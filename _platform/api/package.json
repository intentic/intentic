{
    "name": "@intentic-app/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "dev": "bun --watch --env-file=../../.env ./src/main.ts",
        "start": "bun ./src/main.ts",
        "fleet": "bun --env-file=../../.env ./src/fleet.ts",
        "typecheck": "tsgo --noEmit",
        "docker:release": "bash ../../_tools/scripts/docker-release.sh api --prune",
        "test": "vitest run"
    },
    "dependencies": {
        "@hono/otel": "catalog:",
        "@intentic-app/api-contract": "workspace:*",
        "@intentic-app/localhost-https": "workspace:*",
