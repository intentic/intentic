        "@intentic/base": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/sandbox-run": "workspace:*",
        "@modelcontextprotocol/sdk": "catalog:",
        "@opentelemetry/api": "catalog:",
        "@opentelemetry/context-async-hooks": "catalog:",
        "@opentelemetry/core": "catalog:",
        "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
        "@opentelemetry/resources": "catalog:",
        "@opentelemetry/sdk-trace-node": "catalog:",
        "@opentelemetry/semantic-conventions": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/server": "catalog:",
        "@prisma/adapter-pg": "catalog:",
        "@prisma/client": "catalog:",
        "@puristic/env": "catalog:",
        "better-auth": "catalog:",
        "hono": "catalog:",
        "pg": "catalog:",
        "pino": "catalog:",
        "pino-pretty": "catalog:",
        "prisma": "catalog:",
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic-app/example-provider": "workspace:*",
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/pg": "catalog:",
        "@typescript/native-preview": "catalog:",
        "bun": "catalog:",
        "vitest": "catalog:"
    }
