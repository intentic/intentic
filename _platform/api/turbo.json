{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        // @intentic/prisma's types are generated by its build (prisma generate, then dist/client.d.ts), which no
        // typecheck runs (the root's edge is to `^typecheck:inputs`, a hash): without this a typecheck that misses the
        // cache races that build and finds no module.
        "typecheck": {
            "dependsOn": ["^typecheck:inputs", "@intentic/prisma#build"]
        }
    }
}
