{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        // @intentic/prisma's types are generated by its build (prisma generate, then dist/client.d.ts), which the root's
        // `^typecheck` never runs: without this a typecheck that misses the cache races that build and finds no module.
        "typecheck": {
            "dependsOn": ["^typecheck", "@intentic/prisma#build"]
        }
    }
}
