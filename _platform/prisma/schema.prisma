datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "./generated"
}

// ---------------------------------------------------------------------------
// Better Auth tables (User/Session/Account/Verification) — the platform's
// central account. Regenerate with `npx @better-auth/cli generate` after
// changing auth plugins/options, then create a migration.
// ---------------------------------------------------------------------------

model User {
    id               String             @id
    name             String
    email            String             @unique
    emailVerified    Boolean            @default(false)
    image            String?
    // Consent capture: which clickwrap version (auth.ts TERMS_VERSION = intentic.dev's LEGAL_VERSION) the
    // login page showed when this account was created, and when. Stamped by the user-create hook.
    termsAcceptedAt  DateTime?
    termsVersion     String?
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    sessions         Session[]
    accounts         Account[]
    sandboxes        Sandbox[]
    trialUsage       TrialUsage[]
    hostedUsage      HostedUsage[]
    membership       Membership?
    donations        Donation[]
    creditSpends     CreditSpend[]
    serviceRuns      ServiceRun[]
    services         Service[]
    publisherClaims  PublisherClaim[]
    payoutAccount    PayoutAccount?
    payouts          CreatorPayout[]

    @@map("user")
}

// The free-trial allowance this account has spent today. The trial is the one thing the platform serves ON the
// command path (api config.ts `trial`), so it is also the one thing that needs a per-account meter: the pool is
// intentic's own free-tier keys, and without a counter one enthusiastic visitor spends the day's quota for
// everyone. Counted per UTC day as a plain `YYYY-MM-DD` string rather than a timestamp range, because that is
// exactly the granularity the allowance resets on and it makes the unique key do the work — an upsert on
// (userId, day) is the whole increment, with no read-modify-write to race.
//
// Rows are disposable: nothing reads a past day, so retention.ts sweeps them. Cascades with the user.
model TrialUsage {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    day       String
    messages  Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, day])
    // The sweep deletes by day; the unique index above is on (userId, day), whose leading column it can't use.
    @@index([day])
    @@map("trial_usage")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Postgres does not index FK columns automatically; user-scoped lookups and cascades need it.
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    // Better Auth looks accounts up by userId on every OAuth sign-in; the FK has no automatic index.
    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("verification")
}

// ---------------------------------------------------------------------------
// Platform domain. The strict, sandbox-centric model (CLAUDE.md): the ONLY
// operational state the platform owns is the user's connection to the sandbox
// they work from. Everything else — Claude/git credentials, the three repos
// (intent/desired-state/app), inventory, and the provisioned infra — lives in
// the sandbox; the platform proxies to it over the connection below.
// ---------------------------------------------------------------------------

// A sandbox a user works from. A user can own several. `token` is both the deterministic tunnel-hostname seed
// and the `x-intentic-connect` first-bind secret the browser presents to the daemon. Encrypted at rest
// (api crypto.ts) when SECRETS_KEY is set, like setupPayload and the Account token columns. The platform is
// the registry: the DAEMON announces its own URL + liveness (POST /sandbox/announce); the browser only reads.
model Sandbox {
    id                 String          @id @default(cuid())
    name               String
    // Small square logo for the sandbox switcher, stored inline as a data URL (no upload infrastructure).
    image              String?
    ownerId            String
    owner              User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    token              String          @unique
    // sha256(token) hex — the deterministic lookup key for the daemon's announce (token itself is encrypted
    // with a random IV, so its ciphertext can't be queried by value).
    tokenDigest        String          @unique
    // The sandbox's public URL (https://sandbox-<id>.<zone>), reported by the DAEMON on every announce.
    // Null until the daemon first phones home.
    daemonUrl          String?
    // When the daemon last announced — the setup wizard treats a recent value as "connected".
    lastSeenAt         DateTime?
    // Short-lived setup code the connect script redeems at POST /setup/claim for the values the one-liner used
    // to carry inline (so no raw token lands in shell history). Re-claimable until expiry — a failed run stays
    // re-runnable from the same copied command — and overwritten whenever setup mints a fresh one.
    setupCode          String?         @unique
    setupCodeExpiresAt DateTime?
    // When a machine last redeemed the CURRENT code at /setup/claim — the only proof the platform has that the
    // pasted command actually ran somewhere. The setup wizard reads it to tell "you haven't run it yet" apart
    // from "it's running and pulling the image", which is the difference between a spinner and an instruction.
    // Cleared on every mint: a fresh code describes a fresh run, and a stale stamp would report the old one.
    setupCodeClaimedAt DateTime?
    // Where the machine-side setup run stands (SetupReportSchema): the connect flow POSTs each stage
    // transition and any failure — with its fix — to /setup/report, authenticated by possession of the live
    // code. The wizard renders it so "why did setup fail" has an answer in the browser, not just in a
    // terminal that may be closed. Cleared on every mint, same lifecycle as the claim stamp above.
    setupReport        Json?
    // The DAEMON's own account of its boot (BootReportSchema): whether the sandbox's PUBLIC address answers,
    // checked by the box from the inside and posted to /sandbox/boot-report over the connect token. The one
    // link nothing else can see — a daemon that is up and announcing proves only that it started, not that
    // anybody can reach it, and the wizard holds its handover on the difference. No mint lifecycle: this
    // describes the sandbox, not a setup code, so it is simply overwritten by each boot.
    bootReport         Json?
    // The last check-in we REFUSED and why — {announced, expected} (see expectedDaemonHost). Written on
    // refusal, cleared by an accepted announce, so a value here is always a live disagreement. Was a log line
    // only, which is what made a mis-addressed sandbox look identical to one that never started.
    announceRefusal    Json?
    // The KEY=value map /setup/claim returns alongside CONNECT_TOKEN (= token above): {ZROK_TOKEN,
    // ZROK_API, ZROK_NAMESPACE, SANDBOX_HOSTNAME, OWNER_EMAIL}.
    setupPayload       Json?
    // The sandbox's zrok ACCOUNT token (encrypted) — its whole reachability grant on the self-hosted hub,
    // minted once (sandbox/zrok.ts) and reused across mints; the hostname needs no column because it stays a
    // stable digest of `token` (tunnel-ids). Null until the first setup mint (or hosted provision) buys it.
    zrokToken          String?
    // Where the cloud lane created this sandbox's machine (SandboxCloudSchema + the provider's server id) —
    // null for every other creation path. Display metadata only, never a credential: the provider token was
    // request-scoped, so the platform keeps no way back into the machine. Plaintext on purpose — nothing here
    // is secret, and the delete dialog reads it to name where the still-billing machine lives.
    cloud              Json?
    // The hosted lane's machine record, when THIS sandbox is one the platform runs (HostedMachine below) —
    // null for every other creation path.
    hosted             HostedMachine?
    members            SandboxMember[]
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt

    // sandbox.list's owned-sandboxes findMany is the hottest platform query.
    @@index([ownerId])
    @@map("sandbox")
}

// The pre-provisioned pool (ReservedSandbox) died with the Cloudflare tunnels it existed to amortize: a zrok
// account mint is one fast call, so sandbox.create provisions inline and nothing is reserved ahead of demand.
// The HOSTED lane grew a pool of its own (HostedPoolMachine below) for the cost a mint never had: pulling the
// sandbox image onto a Fly host is the minutes-long part of a first boot, and it can be paid before anyone asks.

// A HOSTED sandbox's machine on Fly — the row that inverts the cloud stamp's stance on purpose: `cloud` is
// display-only residue of a machine the platform can never reach again, while this row is exactly the way
// back in (start on wake, stop, destroy on delete). One per sandbox, dies with it (the reaper destroys the
// Fly app whose row is gone). appName is `<prefix>-<sandbox id>` for a machine built to order and
// `<prefix>-pool-<hex>` for one claimed from the warm pool — the reaper's prefix match and the delete
// dialog's words both read it off this row rather than re-deriving it. Nothing here is a credential: the
// platform's own Fly token (config) is what acts, these are just addresses.
model HostedMachine {
    id        String   @id @default(cuid())
    sandboxId String   @unique
    sandbox   Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
    appName   String   @unique
    machineId String
    volumeId  String
    region    String
    // When the platform last STARTED this machine, and null once that stretch has been counted. The open end
    // of the awake interval the hour meter bills: the platform performs every wake, so it always knows when
    // running began — it is the STOP it never sees, since the machine puts itself to sleep from the inside
    // (sandbox idle-stop). So the interval is closed later, by asking Fly when the machine actually stopped;
    // until then this stays set and the stretch is uncounted. See hosted-usage.ts.
    wokeAt    DateTime?
    // When the owner was told this machine is about to be collected for going unopened, and null whenever it
    // is not under notice. Set by the idle sweep at `hosted.idleWarnDays` and cleared on every wake, so
    // coming back cancels the notice and a later absence earns a fresh one — the stamp is what stops the
    // warning arriving every morning of the week it covers.
    idleWarnedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("hosted_machine")
}

/* THE WARM POOL — machines built before anyone asks for one, so claiming the free sandbox takes the seconds
 * of a start instead of the minutes of an image pull. A pool machine is a full app + volume + machine on Fly
 * whose one boot ran a no-op instead of the sandbox (enough to pull the image onto its host, nothing more),
 * now sitting stopped. It carries NO identity: no connect token, no owner, no reachability grant — those are
 * written into its env at claim time, before the machine ever runs the sandbox, so the first-boot trust story
 * (OWNER_EMAIL seeded before the daemon exists) is exactly the built-to-order one.
 *
 * `state` is the build's own little machine: `building` from creation until the no-op boot is observed
 * stopped, `ready` from then until a claim wins the row, `claimed` for the instant between winning and the
 * hand-off committing (a `claimed` row that lingers is a claim that crashed — the reconcile job collects it).
 * `image` pins what was actually pulled: a config change strands nothing, the reconcile rebuilds drifted
 * machines. Region matters beyond latency — an EEA caller may only claim an EEA machine, or the privacy
 * policy's residency promise breaks. The hour meter does not know these rows exist: the no-op boot is the
 * platform's own cost, and a user's clock starts at claim, when their HostedMachine row is stamped. */
model HostedPoolMachine {
    id        String   @id @default(cuid())
    appName   String   @unique
    machineId String
    volumeId  String
    region    String
    image     String
    state     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([region, state])
    @@map("hosted_pool_machine")
}

// Awake MINUTES this account's hosted machines have burned this calendar month — the meter behind the free
// lane's hour ceiling (api config.ts `hosted.monthlyHours`). Shaped exactly like TrialUsage above, one period
// coarser: a `YYYY-MM` string rather than a timestamp range, so the unique key does the resetting and an
// upsert on (userId, month) is the whole increment with no read-modify-write to race.
//
// Billed to the OWNER of the sandbox, never to whoever woke it — a shared sandbox's guests spend the owner's
// month, which is the only reading under which sharing a sandbox cannot be used to launder machine time.
// Members are unmetered, so rows exist only for accounts without a membership (and for members who were not
// members at the time, which is why the sweep does not assume otherwise).
//
// Rows are disposable — nothing reads a past month — and retention.ts sweeps them on the ledger window.
model HostedUsage {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    month     String
    minutes   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, month])
    // The sweep deletes by month; the unique index above leads with userId, which it can't use.
    @@index([month])
    @@map("hosted_usage")
}

// One sign-in, carried from the user's REAL BROWSER into the desktop app's webview (_editor/desktop-app).
//
// Google refuses OAuth from an embedded webview and Google Identity Services is FedCM-based, which the Linux
// webview does not implement — so the app never asks Google for anything. It opens the platform's own
// /desktop-auth page in the default browser, where sign-in is the ordinary flow, and that page parks the two
// credentials the webview needs here for exactly one pickup:
//   • `ott` — a Better Auth one-time token; the webview redeems it at /api/auth/one-time-token/verify, which
//     answers with a Set-Cookie, so the platform session lands in the webview's own jar and nothing is
//     injected from Rust.
//   • `idToken` — a fresh Google ID token, spent ONCE at the daemon's system.session for a daemon session
//     that renews silently thereafter. This is why the row exists at all: everything else could ride the
//     deep link, but a deep link is passed as a process argument, which is readable by anything on the
//     machine — so the link carries only this row's id.
//
// Both columns are encrypted at rest (api crypto.ts), the row is deleted on the first claim, and anything
// older than its expiry is swept by retention.ts. Minutes, not hours: the app opens the link the moment the
// browser redirects to it.
model DesktopHandoff {
    id        String   @id @default(cuid())
    ott       String
    idToken   String
    challenge String
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@map("desktop_handoff")
}

// A non-owner invited to a sandbox. Email-based (not a User relation) to mirror the daemon's email-based Google
// auth and to allow granting access before the invitee's first sign-in. The owner is NOT listed here — ownership
// lives on Sandbox.ownerId. The daemon is the actual enforcer (its .intentic/members.json); this table is the
// platform's invite/grant record so the invitee's browser can discover the sandbox and its URL.
//
// Lifecycle: an invite is created PENDING (acceptedAt null) with a one-shot inviteToken carried in the emailed
// link; the invitee opens the link, signs in as this email, and accepts (acceptedAt set) — flipping the row to
// an active member. sandbox.list only surfaces a sandbox to the invitee once acceptedAt is set. The daemon's own
// authorized list is pushed by the OWNER's browser at invite time (the server can't reach the daemon), so an
// accepted invitee has daemon access immediately. inviteToken/inviteExpiresAt gate the accept link (resend mints
// fresh ones); an unaccepted invite that expires is inert — the invitee never received a connect token.
// ---------------------------------------------------------------------------
// The creator pool. The membership a user bought (mirrored from Stripe by
// webhook — Stripe stays the source of truth for money, this row is the
// platform's fast local answer to "is this user premium"), and the credit
// economy the revenue share is computed from: the per-day credit meter, the
// donation ledger (install-time support for non-service extensions — the
// platform's ONLY signal about them; no usage telemetry exists), the catalog
// of priced upstreams, and the service-run ledger. The pool's numbers are
// PUBLIC by design (GET /pool/transparency), so no table here may ever hold
// more than ids, statuses, counts and months — the one secret (a service's
// signing key) is encrypted at rest.
// ---------------------------------------------------------------------------

// One row per user who ever completed a membership checkout. `status` is Stripe's subscription status
// verbatim ("active", "past_due", "canceled", …) — a bare string, not an enum, so Stripe growing a status is
// a webhook update, not a migration. Premium = active/trialing (pool/pool-membership.ts owns that rule).
model Membership {
    id                   String   @id @default(cuid())
    userId               String   @unique
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    stripeCustomerId     String   @unique
    stripeSubscriptionId String   @unique
    status               String
    // When the paid period runs out (Stripe's current_period_end) — display only ("renews on …"); the
    // premium answer keys off `status`, which the webhook keeps current through every renewal and lapse.
    currentPeriodEnd     DateTime
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    @@map("membership")
}

// One row = "this member's install of this premium extension donated its credits this month" — the unit a
// non-service extension is paid on. Written by POST /pool/donate at install/update time and NEVER from any
// usage signal: sandboxes are self-hosted, so the platform meters only what passes through its own hands
// (credits), and no telemetry leaves anyone's machine. The unique key is the whole dedupe story: a reinstall
// in the same month is a no-op that charges nothing, an update in a later month donates again — at most
// twelve donations per install per year, which is also what bounds an update-spamming publisher. `credits`
// is stamped from config at donation time, so a later price change never rewrites history. Keyed by the
// manifest-derived extension identity (publisher.name), the same identity listings and payouts use.
model Donation {
    id          String   @id @default(cuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    extensionId String
    month       String
    credits     Int
    createdAt   DateTime @default(now())

    @@unique([userId, extensionId, month])
    // The transparency aggregate and the retention sweep both scan by month; the unique above leads with
    // userId and can't serve them.
    @@index([month])
    @@map("donation")
}

/* A priced upstream the platform will meter and forward to — one row per premium service. `slug` is the
 * public id extensions call it by; `secret` is the provider's signing key (encrypted at rest, api crypto.ts —
 * the one secret in the pool's tables), spent on the HMAC that lets the provider verify a forwarded call came
 * from intentic. `creditsPerRun` is the visible price.
 *
 * TWO KINDS OF ROW LIVE HERE, told apart by `userId`. An OPERATOR row (null owner — the demo service, and any
 * listing written by hand) answers to nobody and is exempt from every admission gate. An OWNED row arrived
 * through open admission (pool-admission.ts): its owner claimed the publisher name, connected payouts, and
 * passed a live conformance probe, and it is subject to the watch forever after.
 *
 * `status` replaced the old `active` boolean because "live" stopped being one bit: `draft` is editable and
 * invisible, `probation` is live under a price ceiling and badged as new, `listed` is graduated, `suspended`
 * is delisted with its reason recorded. Run history survives every transition — a suspended service's
 * earnings are somebody's money, and its public numbers are the evidence for why it was suspended. */
model Service {
    id            String        @id @default(cuid())
    slug          String        @unique
    publisher     String
    name          String
    description   String
    upstreamUrl   String
    secret        String
    creditsPerRun Int
    /* A request body this service actually answers, as JSON. Two jobs, which is why it is required of an
     * owned listing: it is the body the conformance probe sends (so the probe tests a call the provider
     * knows works, rather than a canonical one they never anticipated), and the catalog hands it to the
     * agent as the worked example of this service's request shape. */
    sampleRequest String        @default("{}")
    // "draft" | "probation" | "listed" | "suspended" — see pool-admission.ts ServiceStatus.
    status        String        @default("listed")
    // Null for operator-created rows; set to the provider who published it through open admission.
    userId        String?
    user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    // When the last conformance probe passed. Publishing requires one inside the freshness window; the
    // canary refreshes it for a listed service that is still answering.
    probedAt      DateTime?
    // How many consecutive canary probes have failed — the counter the watch suspends on.
    canaryFails   Int           @default(0)
    // Why a suspended row is suspended, in a sentence written for the provider reading it.
    suspendedFor  String?
    // When the price last moved — the rate limit's whole state.
    pricedAt      DateTime?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    runs          ServiceRun[]
    probes        ServiceProbe[]

    // The catalog reads live rows; the watch scans by owner.
    @@index([status])
    @@index([userId])
    @@map("service")
}

// One conformance probe attempt — kept rather than overwritten so a provider debugging a rejection can read
// what actually happened, and so a suspension has the failing runs behind it on record. Swept by retention.
model ServiceProbe {
    id        String   @id @default(cuid())
    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    // Whether all three checks passed.
    passed    Boolean
    // "publish" (the gate) or "canary" (the watch) — the two callers, told apart in the provider's log.
    kind      String
    // Per-check outcome as JSON, and the first failing check's sentence. Read by humans, never by logic.
    detail    String
    createdAt DateTime @default(now())

    @@index([serviceId, createdAt])
    @@index([createdAt])
    @@map("service_probe")
}

// The credit meter: what a member has spent today, the trial_usage shape verbatim — atomic upsert on
// (userId, day) so a spend is one statement, refusal decided from the post-increment value. The allowance
// itself is config (pool.dailyCredits), never a row. Swept by retention.ts; cascades with the user.
model CreditSpend {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    day       String
    credits   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, day])
    @@index([day])
    @@map("credit_spend")
}

// One metered call to a service — what provider earnings and the transparency page's services section are
// computed from. `status` is "ok" or "refunded" (provider failure gave the credits back; the row stays, so
// a flaky service is visible in its own public numbers). Swept with the use-day window; cascades with user.
model ServiceRun {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    credits   Int
    status    String
    createdAt DateTime @default(now())

    // Earnings and transparency aggregate by service and by time; the FK columns get no automatic index.
    @@index([serviceId, createdAt])
    @@index([userId])
    @@index([createdAt])
    @@map("service_run")
}

/* WHO A PUBLISHER NAME BELONGS TO — the join the pool has never had. Earnings accrue against the manifest's
 * `publisher.name`, which is a string a listing declares, not a person the platform can pay. This row is what
 * turns one into the other: an account proved control of a source repository the official registry lists under
 * that publisher, so money owed to the name is money owed to this user.
 *
 * `publisher` is the unique key, not (publisher, userId): the name is first-come and singular, exactly as the
 * registry treats it, so a second claimant collides with the holder instead of quietly earning beside them.
 * `repo` records WHICH repository carried the proof — a claim nobody can retrace is not evidence, and when a
 * slug is disputed this is the line that settles it. */
model PublisherClaim {
    id        String   @id @default(cuid())
    publisher String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    repo      String
    createdAt DateTime @default(now())

    // The creator surface lists a caller's claims; the unique above is on publisher and can't serve that.
    @@index([userId])
    @@map("publisher_claim")
}

/* WHERE A CREATOR'S MONEY GOES. One per account rather than one per publisher: a person holding three listings
 * is still one payee with one set of tax details, and splitting the destination per listing would multiply the
 * onboarding without buying anything.
 *
 * The platform stores an account REFERENCE and three answers it needs to render honestly — never bank details,
 * never tax forms, which is the whole reason payouts ride a Connect account instead of a form here. `payoutsEnabled`
 * is the only field the settlement job may read as permission to send money; `detailsSubmitted` separates "still
 * filling it in" from "finished but held", and `disabledReason` is why a finished account still cannot be paid,
 * so the creator reads a cause rather than a silence. */
model PayoutAccount {
    id               String   @id @default(cuid())
    userId           String   @unique
    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    stripeAccountId  String   @unique
    payoutsEnabled   Boolean  @default(false)
    detailsSubmitted Boolean  @default(false)
    disabledReason   String?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@map("payout_account")
}

/* A MONTH, CLOSED. The public ledger recomputes its figures live from the donation and run rows every time
 * anyone reads it, which is right for a month still in progress and impossible to pay against: a number that
 * moves cannot be settled on, and the rows it is computed from are swept at thirteen months (retention.ts).
 * This row is the month frozen — computed once, never recomputed, and from then on the record.
 *
 * `grossCents`/`feeCents` are what actually SETTLED at Stripe in the month, not members × price: the published
 * promise is a share of what members spend, and a revenue figure that is really an estimate multiplied out
 * cannot be reconciled against anything. `poolCents` keeps the ceiling the live ledger states, so the two
 * surfaces can be read side by side; `earnedCents` is what this month's own spent credits came to, `sweptCents`
 * is expired unclaimed money folded back in, and `distributedCents` is the sum of the statements below.
 *
 * The shares are frozen alongside the money. If the split ever changes, a closed month must keep paying by the
 * number that was published while it was open — otherwise the promise is retroactive, which is the one thing
 * this whole design exists to prevent. */
model PoolMonth {
    id                String             @id @default(cuid())
    month             String             @unique
    closedAt          DateTime           @default(now())
    members           Int
    grossCents        Int
    feeCents          Int
    // What running the platform for this month's members cost, taken off the top before the shares — frozen
    // here alongside the gross it was subtracted from, so a reader of a closed month can check the pool
    // figure rather than take it. Distinct from feeCents, which is the payment processor's, not ours.
    infraCents        Int
    poolCents         Int
    earnedCents       Int
    sweptCents        Int
    distributedCents  Int
    creatorShare      Float
    serviceShare      Float
    // The date this month's statements become payable — stated at close so a creator reads a date, not "soon".
    payableAt         DateTime
    statements        CreatorStatement[]

    @@map("pool_month")
}

/* ONE PUBLISHER'S EARNINGS FOR ONE CLOSED MONTH — the unit a payout is later made against, and after the raw
 * ledger is swept, the only surviving record that the money was ever owed.
 *
 * Deliberately NOT bound to a user. Who a publisher name belongs to is answered by the claim table, which can
 * change after a close: a creator who claims in October must be paid for July, and binding a user here would
 * mean rewriting frozen rows to make that true. Payability is therefore derived — a claim exists and this row
 * has not expired — and the frozen row stays frozen.
 *
 * `expiresAt` is the published twelve-month window. `expiredAt` is set only when the amount has actually been
 * swept back into a later month's distribution, so the two together answer "is this still claimable" and "where
 * did it go" without a status string that could disagree with either. */
model CreatorStatement {
    id          String         @id @default(cuid())
    month       String
    poolMonth   PoolMonth      @relation(fields: [month], references: [month], onDelete: Cascade)
    publisher   String
    amountCents Int
    credits     Int
    expiresAt   DateTime
    expiredAt   DateTime?
    createdAt   DateTime       @default(now())
    // The payment this line was settled by. Null means still owed — and it is the ONLY thing that means that,
    // so claiming a statement into a payout is what makes paying it twice impossible.
    payoutId    String?
    payout      CreatorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

    @@unique([month, publisher])
    // A creator's own statements are read by publisher; the unique above leads with month.
    @@index([publisher])
    // The payout run scans for unclaimed lines.
    @@index([payoutId])
    @@map("creator_statement")
}

/* ONE PAYMENT TO ONE CREATOR — the receipt, and the thing that makes the run safe to retry.
 *
 * A payout is RESERVED before any money moves: the row is created and the statements it covers are claimed by
 * it in the same transaction, while nothing has been sent. Only then is the transfer attempted, under an
 * idempotency key that is this row's own id. That ordering is the whole guarantee. A crash after the reserve
 * and before the transfer leaves a `pending` row that the next run finishes — with the same key, so if the
 * transfer had in fact reached Stripe, Stripe returns the original instead of making a second one.
 *
 * A failing transfer therefore NEVER releases its statements. Releasing them would mean the next run builds a
 * different payout with a different key, which is precisely how a payment that silently succeeded gets sent
 * twice. It stays pending and visible instead, with the last error on the row, because money stuck in the open
 * is a problem someone can fix and money sent twice is one they cannot. */
model CreatorPayout {
    id               String             @id @default(cuid())
    userId           String
    user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    amountCents      Int
    currency         String
    // "pending" until the transfer is confirmed, then "paid". No "failed": a failure is a pending payment that
    // has not succeeded yet, and calling it finished would strand the money it still holds.
    status           String             @default("pending")
    stripeTransferId String?
    attempts         Int                @default(0)
    lastError        String?
    createdAt        DateTime           @default(now())
    paidAt           DateTime?
    statements       CreatorStatement[]

    @@index([userId])
    // The run resumes every unfinished payment before it builds any new ones.
    @@index([status])
    @@map("creator_payout")
}

model SandboxMember {
    id              String    @id @default(cuid())
    sandboxId       String
    sandbox         Sandbox   @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
    email           String
    // The granted trust tier (GrantedRoleSchema: viewer/collaborator/maintainer — never owner). The daemon's
    // members list is the enforced copy; this column is what the roster renders and what sandbox.list reports
    // as the member's own role. A bare string (not an enum) so re-grading vocabulary is a contract change, not
    // a database migration.
    role            String    @default("collaborator")
    inviteToken     String?   @unique
    inviteExpiresAt DateTime?
    acceptedAt      DateTime?
    createdAt       DateTime  @default(now())

    @@unique([sandboxId, email])
    // sandbox.list's shared-sandboxes lookup and leave query by email alone; the composite unique
    // above leads with sandboxId, so it can't serve them.
    @@index([email])
    @@map("sandbox_member")
}
