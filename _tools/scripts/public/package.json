{
    "name": "@intentic-monorepo/root",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/radarsu/intentic.git"
    },
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "pnpm typecheck:declarations && turbo run typecheck --continue=dependencies-successful",
        "typecheck:declarations": "node _tools/scripts/typecheck.mjs",
        "check:bytes": "node _tools/scripts/control-chars.mjs",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm check:bytes && pnpm build && pnpm typecheck && pnpm lint && pnpm format:check",
        "e2e:hermetic": "turbo run e2e:hermetic --ui=stream",
        "intentic": "tsgo -b tsconfig.libs.json && node _apps/cli/dist/cli.js",
        "demo:up": "tsgo -b tsconfig.libs.json && node _apps/cli/dist/demo.js up",
        "demo:down": "tsgo -b tsconfig.libs.json && node _apps/cli/dist/demo.js down",
        "demo:clear": "tsgo -b tsconfig.libs.json && node _apps/cli/dist/demo.js clear",
        "publish:images": "bash _tools/scripts/publish-images.sh",
        "build:sandbox": "bash _tools/scripts/prepare-image-trees.sh && docker build --build-context trees=.image-out -f _apps/sandbox/Dockerfile -t intentic-sandbox:dev .",
        "dev:sandbox": "node _apps/sandbox/scripts/dev-sandbox.mjs",
        "libs:watch": "nice -n 15 tsgo --build --watch tsconfig.libs.json",
        "clear": "find . \\( -name 'node_modules' -o -name '.cache' -o -name 'dist' -o -name '.turbo' -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +",
        "cache:clear": "find . \\( -name '.cache' -o -name 'dist' -o -name '.turbo' \\) -prune -exec rm -rf '{}' +"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "oxlint": "catalog:",
        "prettier": "catalog:",
        "tslib": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.13.1"
    },
    "packageManager": "pnpm@11.13.1"
}
