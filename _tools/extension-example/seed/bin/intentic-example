#!/usr/bin/env node
/* This standalone CLI writes the file watched by the example extension view. */
import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
import { dirname, join, resolve } from "node:path";
import { existsSync } from "node:fs";

const NOTES_TAIL = join(`.intentic`, `example-notes.json`);

// The workspace root is wherever `.intentic/` lives at or above the cwd — the agent may be anywhere under /work.
const workspaceRoot = () => {
    let dir = resolve(process.cwd());
    for (;;) {
        if (existsSync(join(dir, `.intentic`))) {
            return dir;
        }
        const parent = dirname(dir);
        if (parent === dir) {
            return resolve(process.cwd());
        }
        dir = parent;
    }
};

const notesPath = join(workspaceRoot(), NOTES_TAIL);

// No file yet is "no notes"; one that cannot be read or parsed throws, since `add` would otherwise write over it.
const read = async () => {
    let text;
    try {
        text = await readFile(notesPath, `utf8`);
    } catch (error) {
        if (error.code === `ENOENT`) {
            return [];
        }
        throw error;
    }
    let parsed;
    try {
        parsed = JSON.parse(text);
    } catch (error) {
        throw new Error(`${notesPath} is not valid JSON, so nothing was changed: fix or remove it (${error.message})`, { cause: error });
    }
    return Array.isArray(parsed.notes) ? parsed.notes : [];
};

const [verb, ...rest] = process.argv.slice(2);

if (verb === `add`) {
    const text = rest.join(` `).trim();
    if (text === ``) {
        console.error(`usage: intentic-example add "some text"`);
        process.exit(1);
    }
    const notes = await read();
    notes.push({ at: new Date().toISOString(), text });
    await mkdir(dirname(notesPath), { recursive: true });
    // Temp-then-rename: the view reading mid-write sees the whole old list or the whole new one.
    const staged = `${notesPath}.${process.pid}.tmp`;
    await writeFile(staged, `${JSON.stringify({ notes }, undefined, 4)}\n`);
    await rename(staged, notesPath);
    console.log(`noted (${notes.length} total) — ${notesPath}`);
} else if (verb === `list`) {
    console.log(JSON.stringify({ notes: await read() }, undefined, 4));
} else {
    console.error(`usage: intentic-example <add|list> [text]`);
    process.exit(1);
}
