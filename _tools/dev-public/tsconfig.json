/* Nothing is emitted and nothing is bundled: `pnpm dev:public` hands src/main.ts straight to node, which runs it
 * by erasing the types (the fake-zrok precedent). That is why relative imports here name `.ts` rather than the
 * `.js` every other package writes — node resolves the specifier literally and does not rewrite one extension
 * into the other, so a `.js` specifier would type-check cleanly and then fail at start with ERR_MODULE_NOT_FOUND. */
{
    "compilerOptions": {
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo",
        "skipLibCheck": true
    },
    "include": ["./src/**/*"],
    "extends": "@intentic/tsconfig/tsconfig.base.json"
}
