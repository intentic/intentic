{
    "name": "@intentic/constants",
    "version": "0.0.0",
    "description": "Shared constants for the intentic packages, ports, paths, and image references the daemon, CLIs and desktop app all agree on",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_tools/constants"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src/node.mjs",
        "src/node.d.mts",
        "src/assertion-measure.mjs",
        "src/assertion-measure.d.mts",
        "src/contract-shrink.mjs",
        "src/contract-shrink.d.mts",
        "src/control-bytes.mjs",
        "src/control-bytes.d.mts",
        "src/mirror-roots.mjs",
        "src/mirror-roots.d.mts",
        "src/ci-infra-steps.mjs",
        "src/ci-infra-steps.d.mts",
        "src/memory-room.mjs",
        "src/memory-room.d.mts",
        "src/allow.mjs",
        "src/allow.d.mts",
        "src/heavy/heavy-rules.cjs",
        "src/heavy/heavy-rules.d.cts",
        "src/heavy/heavy-turn.cjs",
        "src/heavy/heavy-hook.cjs",
        "src/heavy/heavy-exec.cjs"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        },
        "./node": {
            "types": "./src/node.d.mts",
            "default": "./src/node.mjs"
        },
        "./assertion-measure": {
            "types": "./src/assertion-measure.d.mts",
            "default": "./src/assertion-measure.mjs"
        },
        "./contract-shrink": {
            "types": "./src/contract-shrink.d.mts",
            "default": "./src/contract-shrink.mjs"
        },
        "./control-bytes": {
            "types": "./src/control-bytes.d.mts",
            "default": "./src/control-bytes.mjs"
        },
        "./ci-infra-steps": {
            "types": "./src/ci-infra-steps.d.mts",
            "default": "./src/ci-infra-steps.mjs"
        },
        "./mirror-roots": {
            "types": "./src/mirror-roots.d.mts",
            "default": "./src/mirror-roots.mjs"
        },
        "./test-suites": {
            "types": "./src/test-suites.d.mts",
            "default": "./src/test-suites.mjs"
        },
        "./memory-room": {
            "types": "./src/memory-room.d.mts",
            "default": "./src/memory-room.mjs"
        },
        "./allow": {
            "types": "./src/allow.d.mts",
            "default": "./src/allow.mjs"
        },
        "./heavy-rules": {
            "types": "./src/heavy/heavy-rules.d.cts",
            "default": "./src/heavy/heavy-rules.cjs"
        },
        "./heavy-hook": "./src/heavy/heavy-hook.cjs",
        "./heavy-exec": "./src/heavy/heavy-exec.cjs"
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:"
    }
}
