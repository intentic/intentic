/* Test config type-checks this package's source and tests. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "bun", "@intentic/testing/globals"],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"]
}
