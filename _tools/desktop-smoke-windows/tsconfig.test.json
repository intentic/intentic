/* Type-checks this package's TESTS along with its source: the build config excludes *.test.ts to keep test code out of the tree the Windows runner executes. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "bun"],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"],
    "exclude": []
}
