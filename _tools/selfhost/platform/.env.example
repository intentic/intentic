# intentic platform self-host — copy to `.env` and fill in. `docker compose` interpolates these.
# Values map 1:1 onto _apps/api/src/config.ts (the api) and the web image's runtime env.

# ---- images ----------------------------------------------------------------------------------------------
# Which tag of registry.gitlab.com/radarsu/intentic/{web,api} to run. `latest` tracks main; pin to sha-<short>
# for a reproducible deploy.
INTENTIC_IMAGE_TAG=latest

# ---- public origins (same-site so the Better-Auth session cookie rides cross-subdomain) ------------------
API_URL=https://api.intentic.dev
WEB_ORIGIN=https://app.intentic.dev

# ---- database --------------------------------------------------------------------------------------------
# Postgres password for the bundled db (user/db are both `intentic`). Any strong secret.
POSTGRES_PASSWORD=

# ---- platform secrets ------------------------------------------------------------------------------------
# Session signing key. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# At-rest encryption key for stored OAuth + sandbox connect tokens. Generate: openssl rand -base64 48
# (never run production without this — tokens would be stored in plaintext).
SECRETS_KEY=

# ---- Google sign-in (required — the only sign-in method) -------------------------------------------------
# The web SPA's public client id is HARDCODED in _apps/web/src/environments/environment.deployment.ts
# (481795963975-…). Use that same OAuth client here, and on it authorize:
#   - Authorized JavaScript origin:  https://app.intentic.dev   (your WEB_ORIGIN)
#   - Authorized redirect URI:       https://api.intentic.dev/api/auth/callback/google   (your API_URL + /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare tunnel (public ingress) ------------------------------------------------------------------
# Connector token for the tunnel that fronts this platform. Create a tunnel in the Cloudflare dashboard, copy
# its token, then add two public hostnames pointing at the compose services:
#   app.intentic.dev  ->  http://web:80
#   api.intentic.dev  ->  http://api:6480
PLATFORM_TUNNEL_TOKEN=

# ---- intentic-provided sandbox tunnels (optional but recommended) ----------------------------------------
# Intentic's OWN Cloudflare API token (Account→Tunnel:Edit, Zone→DNS:Edit, Zone→Zone:Read) + the shared zone.
# Enables the pool + setup path for users who bring no Cloudflare. Blank → only bring-your-own-Cloudflare setup.
INTENTIC_CLOUDFLARE_API_TOKEN=
INTENTIC_CLOUDFLARE_ZONE=intentic.dev
INTENTIC_CLOUDFLARE_POOL_SIZE=1

# ---- billing (optional — upgrade flow 404s until set) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ---- sandbox-invite email via Resend (optional — invites logged server-side until set) -------------------
EMAIL_API_KEY=
EMAIL_FROM=

# ---- misc ------------------------------------------------------------------------------------------------
# Comma-separated emails always entitled to `pro` without a Stripe subscription (comp/test accounts).
PERMANENT_PREMIUM_EMAILS=
# PostHog project key for the SPA (optional).
POSTHOG_KEY=
# PostHog upstreams behind the SPA's /wire reverse proxy. Defaults suit a US Cloud project; an EU project
# needs eu.i.posthog.com / eu-assets.i.posthog.com, and both must match the region POSTHOG_KEY belongs to.
POSTHOG_API_HOST=us.i.posthog.com
POSTHOG_ASSETS_HOST=us-assets.i.posthog.com
LOG_LEVEL=info
