# intentic platform self-host — copy to `.env` and fill in. `docker compose` interpolates these.
# Values map 1:1 onto _platform/api/src/config.ts (the api) and the web image's runtime env.

# ---- images ----------------------------------------------------------------------------------------------
# Which tag of ghcr.io/intentic/{web,api} to run. `latest` tracks main; pin to sha-<short>
# for a reproducible deploy.
INTENTIC_IMAGE_TAG=latest

# ---- public origins (same-site so the Better-Auth session cookie rides cross-subdomain) ------------------
API_URL=https://api.intentic.dev
WEB_ORIGIN=https://app.intentic.dev

# ---- database --------------------------------------------------------------------------------------------
# Postgres password for the bundled db (user/db are both `intentic`). Any strong secret. It is interpolated
# into DATABASE_URL as-is, so keep it to URL-safe characters — a `@`, `:`, `/`, `#` or `?` in here silently
# produces a malformed connection string.
POSTGRES_PASSWORD=
# Per-process pg pool cap. api replicas × this must stay under Postgres max_connections (default 100) with
# headroom for the boot migration and psql.
DATABASE_POOL_MAX=10

# ---- platform secrets ------------------------------------------------------------------------------------
# Session signing key. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# At-rest encryption key for stored OAuth + sandbox connect tokens. Generate: openssl rand -base64 48
# (never run production without this — tokens would be stored in plaintext).
SECRETS_KEY=

# ---- Google sign-in (required — the only sign-in method) -------------------------------------------------
# The web SPA's public client id is HARDCODED in _editor/web/src/environments/environment.deployment.ts
# (481795963975-…). Use that same OAuth client here, and on it authorize:
#   - Authorized JavaScript origin:  https://app.intentic.dev   (your WEB_ORIGIN)
#   - Authorized redirect URI:       https://api.intentic.dev/api/auth/callback/google   (your API_URL + /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare tunnel (public ingress) ------------------------------------------------------------------
# Connector token for the tunnel that fronts this platform. Create a tunnel in the Cloudflare dashboard, copy
# its token, then add two public hostnames pointing at the compose services:
#   app.intentic.dev  ->  http://web:80
#   api.intentic.dev  ->  http://api:6480
PLATFORM_TUNNEL_TOKEN=

# ---- intentic's Cloudflare token — DNS ONLY -------------------------------------------------------------
# Nothing reaches a sandbox through Cloudflare any more (that is the ingress below). What is left of this
# token: the loopback certificate's `*.local.<zone>` records for same-machine sandboxes, and the daily sweep
# that clears the residue of everything the platform used to mint here. Blank → the loopback-certificate path
# is simply off. Token scopes: Zone→DNS:Edit, Zone→Zone:Read.
INTENTIC_CLOUDFLARE_API_TOKEN=
INTENTIC_CLOUDFLARE_ZONE=intentic.dev
# May this deployment DELETE records in that zone? The sweep decides what is an orphan by asking THIS
# deployment's database, and the zone is shared by every deployment holding the token — someone running the api
# locally against production credentials once swept the production zone against an empty local database. Leave
# it false unless this deployment IS the zone's owner. DRY_RUN reports candidates without deleting even when
# reaping is on: run a new deployment's first sweep that way, confirm the lines in `docker compose logs api`,
# then turn it off. Deletes are final.
INTENTIC_CLOUDFLARE_REAP=false
INTENTIC_CLOUDFLARE_REAP_DRY_RUN=false

# ---- the reachability fabric (required for ANY sandbox to be reachable) ----------------------------------
# The platform's own edge (the `ingress` service in docker-compose.yml). Sandboxes dial INGRESS_URL outbound
# and prove who they are with a grant this platform SIGNS — so there is no fabric credential here, only the
# private half of an Ed25519 pair. Generate it:
#   openssl genpkey -algorithm ed25519 -out ingress-key.pem
#   openssl pkey -in ingress-key.pem -pubout -out ingress-pub.pem
# A PEM is multi-line and an env file is not: put it on ONE line with `\n` escapes inside DOUBLE quotes —
# compose's dotenv parser expands them back to real newlines, which is what the api's createPrivateKey needs.
#   awk '{ printf "%s\\n", $0 }' ingress-key.pem      # paste the output between the quotes
# Blank INGRESS_SIGNING_KEY → nothing can be made reachable: setup offers only the attach lane and the hosted
# lane below is off no matter what its own credentials say.
INGRESS_SIGNING_KEY=""
# The matching PUBLIC half, read by the `ingress` service. Same one-line treatment.
INGRESS_PUBLIC_KEY=""
# The wildcard zone sandbox hostnames are labels under, and the address boxes dial. Both must reach the
# ingress service's port: `*.<zone>` (every sandbox) and `ingress.<zone>` (the dial address). One wildcard DNS
# record and one wildcard certificate serve both, which is what makes a sandbox cost zero DNS records.
INGRESS_ZONE=sbx.intentic.dev
INGRESS_URL=https://ingress.sbx.intentic.dev

# ---- hosted sandboxes on intentic's own Fly account (optional) -------------------------------------------
# The platform creates each new user's machine itself, so signing in IS the setup. Blank → the lane is off and
# every user sets up their own machine. The token must be ORG-scoped: `fly tokens create org`.
# NOTE this lane also needs INGRESS_SIGNING_KEY above — a hosted machine is reachable only through the grant
# this platform signs, so credentials here alone leave the lane off.
HOSTED_FLY_API_TOKEN=
HOSTED_FLY_ORG=
# Where a machine lands: REGION outside the EEA, REGION_EU inside it. The EU pick is a published
# data-protection promise, not a latency tweak — emptying it breaks a published statement.
HOSTED_REGION=iad
HOSTED_REGION_EU=arn
# Fly app names are globally unique; keep the prefix unique to this deployment, because the orphan sweep
# recognizes our apps by it.
HOSTED_APP_PREFIX=intentic-sbx
# The warm pool, PER REGION: machines built and stopped before anyone asks, so claiming the free sandbox costs
# a machine start (seconds) instead of an image pull (minutes). 0 drains it — and a drained pool is the whole
# difference between "instant" and "stuck on a spinner".
HOSTED_POOL_SIZE=2
# The fleet watch (our rows vs. what Fly actually has) and the provisioning canary (a throwaway sandbox
# end to end, then destroyed). Both report through ADMIN_EMAILS. 0 turns either off. The canary's email must
# be an account nobody signs in as.
HOSTED_HEALTH_MINUTES=15
HOSTED_CANARY_MINUTES=60
HOSTED_CANARY_EMAIL=
# Everything else about the machine — shape (CPUS/MEMORY_MB/VOLUME_GB), IDLE_STOP_MINUTES, MONTHLY_HOURS,
# IDLE_DAYS/IDLE_WARN_DAYS, PER_USER, INSTANCE_ID — is passed through by docker-compose.yml and falls back to
# the defaults in _platform/api/src/config.ts. Set one here only to move it off its default.

# ---- the creator pool: the optional paid membership (optional, OFF by default) ---------------------------
# POOL_STRIPE_SECRET_KEY + POOL_STRIPE_PRICE_ID are the switch: both blank and the pool does not exist —
# /pool routes 404 and no membership is offered anywhere. Stripe stays the money's source of truth.
POOL_STRIPE_SECRET_KEY=
POOL_STRIPE_WEBHOOK_SECRET=
POOL_STRIPE_PRICE_ID=
# The published economics. These are the numbers the transparency page states, so change them loudly or not
# at all; all of them fall back to config.ts when blank.
POOL_PRICE_USD=20
POOL_CREATOR_SHARE=0.9
POOL_SERVICE_SHARE=0.9
POOL_DAILY_CREDITS=1000
# Comma-separated emails that count as premium WITHOUT a subscription (comped memberships). Checked at
# answer time, never seeded as rows, so it applies the moment the account exists and reverts the moment the
# email leaves the list.
POOL_COMP_EMAILS=

# ---- the operator's admin surface (optional, OFF by default) ---------------------------------------------
# Comma-separated emails whose signed-in session may call /admin. Blank disables it outright — no route, no
# exposure. Also where hosted alerts and the daily digest go. MUTATIONS gates the panel's writes
# (suspend/retry/stop/erase); leave it off until the panel is a pinned install.
ADMIN_EMAILS=
ADMIN_MUTATIONS=false

# ---- Free trial (optional, OFF by default) ---------------------------------------------------------------
# Lets a brand-new user chat before connecting any AI account, on INTENTIC'S OWN free-tier keys. This is the one
# feature that puts the platform on the command path: trial messages pass through it. Every surface that offers
# the trial says so, and connecting any account moves the user onto the direct path for good.
# Blank (the default, and the right setting for a self-hosted platform) → no trial anywhere.
# Several comma-separated keys act as a POOL: a free tier is sized for one developer, so the next key takes the
# turn when one is rate-limited.
TRIAL_KEYS=
# Any OpenAI-compatible upstream. The default is Google's, whose free tier is meant for serving end users.
TRIAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated model ids the trial may ROUTE TO, in preference order. Blank → a curated ladder of Google
# flash aliases built into the code. The trial shows users ONE row and picks a real model per message, walking
# this list until one answers — so this narrows what the trial spends, not what it offers. Set it to keep the
# trial off the expensive end of a free tier; you MUST set it if TRIAL_BASE_URL points at a non-Google upstream,
# since it replaces the built-in ladder rather than filtering it. Prefer `-latest` aliases to pinned versions —
# a pinned id gets retired out from under a free key.
TRIAL_MODELS=
# Messages per signed-in account per UTC day.
TRIAL_DAILY_MESSAGES=12

# ---- sandbox-invite email via Resend (optional — invites logged server-side until set) -------------------
EMAIL_API_KEY=
EMAIL_FROM=

# ---- misc ------------------------------------------------------------------------------------------------
# PostHog project key for the SPA (optional).
POSTHOG_KEY=
# PostHog upstreams behind the SPA's /wire reverse proxy. Defaults suit a US Cloud project; an EU project
# needs eu.i.posthog.com / eu-assets.i.posthog.com, and both must match the region POSTHOG_KEY belongs to.
POSTHOG_API_HOST=us.i.posthog.com
POSTHOG_ASSETS_HOST=us-assets.i.posthog.com
LOG_LEVEL=info
# OTLP collector for api traces (tracing.ts). Blank → tracing is never started.
OTEL_EXPORTER_OTLP_ENDPOINT=
