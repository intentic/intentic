/* Type-checks this package's tests along with its source. Nothing is excluded here: the package emits no
 * dist, so its build config already reads every file. It exists so `pnpm typecheck` names one config per
 * package (AGENTS.md, "Tests"). */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"],
    "exclude": []
}
