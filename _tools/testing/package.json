{
    "name": "@intentic/testing",
    "version": "0.0.0",
    "description": "Test-support seams every package's suites share, the deep, self-naming stand-in for a wide interface",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_tools/testing"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./e2e": {
            "types": "./src/e2e.ts",
            "default": "./src/e2e.ts"
        },
        "./fly-fake": {
            "types": "./src/fly-fake.ts",
            "default": "./src/fly-fake.ts"
        },
        "./stripe-fake": {
            "types": "./src/stripe-fake.ts",
            "default": "./src/stripe-fake.ts"
        },
        "./http-fake": {
            "types": "./src/http-fake.ts",
            "default": "./src/http-fake.ts"
        },
        "./bun": {
            "types": "./src/bun.ts",
            "default": "./src/bun.ts"
        },
        "./dom": {
            "types": "./src/dom.ts",
            "default": "./src/dom.ts"
        },
        "./bun-preload": {
            "types": "./src/bun-preload.ts",
            "default": "./src/bun-preload.ts"
        },
        "./bun-vue": {
            "types": "./src/bun-vue.ts",
            "default": "./src/bun-vue.ts"
        },
        "./globals": {
            "types": "./src/globals.d.ts"
        }
    },
    "scripts": {
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "test": "node ./bin/suites.mjs"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "jsdom": "catalog:",
        "vue": "catalog:"
    },
    "bin": {
        "suites": "./bin/suites.mjs"
    }
}
