/* This package is consumed from source and never emits build artifacts. */
{
    "compilerOptions": {
        "types": ["node", "bun"],
        "noEmit": true,
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo",
        "skipLibCheck": true
    },
    "include": ["./src/**/*"],
    "extends": "@intentic/tsconfig/tsconfig.base.json"
}
