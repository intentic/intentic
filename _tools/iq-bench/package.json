{
    "name": "@intentic/iq-bench",
    "version": "0.0.0",
    "description": "Benchmark harness for iq — tier 1 sweeps retrieval configs in-process against golden datasets; tier 2 runs paired agent-CLI tasks with and without iq",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsgo",
        "watch": "tsc --build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench:retrieval": "node dist/cli.js retrieval",
        "bench:agents": "IQ_BENCH_AGENTS=1 node dist/cli.js agents"
    },
    "dependencies": {
        "@intentic/iq-engine": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
