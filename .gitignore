# Root + nested packages.
**/node_modules
**/.cache
**/.local
**/.turbo
**/dist
**/dist-*
# The browser extension's packed artifact (_computers/webext/scripts/pack.mjs). `**/dist` does not cover it:
# that pattern matches a path component called `dist`, and this is a file called `dist.zip`.
**/dist.zip
**/deploy
**/generated
**/out-tsc
**/.astro
**/.wrangler
**/*.tsbuildinfo
**/npm-debug.log*
**/pnpm-debug.log*

# desktop (Tauri): the Rust build tree, tauri-build's codegen, the launcher scripts staged out of the commit
# for the bundlers (_tools/scripts/stage-desktop-scripts.sh), and installers staged into the site for a
# local download test (_editor/desktop-app/scripts/stage-local-downloads.sh).
_editor/desktop-app/src-tauri/target
_editor/desktop-app/src-tauri/gen
_editor/desktop-app/src-tauri/staged-scripts
_site/site/public/desktop
# ic (the host-side CLI) and the Windows launcher stub: their Rust build trees.
_sandbox/ic/target
_computers/win-launcher/target
/tmp
**/tmp
**/.astro-indexnow-cache.json

# The interactive demo builds into the marketing site's public/ (see _site/demo/vite.config.ts), which Astro
# copies into its dist — a build artifact living inside a tracked directory, so it is named rather than covered
# by the dist globs above.
_site/site/public/demo

# Benchmark output — every iq-bench run writes a timestamped dir here; the datasets are the input worth keeping.
_search/iq-bench/results

# env / secrets
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Claude Code per-user local settings — never shared across devs.
/.claude/settings.local.json

# Written by semantic-release's successCmd, read by release.yml's `Release` step to tell "published 1.223.0"
# apart from "declined because main moved on". Never committed: it is a fact about one run of one job, on a
# runner whose workspace survives between jobs.
/.release-cut

# The config agent-test-strength.ts generates next to a package's own, to re-run one test with the turn's
# changed source served from HEAD. Written and removed inside a single hook call, so this only ever matches if
# the process died between the two — at which point it is a stray file to overwrite, not a change to review.
.intentic-head.vitest.config.mts

# Stryker's sandbox and incremental state, behind the `test-strength` chore. Configured to /tmp in
# stryker.conf.mjs; named here as well because a run given no config writes them into the repo.
/.stryker-tmp
/reports/mutation

# intentic dogfood / demo (local only)
/.intentic
/intent
/desired-state
/app
/.demo
.image-out
