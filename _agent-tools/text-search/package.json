{
    "name": "@intentic/text-search",
    "version": "0.0.0",
    "private": true,
    "description": "The search box's ripgrep searches: text in files and file names, walked live with no index",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_agent-tools/text-search"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "bun check -p tsconfig.test.json",
        "watch": "tsc --build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "dependencies": {
        "@intentic/base": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/workspace-ignore": "workspace:*"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
