{
    "name": "@intentic-monorepo/root",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git"
    },
    "scripts": {
        "build": "turbo run build",
        "verify": "pnpm typecheck && pnpm test",
        "test": "pnpm prepass && turbo run test --only",
        "typecheck": "pnpm prepass && turbo run typecheck --continue=dependencies-successful",
        "prepass": "node _tools/scripts/prepass.mjs",
        "check:bytes": "node _tools/scripts/control-chars.mjs",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "knip": "knip",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm check:bytes && pnpm build && pnpm typecheck && pnpm lint && pnpm format:check",
        "dev": "pnpm db:up && turbo run dev --filter=@intentic-app/api --filter=@intentic-app/web --filter=@intentic-dev/site",
        "dev:light": "pnpm db:up && turbo run dev --filter=@intentic-app/api --filter=@intentic-app/web",
        "e2e": "turbo run e2e --ui=stream",
        "e2e:browser": "turbo run e2e:browser --ui=stream",
        "e2e:hermetic": "turbo run e2e:hermetic --ui=stream",
        "db:up": "docker compose up -d --wait postgres && pnpm --filter @intentic-app/prisma migrate:deploy",
        "db:down": "docker compose down",
        "db:reset": "docker compose down -v && docker compose up -d --wait postgres && pnpm --filter @intentic-app/prisma migrate:deploy",
        "generate": "pnpm --filter @intentic-app/prisma generate",
        "migrate:dev": "pnpm --filter @intentic-app/prisma migrate:dev",
        "migrate:deploy": "pnpm --filter @intentic-app/prisma migrate:deploy",
        "studio": "pnpm --filter @intentic-app/prisma studio",
        "intentic": "tsgo -b tsconfig.libs.json && node _deploy/cli/dist/cli.js",
        "demo:up": "tsgo -b tsconfig.libs.json && node _deploy/cli/dist/demo.js up",
        "demo:down": "tsgo -b tsconfig.libs.json && node _deploy/cli/dist/demo.js down",
        "demo:clear": "tsgo -b tsconfig.libs.json && node _deploy/cli/dist/demo.js clear",
        "publish:images": "bash _tools/scripts/publish-images.sh",
        "publish:platform-images": "turbo run docker:release --filter=@intentic-app/api --filter=@intentic-app/web",
        "build:sandbox": "bash _tools/scripts/prepare-image-trees.sh && docker build --build-context trees=.image-out -f _sandbox/sandbox/Dockerfile -t intentic-sandbox:dev .",
        "dev:sandbox": "node _sandbox/sandbox/scripts/dev-sandbox.mjs",
        "swap:sandbox": "sh _sandbox/sandbox/scripts/dev-sandbox.sh",
        "rebuild:sandbox": "pnpm build:sandbox && sh _sandbox/sandbox/scripts/dev-sandbox.sh",
        "libs:watch": "nice -n 15 tsgo --build --watch tsconfig.libs.json",
        "prepare": "node _tools/scripts/githooks.mjs",
        "clear": "find . \\( -name 'node_modules' -o -name '.cache' -o -name 'dist' -o -name '.turbo' -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +",
        "cache:clear": "find . \\( -name '.cache' -o -name 'dist' -o -name '.turbo' \\) -prune -exec rm -rf '{}' +",
        "diff:stat": "git diff HEAD --shortstat"
    },
    "devDependencies": {
        "@commitlint/cli": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@commitlint/types": "catalog:",
        "@semantic-release/exec": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "knip": "catalog:",
        "oxlint": "catalog:",
        "prettier": "catalog:",
        "semantic-release": "catalog:",
        "tslib": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.13.1"
    },
    "packageManager": "pnpm@11.13.1"
}
