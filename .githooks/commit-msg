#!/bin/sh
# Checks the message against Conventional Commits via commitlint, and never refuses the commit: no check blocks a land,
# a commit or a push in this repository. What commitlint finds is printed for whoever commits, and the commit goes on.
# Wired by the root `prepare` script, which points git at this dir (core.hooksPath=.githooks) on install, with no
# husky/lefthook framework needed.
#
# Runs the INSTALLED binary, not `bunx commitlint`. Two reasons, and the second is the important one:
# bunx re-resolves the package on every commit, and bun is not on PATH everywhere this repo is committed
# from — the sandbox image ships node only, so `command -v bunx` exited 0 there and the hook checked
# nothing at all. Node runs commitlint fine: its own loader reads commitlint.config.ts, so the TypeScript
# config never needed bun. Skip gracefully if deps aren't installed yet.
[ -x node_modules/.bin/commitlint ] || exit 0
node_modules/.bin/commitlint --edit "$1" || echo "commit-msg: the message above does not follow the convention; committed anyway" >&2
exit 0
