/* Checks the git date helper, the integrations' regressions and the og-images types without emitting build artifacts. */
{
    "extends": "@intentic/tsconfig/tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "types": ["node", "bun", "@intentic/testing/globals"],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": [
        "./src/git-lastmod.mjs",
        "./src/git-lastmod.integration.test.mjs",
        "./src/llms-text.integration.test.ts",
        "./src/og-images.integration.test.ts"
    ],
    "exclude": []
}
