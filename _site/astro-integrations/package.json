{
    "name": "@intentic/astro-integrations",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.mjs"
        },
        "./git-lastmod": "./src/git-lastmod.mjs",
        "./llms-text": "./src/llms-text.mjs",
        "./html-to-markdown": "./src/html-to-markdown.mjs",
        "./docs-search": "./src/docs-search.mjs",
        "./og-images": {
            "types": "./src/og-images.d.ts",
            "default": "./src/og-images.mjs"
        }
    },
    "scripts": {
        "build": "node --check src/index.mjs && node --check src/llms-text.mjs && node --check src/html-to-markdown.mjs && node --check src/docs-search.mjs && node --check src/scorecard.mjs && node --check src/og-images.mjs && node --check src/og-image-url.mjs",
        "typecheck": "bun check -p tsconfig.test.json",
        "test": "suites"
    },
    "dependencies": {
        "@resvg/resvg-js": "catalog:",
        "satori": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:"
    },
    "peerDependencies": {
        "astro": "catalog:"
    }
}
