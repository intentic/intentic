{
    "compilerOptions": {
        "rootDir": "../..",
        "tsBuildInfoFile": "./.cache/tsbuildinfo",
        "types": ["vite/client"],
/* This is the one project that type-checks a Vite config (`./vite.config.ts` below, and the app's `vite.shared.ts` it reaches through). */
        "allowImportingTsExtensions": true,
/* The app's own path map, verbatim: this checks the app's source. */
        "paths": {
            "@intentic/api-contract": ["../../_shared/api-contract/src/index.ts"],
            "@intentic/ui": ["../../_editor/ui/src/index.ts"],
            "@intentic/ui/async": ["../../_editor/ui/src/lib/async.ts"],
            "@intentic/ui/brand-color": ["../../_editor/ui/src/lib/brandColor.ts"],
            "@intentic/ui/brand-mark": ["../../_editor/ui/src/components/brand/brandMark.ts"],
            "@intentic/ui/dag": ["../../_editor/ui/src/components/charts/dagLayout.ts"],
            "@intentic/ui/format": ["../../_editor/ui/src/lib/format.ts"],
            "@intentic/ui/highlighter": ["../../_editor/ui/src/composables/useHighlighter.ts"],
            "@intentic/ui/icons": ["../../_editor/ui/src/icons/iconSets.ts"],
            "@intentic/code-read": ["../../_tools/code-read/src/index.ts"],
            "@intentic/code-read/langs": ["../../_tools/code-read/src/langs.ts"],
            "@intentic/ui/markdown": ["../../_editor/ui/src/markdown/index.ts"],
            "@intentic/ui/notice": ["../../_editor/ui/src/components/feedback/notice.ts"],
            "@intentic/ui/path": ["../../_editor/ui/src/lib/path.ts"],
            "@intentic/ui/series": ["../../_editor/ui/src/components/charts/seriesAccent.ts"],
            "@intentic/ui/text-size": ["../../_editor/ui/src/composables/useTextSize.ts"],
            "@intentic/ui/time": ["../../_editor/ui/src/lib/timeWindow.ts"],
            "@intentic/web/main": ["../../_editor/web/src/main.ts"],
            "@intentic/web/builtins": ["../../_editor/web/src/extension-host/builtins.ts"],
            "@intentic/web/chat-tabs": ["../../_editor/web/src/features/chat/tabs/tabSnapshot.ts"]
        }
    },
/* The app's ambient declarations, for the same reason as the path map above: this checks the app's source. */
    "include": ["./src/**/*.ts", "./vite.config.ts", "../../_editor/web/env.d.ts", "../../_editor/web/src/virtual-modules.d.ts"],
    "extends": "@intentic/tsconfig/tsconfig.vue.json"
}
