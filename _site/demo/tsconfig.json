{
    "compilerOptions": {
        "rootDir": "../..",
        "tsBuildInfoFile": "./.cache/tsbuildinfo",
        "types": ["vite/client"],
        /* This is the one project that type-checks a Vite config (`./vite.config.ts` below, and the app's
         * `vite.shared.ts` it reaches through). A config's relative imports must carry `.ts`: Vite's native
         * config loader — the default in a coming major — resolves them on disk with no extension guessing,
         * and warns today about every extensionless one. Nothing is emitted here (`vue-tsc --noEmit`), so
         * letting the checker read the extension it is looking at costs nothing. */
        "allowImportingTsExtensions": true,
        /* The app's own path map, verbatim — this checks the app's source, so a mapping that differs from
         * _editor/web/tsconfig.json gives one module two identities and every type crossing between them reads
         * as "two different types with this name exist". `@intentic/sandbox-contract` is deliberately NOT here
         * for exactly that reason: web resolves it through node_modules, so the fixture must too.
         * `@intentic-app/web/main` is the app's entry, imported for its side effect of being the app. */
        "paths": {
            "@intentic-app/api-contract": ["../../_platform/api-contract/src/index.ts"],
            "@intentic/ui": ["../../_editor/ui/src/index.ts"],
            "@intentic/ui/async": ["../../_editor/ui/src/lib/async.ts"],
            "@intentic/ui/brand-color": ["../../_editor/ui/src/lib/brandColor.ts"],
            "@intentic/ui/brand-mark": ["../../_editor/ui/src/components/brandMark.ts"],
            "@intentic/ui/dag": ["../../_editor/ui/src/components/dagLayout.ts"],
            "@intentic/ui/format": ["../../_editor/ui/src/lib/format.ts"],
            "@intentic/ui/highlighter": ["../../_editor/ui/src/composables/useHighlighter.ts"],
            "@intentic/ui/icons": ["../../_editor/ui/src/icons/iconSets.ts"],
            "@intentic/ui/langs": ["../../_editor/ui/src/lib/shikiLangs.ts"],
            "@intentic/ui/markdown": ["../../_editor/ui/src/markdown/index.ts"],
            "@intentic/ui/notice": ["../../_editor/ui/src/components/notice.ts"],
            "@intentic/ui/path": ["../../_editor/ui/src/lib/path.ts"],
            "@intentic/ui/series": ["../../_editor/ui/src/components/seriesAccent.ts"],
            "@intentic/ui/text-size": ["../../_editor/ui/src/composables/useTextSize.ts"],
            "@intentic/ui/time": ["../../_editor/ui/src/lib/timeWindow.ts"],
            "@intentic-app/web/main": ["../../_editor/web/src/main.ts"],
            "@intentic-app/web/builtins": ["../../_editor/web/src/extension-host/builtins.ts"],
            "@intentic-app/web/popout-keeper": ["../../_editor/web/src/popout/keeper.ts"],
            "@intentic-app/web/chat-tabs": ["../../_editor/web/src/composables/chat/tabSnapshot.ts"]
        }
    },
    /* The app's ambient declarations, for the same reason as the path map above: this checks the app's source,
     * and an import pulls in modules but never a `.d.ts` nobody references. Without it `import.meta.env.BUILD_ID`
     * is only vite/client's index signature here, and the app's own typing of it is the one this must agree with. */
    "include": ["./src/**/*.ts", "./vite.config.ts", "../../_editor/web/env.d.ts"],
    "extends": "@intentic/tsconfig/tsconfig.vue.json"
}
