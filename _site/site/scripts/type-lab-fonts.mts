#!/usr/bin/env node
// Downloads the type lab's candidate faces and writes their @font-face rules, so the switcher works with no network.
//
//   node --experimental-strip-types scripts/type-lab-fonts.mts
//
// The lab used to pull each face from Google's CDN the moment you picked it, which is fine on a machine that can
// reach fonts.gstatic.com and useless on one that cannot — offline, behind a proxy, or with any of the content
// blockers that list Google Fonts by default. Self-hosting is also what the site already does for its own faces.
//
// Latin only, and deliberately: these are candidates being auditioned on English pages, not the shipped face. The
// winner gets the full subset treatment the shipped faces have. Everything this writes lives under a `lab/` directory
// generated stylesheet, so removing the lab is removing two paths.
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { fetchable } from "../src/lib/typeface.ts";

const here = import.meta.dirname;
const FONT_DIR = join(here, "../public/fonts/lab");
const CSS_FILE = join(here, "../src/styles/type-lab-faces.css");

// Google serves woff2 only to a browser it believes supports it; with node's own agent it answers with ttf.
const UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0 Safari/537.36";

/** One `@font-face` block from Google's stylesheet, with the subset comment that precedes it. */
interface Block {
    subset: string;
    weight: string;
    url: string;
    range: string;
}

const field = (body: string, name: string): string | undefined => new RegExp(`${name}:\\s*([^;]+);`, "u").exec(body)?.[1]?.trim();

const parseBlock = (subset: string, body: string): Block | undefined => {
    const weight = field(body, "font-weight");
    const url = /src:\s*url\(([^)]+)\)/u.exec(body)?.[1]?.trim();
    const range = field(body, "unicode-range");
    return weight === undefined || url === undefined || range === undefined ? undefined : { subset, weight, url, range };
};

const blocksIn = (css: string): Block[] =>
    [...css.matchAll(/\/\*\s*([\w-]+)\s*\*\/\s*@font-face\s*\{([^}]*)\}/gu)]
        .map(([, subset, body]) => parseBlock(subset ?? "", body ?? ""))
        .filter((block): block is Block => block !== undefined);

await mkdir(FONT_DIR, { recursive: true });

const rules: string[] = [
    "/* GENERATED by scripts/type-lab-fonts.mts — do not edit. The type lab's candidate faces, self-hosted so the",
    "   switcher needs no network. Latin only; these are auditions, not the shipped face. */",
];
let written = 0;

const faces = fetchable();
for (const face of faces) {
    const sheet = await fetch(face.google!, { headers: { "User-Agent": UA } });
    if (!sheet.ok) {
        throw new Error(`${face.label}: Google answered ${sheet.status} for ${face.google}`);
    }
    // `latin` exactly, never `latin-ext`: the extended subset doubles the files for characters these pages don't use.
    const latin = blocksIn(await sheet.text()).filter((block) => block.subset === "latin");
    if (latin.length === 0) {
        throw new Error(`${face.label}: no latin subset in ${face.google}`);
    }
    const family = /"([^"]+)"/u.exec(face.stack)?.[1] ?? face.label;

    // NEARLY ALL OF THESE ARE VARIABLE FONTS, and Google's v2 API hides it: ask for three weights and it answers
    // with three blocks that differ only in `font-weight` and point at ONE file. Taken literally that downloads the
    // same bytes three times per family — 24 files where 8 will do. Grouping by URL collapses them back into one
    // face per file, declared over the weight range it actually covers.
    const byUrl = new Map<string, Block[]>();
    for (const block of latin) {
        byUrl.set(block.url, [...(byUrl.get(block.url) ?? []), block]);
    }

    for (const [url, group] of byUrl) {
        const weights = group.map((block) => Number(block.weight)).filter((weight) => Number.isFinite(weight));
        const span = weights.length > 1 ? `${Math.min(...weights)} ${Math.max(...weights)}` : (group[0]?.weight ?? "400");
        const file = `${face.id}-${span.replace(/\s+/gu, "-")}.woff2`;
        const font = await fetch(url, { headers: { "User-Agent": UA } });
        if (!font.ok) {
            throw new Error(`${face.label} ${span}: ${font.status} for ${url}`);
        }
        const bytes = Buffer.from(await font.arrayBuffer());
        await writeFile(join(FONT_DIR, file), bytes);
        written += 1;
        rules.push(
            `@font-face {`,
            `    font-family: "${family}";`,
            `    font-style: normal;`,
            `    font-weight: ${span};`,
            `    font-display: swap;`,
            `    src: url("/fonts/lab/${file}") format("woff2");`,
            `    unicode-range: ${group[0]?.range ?? ""};`,
            `}`,
        );
        console.log(`  ${face.label.padEnd(15)} ${span.padEnd(9)} ${(bytes.length / 1024).toFixed(1).padStart(6)} KB  ${file}`);
    }
}

await writeFile(CSS_FILE, `${rules.join("\n")}\n`);
console.log(`\n${written} files in public/fonts/lab/, ${faces.length} faces declared in src/styles/type-lab-faces.css`);
