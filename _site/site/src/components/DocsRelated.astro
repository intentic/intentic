---
/* The curated "and now this" list at the foot of a page.
 *
 * WHY IT IS NOT CALLED "NEXT" ANY MORE. Ten pages ended with a `## Next` list, and every page already ends with an
 * automatic previous/next footer underneath it. So two things called "next" sat one above the other, naming
 * different pages. They are different things and both are wanted: the footer walks the SHELF in order, and this
 * one crosses shelves for a reason ("connect the system whose events you want to wake on"). Only the label was
 * lying, so the label changed.
 *
 * WHY THE HEADING CARRIES A CLASS. That is the signal docs-headings.ts reads to leave a heading out of the section
 * rail: this is furniture at the end of a page, not a section of it, and "Next" was the one rail entry on those
 * pages that described no content. It keeps its rule and its size, so a reader still sees a boundary.
 *
 * WHY A COMPONENT rather than ten hand-written lists: it was ten hand-written lists, which is how the same idea
 * came to be called "Next" on nine pages and "Where to go next" on the tenth.
 */

export interface DocsRelatedLink {
    /** Absolute path, with an anchor where the reason points at one section. */
    href: string;
    /** The page's own name: the docs tree's title, so the reader recognises the row they will land on. */
    title: string;
    /** Why THIS reader would want it, in a clause. Inline markup allowed; it is the only part that carries any. */
    why: string;
}

interface Props {
    links: DocsRelatedLink[];
}

const { links } = Astro.props;
---

<h2 class="docs-related">Related pages</h2>
<ul>
    {
        links.map((link) => (
            <li>
                <a href={link.href}>{link.title}</a>: <Fragment set:html={link.why} />
            </li>
        ))
    }
</ul>
