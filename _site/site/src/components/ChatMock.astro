---
/* ONE CHAT MOCK, shared. Both the "teammate" Discord thread on the autonomous-employees page and the "in
 * practice" spend-flow on /earn are the same drawing — a chat client with a header, avatar rows (name · role
 * badge · time · bubble) and an input — so they are one component with two datasets rather than two builds
 * that drift. A message can carry an OFFER (the premium-service card) and a RECEIPT; both render as siblings
 * of the text bubble inside the message column, NOT nested inside it, so the spend card is one card on the
 * surface — never a card inside a bubble inside the figure. */

export interface ChatOffer {
    // The service, as the platform lists it, plus the two buttons — the price and balance are one `meta` line
    // so the card stays a single flat surface rather than a grid of labelled rows.
    name: string;
    chip?: string;
    pitch: string;
    meta: string;
    run: string;
    skip: string;
}

export interface ChatMsg {
    author: string;
    agent?: boolean;
    time?: string;
    text?: string;
    offer?: ChatOffer;
    receipt?: string;
}

interface Props {
    thread: ChatMsg[];
    // The context bar: a leading icon (raw SVG, so a caller can pass the Discord mark or a chat glyph), a
    // title, and an optional right-aligned status with a live dot. Omit for a bare thread.
    header?: { icon?: string; title: string; status?: string };
    // The message box drawn at the foot, when the surface has one (a Discord channel does; omit and it's gone).
    input?: string;
    ariaLabel?: string;
    class?: string;
}

const { thread, header, input, ariaLabel, class: klass = "" } = Astro.props;

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

// The agent's avatar and the spend card's marker — kept here so the component is self-contained.
const botGlyph = icon('<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>');
const sparkGlyph = icon('<path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/>');
const checkGlyph = icon('<path d="M20 6 9 17l-5-5"/>');
---

<div class={`card overflow-hidden shadow-xl shadow-black/30 ${klass}`} role="log" aria-label={ariaLabel}>
    {
        header && (
            <div class="flex items-center gap-2 border-b border-line px-4 py-3">
                {header.icon && <span class="text-subtle [&>svg]:h-4 [&>svg]:w-4" set:html={header.icon} />}
                <span class="font-mono text-xs text-content">{header.title}</span>
                {header.status && (
                    <span class="ml-auto flex items-center gap-1.5 text-2xs text-subtle">
                        <span class="h-1.5 w-1.5 rounded-full bg-success" />
                        {header.status}
                    </span>
                )}
            </div>
        )
    }

    <div class="space-y-4 p-4">
        {
            thread.map((msg) => (
                <div class="flex gap-3">
                    {msg.agent ? (
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600/15 text-link [&>svg]:h-[18px] [&>svg]:w-[18px]" set:html={botGlyph} />
                    ) : (
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-overlay text-xs font-semibold text-muted">{msg.author.charAt(0)}</span>
                    )}
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class={`text-xs font-semibold ${msg.agent ? "text-link" : "text-content"}`}>{msg.author}</span>
                            {msg.agent && <span class="rounded bg-primary-600/20 px-1.5 py-0.5 text-[0.625rem] font-semibold tracking-wide text-link uppercase">Agent</span>}
                            {msg.time && <span class="text-2xs text-subtle">{msg.time}</span>}
                        </div>

                        {msg.text && (
                            <div class={`mt-1 inline-block rounded-lg px-3 py-2 text-sm leading-relaxed ${msg.agent ? "border border-primary-600/20 bg-primary-600/[0.05] text-content" : "bg-overlay/60 text-muted"}`}>
                                {msg.text}
                            </div>
                        )}

                        {msg.offer && (
                            /* The spend card — ONE surface on the thread, a sibling of the text above it, not a
                               card inside a bubble. Icon · name · chip in a single header row, one price/balance
                               line, the two buttons; nothing nested. */
                            <div class="mt-2 max-w-md rounded-xl border border-primary-600/30 bg-canvas/60 p-3.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-link [&>svg]:h-4 [&>svg]:w-4" set:html={sparkGlyph} />
                                    <span class="min-w-0 truncate font-mono text-xs font-semibold text-content">{msg.offer.name}</span>
                                    {msg.offer.chip && <span class="chip ml-auto shrink-0 whitespace-nowrap bg-primary-600/15 text-link">{msg.offer.chip}</span>}
                                </div>
                                <p class="mt-2 text-xs leading-relaxed text-muted">{msg.offer.pitch}</p>
                                <p class="mt-2 font-mono text-2xs text-content">{msg.offer.meta}</p>
                                <div class="mt-3 flex flex-wrap items-center gap-2">
                                    <span class="rounded-lg bg-primary-600 px-3 py-1.5 text-xs font-medium text-white">{msg.offer.run}</span>
                                    <span class="rounded-lg border border-line px-3 py-1.5 text-xs font-medium text-muted">{msg.offer.skip}</span>
                                </div>
                            </div>
                        )}

                        {msg.receipt && (
                            /* The receipt — a single quiet line, not a panel: the run settled, so it reads as a
                               caption under the answer rather than another card competing with the offer above. */
                            <div class="mt-2 flex items-center gap-1.5 font-mono text-2xs text-subtle">
                                <span class="text-success [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={checkGlyph} />
                                {msg.receipt}
                            </div>
                        )}
                    </div>
                </div>
            ))
        }

        {input && <div class="flex items-center gap-2 rounded-lg border border-line bg-overlay/40 px-3 py-2 text-xs text-subtle">{input}</div>}
    </div>
</div>
