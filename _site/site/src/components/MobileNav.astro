---
import { deskLanding } from "@intentic/site-content/landing";
import { navEntries } from "@intentic/site-content/nav";
import { APP_URL, discordUrl, githubUrl } from "@intentic/site-content/site";
import DownloadCta from "./DownloadCta.astro";
import { GITHUB_MARK } from "../lib/marks";
import { isCurrentRow, isCurrentSection } from "../lib/navCurrent";
import DiscordIcon from "./DiscordIcon.astro";
import ExternalIcon from "./ExternalIcon.astro";
import NavNiche from "./NavNiche.astro";

// Which product's page this is on (Nav.astro decides and passes it): the sheet's one action is that product's door.
interface Props {
    product?: "default" | "desk";
}

const { product = "default" } = Astro.props;
const currentPath = Astro.url.pathname;
---

{/* THE PHONE'S SHEET is the bar's panel at full height: the same lacquer, the same niches, and room for each row's
    line of description, which the bar's panel has too. The gilt gradient the glyphs are laid in is Nav.astro's. */}
<div class="mobile-nav-overlay" id="mobile-nav-overlay">
    <div class="mobile-nav-inner">
        <ul class="mobile-nav-list">
            {
                navEntries.map((entry) => {
                    if (entry.type === "menu") {
/* THE GROUP YOU ARE INSIDE OPENS WITH THE MENU. */
                        const here = isCurrentSection(entry, currentPath);
                        return (
                            <li class:list={["mobile-nav-group", { expanded: here }]}>
                                <button type="button" class:list={["mobile-nav-heading", { active: here }]} aria-expanded={here ? "true" : "false"}>
                                    {entry.label}
                                    <svg class="mobile-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
                                    </svg>
                                </button>
                                {/* Keep section labels in mobile menus unless the rows already provide the grouping. */}
                                <div class="mobile-subnav">
                                    <ul class="mobile-subnav-inner">
                                    {entry.sections.map((section) => (
                                        <>
                                            {section.label && <li class="mobile-subnav-label">{section.label}</li>}
                                            {section.items.map((item) => (
                                                <li>
                                                    <a
                                                        href={item.href}
                                                        class:list={["mobile-nav-row", { current: isCurrentRow(item, currentPath) }]}
                                                        aria-current={isCurrentRow(item, currentPath) ? "page" : undefined}
                                                        target={item.external ? "_blank" : undefined}
                                                        rel={item.external ? "noopener" : undefined}
                                                    >
                                                        <NavNiche icon={item.icon} />
                                                        <span class="mobile-nav-row-text">
                                                            <span class="mobile-nav-row-label">
                                                                {item.label}
                                                                {item.external && <ExternalIcon />}
                                                            </span>
                                                            {item.description && <span class="mobile-nav-row-blurb">{item.description}</span>}
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </>
                                    ))}
                                    {entry.action && (
                                        <li>
                                            <a
                                                href={entry.action.href}
                                                class="mobile-nav-action"
                                                target={entry.action.external ? "_blank" : undefined}
                                                rel={entry.action.external ? "noopener" : undefined}
                                            >
                                                {entry.action.label}
                                                {entry.action.external ? (
                                                    <ExternalIcon />
                                                ) : (
                                                    <svg class="mobile-nav-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                        <path d="M4 12h15 M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                                                    </svg>
                                                )}
                                            </a>
                                        </li>
                                    )}
                                    </ul>
                                </div>
                            </li>
                        );
                    }

                    if (entry.type === "link") {
                        return (
                            <li class="mobile-nav-group">
                                <a
                                    href={entry.href}
                                    class:list={["mobile-nav-heading", { active: isCurrentSection(entry, currentPath) }]}
                                    aria-current={isCurrentSection(entry, currentPath) ? "page" : undefined}
                                    target={entry.external ? "_blank" : undefined}
                                    rel={entry.external ? "noopener" : undefined}
                                >
                                    {entry.label}
                                    {entry.external && <ExternalIcon />}
                                </a>
                            </li>
                        );
                    }
                })
            }
        </ul>

        {/* The two community doors, side by side as a pair of carved plaques; each name fits half a phone's width. */}
        <div class="mobile-nav-doors">
            <a href={githubUrl} target="_blank" rel="noopener" class="mobile-nav-door">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d={GITHUB_MARK} /></svg>
                GitHub
            </a>
            <a href={discordUrl} target="_blank" rel="noopener" class="mobile-nav-door">
                <DiscordIcon size={18} />
                Discord
            </a>
        </div>

        {
            product === "desk" ? (
                <a class="btn btn-primary mobile-cta" href={APP_URL}>
                    {deskLanding.hero.actions.browser}
                </a>
            ) : (
                <DownloadCta primary class="mobile-cta" icon={false} />
            )
        }
    </div>
</div>

<style>
    /* ── Mobile nav overlay ────────────────────────────── */
    .mobile-nav-overlay {
        position: fixed;
        inset: 0;
/* Hung from the bar, whatever height the carved band works out to at this width. */
        top: var(--bar-height);
        z-index: 99;
/* Opaque for the same reason the desktop menu is: the page behind ghosts through an almost-opaque layer once the blur spreads it. */
        background-color: var(--color-canvas);
        background-image: var(--role-nav-sheen), var(--role-nav-lacquer);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-12px);
        transition:
            opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.28s,
            transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
    /* The bar's gilt foot, carried onto the sheet's top edge so the two read as one object. */
    .mobile-nav-overlay::before {
        content: "";
        position: sticky;
        top: 0;
        display: block;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--color-line-bright) 50%, transparent);
    }

    .mobile-nav-overlay.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .mobile-nav-inner {
        max-width: 32rem;
        margin: 0 auto;
        padding: 0.75rem 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        min-height: calc(100dvh - var(--bar-height));
    }

    .mobile-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
    }
    /* Groups are parted by a hairline, the sheet's own rule at its quietest. */
    .mobile-nav-group + .mobile-nav-group {
        border-top: 1px solid var(--color-line);
    }

    /* ── Headings: a menu's trigger, or a page of its own ─ */
    .mobile-nav-heading {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        width: 100%;
        padding: 1rem 0.5rem;
        font-family: var(--font-mark);
        font-size: 1.25rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-content);
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        transition: color 0.15s;
    }
    .mobile-nav-heading:hover {
        color: var(--color-primary-400);
    }
    /* The group you are in is state: the accent's bright metal, and the bar's ember lozenge set before its name. */
    .mobile-nav-heading.active,
    .mobile-nav-heading.active:hover {
        color: var(--color-gold-bright);
    }
    .mobile-nav-heading.active::before {
        content: "";
        position: absolute;
        top: 50%;
        left: -0.55rem;
        width: 5px;
        height: 5px;
        background: var(--color-primary-500);
        filter: var(--house-ember-mark-glow);
        transform: translateY(-50%) rotate(45deg);
    }
    .mobile-nav-heading:focus-visible {
        outline-offset: -2px;
    }

    .mobile-chevron {
        flex: none;
        opacity: 0.75;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mobile-nav-heading[aria-expanded="true"] .mobile-chevron {
        transform: rotate(180deg);
    }

    /* ── Sub-nav (collapsed by default) ────────────────── */
/* The 0fr→1fr collapse needs exactly ONE grid child, so the grid wraps the list rather than sizing each link. */
    .mobile-subnav {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

/* Hidden overflow lets the collapsed 0fr row reach zero. */
    .mobile-subnav-inner {
        display: grid;
        gap: 0.15rem;
        list-style: none;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }
    .mobile-nav-group.expanded .mobile-subnav {
        grid-template-rows: 1fr;
    }
    .mobile-nav-group.expanded .mobile-subnav-inner {
        padding-bottom: 0.9rem;
    }

    .mobile-subnav-label {
        padding: 0.75rem 0.5rem 0.25rem;
        font-size: var(--text-2xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-gold);
    }

    /* ── Rows: the bar panel's row, a step smaller ─────── */
    .mobile-nav-row {
        --niche-size: 2.625rem;
        --glyph-size: 1.625rem;
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0.4rem 0.5rem;
        text-decoration: none;
    }
    .mobile-nav-row::before {
        --cut: 10px;
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--role-nav-row);
        clip-path: polygon(
            var(--cut) 0,
            calc(100% - var(--cut)) 0,
            100% var(--cut),
            100% calc(100% - var(--cut)),
            calc(100% - var(--cut)) 100%,
            var(--cut) 100%,
            0 calc(100% - var(--cut)),
            0 var(--cut)
        );
        opacity: 0;
        transition: opacity 0.18s ease;
    }
    .mobile-nav-row:hover,
    .mobile-nav-row:focus-visible {
        --niche-lit: 1;
        --niche-sweep: 1;
    }
    .mobile-nav-row:hover::before,
    .mobile-nav-row:focus-visible::before {
        opacity: 1;
    }
    .mobile-nav-row:focus-visible {
        outline-offset: -2px;
    }
    .mobile-nav-row.current {
        --niche-lit: 1;
        --niche-glow: 1;
    }
    .mobile-nav-row-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .mobile-nav-row-label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mark);
        font-size: 1.0625rem;
        font-weight: var(--font-weight-semibold);
        line-height: 1.3;
        color: var(--color-content);
    }
    .mobile-nav-row.current .mobile-nav-row-label {
        color: var(--color-gold-bright);
    }
    .mobile-nav-row-blurb {
        font-size: 0.8125rem;
        line-height: 1.4;
        color: var(--color-subtle);
    }

    /* The group's one action: no niche, its words on the rows' text column, the arrow drawn in the glyphs' hand. */
    .mobile-nav-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 0.5rem 0.4rem calc(0.5rem + 2.625rem + 0.9rem);
        font-family: var(--font-mark);
        font-size: 0.975rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-gold-bright);
        text-decoration: none;
        transition: color 0.15s;
    }
    .mobile-nav-action:hover {
        color: var(--color-primary-400);
    }
    .mobile-nav-arrow {
        width: 0.95rem;
        height: 0.95rem;
    }

    /* ── The community doors ────────────────────────────── */
    .mobile-nav-doors {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-top: 1rem;
    }
    .mobile-nav-door {
        --cut: 9px;
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.8rem 0.75rem;
        background: var(--role-nav-niche-edge);
        clip-path: polygon(
            var(--cut) 0,
            calc(100% - var(--cut)) 0,
            100% var(--cut),
            100% calc(100% - var(--cut)),
            calc(100% - var(--cut)) 100%,
            var(--cut) 100%,
            0 calc(100% - var(--cut)),
            0 var(--cut)
        );
        font-family: var(--font-mark);
        font-size: 0.9375rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .mobile-nav-door::before {
        --inner: calc(var(--cut) - 0.41px);
        content: "";
        position: absolute;
        inset: 1px;
        z-index: -1;
        background: var(--role-nav-niche-well);
        clip-path: polygon(
            var(--inner) 0,
            calc(100% - var(--inner)) 0,
            100% var(--inner),
            100% calc(100% - var(--inner)),
            calc(100% - var(--inner)) 100%,
            var(--inner) 100%,
            0 calc(100% - var(--inner)),
            0 var(--inner)
        );
    }
    .mobile-nav-door:hover {
        color: var(--color-primary-400);
    }
    .mobile-nav-door:focus-visible {
        outline-offset: -3px;
    }

    /* CTA button */
    .mobile-cta {
        margin-top: auto;
        padding-top: 1.5rem;
        width: 100%;
        text-align: center;
    }

/* The mobile navigation hides below the 68rem breakpoint. */
    @media (width > 68rem) {
        .mobile-nav-overlay {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mobile-nav-overlay,
        .mobile-subnav,
        .mobile-chevron {
            transition: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const overlay = document.getElementById("mobile-nav-overlay");
        const toggle = document.getElementById("mobile-nav-open");

        // Accordion toggles
        overlay?.querySelectorAll("button.mobile-nav-heading").forEach((btn) => {
            btn.addEventListener("click", () => {
                const group = btn.closest(".mobile-nav-group");
                const wasExpanded = group?.classList.contains("expanded");

                // Collapse all other groups
                overlay.querySelectorAll(".mobile-nav-group.expanded").forEach((g) => {
                    g.classList.remove("expanded");
                    g.querySelector(".mobile-nav-heading")?.setAttribute("aria-expanded", "false");
                });

                // Toggle the clicked group
                if (!wasExpanded) {
                    group?.classList.add("expanded");
                    btn.setAttribute("aria-expanded", "true");
                }
            });
        });

        // Close on link click
        overlay?.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => {
                overlay.classList.remove("open");
                toggle?.classList.remove("active");
                toggle?.setAttribute("aria-expanded", "false");
                document.body.style.overflow = "";
            });
        });
    });
</script>
