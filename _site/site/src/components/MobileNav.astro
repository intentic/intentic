---
import { navEntries } from "@intentic/site-content/nav";
import { APP_URL, discordUrl, githubUrl } from "@intentic/site-content/site";
import DownloadCta from "./DownloadCta.astro";
import { GITHUB_MARK } from "../lib/marks";
import { isCurrentRow, isCurrentSection } from "../lib/navCurrent";
import { NAV_ICONS } from "../lib/navIcons";
import DiscordIcon from "./DiscordIcon.astro";
import ExternalIcon from "./ExternalIcon.astro";

// Which product's page this is on (Nav.astro decides and passes it): the sheet's one action is that product's door.
interface Props {
    product?: "default" | "desk";
}

const { product = "default" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="mobile-nav-overlay" id="mobile-nav-overlay">
    <div class="mobile-nav-inner">
        <ul class="mobile-nav-list">
            {
                navEntries.map((entry) => {
                    if (entry.type === "menu") {
/* THE GROUP YOU ARE INSIDE OPENS WITH THE MENU. */
                        const here = isCurrentSection(entry, currentPath);
                        return (
                            <li class:list={["mobile-nav-group", { expanded: here }]}>
                                <button type="button" class:list={["mobile-nav-heading", { active: here }]} aria-expanded={here ? "true" : "false"}>
                                    {entry.label}
                                    <svg
                                        class="mobile-chevron"
                                        width="12"
                                        height="7"
                                        viewBox="0 0 12 7"
                                        fill="none"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M1 1L6 6L11 1"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </button>
                                {/* Keep section labels in mobile menus unless the rows already provide the grouping. */}
                                <div class="mobile-subnav">
                                    <ul class="mobile-subnav-inner">
                                    {entry.sections.map((section) => (
                                        <>
                                            {section.label && <li class="mobile-subnav-label">{section.label}</li>}
                                            {section.items.map((item) => (
                                                <li>
                                                    <a
                                                        href={item.href}
                                                        class:list={["mobile-nav-link", "nav-wash", "sub", { current: isCurrentRow(item, currentPath) }]}
                                                        aria-current={isCurrentRow(item, currentPath) ? "page" : undefined}
                                                        target={item.external ? "_blank" : undefined}
                                                        rel={item.external ? "noopener" : undefined}
                                                    >
                                                        {item.icon && NAV_ICONS[item.icon] && (
                                                            <svg
                                                                class="mobile-nav-icon"
                                                                viewBox="0 0 24 24"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                stroke-width="1.6"
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                aria-hidden="true"
                                                                set:html={NAV_ICONS[item.icon]}
                                                            />
                                                        )}
                                                        {item.label}
                                                        {item.external && <ExternalIcon />}
                                                    </a>
                                                </li>
                                            ))}
                                        </>
                                    ))}
                                    {entry.action && (
                                        <li>
                                            <a
                                                href={entry.action.href}
                                                class="mobile-nav-link nav-wash sub action"
                                                target={entry.action.external ? "_blank" : undefined}
                                                rel={entry.action.external ? "noopener" : undefined}
                                            >
                                                {entry.action.label}{" "}
                                                {entry.action.external ? <ExternalIcon /> : <span aria-hidden="true">→</span>}
                                            </a>
                                        </li>
                                    )}
                                    </ul>
                                </div>
                            </li>
                        );
                    }

                    if (entry.type === "link") {
                        return (
                            <li>
                                <a
                                    href={entry.href}
                                    class:list={["mobile-nav-link", "nav-wash", { current: isCurrentSection(entry, currentPath) }]}
                                    aria-current={isCurrentSection(entry, currentPath) ? "page" : undefined}
                                    target={entry.external ? "_blank" : undefined}
                                    rel={entry.external ? "noopener" : undefined}
                                >
                                    {entry.label}
                                    {entry.external && <ExternalIcon />}
                                </a>
                            </li>
                        );
                    }
                })
            }

            <li class="mobile-nav-divider"></li>

            <li>
                <a href={githubUrl} target="_blank" rel="noopener" class="mobile-nav-link nav-wash">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d={GITHUB_MARK} /></svg>
                    GitHub
                </a>
            </li>

            {/* Use the full Discord label because the mobile menu has room for it. */}
            <li>
                <a href={discordUrl} target="_blank" rel="noopener" class="mobile-nav-link nav-wash">
                    <DiscordIcon />
                    Discord community
                </a>
            </li>
        </ul>

        {
            product === "desk" ? (
                <DownloadCta primary class="mobile-cta" icon={false} />
            ) : (
                <a class="btn btn-primary mobile-cta" href={APP_URL}>
                    Create your workspace
                </a>
            )
        }
    </div>
</div>

<style>
    /* ── Mobile nav overlay ────────────────────────────── */
    .mobile-nav-overlay {
        position: fixed;
        inset: 0;
/* Hung from the bar, whatever height the carved band works out to at this width. */
        top: var(--bar-height);
        z-index: 99;
/* Opaque for the same reason the desktop menu is: the page behind ghosts through an almost-opaque layer once the blur spreads it. */
        background: var(--color-canvas);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-12px);
        transition:
            opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.28s,
            transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .mobile-nav-overlay.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .mobile-nav-inner {
        max-width: 32rem;
        margin: 0 auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        min-height: calc(100dvh - var(--bar-height));
    }

    /* List */
    .mobile-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* Links */
/* A row is a label, so it takes the brand face the bar's labels do, and it splits its two states the way the desktop panel does. */
    .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        /* 2px of the left padding is spent on the rule, so a marked row keeps its words on the same vertical. */
        border-left: 2px solid transparent;
        padding: 14px 16px 14px 14px;
        font-family: var(--font-mark);
        font-size: 1.0625rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-muted);
        text-decoration: none;
/* Colour only. */
        transition: color 0.15s;
    }

/* POSITION: the words brighten a step, over `.nav-wash` (global.css) — the same raking light the desktop panel's rows take. */
    .mobile-nav-link:hover,
    .mobile-nav-link:focus-visible {
        color: var(--color-content);
    }

    .mobile-nav-link.sub {
        font-size: 0.975rem;
        padding: 12px 16px 12px 26px;
        color: var(--color-subtle);
    }

    /* The row's line drawing, warming a step with the row the way the desktop panel's does. */
    .mobile-nav-icon {
        flex: none;
        width: 1.05rem;
        height: 1.05rem;
        color: var(--color-gold);
        transition: color 0.15s;
    }
    .mobile-nav-link:hover .mobile-nav-icon,
    .mobile-nav-link:focus-visible .mobile-nav-icon {
        color: var(--color-gold-bright);
    }

    .mobile-nav-link.sub.action {
        color: var(--color-gold-bright);
    }

/* STATE, and after the wash for the reason the desktop panel states it last. */
    .mobile-nav-link.current,
    .mobile-nav-link.current:hover,
    .mobile-nav-link.current:focus-visible {
        border-left-color: var(--color-primary-500);
        color: var(--color-primary-400);
    }
    .mobile-nav-link.current .mobile-nav-icon,
    .mobile-nav-link.current:hover .mobile-nav-icon,
    .mobile-nav-link.current:focus-visible .mobile-nav-icon {
        color: var(--color-primary-400);
    }

    .mobile-subnav-label {
        padding: 12px 16px 4px 28px;
        font-size: var(--text-2xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-gold);
    }

    /* ── Accordion heading ─────────────────────────────── */
    .mobile-nav-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 14px 16px;
        font-family: var(--font-mark);
        font-size: 1.0625rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-content);
        background: none;
        border: none;
        cursor: pointer;
        transition: color 0.15s;
    }

/* A heading is an accordion trigger, not a destination, so it takes no rule — the same split the bar makes. */
    .mobile-nav-heading:hover,
    .mobile-nav-heading.active {
        color: var(--color-primary-400);
    }

    .mobile-chevron {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-nav-heading[aria-expanded="true"] .mobile-chevron {
        transform: rotate(180deg);
    }

    /* ── Sub-nav (collapsed by default) ────────────────── */
/* The 0fr→1fr collapse needs exactly ONE grid child, so the grid wraps the list rather than sizing each link. */
    .mobile-subnav {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

/* Hidden overflow lets the collapsed 0fr row reach zero. */
    .mobile-subnav-inner {
        list-style: none;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .mobile-nav-group.expanded .mobile-subnav {
        grid-template-rows: 1fr;
    }

    /* Divider */
    .mobile-nav-divider {
        height: 1px;
        background: var(--color-line);
        margin: 12px 16px;
    }

    /* CTA button */
    .mobile-cta {
        margin-top: auto;
        padding-top: 1.5rem;
        width: 100%;
        text-align: center;
    }

/* The mobile navigation hides below the 68rem breakpoint. */
    @media (width > 68rem) {
        .mobile-nav-overlay {
            display: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const overlay = document.getElementById("mobile-nav-overlay");
        const toggle = document.getElementById("mobile-nav-open");

        // Accordion toggles
        overlay?.querySelectorAll(".mobile-nav-heading").forEach((btn) => {
            btn.addEventListener("click", () => {
                const group = btn.closest(".mobile-nav-group");
                const wasExpanded = group?.classList.contains("expanded");

                // Collapse all other groups
                overlay.querySelectorAll(".mobile-nav-group.expanded").forEach((g) => {
                    g.classList.remove("expanded");
                    g.querySelector(".mobile-nav-heading")?.setAttribute("aria-expanded", "false");
                });

                // Toggle the clicked group
                if (!wasExpanded) {
                    group?.classList.add("expanded");
                    btn.setAttribute("aria-expanded", "true");
                }
            });
        });

        // Close on link click
        overlay?.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => {
                overlay.classList.remove("open");
                toggle?.classList.remove("active");
                toggle?.setAttribute("aria-expanded", "false");
                document.body.style.overflow = "";
            });
        });
    });
</script>
