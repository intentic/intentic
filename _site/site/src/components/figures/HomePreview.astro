---
/* An illustrative /home conversation, drawn in the site's own palette. */
import Lotus from "../Lotus.astro";
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";

const tasks = [
    { title: "Your workspace", detail: "A place for everything you ask", active: true },
    { title: "Prepare the weekly report", detail: "Ready for your review", active: false },
    { title: "Keep an eye on the inbox", detail: "Runs every morning", active: false },
    { title: "Build the new website", detail: "Working on the first draft", active: false },
];
---

<div class="screen screen-app is-on home-preview" data-screen="app" data-hero-frame="0" role="img" aria-label="Illustrative intentic home view: a personal workspace with a conversation, connected AI models and a computer ready for your first task.">
    <div class="preview-shell" aria-hidden="true">
        <aside class="preview-sidebar">
            <div class="preview-brand"><Lotus /> <span>intentic</span><span class="preview-add">＋</span></div>
            <div class="preview-search">⌕ <span>Search anything</span><span>⌘ K</span></div>
            <div class="preview-section">YOUR WORKSPACE</div>
            {tasks.map((task) => (
                <div class:list={["preview-task", { "preview-task-active": task.active }]}>
                    <span class="preview-task-mark">{task.active ? "⌂" : "◇"}</span>
                    <div><strong>{task.title}</strong><small>{task.detail}</small></div>
                </div>
            ))}
            <div class="preview-sidebar-foot"><span class="preview-online"></span> On your computer <span>↗</span></div>
        </aside>
        <div class="preview-main">
            <div class="preview-topbar"><span>⌂ &nbsp; Home</span><span class="preview-topbar-note">Your private workspace</span></div>
            <div class="preview-conversation">
                <div class="preview-message preview-message-user">Let’s make a little room for good work.</div>
                <div class="preview-response">
                    <div class="preview-avatar"><Lotus /></div>
                    <div class="preview-response-body">
                        <strong class="preview-speaker">intentic <span>· just now</span></strong>
                        <p>I'm ready when you are.</p>
                        <p>Bring your models, connect your tools, and tell me what you have in mind. I'll take it from here.</p>
                        <div class="preview-setup">
                            <div class="preview-setup-heading"><span>Your workspace is ready</span><span class="preview-online"></span></div>
                            <div class="preview-setup-row"><span class="preview-setup-label">Models</span><div class="preview-providers">
                                {([['claude', 'Claude'], ['codex', 'Codex'], ['gemini', 'Gemini']] as const).map(([logo, label]) => (
                                    <span><svg viewBox="0 0 24 24" fill="currentColor"><path d={PROVIDER_BRAND_PATHS[logo]} fill-rule={providerFillRule(logo)} /></svg>{label}</span>
                                ))}
                            </div></div>
                            <div class="preview-setup-row"><span class="preview-setup-label">Computer</span><span>My computer <span class="preview-ready">Connected</span></span></div>
                            <div class="preview-setup-row"><span class="preview-setup-label">Tools</span><span>Browser &nbsp; · &nbsp; Files &nbsp; · &nbsp; Terminal</span></div>
                        </div>
                        <span class="preview-suggestion">What would you like to work on first?</span>
                    </div>
                </div>
            </div>
            <div class="preview-composer"><span>Ask for anything. Make it happen.</span><div><span>＋ &nbsp; <span class="preview-model">Claude · Opus</span></span><span class="preview-send">↑</span></div></div>
            <div class="preview-footnote">Your models. Your computer. Your say.</div>
        </div>
    </div>
</div>

<style>
    .home-preview { height: 100%; color: var(--color-content); background: var(--color-canvas); font-family: var(--font-sans); font-size: 1.26cqw; line-height: 1.55; }
    .preview-shell { display: grid; grid-template-columns: 25% 1fr; height: 100%; }
    .preview-sidebar { display: flex; flex-direction: column; padding: 2.2cqw 1.2cqw 1.5cqw; border-right: 1px solid var(--color-line); background: var(--color-card); }
    .preview-brand { display: flex; align-items: center; gap: 0.7cqw; padding: 0 0.7cqw; font-family: var(--font-mark); font-size: 2cqw; }
    .preview-brand :global(.lotus) { width: 2.5cqw; height: 2.5cqw; }
    .preview-add { margin-left: auto; font: 1.8cqw var(--font-sans); color: var(--color-muted); }
    .preview-search { display: flex; gap: 0.7cqw; align-items: center; margin: 2cqw 0 2.4cqw; padding: 0.7cqw; border: 1px solid var(--color-line); color: var(--color-subtle); font-size: 1.05cqw; }
    .preview-search span:last-child { margin-left: auto; font-size: 0.9cqw; }
    .preview-section { margin: 0 0.8cqw 1cqw; color: var(--color-subtle); font-size: 0.8cqw; letter-spacing: 0.12em; }
    .preview-task { display: flex; gap: 0.8cqw; margin-bottom: 0.5cqw; padding: 1cqw 0.8cqw; }
    .preview-task-active { background: var(--color-overlay); box-shadow: inset 2px 0 var(--color-accent); }
    .preview-task-mark { color: var(--color-accent); font-size: 1.65cqw; }
    .preview-task strong { display: block; font-size: 1.08cqw; font-weight: var(--font-weight-medium); }
    .preview-task small { display: block; margin-top: 0.2cqw; color: var(--color-subtle); font-size: 0.92cqw; }
    .preview-sidebar-foot { display: flex; gap: 0.6cqw; align-items: center; margin-top: auto; padding: 1cqw 0.8cqw 0; border-top: 1px solid var(--color-line); font-size: 0.95cqw; color: var(--color-muted); }
    .preview-sidebar-foot > span:last-child { margin-left: auto; }
    .preview-online { display: inline-block; width: 0.5cqw; height: 0.5cqw; border-radius: 50%; background: var(--color-success); }
    .preview-main { display: flex; flex-direction: column; min-width: 0; }
    .preview-topbar { display: flex; justify-content: space-between; padding: 1.4cqw 2cqw; border-bottom: 1px solid var(--color-line); color: var(--color-muted); font-size: 1.05cqw; }
    .preview-topbar-note { color: var(--color-subtle); font-size: 0.9cqw; }
    .preview-conversation { flex: 1; padding: 2.8cqw 4.7cqw 0; }
    .preview-message-user { width: fit-content; max-width: 90%; margin: 0 0 2.4cqw auto; padding: 1cqw 1.4cqw; background: var(--color-overlay); border: 1px solid var(--color-line); }
    .preview-response { display: flex; gap: 1cqw; }
    .preview-avatar { display: grid; place-items: center; flex-shrink: 0; width: 2.8cqw; height: 2.8cqw; border: 1px solid var(--color-line-strong); background: var(--color-card); }
    .preview-avatar :global(.lotus) { width: 1.8cqw; height: 1.8cqw; }
    .preview-response-body { flex: 1; min-width: 0; }
    .preview-speaker { font-size: 1.12cqw; font-weight: var(--font-weight-medium); }
    .preview-speaker span { margin-left: 0.5cqw; color: var(--color-subtle); font-size: 0.9cqw; font-weight: var(--font-weight-normal); }
    .preview-response p { margin: 0.8cqw 0; }
    .preview-response p + p { color: var(--color-muted); }
    .preview-setup { margin-top: 1.7cqw; border: 1px solid var(--color-line-strong); background: var(--color-card); }
    .preview-setup-heading { display: flex; align-items: center; justify-content: space-between; padding: 1cqw 1.4cqw; border-bottom: 1px solid var(--color-line); font-weight: var(--font-weight-medium); }
    .preview-setup-row { display: flex; align-items: center; gap: 1cqw; padding: 0.85cqw 1.4cqw; font-size: 1.05cqw; }
    .preview-setup-label { width: 7cqw; color: var(--color-subtle); }
    .preview-providers { display: flex; gap: 1.5cqw; }
    .preview-providers > span { display: flex; gap: 0.4cqw; align-items: center; }
    .preview-providers svg { width: 1.3cqw; height: 1.3cqw; }
    .preview-ready { margin-left: 1cqw; color: var(--color-success); font-size: 0.9cqw; }
    .preview-suggestion { display: block; margin-top: 1.4cqw; color: var(--color-muted); }
    .preview-composer { margin: 2cqw 4.7cqw 0 8.5cqw; padding: 1.2cqw 1.4cqw; border: 1px solid var(--color-line-strong); background: var(--color-card); color: var(--color-subtle); }
    .preview-composer > div { display: flex; align-items: center; justify-content: space-between; margin-top: 1.5cqw; }
    .preview-model { font-size: 0.95cqw; color: var(--color-muted); }
    .preview-send { display: grid; place-items: center; width: 2.5cqw; height: 2.5cqw; background: var(--color-accent); color: var(--color-canvas); font-size: 1.5cqw; }
    .preview-footnote { padding: 0.7cqw 0 0.9cqw; text-align: center; color: var(--color-subtle); font-size: 0.8cqw; }
</style>
