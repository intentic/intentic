---
/* OsUpdateFigure: Visual A/B bootc deployment pipeline with greenboot self-healing gate and auto-rollback loop. */
---

<div class="os-update my-6" aria-label="Atomic bootc Updates and greenboot Self-Healing Flow">
    <div class="border border-line bg-card/80 p-5 sm:p-6">
        <!-- Top Status Bar -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line/60 pb-3 font-mono text-3xs">
            <div class="flex items-center gap-2">
                <span class="flex h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
                <span class="font-semibold text-content uppercase">OSTree Atomic Deployments</span>
            </div>
            <span class="text-subtle">bootc switch · greenboot health check · automatic rollback</span>
        </div>

        <!-- 4-Stage Visual Pipeline -->
        <div class="my-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Node 1: Slot A (Booted) -->
            <div class="relative flex flex-col justify-between rounded border border-line bg-canvas p-4 font-mono">
                <div>
                    <div class="flex items-center justify-between text-3xs">
                        <span class="text-gold font-bold">SLOT A</span>
                        <span class="rounded bg-emerald-950/60 px-1.5 py-0.5 text-emerald-400 border border-emerald-500/30">BOOTED</span>
                    </div>
                    <div class="mt-3">
                        <p class="text-xs font-semibold text-content">Current OS</p>
                        <p class="text-3xs text-subtle">/usr strictly read-only</p>
                    </div>
                </div>
                <div class="mt-4 border-t border-line/40 pt-2 text-3xs text-subtle">
                    Running active workloads
                </div>
            </div>

            <!-- Node 2: Background Staging -->
            <div class="relative flex flex-col justify-between rounded border border-line bg-canvas p-4 font-mono">
                <div>
                    <div class="flex items-center justify-between text-3xs">
                        <span class="text-gold font-bold">SLOT B</span>
                        <span class="rounded bg-gold/15 px-1.5 py-0.5 text-gold border border-gold/30">STAGING</span>
                    </div>
                    <div class="mt-3">
                        <p class="text-xs font-semibold text-content">ic os update</p>
                        <p class="text-3xs text-subtle">Pulls container layers in bg</p>
                    </div>
                </div>
                <div class="mt-4 border-t border-line/40 pt-2 text-3xs text-gold">
                    Zero downtime for agents
                </div>
            </div>

            <!-- Node 3: Orderly Reboot -->
            <div class="relative flex flex-col justify-between rounded border border-line bg-canvas p-4 font-mono">
                <div>
                    <div class="flex items-center justify-between text-3xs">
                        <span class="text-gold font-bold">TRANSITION</span>
                        <span class="rounded bg-surface px-1.5 py-0.5 text-subtle border border-line">REBOOT</span>
                    </div>
                    <div class="mt-3">
                        <p class="text-xs font-semibold text-content">State Saved</p>
                        <p class="text-3xs text-subtle">restart-resume.json sealed</p>
                    </div>
                </div>
                <div class="mt-4 border-t border-line/40 pt-2 text-3xs text-subtle">
                    Next boot selects Slot B
                </div>
            </div>

            <!-- Node 4: greenboot Gate -->
            <div class="relative flex flex-col justify-between rounded border border-gold/40 bg-canvas p-4 font-mono">
                <div>
                    <div class="flex items-center justify-between text-3xs">
                        <span class="text-gold font-bold">VERDICT</span>
                        <span class="rounded bg-amber-950/60 px-1.5 py-0.5 text-gold-bright border border-gold/40">GATE</span>
                    </div>
                    <div class="mt-3">
                        <p class="text-xs font-semibold text-content">greenboot</p>
                        <p class="text-3xs text-subtle">Docker &amp; Sandboxes health</p>
                    </div>
                </div>
                <div class="mt-4 border-t border-line/40 pt-2 text-3xs text-emerald-400">
                    3 fails ➔ Auto-revert to A
                </div>
            </div>
        </div>

        <!-- Visual Circuit Strip: Success vs Rollback -->
        <div class="grid gap-3 sm:grid-cols-2 rounded border border-line/60 bg-ground p-3.5 font-mono text-3xs">
            <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-bold">✓</span>
                <div>
                    <span class="font-semibold text-content">Healthy Boot:</span>
                    <span class="text-subtle"> Docker responds within 10 min. Slot B is marked permanent active.</span>
                </div>
            </div>
            <div class="flex items-start gap-2.5">
                <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-gold font-bold">↩</span>
                <div>
                    <span class="font-semibold text-gold">Failed Boot:</span>
                    <span class="text-subtle"> 3 consecutive failed boots trigger automatic GRUB fallback to Slot A.</span>
                </div>
            </div>
        </div>
    </div>
</div>
