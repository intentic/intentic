---
/* OsStackFigure: Visual architectural blueprint showing Sandboxes, the ic Security Boundary, Deterministic Floor, and Bare Metal. */
---

<div class="os-stack my-6" aria-label="Intentic OS Architecture: Sandboxes, Security Boundary, Deterministic Floor, and Hardware">
    <div class="border border-line bg-card/80 p-5 sm:p-6 font-mono text-2xs">
        <!-- 1. Top: Sandboxes Plane -->
        <div class="mb-4">
            <div class="flex items-center justify-between border-b border-line/60 pb-2">
                <span class="text-3xs font-semibold text-gold uppercase">01 · Sandboxes Plane</span>
                <span class="text-3xs text-subtle">Isolated Containers &amp; microVMs</span>
            </div>

            <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <!-- Steward Sandbox -->
                <div class="rounded border border-gold/40 bg-canvas p-3">
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-gold">Steward Sandbox (1st)</span>
                        <span class="rounded bg-gold/10 px-1.5 py-0.2 text-3xs text-gold">Manager</span>
                    </div>
                    <p class="mt-1 text-3xs text-subtle">Controls host Wi-Fi, audio, display &amp; OS updates.</p>
                    <div class="mt-2 flex gap-2 text-3xs">
                        <span class="text-emerald-400">✓ Audited device tools</span>
                        <span class="text-red-400">✗ No root</span>
                    </div>
                </div>

                <!-- Worker Sandboxes -->
                <div class="rounded border border-line bg-canvas p-3">
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-content">Worker Sandboxes</span>
                        <span class="rounded bg-surface px-1.5 py-0.2 text-3xs text-subtle">Workspaces</span>
                    </div>
                    <p class="mt-1 text-3xs text-subtle">Code repos, compiler toolchains, background runs.</p>
                    <div class="mt-2 flex gap-2 text-3xs text-subtle">
                        <span>runc / kata</span>
                        <span>·</span>
                        <span>Bounded swap</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Security Boundary: The Host Authority -->
        <div class="my-4 rounded border border-dashed border-gold/40 bg-gold/5 p-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold">
                        <rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/>
                    </svg>
                    <span class="text-3xs font-bold text-gold uppercase tracking-wider">Security Boundary · Host Authority</span>
                </div>
                <span class="text-3xs text-red-400 font-semibold">Direct Docker socket access blocked</span>
            </div>
            <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-3xs text-subtle border-t border-gold/20 pt-2">
                <span>All requests route through <code class="text-gold font-bold">ic os</code> &amp; <code class="text-gold font-bold">ic sandbox</code></span>
                <span>systemd --user · polkit authority</span>
            </div>
        </div>

        <!-- 3. Deterministic Floor -->
        <div class="mb-4">
            <div class="flex items-center justify-between border-b border-line/60 pb-2">
                <span class="text-3xs font-semibold text-content uppercase">02 · Deterministic Floor</span>
                <span class="text-3xs text-subtle">Runs without any active agent</span>
            </div>

            <div class="mt-3 grid gap-3 sm:grid-cols-3">
                <div class="rounded border border-line bg-canvas p-3">
                    <span class="font-semibold text-gold">bootc ostree</span>
                    <p class="mt-1 text-3xs text-subtle">Immutable Fedora image. /usr strictly read-only.</p>
                </div>
                <div class="rounded border border-line bg-canvas p-3">
                    <span class="font-semibold text-gold">greenboot</span>
                    <p class="mt-1 text-3xs text-subtle">Automatic boot health check &amp; rollback.</p>
                </div>
                <div class="rounded border border-line bg-canvas p-3">
                    <span class="font-semibold text-gold">dockerd</span>
                    <p class="mt-1 text-3xs text-subtle">Host container engine with cgroup v2 limits.</p>
                </div>
            </div>
        </div>

        <!-- 4. Bare Metal Hardware Base -->
        <div class="flex flex-wrap items-center justify-between gap-2 rounded border border-line/50 bg-ground p-3 text-3xs text-subtle">
            <div class="flex items-center gap-2">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold">
                    <rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/>
                </svg>
                <span class="font-bold text-content uppercase">Bare Metal:</span>
            </div>
            <div class="flex flex-wrap gap-2 text-3xs">
                <span class="text-gold">TPM 2.0 (Auto-unlocking LUKS)</span>
                <span>·</span>
                <span>x86-64 UEFI</span>
                <span>·</span>
                <span>NVMe</span>
                <span>·</span>
                <span>NVIDIA GPU Passthrough</span>
            </div>
        </div>
    </div>
</div>
