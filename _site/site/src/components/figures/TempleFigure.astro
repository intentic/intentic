---
/* Three panels, one ground line and one stone grid: what you bring, the agents who carry it, the thing that stands.
   Material and labour are drawn as different things on purpose — a stone is what ends up in the building, a mark on a
   head is the model doing the lifting, and neither can be swapped for the other without the picture saying something
   that is not true. */
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";
import { landingContent } from "@intentic/site-content/landing";
import { templeScene, type TempleControl } from "@intentic/site-content/temple";
import { LOTUS_PETALS } from "../ornaments";

const scene = templeScene;

/* Quarry and temple share one stone grid and ground line. */
const STONE = { w: 38, h: 20 };
const PITCH = { x: 40, y: 22 };
const GROUND = 300;
const PANEL = { quarry: 260, site: 420, temple: 520 };
const VIEW_H = 340;

interface Stone {
    x: number;
    y: number;
}

/** Course returns `n` stones centered at a ground-relative row. */
const course = (cx: number, n: number, row: number): Stone[] => {
    const y = GROUND - STONE.h - row * PITCH.y;
    const x0 = cx - (n * PITCH.x) / 2 + (PITCH.x - STONE.w) / 2;
    return Array.from({ length: n }, (_, i) => ({ x: x0 + i * PITCH.x, y }));
};

/** Two decimals: these are written into attributes verbatim. */
const n = (v: number): number => Math.round(v * 100) / 100;

/* Quarry stones are what the reader brings. Inscriptions are 24×24 and stroked, never filled: a stone is cut into. */
const INSCRIPTIONS = {
    prompt: "M6 8.5 11 12 6 15.5M13 15.5h5.5",
    notes: "M4.5 7.5h15M4.5 12h15M4.5 16.5h9",
    file: "M6.5 4h8l3.5 3.5V20h-11.5zM14.5 4v3.5h3.5",
    code: "M10.5 5.5c-2.2 0-2.6 1.2-2.6 3.2s-.6 2.8-2.4 3.3c1.8.5 2.4 1.3 2.4 3.3s.4 3.2 2.6 3.2M13.5 5.5c2.2 0 2.6 1.2 2.6 3.2s.6 2.8 2.4 3.3c-1.8.5-2.4 1.3-2.4 3.3s-.4 3.2-2.6 3.2",
    data: "M4.5 5.5h15v13h-15zM4.5 12h15M12 5.5v13",
} as const;

const quarryCx = PANEL.quarry / 2;
const quarryStones = [...course(quarryCx, 4, 0), ...course(quarryCx, 3, 1), ...course(quarryCx, 1, 2)];
/* Read in laying order, four then three then one, so the apex is the prompt: the last thing you put on the pile is
   the thing you actually asked for. It repeats rather than runs out, so a course resized here leaves no blank stone. */
const PILE = ["file", "data", "notes", "file", "code", "notes", "data", "prompt"] as const satisfies readonly (keyof typeof INSCRIPTIONS)[];
const quarried = quarryStones.map((stone, index) => ({ ...stone, cut: INSCRIPTIONS[PILE[index % PILE.length]!] }));

/* Temple stones form a three-tier platform and towers. */
const templeCx = PANEL.temple / 2;
const towerLeft = templeCx - 119;
const towerRight = templeCx + 119;
const templeStones: Stone[] = [
    // The platform tapers by one stone on each side per course.
    ...course(templeCx, 12, 0),
    ...course(templeCx, 10, 1),
    ...course(templeCx, 8, 2),
    // The central tower keeps a one-stone shaft at its summit.
    ...course(templeCx, 4, 3),
    ...course(templeCx, 3, 4),
    ...course(templeCx, 3, 5),
    ...course(templeCx, 2, 6),
    ...course(templeCx, 2, 7),
    ...course(templeCx, 1, 8),
    ...course(templeCx, 1, 9),
    // Side towers share the platform and reach its edges.
    ...course(towerLeft, 2, 3),
    ...course(towerLeft, 2, 4),
    ...course(towerLeft, 1, 5),
    ...course(towerLeft, 1, 6),
    ...course(towerRight, 2, 3),
    ...course(towerRight, 2, 4),
    ...course(towerRight, 1, 5),
    ...course(towerRight, 1, 6),
];
/* Temple stones animate from bottom to top. */
const laid = [...templeStones]
    .sort((a, b) => b.y - a.y || a.x - b.x)
    .map((stone, order) => ({ ...stone, order }));

/* Finial position is measured from the highest stone. */
const FINIAL = { size: 52, foot: 44 };
const summitY = Math.min(...laid.map((stone) => stone.y));

/* Every figure at work is an agent, and the mark on its head is the model behind it. The roster IS the cost band's
   account list, so the drawing can never wear a provider the page does not sell, and a provider added there walks onto
   the causeway without anyone posing it. First of the list cuts, last sets, the rest carry. */
const roster = landingContent.economics.accounts;
const cutter = roster[0]!;
const setter = roster[roster.length - 1]!;
const carriers = roster.slice(1, -1);

/* One walk crosses the panel; the CSS reads the duration off the figure so these delays cannot drift from it. */
const WALK = { on: -30, off: 450, span: 9.6, from: 30, to: 396 };
/* The stretch of causeway the terrace takes up. Resting places step over it: reduced motion freezes the crew where
   they stand, and a walker whose resting place is the middle of the panel stands inside you. */
const TERRACE = { from: 168, to: 252 };
const room = WALK.to - WALK.from - (TERRACE.to - TERRACE.from);
const crew = carriers.map((account, index) => {
    /* Two in three walk loaded; the third is going back empty for the next stone. */
    const load = index % 3 !== 2;
    const place = WALK.from + (index * room) / Math.max(carriers.length - 1, 1);
    return {
        logo: account.logo,
        load,
        from: load ? WALK.on : WALK.off,
        to: load ? WALK.off : WALK.on,
        /* Spread by roster order rather than by direction, so no two figures share a resting place either. */
        rest: n(place < TERRACE.from ? place : place + (TERRACE.to - TERRACE.from)),
        delay: n((index * WALK.span) / carriers.length),
    };
});

/* A head with a mark struck into it needs the room: 4 is a dot, and a brand path inside one is a smudge. It sits
   higher than a plain head by the difference, so the neck below it is the length it always was. */
const HEAD = { cy: -40.5, r: 6.5, box: 10 };
const MARK_AT = `translate(${-HEAD.box / 2} ${HEAD.cy - HEAD.box / 2}) scale(${n(HEAD.box / 24)})`;

const CONTROL_ICONS: Record<TempleControl["icon"], string> = {
    // Controls describe what gets built and in what order.
    direct: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M7.5 9.5h9M7.5 13.5h5"/>',
    watch: '<path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3.1"/>',
    approve: '<path d="m4.5 12.6 4.8 4.8L19.5 7.2"/>',
};

const glyph = (paths: string) =>
    `<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---

{/* Screen readers receive the temple's summary label. */}
<figure class="tp" role="img" aria-label={scene.label} style={`--tp-walk:${WALK.span}s`}>
    {/* Shared paint servers keep stone surfaces consistent across panels. */}
    <svg class="tp-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="tp-face" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-gold)" stop-opacity="0.3" />
                <stop offset="1" stop-color="var(--color-gold)" stop-opacity="0.09" />
            </linearGradient>
            <linearGradient id="tp-rock" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-gold)" stop-opacity="0.14" />
                <stop offset="1" stop-color="var(--color-gold)" stop-opacity="0.03" />
            </linearGradient>
            <radialGradient id="tp-halo">
                <stop offset="0" stop-color="var(--color-primary-500)" stop-opacity="0.4" />
                <stop offset="0.55" stop-color="var(--color-primary-500)" stop-opacity="0.12" />
                <stop offset="1" stop-color="var(--color-primary-500)" stop-opacity="0" />
            </radialGradient>
        </defs>
    </svg>

    <div class="tp-scene">
        <!-- The quarry -->
        <div class="tp-stage tp-stage-stone">
            <svg class="tp-panel" viewBox={`0 0 ${PANEL.quarry} ${VIEW_H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
                {/* The quarry face uses stepped benches rather than a mountain silhouette. */}
                <path class="tp-rock" d="M4 300V140h44v34h48v34h52v40h56v52z" />
                <path class="tp-seam" d="M48 174v126M96 208v92M148 248v52" />

                {/* The cutter is the only figure beside an uncut stone: it shapes what you brought before anyone carries it. */}
                <g class="tp-fig" transform={`translate(226 ${GROUND})`}>
                    <circle class="tp-head" cx="0" cy={HEAD.cy} r={HEAD.r} />
                    <g class="tp-brand" transform={MARK_AT}>
                        <path d={PROVIDER_BRAND_PATHS[cutter.logo]} fill-rule={providerFillRule(cutter.logo)} />
                    </g>
                    <path d="M0-34v14" />
                    <path d="M0-31-9-37M0-31 6-24" />
                    {/* Clear of the head, which is wider than a plain one: a mallet resting against the face reads as a wound. */}
                    <g class="tp-mallet">
                        <rect class="tp-load" x="-21" y="-43" width="11" height="8" rx="1" />
                    </g>
                    <path d="M0-20-6 0M0-20 6 0" />
                </g>

                <g class="tp-pile">
                    {
                        quarried.map((stone) => (
                            <g>
                                <rect class="tp-stone" x={stone.x} y={stone.y} width={STONE.w} height={STONE.h} rx="1.5" />
                                <path class="tp-cut" d={stone.cut} transform={`translate(${stone.x + 12} ${stone.y + 3}) scale(0.583)`} />
                            </g>
                        ))
                    }
                </g>

                <path class="tp-ground" d={`M0 ${GROUND}h${PANEL.quarry}`} />
            </svg>
        </div>

        <!-- Site panel: causeway, crew, and viewer terrace. -->
        <div class="tp-stage tp-stage-site">
            <svg class="tp-panel" viewBox={`0 0 ${PANEL.site} ${VIEW_H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
                <path class="tp-ground" d={`M0 ${GROUND}h${PANEL.site}`} />
                {/* Causeway ties use one stone's pitch. */}
                <path class="tp-way" d={`M0 ${GROUND + 12}h${PANEL.site}`} />
                <g class="tp-ties">
                    {
                        Array.from({ length: Math.floor(PANEL.site / PITCH.x) + 1 }, (_, i) => (
                            <path d={`M${i * PITCH.x} ${GROUND}v12`} />
                        ))
                    }
                </g>

                {/* Scaffold provides the vertical link between quarry and temple. */}
                <g class="tp-scaffold">
                    <path d="M336 300V186M384 300V186" />
                    <path d="M336 186h48M336 214h48M336 244h48M336 272h48" />
                    <path d="M336 272 384 244M336 214 384 186" />
                    <rect class="tp-load" x="348" y="176" width="24" height="9" rx="1.5" />
                    <path class="tp-load-rule" d="M353 179.3h14M353 182.1h9" />
                </g>

                <g class="tp-crew">
                    {
                        crew.map((worker) => (
                            <g
                                class:list={["tp-walker", worker.load ? "tp-walker-load" : "tp-walker-back"]}
                                style={`--from:${worker.from}; --to:${worker.to}; --rest:${worker.rest}; --d:${worker.delay}s`}
                            >
                                {/* Carrier keeps the stone below the head so the silhouette reads as a person. */}
                                <g class="tp-fig" transform={`translate(0 ${GROUND})`}>
                                    <circle class="tp-head" cx="0" cy={HEAD.cy} r={HEAD.r} />
                                    <g class="tp-brand" transform={MARK_AT}>
                                        <path d={PROVIDER_BRAND_PATHS[worker.logo]} fill-rule={providerFillRule(worker.logo)} />
                                    </g>
                                    <path d="M0-34v14" />
                                    {worker.load ? <path d="M0-31-8-25M0-31 8-25" /> : <path d="M0-31-5-22M0-31 5-22" />}
                                    {
                                        worker.load && (
                                            <Fragment>
                                                <rect class="tp-load" x="-10" y="-28" width="20" height="9" rx="1.5" />
                                                {/* Two rules on the load: what is being carried is the inscribed stone, not a crate. */}
                                                <path class="tp-load-rule" d="M-6-25.2h12M-6-22.4h7.5" />
                                            </Fragment>
                                        )
                                    }
                                    <g class="tp-legs tp-legs-a"><path d="M0-20-6 0M0-20 6 0" /></g>
                                    <g class="tp-legs tp-legs-b"><path d="M0-20-2 0M0-20 5 0" /></g>
                                </g>
                            </g>
                        ))
                    }
                </g>

                {/* The warm ring identifies the watching position. */}
                <g class="tp-you" transform={`translate(${PANEL.site / 2} ${GROUND + 16})`}>
                    <ellipse class="tp-lantern" cx="0" cy="-30" rx="86" ry="62" fill="url(#tp-halo)" />
                    <path class="tp-dais" d="M-30 0h60v7h-60zM-38 7h76v8h-76z" />
                    {/* Your head matches the crew's in size and stays unfilled: the one figure in the yard wearing no mark. */}
                    <g class="tp-fig tp-fig-you">
                        <circle cx="0" cy="-49" r={HEAD.r} />
                        <path d="M0-42v18" />
                        <path d="M0-38 15-45" />
                        <path d="M0-35-12-30" />
                        <rect class="tp-plan" x="-22" y="-36" width="12" height="15" rx="1.5" />
                        <path d="M0-24-7 0M0-24 7 0" />
                    </g>
                </g>
            </svg>
        </div>

        <!-- The temple -->
        <div class="tp-stage tp-stage-temple">
            <svg class="tp-panel" viewBox={`0 0 ${PANEL.temple} ${VIEW_H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
                <ellipse class="tp-halo" cx={templeCx} cy="200" rx="250" ry="170" fill="url(#tp-halo)" />
                <path class="tp-ground" d={`M0 ${GROUND}h${PANEL.temple}`} />

                <g class="tp-temple">
                    {
                        laid.map((stone) => (
                            <rect class="tp-stone tp-set" x={stone.x} y={stone.y} width={STONE.w} height={STONE.h} rx="1.5" style={`--o:${stone.order}`} />
                        ))
                    }
                </g>

                {/* The arched door distinguishes the temple from a pyramid. */}
                <path class="tp-door" d={`M${templeCx - 15} ${GROUND}v-26a15 15 0 0 1 30 0v26z`} />

                {/* The summit lotus lights when construction completes. */}
                <svg
                    class="tp-finial"
                    x={templeCx - FINIAL.size / 2}
                    y={summitY - FINIAL.foot}
                    width={FINIAL.size}
                    height={FINIAL.size}
                    viewBox="0 -1.3 32 32"
                    set:html={LOTUS_PETALS}
                />

                {/* The setter lifts the arriving stone without moving its ground position. */}
                <g transform={`translate(44 ${GROUND})`}>
                    <g class="tp-setter">
                        <g class="tp-fig">
                            <circle class="tp-head" cx="0" cy={HEAD.cy} r={HEAD.r} />
                            <g class="tp-brand" transform={MARK_AT}>
                                <path d={PROVIDER_BRAND_PATHS[setter.logo]} fill-rule={providerFillRule(setter.logo)} />
                            </g>
                            <path d="M0-34v14" />
                            <path d="M0-31-8-25M0-31 8-25" />
                            <rect class="tp-load" x="-10" y="-28" width="20" height="9" rx="1.5" />
                            <path class="tp-load-rule" d="M-6-25.2h12M-6-22.4h7.5" />
                            <path d="M0-20-6 0M0-20 6 0" />
                        </g>
                    </g>
                </g>
            </svg>
        </div>

        <!-- Captions keep one label and line under each stage. -->
        <div class="tp-cap tp-cap-stone">
            <span class="tp-label">{scene.stone.label}</span>
            <p class="tp-copy">{scene.stone.line}</p>
        </div>

        <div class="tp-cap tp-cap-site">
            <span class="tp-label">{scene.site.label}</span>
            <p class="tp-copy">{scene.site.line}</p>
            <ul class="tp-keeps">
                {
                    scene.site.controls.map((control) => (
                        <li class="tp-keep">
                            <span class="tp-keep-icon" set:html={glyph(CONTROL_ICONS[control.icon])} />
                            <span>{control.label}</span>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="tp-cap tp-cap-temple">
            <span class="tp-label tp-label-lit">{scene.temple.label}</span>
            <p class="tp-copy">{scene.temple.line}</p>
        </div>
    </div>
</figure>

<style>
    /* Canvas layout owns the figure bounds. */
    /* `--tp-walk` is set on the element from WALK.span, not here: the crew's delays are computed against it. */
    .tp {
        container-type: inline-size;
        --tp-cycle: 11s;
        margin: 0;
    }
    .tp-defs {
        position: absolute;
        width: 0;
        height: 0;
    }

    /* Three panels share one responsive grid. */
    .tp-scene {
        display: grid;
        grid-template-columns: minmax(0, 260fr) minmax(0, 420fr) minmax(0, 520fr);
        grid-template-areas:
            "stone     site     temple"
            "cap-stone cap-site cap-temple";
        align-items: start;
    }
    .tp-stage {
        min-width: 0;
    }
    /* Named areas support both side-by-side and stacked layouts. */
    .tp-stage-stone {
        grid-area: stone;
    }
    .tp-stage-site {
        grid-area: site;
    }
    .tp-stage-temple {
        grid-area: temple;
    }
    .tp-cap-stone {
        grid-area: cap-stone;
    }
    .tp-cap-site {
        grid-area: cap-site;
    }
    .tp-cap-temple {
        grid-area: cap-temple;
    }
    .tp-panel {
        display: block;
        width: 100%;
        height: auto;
    }

    /* Drawing styles share one stroke vocabulary. */
    .tp-ground {
        stroke: var(--color-line-bright);
        stroke-width: 1.2;
    }
    .tp-way {
        stroke: var(--color-line);
        stroke-width: 1;
    }
    .tp-ties path {
        stroke: var(--color-line);
        stroke-width: 1;
    }
    .tp-rock {
        fill: url(#tp-rock);
        stroke: var(--color-line);
        stroke-width: 1;
        stroke-linejoin: round;
    }
    .tp-seam {
        stroke: var(--color-line);
        stroke-width: 1;
        opacity: 0.55;
    }
    .tp-scaffold {
        fill: none;
        stroke: var(--color-line-strong);
        stroke-width: 1.4;
        stroke-linecap: round;
    }
    .tp-stone {
        fill: url(#tp-face);
        stroke: var(--color-line-strong);
        stroke-width: 1;
    }
    /* An inscription is cut into the face, so it is stroked; a filled mark would sit on the stone like a sticker. */
    .tp-cut {
        fill: none;
        stroke: var(--color-gold);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.72;
    }

    /* Figures use one rounded stroke and no fill. */
    .tp-fig {
        fill: none;
        stroke: var(--color-gold);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .tp-load {
        fill: url(#tp-face);
        stroke: var(--color-gold);
        stroke-width: 1.4;
    }
    .tp-load-rule {
        fill: none;
        stroke: var(--color-gold);
        stroke-width: 1;
        stroke-linecap: round;
        opacity: 0.6;
    }
    /* A head is a surface here and not an outline, because the mark of the model behind the agent is struck into it. */
    .tp-head {
        fill: url(#tp-face);
    }
    /* Under full gold a dense mark (Claude's burst) fills the head and reads as a lamp rather than a badge. */
    .tp-brand {
        fill: var(--color-gold);
        stroke: none;
        opacity: 0.88;
    }
    .tp-walker-back .tp-fig {
        opacity: 0.45;
    }
    /* The viewer figure uses the warm accent. */
    .tp-fig-you {
        stroke: var(--color-primary-400);
        stroke-width: 2.3;
    }
    .tp-plan {
        fill: var(--role-figure-halo);
        stroke: var(--color-primary-400);
        stroke-width: 1.6;
    }
    .tp-dais {
        fill: url(#tp-face);
        stroke: var(--color-line-bright);
        stroke-width: 1;
    }
    .tp-lantern {
        opacity: 0.5;
    }

    .tp-halo {
        opacity: 0;
    }
    .tp-finial {
        fill: var(--color-primary-400);
        opacity: 0.25;
    }
    /* The doorway uses the plate's dark fill. */
    .tp-door {
        fill: var(--role-figure-doorway);
        stroke: var(--color-line-bright);
        stroke-width: 1.2;
    }

    /* Captions share one layout below each panel. */
    .tp-cap {
        padding: 1.25rem 0 0;
    }
    .tp-cap-site,
    .tp-cap-temple {
        padding-left: 1.5rem;
    }
    .tp-label {
        display: block;
        font-size: 0.625rem;
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.24em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--color-gold);
    }
    .tp-label-lit {
        color: var(--color-primary-400);
    }
    .tp-copy {
        margin: 0.6rem 0 0;
        max-width: 44ch;
        font-size: 0.9375rem;
        line-height: 1.55;
        color: var(--color-muted);
    }

    /* Kept controls render as a row of verbs. */
    .tp-keeps {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.4rem;
        margin: 0.9rem 0 0;
        padding: 0;
        list-style: none;
    }
    .tp-keep {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.875rem;
        line-height: 1.2;
        color: var(--color-content);
    }
    .tp-keep-icon {
        display: flex;
        color: var(--color-primary-400);
    }

    /* Stacked layout pairs each picture with its caption. */
    @container (max-width: 46rem) {
        .tp-scene {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "stone"
                "cap-stone"
                "site"
                "cap-site"
                "temple"
                "cap-temple";
        }
        /* Each panel keeps its own aspect ratio. */
        .tp-panel {
            max-width: 28rem;
            height: auto;
            margin-inline: auto;
        }
        .tp-stage-stone .tp-panel {
            aspect-ratio: 7 / 5;
        }
        .tp-stage-site .tp-panel {
            aspect-ratio: 12 / 5;
        }
        .tp-stage-temple .tp-panel {
            aspect-ratio: 37 / 20;
        }
        .tp-stage-site,
        .tp-stage-temple {
            margin-top: 1.75rem;
        }
        .tp-cap-site,
        .tp-cap-temple {
            padding-left: 0;
        }
        .tp-copy {
            max-width: 46ch;
        }
    }

    /* The build lights each stone in order and holds the completed course. */
    .tp-set {
        opacity: 1;
        animation: tp-lay var(--tp-cycle) linear infinite both;
        animation-delay: calc(var(--o) * 78ms);
    }
    .tp-halo {
        animation: tp-halo var(--tp-cycle) ease-in-out infinite both;
        animation-delay: 4.1s;
    }
    .tp-finial {
        animation: tp-crown var(--tp-cycle) ease-in-out infinite both;
        animation-delay: 4.3s;
    }

    /* Each stone starts dim and brightens only during its own animation. */
    @keyframes tp-lay {
        0% {
            opacity: 0.12;
        }
        6% {
            opacity: 1;
        }
        18%,
        100% {
            opacity: 0.9;
        }
    }
    /* Tower light never fully turns off. */
    @keyframes tp-halo {
        0%,
        100% {
            opacity: 0.4;
        }
        24%,
        64% {
            opacity: 1;
        }
    }
    @keyframes tp-crown {
        0%,
        100% {
            opacity: 0.55;
        }
        18%,
        60% {
            opacity: 1;
        }
    }

    /* Each worker has an animated outer group and a drawing group. */
    .tp-walker {
        transform: translateX(calc(var(--rest) * 1px));
        animation: tp-walk var(--tp-walk) linear infinite both;
        animation-delay: var(--d);
    }
    /* Stride swaps leg groups instead of rotating them. */
    .tp-legs-b {
        opacity: 0;
    }
    .tp-legs {
        animation: tp-step 0.42s steps(1) infinite alternate;
    }
    .tp-legs-b {
        animation-name: tp-step-off;
    }
    /* The stone lands, and the setter straightens up for the next one. */
    .tp-setter {
        animation: tp-place 2.6s ease-in-out infinite;
    }
    /* The mallet taps once per construction cycle. */
    .tp-mallet {
        animation: tp-tap 1.8s ease-in-out infinite;
    }

    @keyframes tp-walk {
        0% {
            transform: translateX(calc(var(--from) * 1px));
        }
        100% {
            transform: translateX(calc(var(--to) * 1px));
        }
    }
    @keyframes tp-step {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }
    @keyframes tp-step-off {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes tp-place {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-6px);
        }
    }
    @keyframes tp-tap {
        0%,
        66%,
        100% {
            transform: translate(0, 0);
        }
        78% {
            transform: translate(2px, 6px);
        }
    }

    /* Reduced motion leaves the completed temple visible. */
    @media (prefers-reduced-motion: reduce) {
        .tp-set,
        .tp-halo,
        .tp-finial,
        .tp-walker,
        .tp-legs,
        .tp-setter,
        .tp-mallet {
            animation: none;
        }
        .tp-halo {
            opacity: 0.9;
        }
        .tp-finial {
            opacity: 1;
        }
