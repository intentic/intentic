---
/* OsPairingFigure: Visual 3-phase zero-touch installation and LAN pairing flow. */
---

<div class="os-pairing my-6" aria-label="Zero-touch setup and pairing flow">
    <div class="border border-line bg-card/80 p-5 sm:p-6 font-mono text-2xs">
        <div class="grid gap-4 lg:grid-cols-3">
            <!-- Phase 1: USB Boot & Unattended Partition -->
            <div class="flex flex-col justify-between rounded border border-line bg-canvas p-4">
                <div>
                    <div class="flex items-center justify-between text-3xs border-b border-line/60 pb-2">
                        <span class="text-gold font-bold">PHASE 01</span>
                        <span class="rounded bg-surface px-1.5 py-0.5 text-subtle border border-line">USB BOOT</span>
                    </div>

                    <div class="my-4 flex flex-col gap-2 rounded border border-line/40 bg-ground p-3 text-3xs">
                        <div class="flex items-center justify-between text-content">
                            <span>Target NVMe Disk</span>
                            <span class="text-emerald-400">Auto-wiped</span>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded bg-surface">
                            <div class="h-full w-full bg-gold/40"></div>
                        </div>
                        <span class="text-subtle">EFI · LUKS Root (TPM 2.0) · Var</span>
                    </div>
                </div>

                <div class="border-t border-line/40 pt-2 text-3xs text-subtle">
                    0 prompts · Automatic disk encryption
                </div>
            </div>

            <!-- Phase 2: Local Beacon & Setup Code -->
            <div class="flex flex-col justify-between rounded border border-line bg-canvas p-4">
                <div>
                    <div class="flex items-center justify-between text-3xs border-b border-line/60 pb-2">
                        <span class="text-gold font-bold">PHASE 02</span>
                        <span class="rounded bg-gold/15 px-1.5 py-0.5 text-gold border border-gold/30">BEACON</span>
                    </div>

                    <div class="my-4 flex flex-col items-center justify-center gap-1.5 rounded border border-line/40 bg-ground p-3 text-center">
                        <span class="font-bold text-gold text-sm tracking-widest">482 - 910</span>
                        <span class="text-3xs text-subtle">Console Setup Code</span>
                        <span class="mt-1 rounded bg-surface px-2 py-0.5 text-3xs text-muted">http://intentic.local</span>
                    </div>
                </div>

                <div class="border-t border-line/40 pt-2 text-3xs text-gold">
                    Local LAN mDNS · Temporary pairing web
                </div>
            </div>

            <!-- Phase 3: Steward Online & Fleet Joined -->
            <div class="flex flex-col justify-between rounded border border-gold/40 bg-canvas p-4">
                <div>
                    <div class="flex items-center justify-between text-3xs border-b border-line/60 pb-2">
                        <span class="text-gold font-bold">PHASE 03</span>
                        <span class="rounded bg-emerald-950/60 px-1.5 py-0.5 text-emerald-400 border border-emerald-500/30">ONLINE</span>
                    </div>

                    <div class="my-4 flex flex-col gap-2 rounded border border-line/40 bg-ground p-3 text-3xs">
                        <div class="flex items-center justify-between">
                            <span class="text-content font-semibold">Steward Sandbox</span>
                            <span class="text-emerald-400">Connected</span>
                        </div>
                        <p class="text-subtle">Local web server terminates permanently.</p>
                        <span class="text-gold">Machine joins your private fleet</span>
                    </div>
                </div>

                <div class="border-t border-line/40 pt-2 text-3xs text-emerald-400">
                    Ready to run coding agents
                </div>
            </div>
        </div>
    </div>
</div>
