---
/* Automation figure shows triggers, checks, and outcomes. */
import { automateMachine, type AutomateTrigger } from "@intentic/site-content/automate";
import Bullet from "../Bullet.astro";

const machine = automateMachine;

/* Event icons use the nav icon stroke grammar. */
const EVENT_ICONS: Record<AutomateTrigger["icon"], string> = {
    push: '<circle cx="12" cy="12" r="3"/><path d="M3 12h6"/><path d="M15 12h6"/>',
    alert: '<path d="M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20.5h15a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/>',
    payment: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/><path d="M6.5 15h3"/>',
    email: '<rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3.5 6.5 7.4 5.3a2 2 0 0 0 2.2 0l7.4-5.3"/>',
    message: '<path d="M20.5 14.5a2 2 0 0 1-2 2H8l-4.5 4v-16a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>',
    schedule: '<circle cx="12" cy="12" r="9"/><path d="M12 6.5V12l3.5 2"/>',
};

const glyph = (paths: string) =>
    `<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---

{/* Screen readers receive the machine's summary label. */}
<figure class="am" role="img" aria-label={machine.label}>
    <div class="am-grid">
        <div class="am-head am-head-events">
            <span class="am-step">01</span>
            <span class="am-label">{machine.events.eyebrow}</span>
        </div>

        <div class="am-body am-body-events">
            <ul class="am-events">
                {
                    machine.events.items.map((trigger, index) => (
                        <li class="am-event" style={`--i:${index}`}>
                            <span class="am-event-icon" set:html={glyph(EVENT_ICONS[trigger.icon])} />
                            <span class="am-event-label">{trigger.label}</span>
                            <span class="am-event-source">{trigger.source}</span>
                        </li>
                    ))
                }
            </ul>
            {/* All event stems converge on one bus. */}
            <span class="am-bus" aria-hidden="true"></span>
        </div>

        <div class="am-rail am-rail-in" aria-hidden="true">
            <span class="am-rail-line"></span>
        </div>

        <div class="am-head am-head-check">
            <span class="am-step">02</span>
            <span class="am-label">{machine.check.eyebrow}</span>
            <span class="am-optional">{machine.check.optional}</span>
        </div>

        <div class="am-body am-body-check">
            <div class="am-node am-gate">
                <div class="am-gate-main">
                    <p class="am-node-title">{machine.check.title}</p>
                    <p class="am-node-body">{machine.check.body}</p>
                </div>
                {/* The command appears on the check panel's bottom rail. */}
                <p class="am-cmd">
                    <span class="am-cmd-caption">{machine.check.example.caption}</span>
                    <code><span aria-hidden="true">$ </span>{machine.check.example.command}</code>
                </p>
            </div>
        </div>

        {/* The check splits into run and skip paths based on exit status. */}
        <div class="am-rail am-rail-out" aria-hidden="true">
            <span class="am-rail-line"></span>
            <span class="am-tag am-tag-pass">
                <code>{machine.check.pass.code}</code>
                <span>{machine.check.pass.note}</span>
            </span>
            <span class="am-fork"></span>
            {/* Skip label is a sibling of the zero-width stub. */}
            <span class="am-tag am-tag-skip">
                <code>{machine.check.skip.code}</code>
                <span>{machine.check.skip.note}</span>
            </span>
        </div>

        <div class="am-head am-head-run">
            <span class="am-step">03</span>
            <span class="am-label">{machine.run.eyebrow}</span>
        </div>

        <div class="am-body am-body-run">
            <div class="am-node am-outcome">
                <p class="am-node-title">
                    <Bullet size="md" />
                    {machine.run.title}
                </p>
                <ul class="am-points">
                    {
                        machine.run.points.map((point) => (
                            <li>
                                <Bullet mark="lozenge" />
                                {point}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</figure>

<style>
    /* Canvas layout owns the figure bounds. */
    .am {
        container-type: inline-size;
        --am-beat: 1.5s;
        --am-cycle: 9s;
        margin: 0;
    }

    .am-grid {
        display: grid;
        gap: 0;
    }

    /* Station heads share one layout. */
    .am-head {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        margin-bottom: 0.9rem;
    }
    .am-step {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: var(--font-weight-semibold);
        line-height: 1;
        color: var(--color-primary-500);
    }
    .am-label {
        font-size: var(--text-2xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.22em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--color-gold);
    }
    /* Optional marks identify skippable checks. */
    .am-optional {
        border: 1px solid var(--color-line);
        padding: 0.15rem 0.45rem;
        font-size: 0.625rem;
        letter-spacing: 0.12em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    /* Event chips form the trigger list. */
    .am-events {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    /* Narrow chips use two lines; wide chips use one. */
    .am-event {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 0.6rem;
        align-items: center;
        border: 1px solid var(--color-line);
        background: var(--role-figure-panel);
        padding: 0.5rem 0.8rem;
        color: var(--color-gold);
        transition:
            border-color 0.4s ease,
            background-color 0.4s ease,
            color 0.4s ease;
    }
    .am-event-icon {
        display: flex;
        flex: none;
        grid-row: 1 / 3;
    }
    .am-event-label {
        font-size: 0.9375rem;
        line-height: 1.3;
        color: var(--color-content);
        white-space: nowrap;
    }
    .am-event-source {
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        line-height: 1.3;
        color: var(--color-subtle);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Rails carry the animated signal between stations. */
    .am-rail {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .am-rail-line {
        position: relative;
        background-repeat: no-repeat;
    }
    .am-rail-line::after {
        content: "";
        position: absolute;
        width: 0;
        height: 0;
    }

    /* Fork labels show exit status and its meaning. */
    .am-tag {
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        line-height: 1.25;
    }
    .am-tag code {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.02em;
    }
    .am-tag span {
        font-size: 0.6875rem;
    }
    .am-tag-pass code {
        color: var(--color-primary-400);
    }
    .am-tag-pass span {
        color: var(--color-muted);
    }
    .am-tag-skip code,
    .am-tag-skip span {
        color: var(--color-subtle);
    }
    /* Skip path is dashed and ends in an open lozenge. */
    .am-fork {
        position: absolute;
        border-color: var(--color-line-strong);
    }
    .am-fork::after {
        content: "";
        position: absolute;
        width: 6px;
        height: 6px;
        border: 1px solid var(--color-line-strong);
        transform: rotate(45deg);
    }

    /* Check and outcome nodes share the node layout. */
    .am-node {
        position: relative;
        padding: 1.1rem 1.2rem;
    }
    .am-gate {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--color-line);
        background: var(--wash-panel);
        padding: 0;
    }
    .am-gate-main {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        padding: 1.15rem 1.25rem;
    }
    .am-node-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        font-size: 1rem;
        line-height: 1.35;
        color: var(--color-content);
    }
    .am-node-body {
        margin: 0.5rem 0 0;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--color-muted);
    }
    /* The command uses the terminal treatment. */
    .am-cmd {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.75rem;
        margin: 0;
        border-top: 1px solid var(--color-line);
        background: var(--role-figure-terminal);
        padding: 0.7rem 1.25rem;
    }
    .am-cmd-caption {
        font-size: 0.625rem;
        letter-spacing: 0.16em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--color-subtle);
    }
    /* Command text wraps instead of clipping. */
    .am-cmd code {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--color-primary-300);
    }
    .am-cmd code span {
        color: var(--color-subtle);
    }
    .am-outcome {
        border: 1px solid var(--role-decision-line);
        background: var(--wash-ember);
        box-shadow: var(--role-ember-glow);
    }
    .am-outcome .am-node-title {
        font-size: 1.0625rem;
    }
    .am-points {
        display: grid;
        gap: 0.45rem;
        margin: 0.85rem 0 0;
        padding: 0;
        list-style: none;
    }
    .am-points li {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-muted);
    }

    /* Stacked layout is the default narrow arrangement. */
    .am-events {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .am-bus,
    .am-event::after {
        display: none;
    }
    .am-rail {
        min-height: 5rem;
        /* Stacked, a rail ends just above the next station's label rather than on it. */
        padding-bottom: 0.6rem;
    }
    .am-rail .am-rail-line {
        width: 1px;
        height: 100%;
        background-image: linear-gradient(180deg, transparent, var(--color-line-strong) 12%, var(--color-line-strong) 88%, transparent),
            linear-gradient(180deg, transparent, var(--color-primary-400), transparent);
        background-size:
            100% 100%,
            100% 45%;
        background-position:
            0 0,
            0 -60%;
    }
    .am-rail .am-rail-line::after {
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 6px solid var(--color-primary-500);
    }
    .am-rail-out .am-tag-pass {
        left: calc(50% + 0.75rem);
        top: 0.35rem;
    }
    /* The dashed exit leaves the same point the solid one does and stops a stub later, with its label beside it. */
    .am-rail-out .am-fork {
        top: 1.6rem;
        right: calc(50% + 1px);
        width: 1.75rem;
        border-top: 1px dashed var(--color-line-strong);
    }
    .am-rail-out .am-fork::after {
        top: -3px;
        left: -3px;
    }
    .am-rail-out .am-tag-skip {
        top: 0.95rem;
        right: calc(50% + 2.5rem);
        width: 8rem;
        text-align: right;
        align-items: flex-end;
    }

    /* Wide layout places stations left to right. */
    @container (min-width: 54rem) {
        /* Wide grid has three stations and two rail columns. */
        .am-grid {
            /* Event column fits its longest label on one line. */
            grid-template-columns:
                clamp(15.75rem, 21cqw, 19rem) clamp(2.5rem, 4cqw, 4rem) minmax(0, 1fr)
                clamp(7.5rem, 11cqw, 10rem) minmax(0, 1.12fr);
            grid-template-rows: auto auto;
            align-items: center;
        }
        .am-head-events {
            grid-area: 1 / 1;
        }
        .am-body-events {
            grid-area: 2 / 1;
        }
        .am-rail-in {
            grid-area: 2 / 2;
        }
        .am-head-check {
            grid-area: 1 / 3;
        }
        .am-body-check {
            grid-area: 2 / 3;
        }
        .am-rail-out {
            grid-area: 2 / 4;
        }
        .am-head-run {
            grid-area: 1 / 5;
        }
        .am-body-run {
            grid-area: 2 / 5;
        }
        .am-head {
            align-self: end;
        }
        /* The two nodes match the event stack's height. */
        .am-body-check,
        .am-body-run {
            align-self: stretch;
        }
        .am-body-check .am-node,
        .am-body-run .am-node {
            display: flex;
            flex-direction: column;
            justify-content: center;
            height: 100%;
        }

        .am-body-events {
            position: relative;
            padding-right: 1.5rem;
        }
        .am-events {
            grid-template-columns: minmax(0, 1fr);
        }
        /* Wide event chips keep each label on one line. */
        .am-event {
            display: flex;
            align-items: baseline;
            gap: 0.6rem;
        }
        .am-event-icon {
            /* Icons align with the event label baseline. */
            transform: translateY(0.25rem);
        }
        /* Each event chip connects to the bus with a stem. */
        .am-event::after {
            content: "";
            display: block;
            position: absolute;
            top: 50%;
            left: 100%;
            width: 1.5rem;
            height: 1px;
            background: var(--color-line-strong);
        }
        .am-bus {
            display: block;
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 1px;
            background: linear-gradient(180deg, transparent, var(--color-line-strong) 8%, var(--color-line-strong) 92%, transparent);
        }

        .am-rail {
            min-height: 0;
            padding-bottom: 0;
            align-self: center;
        }
        .am-rail .am-rail-line {
            width: 100%;
            height: 1px;
            background-image: linear-gradient(90deg, transparent, var(--color-line-strong) 8%, var(--color-line-strong) 92%, transparent),
                linear-gradient(90deg, transparent, var(--color-primary-400), transparent);
            background-size:
                100% 100%,
                40% 100%;
            background-position:
                0 0,
                -50% 0;
        }
        .am-rail .am-rail-line::after {
            top: 50%;
            right: -1px;
            bottom: auto;
            left: auto;
            transform: translateY(-50%);
            border-top: 4px solid transparent;
            border-bottom: 4px solid transparent;
            border-left: 6px solid var(--color-primary-500);
            border-right: 0;
        }

        /* Each label stays centered on its own path. */
        .am-rail-out .am-tag-pass {
            top: auto;
            left: 50%;
            bottom: calc(50% + 0.6rem);
            transform: translateX(-50%);
            width: max-content;
            max-width: 100%;
            text-align: center;
            align-items: center;
        }
        .am-rail-out .am-fork {
            top: 50%;
            left: 0.6rem;
            right: auto;
            width: 0;
            height: 2rem;
            border-top: 0;
            border-left: 1px dashed var(--color-line-strong);
        }
        .am-rail-out .am-fork::after {
            top: auto;
            bottom: -3px;
            left: -3px;
        }
        /* Skip labels stay within the rail column. */
        .am-rail-out .am-tag-skip {
            top: calc(50% + 2.55rem);
            left: 0;
            right: auto;
            width: max-content;
            max-width: 100%;
            text-align: left;
            align-items: flex-start;
        }
    }

    /* Signal animations share the figure cycle. */
    .am-event {
        animation: am-wake var(--am-cycle) linear infinite;
        animation-delay: calc(var(--i) * var(--am-beat));
    }
    .am-event::after {
        animation: am-stem var(--am-cycle) linear infinite;
        animation-delay: calc(var(--i) * var(--am-beat));
    }
    .am-rail-in .am-rail-line {
        animation: am-flow-y var(--am-beat) linear infinite;
    }
    .am-rail-out .am-rail-line {
        animation: am-flow-y var(--am-beat) linear infinite;
        animation-delay: calc(var(--am-beat) / 3);
    }
    /* Outcome highlights when the signal arrives. */
    .am-outcome {
        animation: am-arrive var(--am-beat) ease-out infinite;
        animation-delay: calc(var(--am-beat) * 0.66);
    }
    @container (min-width: 54rem) {
        .am-rail-in .am-rail-line,
        .am-rail-out .am-rail-line {
            animation-name: am-flow-x;
        }
    }

    @keyframes am-wake {
        0% {
            border-color: var(--color-line-bright);
            background-color: var(--role-figure-row-on);
            color: var(--color-primary-400);
        }
        6% {
            border-color: var(--color-line-bright);
            background-color: var(--role-figure-row-on);
            color: var(--color-primary-400);
        }
        20%,
        100% {
            border-color: var(--color-line);
            background-color: var(--role-figure-panel);
            color: var(--color-gold);
        }
    }
    @keyframes am-stem {
        0%,
        6% {
            background: var(--color-primary-500);
        }
        20%,
        100% {
            background: var(--color-line-strong);
        }
    }
    @keyframes am-arrive {
        0% {
            border-color: var(--role-ember-line-strong);
            box-shadow: var(--role-ember-glow-lit);
        }
        50%,
        100% {
            border-color: var(--role-decision-line);
            box-shadow: var(--role-ember-glow);
        }
    }
    @keyframes am-flow-x {
        to {
            background-position:
                0 0,
                150% 0;
        }
    }
    @keyframes am-flow-y {
        to {
            background-position:
                0 0,
                0 160%;
        }
    }

    /* Reduced motion leaves the static figure intact. */
    @media (prefers-reduced-motion: reduce) {
        .am-event,
        .am-event::after,
        .am-rail-line,
        .am-outcome {
            animation: none;
        }
    }
</style>
