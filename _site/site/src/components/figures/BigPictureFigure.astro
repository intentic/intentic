---
/* The big picture: one person signed in once, the sandboxes they are in, and what each reaches. Read at a glance:
   you at the top, one line fanning out through intentic.dev into three sandboxes, each in its own colour. Selecting a
   part opens a peek under the drawing with the detail. The script only draws the lines where the layout put things,
   and lights what the pointer is on. Every word comes from site-content/big-picture.ts. */
import { bigPictureScene, type BigPictureReach, type BigPictureSandbox } from "@intentic/site-content/big-picture";

const scene = bigPictureScene;
const ids = scene.sandboxes.map((sandbox) => sandbox.id);
const lineOf = (id: string) => `line-${id}`;
const worldOf = (id: string) => `world-${id}`;

/* What each part lights. Anything not listed falls back while that part is pointed at or open. */
const lights = {
    you: [`you`, `trunk`, `gate`, ...ids.map(lineOf), ...ids.map(worldOf)],
    platform: [`platform`, `trunk`, `gate`, `ola-line`, `ola-gate`, ...ids.map(lineOf)],
    ola: [`ola`, `ola-line`, `ola-gate`, `world-work`],
    laptop: [`laptop`],
    link: [`link`, `world-home`, `world-game`],
    home: [`world-home`, `line-home`, `trunk`, `gate`, `you`],
    game: [`world-game`, `line-game`, `trunk`, `gate`, `you`],
    work: [`world-work`, `line-work`, `trunk`, `gate`, `you`, `ola`, `ola-line`, `ola-gate`],
} satisfies Record<keyof typeof scene.peeks | BigPictureSandbox["id"], string[]>;

/* Each sandbox's own colour: a hue on the oklch wheel, mixed into whichever skin is on. */
const HUE = { home: 62, game: 162, work: 248 } satisfies Record<BigPictureSandbox["id"], number>;

const ICON = {
    browser: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9.5h18"/>',
    desktop: '<rect x="5" y="5" width="14" height="10" rx="1.5"/><path d="M2.5 18.5h19"/>',
    phone: '<rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M11 17.5h2"/>',
    os: '<path d="M12 3.5v7"/><path d="M6.8 6.8a7.3 7.3 0 1 0 10.4 0"/>',
    person: '<circle cx="12" cy="8.5" r="3.6"/><path d="M5 20a7 7 0 0 1 14 0"/>',
    laptop: '<rect x="5" y="5" width="14" height="10" rx="1.5"/><path d="M2.5 18.5h19"/>',
    cloud: '<path d="M7 18.5h10a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 7.1 9.6 4.5 4.5 0 0 0 7 18.5z"/>',
    server: '<rect x="3.5" y="4.5" width="17" height="6" rx="2"/><rect x="3.5" y="13.5" width="17" height="6" rx="2"/><path d="M7 7.5h.01"/><path d="M7 16.5h.01"/>',
    agent: '<path d="m12 3 1.8 5 5 1.8-5 1.8L12 16.6l-1.8-5-5-1.8 5-1.8z"/>',
    home: '<path d="M4 11 12 4l8 7"/><path d="M6.5 9.5V20h11V9.5"/>',
    branch: '<circle cx="6" cy="5.5" r="2"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="8.5" r="2"/><path d="M6 7.5v9"/><path d="M18 10.5c0 4-6 3-12 6"/>',
    wave: '<path d="M3 12h2"/><path d="M7.5 8v8"/><path d="M12 5v14"/><path d="M16.5 9v6"/><path d="M21 11v2"/>',
    drive: '<path d="M9 4h6l6 10.5-3 5.5H6l-3-5.5z"/>',
    link: '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>',
    close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
};
const glyph = (paths: string, size = 14, width = 1.7) =>
    `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const REACH_ICON = {
    laptop: ICON.laptop,
    phone: ICON.phone,
    assistant: ICON.home,
    server: ICON.server,
    github: ICON.branch,
    elevenlabs: ICON.wave,
    drive: ICON.drive,
} satisfies Record<BigPictureReach["id"], string>;
const keys = (...parts: (string | false | undefined)[]): string => parts.filter(Boolean).join(` `);
const runsIcon = (sandbox: BigPictureSandbox): string =>
    sandbox.host.kind === `hosted` ? ICON.cloud : sandbox.host.laptop ? ICON.laptop : ICON.server;
const plainPeeks = Object.entries(scene.peeks);
---

<figure class="bp" data-bp data-lights={JSON.stringify(lights)} aria-label={scene.label}>
    <div class="bp-board" data-bp-board>
        <svg class="bp-lines" data-bp-lines aria-hidden="true"></svg>

        {/* You, and the screens you sign in from. */}
        <button type="button" class="bp-part bp-you" data-part="you" aria-expanded="false" aria-controls="bp-peek">
            <span class="bp-avatar" data-k="you" set:html={glyph(ICON.person, 22, 1.6)} />
            <span class="bp-you-name" data-k="you">{scene.you.name}</span>
            <span class="bp-screens" data-bp-screens>
                {
                    scene.kiosks.map((kiosk) => (
                        <span class="bp-screen" data-k={keys(`you`, kiosk.laptop && `laptop`)} title={`${kiosk.name}, ${kiosk.line}`} set:html={glyph(ICON[kiosk.id], 15)} />
                    ))
                }
                <span class="bp-screens-label" data-k="you">{scene.you.screens}</span>
            </span>
        </button>

        {/* Ola, who signs in with her own account and is in one of these sandboxes. */}
        <button type="button" class="bp-part bp-ola" data-part="ola" aria-expanded="false" aria-controls="bp-peek" style={`--h:${HUE.work}`}>
            <span class="bp-ola-avatar" data-bp-ola data-k="ola">{scene.colleague.name.slice(0, 1)}</span>
            <span class="bp-ola-text" data-k="ola">
                <span class="bp-ola-name">{scene.colleague.name}</span>
                <span class="bp-ola-line">{scene.colleague.line}</span>
            </span>
        </button>

        {/* intentic.dev: a strip the lines cross, not a box they enter. */}
        <button type="button" class="bp-part bp-band" data-part="platform" data-bp-band data-k="platform" aria-expanded="false" aria-controls="bp-peek">
            <span class="bp-band-name">{scene.platform.name}</span>
            <span class="bp-band-tagline">
                {scene.platform.tagline.map((line) => (
                    <span>{line}</span>
                ))}
            </span>
        </button>

        {/* The sandboxes, each a world of its own colour. */}
        <div class="bp-worlds" data-bp-worlds>
            {
                scene.sandboxes.map((sandbox) => (
                    <div class="bp-world" data-world={sandbox.id} data-k={worldOf(sandbox.id)} style={`--h:${HUE[sandbox.id]}`}>
                        <button
                            type="button"
                            class="bp-part bp-hit"
                            data-part={sandbox.id}
                            aria-expanded="false"
                            aria-controls="bp-peek"
                            aria-label={`Look inside ${sandbox.title}`}
                        />
                        <span class="bp-world-head" data-k={worldOf(sandbox.id)}>
                            <span class="bp-world-title">{sandbox.title}</span>
                            <span class="bp-world-owner">{sandbox.owner}</span>
                        </span>
                        <span class="bp-world-agents" data-k={worldOf(sandbox.id)}>
                            <span class="bp-faces">
                                {sandbox.agents.map((agent) => (
                                    <span class="bp-face" data-state={agent.state} set:html={glyph(ICON.agent, 10, 2)} />
                                ))}
                            </span>
                            <span class="bp-glance">
                                <span>{sandbox.agents.length} agents</span>
                                <span class="bp-glance-state" data-state={sandbox.agents.find((agent) => agent.state !== `working`)?.state}>
                                    {sandbox.glance}
                                </span>
                            </span>
                        </span>
                        <ul class="bp-pills">
                            {sandbox.reaches.map((reach) =>
                                reach.laptop ? (
                                    <li>
                                        <button
                                            type="button"
                                            class="bp-part bp-pill bp-raised"
                                            data-part="laptop"
                                            data-k={keys(worldOf(sandbox.id), `laptop`)}
                                            aria-expanded="false"
                                            aria-controls="bp-peek"
                                        >
                                            <span class="bp-coin" set:html={glyph(REACH_ICON[reach.id], 12)} />
                                            {reach.name}
                                        </button>
                                    </li>
                                ) : (
                                    <li class="bp-pill" data-k={worldOf(sandbox.id)}>
                                        <span class="bp-coin" set:html={glyph(REACH_ICON[reach.id], 12)} />
                                        {reach.name}
                                    </li>
                                ),
                            )}
                        </ul>
                        {sandbox.host.laptop ? (
                            <button
                                type="button"
                                class="bp-part bp-runs bp-raised"
                                data-part="laptop"
                                data-k={keys(worldOf(sandbox.id), `laptop`)}
                                aria-expanded="false"
                                aria-controls="bp-peek"
                            >
                                <span set:html={glyph(runsIcon(sandbox), 14)} />
                                Runs on {sandbox.host.name}
                            </button>
                        ) : (
                            <span class="bp-runs" data-k={worldOf(sandbox.id)}>
                                <span set:html={glyph(runsIcon(sandbox), 14)} />
                                Runs on {sandbox.host.name}
                            </span>
                        )}
                    </div>
                ))
            }
            <button type="button" class="bp-part bp-link" data-part="link" data-bp-link data-k="link" aria-expanded="false" aria-controls="bp-peek" aria-label="Linked sandboxes" set:html={glyph(ICON.link, 13)} />
        </div>
    </div>

    {/* The peek: one part's detail, opened by selecting it. */}
    <div class="bp-peek" id="bp-peek" data-bp-peek data-open="false">
        <div class="bp-peek-clip">
            {
                plainPeeks.map(([id, peek]) => (
                    <section class="bp-peek-card" data-peek={id} hidden style={id === `ola` ? `--h:${HUE.work}` : undefined}>
                        <header class="bp-peek-head">
                            <p class="bp-peek-title">{peek.title}</p>
                            <button type="button" class="bp-close" data-bp-close aria-label="Close" set:html={glyph(ICON.close, 14)} />
                        </header>
                        <p class="bp-peek-body">{peek.body}</p>
                        {peek.facts && (
                            <dl class="bp-facts">
                                {peek.facts.map((fact) => (
                                    <div>
                                        <dt>{fact.label}</dt>
                                        <dd>{fact.value}</dd>
                                    </div>
                                ))}
                            </dl>
                        )}
                    </section>
                ))
            }
            {
                scene.sandboxes.map((sandbox) => (
                    <section class="bp-peek-card" data-peek={sandbox.id} hidden style={`--h:${HUE[sandbox.id]}`}>
                        <header class="bp-peek-head">
                            <p class="bp-peek-title">{sandbox.peek.title}</p>
                            <button type="button" class="bp-close" data-bp-close aria-label="Close" set:html={glyph(ICON.close, 14)} />
                        </header>
                        <p class="bp-peek-body">{sandbox.peek.body}</p>
                        <div class="bp-groups">
                            <div class="bp-group">
                                <p class="bp-group-name">Agents</p>
                                <ul>
                                    {sandbox.agents.map((agent) => (
                                        <li class="bp-agent" data-state={agent.state}>
                                            <span class="bp-agent-task">{agent.task}</span>
                                            <span class="bp-agent-state">{agent.stateLabel}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            <div class="bp-group">
                                <p class="bp-group-name">Reaches</p>
                                <ul>
                                    {sandbox.reaches.map((reach) => (
                                        <li>
                                            {reach.name}
                                            <span class="bp-group-sub">{reach.line}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            <div class="bp-group">
                                <p class="bp-group-name">Keeps</p>
                                <ul>
                                    {[...sandbox.files, ...sandbox.keys].map((item) => (
                                        <li>{item}</li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </section>
                ))
            }
        </div>
    </div>
    <p class="bp-hint" data-bp-hint>{scene.hint}</p>
</figure>

<script>
    // Draws the lines where the layout put things, lights what the pointer or focus is on, and opens a part's peek
    // when it is selected. The lines draw themselves in once, the first time the figure comes into view.
    const SVG = "http://www.w3.org/2000/svg";
    const LEAVE_GRACE_MS = 80;

    for (const figure of document.querySelectorAll<HTMLElement>("[data-bp]")) {
        // SAFETY: written by this component's frontmatter, from `lights`.
        const lights = JSON.parse(figure.dataset.lights ?? "{}") as Record<string, string[] | undefined>;
        const board = figure.querySelector<HTMLElement>("[data-bp-board]");
        const lines = figure.querySelector<SVGSVGElement>("[data-bp-lines]");
        const peek = figure.querySelector<HTMLElement>("[data-bp-peek]");
        if (board === null || lines === null || peek === null) {
            continue;
        }
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const parts = [...figure.querySelectorAll<HTMLButtonElement>("button[data-part]")];
        const lit = [...board.querySelectorAll<HTMLElement>("[data-k]")];
        const cards = [...peek.querySelectorAll<HTMLElement>("[data-peek]")];
        let hovered: string | undefined;
        let open: string | undefined;
        let leaving: ReturnType<typeof setTimeout> | undefined;

        // ── The lines ─────────────────────────────────────────────────────────────────────────────────────────────
        const add = (tag: string, attributes: Record<string, string | number>, parent: Element = lines): SVGElement => {
            const element = document.createElementNS(SVG, tag);
            for (const [name, value] of Object.entries(attributes)) {
                element.setAttribute(name, String(value));
            }
            parent.append(element);
            return element;
        };
        // Leaves straight down and arrives straight down, so every line enters its sandbox from above.
        const drop = (x1: number, y1: number, x2: number, y2: number): string => {
            const bend = (y2 - y1) * 0.55;
            return `C${x1} ${y1 + bend} ${x2} ${y2 - bend} ${x2} ${y2}`;
        };
        const gradient = (id: string, from: [number, number], to: [number, number], stops: [string, string]): string => {
            const defs = lines.querySelector("defs") ?? add("defs", {});
            const element = add("linearGradient", { id, gradientUnits: "userSpaceOnUse", x1: from[0], y1: from[1], x2: to[0], y2: to[1] }, defs);
            add("stop", { offset: 0, "stop-color": stops[0] }, element);
            add("stop", { offset: 1, "stop-color": stops[1] }, element);
            return `url(#${id})`;
        };
        const gate = (x: number, y: number, key: string): void => {
            add("circle", { cx: x, cy: y, r: 10, class: "bp-gate-glow", "data-k": key });
            add("circle", { cx: x, cy: y, r: 4, class: "bp-gate", "data-k": key });
        };

        const draw = (): void => {
            lines.replaceChildren();
            if (getComputedStyle(lines).display === "none") {
                paint();
                return;
            }
            const origin = board.getBoundingClientRect();
            const box = (element: Element | null) => {
                const rect = (element ?? board).getBoundingClientRect();
                const l = rect.left - origin.left;
                const t = rect.top - origin.top;
                return { l, t, w: rect.width, h: rect.height, r: l + rect.width, b: t + rect.height, cx: l + rect.width / 2, cy: t + rect.height / 2 };
            };
            lines.setAttribute("width", String(origin.width));
            lines.setAttribute("height", String(origin.height));
            const tint = (element: Element | null): string => (element === null ? "" : getComputedStyle(element).getPropertyValue("--bp-tint").trim());
            const gold = getComputedStyle(figure).getPropertyValue("--bp-gold").trim();

            const screens = box(board.querySelector("[data-bp-screens]"));
            const band = box(board.querySelector("[data-bp-band]"));
            const x = screens.cx;
            const gateY = band.cy;
            add("path", { d: `M${x} ${screens.b + 8}V${gateY}`, class: "bp-line", stroke: gold, "data-k": "trunk", pathLength: 1, style: "--d:0s" });

            // Through the relay, then out to every sandbox, each line turning that sandbox's colour as it arrives.
            const worlds = [...board.querySelectorAll<HTMLElement>("[data-world]")];
            for (const [index, world] of worlds.entries()) {
                const id = world.dataset.world ?? "";
                const at = box(world);
                const door = id === "work" ? at.l + at.w * 0.38 : at.cx;
                const stroke = gradient(`bp-g-${id}`, [x, gateY], [door, at.t], [gold, tint(world)]);
                add("path", { d: `M${x} ${gateY}${drop(x, gateY, door, at.t)}`, class: "bp-line", stroke, "data-k": `line-${id}`, pathLength: 1, style: `--d:${0.45 + index * 0.08}s` });
                add("circle", { cx: door, cy: at.t, r: 3, class: "bp-door", fill: tint(world), "data-k": `line-${id}` });
            }
            gate(x, gateY, "gate");

            // Ola: her own line, through the relay, into the one sandbox she shares with you.
            const work = board.querySelector<HTMLElement>('[data-world="work"]');
            const ola = box(board.querySelector("[data-bp-ola]"));
            if (work !== null) {
                const at = box(work);
                const door = at.l + at.w * 0.8;
                const stroke = gradient("bp-g-ola", [ola.cx, ola.b], [door, at.t], [tint(work), tint(work)]);
                add("path", { d: `M${ola.cx} ${ola.b + 8}V${gateY}${drop(ola.cx, gateY, door, at.t)}`, class: "bp-line", stroke, "data-k": "ola-line", pathLength: 1, style: "--d:0.7s" });
                add("circle", { cx: door, cy: at.t, r: 3, class: "bp-door", fill: tint(work), "data-k": "ola-line" });
                gate(ola.cx, gateY, "ola-gate");
            }

            // The link: a dotted bridge between the two sandboxes that are both yours, its button at the middle.
            const home = box(board.querySelector('[data-world="home"]'));
            const game = box(board.querySelector('[data-world="game"]'));
            const holder = box(board.querySelector("[data-bp-worlds]"));
            const linkY = home.t + home.h * 0.5;
            add("path", { d: `M${home.r} ${linkY}H${game.l}`, class: "bp-link-line", "data-k": "link" });
            const button = board.querySelector<HTMLElement>("[data-bp-link]");
            if (button !== null) {
                button.style.left = `${(home.r + game.l) / 2 - holder.l}px`;
                button.style.top = `${linkY - holder.t}px`;
            }
            paint();
        };

        // ── The lighting and the peek ─────────────────────────────────────────────────────────────────────────────
        const paint = (): void => {
            const key = hovered ?? open;
            const on = key === undefined ? undefined : lights[key];
            if (on === undefined) {
                delete figure.dataset.active;
            } else {
                figure.dataset.active = key;
            }
            for (const element of [...lit, ...lines.querySelectorAll<SVGElement>("[data-k]")]) {
                if (on === undefined) {
                    element.removeAttribute("data-lit");
                } else {
                    const own = (element.getAttribute("data-k") ?? "").split(" ");
                    element.setAttribute("data-lit", own.some((part) => on.includes(part)) ? "on" : "off");
                }
            }
        };
        // On a phone the sandboxes stack, so a sandbox's peek opens right under it; everywhere else, under the drawing.
        const hint = figure.querySelector("[data-bp-hint]");
        const place = (): void => {
            const world = open === undefined ? null : board.querySelector(`[data-world="${open}"]`);
            if (world !== null && getComputedStyle(lines).display === "none") {
                world.after(peek);
            } else if (peek.parentElement !== figure) {
                figure.insertBefore(peek, hint);
            }
        };
        const show = (next: string | undefined): void => {
            open = next;
            place();
            for (const part of parts) {
                part.setAttribute("aria-expanded", String(part.dataset.part === next));
            }
            for (const card of cards) {
                card.hidden = card.dataset.peek !== next;
            }
            peek.dataset.open = String(next !== undefined);
            figure.dataset.peeking = String(next !== undefined);
            paint();
            if (next !== undefined) {
                // Once the peek has opened, bring it on screen if it landed below the fold.
                setTimeout(() => peek.scrollIntoView({ block: "nearest", behavior: reduced ? "auto" : "smooth" }), reduced ? 0 : 380);
            }
        };
        const point = (next: string | undefined): void => {
            clearTimeout(leaving);
            if (next !== undefined) {
                hovered = next;
                paint();
                return;
            }
            leaving = setTimeout(() => {
                hovered = undefined;
                paint();
            }, LEAVE_GRACE_MS);
        };
        const partOf = (target: EventTarget | null): string | undefined =>
            target instanceof Element ? target.closest<HTMLElement>("[data-part]")?.dataset.part : undefined;

        board.addEventListener("pointerover", (event) => {
            if (event.pointerType === "mouse") {
                point(partOf(event.target));
            }
        });
        board.addEventListener("pointerleave", () => point(undefined));
        board.addEventListener("focusin", (event) => point(partOf(event.target)));
        board.addEventListener("focusout", () => point(undefined));
        for (const part of parts) {
            part.addEventListener("click", () => show(part.dataset.part === open ? undefined : part.dataset.part));
        }
        for (const close of figure.querySelectorAll<HTMLButtonElement>("[data-bp-close]")) {
            close.addEventListener("click", () => {
                const was = open;
                show(undefined);
                parts.find((part) => part.dataset.part === was)?.focus({ preventScroll: true });
            });
        }
        figure.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && open !== undefined) {
                show(undefined);
            }
        });

        // ── Coming into view ──────────────────────────────────────────────────────────────────────────────────────
        if (!reduced) {
            figure.dataset.intro = "waiting";
            const watch = new IntersectionObserver(
                ([entry]) => {
                    if (entry?.isIntersecting === true) {
                        figure.dataset.intro = "playing";
                        setTimeout(() => {
                            delete figure.dataset.intro;
                        }, 2200);
                        watch.disconnect();
                    }
                },
                { threshold: 0.35 },
            );
            watch.observe(figure);
        }
        new ResizeObserver(() => {
            place();
            draw();
        }).observe(board);
        void document.fonts.ready.then(draw);
    }
</script>

<style>
    .bp {
        --bp-gold: color-mix(in oklab, var(--color-gold) 85%, var(--color-content));
        --bp-gap: 1.25rem;
        --bp-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
        --bp-wash: color-mix(in oklab, var(--color-content) 6%, transparent);
        --bp-wash-strong: color-mix(in oklab, var(--color-content) 10%, transparent);
        --bp-dim: 0.3;

        position: relative;
        container-type: inline-size;
        margin: 0;
        border-radius: 28px;
        background: color-mix(in oklab, var(--color-content) 3%, transparent);
        padding: clamp(1.1rem, 3vw, 2rem);
        color: var(--color-content);
    }

    /* A part is a press target with no box at rest; focus is the house's gold ring. */
    .bp-part {
        border: 0;
        background: none;
        padding: 0;
        color: inherit;
        font: inherit;
        text-align: inherit;
        cursor: pointer;
    }
    .bp-part:focus-visible {
        outline: 2px solid var(--color-accent);
