---
/* The big picture: one person signed in once, the sandboxes they are in, and what each of those reaches. The drawing is
   HTML laid out by the grid; the script only draws the wires where the cards landed and switches the lighting. Every
   word comes from site-content/big-picture.ts. */
import { bigPictureScene, type BigPictureReach, type BigPictureStep } from "@intentic/site-content/big-picture";

const scene = bigPictureScene;
const ids = scene.sandboxes.map((sandbox) => sandbox.id);
const each = (prefix: string): string[] => ids.map((id) => `${prefix}-${id}`);

/** What one lighting does to the drawing: `on` glows, `near` stays as drawn, everything else falls back. */
interface Light {
    on: string[];
    near: string[];
    /** The caption shown while it is lit. */
    cap: string;
}

const stepLights = {
    signin: { on: [`kiosk`, `you`, `acct-you`, `w-you`, `w-you-sign`], near: [`platform`], cap: `signin` },
    relay: {
        on: [`platform`, `relay`, `acct-you`, `acct-ola`, `w-you`, `w-you-sign`, `w-ola`, `w-ola-sign`, `w-ola-work`, ...each(`w`)],
        near: [`kiosk`, `you`, `ola`, ...each(`sbx`)],
        cap: `relay`,
    },
    sandboxes: { on: [...each(`sbx`), ...each(`host`), `link`], near: [`agents`, ...each(`keeps`), ...each(`w`)], cap: `sandboxes` },
    reach: { on: [...each(`reach`), ...each(`w-reach`), ...each(`keeps`)], near: [...each(`sbx`), `agents`, ...each(`host`)], cap: `reach` },
    agents: { on: [`agents`], near: [...each(`sbx`), ...each(`keeps`), ...each(`host`)], cap: `agents` },
    laptop: { on: [`laptop`], near: [`sbx-home`, `reach-home`], cap: `laptop` },
    sharing: {
        on: [`ola`, `acct-ola`, `w-ola`, `w-ola-sign`, `w-ola-work`, `sbx-work`, `agents-work`],
        near: [`keeps-work`, `host-work`, `reach-work`, `w-reach-work`, `relay`, `platform`, `w-work`],
        cap: `sharing`,
    },
    "acct-you": { on: [`acct-you`, `w-you-sign`, `w-you`, ...each(`w`), ...each(`sbx`)], near: [`kiosk`, `you`, `platform`, `relay`], cap: `signin` },
} satisfies Record<BigPictureStep["id"] | "acct-you", Light>;
/* Pointing at a sandbox, or at anything it reaches, lights that sandbox's whole column and the path into it. */
const sandboxLights = Object.fromEntries(
    ids.map((id): [string, Light] => [
        `sbx:${id}`,
        {
            on: [`sbx-${id}`, `agents-${id}`, `keeps-${id}`, `host-${id}`, `reach-${id}`, `w-reach-${id}`, `w-${id}`],
            near: [`kiosk`, `you`, `w-you`, `relay`, `platform`, ...(id === `work` ? [`ola`, `acct-ola`, `w-ola`, `w-ola-work`] : [`link`])],
            cap: `sbx:${id}`,
        },
    ]),
);
const lights = { ...stepLights, ...sandboxLights };
const tour = scene.steps.map((step) => step.id);

const ICON = {
    browser: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9.5h18"/>',
    desktop: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M9 20h6"/><path d="M12 16v4"/>',
    phone: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 17.5h2"/>',
    os: '<path d="M12 3.5v7"/><path d="M6.8 6.8a7.3 7.3 0 1 0 10.4 0"/>',
    person: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>',
    key: '<circle cx="8" cy="12" r="3.5"/><path d="M11.5 12H21"/><path d="M17.5 12v3"/><path d="M20.5 12v2.5"/>',
    laptop: '<rect x="5" y="5" width="14" height="10" rx="1.2"/><path d="M2.5 18.5h19"/>',
    cloud: '<path d="M7 18.5h10a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 7.1 9.6 4.5 4.5 0 0 0 7 18.5z"/>',
    server: '<rect x="3" y="5" width="18" height="5.5" rx="1.5"/><rect x="3" y="13.5" width="18" height="5.5" rx="1.5"/><path d="M6.5 7.75h.01"/><path d="M6.5 16.25h.01"/>',
    agent: '<path d="m12 3 1.7 4.8 4.8 1.7-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7z"/><path d="M18 16.5v3"/><path d="M16.5 18h3"/>',
    folder: '<path d="M4 7.5A1.5 1.5 0 0 1 5.5 6h3.2l2 2.2h7.8A1.5 1.5 0 0 1 20 9.7v7.8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z"/>',
    lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/>',
    home: '<path d="M4 11 12 4l8 7"/><path d="M6.5 9.5V20h11V9.5"/>',
    branch: '<circle cx="6" cy="5.5" r="2"/><circle cx="6" cy="18.5" r="2"/><circle cx="18" cy="8.5" r="2"/><path d="M6 7.5v9"/><path d="M18 10.5c0 4-6 3-12 6"/>',
    wave: '<path d="M3 12h2"/><path d="M7.5 8v8"/><path d="M12 5v14"/><path d="M16.5 9v6"/><path d="M21 11v2"/>',
    drive: '<path d="M12 4 21 19H3z"/>',
    pause: '<path d="M9 5v14"/><path d="M15 5v14"/>',
    play: '<path d="M7 4.5v15l12-7.5z"/>',
};
const glyph = (paths: string, size = 14) =>
    `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const REACH_ICON = {
    laptop: ICON.laptop,
    phone: ICON.phone,
    assistant: ICON.home,
    server: ICON.server,
    github: ICON.branch,
    elevenlabs: ICON.wave,
    drive: ICON.drive,
} satisfies Record<BigPictureReach["id"], string>;
const keys = (...parts: (string | false | undefined)[]): string => parts.filter(Boolean).join(` `);
---

<figure class="bp" data-bp data-lights={JSON.stringify(lights)} data-tour={JSON.stringify(tour)} data-paused="false" data-beat="a">
    {/* The steps. Buttons, so a reader can stop on one; the tour walks them while the figure is on screen. */}
    <div class="bp-tabs" role="group" aria-label="Show one part of the picture at a time">
        {
            scene.steps.map((step, index) => (
                <button type="button" class="bp-tab" data-bp-go={step.id} aria-pressed="false">
                    <span class="bp-tab-num">{String(index + 1).padStart(2, `0`)}</span>
                    <span class="bp-tab-name">{step.tab}</span>
                    <span class="bp-tab-bar" aria-hidden="true" />
                </button>
            ))
        }
        <button type="button" class="bp-play" data-bp-play aria-label="Pause the tour" data-label-pause="Pause the tour" data-label-play="Play the tour">
            <span class="bp-play-pause" set:html={glyph(ICON.pause, 13)} />
            <span class="bp-play-play" set:html={glyph(ICON.play, 13)} />
        </button>
    </div>

    <div class="bp-caption" data-bp-captions>
        <div class="bp-cap" data-cap="" data-on="true">
            <p class="bp-cap-title">{scene.heading}</p>
            <p class="bp-cap-body">{scene.sub}</p>
        </div>
        {
            scene.steps.map((step, index) => (
                <div class="bp-cap" data-cap={step.id}>
                    <p class="bp-cap-title">
                        <span class="bp-cap-num">{String(index + 1).padStart(2, `0`)}</span>
                        {step.title}
                    </p>
                    <p class="bp-cap-body">{step.body}</p>
                </div>
            ))
        }
        {
            scene.sandboxes.map((sandbox) => (
                <div class="bp-cap" data-cap={`sbx:${sandbox.id}`}>
                    <p class="bp-cap-title">{sandbox.caption.title}</p>
                    <p class="bp-cap-body">{sandbox.caption.body}</p>
                </div>
            ))
        }
    </div>

    {/* The drawing. Screen readers get the same story from the label at the foot and the captions above. */}
    <div class="bp-board" data-bp-board aria-hidden="true">
        <svg class="bp-wires" data-bp-wires></svg>

        {/* ── Where people sign in ── */}
        <div class="bp-you">
            <p class="bp-col" data-k="you" data-hover="signin">
                <span class="bp-icon" set:html={glyph(ICON.person, 15)} />
                You sign in from
            </p>
            <ul class="bp-kiosks">
                {
                    scene.kiosks.map((kiosk) => (
                        <li class="bp-kiosk" data-bp-kiosk data-k={keys(`kiosk`, `kiosk-${kiosk.id}`, kiosk.laptop && `laptop`)} data-hover={kiosk.laptop ? `laptop` : `signin`}>
                            <span class="bp-icon" set:html={glyph(ICON[kiosk.id], 16)} />
                            <span class="bp-kiosk-name">{kiosk.name}</span>
                            <span class="bp-kiosk-line">{kiosk.line}</span>
                            {kiosk.laptop && <span class="bp-same">same laptop</span>}
                        </li>
                    ))
                }
            </ul>
        </div>
        <div class="bp-ola" data-k="ola" data-hover="sharing">
            <p class="bp-col">
                <span class="bp-icon" set:html={glyph(ICON.person, 15)} />
                {scene.colleague.name}, {scene.colleague.line}
            </p>
            <div class="bp-kiosk bp-kiosk-ola" data-bp-ola-kiosk>
                <span class="bp-icon" set:html={glyph(ICON.browser, 16)} />
                <span class="bp-kiosk-name">Browser</span>
                <span class="bp-kiosk-line">{scene.colleague.kiosk}</span>
            </div>
        </div>

        {/* ── intentic.dev: the accounts and the address book beside the path, the relay across it ── */}
        <div class="bp-band" data-bp-band data-k="platform" data-hover="relay">
            <span class="bp-band-tag">{scene.platform.name}</span>
            <div class="bp-band-row">
                <div class="bp-account" data-bp-acct="you" data-k="acct-you" data-hover="acct-you">
                    <span class="bp-icon" set:html={glyph(ICON.key, 15)} />
                    <span class="bp-account-text">
                        <span class="bp-account-name">Your account</span>
                        <span class="bp-account-line">one sign-in</span>
                    </span>
                </div>
                <div class="bp-knows" data-bp-knows data-k="platform">
                    <p>{scene.platform.knows}</p>
                    <p>{scene.platform.relay}</p>
                </div>
                <div class="bp-account" data-bp-acct="ola" data-k="acct-ola" data-hover="sharing">
                    <span class="bp-icon" set:html={glyph(ICON.key, 15)} />
                    <span class="bp-account-text">
                        <span class="bp-account-name">Ola's account</span>
                        <span class="bp-account-line">her own</span>
                    </span>
                </div>
            </div>
            <div class="bp-relay" data-bp-relay data-k="relay">
                <span class="bp-relay-tag">{scene.platform.relayTag}</span>
            </div>
        </div>

        {/* ── The sandboxes, each standing on the machine it runs on, with what it reaches below ── */}
        <div class="bp-sites">
            {
                scene.sandboxes.map((sandbox) => (
                    <div class="bp-site" data-bp-site={sandbox.id}>
                        <div class="bp-wall" data-bp-wall data-k={`sbx-${sandbox.id}`} data-hover={`sbx:${sandbox.id}`}>
                            <span class="bp-plaque" data-k={`sbx-${sandbox.id}`}>{sandbox.name}</span>
                            <div class="bp-court" data-bp-court>
                                <p class="bp-purpose" data-k={`sbx-${sandbox.id}`}>
                                    <span class="bp-purpose-name">{sandbox.purpose}</span>
                                    <span class="bp-purpose-owner">{sandbox.owner}</span>
                                </p>
                                <ul class="bp-agents">
                                    {sandbox.agents.map((agent) => (
                                        <li class="bp-agent" data-k={`agents agents-${sandbox.id}`} data-state={agent.state}>
                                            <span class="bp-icon bp-agent-icon" set:html={glyph(ICON.agent, 12)} />
                                            <span class="bp-agent-text">
                                                <span class="bp-agent-task">{agent.task}</span>
                                                <span class="bp-agent-state">
                                                    <span class="bp-dot" />
                                                    {agent.stateLabel}
                                                </span>
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                                <div class="bp-keeps" data-k={`keeps-${sandbox.id}`}>
                                    {sandbox.files.map((file) => (
                                        <span class="bp-keep">
                                            <span set:html={glyph(ICON.folder, 11)} />
                                            {file}
                                        </span>
                                    ))}
                                    {sandbox.keys.map((key) => (
                                        <span class="bp-keep bp-keep-key">
                                            <span set:html={glyph(ICON.lock, 11)} />
                                            {key}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                        <div
                            class="bp-plinth"
                            data-bp-plinth
                            data-k={keys(`host-${sandbox.id}`, sandbox.host.laptop && `laptop`)}
                            data-hover={sandbox.host.laptop ? `laptop` : `sbx:${sandbox.id}`}
                        >
                            <span class="bp-icon" set:html={glyph(sandbox.host.kind === `hosted` ? ICON.cloud : sandbox.host.laptop ? ICON.laptop : ICON.server, 13)} />
                            <span class="bp-plinth-label">runs on</span>
                            <span class="bp-plinth-name">{sandbox.host.name}</span>
                            {sandbox.host.laptop && <span class="bp-same">same laptop</span>}
                        </div>
                        <ul class="bp-reach" data-bp-reach data-k={`reach-${sandbox.id}`}>
                            <li class="bp-reach-head" data-k={`reach-${sandbox.id}`}>
                                reaches
                            </li>
                            {sandbox.reaches.map((reach) => (
                                <li
                                    class="bp-reach-item"
                                    data-bp-reach-item
                                    data-k={keys(`reach-${sandbox.id}`, `reach-${sandbox.id}-${reach.id}`, reach.laptop && `laptop`)}
                                    data-hover={reach.laptop ? `laptop` : `sbx:${sandbox.id}`}
                                >
                                    <span class="bp-icon" set:html={glyph(REACH_ICON[reach.id], 13)} />
                                    <span class="bp-reach-name">{reach.name}</span>
                                    <span class="bp-reach-line">{reach.line}</span>
                                    {reach.laptop && <span class="bp-same">same laptop</span>}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
            <span class="bp-link-tag" data-bp-link-tag data-k="link">{scene.link.label}</span>
        </div>
    </div>

    <div class="bp-foot">
        <div class="bp-legend">
            <span class="bp-legend-item"><span class="bp-legend-line" />a screen's traffic, through the relay</span>
            <span class="bp-legend-item"><span class="bp-legend-line bp-legend-dotted" />signs in as</span>
            <span class="bp-legend-item"><span class="bp-legend-line bp-legend-dashed" />{scene.link.label}: {scene.link.line}</span>
        </div>
    </div>
    <p class="sr-only">{scene.label}</p>
</figure>

<script>
    // Draws the wires from where the cards landed, and switches the lighting. The pointer over a part previews its
    // lighting and holds the tour; a press on a tab keeps that step; the play button carries the tour on.
    interface Light {
        on: string[];
        near: string[];
        cap: string;
    }

    const BEAT_MS = 6500;
    const LEAVE_GRACE_MS = 90;
    const SVG = "http://www.w3.org/2000/svg";

    for (const figure of document.querySelectorAll<HTMLElement>("[data-bp]")) {
        // SAFETY: both attributes are written by this component's frontmatter.
        const lights = JSON.parse(figure.dataset.lights ?? "{}") as Record<string, Light | undefined>;
        // SAFETY: as above, the tour is the list of step ids the frontmatter wrote.
        const tour = JSON.parse(figure.dataset.tour ?? "[]") as string[];
        const board = figure.querySelector<HTMLElement>("[data-bp-board]");
        const wires = figure.querySelector<SVGSVGElement>("[data-bp-wires]");
        if (board === null || wires === null) {
            continue;
        }
        const reduced = matchMedia("(prefers-reduced-motion: reduce)");
        const tabs = [...figure.querySelectorAll<HTMLButtonElement>("[data-bp-go]")];
        const captions = [...figure.querySelectorAll<HTMLElement>("[data-cap]")];
        const captionStack = figure.querySelector<HTMLElement>("[data-bp-captions]");
        const play = figure.querySelector<HTMLButtonElement>("[data-bp-play]");
        const parts = [...board.querySelectorAll<HTMLElement>("[data-k]")];

        let hovered: string | undefined;
        let pinned: string | undefined;
        let touring: string | undefined;
        let playing = !reduced.matches;
        let visible = false;
        let held = false;
        let timer: ReturnType<typeof setTimeout> | undefined;
        let leaving: ReturnType<typeof setTimeout> | undefined;
        let shown: string | undefined;

        // ── The wires ─────────────────────────────────────────────────────────────────────────────────────────────
        const add = (tag: string, attributes: Record<string, string | number>, parent: Element = wires): SVGElement => {
            const element = document.createElementNS(SVG, tag);
            for (const [name, value] of Object.entries(attributes)) {
                element.setAttribute(name, String(value));
            }
            parent.append(element);
            return element;
        };
        const wire = (d: string, key: string, kind = ""): void => {
            add("path", { d, class: `bp-wire ${kind}`.trim(), "data-k": key });
        };
        // A vertical S from one point down to another: leaves straight down, arrives straight down.
        const drop = (x1: number, y1: number, x2: number, y2: number): string => {
            const bend = (y2 - y1) * 0.5;
            return `M${x1} ${y1}C${x1} ${y1 + bend} ${x2} ${y2 - bend} ${x2} ${y2}`;
        };
        // An opening cut through a wall or a strip, with its two jambs; the wire runs on through it.
        const opening = (key: string, x: number, y1: number, y2: number): void => {
            const group = add("g", { class: "bp-gate", "data-k": key });
            add("rect", { x: x - 6, y: y1, width: 12, height: y2 - y1, class: "bp-gate-gap" }, group);
            add("path", { d: `M${x - 6} ${y1}V${y2}M${x + 6} ${y1}V${y2}`, class: "bp-gate-jamb" }, group);
            add("path", { d: `M${x} ${y1}V${y2}`, class: "bp-wire bp-gate-pass", "data-k": key }, group);
        };

        const draw = (): void => {
            wires.replaceChildren();
            if (getComputedStyle(wires).display === "none") {
                paint(false);
                return;
            }
            const origin = board.getBoundingClientRect();
            const box = (element: Element | null) => {
                const rect = (element ?? board).getBoundingClientRect();
                const l = rect.left - origin.left;
                const t = rect.top - origin.top;
                return { l, t, r: l + rect.width, b: t + rect.height, w: rect.width, h: rect.height, cx: l + rect.width / 2, cy: t + rect.height / 2 };
            };
            wires.setAttribute("width", String(origin.width));
            wires.setAttribute("height", String(origin.height));

            const band = box(board.querySelector("[data-bp-band]"));
            const relay = box(board.querySelector("[data-bp-relay]"));
            const knows = box(board.querySelector("[data-bp-knows]"));
            const you = box(board.querySelector('[data-bp-acct="you"]'));
            const ola = box(board.querySelector('[data-bp-acct="ola"]'));
            // Each person's line runs down a lane beside the address book, never through it.
            const laneYou = (you.r + knows.l) / 2;
            const laneOla = (knows.r + ola.l) / 2;
            const meet = band.t - 18;

            // You: every screen down to one line, which signs in to the left and carries on through the relay.
            for (const kiosk of board.querySelectorAll("[data-bp-kiosk]")) {
                const at = box(kiosk);
                wire(drop(at.cx, at.b + 3, laneYou, meet), "w-you");
            }
            wire(`M${laneYou} ${meet}V${relay.t}`, "w-you");
            wire(`M${laneYou} ${you.cy}H${you.r + 4}`, "w-you-sign", "bp-wire-dotted");
            add("circle", { cx: laneYou, cy: you.cy, r: 2.6, class: "bp-knot", "data-k": "w-you-sign" });
            opening("w-you", laneYou, relay.t, relay.b);

            // Ola: her one screen, her own account, her own lane.
            const olaKiosk = box(board.querySelector("[data-bp-ola-kiosk]"));
            wire(drop(olaKiosk.cx, olaKiosk.b + 3, laneOla, meet), "w-ola");
            wire(`M${laneOla} ${meet}V${relay.t}`, "w-ola");
            wire(`M${laneOla} ${ola.cy}H${ola.l - 4}`, "w-ola-sign", "bp-wire-dotted");
            add("circle", { cx: laneOla, cy: ola.cy, r: 2.6, class: "bp-knot", "data-k": "w-ola-sign" });
            opening("w-ola", laneOla, relay.t, relay.b);

            for (const site of board.querySelectorAll<HTMLElement>("[data-bp-site]")) {
                const id = site.dataset.bpSite ?? "";
                const wall = box(site.querySelector("[data-bp-wall]"));
                const court = box(site.querySelector("[data-bp-court]"));
                // Out of the relay and in through the sandbox's roof; the shared one has a second door for Ola.
                const door = id === "work" ? wall.l + wall.w * 0.34 : wall.l + wall.w * 0.66;
                wire(drop(laneYou, relay.b, door, wall.t), `w-${id}`);
                opening(`w-${id}`, door, wall.t, court.t);
                if (id === "work") {
                    const second = wall.l + wall.w * 0.8;
                    wire(drop(laneOla, relay.b, second, wall.t), "w-ola-work");
                    opening("w-ola-work", second, wall.t, court.t);
                }

                // Down through the floor and the machine under it, to everything it reaches.
                const plinth = box(site.querySelector("[data-bp-plinth]"));
                const items = [...site.querySelectorAll("[data-bp-reach-item]")].map(box);
                const last = items.at(-1);
                if (last === undefined) {
                    continue;
                }
                const x = wall.l + 16;
                const key = `w-reach-${id}`;
                opening(key, x, court.b, wall.b);
                opening(key, x, plinth.t, plinth.b);
                wire(`M${x} ${wall.b}V${plinth.t}M${x} ${plinth.b}V${last.cy}`, key);
                for (const item of items) {
                    wire(`M${x} ${item.cy}H${item.l - 3}`, key);
                }
            }

            // The link: a dashed bridge between the two sandboxes that are both yours.
            const home = box(board.querySelector('[data-bp-site="home"] [data-bp-wall]'));
            const game = box(board.querySelector('[data-bp-site="game"] [data-bp-wall]'));
            const tag = board.querySelector<HTMLElement>("[data-bp-link-tag]");
            const bridgeY = home.t + home.h * 0.62;
            wire(`M${home.r} ${bridgeY}H${game.l}`, "link", "bp-wire-dashed");
            if (tag !== null) {
                tag.style.left = `${(home.r + game.l) / 2}px`;
                tag.style.top = `${bridgeY - box(board.querySelector(".bp-sites")).t}px`;
            }
            paint(false);
        };

        // ── The lighting ──────────────────────────────────────────────────────────────────────────────────────────
        const spark = (path: SVGPathElement, delay: number): void => {
            const dot = add("circle", { r: 2.6, class: "bp-spark" });
            const motion = document.createElementNS(SVG, "animateMotion");
            for (const [name, value] of Object.entries({ dur: "0.8s", begin: "indefinite", fill: "freeze", keyPoints: "0;1", keyTimes: "0;1", calcMode: "spline", keySplines: "0.4 0 0.2 1" })) {
                motion.setAttribute(name, value);
            }
            motion.setAttribute("path", path.getAttribute("d") ?? "");
            dot.append(motion);
            setTimeout(() => {
                motion.beginElement();
                dot.classList.add("bp-spark-go");
            }, delay);
            setTimeout(() => dot.remove(), delay + 950);
        };
        const stateOf = (element: Element, light: Light): string => {
            const own = (element.getAttribute("data-k") ?? "").split(" ");
            if (own.some((key) => light.on.includes(key))) {
                return "on";
            }
            return own.some((key) => light.near.includes(key)) ? "near" : "off";
        };
        const paint = (animate: boolean): void => {
            const key = hovered ?? pinned ?? touring;
            const light = key === undefined ? undefined : lights[key];
            const changed = key !== shown;
            shown = key;
            figure.dataset.light = key ?? "";
            for (const element of [...parts, ...wires.querySelectorAll<SVGElement>("[data-k]")]) {
                if (light === undefined) {
                    element.removeAttribute("data-lit");
                } else {
                    element.setAttribute("data-lit", stateOf(element, light));
                }
            }
            const cap = light?.cap ?? "";
            for (const caption of captions) {
                caption.dataset.on = String(caption.dataset.cap === cap);
            }
            const step = pinned ?? touring;
            for (const tab of tabs) {
                tab.setAttribute("aria-pressed", String(tab.dataset.bpGo === step));
                tab.dataset.shown = String(tab.dataset.bpGo === cap);
            }
            if (animate && changed && light !== undefined && !reduced.matches) {
                for (const path of wires.querySelectorAll<SVGPathElement>("path.bp-wire:not(.bp-gate-pass)")) {
                    if (path.dataset.lit === "on") {
                        spark(path, (path.dataset.k ?? "").startsWith("w-reach") ? 420 : 0);
                    }
                }
            }
        };

        // ── The tour ──────────────────────────────────────────────────────────────────────────────────────────────
        const stop = (): void => {
            clearTimeout(timer);
            timer = undefined;
        };
        const advance = (): void => {
            touring = tour[(tour.indexOf(touring ?? "") + 1) % tour.length];
            // The beat restarts under the new tab: its animation is dropped and put back.
            figure.dataset.beat = figure.dataset.beat === "a" ? "b" : "a";
            paint(true);
        };
        const run = (): void => {
            stop();
            if (!playing || !visible || held || pinned !== undefined || tour.length === 0) {
                return;
            }
            if (touring === undefined) {
                advance();
            }
            timer = setTimeout(() => {
                advance();
                run();
            }, BEAT_MS);
        };
        const setPlaying = (on: boolean): void => {
            playing = on;
            figure.dataset.paused = String(!on);
            play?.setAttribute("aria-label", (on ? play.dataset.labelPause : play.dataset.labelPlay) ?? "");
            run();
        };

        // ── The reader ────────────────────────────────────────────────────────────────────────────────────────────
        const hoverOf = (target: EventTarget | null): string | undefined =>
            target instanceof Element ? target.closest<HTMLElement>("[data-hover]")?.dataset.hover : undefined;
        const point = (next: string | undefined): void => {
            clearTimeout(leaving);
            if (next !== undefined) {
                hovered = next;
                paint(true);
                return;
            }
            leaving = setTimeout(() => {
                hovered = undefined;
                paint(true);
            }, LEAVE_GRACE_MS);
        };
        board.addEventListener("pointerover", (event) => {
            if (event.pointerType === "mouse") {
                point(hoverOf(event.target));
            }
        });
        board.addEventListener("pointerenter", (event) => {
            if (event.pointerType === "mouse" && timer !== undefined) {
                held = true;
                figure.dataset.held = "true";
                stop();
            }
        });
        board.addEventListener("pointerleave", () => {
            point(undefined);
            if (held) {
                held = false;
                delete figure.dataset.held;
                run();
            }
        });
        // A finger has no hover: a tap on a part keeps its lighting, a second tap lets it go.
        board.addEventListener("click", (event) => {
            const id = hoverOf(event.target);
            pinned = id === undefined || id === pinned ? undefined : id;
            if (id !== undefined) {
                setPlaying(false);
            }
            paint(true);
        });
        tabs.forEach((tab) =>
            tab.addEventListener("click", () => {
                pinned = tab.dataset.bpGo;
                touring = pinned;
                hovered = undefined;
                // From the reader's own press on, a screen reader hears each caption; the tour alone stays quiet.
                captionStack?.setAttribute("aria-live", "polite");
                setPlaying(false);
                paint(true);
            }),
        );
        play?.addEventListener("click", () => {
            if (!playing) {
                pinned = undefined;
                hovered = undefined;
                advance();
            }
            setPlaying(!playing);
        });
        figure.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && pinned !== undefined) {
                pinned = undefined;
                paint(true);
            }
        });

        figure.dataset.paused = String(!playing);
        new ResizeObserver(draw).observe(board);
        void document.fonts.ready.then(draw);
        new IntersectionObserver(
            ([entry]) => {
                visible = entry?.isIntersecting ?? false;
                if (visible) {
                    run();
                } else {
                    stop();
                }
            },
            { threshold: 0.3 },
        ).observe(figure);
    }
</script>

