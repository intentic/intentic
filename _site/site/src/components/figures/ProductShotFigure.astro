---
import type { ProductShot } from "@intentic/site-content/product";
import Window from "../Window.astro";
import ProductShot from "../ProductShot.astro";

/* One screenshot, framed — and the frame is the site's own, the same carved window the home page stands its three hero surfaces in. */

interface Props {
    shot: ProductShot;
    /** The hero is the page's LCP; everything below it waits until it is scrolled near. */
    priority?: boolean;
/** How wide the page paints this shot, so the browser can pick a rung of its srcset. */
    sizes: string;
    class?: string;
}

const { shot, priority = false, sizes, class: className = "" } = Astro.props;
---

{
    shot.frame === "browser" && (
        <Window class={className} label={shot.label}>
            <ProductShot name={shot.name} alt={shot.alt} sizes={sizes} priority={priority} class="window-full" />
        </Window>
    )
}

{
    shot.frame === "phone" && (
        <div class:list={["mx-auto w-full max-w-[27rem] overflow-hidden rounded-[2rem] border border-line-strong bg-card p-2 shadow-2xl shadow-black/50", className]}>
            <ProductShot
                name={shot.name}
                alt={shot.alt}
                sizes="(min-width: 29rem) 416px, calc(100vw - 4rem)"
                priority={priority}
                class="w-full rounded-[1.5rem]"
            />
        </div>
    )
}

{
    shot.frame === "bare" && (
        <ProductShot
            name={shot.name}
            alt={shot.alt}
            sizes={sizes}
            priority={priority}
            class={`w-full border border-line-strong shadow-2xl shadow-black/50 ${className}`}
        />
    )
}
