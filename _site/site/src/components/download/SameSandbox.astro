---
import { APP_URL } from "@intentic/site-content/site";
import { glyph, type GlyphName } from "./glyphs";

/* TWO DOORS, ONE ROOM. Said plainly rather than buried: someone weighing an .exe against a shell command deserves to
   know they are the same thing. The app runs the one-line install's own script, so both end in the same containers
   and the same private connection, reachable from anywhere the reader signs in. */

interface Door {
    glyph: GlyphName;
    title: string;
    sub: string;
    href?: string;
}

const doors: Door[] = [
    { glyph: "app", title: "Desktop app", sub: "Click Run on this computer" },
    { glyph: "terminal", title: "One-line install", sub: "Paste one command", href: "/docs/quickstart/" },
];

const appHost = new URL(APP_URL).host;
---

<div class="flow" role="img" aria-label={`The desktop app and the one-line install run the same script, so both create the same sandbox: the same Docker containers and private connection. You reach it from any device at ${appHost}.`}>
    <div class="flex flex-col gap-3">
        {
            doors.map((door) => (
                <div class="node">
                    <span class="node-glyph" set:html={glyph(door.glyph, "h-5 w-5")} />
                    <div class="min-w-0">
                        <p class="font-mark text-base leading-snug text-content">{door.title}</p>
                        <p class="text-xs text-subtle">{door.sub}</p>
                    </div>
                </div>
            ))
        }
    </div>

    {/* Wide: the two doors' wires meet and run on into the sandbox. Narrow: one arrow down. */}
    <svg class="flow-join hidden lg:block" viewBox="0 0 64 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 30 C 32 30, 30 60, 60 60 M0 90 C 32 90, 30 60, 60 60" fill="none" stroke="var(--color-line-bright)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="flow-arrow" set:html={glyph("arrow", "h-5 w-5")} />

    <div class="node node-lit">
        <span class="node-glyph" set:html={glyph("cube", "h-6 w-6")} />
        <div class="min-w-0">
            <p class="font-mark text-lg leading-snug text-content">The same sandbox</p>
            <p class="text-xs text-muted">Same script, same Docker containers, same private connection</p>
        </div>
    </div>

    <span class="flow-arrow" set:html={glyph("arrow", "h-5 w-5")} />

    <div class="node">
        <span class="node-glyph" set:html={glyph("devices", "h-5 w-5")} />
        <div class="min-w-0">
            <p class="font-mark text-base leading-snug text-content">Any device</p>
            <p class="text-xs text-subtle">Sign in at {appHost}</p>
        </div>
    </div>
</div>

{/* The links the picture cannot hold, under it. */}
<p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a href="/docs/quickstart/" class="text-link hover:underline">How the one-line install works</a>
    <a href={APP_URL} class="text-link hover:underline">Open {appHost}</a>
</p>

<style>
    /* Wide: doors | join | sandbox | arrow | any device. Narrow: one column, arrows turned to point down. */
    .flow {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: stretch;
        gap: 0.75rem;
    }
    @media (min-width: 64rem) {
        .flow {
            grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1.25fr) 2.5rem minmax(0, 1fr);
            align-items: center;
            gap: 0;
        }
        /* The join already carries the doors into the sandbox; the arrow after the doors is the narrow layout's. */
        .flow > .flow-arrow:nth-of-type(1) {
            display: none;
        }
    }

    .flow-join {
        width: 100%;
        height: 100%;
        min-height: 7rem;
    }

    .flow-arrow {
        display: grid;
        place-items: center;
        color: var(--color-gold);
        transform: rotate(90deg);
    }
    @media (min-width: 64rem) {
        .flow-arrow {
            transform: none;
        }
    }

    .node {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--color-line);
        background: var(--wash-panel);
    }
    .node-glyph {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        flex: none;
        color: var(--color-gold);
        border: 1px solid var(--color-line);
        background: var(--role-frame-fill);
    }
    .node-glyph :global(svg) {
        display: block;
    }
    .node-lit {
        padding: 1.25rem 1.2rem;
        border-color: var(--role-ember-line-strong);
        background: var(--wash-ember);
        box-shadow: var(--role-ember-glow);
    }
    .node-lit .node-glyph {
        width: 3rem;
        height: 3rem;
        color: var(--color-primary-400);
        border-color: var(--role-ember-line);
    }
</style>
