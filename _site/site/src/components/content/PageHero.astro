---
interface Props {
    heading: string;
    eyebrow?: string;
    eyebrowHref?: string;
    sub?: string;
    class?: string;
    jumpLinks?: { label: string; links: { href: string; label: string }[] };
}

const { heading, eyebrow, eyebrowHref, sub, class: className, jumpLinks } = Astro.props;
---

<section class="page-hero">
    <div class:list={["below-bar relative mx-auto max-w-7xl px-6 pb-14", className]}>
        <slot name="eyebrow">
            {eyebrowHref ? (
                <a href={eyebrowHref} class="eyebrow transition-colors hover:text-link">{eyebrow}</a>
            ) : (
                <div class="eyebrow">{eyebrow}</div>
            )}
        </slot>
        <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">{heading}</h1>
        {sub && <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">{sub}</p>}
        {jumpLinks && (
            <div class="mt-8 border-t border-line pt-6">
                <div class="eyebrow">{jumpLinks.label}</div>
                <div class="mt-3 flex flex-wrap gap-2">
                    {jumpLinks.links.map((link) => (
                        <a href={link.href} class="border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:border-primary-600/40 hover:text-link">
                            {link.label}
                        </a>
                    ))}
                </div>
            </div>
        )}
        <slot />
    </div>
</section>
