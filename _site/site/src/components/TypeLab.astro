---
/* THE TYPE LAB, and it is temporary. Two axes — the reading face and the display face — picked by eye on the real
   pages rather than from specimens side by side in a tool. Each choice is a plain link to `?font=…` or `?display=…`:
   the pre-paint script in lib/typeface.ts reads the parameter, writes the cookie, strips the parameter and applies
   the face, so there is no client JavaScript here beyond marking what is worn, and no flash of the previous face.

   Delete this component, lib/typeface.ts, public/fonts/lab/, styles/type-lab-faces.css and the lines that call
   them once both faces have won. */
import { AXES, defaultFace, typefaceMarkScript } from "../lib/typeface";
---

<details class="type-lab">
    <summary class="type-lab-tab">
        <span class="type-lab-mark">Aa</span>
        <span>Type</span>
    </summary>
    <div class="type-lab-body">
        {
            AXES.map((axis) => (
                <section class="type-lab-axis">
                    <h2 class="type-lab-axis-name">{axis.label}</h2>
                    <p class="type-lab-lede" set:html={axis.lede} />
                    <ul class="type-lab-list">
                        {axis.faces.map((face) => (
                            <li>
                                <a href={`?${axis.key}=${face.id}`} class="type-lab-choice" data-face={`${axis.attribute}:${face.id}`}>
                                    <span class="type-lab-name">
                                        {face.label}
                                        {face.id === defaultFace(axis).id && <span class="type-lab-now">default</span>}
                                    </span>
                                    <span class="type-lab-note">{face.note}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</details>

<script is:inline set:html={typefaceMarkScript()} />

<style>
    /* Docked bottom-left, clear of the demo bar that sits bottom-centre. */
    .type-lab {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        z-index: 60;
        width: max-content;
        max-width: min(22rem, calc(100vw - 2rem));
        border: 1px solid var(--color-line-strong);
        background: var(--color-card);
        box-shadow: var(--role-window-shadow);
        font-family: var(--font-sans);
    }
    .type-lab-tab {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.8rem;
        cursor: pointer;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-gold);
        list-style: none;
    }
    .type-lab-tab::-webkit-details-marker {
        display: none;
    }
    .type-lab-mark {
        font-family: var(--font-display);
        font-size: 1rem;
        line-height: 1;
        text-transform: none;
        letter-spacing: 0;
        color: var(--color-primary-500);
    }
    .type-lab-body {
        border-top: 1px solid var(--color-line);
        padding: 0.7rem 0.8rem 0.85rem;
        /* Seventeen faces with a line of reasoning each is taller than any window; the list scrolls inside the panel
           rather than the panel covering the page it is there to let you read. */
        max-height: min(64vh, 34rem);
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .type-lab-axis + .type-lab-axis {
        margin-top: 0.9rem;
        border-top: 1px solid var(--color-line);
        padding-top: 0.7rem;
    }
    .type-lab-axis-name {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-2xs);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-gold);
    }
    .type-lab-lede {
        margin: 0.25rem 0 0.5rem;
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--color-subtle);
    }
    .type-lab-list {
        display: grid;
        gap: 0.15rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .type-lab-choice {
        display: block;
        padding: 0.35rem 0.55rem;
        border: 1px solid transparent;
        text-decoration: none;
    }
    .type-lab-choice:hover,
    .type-lab-choice:focus-visible {
        border-color: var(--color-line-strong);
        background: var(--role-btn-wash, rgba(224, 123, 39, 0.12));
    }
    /* The face you are reading in right now. */
    .type-lab-choice[aria-current] {
        border-color: var(--role-ember-line);
        background: var(--role-decision-fill);
    }
    .type-lab-name {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-content);
    }
    .type-lab-now {
        font-size: var(--text-2xs);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-primary-400);
    }
    .type-lab-note {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--color-muted);
    }
    @media (max-width: 30rem) {
        .type-lab {
            max-width: calc(100vw - 2rem);
        }
        .type-lab-body {
            max-height: 50vh;
        }
    }
</style>
