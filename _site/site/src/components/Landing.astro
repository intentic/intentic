---
/* Landing page composition for the Intentic site. */
import { CREATOR_NAME, creatorBio, creatorRole } from "@intentic/site-content/about";
import { faqGroups } from "@intentic/site-content/faq";
import { landingContent } from "@intentic/site-content/landing";
import { templeScene } from "@intentic/site-content/temple";
import { APP_URL, DEMO_PATH, githubUrl, ORG_NAME } from "@intentic/site-content/site";
import { buildSoftwareAppSchema } from "@intentic/site-content/structured-data";
// Provider marks match the session icons used by the app.
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { shotAsset, SHOT_WIDTHS } from "../lib/shots";
import AutomateFigure from "./figures/AutomateFigure.astro";
import Bullet from "./Bullet.astro";
import Corners from "./Corners.astro";
import Divider from "./Divider.astro";
import DownloadCta from "./DownloadCta.astro";
import Footer from "./Footer.astro";
import Lotus from "./Lotus.astro";
import Nav from "./Nav.astro";
import Point from "./Point.astro";
import TempleFigure from "./figures/TempleFigure.astro";
import TrustCards from "./TrustCards.astro";
import Window from "./Window.astro";
import "../styles/home.css";

const content = landingContent;

// FAQPage data stays flat; topic bands belong only to the page layout.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

/* Headline text is split into sentence beats. */
const beats = content.hero.headlineLines
    .flatMap((line) => line.split(/(?<=\.)\s+/u))
    .map((beat) => beat.replace(/\.\s*$/u, ""))
    .filter((beat) => beat.length > 0);

const appScreens = content.hero.screens.app.map((screen) => ({ ...screen, image: shotAsset(screen.name) }));
/* Side frames hold still images. */
const chatStill = shotAsset(content.hero.screens.chat[0]!.name);
/* Hero frames share a viewport axis, so their sizes use `vw`. */
const appSizes = "(min-width: 64rem) 70vw, (min-width: 48rem) 78vw, 205vw";
const chatSizes = "(min-width: 64rem) 47vw, (min-width: 48rem) 56vw, 60vw";
const planSizes = "(min-width: 64rem) 29vw, (min-width: 48rem) 35vw, 40vw";

/* Stage screenshots size from the shell and viewport bleed. */
const STAGE_SIZES = "(min-width: 102rem) 1440px, (min-width: 84rem) calc(50vw + 624px), (min-width: 48rem) calc(100vw - 3rem), 275vw";

/* Getting-started steps are grouped by execution location. */
const browserSteps = content.connect.steps.slice(0, -1);
const machineStep = content.connect.steps.at(-1)!;
---

<BaseLayout title={content.meta.title} description={content.meta.description} faq={faq} extraJsonLd={[buildSoftwareAppSchema()]} backdrop={false}>
    <div class="home flex flex-1 flex-col">
        {/* The home bar overlays the plate; other pages use PageBackdrop. */}
        <Nav />

        <main class="flex-1">
            <!-- The first screen remains symmetric with its plate. -->
            <section class="hero" id="hero">
                <div class="plate" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                <div class="plate-fade" aria-hidden="true"></div>

                <div class="hero-grid">
                    <div class="hero-copy">
                        {/* The greeting is flanked because the hero axis is centered. */}
                        <p class="hero-eyebrow">
                            <Bullet mark="lozenge" />
                            <span>Welcome to {ORG_NAME}</span>
                            <Bullet mark="lozenge" />
                        </p>

                        {/* Beat spans need spaces for assistive text and crawlers. */}
                        <h1 class="headline">
                            {
                                beats.map((beat, index) => (
                                    <>
                                        <span class="headline-line">
                                            <span class="display">{beat}</span>
                                            <span class="stop">.</span>
                                        </span>
                                        {index < beats.length - 1 && " "}
                                    </>
                                ))
                            }
                        </h1>

                        <p class="hero-sub">{content.hero.subhead}</p>

                        {/* Hero shows two start actions; the bar hides its duplicate while they are visible. */}
                        <div class="hero-actions">
                            <a class="btn btn-primary" href={APP_URL} data-hero-cta>Create your workspace</a>
                            <DownloadCta />
                        </div>
                    </div>

<!-- Product frames share one visual axis. -->
                    <figure class="hero-visual">
                        <div class="hero-stack">
                            <Window class="window-plan" aria-hidden="true">
                                <div class="window-crop window-crop-plan">
                                    <Image src={shotAsset("chat-plan")} alt="" widths={SHOT_WIDTHS} sizes={planSizes} loading="lazy" decoding="async" class="screen screen-plan" />
                                </div>
                            </Window>

                            {/* The hero ledge stays empty because its image is the argument. */}
                            <Window class="window-app" finial>
                                <div class="window-crop window-crop-app">
                                    {
                                        appScreens.map((screen, index) => (
                                            <Image
                                                src={screen.image}
                                                alt={screen.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes={appSizes}
                                                loading={index === 0 ? "eager" : "lazy"}
                                                fetchpriority={index === 0 ? "high" : undefined}
                                                decoding="async"
                                                class:list={["screen screen-app", index === 0 && "is-on"]}
                                                data-screen="app"
                                                aria-hidden={index > 0 ? "true" : undefined}
                                            />
                                        ))
                                    }
                                </div>

                                {/* The demo control stays available to pointer, keyboard, and touch users. */}
                                <a class="play" href={DEMO_PATH}>
                                    <span class="btn btn-sm">
                                        <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                                        <span>{content.hero.demo.playLabel}</span>
                                    </span>
                                </a>
                            </Window>

                            <Window class="window-chat" aria-hidden="true">
                                <div class="window-crop window-crop-chat">
                                    <Image src={chatStill} alt="" widths={SHOT_WIDTHS} sizes={chatSizes} loading="lazy" decoding="async" class="screen screen-chat" />
                                </div>
                            </Window>
                        </div>
                    </figure>
                </div>
            </section>

            <!-- The build section follows the hero. -->
            <section class="band" id="build">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell build-open fade-in">
                    <div class="eyebrow">{templeScene.eyebrow}</div>
                    <h2 class="h2 display">{templeScene.heading}</h2>
                    <p class="lede">{templeScene.sub}</p>
                </div>

                {/* Build stage width matches the screenshots below it. */}
                <div class="stage build-stage fade-in">
                    <div class="card build-plate">
                        <Corners />
                        <TempleFigure />
                    </div>
                </div>
            </section>

            <!-- Verbs render as one screenful per showcase stage. -->
            <section class="band" id="verbs">
                <div class="wall" aria-hidden="true"></div>

                <div class="shell verbs-open fade-in">
                    <div class="eyebrow">{content.verbs.eyebrow}</div>
                    {content.verbs.heading !== undefined && <h2 class="h2 display">{content.verbs.heading}</h2>}
                </div>

                {
                    content.verbs.items.map((item) => {
                        const image = item.shot === undefined ? undefined : shotAsset(item.shot.name);
                        return (
                            <div class="stage fade-in">
                                <div class="stage-head">
                                    <h3 class="stage-verb">
                                        <Bullet size="md" />
                                        {item.verb}
                                    </h3>
                                    <p class="stage-line">{item.line}</p>
                                    <a href={item.href} class="link see">See it →</a>
                                </div>

                                {item.shot !== undefined && image !== undefined && (
/* Each showcase frame gets its own finial. */
                                    <Window class="stage-frame" finial label={item.shot.label}>
                                        <div class="stage-crop">
                                            <Image
                                                src={image}
                                                alt={item.shot.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes={STAGE_SIZES}
                                                loading="lazy"
                                                decoding="async"
                                                class="stage-shot"
                                            />
                                        </div>
                                    </Window>
                                )}

                                {item.figure === "automate" && (
/* Automate uses its machine figure instead of a screenshot. */
                                    <div class="card stage-machine">
                                        <Corners />
                                        <AutomateFigure />
                                    </div>
                                )}
                            </div>
                        );
                    })
                }

                <div class="shell verbs-close">
                    <a href="/features/" class="link band-cta">{content.verbs.cta} →</a>
                </div>
            </section>

            <!-- Compare the two working environments side by side. -->
            <section class="band" id="workspace">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.workspace.eyebrow}</div>
                    <h2 class="h2 display">{content.workspace.heading}</h2>
                    <p class="lede">{content.workspace.sub}</p>

                    <div class="compare">
                        <div class="card compare-ours">
                            <Corners />
                            <div class="compare-head">
                                <h3>{content.workspace.comparison.ours.label}</h3>
                                <span>{content.workspace.comparison.ours.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.ours.items.map((item) => <Point>{item}</Point>)
                                }
                            </ul>
                        </div>

                        <div class="compare-chat">
                            <div class="compare-head">
                                <h3>{content.workspace.comparison.chat.label}</h3>
                                <span>{content.workspace.comparison.chat.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.chat.items.map((item) => (
                                        <Point mark="lozenge" markClass="lozenge-quiet">
                                            {item}
                                        </Point>
                                    ))
                                }
                            </ul>
                            <p class="compare-missing">{content.workspace.comparison.chat.missing}</p>
                        </div>
                    </div>

                    <div class="compare-foot">
                        <p>{content.workspace.comparison.footnote}</p>
                        <a href="/features/review/" class="link">How reviewing agent work works →</a>
                    </div>
                </div>
            </section>

            <!-- Explain the cost model. -->
            <section class="band" id="economics">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.economics.eyebrow}</div>
                    <h2 class="h2 display">{content.economics.heading}</h2>
                    <p class="lede">{content.economics.sub}</p>

                    <div class="econ">
                        <div class="card accounts">
                            <Corners set="diag" />
                            <div class="accounts-head"><span class="eyebrow">Your agent accounts</span></div>
                            <ul>
                                {
                                    content.economics.accounts.map((account) => (
                                        <li>
                                            <Bullet>
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                                    <path d={PROVIDER_BRAND_PATHS[account.logo]} fill-rule={providerFillRule(account.logo)} />
                                                </svg>
                                            </Bullet>
                                            <span class="account-name">{account.name}</span>
                                            <span class="account-detail">{account.detail}</span>
                                            <span class="account-tag">subscription</span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="card flat">
                            <Corners set="diag" />
                            <div class="eyebrow">Flat, not metered</div>
                            <ul>
                                {
                                    content.economics.points.map((point) => <Point>{point}</Point>)
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Identify who builds it. -->
            <section class="band" id="trust">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="trust">
                        <div>
                            <div class="eyebrow">{content.trust.eyebrow}</div>
                            <h2 class="h2 display">{CREATOR_NAME}</h2>
                            <p class="lede">{creatorRole}</p>
                            <p class="trust-bio">{creatorBio}</p>
                            <a href="/about/" class="link band-cta">{content.trust.cta} →</a>
                        </div>

                        {/* Trust claims share the about module and build-time commit count. */}
                        <TrustCards />
                    </div>
                </div>
            </section>

            <!-- Show how to get started. -->
            <section class="band" id="connect">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.connect.eyebrow}</div>
                    <h2 class="h2 display">{content.connect.heading}</h2>
                    <p class="lede">{content.connect.sub}</p>

                    {/* Steps are grouped by location: browser first, then terminal. */}
                    <div class="flow">
                        <div class="flow-zone">
                            <div class="flow-where">in your browser</div>
                            {
                                browserSteps.map((step) => (
                                    <div class="station">
                                        <h3>
                                            <Bullet />
                                            {step.title}
                                        </h3>
                                        <p>{step.body}</p>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="flow-seam" aria-hidden="true"></div>

                        <div class="flow-zone">
                            <div class="flow-where">on your machine</div>
                            <div class="station">
                                <h3>
                                    <Bullet />
                                    {machineStep.title}
                                </h3>
                                <p>{machineStep.body}</p>
                            </div>

                            <div class="frame command">
                                <Corners />
                                <div class="command-head"><span class="command-where">your terminal</span></div>
                                <pre><code><span class="prompt">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                            </div>
                            <p class="command-note">{content.connect.commandNote}</p>
                            {/* Supporting links stay below the terminal command. */}
                            <p class="command-note">
                                {content.connect.commandChoice.lead}{" "}
                                <a href="/where-it-runs/" class="text-link hover:underline">{content.connect.commandChoice.cta}</a>
                            </p>
                        </div>
                    </div>

                    <div class="card desktop">
                        <Corners set="diag" />
                        <div>
                            <p class="desktop-lead">{content.connect.desktop.lead}</p>
                            <p class="desktop-note">{content.connect.desktop.note}</p>
                        </div>
                        {/* The download sits beside the terminal command for non-terminal users. */}
                        <DownloadCta class="btn-sm" label={content.connect.desktop.cta} icon={false} />
                    </div>
                </div>
            </section>

            <!-- FAQ uses native details for keyboard and screen-reader behavior. -->
            <section class="band" id="faq">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">FAQ</div>
                    <h2 class="h2 display">Before you install it.</h2>
                    <p class="lede">What it costs, where your code sits, and what is not built yet.</p>

                    <div class="faq">
                        {
                            faqGroups.map((group) => (
                                <div class="faq-group" id={group.id}>
                                    <div class="faq-group-head">
                                        <h3>{group.label}</h3>
                                        <p>{group.blurb}</p>
                                    </div>
                                    <div class="faq-list">
                                        {group.items.map((item) => (
                                            <details id={item.id} name={group.id} class="faq-item scroll-mt-28">
                                                <summary>
                                                    <Bullet mark="lozenge" markClass="faq-mark" />
                                                    <span>{item.question}</span>
                                                </summary>
                                                <div class="faq-answer">
                                                    {item.answer.map((paragraph) => (
                                                        <p>{paragraph}</p>
                                                    ))}
                                                    {item.more && (
                                                        <a href={item.more.href} class="link">
                                                            {item.more.label} →
                                                        </a>
                                                    )}
                                                </div>
                                            </details>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- Closing cartouche returns the plate at the page end. -->
            <section class="band final">
                <div class="plate plate-foot" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                {/* The closing band is the only page-authored copy; other copy comes from landing.ts. */}
                <div class="shell fade-in final-inner">
                    <Lotus size="lg" />
                    <h2 class="h2 display final-heading">
                        <span>Open-source and free</span>
                        {/* The underline is a separate gold element below the heading text. */}
                        {" "}
                        <span class="final-forever">forever</span>
                    </h2>
                    <p class="lede final-sub">
                        Contribute to our code, extend workspace<br />or offer services for others.
                    </p>
                    <Divider class="final-divider" />
                    <div class="hero-actions">
                        <a class="btn btn-primary" href={APP_URL}>Create your workspace</a>
                        <a class="btn" href={githubUrl} target="_blank" rel="noopener">See the source</a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>

    <script>
/* The page remains usable when these enhancements are unavailable. */
        const bar = document.getElementById("site-bar");

/* The bar CTA hides while the hero CTA is visible. */
        const heroCta = document.querySelector("[data-hero-cta]");
        if (bar && heroCta && "IntersectionObserver" in window) {
            bar.setAttribute("data-cta-managed", "");
            const ctaObserver = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        bar.toggleAttribute("data-cta-shown", !entry.isIntersecting);
                    }
                },
                { rootMargin: "-72px 0px 0px 0px", threshold: 0 },
            );
            ctaObserver.observe(heroCta);
        }

/* One app frame is visible at a time. */
        const screens = document.querySelectorAll<HTMLElement>('[data-screen="app"]');
        if (screens.length > 1) {
            let shown = 0;
            setInterval(() => {
                shown = (shown + 1) % screens.length;
                screens.forEach((screen, index) => {
                    screen.classList.toggle("is-on", index === shown);
                    // Only the visible frame is exposed to screen readers.
                    screen.setAttribute("aria-hidden", index === shown ? "false" : "true");
                });
            }, 4000);
        }
    </script>
</BaseLayout>
