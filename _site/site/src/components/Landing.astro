---
/* ═══════════════════════════════════════════════════════════════════════════════════════════════════
 * THE HOME PAGE.
 *
 * A photographed temple wall behind the first screen, engraved display type with an ember full stop on
 * each beat, gold rules and turned corners in place of hairline borders, and a lotus wherever a page
 * would otherwise set a bullet dot. The vocabulary is the site's own — `styles/global.css` holds the
 * metals, the type tiers, the cartouche button and the frame; what lives beside this file in
 * `styles/home.css` is only THIS page's arrangement.
 *
 * Every word comes from the content modules (`landing.ts`, `about.ts`, `faq.ts`, `nav.ts`), so a copy
 * change lands here without this file being opened.
 * ═══════════════════════════════════════════════════════════════════════════════════════════════════ */
import { CREATOR_NAME, creatorBio, creatorRole } from "@intentic-dev/site-content/about";
import { faqGroups } from "@intentic-dev/site-content/faq";
import { landingContent } from "@intentic-dev/site-content/landing";
import { APP_URL, DEMO_PATH, githubUrl, ORG_NAME } from "@intentic-dev/site-content/site";
import { buildSoftwareAppSchema } from "@intentic-dev/site-content/structured-data";
// The providers' own marks, the same five the app draws beside every session.
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COLUMN_SIZES, shotAsset, SHOT_WIDTHS } from "../lib/shots";
import Corners from "./Corners.astro";
import Divider from "./Divider.astro";
import DownloadCta from "./DownloadCta.astro";
import Footer from "./Footer.astro";
import Lotus from "./Lotus.astro";
import Lozenge from "./Lozenge.astro";
import Nav from "./Nav.astro";
import TrustCards from "./TrustCards.astro";
import Window from "./Window.astro";
import "../styles/home.css";

const content = landingContent;

// FAQPage structured data is flat: the topic bands are a reading aid for the page, not part of the schema.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

/* THE HEADLINE, RE-BEATEN. The content ships two typeset lines ("You delegate. Agents work." and "You
 * approve.") because they were written for a 32px setting in a 26rem column. This page sets the same words
 * at three times that size, one sentence per line, with the full stop carrying the only ember on the
 * screen — so the beats are re-split off the same strings rather than authored a second time here.
 * Splitting on the sentence rather than on the line is what keeps this page and landing.ts one source. */
const beats = content.hero.headlineLines
    .flatMap((line) => line.split(/(?<=\.)\s+/u))
    .map((beat) => beat.replace(/\.\s*$/u, ""))
    .filter((beat) => beat.length > 0);

const appScreens = content.hero.screens.app.map((screen) => ({ ...screen, image: shotAsset(screen.name) }));
/* THE WINGS HOLD STILLS. Only the centre frame walks its surfaces (see the script at the foot of this
 * file): a cross-fade inside a 340px frame is a flicker at the edge of vision, and caught mid-fade — which
 * on a four-second beat is a fair share of the time — it reads as two pictures printed over each other. So
 * the chat wing takes the first of the same shared list and holds it. */
const chatStill = shotAsset(content.hero.screens.chat[0]!.name);
/* THREE FRAMES ON ONE AXIS, so three measures, and all of them in `vw` because the frames take their width
 * from the window rather than from a capped shell (see `.hero-grid`).
 *
 * Each number is the frame's share of the window MULTIPLIED BY the crop: these are top-left crops drawn
 * larger than the frame that shows them, not whole screenshots shrunk to fit, so the pixels the browser
 * has to fetch are the drawn width and not the frame's. The centre takes 62% of the band at 112% = 70vw;
 * the plan wing 21% at 135% = 29vw; the chat wing 21% at 222% = 47vw. */
const appSizes = "(min-width: 64rem) 70vw, (min-width: 48rem) 78vw, 205vw";
const chatSizes = "(min-width: 64rem) 47vw, (min-width: 48rem) 56vw, 60vw";
const planSizes = "(min-width: 64rem) 29vw, (min-width: 48rem) 35vw, 40vw";

/* THE SUBHEAD, FIRST CLAUSE ONLY. The shared line is two sentences — what the product is, then a claim
 * about visibility — and this page keeps the first. The second is carried here by the picture beside it
 * rather than by words: three live surfaces of the product, turning, in the same screenful. Sliced off the
 * shared string rather than retyped, so a rewording upstream still lands here. */
const subheadLead = `${content.hero.subhead.split(/(?<=\.)\s+/u)[0] ?? content.hero.subhead}`;

/* THE LEAD VERB leads the section at full width; the other four are the compact cards below it. */
const [leadVerb, ...verbCards] = content.verbs.items;

/* THE GETTING-STARTED BEATS, SORTED BY WHERE THEY HAPPEN rather than by their number. Everything up to the
 * last one is done in a browser on our side; the last is the line you paste into a terminal on your own
 * machine, which is the only one that touches your hardware. Taken from the END rather than at a fixed
 * index so an extra browser-side beat upstream widens the left zone instead of being mistaken for the
 * machine one. */
const browserSteps = content.connect.steps.slice(0, -1);
const machineStep = content.connect.steps.at(-1)!;
---

<BaseLayout title={content.meta.title} description={content.meta.description} faq={faq} extraJsonLd={[buildSoftwareAppSchema()]} backdrop={false}>
    <div class="home flex flex-1 flex-col">
        {/* The bar is transparent over the plate until the first screen is behind you — the temple's own
            carved top border becomes the bar's, exactly as the reference art has it. Every other page
            gets the same picture from `PageBackdrop`, so the bar never changes under a reader. */}
        <Nav />

        <main class="flex-1">
            <!-- ═══ 1 · The first screen ═══════════════════════════════════════════════════════════
                 SYMMETRIC, because the picture behind it is. The art is a framed plaque with a devata
                 standing in each outer third and a deliberately empty middle; the copy sits in that
                 middle, on the axis, and the product is spread underneath it in three frames — one wide
                 one on the centre line and a narrower one leaning in from either side. -->
            <section class="hero" id="hero">
                <div class="plate" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                <div class="plate-fade" aria-hidden="true"></div>

                <div class="hero-grid">
                    <div class="hero-copy">
                        {/* The one line on this page that is a greeting rather than a claim. Flanked rather
                            than underlined — the band eyebrows elsewhere trail a hairline to the right,
                            which on a centred axis would tip the whole block sideways. */}
                        <p class="hero-eyebrow">
                            <Lozenge />
                            <span>Welcome to {ORG_NAME}</span>
                            <Lozenge />
                        </p>

                        <h1 class="headline">
                            {
                                beats.map((beat) => (
                                    <span class="headline-line">
                                        <span class="display">{beat}</span>
                                        <span class="stop">.</span>
                                    </span>
                                ))
                            }
                        </h1>

                        <p class="hero-sub">{subheadLead}</p>

                        {/* TWO PRESSES, and resist adding a third. On a centred axis three controls in a row
                            read as a toolbar, and the claim above them drops to a caption on it. They are
                            the two ways to START: the hosted workspace, and the same thing on the reader's
                            own machine. The demo is a fourth thing a visitor might want and it is not a way
                            to start, so it rides on the picture below instead — over the surface it is a
                            recording of.
                            `data-hero-cta` is watched by the script at the foot of the file: while this
                            button is on screen the bar keeps its own copy of it hidden, so the page never
                            shows the same call twice at once. */}
                        <div class="hero-actions">
                            <a class="btn btn-primary" href={APP_URL} data-hero-cta>Create your workspace</a>
                            <DownloadCta />
                        </div>
                    </div>

                    <!-- THE PRODUCT, IN THREE FRAMES ON ONE AXIS. The workspace is the wide one on the
                         centre line and the only one that cycles its surfaces; the plan and the chat lean in
                         from the sides, overlapping its edges, at the size a thing in the middle distance
                         would be. All three crop their screens from the top-left rather than fitting them,
                         so a reader sees the legible top of a screen instead of a whole one shrunk past
                         reading. -->
                    <figure class="hero-visual">
                        <div class="hero-stack">
                            <Window class="window-plan" aria-hidden="true">
                                <div class="window-crop window-crop-plan">
                                    <Image src={shotAsset("chat-plan")} alt="" widths={SHOT_WIDTHS} sizes={planSizes} loading="lazy" decoding="async" class="screen screen-plan" />
                                </div>
                            </Window>

                            {/* THE LEDGE IS EMPTY HERE, and that is the point of it. Elsewhere on the site a
                                frame names the route its screenshot was taken on, because that reader has
                                arrived on a page about one surface and wants to go open it. On the first
                                screen the picture is the argument, not a specimen, and a caption over three
                                cross-fading surfaces is a label that keeps changing under the eye. */}
                            <Window class="window-app" finial>
                                <div class="window-crop window-crop-app">
                                    {
                                        appScreens.map((screen, index) => (
                                            <Image
                                                src={screen.image}
                                                alt={screen.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes={appSizes}
                                                loading={index === 0 ? "eager" : "lazy"}
                                                fetchpriority={index === 0 ? "high" : undefined}
                                                decoding="async"
                                                class:list={["screen screen-app", index === 0 && "is-on"]}
                                                data-screen="app"
                                                aria-hidden={index > 0 ? "true" : undefined}
                                            />
                                        ))
                                    }
                                </div>

                                {/* THE DEMO, ON THE SURFACE IT IS A RECORDING OF. Quiet at rest and lit when
                                    the pointer or the keyboard reaches the frame, so it reads as a property
                                    of the picture rather than as a third button competing with the two
                                    above. Quiet, not hidden: a control that only exists on hover does not
                                    exist on a touch screen. Bottom-centre, clear of the side wings. */}
                                <a class="play" href={DEMO_PATH}>
                                    <span class="btn btn-sm">
                                        <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                                        <span>{content.hero.demo.playLabel}</span>
                                    </span>
                                </a>
                            </Window>

                            <Window class="window-chat" aria-hidden="true">
                                <div class="window-crop window-crop-chat">
                                    <Image src={chatStill} alt="" widths={SHOT_WIDTHS} sizes={chatSizes} loading="lazy" decoding="async" class="screen screen-chat" />
                                </div>
                            </Window>
                        </div>
                    </figure>
                </div>
            </section>

            <!-- ═══ 2 · What you do: the five verbs ═════════════════════════════════════════════ -->
            <section class="band" id="verbs">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.verbs.eyebrow}</div>
                    <h2 class="h2 display">{content.verbs.heading}</h2>
                    <p class="lede">{content.verbs.sub}</p>

                    {/* THE LEAD VERB IS ONE OF THE FIVE, so it is titled like the other four rather than
                        with a style of its own — the same lotus-and-title pair the trust cards use, one step
                        up in size because this one leads. That also gives the block the <h3> its four
                        siblings have, so the section has an outline a screen reader can walk. */}
                    <div class="lead-verb">
                        <div class="lead-verb-head">
                            <div>
                                <h3 class="lead-verb-name">
                                    <Lotus />
                                    {leadVerb.verb}
                                </h3>
                                <p class="lead-verb-line">{leadVerb.line}</p>
                            </div>
                            <a href={leadVerb.href} class="link see">See it →</a>
                        </div>
                        {
                            leadVerb.shot && (
                                <Window class="window-wide" finial>
                                    <Image
                                        src={shotAsset(leadVerb.shot.name)}
                                        alt={leadVerb.shot.alt}
                                        widths={SHOT_WIDTHS}
                                        sizes={COLUMN_SIZES}
                                        loading="lazy"
                                        decoding="async"
                                        class="window-full"
                                    />
                                </Window>
                            )
                        }
                    </div>

                    <div class="verb-grid">
                        {
                            verbCards.map((item) => (
                                <Window class="verb-card" href={item.href}>
                                    {item.shot ? (
                                        <div class="verb-crop">
                                            <Image
                                                src={shotAsset(item.shot.name)}
                                                alt={item.shot.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes="(min-width: 64rem) 420px, (min-width: 40rem) 45vw, calc(100vw - 3rem)"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>
                                    ) : (
                                        /* Automate has no honest screenshot, so its picture is the events it
                                           wakes on: a mocked-up automations screen would be the one lie here. */
                                        <div class="triggers">
                                            <div class="eyebrow">Wakes on</div>
                                            <ul>
                                                {item.triggers?.map((trigger) => (
                                                    <li>
                                                        <Lozenge />
                                                        {trigger}
                                                    </li>
                                                ))}
                                            </ul>
                                            <p class="triggers-out">
                                                <span aria-hidden="true">→</span> an optional command checks the event, then a new agent session starts and
                                                appears on your board.
                                            </p>
                                        </div>
                                    )}
                                    <div class="verb-body">
                                        <h3>{item.verb}</h3>
                                        <p>{item.line}</p>
                                    </div>
                                </Window>
                            ))
                        }
                    </div>

                    <a href="/features/" class="link band-cta">{content.verbs.cta} →</a>
                </div>
            </section>

            <!-- ═══ 3 · Why a workspace: the comparison ═════════════════════════════════════════
                 Two columns of nouns, and the asymmetry between them is the whole argument — so the heavy
                 side is a lit cartouche and the light one a dashed outline that ends early. -->
            <section class="band" id="workspace">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.workspace.eyebrow}</div>
                    <h2 class="h2 display">{content.workspace.heading}</h2>
                    <p class="lede">{content.workspace.sub}</p>

                    <div class="compare">
                        <div class="card compare-ours">
                            <Corners />
                            <div class="compare-head">
                                <h3>{content.workspace.comparison.ours.label}</h3>
                                <span>{content.workspace.comparison.ours.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.ours.items.map((item) => (
                                        <li>
                                            <Lotus />
                                            {item}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="compare-chat">
                            <div class="compare-head">
                                <h3>{content.workspace.comparison.chat.label}</h3>
                                <span>{content.workspace.comparison.chat.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.chat.items.map((item) => (
                                        <li>
                                            <Lozenge class="lozenge-quiet" />
                                            {item}
                                        </li>
                                    ))
                                }
                            </ul>
                            <p class="compare-missing">{content.workspace.comparison.chat.missing}</p>
                        </div>
                    </div>

                    <div class="compare-foot">
                        <p>{content.workspace.comparison.footnote}</p>
                        <a href="/features/review/" class="link">How reviewing agent work works →</a>
                    </div>
                </div>
            </section>

            <!-- ═══ 4 · What it costs ═══════════════════════════════════════════════════════════ -->
            <section class="band" id="economics">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.economics.eyebrow}</div>
                    <h2 class="h2 display">{content.economics.heading}</h2>
                    <p class="lede">{content.economics.sub}</p>

                    <div class="econ">
                        <div class="card accounts">
                            <Corners set="diag" />
                            <div class="accounts-head"><span class="eyebrow">Your agent accounts</span></div>
                            <ul>
                                {
                                    content.economics.accounts.map((account) => (
                                        <li>
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                                <path d={PROVIDER_BRAND_PATHS[account.logo]} fill-rule={providerFillRule(account.logo)} />
                                            </svg>
                                            <span class="account-name">{account.name}</span>
                                            <span class="account-detail">{account.detail}</span>
                                            <span class="account-tag">subscription</span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="card flat">
                            <Corners set="diag" />
                            <div class="eyebrow">Flat, not metered</div>
                            <ul>
                                {
                                    content.economics.points.map((point) => (
                                        <li>
                                            <Lotus />
                                            {point}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══ 5 · Who builds it ═══════════════════════════════════════════════════════════ -->
            <section class="band" id="trust">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="trust">
                        <div>
                            <div class="eyebrow">{content.trust.eyebrow}</div>
                            <h2 class="h2 display">{CREATOR_NAME}</h2>
                            <p class="lede">{creatorRole}</p>
                            <p class="trust-bio">{creatorBio}</p>
                            <a href="/about/" class="link band-cta">{content.trust.cta} →</a>
                        </div>

                        {/* The same four checkable claims /about/ carries, from the same module, with the
                            commit figure measured from git at build time rather than authored. */}
                        <TrustCards />
                    </div>
                </div>
            </section>

            <!-- ═══ 6 · Getting started ═════════════════════════════════════════════════════════ -->
            <section class="band" id="connect">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">{content.connect.eyebrow}</div>
                    <h2 class="h2 display">{content.connect.heading}</h2>
                    <p class="lede">{content.connect.sub}</p>

                    {/* THE STEPS ARE A PLAN OF THE SYSTEM, NOT A COUNT OF THEM. Two of the beats happen in a
                        browser on our side; the third happens in a terminal on yours, and the whole product
                        argument — the code and the keys never leave your hardware — is that boundary. So the
                        section draws the boundary and hangs the beats off it: a seam down the middle, our
                        side to the left, yours to the right, with the command sitting on your side because
                        that is where it runs. See the note in home.css for what this replaced. */}
                    <div class="flow">
                        <div class="flow-zone">
                            <div class="flow-where">in your browser</div>
                            {
                                browserSteps.map((step) => (
                                    <div class="station">
                                        <span class="station-mark" aria-hidden="true">
                                            <Lotus />
                                        </span>
                                        <h3>{step.title}</h3>
                                        <p>{step.body}</p>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="flow-seam" aria-hidden="true"></div>

                        <div class="flow-zone">
                            <div class="flow-where">on your machine</div>
                            <div class="station">
                                <span class="station-mark" aria-hidden="true">
                                    <Lotus />
                                </span>
                                <h3>{machineStep.title}</h3>
                                <p>{machineStep.body}</p>
                            </div>

                            <div class="frame command">
                                <Corners />
                                <div class="command-head"><span class="command-where">your terminal</span></div>
                                <pre><code><span class="prompt">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                            </div>
                            <p class="command-note">{content.connect.commandNote}</p>
                            {/* The other two rungs, one line under the command that assumes one of them. The
                                link is last so it is read as a check on the command rather than as a
                                competing offer. */}
                            <p class="command-note">
                                {content.connect.commandChoice.lead}{" "}
                                <a href="/where-it-runs/" class="text-link hover:underline">{content.connect.commandChoice.cta}</a>
                            </p>
                        </div>
                    </div>

                    <div class="card desktop">
                        <Corners set="diag" />
                        <div>
                            <p class="desktop-lead">{content.connect.desktop.lead}</p>
                            <p class="desktop-note">{content.connect.desktop.note}</p>
                        </div>
                        {/* THE ONE DOWNLOAD ON THE PAGE, and it names the reader's own machine. It sits
                            beside the install command because that is the question it answers: the same step,
                            for someone who would rather not open a terminal. */}
                        <DownloadCta class="btn-sm" label={content.connect.desktop.cta} icon={false} />
                    </div>
                </div>
            </section>

            <!-- ═══ 7 · FAQ ═════════════════════════════════════════════════════════════════════
                 Native <details>, so the whole widget costs no JavaScript and keeps keyboard and
                 screen-reader behaviour for free. `name` makes each band an exclusive accordion. -->
            <section class="band" id="faq">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell fade-in">
                    <div class="eyebrow">FAQ</div>
                    <h2 class="h2 display">Before you install it.</h2>
                    <p class="lede">What it costs, where your code sits, and what is not built yet.</p>

                    <div class="faq">
                        {
                            faqGroups.map((group) => (
                                <div class="faq-group" id={group.id}>
                                    <div class="faq-group-head">
                                        <h3>{group.label}</h3>
                                        <p>{group.blurb}</p>
                                    </div>
                                    <div class="faq-list">
                                        {group.items.map((item) => (
                                            <details id={item.id} name={group.id} class="faq-item scroll-mt-28">
                                                <summary>
                                                    <Lozenge class="faq-mark" />
                                                    <span>{item.question}</span>
                                                </summary>
                                                <div class="faq-answer">
                                                    {item.answer.map((paragraph) => (
                                                        <p>{paragraph}</p>
                                                    ))}
                                                    {item.more && (
                                                        <a href={item.more.href} class="link">
                                                            {item.more.label} →
                                                        </a>
                                                    )}
                                                </div>
                                            </details>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- ═══ 8 · The closing cartouche ═══════════════════════════════════════════════════
                 The plate returns, cropped to its foot — the temple and the lotus at the bottom of the art,
                 which is the half the first screen never shows because the windows cover it. -->
            <section class="band final">
                <div class="plate plate-foot" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                {/* THE ONE PLACE THIS PAGE AUTHORS ITS OWN WORDS. Everywhere else the copy is read from
                    `landing.ts`, so the page can never make a claim the content modules do not — see the
                    file header. The closing band is the exception, by request: it argues from the licence
                    and the community rather than from the fleet, so it needs a sentence the modules do not
                    have. If this ever stops being the closing argument, it belongs back in `landing.ts`
                    with the rest. */}
                <div class="shell fade-in final-inner">
                    <Lotus size="lg" />
                    <h2 class="h2 display final-heading">
                        <span>Open-source and free</span>
                        {/* The underline is drawn rather than `text-decoration`, which on a face this large
                            sits too close and too thin, and cannot take the page's gold. */}
                        <span class="final-forever">forever</span>
                    </h2>
                    <p class="lede final-sub">
                        Contribute to our code, extend workspace<br />or offer services for others.
                    </p>
                    <Divider class="final-divider" />
                    <div class="hero-actions">
                        <a class="btn btn-primary" href={APP_URL}>Create your workspace</a>
                        <a class="btn" href={githubUrl} target="_blank" rel="noopener">See the source</a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>

    <script>
        /* Two behaviours, and neither is load-bearing: the page is correct with the script removed. The
           bar's own call is held back while the hero's is on screen, and the centre frame walks its three
           surfaces.

           THE BAR'S HEIGHT USED TO BE MEASURED HERE and is now a stylesheet value — see `--bar-height` in
           global.css. Pinning the plate to its own 16:9 ratio made the art's scale a single term
           (`width / 1600`), which a stylesheet can name; the observer that stood here was left over from
           when the plate was `cover`-ed onto a content-sized box and the scale genuinely could not be
           written down. Losing it is what lets every other page have the same bar as this one rather than
           one only this page can compute. */
        const bar = document.getElementById("site-bar");

        /* THE BAR'S CALL TO ACTION, held back while the hero's own is on screen. The two say the same words,
           so showing both above the fold is one call printed twice; instead the bar keeps its copy hidden
           until the hero button has scrolled off, then reveals it as the standing shortcut. Setting
           `data-cta-managed` here — rather than in the markup — is what makes the no-JS fallback the safe
           one: with the script blocked the attribute never lands and the button is simply always shown.
           The negative top margin lets the reveal fire as the hero button slips under the fixed bar rather
           than only once it is fully off the top. */
        const heroCta = document.querySelector("[data-hero-cta]");
        if (bar && heroCta && "IntersectionObserver" in window) {
            bar.setAttribute("data-cta-managed", "");
            const ctaObserver = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        bar.toggleAttribute("data-cta-shown", !entry.isIntersecting);
                    }
                },
                { rootMargin: "-72px 0px 0px 0px", threshold: 0 },
            );
            ctaObserver.observe(heroCta);
        }

        /* ONE FRAME WALKS, and it is the middle one. The two wings hold stills: a cross-fade in a frame that
           size is movement at the edge of vision with nothing to show for it, and the centre is where a
           reader is already looking. Two surfaces, four seconds each. */
        const screens = document.querySelectorAll<HTMLElement>('[data-screen="app"]');
        if (screens.length > 1) {
            let shown = 0;
            setInterval(() => {
                shown = (shown + 1) % screens.length;
                screens.forEach((screen, index) => {
                    screen.classList.toggle("is-on", index === shown);
                    // The alt text a screen reader gets is the one on screen: nobody should be handed three
                    // descriptions of one picture.
                    screen.setAttribute("aria-hidden", index === shown ? "false" : "true");
                });
            }, 4000);
        }
    </script>
</BaseLayout>
