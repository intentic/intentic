---
/* Landing page composition for the Intentic site. */
import { faqGroups } from "@intentic/site-content/faq";
import { landingContent } from "@intentic/site-content/landing";
import { templeScene } from "@intentic/site-content/temple";
import { APP_URL, DEMO_PATH, HOSTED_ALT_LABEL, HOSTED_START_LABEL } from "@intentic/site-content/site";
import { buildSoftwareAppSchema } from "@intentic/site-content/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DESK_VARIANT } from "../lib/variant";
import ProductShot from "./ProductShot.astro";
import Corners from "./Corners.astro";
import DownloadCta from "./DownloadCta.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import Band from "./landing/Band.astro";
import Economics from "./landing/Economics.astro";
import FaqList from "./landing/FaqList.astro";
import Final from "./landing/Final.astro";
import Headline from "./landing/Headline.astro";
import Station from "./landing/Station.astro";
import Tour from "./landing/Tour.astro";
import Trust from "./landing/Trust.astro";
import Workspace from "./landing/Workspace.astro";
import TempleFigure from "./figures/TempleFigure.astro";
import Window from "./Window.astro";
import "../styles/home.css";
import "../styles/focused-hero.css";

/* THE DEVELOPER PAGE. intentic desk, the other product, is DeskLanding.astro at /desk/: its own words and pictures
   over the same shell, never a second edition of this document. */
interface Props {
    noindex?: boolean;
}

const content = landingContent;
const demo = content.hero.demo;

// FAQPage data stays flat; topic bands belong only to the page layout.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));


// The frame fills the hero stack (74rem) inside the grid's 2rem gutters, 1.5rem on a phone.
const appSizes = "(min-width: 78rem) 1184px, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 3rem)";


/* Getting started: the app is the primary path, the command and the hosted workspace are its labelled alternatives. */
const { steps: appSteps, alternatives } = content.connect;
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faq={faq}
    extraJsonLd={[buildSoftwareAppSchema()]}
    backdrop={false}
    noindex={Astro.props.noindex}
>
    <div class="home home-focused flex flex-1 flex-col">
        {/* The home bar overlays the plate; other pages use PageBackdrop. */}
        <Nav ctaManaged />

        <main class="flex-1">
            <!-- The first screen remains symmetric with its plate. -->
            <section class="hero" id="hero">
                <div class="plate" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                <div class="plate-fade" aria-hidden="true"></div>

                <div class="hero-grid">
                    <div class="hero-copy">
                        <Headline lines={content.hero.headlineLines} />

                        <p class="hero-sub">{content.hero.subhead}</p>

                        {/* Hero shows two start actions; the bar hides its duplicate while they are visible. */}
                        <div class="hero-actions" data-hero-cta>
                            <DownloadCta primary />
                            <a class="btn btn-secondary" href={APP_URL}>{HOSTED_ALT_LABEL}</a>
                        </div>

                        {/* The other product, for the reader who is in the wrong place: /desk/ is its own page. */}
                        <p class="hero-cross">
                            {content.crossLink.lead}{" "}
                            <a href={content.crossLink.href} class="link">{content.crossLink.label} →</a>
                        </p>
                    </div>

                    {/* THE HERO IS THE APP, LIVE (landing/live-demo.ts): the demo runs in the frame and answers clicks. The poster
                        is a screenshot of the view the frame opens on, so it is the LCP and stands until the app has drawn,
                        and it is all a phone or a reader saving data gets until they press for the live one. */}
                    <a class="live-skip sr-only focus:not-sr-only" href="#build">{demo.skipLabel}</a>
                    <figure class="hero-visual live" data-live data-state="poster" data-src={DEMO_PATH} data-light-variant={DESK_VARIANT}>
                        <div class="hero-stack">
                            <Window class="window-app" finial>
                                <div class="window-crop window-crop-app">
                                    <ProductShot
                                        name={demo.poster.name}
                                        alt={demo.poster.alt}
                                        sizes={appSizes}
                                        priority
                                        class="screen-app live-poster"
                                        data-live-poster
                                    />
                                    {/* Popover, so "Full screen" lifts it into the top layer where it stands: an iframe moved in the
                                        document reloads, and the visitor's place in the app would go with it. */}
                                    <div class="live-stage" popover="manual" data-live-stage aria-label={demo.frameTitle}>
                                        <div class="live-bar">
                                            <span class="live-bar-label">{demo.frameTitle}</span>
                                            <button type="button" class="btn btn-sm" data-live-close>{demo.closeLabel}</button>
                                        </div>
                                        <p class="live-wait">Starting the live workspace…</p>
                                    </div>
                                </div>

                                {/* Until the app has drawn: the press that starts it here, or on a phone opens it over the page. */}
                                <div class="play live-start" data-live-start hidden>
                                    <button type="button" class="btn btn-sm">
                                        <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                                        <span class="live-start-idle">{demo.startLabel}</span>
                                        <span class="live-start-busy">Starting…</span>
                                    </button>
                                </div>
                            </Window>
                        </div>
                        <figcaption class="live-caption">
                            <span>{demo.note}</span>
                            <button type="button" class="live-expand link" data-live-expand hidden>{demo.expandLabel}</button>
                        </figcaption>
                    </figure>
                </div>
            </section>

            <!-- The build section follows the hero. -->
            <section class="band" id="build">
                <div class="wall" aria-hidden="true"></div>
                <div class="shell build-open fade-in">
                    <div class="eyebrow">{templeScene.eyebrow}</div>
                    <h2 class="h2 display">{templeScene.heading}</h2>
                    <p class="lede">{templeScene.sub}</p>
                </div>

                {/* Build stage width matches the screenshots below it. */}
                <div class="stage build-stage fade-in">
                    <div class="card build-plate">
                        <Corners />
                        <TempleFigure />
                    </div>
                </div>
            </section>

            <!-- Rows render as one screenful per showcase stage. -->
            <Tour content={content.verbs} />

            <!-- Compare the two working environments side by side. -->
            <Workspace content={content.workspace} />

            <!-- Explain the cost model. -->
            <Economics content={content.economics} accountsLabel="Your agent accounts" flatLabel="Flat, not metered" />

            <!-- Identify who builds it. -->
            <Trust />

            <!-- Show how to get started. -->
            <Band id="connect" intro={content.connect}>
                {/* Same sequence as /download/: install, sign in, Run on this computer. Alternatives sit in their own labelled zone. */}
                <div class="flow">
                    <div class="flow-zone">
                        <div class="flow-where">With the app</div>
                        {
                            appSteps.map((step) => (
                                <Station step={step} />
                            ))
                        }
                        <p class="mt-6">
                            <DownloadCta primary class="btn-sm" label={content.connect.appCta} icon={false} />
                        </p>
                    </div>

                    <div class="flow-seam" aria-hidden="true"></div>

                    <div class="flow-zone">
                        <div class="flow-where">{alternatives.heading}</div>
                        <Station step={alternatives.command} />

                        <div class="frame command">
                            <Corners />
                            <div class="command-head"><span class="command-where">your terminal</span></div>
                            <pre><code><span class="prompt">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                        </div>
                        <p class="command-note">{alternatives.command.note}</p>
                        <p class="command-note">
                            {alternatives.command.compare.lead}{" "}
                            <a href="/where-it-runs/" class="text-link hover:underline">{alternatives.command.compare.cta}</a>
                        </p>

                        <Station step={alternatives.hosted} class="mt-8">
                            <p class="mt-3">
                                <a class="btn btn-secondary btn-sm" href={APP_URL}>{HOSTED_START_LABEL}</a>
                            </p>
                        </Station>
                    </div>
                </div>
            </Band>

            <!-- FAQ uses native details for keyboard and screen-reader behavior. -->
            <Band id="faq" intro={{ eyebrow: "FAQ", heading: "Before you install it.", sub: "What it costs, where your code sits, and what is not built yet." }}>
                <div class="faq">
                    {
                        faqGroups.map((group) => (
                            <div class="faq-group" id={group.id}>
                                <div class="faq-group-head">
                                    <h3>{group.label}</h3>
                                    <p>{group.blurb}</p>
                                </div>
                                <FaqList items={group.items} groupId={group.id} />
                            </div>
                        ))
                    }
                </div>
            </Band>

            <!-- Closing cartouche returns the plate at the page end. -->
            <Final>
                <Fragment slot="description">Contribute to our code, extend your workspace.</Fragment>
                <DownloadCta primary />
            </Final>
        </main>

        <Footer />
    </div>

    <script>
        import { observeHeroCta } from "./landing/hero-cta";
        import { mountLiveDemo } from "./landing/live-demo";

        observeHeroCta();

        mountLiveDemo();
    </script>
</BaseLayout>
