---
import { CREATOR_NAME, creatorBio, creatorRole } from "@intentic-dev/site-content/about";
import { faqGroups } from "@intentic-dev/site-content/faq";
import type { LandingContent } from "@intentic-dev/site-content/landing";
import { APP_URL, DEMO_PATH, discordUrl, githubIssuesUrl, githubUrl } from "@intentic-dev/site-content/site";
import { buildSoftwareAppSchema } from "@intentic-dev/site-content/structured-data";
// The providers' own marks, the same five the app draws beside every session.
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";
import { Image } from "astro:assets";
import { COLUMN_SIZES, shotAsset, SHOT_WIDTHS } from "../lib/shots";
import BaseLayout from "../layouts/BaseLayout.astro";
import CreatorLinks from "./CreatorLinks.astro";
import DiscordIcon from "./DiscordIcon.astro";
import DownloadCta from "./DownloadCta.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import ProductShotFigure from "./ProductShotFigure.astro";
import TrustCards from "./TrustCards.astro";

interface Props {
    content: LandingContent;
    noindex?: boolean;
}

const { content, noindex } = Astro.props;

// FAQPage structured data is flat: the topic bands are a reading aid for the page, not part of the schema.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

const checkIcon = icon('<path d="M20 6 9 17l-5-5"/>');
// Marks what the chat-box column does not give you, in the workspace comparison.
const crossIcon = icon('<path d="M18 6 6 18M6 6l12 12"/>');
// The FAQ disclosure marker. Both strokes are drawn; CSS rotates the vertical one away when open.
const plusIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14"/><path class="faq-marker-bar" d="M12 5v14"/></svg>`;

/* The hero is the LCP and it is a CROP: the frame shows 262% of its own width on a phone and 168% from sm up,
 * so what the browser paints is that multiple of the column, not the column. Spelling the three cases out is
 * the difference between fetching ~950px of screenshot and fetching all 2144. */
const heroImage = shotAsset(content.hero.shot.name);
const heroSizes = "(min-width: 64rem) calc((min(100vw, 80rem) - 6rem) * 0.84), (min-width: 40rem) calc(min(100vw - 3rem, 34rem) * 1.68), calc(min(100vw - 3rem, 34rem) * 2.62)";

// The tour leads with the first verb (Orchestrate) at full width; the rest are the compact cards.
const [leadVerb, ...verbCards] = content.verbs.items;
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faq={faq}
    extraJsonLd={[buildSoftwareAppSchema()]}
    noindex={noindex}
>
    <Nav />
    <main class="flex-1">
        <!-- 1 · Hero -->
        <section class="relative overflow-hidden" id="hero">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>

            <!-- Floating ambient orbs -->
            <div class="hero-orbs" aria-hidden="true">
                <svg width="0" height="0">
                    <defs>
                        <radialGradient id="orb-glow" cx="40%" cy="35%" r="50%">
                            <stop offset="0%" stop-color="oklch(82% 0.14 55)" />
                            <stop offset="60%" stop-color="oklch(72% 0.17 55)" />
                            <stop offset="100%" stop-color="oklch(60% 0.16 55)" />
                        </radialGradient>
                    </defs>
                </svg>

                {
                    [1, 2, 3, 4, 5, 6, 7].map((n) => (
                        <svg class={`orb orb-${n}`} viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="46" fill="url(#orb-glow)" stroke="oklch(77% 0.155 55 / 0.2)" stroke-width="0.8" />
                            <ellipse cx="38" cy="36" rx="18" ry="14" fill="rgba(255,255,255,0.10)" />
                        </svg>
                    ))
                }
            </div>

            <div class="grid-overlay" aria-hidden="true"></div>

            <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pt-32 pb-20 lg:grid-cols-2 lg:pt-40 lg:pb-28">
                <div class="animate-fade-in-up">
                    {/* One authored line per block, not one <br>-joined run: a line that has to wrap then
                        wraps inside its own box, and the balanced heading wrap splits it evenly instead of
                        leaving the last word alone under a full line. The display step is 44px rather than
                        48px because the column is 592px at every width from xl up (max-w-7xl caps the
                        container, so it never grows) and the longest line measures 629px at 48px: it
                        wrapped on desktop. */}
                    <h1 class="text-4xl leading-tight font-semibold tracking-tight xl:text-[2.75rem]">
                        {content.hero.headlineLines.map((line) => (
                            <span class="block">{line}</span>
                        ))}
                    </h1>
                    <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                        {content.hero.subhead}
                    </p>
                    {/* The literal restatement. Quieter than the subhead on purpose: a reader who is already
                        sold skims past it, and a reader who is not gets the mechanism in one sentence. It is
                        ordinary crawlable prose in the first screen rather than a chip, because the concepts
                        it carries (parallel agents, a container each, reviewing the diff) are phrases, and a
                        phrase split across three bullets is not the phrase any more. */}
                    <p class="mt-3 max-w-copy text-sm leading-relaxed text-subtle">
                        {content.hero.summary}
                    </p>

                    {/* Three doors, one primary: the app, the repository, and an installer for the computer
                        this is being read on. The download stays secondary because the invitation to begin is
                        still the hosted one — it is the same product either way, and asking a stranger to run
                        an installer first is a bigger ask than a sign-in. It wraps to its own line below the
                        other two once the column narrows, which is where it belongs anyway. */}
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                        <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the source</a>
                        <DownloadCta />
                    </div>

                    <ul class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-subtle">
                        {
                            content.hero.chips.map((chip) => (
                                <li class="flex items-center gap-1.5">
                                    <span class="h-1 w-1 rounded-full bg-primary-500" />
                                    {chip}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- The claim, proven immediately: the real fleet board. The frame crops the full-width
                     screenshot to its Attention + Active lanes so agent cards stay legible beside the copy;
                     the third lane bleeds past the right edge, and section 2 shows the whole board. -->
                <!-- Capped until the hero splits into two columns: the crop scales with the frame, so a
                     full-width frame on a tablet would blow the screenshot up to twice its intended size. -->
                <figure class="animate-fade-in-up m-0 w-full max-w-[34rem] lg:mx-0 lg:max-w-none" style="animation-delay: 60ms">
                    <div class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                        <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{content.hero.shot.frameLabel}</span>
                        </div>
                        <!-- Crop window. The width percentages pick how much of the 1072px-wide surface shows:
                             262% ≈ rail + the Attention lane (phones), 168% ≈ through the Active lane (from sm up).
                             Each aspect ratio is the matching slice of the source, so the image fills the box.

                             The press over it is a plain link to the demo's own page, the same on every screen and
                             the same as every other "open the workspace" call on the site. An IDE needs a viewport:
                             not this box (half a hero column) and not an overlay with a marketing chrome bar over
                             it. The image stays the LCP, undimmed until hover, and the page still ships no part of
                             the app. -->
                        <div class="relative aspect-[5/7] overflow-hidden sm:aspect-6/5">
                            <Image
                                src={heroImage}
                                alt={content.hero.shot.alt}
                                widths={SHOT_WIDTHS}
                                sizes={heroSizes}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="w-[262%] max-w-none sm:w-[168%]"
                            />
                            <a
                                href={DEMO_PATH}
                                class="group absolute inset-0 flex items-center justify-center bg-canvas/10 transition hover:bg-canvas/35 focus-visible:bg-canvas/35 focus-visible:outline-none"
                            >
                                <span
                                    class="flex items-center gap-2.5 rounded-full border border-line bg-canvas/85 px-5 py-2.5 text-sm font-medium shadow-xl shadow-black/40 backdrop-blur transition group-hover:border-primary-500 group-hover:text-primary-500"
                                >
                                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5"><path d="M8 5v14l11-7z" /></svg>
                                    {content.hero.demo.playLabel}
                                </span>
                            </a>
                        </div>
                    </div>
                    <figcaption class="mt-3 text-2xs leading-relaxed text-subtle/80">{content.hero.demo.note}</figcaption>
                </figure>
            </div>
        </section>

        <!-- 2 · What you do: the five verbs, said once.
             The single telling of what the product does, in the same order as the Features menu, so the
             home page and the feature pages read as one product. It replaces the old four-beat "loop" and
             six-tile "extend" bands, which between them said the same powers three times over. Orchestrate
             leads at full width because the board is the product's face; the other four are compact cards,
             each a cropped real screen or, for Automate, its trigger list, because there is no honest
             screenshot of an automations screen and a mockup would be the one lie on the page. -->
        <section class="border-t border-line" id="verbs">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.verbs.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight">{content.verbs.heading}</h2>
                <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{content.verbs.sub}</p>

                <!-- The lead verb: the whole board, with its one line above it. -->
                <div class="mt-12 lg:mt-14">
                    <div class="flex max-w-3xl flex-wrap items-end justify-between gap-x-6 gap-y-3">
                        <div class="max-w-2xl">
                            <div class="eyebrow text-link">{leadVerb.verb}</div>
                            <p class="mt-2 text-lg leading-relaxed text-balance text-content">{leadVerb.line}</p>
                        </div>
                        <a href={leadVerb.href} class="text-sm font-medium whitespace-nowrap text-link hover:underline">See it →</a>
                    </div>
                    {leadVerb.shot && (
                        <ProductShotFigure
                            shot={{ name: leadVerb.shot.name, alt: leadVerb.shot.alt, frame: "browser", label: leadVerb.shot.label }}
                            sizes={COLUMN_SIZES}
                            class="mt-6"
                        />
                    )}
                </div>

                <!-- The other four: compact cards, each a link to its page. A real screen shows as a cropped
                     thumbnail so it reads as an interface rather than a shrunk-illegible one; Automate, which
                     has no honest screen, shows the events it wakes on instead. -->
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:mt-6">
                    {
                        verbCards.map((item) => (
                            <a href={item.href} class="card group flex flex-col overflow-hidden transition-colors hover:border-line-strong">
                                {item.shot ? (
                                    <div>
                                        <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                            <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">
                                                {item.shot.label}
                                            </span>
                                        </div>
                                        <div class="relative h-52 overflow-hidden border-b border-line">
                                            <Image
                                                src={shotAsset(item.shot.name)}
                                                alt={item.shot.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes="(min-width: 64rem) 420px, (min-width: 40rem) 45vw, calc(100vw - 3rem)"
                                                loading="lazy"
                                                decoding="async"
                                                class="absolute top-0 left-0 w-[150%] max-w-none"
                                            />
                                        </div>
                                    </div>
                                ) : (
                                    // Automate has no honest screenshot, so its visual is the trigger→outcome it names.
                                    // `flex-1` lets it grow to the height the screenshot cards set, and `justify-between`
                                    // spreads the events to the top and the outcome to the bottom so the cell fills.
                                    <div class="flex flex-1 flex-col justify-between border-b border-line bg-primary-600/[0.03] p-5">
                                        <div>
                                            <div class="eyebrow text-link">Wakes on</div>
                                            <ul class="mt-3 grid grid-cols-2 gap-x-5 gap-y-2">
                                                {item.triggers?.map((trigger) => (
                                                    <li class="flex items-center gap-2 text-sm text-muted">
                                                        <span class="h-1 w-1 shrink-0 rounded-full bg-primary-500" />
                                                        {trigger}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                        <p class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-subtle">
                                            <span class="text-link" aria-hidden="true">→</span>
                                            an optional command checks the event, then a new agent session starts and appears on your board.
                                        </p>
                                    </div>
                                )}
                                <div class:list={["p-5", item.shot && "flex flex-1 flex-col"]}>
                                    <h3 class="flex items-center gap-2 text-base font-semibold tracking-tight text-content">
                                        {item.verb}
                                        <span class="text-subtle opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
                                            →
                                        </span>
                                    </h3>
                                    <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">{item.line}</p>
                                </div>
                            </a>
                        ))
                    }
                </div>

                <a href="/features/" class="mt-10 inline-block text-sm font-medium text-link hover:underline">{content.verbs.cta} →</a>
            </div>
        </section>

        <!-- 3 · Why a workspace: the comparison.
             This slot held the ownership ledger until 2026-08-15. That band answered "is my code safe"
             a whole screenful before anyone had asked it, under a heading that was a slogan, and the
             trust band below already made the same argument with its qualifier and its link. The slot
             now answers the question the hero actually raises: it promises you approve everything, so
             this shows what you approve WITH. Still a COMPARISON, so still two columns, nouns only, and
             the asymmetry between the lists carries the whole argument. -->
        <section class="border-t border-line" id="workspace">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.workspace.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.workspace.heading}</h2>
                <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{content.workspace.sub}</p>

                <!-- `items-start`, not stretch: each card ends where its own list ends, and the platform's
                     card being visibly the shorter of the two is the argument made in silhouette. -->
                <div class="mt-12 grid items-start gap-5 lg:grid-cols-2">
                    <!-- The heavy side: solid card, brand-tinted, a filled dot per line. -->
                    <div class="card border-primary-600/30 bg-primary-600/[0.03] p-6 sm:p-7">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h3 class="text-base font-semibold tracking-tight text-content">{content.workspace.comparison.ours.label}</h3>
                            <span class="text-xs text-subtle">{content.workspace.comparison.ours.note}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.workspace.comparison.ours.items.map((item) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-content">
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-500" />
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <!-- The light side: dashed, unfilled, and shorter than its neighbour, so the two read
                         as different weights before a single word of either is read. -->
                    <div class="rounded-2xl border border-dashed border-line-strong p-6 sm:p-7">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h3 class="text-base font-semibold tracking-tight text-muted">{content.workspace.comparison.chat.label}</h3>
                            <span class="text-xs text-subtle">{content.workspace.comparison.chat.note}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.workspace.comparison.chat.items.map((item) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full border border-line-strong" />
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                        <p class="mt-5 flex max-w-copy items-start gap-3 border-t border-line pt-5 text-sm leading-relaxed text-subtle">
                            <span class="mt-0.5 shrink-0 text-subtle/70">
                                <Fragment set:html={crossIcon} />
                            </span>
                            {content.workspace.comparison.chat.missing}
                        </p>
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
                    <p class="max-w-copy text-xs leading-relaxed text-subtle">{content.workspace.comparison.footnote}</p>
                    <a href="/features/review/" class="text-sm font-medium text-link hover:underline">How reviewing agent work works →</a>
                </div>
            </div>
        </section>

        <!-- 4 · Economics: your subscriptions, your hardware, nothing to pay us -->
        <section class="border-t border-line" id="economics">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.economics.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight">{content.economics.heading}</h2>
                <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{content.economics.sub}</p>

                <div class="mt-12 grid items-start gap-6 lg:grid-cols-2">
                    <div class="card overflow-hidden">
                        <div class="border-b border-line px-5 py-3">
                            <span class="eyebrow">Your agent accounts</span>
                        </div>
                        <ul class="divide-y divide-line">
                            {
                                content.economics.accounts.map((account) => (
                                    <li class="flex items-center gap-3 px-5 py-4">
                                        {/* The provider's own mark, in place of the status dot that used to sit
                                            here: the dot said "connected" about accounts the reader has not
                                            connected yet, while the logo says which account the row means at a
                                            glance. Drawn in currentColor at text size, exactly as the app draws it. */}
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            fill="currentColor"
                                            class="shrink-0 text-content"
                                            aria-hidden="true"
                                        >
                                            <path d={PROVIDER_BRAND_PATHS[account.logo]} fill-rule={providerFillRule(account.logo)} />
                                        </svg>
                                        <div class="flex flex-1 flex-wrap items-baseline justify-between gap-x-3">
                                            <h3 class="text-sm font-medium text-content">{account.name}</h3>
                                            <span class="text-2xs text-subtle">{account.detail}</span>
                                        </div>
                                        <span class="chip bg-success/10 text-success">subscription</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="card p-5">
                        <div class="eyebrow">Flat, not metered</div>
                        <ul class="mt-4 space-y-3">
                            {
                                content.economics.points.map((point) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                                        <span class="mt-0.5 shrink-0 text-link">
                                            <Fragment set:html={checkIcon} />
                                        </span>
                                        {point}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </section>


        <!-- 6 · About the creator: the last objection before the command.
             The page has just asked a visitor to run a container on their own machine and hand it a
             GitHub token and a database password. Its first card answers the architectural half of "can
             I trust this" and is the only place on the page that does, now that the ownership band is
             retired; the rest answers the human half, which until now existed only in the page's JSON-LD
             told to Google and never to the reader.
             Verifiability, not popularity: no logos, no testimonials, no counter that could render a
             zero. The name, bio and cards come from about.ts so this band and /about/ cannot drift. -->
        <section class="border-t border-line" id="trust">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
                    <div>
                        <div class="eyebrow">{content.trust.eyebrow}</div>
                        <h2 class="mt-3 text-3xl font-semibold tracking-tight">{CREATOR_NAME}</h2>
                        <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{creatorRole}</p>
                        <p class="mt-3 max-w-copy text-sm leading-relaxed text-subtle">{creatorBio}</p>
                        <CreatorLinks class="mt-6" />
                        <a href="/about/" class="mt-6 inline-block text-sm font-medium text-link hover:underline">{content.trust.cta} →</a>
                    </div>

                    <TrustCards />
                </div>
            </div>
        </section>

        <!-- 7 · Get connected: ghost-numeral steps, no boxes -->
        <section class="border-t border-line" id="connect">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.connect.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.connect.heading}</h2>
                <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{content.connect.sub}</p>

                <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
                    {
                        content.connect.steps.map((step, i) => (
                            <div>
                                <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                    0{i + 1}
                                </div>
                                <h3 class="mt-3 text-sm font-medium text-content">{step.title}</h3>
                                <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="code-window mt-10">
                    <div class="flex items-center justify-between border-b border-line px-4 py-2">
                        <span class="eyebrow">Step 3 · your machine</span>
                    </div>
                    <pre class="px-4 py-3 text-content"><code><span class="text-subtle">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                </div>
                <p class="mt-3 text-xs text-subtle">{content.connect.commandNote}</p>

                {/* The alternative to step 3, sitting under step 3 rather than in place of it. This band is
                    where the page asks for a terminal, and a terminal is where it loses people. So the way
                    out belongs here, at the moment the hesitation lands, as well as in the top bar.

                    Secondary, and narrower than the code window above it: the app is a window around that same
                    install, not a rival to it, and the hero already spends the page's one primary button. The
                    width is the CONTENT's: a note at its readable measure, the button beside it because at
                    the band's full 77rem the two sat half a metre apart with nothing between them. The
                    platforms are named on the button because there is no macOS build: a reader on a Mac
                    learns that here, with the one-liner that does work still on screen, not after a click. */}
                <div
                    class="mt-6 flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-3 rounded-2xl border border-line bg-card/40 px-5 py-4"
                >
                    <div class="min-w-64 flex-1">
                        <p class="text-sm font-medium text-content">{content.connect.desktop.lead}</p>
                        <p class="mt-1 max-w-copy text-xs leading-relaxed text-muted">{content.connect.desktop.note}</p>
                    </div>
                    <a class="btn btn-secondary shrink-0" href="/download/">{content.connect.desktop.cta}</a>
                </div>
            </div>
        </section>

        <!-- 8 · FAQ: collapsed disclosures in topic bands.
             Open, thirteen answers were the longest thing on the page by a wide margin and a visitor had
             to scroll past twelve of them to reach their own question. Collapsed, the whole FAQ is a list
             of headlines you skim in one screen.

             Native <details>, so this costs no JavaScript and keeps keyboard and screen-reader behaviour
             for free. `name` groups each band into an exclusive accordion: opening one closes its
             sibling, so the section never grows back into the wall it replaced. The answers are still in
             the HTML, so the FAQPage schema above and in-page find both still see them. -->
        <section class="border-t border-line" id="faq">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">FAQ</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">Questions, answered plainly.</h2>
                <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">Including the honest ones: what's free, what's stored where, what isn't ready yet.</p>

                <div class="mt-10 max-w-2xl space-y-10">
                    {
                        faqGroups.map((group) => (
                            <div id={group.id} class="scroll-mt-24">
                                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <h3 class="text-sm font-semibold tracking-tight text-content">{group.label}</h3>
                                    <p class="text-xs text-subtle">{group.blurb}</p>
                                </div>

                                <div class="mt-3 border-b border-line">
                                    {group.items.map((item) => (
                                        <details id={item.id} name={group.id} class="faq-item scroll-mt-24 border-t border-line">
                                            <summary class="flex cursor-pointer list-none items-start gap-4 py-4 text-[0.9375rem] leading-snug font-medium text-content transition-colors hover:text-link">
                                                {item.question}
                                                {/* Rotates to a minus when open; drawn rather than a marker so it
                                                    matches the 1.5-stroke motif the rest of the page uses. */}
                                                <span class="faq-marker mt-0.5 ml-auto shrink-0 text-subtle transition-transform duration-200">
                                                    <Fragment set:html={plusIcon} />
                                                </span>
                                            </summary>
                                            <div class="pb-5">
                                                {item.answer.map((paragraph) => (
                                                    <p class="mt-0 mb-2.5 max-w-copy text-sm leading-relaxed text-muted last:mb-0">{paragraph}</p>
                                                ))}
                                                {item.more && (
                                                    <a href={item.more.href} class="mt-3 inline-block text-sm font-medium text-link hover:underline">
                                                        {item.more.label} →
                                                    </a>
                                                )}
                                            </div>
                                        </details>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>

                {/* The one place on this page a visitor is holding an unanswered question, so it is the one
                    place the community belongs: not the hero and not the final CTA, where it would compete
                    with the thing we actually want them to do. Two doors rather than one, because the reader
                    who bounced off the FAQ has one of two problems and Issues only ever fitted the second:
                    a question wants a person, a bug wants a record. Discord leads because it is the lighter
                    of the two asks, and "still unanswered" is usually a question. */}
                <div class="mt-10 max-w-2xl rounded-2xl border border-line bg-card/40 px-5 py-4">
                    <p class="text-sm text-muted">Still unanswered? Ask in Discord if it's a question, open an issue if it's a bug. Both get a real reply.</p>
                    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2">
                        <a
                            href={discordUrl}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center gap-2 text-sm font-medium text-link hover:underline"
                        >
                            <DiscordIcon size={15} />
                            Ask in Discord →
                        </a>
                        <a href={githubIssuesUrl} target="_blank" rel="noopener" class="text-sm font-medium text-link hover:underline">Open an issue →</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9 · Final CTA -->
        <section class="relative overflow-hidden border-t border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="fade-in relative mx-auto max-w-7xl px-6 py-20 text-center lg:py-28">
                <div class="eyebrow">Ready</div>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{content.finalCta.heading}</h2>
                <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted">{content.finalCta.sub}</p>
                <div class="mt-8 flex justify-center gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                    <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the engine</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <script>
        // Fade-in observer
        const targets = document.querySelectorAll(".fade-in");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.12 },
            );
            targets.forEach((el) => observer.observe(el));
        } else {
            targets.forEach((el) => el.classList.add("visible"));
        }

        // Scroll-based depth parallax for hero orbs
        const hero = document.getElementById("hero");
        const orbsLayer = document.querySelector(".hero-orbs");
        const gridOverlay = document.querySelector(".grid-overlay");

        if (hero && orbsLayer) {
            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            const y = window.scrollY;
                            const limit = hero.offsetHeight;
                            if (y < limit) {
                                (orbsLayer as HTMLElement).style.transform = `translateY(${y * 0.3}px) scale(${1 + y * 0.0003})`;
                                if (gridOverlay) {
                                    (gridOverlay as HTMLElement).style.transform = `translateY(${y * 0.15}px)`;
                                }
                            }
                            ticking = false;
                        });
                        ticking = true;
                    }
                },
                { passive: true },
            );
        }
    </script>
</BaseLayout>
