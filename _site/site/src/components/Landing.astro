---
import { CREATOR_NAME, creatorBio, creatorRole } from "@intentic-dev/site-content/about";
import { faqGroups } from "@intentic-dev/site-content/faq";
import type { LandingContent } from "@intentic-dev/site-content/landing";
import { APP_URL, DEMO_PATH, githubIssuesUrl, githubUrl } from "@intentic-dev/site-content/site";
import { buildSoftwareAppSchema } from "@intentic-dev/site-content/structured-data";
import { Image } from "astro:assets";
import { COLUMN_SIZES, shotAsset, SHOT_WIDTHS } from "../lib/shots";
import BaseLayout from "../layouts/BaseLayout.astro";
import CreatorLinks from "./CreatorLinks.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import TrustCards from "./TrustCards.astro";

interface Props {
    content: LandingContent;
    noindex?: boolean;
}

const { content, noindex } = Astro.props;

// FAQPage structured data is flat — the topic bands are a reading aid for the page, not part of the schema.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

const checkIcon = icon('<path d="M20 6 9 17l-5-5"/>');
// Marks the platform's deliberate absences in the ownership ledger.
const crossIcon = icon('<path d="M18 6 6 18M6 6l12 12"/>');
// The FAQ disclosure marker. Both strokes are drawn; CSS rotates the vertical one away when open.
const plusIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14"/><path class="faq-marker-bar" d="M12 5v14"/></svg>`;

// Per-index glyphs for the extend bento, in tile order; content stays pure copy.
const extendIcons = [
    icon('<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>'),
    icon('<path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/>'),
    icon('<path d="M4 10.5 12 4l8 6.5"/><path d="M6.5 9.5V20h11V9.5"/><path d="M10 20v-4h4v4"/>'),
    icon('<path d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path d="M2.5 20v-1a5 5 0 0 1 5-5H10"/><path d="M16 8.5a3 3 0 1 1 2 5.3"/><path d="M15 20v-1a4 4 0 0 1 4-4h2.5"/>'),
    icon('<rect x="3.5" y="4" width="17" height="7" rx="2"/><rect x="3.5" y="13" width="17" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>'),
    icon('<rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M7.5 8V4.5h9V8"/><path d="M9.5 21v-4h5v4"/>'),
];

/* The hero is the LCP and it is a CROP: the frame shows 262% of its own width on a phone and 168% from sm up,
 * so what the browser paints is that multiple of the column, not the column. Spelling the three cases out is
 * the difference between fetching ~950px of screenshot and fetching all 2144. */
const heroImage = shotAsset(content.hero.shot.name);
const heroSizes = "(min-width: 64rem) calc((min(100vw, 80rem) - 6rem) * 0.84), (min-width: 40rem) calc(min(100vw - 3rem, 34rem) * 1.68), calc(min(100vw - 3rem, 34rem) * 2.62)";
/* Same idea for the one portrait beat: 145% of half the column above lg, 145% of the whole one below it. */
const cropBeatSizes = "(min-width: 64rem) calc((min(100vw, 80rem) - 6.5rem) * 0.725), calc((100vw - 3rem) * 1.45)";

// Line glyphs for the sandbox figure (same 1.5-stroke motif as the section icons above).
const monitorGlyph = icon('<rect x="3" y="4" width="18" height="12.5" rx="1.5"/><path d="M8.5 20.5h7M12 16.5v4"/>');
const cubeGlyph = icon('<path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"/><path d="m3.5 7 8.5 4.5L20.5 7M12 11.5v10"/>');
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faq={faq}
    extraJsonLd={[buildSoftwareAppSchema()]}
    noindex={noindex}
>
    <Nav />
    <main class="flex-1">
        <!-- 1 · Hero -->
        <section class="relative overflow-hidden" id="hero">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>

            <!-- Floating ambient orbs -->
            <div class="hero-orbs" aria-hidden="true">
                <svg width="0" height="0">
                    <defs>
                        <radialGradient id="orb-glow" cx="40%" cy="35%" r="50%">
                            <stop offset="0%" stop-color="oklch(82% 0.14 55)" />
                            <stop offset="60%" stop-color="oklch(72% 0.17 55)" />
                            <stop offset="100%" stop-color="oklch(60% 0.16 55)" />
                        </radialGradient>
                    </defs>
                </svg>

                {
                    [1, 2, 3, 4, 5, 6, 7].map((n) => (
                        <svg class={`orb orb-${n}`} viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="46" fill="url(#orb-glow)" stroke="oklch(77% 0.155 55 / 0.2)" stroke-width="0.8" />
                            <ellipse cx="38" cy="36" rx="18" ry="14" fill="rgba(255,255,255,0.10)" />
                        </svg>
                    ))
                }
            </div>

            <div class="grid-overlay" aria-hidden="true"></div>

            <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pt-32 pb-20 lg:grid-cols-2 lg:pt-40 lg:pb-28">
                <div class="animate-fade-in-up">
                    {/* One authored line per block, not one <br>-joined run: a line that has to wrap then
                        wraps inside its own box, and `text-balance` splits it evenly instead of leaving the
                        last word alone under a full line. The display step is 44px rather than 48px because
                        the column is 592px at every width from xl up (max-w-7xl caps the container, so it
                        never grows) and the longest line measures 629px at 48px — it wrapped on desktop. */}
                    <h1 class="text-4xl leading-tight font-semibold tracking-tight xl:text-[2.75rem]">
                        {content.hero.headlineLines.map((line) => (
                            <span class="block text-balance">{line}</span>
                        ))}
                    </h1>
                    <p class="mt-4 max-w-lg text-base leading-relaxed text-muted">
                        {content.hero.subhead}
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                        <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the source</a>
                    </div>

                    <ul class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-subtle">
                        {
                            content.hero.chips.map((chip) => (
                                <li class="flex items-center gap-1.5">
                                    <span class="h-1 w-1 rounded-full bg-primary-500" />
                                    {chip}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- The claim, proven immediately: the real fleet board. The frame crops the full-width
                     screenshot to its Attention + Active lanes so agent cards stay legible beside the copy;
                     the third lane bleeds past the right edge, and section 2 shows the whole board. -->
                <!-- Capped until the hero splits into two columns: the crop scales with the frame, so a
                     full-width frame on a tablet would blow the screenshot up to twice its intended size. -->
                <figure class="animate-fade-in-up m-0 w-full max-w-[34rem] lg:mx-0 lg:max-w-none" style="animation-delay: 60ms">
                    <div class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                        <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{content.hero.shot.frameLabel}</span>
                        </div>
                        <!-- Crop window. The width percentages pick how much of the 1072px-wide surface shows:
                             262% ≈ rail + the Attention lane (phones), 168% ≈ through the Active lane (from sm up).
                             Each aspect ratio is the matching slice of the source, so the image fills the box.

                             The press over it is a plain link to the demo's own page, the same on every screen and
                             the same as every other "open the workspace" call on the site. An IDE needs a viewport:
                             not this box (half a hero column) and not an overlay with a marketing chrome bar over
                             it. The image stays the LCP, undimmed until hover, and the page still ships no part of
                             the app. -->
                        <div class="relative aspect-[5/7] overflow-hidden sm:aspect-6/5">
                            <Image
                                src={heroImage}
                                alt={content.hero.shot.alt}
                                widths={SHOT_WIDTHS}
                                sizes={heroSizes}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="w-[262%] max-w-none sm:w-[168%]"
                            />
                            <a
                                href={DEMO_PATH}
                                class="group absolute inset-0 flex items-center justify-center bg-canvas/10 transition hover:bg-canvas/35 focus-visible:bg-canvas/35 focus-visible:outline-none"
                            >
                                <span
                                    class="flex items-center gap-2.5 rounded-full border border-line bg-canvas/85 px-5 py-2.5 text-sm font-medium shadow-xl shadow-black/40 backdrop-blur transition group-hover:border-primary-500 group-hover:text-primary-500"
                                >
                                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5"><path d="M8 5v14l11-7z" /></svg>
                                    {content.hero.demo.playLabel}
                                </span>
                            </a>
                        </div>
                    </div>
                    <figcaption class="mt-3 text-2xs leading-relaxed text-subtle/80">{content.hero.demo.note}</figcaption>
                </figure>
            </div>
        </section>

        <!-- 2 · The loop: assign several, each isolated, nothing lands unread.
             This is the section that earns the headline's second half: the window is the board you watch,
             the agent you answer, and the diff you read. Beat 02 carries the sandbox FIGURE rather than a
             screenshot because a container is not a surface: there is no honest screen of "its tools are
             really installed", and a mockup of one would be the first lie on the page. -->
        <section class="border-t border-line" id="loop">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.loop.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance">{content.loop.heading}</h2>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{content.loop.sub}</p>

                <div class="mt-14 space-y-14 lg:mt-16 lg:space-y-20">
                    {
                        content.loop.beats.map((beat, i) => {
                            /* Layout follows the shot, the way the product pages do it: a wide capture is 1072 CSS px
                               of real interface and takes the whole column, because halving it renders the app's own
                               text at a third size. It also keeps beat 01 from reading as the hero's screenshot
                               printed twice — the hero shows a cropped corner of the board, this shows all of it.
                               The threshold is 3:2 rather than merely landscape: the review capture is 2144×1800, a
                               tall panel that happens to be a hair wider than high, and given the whole column it is
                               mostly the empty canvas under its own diff. That one keeps the cropped side-by-side. */
                            const shot = beat.shot === undefined ? undefined : { ...beat.shot, image: shotAsset(beat.shot.name) };
                            const wideShot = shot !== undefined && shot.frame === "browser" && shot.image.width >= shot.image.height * 1.5 ? shot : undefined;
                            const words = (
                                <>
                                    <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                        {beat.step}
                                    </div>
                                    <h3 class="mt-3 text-xl font-semibold tracking-tight text-balance text-content">{beat.title}</h3>
                                    <p class="mt-3 text-base leading-relaxed text-muted">{beat.body}</p>
                                </>
                            );

                            if (wideShot !== undefined) {
                                return (
                                    <div>
                                        <div class="max-w-2xl">{words}</div>
                                        <figure class="m-0 mt-8 overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                                            <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">
                                                    {wideShot.frameLabel}
                                                </span>
                                            </div>
                                            <Image
                                                src={wideShot.image}
                                                alt={wideShot.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes={COLUMN_SIZES}
                                                loading="lazy"
                                                decoding="async"
                                                class="w-full"
                                            />
                                        </figure>
                                    </div>
                                );
                            }

                            return (
                                <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
                                    <div class={i % 2 === 1 ? "lg:order-2" : ""}>{words}</div>

                                    <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                                        {/* The continuity beat's proof is the same board on a different device, so its
                                            shot gets the phone shell (the product pages' frame, `ProductShotFigure`):
                                            a 430px-wide capture in the browser chrome reads as a cropped desktop. */}
                                        {shot && shot.frame === "phone" && (
                                            <figure class="m-0 mx-auto w-full max-w-[20rem] overflow-hidden rounded-[2rem] border border-line-strong bg-card p-2 shadow-2xl shadow-black/50">
                                                <Image
                                                    src={shot.image}
                                                    alt={shot.alt}
                                                    widths={SHOT_WIDTHS}
                                                    sizes="(min-width: 22rem) 304px, calc(100vw - 4rem)"
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="w-full rounded-[1.5rem]"
                                                />
                                            </figure>
                                        )}
                                        {shot && shot.frame === "browser" && (
                                            <figure class="m-0 overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                                                <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">
                                                        {shot.frameLabel}
                                                    </span>
                                                </div>
                                                {/* A crop window, not a fit: a portrait capture scaled into half a column is
                                                    the app at a third size — a shape you can see, not a screen you can read.
                                                    So the shot is oversized and the window shows its top-left, where this
                                                    surface puts the thing the beat claims. Pinned rather than left in flow:
                                                    a block box with an aspect-ratio and `overflow-hidden` centres a child
                                                    taller than itself, which scrolled the review past its own diff. */}
                                                <div class="relative aspect-16/10 overflow-hidden">
                                                    <Image
                                                        src={shot.image}
                                                        alt={shot.alt}
                                                        widths={SHOT_WIDTHS}
                                                        sizes={cropBeatSizes}
                                                        loading="lazy"
                                                        decoding="async"
                                                        class="absolute top-0 left-0 w-[145%] max-w-none"
                                                    />
                                                </div>
                                            </figure>
                                        )}

                                        {beat.figure === "sandbox" && (
                                            <figure class="m-0 rounded-2xl border border-dashed border-line-strong p-4 sm:p-6">
                                                <div class="eyebrow mb-4 flex items-center gap-2">
                                                    <span class="text-subtle">
                                                        <Fragment set:html={monitorGlyph} />
                                                    </span>
                                                    {content.loop.sandbox.boundary}
                                                </div>

                                                <div class="card border-primary-600/30 bg-primary-600/[0.03] p-5 shadow-xl shadow-black/30">
                                                    <div class="flex items-center gap-3 border-b border-line pb-4">
                                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-600/15 text-link">
                                                            <Fragment set:html={cubeGlyph} />
                                                        </span>
                                                        <div class="min-w-0">
                                                            <div class="font-mono text-sm text-content">{content.loop.sandbox.agent.name}</div>
                                                            <div class="text-2xs text-subtle">{content.loop.sandbox.agent.role}</div>
                                                        </div>
                                                        <span class="chip ml-auto bg-success/10 text-success">
                                                            <span class="h-1.5 w-1.5 rounded-full bg-success" />
                                                            running
                                                        </span>
                                                    </div>

                                                    <div class="mt-4 space-y-4">
                                                        {content.loop.sandbox.layers.map((layer) => (
                                                            <div class="flex flex-col gap-1.5">
                                                                <div class="eyebrow">{layer.label}</div>
                                                                <div class="flex flex-wrap gap-1.5">
                                                                    {layer.items.map((item) => (
                                                                        <span class="rounded-md border border-line bg-overlay/50 px-2 py-0.5 font-mono text-2xs text-muted">
                                                                            {item}
                                                                        </span>
                                                                    ))}
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </figure>
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                <a href="/product/" class="mt-14 inline-block text-sm font-medium text-link hover:underline">{content.loop.cta} →</a>
            </div>
        </section>

        <!-- 3 · Ownership: the ledger.
             What used to be here was a three-box flow with three paragraphs under it, and it asked the
             reader to assemble the claim themselves: the boxes implied a pipeline the platform is not on,
             and the prose then explained that it is not on it. The claim is a COMPARISON, so this is one.
             Two columns, nouns only, and the asymmetry between the lists carries the whole argument: one
             side holds everything that matters, the other holds an email address and a URL. -->
        <section class="border-t border-line" id="ownership">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.ownership.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight text-balance">{content.ownership.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.ownership.sub}</p>

                <!-- `items-start`, not stretch: each card ends where its own list ends, and the platform's
                     card being visibly the shorter of the two is the argument made in silhouette. -->
                <div class="mt-12 grid items-start gap-5 lg:grid-cols-2">
                    <!-- The heavy side: solid card, brand-tinted, a filled dot per line. -->
                    <div class="card border-primary-600/30 bg-primary-600/[0.03] p-6 sm:p-7">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h3 class="text-base font-semibold tracking-tight text-content">{content.ownership.ledger.yours.label}</h3>
                            <span class="text-xs text-subtle">{content.ownership.ledger.yours.note}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.ownership.ledger.yours.items.map((item) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-content">
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-500" />
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <!-- The light side: dashed, unfilled, and shorter than its neighbour, so the two read
                         as different weights before a single word of either is read. -->
                    <div class="rounded-2xl border border-dashed border-line-strong p-6 sm:p-7">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h3 class="text-base font-semibold tracking-tight text-muted">{content.ownership.ledger.platform.label}</h3>
                            <span class="text-xs text-subtle">{content.ownership.ledger.platform.note}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.ownership.ledger.platform.holds.map((item) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full border border-line-strong" />
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                        <p class="mt-5 flex items-start gap-3 border-t border-line pt-5 text-sm leading-relaxed text-subtle">
                            <span class="mt-0.5 shrink-0 text-subtle/70">
                                <Fragment set:html={crossIcon} />
                            </span>
                            {content.ownership.ledger.platform.never}
                        </p>
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
                    <p class="max-w-xl text-xs leading-relaxed text-subtle">{content.ownership.ledger.footnote}</p>
                    <a href="/product/delegate/" class="text-sm font-medium text-link hover:underline">How ownership works in the product →</a>
                </div>
            </div>
        </section>

        <!-- 4 · Economics: your subscriptions, your hardware, nothing to pay us -->
        <section class="border-t border-line" id="economics">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.economics.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance">{content.economics.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.economics.sub}</p>

                <div class="mt-12 grid items-start gap-6 lg:grid-cols-2">
                    <div class="card overflow-hidden">
                        <div class="border-b border-line px-5 py-3">
                            <span class="eyebrow">Your agent accounts</span>
                        </div>
                        <ul class="divide-y divide-line">
                            {
                                content.economics.accounts.map((account) => (
                                    <li class="flex items-center gap-3 px-5 py-4">
                                        <span class="h-2 w-2 shrink-0 rounded-full bg-success" />
                                        <div class="flex flex-1 flex-wrap items-baseline justify-between gap-x-3">
                                            <h3 class="text-sm font-medium text-content">{account.name}</h3>
                                            <span class="text-2xs text-subtle">{account.detail}</span>
                                        </div>
                                        <span class="chip bg-success/10 text-success">subscription</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="card p-5">
                        <div class="eyebrow">Flat, not metered</div>
                        <ul class="mt-4 space-y-3">
                            {
                                content.economics.points.map((point) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                                        <span class="mt-0.5 shrink-0 text-link">
                                            <Fragment set:html={checkIcon} />
                                        </span>
                                        {point}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5 · Extend it: a bento of the six superpowers.
             Everything here used to be a section of its own, and together they were what made a visitor
             lose track of what the product is. As a bento they read as one shelf of options rather than
             six more arguments: a glance takes the whole band, and each tile hands the reader to the
             page that owns it. -->
        <section class="border-t border-line" id="extend">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.extend.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance">{content.extend.heading}</h2>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{content.extend.sub}</p>

                <!-- The bento: tile 0 takes a 2×2 cell, so the auto-flow fills the remaining column with
                     tiles 1–2 and the bottom row with 3–5: six tiles, nine cells, no holes. On md the
                     lead tile spans the full width and the last one closes the odd row; below that it is
                     an ordinary stack, because a bento at 375px is just a column with extra rules. -->
                <div class="mt-10 grid gap-4 md:grid-cols-2 lg:auto-rows-fr lg:grid-cols-3">
                    {
                        content.extend.tiles.map((tile, i) => (
                            <a
                                href={tile.href}
                                class:list={[
                                    "card group flex flex-col p-6 transition-colors hover:border-line-strong hover:bg-overlay/30",
                                    i === 0 && "md:col-span-2 lg:row-span-2 lg:bg-primary-600/[0.03]",
                                    i === 5 && "md:col-span-2 lg:col-span-1",
                                ]}
                            >
                                <span class:list={["text-subtle transition-colors group-hover:text-link", i === 0 && "text-link"]}>
                                    <Fragment set:html={extendIcons[i] ?? ""} />
                                </span>
                                <h3
                                    class:list={[
                                        "mt-4 flex items-center gap-2 font-semibold tracking-tight text-content",
                                        i === 0 ? "text-lg" : "text-[0.9375rem]",
                                    ]}
                                >
                                    {tile.name}
                                    <span class="text-subtle opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
                                        →
                                    </span>
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-muted">{tile.body}</p>
                                {/* Only the lead tile carries these: a 2×2 cell has to earn its size with
                                    something real, and the trigger list is the thing that reads at a glance.
                                    Two columns of three rather than one wrapped row of chips — the taller
                                    block is what fills the cell, and it borrows the dotted list from the
                                    ownership ledger so the page has one way of writing a list of nouns. */}
                                {tile.triggers && (
                                    <div class="mt-auto pt-8">
                                        <div class="eyebrow">{tile.triggers.label}</div>
                                        <ul class="mt-3 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
                                            {tile.triggers.items.map((trigger) => (
                                                <li class="flex items-center gap-2.5 text-sm text-muted">
                                                    <span class="h-1 w-1 shrink-0 rounded-full bg-primary-500" />
                                                    {trigger}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}
                            </a>
                        ))
                    }
                </div>

                <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
                    <p class="max-w-xl text-xs leading-relaxed text-subtle">{content.extend.note}</p>
                    <a href="/extensions/" class="text-sm font-medium text-link hover:underline">{content.extend.cta} →</a>
                </div>
            </div>
        </section>

        <!-- 6 · About the creator: the last objection before the command.
             The page has just asked a visitor to run a container on their own machine and hand it a
             GitHub token and a database password. `#ownership` answers the architectural half of "can I
             trust this"; this answers the human half, which until now existed only in the page's JSON-LD
             told to Google and never to the reader.
             Verifiability, not popularity: no logos, no testimonials, no counter that could render a
             zero. The name, bio and cards come from about.ts so this band and /about/ cannot drift. -->
        <section class="border-t border-line" id="trust">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
                    <div>
                        <div class="eyebrow">{content.trust.eyebrow}</div>
                        <h2 class="mt-3 text-3xl font-semibold tracking-tight">{CREATOR_NAME}</h2>
                        <p class="mt-3 text-base leading-relaxed text-muted">{creatorRole}</p>
                        <p class="mt-3 text-sm leading-relaxed text-subtle">{creatorBio}</p>
                        <CreatorLinks class="mt-6" />
                        <a href="/about/" class="mt-6 inline-block text-sm font-medium text-link hover:underline">{content.trust.cta} →</a>
                    </div>

                    <TrustCards />
                </div>
            </div>
        </section>

        <!-- 7 · Get connected: ghost-numeral steps, no boxes -->
        <section class="border-t border-line" id="connect">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.connect.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight text-balance">{content.connect.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.connect.sub}</p>

                <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
                    {
                        content.connect.steps.map((step, i) => (
                            <div>
                                <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                    0{i + 1}
                                </div>
                                <h3 class="mt-3 text-sm font-medium text-content">{step.title}</h3>
                                <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="code-window mt-10">
                    <div class="flex items-center justify-between border-b border-line px-4 py-2">
                        <span class="eyebrow">Step 3 · your machine</span>
                    </div>
                    <pre class="px-4 py-3 text-content"><code><span class="text-subtle">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                </div>
                <p class="mt-3 text-xs text-subtle">{content.connect.commandNote}</p>
            </div>
        </section>

        <!-- 8 · FAQ: collapsed disclosures in topic bands.
             Open, thirteen answers were the longest thing on the page by a wide margin and a visitor had
             to scroll past twelve of them to reach their own question. Collapsed, the whole FAQ is a list
             of headlines you skim in one screen.

             Native <details>, so this costs no JavaScript and keeps keyboard and screen-reader behaviour
             for free. `name` groups each band into an exclusive accordion: opening one closes its
             sibling, so the section never grows back into the wall it replaced. The answers are still in
             the HTML, so the FAQPage schema above and in-page find both still see them. -->
        <section class="border-t border-line" id="faq">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">FAQ</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight text-balance">Questions, answered plainly.</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">Including the honest ones: what's free, what's stored where, what isn't ready yet.</p>

                <div class="mt-10 max-w-3xl space-y-10">
                    {
                        faqGroups.map((group) => (
                            <div id={group.id} class="scroll-mt-24">
                                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <h3 class="text-sm font-semibold tracking-tight text-content">{group.label}</h3>
                                    <p class="text-xs text-subtle">{group.blurb}</p>
                                </div>

                                <div class="mt-3 border-b border-line">
                                    {group.items.map((item) => (
                                        <details id={item.id} name={group.id} class="faq-item scroll-mt-24 border-t border-line">
                                            <summary class="flex cursor-pointer list-none items-start gap-4 py-4 text-[0.9375rem] leading-snug font-medium text-content transition-colors hover:text-link">
                                                {item.question}
                                                {/* Rotates to a minus when open; drawn rather than a marker so it
                                                    matches the 1.5-stroke motif the rest of the page uses. */}
                                                <span class="faq-marker mt-0.5 ml-auto shrink-0 text-subtle transition-transform duration-200">
                                                    <Fragment set:html={plusIcon} />
                                                </span>
                                            </summary>
                                            <div class="pb-5">
                                                {item.answer.map((paragraph) => (
                                                    <p class="mt-0 mb-2.5 text-sm leading-relaxed text-muted last:mb-0">{paragraph}</p>
                                                ))}
                                                {item.more && (
                                                    <a href={item.more.href} class="mt-3 inline-block text-sm font-medium text-link hover:underline">
                                                        {item.more.label} →
                                                    </a>
                                                )}
                                            </div>
                                        </details>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="mt-10 flex max-w-3xl flex-wrap items-center justify-between gap-4 rounded-2xl border border-line bg-card/40 px-5 py-4">
                    <p class="text-sm text-muted">Still unanswered? Issues are public and get a real reply.</p>
                    <a href={githubIssuesUrl} target="_blank" rel="noopener" class="text-sm font-medium text-link hover:underline">Open an issue →</a>
                </div>
            </div>
        </section>

        <!-- 9 · Final CTA -->
        <section class="relative overflow-hidden border-t border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="fade-in relative mx-auto max-w-7xl px-6 py-20 text-center lg:py-28">
                <div class="eyebrow">Ready</div>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{content.finalCta.heading}</h2>
                <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted">{content.finalCta.sub}</p>
                <div class="mt-8 flex justify-center gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                    <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the engine</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <script>
        // Fade-in observer
        const targets = document.querySelectorAll(".fade-in");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.12 },
            );
            targets.forEach((el) => observer.observe(el));
        } else {
            targets.forEach((el) => el.classList.add("visible"));
        }

        // Scroll-based depth parallax for hero orbs
        const hero = document.getElementById("hero");
        const orbsLayer = document.querySelector(".hero-orbs");
        const gridOverlay = document.querySelector(".grid-overlay");

        if (hero && orbsLayer) {
            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            const y = window.scrollY;
                            const limit = hero.offsetHeight;
                            if (y < limit) {
                                (orbsLayer as HTMLElement).style.transform = `translateY(${y * 0.3}px) scale(${1 + y * 0.0003})`;
                                if (gridOverlay) {
                                    (gridOverlay as HTMLElement).style.transform = `translateY(${y * 0.15}px)`;
                                }
                            }
                            ticking = false;
                        });
                        ticking = true;
                    }
                },
                { passive: true },
            );
        }
    </script>
</BaseLayout>
