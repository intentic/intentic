---
/* Product chat figure. */

export interface ChatOffer {
    // Offer fields are relayed from the platform without local modeling.
    // Offer fields render in header, body, and button order.
    title: string;
    description: string;
    byline: string;
    why?: string;
    request?: string;
    meta: string;
    run: string;
    skip: string;
}

export type ChatEntry =
    | { role: "user"; text: string }
    | { role: "agent"; text: string }
    | { role: "tool"; name: string; target: string; summary?: string }
    | { role: "offer"; offer: ChatOffer };

interface Props {
    // Title identifies the conversation tab and can be renamed in place.
    title: string;
    // Day marks the first turn sent on a date.
    day?: string;
    thread: ChatEntry[];
    // Input renders the composer; omitted input ends the transcript.
    input?: string;
    ariaLabel?: string;
    class?: string;
}

const { title, day, thread, input, ariaLabel, class: klass = "" } = Astro.props;

const icon = (paths: string, width = 1.5) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

// Inline glyphs replace the site's absent icon runtime.
const chevronDown = icon('<path d="m6 9 6 6 6-6"/>');
const chevronRight = icon('<path d="m9 6 6 6-6 6"/>');
const plusGlyph = icon('<path d="M12 5v14M5 12h14"/>');
const historyGlyph = icon('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 4v4h4"/><path d="M12 8v4l3 2"/>');
const popoutGlyph = icon('<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>');
const searchGlyph = icon('<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>');
const starGlyph = icon('<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z"/>');
const checkGlyph = icon('<path d="M20 6 9 17l-5-5"/>', 2);
const timesGlyph = icon('<path d="M18 6 6 18M6 6l12 12"/>', 2);
const sparkGlyph = icon('<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>');
const atGlyph = icon('<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>');
const branchGlyph = icon('<circle cx="7" cy="6" r="2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="12" r="2"/><path d="M7 8v8M7 12h8"/>');
const micGlyph = icon('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>');
const stopGlyph = icon('<circle cx="12" cy="12" r="9"/><rect x="9" y="9" width="6" height="6" rx="1"/>');
const sendGlyph = icon('<path d="M4.5 12 20 4.5 15 20l-3.5-5.5z"/><path d="m11.5 14.5 8.5-10"/>');
---

<div class={`card overflow-hidden shadow-xl shadow-black/30 ${klass}`} role="log" aria-label={ariaLabel}>
    {/* Chat chrome stays above transcript content. */}
    <header class="flex items-center gap-1 border-b border-line px-1.5 py-1.5">
        <span class="flex h-7 min-w-0 flex-1 items-center gap-1.5 px-2 text-2xs">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-success"></span>
            <span class="min-w-0 truncate text-content">{title}</span>
            <span class="shrink-0 text-subtle [&>svg]:h-3 [&>svg]:w-3" set:html={chevronDown} />
        </span>
        <span class="flex shrink-0 items-center gap-1 pr-1 text-subtle [&>span]:flex [&>span]:h-6 [&>span]:w-6 [&>span]:items-center [&>span]:justify-center [&_svg]:h-3.5 [&_svg]:w-3.5">
            <span set:html={plusGlyph} />
            <span set:html={historyGlyph} />
            <span set:html={popoutGlyph} />
        </span>
    </header>

    {/* Transcript rows use compact spacing around each answer. */}
    <div class="flex flex-col gap-1 px-4 pt-4 pb-2">
        {day && <div class="flex justify-center pb-0.5 text-2xs text-subtle">{day}</div>}

        {
            thread.map((entry) => {
                if (entry.role === "user") {
                    /* Prompts are right-aligned and capped at 85% of the column. */
                    return (
                        <div class="flex flex-col items-end pt-3 pb-2">
                            <div class="chat-surface max-w-[85%] px-3 py-2 text-xs leading-relaxed text-content">{entry.text}</div>
                        </div>
                    );
                }

                if (entry.role === "tool") {
                    /* Tool calls render as one metadata row. */
                    return (
                        <div class="flex min-w-0 items-center gap-1.5 text-2xs text-muted">
                            <span class="shrink-0 [&>svg]:h-3 [&>svg]:w-3" set:html={chevronRight} />
                            <span class="shrink-0 text-link [&>svg]:h-3 [&>svg]:w-3" set:html={searchGlyph} />
                            <span class="shrink-0 font-medium">{entry.name}</span>
                            <span class="min-w-0 truncate font-mono">{entry.target}</span>
                            {entry.summary && <span class="ml-auto shrink-0 tabular-nums text-subtle">{entry.summary}</span>}
                        </div>
                    );
                }

                if (entry.role === "agent") {
                    // Agent answers span the column at body text weight.
                    return <div class="chat-surface-assistant w-full px-3.5 py-2.5 text-xs leading-relaxed text-content">{entry.text}</div>;
                }

                /* Spend offers render as one transcript card. */
                const { offer } = entry;
                return (
                    <div class="chat-surface w-full overflow-hidden">
                        <div class="flex items-center gap-2 border-b border-line px-3.5 py-2">
                            <span class="shrink-0 text-primary-500 [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={starGlyph} />
                            <span class="min-w-0 flex-1 truncate text-sm font-medium text-content">{offer.title}</span>
                        </div>

                        <div class="flex flex-col gap-1 px-3.5 py-3">
                            <span class="text-xs leading-relaxed text-content/85">{offer.description}</span>
                            <span class="font-mono text-2xs text-subtle">{offer.byline}</span>
                            {offer.why && <span class="text-2xs leading-snug text-subtle">The agent's case: {offer.why}</span>}
                            {offer.request && <span class="truncate font-mono text-2xs text-subtle">Request: {offer.request}</span>}
                            {/* Price and balance share one required mono line. */}
                            <span class="pt-1 font-mono text-xs text-content">{offer.meta}</span>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 border-t border-line px-3.5 py-2.5">
                            <span class="chat-decision chat-decision-primary">
                                <span class="[&>svg]:h-3.5 [&>svg]:w-3.5" set:html={checkGlyph} />
                                {offer.run}
                            </span>
                            <span class="chat-decision chat-decision-secondary">
                                <span class="[&>svg]:h-3.5 [&>svg]:w-3.5" set:html={timesGlyph} />
                                {offer.skip}
                            </span>
                        </div>
                    </div>
                );
            })
        }
    </div>

    {
        input && (
            /* The composer renders only when input is provided. */
            <div class="px-3 pt-1 pb-3">
                <div class="flex flex-col border border-line-strong bg-overlay shadow-lg">
                    <div class="px-4 py-3 text-xs leading-relaxed text-subtle">{input}</div>
                    <div class="flex items-center gap-1 px-2.5 pb-2.5 text-subtle">
                        <span class="flex h-7 items-center gap-1.5 px-2 text-2xs font-medium text-muted">
                            <span class="text-link [&>svg]:h-3 [&>svg]:w-3" set:html={sparkGlyph} />
                            Claude Opus 5
                            <span class="[&>svg]:h-3 [&>svg]:w-3" set:html={chevronDown} />
                        </span>
                        {/* The effort meter has four bars for the next turn. */}
                        <span class="flex h-7 items-center gap-0.5 px-1.5">
                            {[0, 1, 2, 3].map((i) => (
                                <span class={`h-3 w-1 rounded-xs ${i < 3 ? "bg-primary-500" : "bg-content/10"}`} />
                            ))}
                        </span>
                        <span class="flex h-7 w-7 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={atGlyph} />
                        <span class="flex h-7 w-7 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={branchGlyph} />
                        <span class="flex h-7 w-7 items-center justify-center [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={micGlyph} />
                        {/* Live turns keep Stop available while Send requires input. */}
                        <span class="composer-send composer-stop ml-auto [&>svg]:h-4 [&>svg]:w-4" set:html={stopGlyph} />
                        <span class="composer-send composer-send-off [&>svg]:h-4 [&>svg]:w-4" set:html={sendGlyph} />
                    </div>
                </div>
            </div>
        )
    }
</div>
