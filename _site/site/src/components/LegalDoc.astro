---
import type { LegalDoc } from "@intentic/site-content/legal";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
    doc: LegalDoc;
    eyebrow: string;
}

const { doc, eyebrow } = Astro.props;

/* A document with a table gets a wider column. */
const measure = doc.sections.some((section) => section.table !== undefined) ? "max-w-4xl" : "max-w-2xl";
---

<BaseLayout>
    <Nav />
    <main class="flex-1">
        <section class:list={["below-bar mx-auto px-6 pb-24", measure]}>
            <div class="eyebrow">{eyebrow}</div>
            <h1 class="display mt-3 text-3xl font-semibold sm:text-4xl">{doc.title}</h1>
            <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">{doc.intro}</p>

            <div class="mt-10 flex flex-col gap-8">
                {
                    doc.sections.map((section) => (
                        <section>
                            <h2 class="text-lg font-semibold text-content">{section.heading}</h2>
                            {section.paragraphs.map((paragraph) => (
                                <p class="mt-3 max-w-longform text-sm leading-7 text-muted">{paragraph}</p>
                            ))}
                            {section.list && (
                                <ul class="mt-3 list-disc space-y-2 pl-5">
                                    {section.list.map((item) => (
                                        <li class="max-w-longform text-sm leading-7 text-muted">{item}</li>
                                    ))}
                                </ul>
                            )}
                            {/* Allow wide legal tables to scroll instead of becoming unreadable. */}
                            {section.table && (
                                <div class="mt-4 overflow-x-auto">
                                    <table class="w-full min-w-lg border-collapse text-left text-sm">
                                        <thead>
                                            <tr class="border-b border-line">
                                                {section.table.columns.map((column) => (
                                                    <th class="py-2 pr-4 font-medium text-content">{column}</th>
                                                ))}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {section.table.rows.map((row) => (
                                                <tr class="border-b border-line/60 align-top">
                                                    {row.map((cell) => (
                                                        <td class="py-3 pr-4 leading-6 text-muted">{cell}</td>
                                                    ))}
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </section>
                    ))
                }
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
