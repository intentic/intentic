---
/* A MARK ON A LINE OF TEXT. */
import Lotus from "./Lotus.astro";
import Lozenge from "./Lozenge.astro";

interface Props {
    /** Which house ornament to draw when no mark is passed as children. */
    mark?: "lotus" | "lozenge";
    /** The lotus's size, for the handful of places that mark a heading rather than a list row. */
    size?: "sm" | "md" | "lg";
    /** Classes for the DRAWING: colour, opacity, a transition. Never position — see above. */
    markClass?: string;
}

const { mark = "lotus", size = "sm", markClass = "" } = Astro.props;
const own = !Astro.slots.has("default");
---

<span class="mark">
    {own && mark === "lotus" && <Lotus size={size} class={markClass} />}
    {own && mark === "lozenge" && <Lozenge class={markClass} />}
    <slot />
</span>
