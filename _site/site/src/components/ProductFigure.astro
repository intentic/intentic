---
import type { ProductFigure } from "@intentic-dev/site-content/product";
import DiscordThread from "./DiscordThread.astro";

/* The diagrams a screenshot can't carry: what isolation, sharing, wiring and the platform boundary actually
 * mean. They are markup rather than images so they read at any width and stay in the site's palette, and
 * because a page that would otherwise need a mockup gets a drawing that claims nothing about a screen. */

interface Props {
    figure: ProductFigure;
}

const { figure } = Astro.props;

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

const cubeGlyph = icon('<path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"/><path d="m3.5 7 8.5 4.5L20.5 7M12 11.5v10"/>');
const botGlyph = icon('<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>');
const userGlyph = icon('<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>');
const lockGlyph = icon('<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>');
const branchGlyph = icon('<circle cx="7" cy="5" r="2"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="12" r="2"/><path d="M7 7v10M7 12h8"/>');
const boltGlyph = icon('<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>');

const triggers = [
    { name: "Push", detail: "GitHub · GitLab" },
    { name: "Alert", detail: "Sentry" },
    { name: "Payment", detail: "Stripe" },
    { name: "Email", detail: "IMAP" },
    { name: "Message", detail: "Discord" },
    { name: "Schedule", detail: "cron" },
];

const surfaces = [
    { surface: "Search", you: "the workspace search box", agent: "`iq` from Bash" },
    { surface: "Terminal", you: "a docked terminal tab", agent: "shell commands" },
    { surface: "Files", you: "the tree and the editor", agent: "Read and Edit" },
    { surface: "Network", you: "the VPN panel", agent: "/usr/local/bin/vpn" },
];

const boundary = {
    local: ["Your code and repos", "Every credential and token", "The agent's transcripts", "The container and its image"],
    platform: ["Your identity (Google sign-in)", "The sandbox's name and URL", "Billing state", "Grants to invited teammates"],
};

// The one layer everyone lets you change, against the ones this product opens. It lived on the landing
// page as a band of its own; the landing now makes a single claim and this argument belongs to the page
// about the sandbox, which is the thing all four rows are describing.
const layers = {
    prompt: [
        "Can describe tools, but cannot install them.",
        "Cannot access your code, data or services.",
        "Starts from the same blank context every run.",
        "Produces output you must apply yourself.",
    ],
    environment: [
        "Development tools and libraries are installed.",
        "Connects to your repositories, databases and services.",
        "Loads the context you chose on every run.",
        "Does the work and shows every file change as a diff.",
    ],
};

const people = [
    { name: "You", role: "Owner", access: "installs tools · connects systems · full control", owner: true },
    { name: "Sam", role: "Teammate", access: "chats, works & reviews · opens sandbox apps" },
    { name: "Ada", role: "Teammate", access: "chats, works & reviews · opens sandbox apps" },
];

const thread = [
    { author: "Dana", time: "9:41", text: "@storefront ship 2.4 once CI is green, and drop the changelog in #announcements 🙏" },
    {
        author: "storefront",
        app: true,
        time: "9:41",
        text: "On it. Watching the pipeline. I'll tag the release, draft the changelog from the merged PRs, and post it the second it's green.",
    },
    {
        author: "storefront",
        app: true,
        time: "9:58",
        text: "✓ Tagged v2.4.0 · changelog posted in #announcements · deploy is live. 3 PRs shipped, no failures.",
    },
    { author: "Dana", time: "9:59", text: "🎉 thanks!" },
];

const checkGlyph = icon('<path d="M20 6 9 17l-5-5"/>');
const minusGlyph = icon('<path d="M6 12h12"/>');
const chevronDownGlyph = icon('<path d="m6 9 6 6 6-6"/>');
---

{
    figure === "worktrees" && (
        <div class="card p-6">
            <div class="eyebrow">One base commit, one branch each</div>
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
                {["agent/checkout-stripe", "agent/soft-deletes", "agent/latency-p99"].map((branch) => (
                    <div class="border border-line bg-overlay/40 p-4">
                        <span class="flex items-center gap-2 text-link">
                            <Fragment set:html={branchGlyph} />
                            <span class="font-mono text-2xs text-muted">{branch}</span>
                        </span>
                        <p class="mt-2 text-xs leading-relaxed text-subtle">its own worktree, its own checkout</p>
                    </div>
                ))}
            </div>
            <div class="my-4 flex items-center gap-2 text-2xs text-subtle">
                <span aria-hidden="true">↓</span>accept one at a time, after you have read the diff
                <span class="h-px flex-1 bg-line" />
            </div>
            <div class="border border-primary-600/30 bg-primary-600/[0.05] p-4 text-center">
                <div class="eyebrow text-link">Your checkout</div>
                <p class="mt-1 text-xs text-muted">Untouched until you accept the work, and still yours to change or revert afterwards</p>
            </div>
        </div>
    )
}

{
    figure === "shared-surfaces" && (
        <div class="card overflow-hidden">
            <div class="grid grid-cols-[1fr_1fr_1fr] gap-px bg-line text-xs">
                <div class="bg-card px-4 py-3 text-2xs font-semibold tracking-wider text-subtle uppercase">Surface</div>
                <div class="flex items-center gap-2 bg-card px-4 py-3 text-2xs font-semibold tracking-wider text-subtle uppercase">
                    <span class="text-link [&>svg]:h-3.5 [&>svg]:w-3.5">
                        <Fragment set:html={userGlyph} />
                    </span>
                    You
                </div>
                <div class="flex items-center gap-2 bg-card px-4 py-3 text-2xs font-semibold tracking-wider text-subtle uppercase">
                    <span class="text-link [&>svg]:h-3.5 [&>svg]:w-3.5">
                        <Fragment set:html={botGlyph} />
                    </span>
                    The agent
                </div>
                {surfaces.map((row) => (
                    <>
                        <div class="bg-card px-4 py-3 font-medium text-content">{row.surface}</div>
                        <div class="bg-card px-4 py-3 text-muted">{row.you}</div>
                        <div class="bg-card px-4 py-3 font-mono text-2xs text-muted">{row.agent}</div>
                    </>
                ))}
            </div>
            <p class="max-w-copy border-t border-line px-4 py-3 text-xs text-subtle">
                You and the agent use the same search, terminal, files and network connection, so both always see the current state.
            </p>
        </div>
    )
}

{
    figure === "triggers" && (
        <div class="card p-6">
            <div class="grid items-center gap-6 sm:grid-cols-[1fr_auto_1fr]">
                <div class="grid grid-cols-2 gap-2">
                    {triggers.map((trigger) => (
                        <div class="border border-line bg-overlay/40 px-3 py-2">
                            <div class="text-xs font-medium text-content">{trigger.name}</div>
                            <div class="text-2xs text-subtle">{trigger.detail}</div>
                        </div>
                    ))}
                </div>
                <div class="flex items-center justify-center gap-2 text-2xs text-link sm:flex-col">
                    <Fragment set:html={boltGlyph} />
                    <span class="whitespace-nowrap">Optional check, then run</span>
                </div>
                <div class="border border-primary-600/30 bg-primary-600/[0.05] p-4">
                    <span class="flex items-center gap-2 text-link">
                        <Fragment set:html={cubeGlyph} />
                        <span class="text-sm font-medium text-content">A fresh agent session</span>
                    </span>
                    <p class="mt-2 text-xs leading-relaxed text-muted">
                        Its own session, reviewed before you accept its changes.
                    </p>
                </div>
            </div>
        </div>
    )
}

{
    figure === "ownership" && (
        /* Stacked, not a row: this figure lives in half a page column, and four boxes side by side there
           would wrap every label onto its own line. */
        <div class="flex flex-col gap-3">
            <div class="card p-5">
                <div class="eyebrow">Your browser</div>
                <p class="mt-1.5 text-sm text-muted">Chat, files, editor, terminal</p>
            </div>
            <div class="flex items-center gap-2 px-1 text-xs font-medium text-link">
                <span aria-hidden="true">↓</span>your browser connects directly through a private tunnel
                <span class="h-px flex-1 bg-line" />
            </div>
            <div class="card border-primary-600/30 bg-primary-600/[0.03] p-5">
                <div class="eyebrow text-link">Your machine</div>
                <p class="mt-1.5 text-sm text-muted">Sandboxes, repos, credentials, capabilities</p>
            </div>
            <div class="border border-dashed border-line p-5">
                <div class="eyebrow">intentic platform</div>
                <p class="mt-1.5 text-sm text-subtle">Stores your identity and sandbox URL. Does not handle commands or files.</p>
            </div>
        </div>
    )
}

{
    figure === "platform-boundary" && (
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="card border-primary-600/30 bg-primary-600/[0.03] p-5">
                <div class="flex items-center gap-2">
                    <span class="text-link">
                        <Fragment set:html={lockGlyph} />
                    </span>
                    <h3 class="text-sm font-medium text-content">Stays inside your sandbox</h3>
                </div>
                <ul class="mt-4 space-y-2">
                    {boundary.local.map((item) => (
                        <li class="text-sm leading-relaxed text-muted">{item}</li>
                    ))}
                </ul>
            </div>
            <div class="border border-dashed border-line p-5">
                <div class="flex items-center gap-2">
                    <span class="text-subtle">
                        <Fragment set:html={cubeGlyph} />
                    </span>
                    <h3 class="text-sm font-medium text-muted">All the platform holds</h3>
                </div>
                <ul class="mt-4 space-y-2">
                    {boundary.platform.map((item) => (
                        <li class="text-sm leading-relaxed text-subtle">{item}</li>
                    ))}
                </ul>
                <p class="mt-4 border-t border-line pt-3 text-xs leading-relaxed text-subtle">
                    Stored records use AES-256-GCM encryption. The product has no feature that can decrypt them.
                </p>
            </div>
        </div>
    )
}

{
    figure === "prompt-vs-environment" && (
        <div class="grid items-start gap-4 sm:grid-cols-2">
            <div class="card p-5">
                <div class="flex items-baseline justify-between gap-3">
                    <h3 class="text-sm font-medium text-muted">A prompt</h3>
                    <span class="text-2xs text-subtle">a system prompt and a few .md files</span>
                </div>
                <ul class="mt-4 space-y-2.5">
                    {layers.prompt.map((point) => (
                        <li class="flex items-start gap-3 text-sm leading-relaxed text-subtle">
                            <span class="mt-0.5 shrink-0 text-line-strong">
                                <Fragment set:html={minusGlyph} />
                            </span>
                            {point}
                        </li>
                    ))}
                </ul>
            </div>

            <div class="card border-primary-600/30 bg-primary-600/[0.03] p-5">
                <div class="flex items-baseline justify-between gap-3">
                    <h3 class="text-sm font-medium text-content">The whole environment</h3>
                    <span class="text-2xs text-link">a sandbox you can open and change</span>
                </div>
                <ul class="mt-4 space-y-2.5">
                    {layers.environment.map((point) => (
                        <li class="flex items-start gap-3 text-sm leading-relaxed text-content">
                            <span class="mt-0.5 shrink-0 text-link">
                                <Fragment set:html={checkGlyph} />
                            </span>
                            {point}
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    )
}

{
    figure === "sharing" && (
        /* Stacked for the same reason `ownership` is: this figure lives in half a page column, and the
           landing's left-to-right fan of tunnels needs a width that does not exist here. */
        <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-3">
                {people.map((person) => (
                    <div class={`card flex items-center gap-3 p-4 ${person.owner ? "border-primary-600/30 bg-primary-600/[0.03]" : ""}`}>
                        <span
                            class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold ${person.owner ? "bg-primary-600/15 text-link" : "bg-overlay text-muted"}`}
                        >
                            {person.name.charAt(0)}
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium text-content">{person.name}</span>
                                <span class={`chip ${person.owner ? "bg-primary-600/15 text-link" : "bg-overlay text-muted"}`}>{person.role}</span>
                            </div>
                            <div class="mt-1 text-2xs text-subtle">{person.access}</div>
                        </div>
                    </div>
                ))}
            </div>

            <div class="flex items-center gap-2 px-1 text-xs font-medium text-link">
                <span>
                    <Fragment set:html={chevronDownGlyph} />
                </span>
                <span class="flex items-center gap-1.5">
                    <Fragment set:html={lockGlyph} />
                    each over its own private tunnel
                </span>
                <span class="h-px flex-1 bg-line" />
            </div>

            <div class="card border-primary-600/30 bg-primary-600/[0.03] p-6 text-center shadow-xl shadow-black/30">
                <span class="mx-auto flex h-11 w-11 items-center justify-center bg-primary-600/15 text-link">
                    <Fragment set:html={cubeGlyph} />
                </span>
                <div class="mt-3 text-sm font-medium text-content">one specialized sandbox</div>
                <div class="mt-1 font-mono text-2xs text-subtle">storefront · on the owner's machine</div>
                <div class="mt-3 flex justify-center">
                    <span class="chip bg-success/10 text-success">
                        <span class="h-1.5 w-1.5 rounded-full bg-success" />
                        running
                    </span>
                </div>
            </div>
        </div>
    )
}

{
    figure === "teammate" && (
        <DiscordThread
            thread={thread}
            channel="#releases"
            status="3 online"
            input="Message #releases"
            ariaLabel="A Discord channel where a teammate asks the storefront agent to ship a release and it reports back"
        />
    )
}

{
    figure === "integrations" && (
        <div class="card p-6">
            <div class="grid items-center gap-6 sm:grid-cols-[auto_1fr]">
                <div class="mx-auto flex w-40 flex-col items-center border border-primary-600/40 bg-primary-600/[0.06] p-4 text-center">
                    <span class="flex h-9 w-9 items-center justify-center bg-primary-600/15 text-link">
                        <Fragment set:html={cubeGlyph} />
                    </span>
                    <div class="mt-2 text-sm font-medium text-content">One sandbox</div>
                    <div class="text-2xs text-subtle">credentials inside it</div>
                </div>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    {["GitHub", "GitLab", "PostgreSQL", "MySQL", "Sentry", "SigNoz", "Komodo", "Stripe", "Discord", "Outline", "Redmine", "SSH", "Any MCP server"].map((name) => (
                        <span class="border border-line bg-overlay/40 px-3 py-2 text-xs text-muted">{name}</span>
                    ))}
                </div>
            </div>
        </div>
    )
}
