---
import { scorecard } from "@intentic-dev/astro-integrations";
import DocsCodeBlock from "./DocsCodeBlock.astro";
import { githubUrl } from "@intentic-dev/site-content/site";

/* The one claim on this site that does not ask the reader to trust anybody.
 *
 * Everything else in the trust section is an argument — the platform cannot reach your code, the person is
 * real, the source is readable. Those are worth making, and none of them is checkable in the thirty seconds
 * somebody spends deciding whether to run an installer. This is: three commands, run on their machine,
 * against a public transparency log, that answer whether the bytes they downloaded came from the source
 * they can read. We are not a party to the check.
 *
 * The score is MEASURED, never authored — the same rule TrustCards applies to the commit count, and here it
 * matters more, because a security number typed by the people it grades is not evidence of anything. When
 * the API cannot be read at build time the block still renders: the commands are the substance, the score is
 * the summary. It never renders a placeholder number and never renders a zero. */
const card = await scorecard();

const commands = `# The desktop installer, or any binary from a release
gh attestation verify Intentic-<version>-x64-setup.exe --repo intentic/intentic

# The sandbox image your machine runs
gh attestation verify oci://ghcr.io/intentic/sandbox:stable --repo intentic/intentic

# The npm packages
npm audit signatures`;
---

<div class="card p-6 sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="max-w-xl">
            <div class="eyebrow">Verify it yourself</div>
            <h3 class="mt-3 text-xl font-semibold tracking-tight text-content">Don't trust us. Check.</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
                Every installer, binary and container image is built by CI from a tagged commit in the public repository, and each one carries a signature
                published to a transparency log anyone can read. These commands confirm that what you downloaded came from the source you can read — on your
                machine, against public infrastructure, with us not involved.
            </p>
        </div>

        {
            card !== null && (
                <a
                    href={card.url}
                    target="_blank"
                    rel="noopener"
                    class="flex shrink-0 flex-col items-center rounded-xl border border-line bg-primary-600/5 px-6 py-4 no-underline transition-colors hover:border-primary-500/40"
                >
                    <span class="eyebrow">OpenSSF Scorecard</span>
                    <span class="mt-2 text-3xl font-semibold tracking-tight text-content">
                        {card.score.toFixed(1)}
                        <span class="text-base font-normal text-subtle">/10</span>
                    </span>
                    <span class="mt-1 text-2xs text-subtle">scanned {card.date}</span>
                </a>
            )
        }
    </div>

    <DocsCodeBlock code={commands} lang="bash" title="needs the GitHub CLI — no account" />

    <p class="text-sm leading-relaxed text-muted">
        What a signature cannot tell you is whether the source itself is worth trusting. That part is the reading, and it is why
        <a href={githubUrl} target="_blank" rel="noopener" class="text-link hover:underline">all of it is public</a>.
    </p>
</div>
