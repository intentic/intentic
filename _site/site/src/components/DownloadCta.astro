---
import { DESKTOP_DOWNLOADS_PAGE, DESKTOP_GENERIC_ICON, desktopPlatforms } from "../lib/desktop-downloads";

/* THE THIRD DOOR: an installer, for the computer the visitor is reading this on. */

interface Props {
    /** Appended to the button's own classes: `btn-sm` for a compact row, or spacing at the call site. */
    class?: string;
    /** The resting label, before the script narrows it to the reader's platform. */
    label?: string;
    /** The tray glyph. Off where the control is already small and the row around it is words. */
    icon?: boolean;
}

const { class: className, label = "Download the app", icon = true } = Astro.props;

// Name and link only: the glyph in the table is the download page's, and shipping it in an attribute here
// would put a Windows logo in the hero's HTML for nobody to draw.
const targets = Object.fromEntries(
    Object.entries(desktopPlatforms).map(([key, platform]) => [key, { name: platform.name, href: platform.href }]),
);
---

<a
    class:list={["btn", "btn-secondary", className]}
    href={DESKTOP_DOWNLOADS_PAGE}
    data-download-cta
    data-platforms={JSON.stringify(targets)}
>
    {/* Keep the platform meaning in the button label; the small icon is only decorative. */}
    {icon && (
        <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor" aria-hidden="true">
            <path d={DESKTOP_GENERIC_ICON}></path>
        </svg>
    )}
    <span data-download-label>{label}</span>
</a>

{/* Wrap the inline script so multiple download buttons do not redeclare its variables. */}
<script is:inline>
    (() => {
        // userAgentData.platform where it exists ("Windows", "Linux", "macOS", "Android"), the user-agent
        // string where it does not. Android and ChromeOS both say Linux and get neither build.
        const hint = navigator.userAgentData?.platform || navigator.userAgent;
        const key = /Win/i.test(hint)
            ? "windows"
            : /Linux|X11/i.test(hint) && !/Android|CrOS/i.test(hint)
              ? "linux"
              : null;
        if (!key) {return;}

        for (const cta of document.querySelectorAll("[data-download-cta]")) {
            const platform = JSON.parse(cta.dataset.platforms || "{}")[key];
            if (!platform) {continue;}
            cta.href = platform.href;
            cta.querySelector("[data-download-label]").textContent = `Download for ${platform.name}`;
        }
    })();
</script>
