---
import { bookHref, bookNeighbours, bookPage } from "@intentic-dev/site-content/book";
import { referenceBook } from "@intentic-dev/site-content/reference";
import type { DocsHeading } from "../lib/docs-headings";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSearch from "./DocsSearch.astro";
import DocsSearchField from "./DocsSearchField.astro";
import DocsSidebar from "./DocsSidebar.astro";
import DocsToc from "./DocsToc.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

/* THE /api BOOK'S PAGE FRAME. Same rail, same prose column, same section list and the same tokens as
 * DocsLayout, and a sibling of it rather than a variant, for one reason that is not cosmetic.
 *
 * DocsLayout RENDERS ITS SLOT TO A STRING and re-emits it with `set:html`, because it discovers a page's
 * headings by reading the markup the page produced. That is a fine bargain for a book of static prose and it
 * states its own condition out loud: "no client islands anywhere under /docs/". A string is finished HTML, not
 * a hydration boundary, so anything interactive inside it arrives as dead markup.
 *
 * This book's whole point is a playground that answers you. So the slot is rendered STRAIGHT INTO THE PAGE
 * here, islands and all, and the price is that headings can no longer be discovered: they are passed in. For
 * the 37 generated pages that is free and in fact better, because the section list is the group's own
 * operations, known before a single tag is emitted rather than recovered from markup afterwards. The five
 * authored pages state theirs, which is the same discipline `requireAnchors` already asks of a docs page.
 *
 * Everything else is shared. DocsSidebar, DocsToc, DocsSearchField and DocsSearch take a book or a list and do
 * not care which book it is, so the rail, the section list and the search field here are the same components
 * the other two books use, not copies of them.
 */

interface Props {
    pageId: string;
    /** The page's h1. Must start with the page's title in the book tree, as in DocsLayout. */
    heading: string;
    lead: string;
    /**
     * The page's own sections, for the "On this page" list. Authored rather than discovered, because this
     * layout hands the slot to the browser instead of reading it. Under three entries the list suppresses
     * itself, so a short page can pass an empty array and say nothing.
     */
    headings?: DocsHeading[];
    /** Shown above the prose on every page in the book: what the playground is and is not. */
    simulated?: boolean;
}

const { pageId, heading, lead, headings = [], simulated = false } = Astro.props;

const book = referenceBook;
const page = bookPage(book, pageId);
const bookRoot = bookHref(book, "");

const breadcrumbs = [
    { name: book.label, path: bookRoot },
    ...(page && pageId ? [{ name: page.title, path: bookHref(book, pageId) }] : []),
];

const { section, prev, next } = bookNeighbours(book, pageId);
---

<BaseLayout breadcrumbs={breadcrumbs}>
    <Nav />
    <main class="flex-1">
        <div
            class="below-bar mx-auto grid max-w-6xl gap-10 px-6 pb-20 lg:grid-cols-[15rem_1fr] lg:gap-14 xl:max-w-[96rem] xl:grid-cols-[16rem_minmax(0,1fr)_14rem]"
        >
            <aside class="lg:relative">
                <div class="mb-4 flex items-center gap-2 lg:hidden">
                    <button
                        class="flex items-center gap-2 border border-line bg-card px-3.5 py-2 text-sm text-muted"
                        id="docs-sidebar-toggle"
                        aria-label="Toggle API menu"
                        aria-expanded="false"
                    >
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                        </svg>
                        Menu
                    </button>
                    <DocsSearchField variant="compact" />
                </div>
                <div class="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto pb-2 lg:block" id="docs-sidebar" data-rail-scroll>
                    <DocsSidebar book={book} pageId={pageId}>
                        <div class="mb-6 hidden lg:block" slot="search">
                            <DocsSearchField />
                        </div>
                    </DocsSidebar>
                </div>
            </aside>

            <article class="docs-article min-w-0">
                <nav aria-label="Breadcrumb" class="mb-6 text-xs text-subtle">
                    <ol class="flex flex-wrap items-center gap-1.5 p-0">
                        <li><a href="/" class="transition-colors hover:text-link">Home</a></li>
                        <li aria-hidden="true">›</li>
                        <li><a href={bookRoot} class="transition-colors hover:text-link">{book.label}</a></li>
                        {
                            pageId && (
                                <Fragment>
                                    <li aria-hidden="true">›</li>
                                    {section && (
                                        <Fragment>
                                            <li class="text-subtle">{section.label}</li>
                                            <li aria-hidden="true">›</li>
                                        </Fragment>
                                    )}
                                    <li aria-current="page" class="text-muted">
                                        {page?.title}
                                    </li>
                                </Fragment>
                            )
                        }
                    </ol>
                </nav>

                <header class="mb-10 border-b border-line pb-8">
                    <div class="eyebrow">{section?.label ?? book.label}</div>
                    <h1 class="display mt-3 text-3xl font-semibold sm:text-4xl">{heading}</h1>
                    <p class="mt-4 text-base leading-relaxed text-muted">{lead}</p>
                </header>

                {
                    /* THE STANDING NOTE, on every page that carries a playground. It is the one thing about
                       this book a reader could otherwise get wrong in a way that matters: the answers are made
                       up in their own tab, and the copyable commands beside them are the real thing. Said once
                       per page, above the fold, rather than once per operation, where 43 copies of it on the
                       git page would stop being read by the third. */
                    simulated && (
                        <div class="mb-8 flex gap-3 border border-line bg-card px-4 py-3 text-sm text-muted">
                            <span aria-hidden="true" class="mt-0.5 text-primary-500">
                                ▲
                            </span>
                            <p class="m-0">
                                <strong class="text-content">Nothing here leaves this page.</strong> The playground answers from a simulated
                                sandbox running in your own browser, so every call is safe to press and none of them needs a sign-in. The{" "}
                                <code>curl</code> and TypeScript beside each one are the real thing: point them at your sandbox and they work.
                            </p>
                        </div>
                    )
                }

                <DocsToc headings={headings} variant="inline" />

                <div class="docs-body"><slot /></div>

                {
                    (prev || next) && (
                        <div class="mt-16 border-t border-line pt-8">
                            {section && <div class="eyebrow mb-4">More in {section.label}</div>}
                            <div class="flex items-stretch justify-between gap-4">
                                {prev ? (
                                    <a href={bookHref(book, prev.id)} class="group flex flex-col gap-1">
                                        <span class="eyebrow">Previous</span>
                                        <span class="text-sm font-medium text-content transition-colors group-hover:text-link">← {prev.title}</span>
                                    </a>
                                ) : (
                                    <span />
                                )}
                                {next && (
                                    <a href={bookHref(book, next.id)} class="group ml-auto flex flex-col gap-1 text-right">
                                        <span class="eyebrow">Next</span>
                                        <span class="text-sm font-medium text-content transition-colors group-hover:text-link">{next.title} →</span>
                                    </a>
                                )}
                            </div>
                        </div>
                    )
                }
            </article>

            <DocsToc headings={headings} variant="rail" />
        </div>
    </main>
    <Footer />

    <DocsSearch />

    {/* The rail's overflow fades and its open-on-narrow behaviour, and the section rail's scroll-spy. Both are
        DocsLayout's scripts unchanged: they read the DOM by id and data attribute, so they are about the page
        frame rather than about which book rendered it. */}
    <script>
        const toggle = document.getElementById("docs-sidebar-toggle");
        const sidebar = document.getElementById("docs-sidebar");

        if (sidebar) {
            const edges = () => {
                sidebar.toggleAttribute("data-overflow-top", sidebar.scrollTop > 1);
                sidebar.toggleAttribute("data-overflow-bottom", Math.ceil(sidebar.scrollTop + sidebar.clientHeight) < sidebar.scrollHeight - 1);
            };

            toggle?.addEventListener("click", () => {
                const open = sidebar.classList.toggle("!block");
                toggle.setAttribute("aria-expanded", String(open));
                if (open) {
                    sidebar.querySelector('[aria-current="page"]')?.scrollIntoView({ block: "nearest" });
                    edges();
                }
            });

            /* THE RAIL STAYS PUT ACROSS A NAVIGATION. Every link in this book is a full page load, so the rail —
               its own scroll region — reset to the top on each click and the reader lost their place in a long
               list. Its position is remembered per book and restored on the next page; only on a first visit,
               with nothing saved, does it fall back to revealing the current page. */
            const scrollKey = `rail-scroll:${location.pathname.split("/")[1] || "root"}`;
            const saved = sessionStorage.getItem(scrollKey);
            if (saved !== null) sidebar.scrollTop = Number(saved);
            else sidebar.querySelector('[aria-current="page"]')?.scrollIntoView({ block: "nearest" });

            edges();
            sidebar.addEventListener(
                "scroll",
                () => {
                    edges();
                    sessionStorage.setItem(scrollKey, String(sidebar.scrollTop));
                },
                { passive: true },
            );
            window.addEventListener("resize", edges);
        }
    </script>

    <script>
        const links = new Map<string, HTMLElement>();
        for (const link of document.querySelectorAll<HTMLElement>("[data-toc-link]")) {
            const id = link.dataset.tocLink;
            if (id) links.set(id, link);
        }

        if (links.size > 0) {
            const ACTIVE = ["border-primary-500", "text-content"];
            const IDLE = ["border-line", "text-subtle"];
            const visible = new Set<string>();
            let current = "";

            const paint = (id: string) => {
                if (id === current) return;
                const previous = current === "" ? undefined : links.get(current);
                previous?.classList.remove(...ACTIVE);
                previous?.classList.add(...IDLE);
                const next = links.get(id);
                next?.classList.remove(...IDLE);
                next?.classList.add(...ACTIVE);
                current = id;
            };

            const order = [...links.keys()];
            const settle = () => {
                const first = order.find((id) => visible.has(id));
                if (first) paint(first);
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        const id = entry.target.id;
                        if (entry.isIntersecting) visible.add(id);
                        else visible.delete(id);
                    }
                    settle();
                },
                { rootMargin: "-100px 0px -70% 0px", threshold: 0 },
            );

            for (const id of order) {
                const heading = document.getElementById(id);
                if (heading) observer.observe(heading);
            }

            paint(order[0] ?? "");
        }
    </script>
</BaseLayout>
