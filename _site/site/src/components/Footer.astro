---
import { developersHref } from "@intentic-dev/site-content/developers";
import { referenceHref } from "@intentic-dev/site-content/reference";
import { compareFamilies, compareHref, comparePages } from "@intentic-dev/site-content/compare";
import { docsDestinations } from "@intentic-dev/site-content/docs";
import { guidePages, guidesHref } from "@intentic-dev/site-content/guides";
import { productHref, productPages } from "@intentic-dev/site-content/product";
import { APP_URL, discordUrl, githubIssuesUrl, githubReleasesUrl, githubUrl, ORG_NAME, ORG_TAGLINE } from "@intentic-dev/site-content/site";
import { GITHUB_MARK } from "../lib/marks";
import DiscordIcon from "./DiscordIcon.astro";
import ExternalIcon from "./ExternalIcon.astro";
import Lotus from "./Lotus.astro";

const year = 2026;

/* The five columns, as data. They render through one loop because they are one thing: a labelled list of
 * links, some of which leave the site, and five hand-written copies of that markup is how the footer ended
 * up with the external mark on none of them. `external` is the whole switch: it opens the tab AND draws the
 * arrow, so the two can no longer disagree. */
const columns: { label: string; links: { href: string; label: string; external?: boolean }[] }[] = [
    {
        label: "Features",
        links: productPages.map((page) => ({ href: productHref(page.slug), label: page.navLabel })),
    },
    {
        // The four destinations, not the tree: the same list the top bar carries, and for the same reason:
        // this column was every docs page, so it grew a row per page written and stood three times the height
        // of its neighbours. A footer column is a shortcut, and nineteen shortcuts is a table of contents.
        label: "Docs",
        links: [
            ...docsDestinations.map((destination) => ({ href: destination.href, label: destination.label })),
            { href: githubReleasesUrl, label: "Release notes", external: true },
        ],
    },
    {
        /* The authoring book, named page by page rather than shelf by shelf: the opposite of the column above,
         * on purpose. Its shelves are two, so shelf rows would be a column of two; and these are the pages
         * people deep-link and search for by name. A footer column is a shortcut, and "Manifest reference" is a
         * shortcut in a way that "Reference" is not. Earn rides here too: it left the book for its own
         * top-level page, but "how do creators get paid" is searched from the same seat these are.
         *
         * "Offer a paid service" sits beside Earn because it is the OTHER thing you can ship here, and this
         * column is its only sitewide row. The top bar cannot carry it (that menu is one row per shelf, by
         * construction) and its readers are people who already run a paid API: they arrive from a search
         * engine rather than from browsing the product, and a page with one inbound link is a page search
         * never surfaces. A footer row costs no attention and fixes exactly that. */
        label: "Developers",
        links: [
            { href: developersHref(""), label: "Extension API" },
            { href: developersHref("build"), label: "Build an extension" },
            { href: developersHref("publish"), label: "Publish & registries" },
            { href: developersHref("manifest"), label: "Manifest reference" },
            /* The wire API's sitewide row, pointing OUT of this column into its own book. It sits here rather
             * than getting a column of its own for the same reason the docs column is four destinations and
             * not nineteen pages: a footer column is a shortcut. The one shortcut worth having into a book of
             * 42 pages is its front door. */
            { href: referenceHref(""), label: "Sandbox API reference" },
            { href: developersHref("services"), label: "Offer a paid service" },
            { href: "/earn/", label: "Earn & the creator pool" },
        ],
    },
    {
        /* The guides, named one by one rather than as a single hub row. These are the pages someone reaches
         * from a question rather than from this site, so their job is to be findable at all: a sitewide link
         * per guide is how each one gets crawled and re-crawled on its own, and the titles are the questions
         * people actually type. The hub sits on top for the reader who wants the shelf. */
        label: "Guides",
        links: [
            { href: guidesHref(""), label: "All guides" },
            ...guidePages.map((page) => ({ href: guidesHref(page.slug), label: page.navLabel })),
        ],
    },
    {
        label: "Resources",
        links: [
            { href: APP_URL, label: "Open the app", external: true },
            // Directly under "Open the app", and worded to rhyme with it, because they are the same app
            // reached two ways rather than two products, which is the one thing a reader weighing an
            // installer against a browser needs to know. This is also the sitewide home of the download
            // page now that it has left the top bar (see nav.ts for why it left).
            { href: "/download/", label: "Download the app" },
            // …and the question BEFORE both of those: which machine any of this runs on. It sits with them
            // rather than in Docs because it is a decision, not a reference, and it is out of the top bar for
            // the reason the download page is (nav.ts): a permanent tab beside "Create your workspace" offers
            // two openings where there is one.
            { href: "/where-it-runs/", label: "Where it runs" },
            { href: "/changelog/", label: "Changelog" },
            { href: "/about/", label: "About the creator" },
            { href: githubUrl, label: "GitHub", external: true },
            // Directly under Issues, because the two are one decision made twice a day: a question goes to
            // Discord and a bug goes to Issues, and a reader choosing between them should not have to hunt
            // for the second option in a different column.
            { href: discordUrl, label: "Discord community", external: true },
            { href: githubIssuesUrl, label: "Issues", external: true },
            { href: "/#faq", label: "FAQ" },
        ],
    },
];

/* The comparison shelf, as a BAND rather than a sixth column, and GROUPED rather than flat.
 *
 * Every other column here is a handful of unlike things a reader picks between. This is twelve of one
 * thing, and as a column it stood four rows below its tallest neighbour, so the footer ended on a ragged
 * spike with a hole beside it. A band fixed the shape and left the real problem: twelve product names in
 * one undifferentiated run, which is a list you can only use if you already know the name you want. A
 * reader who does not — and that is most of them — cannot tell from "vs Hermes" whether Hermes is a rival,
 * a thing that runs inside this, or something else entirely.
 *
 * THE ANSWER WAS ALREADY WRITTEN, in `compare.ts`: the shelf's whole argument is that most of the tools
 * people name are NOT competitors, so every page is filed under one of five families, and each family
 * carries a three-word verdict — "intentic runs these", "keep yours", "the opposite trade". Those verdicts
 * are the most useful words on the shelf and the footer was throwing them away. Grouping by family puts
 * each name under the sentence that says what kind of thing it is, and the whole band becomes readable
 * without opening anything.
 *
 * NOT A FEATURE MATRIX, deliberately, and `compare.ts` says why at more length: a table where every row is
 * a tick for us is the fastest way to lose the credibility the rest of the site is built on. The families
 * are the honest compression — three of the five verdicts concede that the other tool is not competing.
 *
 * Families with no page of their own are dropped rather than rendered empty: `examples` names tools this
 * site has no page for, and a heading with nothing under it is a promise the footer cannot keep. */
const compareFamilyLinks = compareFamilies
    .map((family) => ({
        label: family.label,
        verdict: family.verdict,
        links: comparePages.filter((page) => page.family === family.id).map((page) => ({ href: compareHref(page.slug), label: page.navLabel })),
    }))
    .filter((family) => family.links.length > 0);

const legalLinks = [
    { href: "/privacy/", label: "Privacy Policy" },
    { href: "/terms/", label: "Terms of Service" },
    { href: "/acceptable-use/", label: "Acceptable Use" },
    { href: "/dpa/", label: "DPA" },
    { href: "/subprocessors/", label: "Sub-processors" },
    { href: "/credits/", label: "Credits" },
];
---

{/* A ground a shade darker than the page, so the band reads as the END of it rather than as one more
    section, with the same wall texture the bands upstairs carry. `mt-auto` keeps it at the bottom of a
    short page. */}
<footer class="relative mt-auto overflow-hidden border-t border-line bg-[#090706] pt-14 pb-10">
    <div class="wall" aria-hidden="true"></div>

    {/* Six cells: the brand plus five columns, none taller than eight rows. The long tail that used to be a
        sixth column is the band below.

        One row of six only from xl, where 80rem gives each column ~178px and labels like "Earn & the creator
        pool" stay on one line. Below that the six split three and three rather than squeezing to 136px, which
        is the width that had five labels wrapping. Two even rows beat one row of ragged ones. */}
    <div class="relative mx-auto grid max-w-7xl grid-cols-2 gap-10 px-6 sm:grid-cols-3 xl:grid-cols-6 xl:gap-8">
        <div class="col-span-2 sm:col-span-1">
            {/* The wordmark is DRAWN rather than an image here, the same pair the bar sets: the flower and
                the word, aligned on the letters. The nudge is the bar's, at this cell's size. */}
            <div class="inline-flex items-center gap-2">
                <Lotus size="md" class="-translate-y-[0.09rem]" />
                <span class="font-mark text-[1.55rem] leading-none font-medium text-primary-500">intentic</span>
            </div>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{ORG_TAGLINE}</p>
            <div class="mt-4 flex gap-4">
                <a href={githubUrl} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-primary-400" aria-label="GitHub repository">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true"><path d={GITHUB_MARK}></path></svg>
                </a>
                <a href={discordUrl} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-primary-400" aria-label="Discord community">
                    <DiscordIcon size={17} />
                </a>
            </div>
        </div>

        {
            columns.map((column) => (
                <div>
                    <h3 class="eyebrow eyebrow-bare mb-3">{column.label}</h3>
                    <ul class="space-y-2">
                        {column.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target={link.external ? "_blank" : undefined}
                                    rel={link.external ? "noopener" : undefined}
                                    class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-primary-400"
                                >
                                    {link.label}
                                    {link.external && <ExternalIcon />}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    {/* The comparison band, in the five families the shelf is actually organised in. Each family is a
        heading, the verdict that family's page argues, and the tools this site has a page for — so a
        reader scanning it learns what KIND of thing each name is before deciding whether to open it.
        Three columns at xl, two on a tablet, one on a phone: the families are unlike each other, so they
        read as a row of small headed lists rather than as one long run of names. */}
    <div class="relative mx-auto mt-12 max-w-7xl px-6">
        <div class="h-px bg-[linear-gradient(90deg,transparent,var(--color-line-strong)_20%,var(--color-line-strong)_80%,transparent)]" aria-hidden="true"></div>
        <div class="flex flex-col gap-5 pt-7 lg:flex-row lg:gap-8">
            {/* The label column, and it carries the hub: "Compare" names the shelf, the link under it goes
                to the page that answers the shelf's own question. `self-start` because an `.eyebrow` is an
                inline-flex that would otherwise stretch to the grid's full height and centre itself. */}
            <div class="flex shrink-0 flex-col items-start gap-2 self-start lg:w-32">
                <h3 class="eyebrow eyebrow-bare">Compare</h3>
                <a href={compareHref("")} class="link text-sm">Where intentic sits →</a>
            </div>
            <div class="grid flex-1 gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-3">
                {
                    compareFamilyLinks.map((family) => (
                        <div>
                            <div class="flex flex-wrap items-baseline gap-x-2">
                                <span class="font-mark text-sm font-semibold text-content">{family.label}</span>
                                {/* The three words that make the whole shelf worth reading: most of these
                                    are not competitors, and the verdict is where that is said. */}
                                <span class="text-2xs text-gold">{family.verdict}</span>
                            </div>
                            <ul class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
                                {family.links.map((link) => (
                                    <li>
                                        <a href={link.href} class="text-sm text-muted transition-colors hover:text-primary-400">
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    {/* The legal bar sets its links in 12px type, which leaves a hit box a fingertip cannot land on: the one
        row of this site that failed the 24px target floor WCAG 2.2 and Lighthouse both use. The type stays
        12px and the wording is unchanged; each link just carries a 24px-high box under it. */}
    <div class="relative mx-auto mt-10 flex max-w-7xl flex-col items-center justify-between gap-2 px-6 text-xs text-subtle sm:flex-row">
        <span>© {year} {ORG_NAME}. Engine MIT licensed.</span>
        <span class="flex flex-wrap items-center justify-center gap-4">
            {
                legalLinks.map((link) => (
                    <a href={link.href} class="inline-flex min-h-6 items-center transition-colors hover:text-gold-bright">
                        {link.label}
                    </a>
                ))
            }
        </span>
        <span class="inline-flex items-center gap-1">
            Open source on
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-6 items-center gap-1 transition-colors hover:text-gold-bright"
            >
                GitHub
                <ExternalIcon />
            </a>
        </span>
    </div>
</footer>
