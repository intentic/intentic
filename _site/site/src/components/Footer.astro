---
import { apiHref } from "@intentic-dev/site-content/api";
import { compareHref, comparePages } from "@intentic-dev/site-content/compare";
import { docsDestinations } from "@intentic-dev/site-content/docs";
import { productHref, productPages } from "@intentic-dev/site-content/product";
import { APP_URL, discordUrl, githubIssuesUrl, githubReleasesUrl, githubUrl, ORG_NAME, ORG_TAGLINE } from "@intentic-dev/site-content/site";
import { Image } from "astro:assets";
import logo from "../assets/intentic-full.png";
import ExternalIcon from "./ExternalIcon.astro";

const year = 2026;

/* The five columns, as data. They render through one loop because they are one thing — a labelled list of
 * links, some of which leave the site — and five hand-written copies of that markup is how the footer ended
 * up with the external mark on none of them. `external` is the whole switch: it opens the tab AND draws the
 * arrow, so the two can no longer disagree. */
const columns: { label: string; links: { href: string; label: string; external?: boolean }[] }[] = [
    {
        label: "Features",
        links: productPages.map((page) => ({ href: productHref(page.slug), label: page.navLabel })),
    },
    {
        // The four destinations, not the tree — the same list the top bar carries, and for the same reason:
        // this column was every docs page, so it grew a row per page written and stood three times the height
        // of its neighbours. A footer column is a shortcut, and nineteen shortcuts is a table of contents.
        label: "Docs",
        links: [
            ...docsDestinations.map((destination) => ({ href: destination.href, label: destination.label })),
            { href: githubReleasesUrl, label: "Release notes", external: true },
        ],
    },
    {
        /* The authoring book, named page by page rather than shelf by shelf — the opposite of the column above,
         * on purpose. Its shelves are two, so shelf rows would be a column of two; and these five are the pages
         * people deep-link and search for by name. A footer column is a shortcut, and "Manifest reference" is a
         * shortcut in a way that "Reference" is not. */
        label: "API",
        links: [
            { href: apiHref(""), label: "Extension API" },
            { href: apiHref("build"), label: "Build an extension" },
            { href: apiHref("publish"), label: "Publish & registries" },
            { href: apiHref("manifest"), label: "Manifest reference" },
            { href: apiHref("http"), label: "HTTP API" },
        ],
    },
    {
        // The hub first: it is the page that reframes the question, and the comparisons below it are the long
        // tail a search engine wants as its own links.
        label: "Compare",
        links: [
            { href: compareHref(""), label: "Where intentic sits" },
            ...comparePages.map((page) => ({ href: compareHref(page.slug), label: page.navLabel })),
        ],
    },
    {
        label: "Resources",
        links: [
            { href: APP_URL, label: "Open the app", external: true },
            { href: "/changelog/", label: "Changelog" },
            { href: "/about/", label: "About the creator" },
            { href: githubUrl, label: "GitHub", external: true },
            // Directly under Issues, because the two are one decision made twice a day: a question goes to
            // Discord and a bug goes to Issues, and a reader choosing between them should not have to hunt
            // for the second option in a different column.
            { href: discordUrl, label: "Discord community", external: true },
            { href: githubIssuesUrl, label: "Issues", external: true },
            { href: "/#faq", label: "FAQ" },
        ],
    },
];

const legalLinks = [
    { href: "/privacy/", label: "Privacy Policy" },
    { href: "/terms/", label: "Terms of Service" },
];
---

<footer class="mt-auto border-t border-line pt-12 pb-10">
    {/* Six cells at lg — the brand plus five columns. The gap tightens with the extra column so the row still
        fits 80rem without the link labels wrapping. */}
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-10 px-6 sm:grid-cols-3 lg:grid-cols-6 lg:gap-8">
        <div class="col-span-2 sm:col-span-1">
            <Image src={logo} alt={ORG_NAME} width={126} height={24} densities={[2]} class="h-6 w-auto" />
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{ORG_TAGLINE}</p>
        </div>

        {
            columns.map((column) => (
                <div>
                    <h3 class="eyebrow mb-3">{column.label}</h3>
                    <ul class="space-y-2">
                        {column.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target={link.external ? "_blank" : undefined}
                                    rel={link.external ? "noopener" : undefined}
                                    class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-link"
                                >
                                    {link.label}
                                    {link.external && <ExternalIcon />}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    {/* The legal bar sets its links in 12px type, which leaves a hit box a fingertip cannot land on — the one
        row of this site that failed the 24px target floor WCAG 2.2 and Lighthouse both use. The type stays
        12px and the wording is unchanged; each link just carries a 24px-high box under it. */}
    <div class="mx-auto mt-10 flex max-w-7xl flex-col items-center justify-between gap-2 px-6 text-xs text-subtle sm:flex-row">
        <span>© {year} {ORG_NAME}. Engine MIT licensed.</span>
        <span class="flex items-center gap-4">
            {
                legalLinks.map((link) => (
                    <a href={link.href} class="inline-flex min-h-6 items-center transition-colors hover:text-link">
                        {link.label}
                    </a>
                ))
            }
        </span>
        <span class="inline-flex items-center gap-1">
            Open source on
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-6 items-center gap-1 transition-colors hover:text-link"
            >
                GitHub
                <ExternalIcon />
            </a>
        </span>
    </div>
</footer>
