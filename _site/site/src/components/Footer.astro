---
import { developersHref } from "@intentic/site-content/developers";
import { referenceHref } from "@intentic/site-content/reference";
import { compareFamilies, compareHref, comparePages } from "@intentic/site-content/compare";
import { docsDestinations } from "@intentic/site-content/docs";
import { guidePages, guidesHref } from "@intentic/site-content/guides";
import { productHref, productPages } from "@intentic/site-content/product";
import { APP_URL, discordUrl, githubIssuesUrl, githubReleasesUrl, githubUrl, ORG_NAME, ORG_TAGLINE } from "@intentic/site-content/site";
import { GITHUB_MARK } from "../lib/marks";
import { DEFAULT_VARIANT_HREF } from "../lib/variant";
import DiscordIcon from "./DiscordIcon.astro";
import ExternalIcon from "./ExternalIcon.astro";
import Lotus from "./Lotus.astro";

const year = 2026;

/* The five columns, as data. */
const columns: { label: string; links: { href: string; label: string; external?: boolean }[] }[] = [
    {
        label: "Features",
        links: productPages.map((page) => ({ href: productHref(page.slug), label: page.navLabel })),
    },
    {
        // The four destinations, not the tree: the same list the top bar carries, and for the same reason:
        // this column was every docs page, so it grew a row per page written and stood three times the height
        // of its neighbours. A footer column is a shortcut, and nineteen shortcuts is a table of contents.
        label: "Docs",
        links: [
            ...docsDestinations.map((destination) => ({ href: destination.href, label: destination.label })),
            { href: githubReleasesUrl, label: "Release notes", external: true },
        ],
    },
    {
/* The authoring book, named page by page rather than shelf by shelf: the opposite of the column above, on purpose. */
        label: "Developers",
        links: [
            { href: developersHref(""), label: "Extension API" },
            { href: developersHref("build"), label: "Build an extension" },
            { href: developersHref("publish"), label: "Publish & registries" },
            { href: developersHref("manifest"), label: "Manifest reference" },
/* The wire API's sitewide row, pointing OUT of this column into its own book. */
            { href: referenceHref(""), label: "Sandbox API reference" },
        ],
    },
    {
/* The guides, named one by one rather than as a single hub row. */
        label: "Guides",
        links: [
            { href: guidesHref(""), label: "All guides" },
            ...guidePages.map((page) => ({ href: guidesHref(page.slug), label: page.navLabel })),
        ],
    },
    {
        label: "Resources",
        links: [
            { href: APP_URL, label: "Open the app", external: true },
            // Directly under "Open the app", and worded to rhyme with it, because they are the same app
            // reached two ways rather than two products, which is the one thing a reader weighing an
            // installer against a browser needs to know. This is also the sitewide home of the download
            // page: it is deliberately not in the top bar (see nav.ts for why).
            { href: "/download/", label: "Download the app" },
            // …and the question BEFORE both of those: which machine any of this runs on. It sits with them
            // rather than in Docs because it is a decision, not a reference, and it is out of the top bar for
            // the reason the download page is (nav.ts): a permanent tab beside "Create your workspace" offers
            // two openings where there is one.
            { href: "/where-it-runs/", label: "Where it runs" },
            { href: "/changelog/", label: "Changelog" },
            // Beside the changelog, which is the pair a reader is choosing between: what shipped, and what
            // we think. Both are rows of the bar's Resources menu too.
            { href: "/blog/", label: "Blog" },
            { href: "/pricing/", label: "Pricing" },
            { href: "/about/", label: "About the creator" },
            { href: githubUrl, label: "GitHub", external: true },
            // Directly under Issues, because the two are one decision made twice a day: a question goes to
            // Discord and a bug goes to Issues, and a reader choosing between them should not have to hunt
            // for the second option in a different column.
            { href: discordUrl, label: "Discord community", external: true },
            { href: githubIssuesUrl, label: "Issues", external: true },
            { href: "/#faq", label: "FAQ" },
        ],
    },
];

/* The comparison shelf, as a BAND rather than a sixth column, and GROUPED rather than flat. */
const compareFamilyLinks = compareFamilies
    .map((family) => ({
        label: family.label,
        verdict: family.verdict,
        links: comparePages.filter((page) => page.family === family.id).map((page) => ({ href: compareHref(page.slug), label: page.navLabel })),
    }))
    .filter((family) => family.links.length > 0);

const legalLinks = [
    { href: "/privacy/", label: "Privacy Policy" },
    { href: "/terms/", label: "Terms of Service" },
    { href: "/acceptable-use/", label: "Acceptable Use" },
    { href: "/dpa/", label: "DPA" },
    { href: "/subprocessors/", label: "Sub-processors" },
    { href: "/credits/", label: "Credits" },
];
---

{/* Keep the footer distinct from the page and pinned to the bottom on short pages. */}
<footer class="relative mt-auto overflow-hidden border-t border-line bg-ground pt-14 pb-10">
    <div class="wall" aria-hidden="true"></div>

    {/* Use six columns only at xl; split them below xl to keep labels readable. */}
    <div class="relative mx-auto grid max-w-7xl grid-cols-2 gap-10 px-6 sm:grid-cols-3 xl:grid-cols-6 xl:gap-8">
        <div class="col-span-2 sm:col-span-1">
            {/* Keep wordmark spacing in `.lockup` and `--wordmark-size`. */}
            <div class="lockup">
                <Lotus size="md" />
                <span class="wordmark">intentic</span>
            </div>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{ORG_TAGLINE}</p>
            <div class="mt-4 flex gap-4">
                <a href={githubUrl} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-primary-400" aria-label="GitHub repository">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true"><path d={GITHUB_MARK}></path></svg>
                </a>
                <a href={discordUrl} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-primary-400" aria-label="Discord community">
                    <DiscordIcon size={17} />
                </a>
            </div>
        </div>

        {
            columns.map((column) => (
                <div>
                    <h3 class="eyebrow eyebrow-bare mb-3">{column.label}</h3>
                    <ul class="space-y-2">
                        {column.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target={link.external ? "_blank" : undefined}
                                    rel={link.external ? "noopener" : undefined}
                                    class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-primary-400"
                                >
                                    {link.label}
                                    {link.external && <ExternalIcon />}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    {/* Keep comparison families grouped by heading and responsive columns. */}
    <div class="relative mx-auto mt-12 max-w-7xl px-6">
        <div class="h-px bg-[linear-gradient(90deg,transparent,var(--color-line-strong)_20%,var(--color-line-strong)_80%,transparent)]" aria-hidden="true"></div>
        <div class="flex flex-col gap-5 pt-7 lg:flex-row lg:gap-8">
            {/* Keep the Compare label and hub link aligned at the start of the rail. */}
            <div class="flex shrink-0 flex-col items-start gap-2 self-start lg:w-32">
                <h3 class="eyebrow eyebrow-bare">Comparisons</h3>
                <a href={compareHref("")} class="link text-sm">Where intentic sits →</a>
            </div>
            <div class="grid flex-1 gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-3">
                {
                    compareFamilyLinks.map((family) => (
                        <div>
                            <div class="flex flex-wrap items-baseline gap-x-2">
                                <span class="font-mark text-sm font-semibold text-content">{family.label}</span>
                                {/* Keep each family's verdict beside its label. */}
                                <span class="text-2xs text-gold">{family.verdict}</span>
                            </div>
                            <ul class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
                                {family.links.map((link) => (
                                    <li>
                                        <a href={link.href} class="text-sm text-muted transition-colors hover:text-primary-400">
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    {/* Keep legal links in 24px hit boxes even when their text is 12px. */}
    <div class="relative mx-auto mt-10 flex max-w-7xl flex-col items-center justify-between gap-2 px-6 text-xs text-subtle sm:flex-row">
        <span>© {year} {ORG_NAME}. Engine MIT licensed.</span>
        <span class="flex flex-wrap items-center justify-center gap-4">
            {
                legalLinks.map((link) => (
                    <a href={link.href} class="inline-flex min-h-6 items-center transition-colors hover:text-gold-bright">
                        {link.label}
                    </a>
                ))
            }
            {/* The way out of the light skin. In the markup on every page so one cached document serves both, and
                shown only when that skin is on — see `.variant-exit` in global.css. */}
            <a href={DEFAULT_VARIANT_HREF} class="variant-exit min-h-6 items-center transition-colors hover:text-gold-bright">
                Developer view →
            </a>
        </span>
        <span class="inline-flex items-center gap-1">
            Open source on
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-6 items-center gap-1 transition-colors hover:text-gold-bright"
            >
                GitHub
                <ExternalIcon />
            </a>
        </span>
    </div>
</footer>
