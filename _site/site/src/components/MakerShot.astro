---
/* ONE PICTURE, ONE SKIN. The maker product's page (MakerLanding.astro) is only ever light, so it needs no dark copy
   and no pair: a single image from the light set, a shot of the maker recording or a default shot's light twin
   (lib/shots.ts `lightShot`). ProductShot is the developer page's pair; this is the maker page's single. */
import { Image } from "astro:assets";
import { lightShot, SHOT_WIDTHS } from "../lib/shots";

interface Props {
    name: string;
    alt: string;
    /** How wide the page paints this shot, so the browser can pick a rung of its srcset. */
    sizes: string;
    class?: string;
    /** The hero is the page's LCP; everything below it waits until it is scrolled near. */
    priority?: boolean;
    widths?: number[];
    /** Anything else — `data-screen`, `style`, `aria-hidden` — lands on the image. */
    [attribute: string]: unknown;
}

const { name, alt, sizes, class: className = "", priority = false, widths = SHOT_WIDTHS, ...rest } = Astro.props;
---

<Image
    src={lightShot(name)}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
    class={className}
    {...rest}
/>
