---
/* The bar starts transparent and lifts after the page scrolls. */
import { navEntries } from "@intentic/site-content/nav";
import { APP_URL, discordUrl, githubUrl } from "@intentic/site-content/site";
import { GITHUB_MARK } from "../lib/marks";
import { isCurrentRow, isCurrentSection } from "../lib/navCurrent";
import { NAV_ICONS } from "../lib/navIcons";
import DiscordIcon from "./DiscordIcon.astro";
import Bullet from "./Bullet.astro";
import Lotus from "./Lotus.astro";
import MobileNav from "./MobileNav.astro";

const currentPath = Astro.url.pathname;
---

<header class="bar" id="site-bar">
    <div class="bar-inner">
        <a href="/" class="brand lockup" aria-label="intentic">
            <Lotus size="lg" class="brand-mark" />
            <span class="wordmark">intentic</span>
        </a>

        <nav class="bar-links" aria-label="Main">
            {
                navEntries.map((entry, index) =>
                    entry.type === "link" ? (
                        <a
                            href={entry.href}
                            class:list={["bar-link", { active: isCurrentSection(entry, currentPath) }]}
                            aria-current={isCurrentSection(entry, currentPath) ? "page" : undefined}
                        >
                            {entry.label}
                        </a>
                    ) : (
                        <div class="menu" data-menu>
                            <button
                                type="button"
                                class:list={["bar-link", "menu-trigger", { active: isCurrentSection(entry, currentPath) }]}
                                aria-expanded="false"
                                aria-controls={`bar-menu-${index}`}
                            >
                                {entry.label}
                                <svg class="chev" width="9" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>

                            {/* Menu chrome stays fixed while its body moves into the shared flyout. */}
                            <div class="menu-panel">
                                <div class="menu-panel-body" id={`bar-menu-${index}`}>
                                    <div class="menu-rows" style={`--menu-cols:${entry.sections.length}`}>
                                        {entry.sections.map((section) => (
                                            <div class="menu-section">
                                                {section.label && <div class="eyebrow eyebrow-bare menu-section-label">{section.label}</div>}
                                                <ul>
                                                    {section.items.map((item) => (
                                                        <li>
                                                            <a
                                                                href={item.href}
                                                                class:list={[
                                                                    "menu-item",
                                                                    "nav-wash",
                                                                    { current: isCurrentRow(item, currentPath), "menu-item--flat": !item.description },
                                                                ]}
                                                                aria-current={isCurrentRow(item, currentPath) ? "page" : undefined}
                                                                target={item.external ? "_blank" : undefined}
                                                                rel={item.external ? "noopener" : undefined}
                                                            >
                                                                {item.icon && NAV_ICONS[item.icon] && (
                                                                    <svg
                                                                        class="menu-item-icon"
                                                                        viewBox="0 0 24 24"
                                                                        fill="none"
                                                                        stroke="currentColor"
                                                                        stroke-width="1.6"
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        aria-hidden="true"
                                                                        set:html={NAV_ICONS[item.icon]}
                                                                    />
                                                                )}
                                                                <span class="menu-item-text">
                                                                    <span class="menu-item-label">{item.label}</span>
                                                                    {item.description && <span class="menu-item-blurb">{item.description}</span>}
                                                                </span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>

                                    {entry.action && (
                                        <a
                                            href={entry.action.href}
                                            class="menu-action"
                                            target={entry.action.external ? "_blank" : undefined}
                                            rel={entry.action.external ? "noopener" : undefined}
                                        >
                                            <Bullet />
                                            {entry.action.label}
                                            <span aria-hidden="true">→</span>
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    ),
                )
            }

            {/* The shared dock is present in markup so Astro scopes its styles. */}
            <div class="flyout">
                <div class="flyout-shift">
                    <div class="flyout-surface"></div>
                </div>
            </div>
        </nav>

        <div class="bar-end">
            <a href={githubUrl} target="_blank" rel="noopener" class="bar-icon" aria-label="GitHub repository" title="GitHub repository">
                <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true"><path d={GITHUB_MARK}></path></svg>
            </a>
            <a href={discordUrl} target="_blank" rel="noopener" class="bar-icon" aria-label="Discord community" title="Discord community">
                <DiscordIcon size={17} />
            </a>
            <a href={APP_URL} class="btn btn-primary btn-sm bar-cta">Create your workspace</a>

            <button class="hamburger" id="mobile-nav-open" aria-label="Toggle navigation" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<MobileNav />

<script>
    /* The navigation remains usable when this enhancement script is unavailable. */

    /* All menu bodies share one surface below the bar. */
    const links = document.querySelector<HTMLElement>(".bar-links");
    const menus = [...document.querySelectorAll<HTMLElement>("[data-menu]")];

    type Menu = { menu: HTMLElement; trigger: HTMLElement; page: HTMLElement };
    const items: Menu[] = [];
    for (const menu of menus) {
        const trigger = menu.querySelector<HTMLElement>(".menu-trigger");
        const page = menu.querySelector<HTMLElement>(".menu-panel-body");
        if (trigger && page) {items.push({ menu, trigger, page });}
    }

    const flyout = document.querySelector<HTMLElement>(".flyout");
    const surface = document.querySelector<HTMLElement>(".flyout-surface");

    if (links && flyout && surface && items.length > 0) {
        /* Switching menus is instant; opening from closed uses a delay. */
        const OPEN_DELAY = 90;
        const CLOSE_GRACE = 140;
        const DRIFT_MS = 340;

        // Enhanced navigation disables the per-menu hover panels.
        links.setAttribute("data-enhanced", "");

        for (const item of items) {
            item.page.classList.add("flyout-page");
            surface.append(item.page);
            item.menu.querySelector(".menu-panel")?.remove();
        }

        // The open value is a complete menu; its index is only for travel direction.
        let open: Menu | null = null;
        let leaving: HTMLElement | null = null;
        let openTimer = 0;
        let closeTimer = 0;
        let driftTimer = 0;
        const idle = () => {
            window.clearTimeout(openTimer);
            window.clearTimeout(closeTimer);
        };

        /* The flyout is positioned from the trigger and clamped to the viewport. */
        const place = (item: Menu) => {
            const nav = links.getBoundingClientRect();
            const label = item.trigger.getBoundingClientRect();
            const size = item.page.getBoundingClientRect();
            const edge = 12;
            const room = Math.max(edge, window.innerWidth - edge - size.width);
            const x = Math.min(Math.max(label.left + label.width / 2 - size.width / 2, edge), room);
            flyout.style.setProperty("--fx", `${Math.round(x - nav.left)}px`);
            surface.style.setProperty("--fw", `${Math.round(size.width)}px`);
            surface.style.setProperty("--fh", `${Math.round(size.height)}px`);
        };

        const light = (i: number) => {
            for (const [n, item] of items.entries()) {
                item.menu.toggleAttribute("data-open", n === i);
                item.trigger.setAttribute("aria-expanded", String(n === i));
                item.page.toggleAttribute("data-active", n === i);
            }
        };

        const show = (i: number) => {
            idle();
            const next = items[i];
            if (!next || next === open) {return;}
            // Content drifts toward the next menu; a cold open only rises.
            flyout.style.setProperty("--dir", String(open ? Math.sign(i - items.indexOf(open)) : 0));

            window.clearTimeout(driftTimer);
            leaving?.removeAttribute("data-leaving");
            leaving = null;
            if (open) {
                leaving = open.page;
                leaving.setAttribute("data-leaving", "");
                driftTimer = window.setTimeout(() => {
                    leaving?.removeAttribute("data-leaving");
                    leaving = null;
                }, DRIFT_MS);
                place(next);
                light(i);
            } else {
                /* Closed panels appear at their trigger without sliding. */
                flyout.setAttribute("data-instant", "");
                place(next);
                light(i);
                void flyout.offsetWidth;
                flyout.removeAttribute("data-instant");
            }
            open = next;
            flyout.setAttribute("data-open", "");
        };

        /* Focus restoration is guarded so its own focus event does not reopen the menu. */
        let restoring = false;
        const restore = (el: HTMLElement) => {
            restoring = true;
            el.focus();
            restoring = false;
        };

        /* Closing keeps the last body active while the surface fades. */
        const hide = () => {
            idle();
            if (!open) {return;}
            const home = open.trigger;
            const holding = open.page.contains(document.activeElement);
            open = null;
            flyout.removeAttribute("data-open");
            for (const item of items) {
                item.menu.removeAttribute("data-open");
                item.trigger.setAttribute("aria-expanded", "false");
            }
            if (holding) {restore(home);}
        };

        for (const link of links.querySelectorAll<HTMLElement>(".bar-link")) {
            const i = items.findIndex((item) => item.trigger === link);
            link.addEventListener("pointerenter", (event) => {
                if (event.pointerType !== "mouse") {return;}
                idle();
                // Hovering a plain destination closes the menu.
                if (i === -1) {
                    hide();
                } else if (!open) {
                    openTimer = window.setTimeout(() => show(i), OPEN_DELAY);
                } else {
                    show(i);
                }
            });
        }
        flyout.addEventListener("pointerenter", (event) => {
            if (event.pointerType === "mouse") {idle();}
        });
        links.addEventListener("pointerleave", (event) => {
            if (event.pointerType !== "mouse") {return;}
            idle();
            // Pointer movement does not close a panel while focus remains inside it.
            if (items.some((item) => item.page.contains(document.activeElement))) {return;}
            closeTimer = window.setTimeout(hide, CLOSE_GRACE);
        });

        // Click opens a menu for touch and keyboard users.
        for (const [i, item] of items.entries()) {
            item.trigger.addEventListener("click", (event) => {
                event.preventDefault();
                if (open === item) {
                    hide();
                } else {
                    show(i);
                }
            });
        }

        links.addEventListener("focusin", (event) => {
            const target = event.target as HTMLElement | null;
            if (!target || restoring) {return;}
            const i = items.findIndex((item) => item.trigger === target);
            if (i !== -1) {
                /* Click handlers open menus; focus alone does not toggle them closed. */
                if (target.matches(":focus-visible")) {show(i);}
                return;
            }
            // Focus inside the panel keeps it; other bar links close it.
            if (!items.some((item) => item.page.contains(target))) {hide();}
        });
        links.addEventListener("focusout", (event) => {
            const next = event.relatedTarget as Node | null;
            if (!next || !links.contains(next)) {hide();}
        });

        /* Tab navigation must cross the shared dock before leaving the bar. */
        links.addEventListener("keydown", (event) => {
            if (!open) {return;}
            if (event.key !== "Tab" && event.key !== "ArrowDown") {return;}
            const { trigger, page } = open;
            const rows = [...page.querySelectorAll<HTMLElement>("a[href]")];
            const target = event.target as HTMLElement | null;
            const first = rows[0];
            if (!target || !first) {return;}

            const into = event.key === "ArrowDown" || (event.key === "Tab" && !event.shiftKey);
            if (target === trigger && into) {
                event.preventDefault();
                first.focus();
                return;
            }
            if (event.key !== "Tab" || !page.contains(target)) {return;}
            const at = rows.indexOf(target);
            if (event.shiftKey && at === 0) {
                event.preventDefault();
                trigger.focus();
                return;
            }
            if (!event.shiftKey && at === rows.length - 1) {
                const bar = [...links.querySelectorAll<HTMLElement>(".bar-link")];
                const next = bar[bar.indexOf(trigger) + 1];
                if (!next) {return;}
                // Focus handling closes or switches the panel.
                event.preventDefault();
                next.focus();
            }
        });
        document.addEventListener("pointerdown", (event) => {
            if (!links.contains(event.target as Node | null)) {hide();}
        });
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || !open) {return;}
            const trigger = open.trigger;
            hide();
            restore(trigger);
        });
        // Resize invalidates the dock measurement, so it closes.
        window.addEventListener("resize", hide);
    }

    /* The bar lifts after scrolling past the top plate. */
    const bar = document.getElementById("site-bar");
    if (bar) {
        const lift = () => bar.toggleAttribute("data-lifted", window.scrollY > 40);
        lift();
        window.addEventListener("scroll", lift, { passive: true });
    }

    /* The hamburger opens an overlay that owns its internal navigation. */
    const toggle = document.getElementById("mobile-nav-open");
    const overlay = document.getElementById("mobile-nav-overlay");
    toggle?.addEventListener("click", () => {
        const open = overlay?.classList.toggle("open") ?? false;
        toggle.classList.toggle("active", open);
        toggle.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
    });
</script>

<style>
    /* The navigation bar keeps one shared height and surface on every page. */
    .bar {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        z-index: 100;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease;
    }
    .bar[data-lifted] {
        background: var(--role-bar-fill);
        border-bottom-color: var(--color-line);
        backdrop-filter: blur(14px);
    }

    .bar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        max-width: 84rem;
        margin: 0 auto;
        padding: 0 1.5rem;
        min-height: var(--bar-height);
    }

    /* The brand lockup aligns the flower with the lettering, not the boxes. */
    .brand {
        --wordmark-size: 1.85rem;
        flex: none;
    }
    .wordmark {
        text-shadow: var(--role-bar-glow);
    }

    /* Relative positioning anchors the shared flyout. */
    .bar-links {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }
    /* The wordmark uses the site's title face. */
    .bar-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.65rem;
        border: 0;
        background: none;
        font-family: var(--font-mark);
        font-weight: var(--font-weight-semibold);
        font-size: 1rem;
        letter-spacing: 0.004em;
        color: var(--color-content);
        text-decoration: none;
        opacity: 0.86;
        cursor: pointer;
        transition:
            color 0.2s ease,
            opacity 0.2s ease;
    }
    .bar-link:hover,
    .bar-link.active,
    .menu[data-open] .menu-trigger {
        color: var(--color-primary-400);
        opacity: 1;
    }
    .chev {
        transition: transform 0.2s ease;
    }
    /* The chevron follows the OPEN menu, not the hovered one — with the script running, hover opens. */
    .menu[data-open] .chev,
    .bar-links:not([data-enhanced]) .menu:hover .chev {
        transform: rotate(180deg);
    }

    /* Menu panels share the page's carved surface vocabulary. */
    .menu {
        position: relative;
    }
    /* THE PANEL IS THE BUTTON'S BLOCK AT WALL SCALE, and like the button it carries its face on its OWN. */
    .menu-panel,
    .flyout-surface {
        --cut: 9px;

        /* Each skin brings its own sheet: a ground, a woven tile and a wash. */
        background-color: var(--role-nav-sheet);
        background-image:
            var(--role-nav-sheet-texture),
            var(--role-nav-sheet-wash);
        background-repeat: repeat, no-repeat;
        background-size: 200px 200px, cover;
        /* Menu panels use the same double rule as buttons. */
        border: 1px solid transparent;
        border-image-source: var(--role-nav-sheet-frame);
        border-image-slice: 16;
        border-image-width: 16px;
        border-image-repeat: stretch;
        clip-path: polygon(
            var(--cut) 0,
            calc(100% - var(--cut)) 0,
            100% var(--cut),
            100% calc(100% - var(--cut)),
            calc(100% - var(--cut)) 100%,
            var(--cut) 100%,
            0 calc(100% - var(--cut)),
            0 var(--cut)
        );
        filter: var(--role-nav-sheet-shadow);
    }

    /* Menu body spacing moves with the shared panel. */
    .menu-panel-body {
        min-width: 22rem;
        padding: 1.1rem 1.15rem 0.9rem;
    }

    /* Without the script each menu keeps its own hover panel. */
    .menu-panel {
        position: absolute;
        top: calc(100% + 0.55rem);
        left: 50%;
        z-index: 10;
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -0.4rem);
        transition:
            opacity 0.18s ease,
            transform 0.18s ease,
            visibility 0s linear 0.18s;
    }
    .menu:hover .menu-panel,
    .menu:focus-within .menu-panel {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
        transition-delay: 0s;
    }

    /* The flyout follows the cursor within one stable panel. */
    .flyout {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 10;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 0.2s ease,
            visibility 0s linear 0.2s;
    }
    .flyout[data-open] {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition-delay: 0s;
    }
    /* The moving part owns the gap below the bar. */
    .flyout-shift {
        padding-top: 0.55rem;
        transform: translateX(var(--fx, 0));
        transition: transform 0.42s cubic-bezier(0.22, 0.68, 0.24, 1);
    }
    /* Content-box sizing matches the dimensions measured from each body. */
    .flyout-surface {
        position: relative;
        box-sizing: content-box;
        width: var(--fw, 22rem);
        height: var(--fh, 10rem);
        transform: translateY(-0.4rem);
        transition:
            width 0.42s cubic-bezier(0.22, 0.68, 0.24, 1),
            height 0.42s cubic-bezier(0.22, 0.68, 0.24, 1),
            transform 0.2s ease;
    }
    .flyout[data-open] .flyout-surface {
        transform: none;
    }
    /* The one frame where the panel is allowed to teleport: a cold open, which must appear at its trigger. */
    .flyout[data-instant],
    .flyout[data-instant] .flyout-shift,
    .flyout[data-instant] .flyout-surface,
    .flyout[data-instant] .flyout-page {
        transition: none;
    }
    /* Menu bodies stack at the surface origin and stay out of flow. */
    .flyout-page {
        position: absolute;
        top: 0;
        left: 0;
        width: max-content;
        max-width: min(92vw, 46rem);
        opacity: 0;
        visibility: hidden;
        transform: translateX(calc(var(--dir, 0) * 12px));
        transition:
            opacity 0.16s ease,
            transform 0.3s cubic-bezier(0.22, 0.68, 0.24, 1),
            visibility 0s linear 0.3s;
    }
    .flyout-page[data-leaving] {
        transform: translateX(calc(var(--dir, 0) * -12px));
    }
    .flyout-page[data-active] {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
            opacity 0.22s ease 0.04s,
            transform 0.34s cubic-bezier(0.22, 0.68, 0.24, 1);
    }

    .menu-rows {
        display: grid;
        grid-template-columns: repeat(var(--menu-cols, 1), minmax(0, 1fr));
        gap: 1.5rem;
    }
    .menu-section-label {
        margin-bottom: 0.6rem;
    }
    .menu-section ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    /* Menu rows contain an icon and label with distinct states. */
    .menu-item {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        /* The active rule is included in the row's left padding. */
        border-left: 2px solid transparent;
        padding: 0.5rem 0.6rem 0.5rem calc(0.6rem - 2px);
        text-decoration: none;
    }
    /* Label-only rows (the reference menu) have one line to sit against, so the icon centres on it. */
    .menu-item--flat {
        align-items: center;
    }

    .menu-item-icon {
        flex: none;
        width: 1.15rem;
        height: 1.15rem;
        /* Dropped a hair so the glyph sits on the label's cap line once a blurb makes the text two lines tall. */
        margin-top: 0.08rem;
        color: var(--color-gold);
        transition:
            color 0.2s ease,
            transform 0.26s cubic-bezier(0.34, 1.5, 0.64, 1);
    }
    .menu-item--flat .menu-item-icon {
        margin-top: 0;
    }
    /* The hover's second signal, and the reason the label can stay put: it is already the brightest text. */
    .menu-item:hover .menu-item-icon,
    .menu-item:focus-visible .menu-item-icon {
        color: var(--color-gold-bright);
        transform: scale(1.08);
    }
    .menu-item-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .menu-item-label {
        font-family: var(--font-mark);
        font-size: 0.9375rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-content);
    }
    .menu-item-blurb {
        margin-top: 0.1rem;
        max-width: 30ch;
        font-size: 0.75rem;
        line-height: 1.45;
        color: var(--color-subtle);
    }

    /* Current rows keep their state while hovered. */
    .menu-item.current {
        border-left-color: var(--color-primary-500);
    }
    .menu-item.current .menu-item-icon,
    .menu-item.current:hover .menu-item-icon,
    .menu-item.current:focus-visible .menu-item-icon {
        color: var(--color-primary-400);
    }
    .menu-item.current .menu-item-label {
        color: var(--color-primary-400);
    }

    .menu-action {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.9rem;
        border-top: 1px solid var(--color-line);
        padding: 0.8rem 0.6rem 0.1rem;
        font-size: 0.875rem;
        color: var(--color-gold-bright);
        text-decoration: none;
        transition: color 0.16s ease;
    }
    .menu-action:hover {
        color: var(--color-primary-400);
    }

    .bar-end {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: none;
    }
    .bar-icon {
        display: inline-flex;
        color: var(--color-muted);
        transition: color 0.2s ease;
    }
    .bar-icon:hover {
        color: var(--color-primary-400);
    }

    /* The bar CTA hides when the hero already exposes the same action. */
    .bar[data-cta-managed] .bar-cta {
        opacity: 0;
        transform: translateY(-0.45rem);
        pointer-events: none;
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
    }
    .bar[data-cta-managed][data-cta-shown] .bar-cta {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }

    /* Hamburger control styles. */
    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        padding: 4px;
        background: none;
        border: none;
        cursor: pointer;
    }
    .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-gold);
        transition:
            transform 0.3s,
            opacity 0.3s;
    }
    .hamburger.active span:nth-child(1) {
