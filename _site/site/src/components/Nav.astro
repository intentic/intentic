---
import type { NavEntry } from "@intentic-dev/site-content/nav";
import { navEntries } from "@intentic-dev/site-content/nav";
import { APP_URL, githubUrl, ORG_NAME } from "@intentic-dev/site-content/site";
import { Image } from "astro:assets";
import logo from "../assets/intentic-full.png";
import { shotAsset, SHOT_WIDTHS } from "../lib/shots";
import ExternalIcon from "./ExternalIcon.astro";
import MobileNav from "./MobileNav.astro";

const currentPath = Astro.url.pathname;

function isActive(entry: NavEntry): boolean {
    if (entry.type === "link") {
        return currentPath === entry.href || currentPath.startsWith(entry.prefix);
    }
    return currentPath.startsWith(entry.prefix);
}

/* A menu row points at ONE page, so it lights up only on that page. The trigger above matches a prefix because
 * a whole menu is "current"; a row must not — /docs/ is a prefix of every docs page, which made "Overview" the
 * current row everywhere under Docs, and "Extensions" current on each of its three children.
 * The trailing slash is "always" in a build and "ignore" in dev, so it is not part of the comparison. */
const bare = (path: string): string => path.replace(/\/+$/, "");
const isCurrentPage = (href: string): boolean => bare(href) === bare(currentPath);
---

<nav class="fixed top-0 right-0 left-0 z-100 border-b border-line bg-canvas/70 backdrop-blur-lg transition-colors duration-300">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
        {/* The wordmark is what a phone paints largest before the hero image arrives, so it IS the LCP on
            every page here — hence eager and fetchpriority=high, ahead of the stylesheet's other requests.
            `shrink-0` because the links row does not wrap: without it a bar one link too full pays for the
            overflow out of the BRAND, silently — the wordmark rendered at 50px of its 126 before this. */}
        <a href="/" class="flex shrink-0 items-center no-underline">
            <Image src={logo} alt={ORG_NAME} width={126} height={24} densities={[2]} loading="eager" fetchpriority="high" class="h-6 w-auto" />
        </a>

        <button
            class="hamburger flex-col gap-1.25 p-1"
            id="mobile-nav-open"
            aria-label="Toggle navigation"
            aria-expanded="false"
        >
            <span></span><span></span><span></span>
        </button>

        {/* The bar swaps to the hamburger at 64rem, not the 48rem it used to: six links, the repo mark and the
            CTA need ~900px of the 1280 this row ever gets, and at 48rem they had 768 to share with the
            wordmark. A tablet gets the overlay — the same navigation, laid out for a width that can hold it.
            Which of the two shows is decided ONLY by the media query in this file's <style> and the matching
            one in MobileNav: an Astro scoped rule is unlayered and so outranks any Tailwind `max-lg:hidden`
            here however specific that looks, and a second spelling of the breakpoint is a second answer at
            the pixel where they disagree. */}
        <ul class="links flex list-none items-center gap-0.5" id="nav-links">
            {
                navEntries.map((entry) => {
                    if (entry.type === "menu") {
                        const preview = entry.sections
                            .flatMap((section) => section.items)
                            .flatMap((item) => (item.shot === undefined ? [] : [{ href: item.href, shot: item.shot }]));
                        return (
                            <li class="nav-item has-menu">
                                <button type="button" class:list={["nav-link", { active: isActive(entry) }]} aria-expanded="false">
                                    {entry.label}
                                    <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>

                                {/* The panel. Its column count follows the section count, so Product reads as
                                    its three shelves and Docs as one narrow column of destinations — and the
                                    preview rail exists only where there are screenshots to preview. */}
                                <div class:list={["menu-panel", { "has-preview": preview.length > 0 }]}>
                                    <div class="menu-sections" style={`--menu-columns:${entry.sections.length}`}>
                                        {entry.sections.map((section) => (
                                            <div class="menu-section">
                                                {section.label && <div class="menu-section-label">{section.label}</div>}
                                                <ul>
                                                    {section.items.map((item) => (
                                                        <li>
                                                            <a
                                                                href={item.href}
                                                                class:list={["menu-item", { active: isCurrentPage(item.href) }]}
                                                                data-preview={item.shot === undefined ? undefined : item.href}
                                                                target={item.external ? "_blank" : undefined}
                                                                rel={item.external ? "noopener" : undefined}
                                                            >
                                                                <span class="menu-item-label">{item.label}</span>
                                                                <span class="menu-item-blurb">{item.description}</span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>

                                    {preview.length > 0 && (
                                        <div class="menu-preview">
                                            {preview.map(({ href, shot }, i) => (
                                                /* A fixed 34rem box — the menu only exists from lg up, so
                                                   this is one width, not a viewport formula. The rail asks
                                                   for 170% below, but Tailwind's `img { max-width: 100% }`
                                                   holds it to the box, and `sizes` follows what paints. */
                                                <Image
                                                    src={shotAsset(shot.name)}
                                                    alt={shot.alt}
                                                    widths={SHOT_WIDTHS}
                                                    sizes="544px"
                                                    loading="lazy"
                                                    decoding="async"
                                                    class:list={["menu-preview-shot", { current: i === 0 }]}
                                                    data-preview-for={href}
                                                />
                                            ))}
                                        </div>
                                    )}

                                    {entry.action && (
                                        <a
                                            class="menu-action"
                                            href={entry.action.href}
                                            target={entry.action.external ? "_blank" : undefined}
                                            rel={entry.action.external ? "noopener" : undefined}
                                        >
                                            {entry.action.label}{" "}
                                            {entry.action.external ? <ExternalIcon /> : <span aria-hidden="true">→</span>}
                                        </a>
                                    )}
                                </div>
                            </li>
                        );
                    }

                    if (entry.type === "link") {
                        return (
                            <li class="nav-item">
                                <a
                                    href={entry.href}
                                    class:list={["nav-link", { active: isActive(entry) }]}
                                    target={entry.external ? "_blank" : undefined}
                                    rel={entry.external ? "noopener" : undefined}
                                >
                                    {entry.label}
                                    {entry.external && <ExternalIcon />}
                                </a>
                            </li>
                        );
                    }
                })
            }

            <li class="nav-item">
                <a
                    href={githubUrl}
                    target="_blank"
                    rel="noopener"
                    class="nav-link"
                    aria-label="GitHub repository"
                >
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                        <path
                            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                        />
                    </svg>
                </a>
            </li>

            <li>
                <a class="btn btn-primary ml-2" href={APP_URL}>Get started free</a>
            </li>
        </ul>
    </div>
</nav>

<MobileNav />

<style>
    /* ── Nav base ──────────────────────────────────────── */
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
    }
    .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-muted);
        border-radius: 2px;
        transition:
            transform 0.3s,
            opacity 0.3s;
    }
    .hamburger.active span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .hamburger.active span:nth-child(2) {
        opacity: 0;
    }
    .hamburger.active span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Nav items ─────────────────────────────────────── */
    .nav-item {
        position: relative;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-muted);
        padding: 8px 14px;
        border-radius: 8px;
        transition:
            color 0.2s,
            background 0.2s;
        cursor: pointer;
        background: none;
        border: none;
        font-family: inherit;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-link.active {
        color: var(--color-content);
    }

    .nav-link:hover {
        color: var(--color-content);
        background: var(--color-overlay);
    }

    /* ── Chevron ────────────────────────────────────────── */
    .chevron {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        margin-top: 1px;
    }

    .has-menu.open .chevron {
        transform: rotate(180deg);
    }

    /* ── Mega-menu panel ───────────────────────────────────
       One panel shape for both menus: a grid of labelled sections, an optional screenshot rail, and one
       action at the foot. It is centred under its trigger and clamped to the viewport, so the Product panel
       (wide, with a preview) and the Docs panel (four narrow shelves) both stay on screen at 1024px. */
    .menu-panel {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        display: grid;
        grid-template-areas: "sections" "action";
        gap: 4px;
        width: max-content;
        max-width: min(94vw, 78rem);
        /* Opaque, not "nearly": the panel sits over the hero's white 3xl heading, and on a canvas this dark
           even 3% bleed lifts that text ~8/255 — which the blur then spreads into a legible ghost across the
           menu. The translucency belongs to the nav BAR, which content is meant to scroll under; a menu has
           to be readable. Nothing behind it means backdrop-filter buys only a compositing layer. */
        background: var(--color-canvas);
        border: 1px solid var(--color-line);
        border-top: 2px solid var(--color-link);
        border-radius: 14px;
        padding: 14px;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.22s,
            transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.4),
            0 0 0 1px color-mix(in srgb, var(--color-link) 8%, transparent),
            0 0 40px color-mix(in srgb, var(--color-link) 4%, transparent);
    }

    .menu-panel.has-preview {
        grid-template-areas:
            "sections preview"
            "action   preview";
        grid-template-columns: minmax(0, 1fr) 34rem;
        gap: 4px 18px;
    }

    /* Open is a class, never `:hover` or `:focus-within`. Two panels could be up at once while CSS decided
       this on its own: a click left the trigger focused, :focus-within pinned that panel, and the next
       hover opened its neighbour's. One class, set in one place, cannot say yes twice. */
    .has-menu.open .menu-panel {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    /* The open trigger keeps the hover look while the pointer is down inside the panel, so the menu on
       screen always has exactly one lit label it belongs to. */
    .has-menu.open > .nav-link {
        color: var(--color-content);
        background: var(--color-overlay);
    }

    .menu-sections {
        grid-area: sections;
        display: grid;
        grid-template-columns: repeat(var(--menu-columns, 2), minmax(11rem, 1fr));
        gap: 4px 10px;
    }

    .menu-section > ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .menu-section-label {
        padding: 6px 12px;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .menu-item {
        display: block;
        padding: 8px 12px;
        border-radius: 9px;
        text-decoration: none;
        transition:
            background 0.15s,
            color 0.15s;
    }

    .menu-item-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-content);
    }

    .menu-item-blurb {
        display: block;
        margin-top: 2px;
        max-width: 15rem;
        font-size: 0.75rem;
        line-height: 1.35;
        color: var(--color-subtle);
    }

    .menu-item:hover,
    .menu-item:focus-visible {
        background: color-mix(in srgb, var(--color-link) 10%, transparent);
        outline: none;
    }

    .menu-item:hover .menu-item-blurb,
    .menu-item:focus-visible .menu-item-blurb {
        color: var(--color-muted);
    }

    .menu-item.active {
        background: color-mix(in srgb, var(--color-content) 6%, transparent);
    }

    .menu-item.active .menu-item-label {
        color: var(--color-link);
    }

    /* The rail: every product shot stacked, one visible. Cropped to a wide strip — the panel is selling the
       surface at a glance, and the whole 1240px-tall board would shrink to nothing here. It is 34rem because
       the shots are 1072 CSS px of real interface: a rail much narrower than that renders the app's own text
       too small to read, which is all a preview has to do. */
    .menu-preview {
        grid-area: preview;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--color-line);
        border-radius: 10px;
        background: var(--color-card);
        aspect-ratio: 16 / 10;
    }

    /* Zoomed to its top-left corner rather than fitted: a whole surface scaled to fit the rail is a grey
       rectangle, while its first lanes are recognisably the screen the row leads to. 170% of a 34rem rail is
       ~925px of a 1072px-wide shot — near enough to native that the lane headers and card titles read. */
    .menu-preview-shot {
        position: absolute;
        top: 0;
        left: 0;
        width: 170%;
        height: auto;
        opacity: 0;
        transition: opacity 0.18s ease;
    }

    .menu-preview-shot.current {
        opacity: 1;
    }

    .menu-action {
        grid-area: action;
        margin-top: 6px;
        border-top: 1px solid var(--color-line);
        padding: 12px 12px 4px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-link);
        text-decoration: none;
    }

    .menu-action:hover {
        text-decoration: underline;
    }

    /* ── Responsive ────────────────────────────────────── */
    @media (width < 64rem) {
        .hamburger {
            display: flex;
        }
        .links {
            display: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("mobile-nav-open");
        const overlay = document.getElementById("mobile-nav-overlay");

        toggle?.addEventListener("click", () => {
            const isOpen = overlay?.classList.toggle("open");
            toggle.classList.toggle("active", isOpen);
            toggle.setAttribute("aria-expanded", String(!!isOpen));
            document.body.style.overflow = isOpen ? "hidden" : "";
        });

        // ── Mega-menus: one open, ever ─────────────────────
        // Hover, click, keyboard and every way of dismissing all go through openMenu, which closes the
        // others as it opens one. CSS deciding this by itself is what allowed two at a time.
        const menuItems = [...document.querySelectorAll(".nav-item.has-menu")];

        const openMenu = (item) => {
            menuItems.forEach((menuItem) => {
                const isOpen = menuItem === item;
                menuItem.classList.toggle("open", isOpen);
                menuItem.querySelector(".nav-link")?.setAttribute("aria-expanded", String(isOpen));
            });
        };

        menuItems.forEach((item) => {
            const trigger = item.querySelector(".nav-link");

            // Touch has no hovering: a tap fires pointerenter and click together, which would open the
            // panel and shut it again in one gesture. There the click below is the whole interaction.
            item.addEventListener("pointerenter", (event) => {
                if (event.pointerType !== "touch") openMenu(item);
            });

            // Leaving closes — unless the keyboard is inside the panel, in which case a stray mouse
            // movement must not yank the rows out from under whoever is tabbing through them.
            item.addEventListener("pointerleave", (event) => {
                const keyboardInside = item.contains(document.activeElement) && document.activeElement !== trigger;
                if (event.pointerType !== "touch" && !keyboardInside) openMenu(null);
            });

            // The trigger is a disclosure button: pressing it opens what is closed and closes what is open,
            // which is also how a touch device gets rid of a panel it opened.
            trigger?.addEventListener("click", () => {
                openMenu(item.classList.contains("open") ? null : item);
            });

            // Tabbing past the last row closes the panel; moving between its own rows does not. Only an
            // item that is itself open may close on this: pressing a trigger pulls focus off its
            // neighbour, and a neighbour that closed the menu there would blink it shut under the press.
            item.addEventListener("focusout", (event) => {
                if (item.classList.contains("open") && !item.contains(event.relatedTarget)) openMenu(null);
            });
        });

        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            const open = menuItems.find((item) => item.classList.contains("open"));
            if (!open) return;
            openMenu(null);
            open.querySelector(".nav-link")?.focus();
        });

        // Anything pressed outside the menus — the page, a plain nav link — is a dismissal.
        document.addEventListener("pointerdown", (event) => {
            if (!event.target?.closest?.(".nav-item.has-menu")) openMenu(null);
        });

        // The preview rail follows the hovered row. Pointer only: on a touch screen the panel opens on tap
        // and the rail just shows the first shot, which is the one the panel is already about.
        document.querySelectorAll(".menu-panel.has-preview").forEach((panel) => {
            const shots = panel.querySelectorAll(".menu-preview-shot");
            const show = (href) => {
                shots.forEach((shot) => shot.classList.toggle("current", shot.dataset.previewFor === href));
            };
            panel.querySelectorAll("[data-preview]").forEach((item) => {
                item.addEventListener("pointerenter", () => show(item.dataset.preview));
                item.addEventListener("focus", () => show(item.dataset.preview));
            });
        });
    });
</script>
