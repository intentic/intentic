---
/* The bar starts transparent and lifts after the page scrolls. Its menus open on one shared sheet of lacquer below it. */
import { getImage } from "astro:assets";
import { deskLanding } from "@intentic/site-content/landing";
import { type MenuItem, navEntries } from "@intentic/site-content/nav";
import { APP_URL, DESK_PATH, discordUrl, githubUrl } from "@intentic/site-content/site";
import { GITHUB_MARK } from "../lib/marks";
import { isCurrentRow, isCurrentSection } from "../lib/navCurrent";
import { shotPair } from "../lib/shots";
import Bullet from "./Bullet.astro";
import DiscordIcon from "./DiscordIcon.astro";
import DownloadCta from "./DownloadCta.astro";
import Lotus from "./Lotus.astro";
import MobileNav from "./MobileNav.astro";
import NavNiche from "./NavNiche.astro";

// Which product's page this bar sits on. The mark leads home to that product, and the bar's one action is that
// product's door: the install for a developer, the app for the desk. A shared page (docs, pricing) is the
// developer's by default; the pre-paint script (lib/variant.ts) points a desk reader's mark at /desk/ instead.
interface Props {
    product?: "default" | "desk";
    /** The page carries the same action above the fold. The bar's copy starts hidden and the page's script reveals it
     * once the page's own has scrolled away — rendered here rather than set on load, or the button flashes once. */
    ctaManaged?: boolean;
}

const { product = "default", ctaManaged = false } = Astro.props;
const home = product === "desk" ? DESK_PATH : "/";
const currentPath = Astro.url.pathname;

// THE PREVIEW WINDOW. A menu whose rows carry a shot (Features) shows the hovered row's screen beside the list. Its
// pictures are URLs, not <Image>s, on purpose: the sheet is on every page, and an <img> with a src would be fetched by
// every page view. The script hands them their src on the reader's first approach to the bar instead.
// The window is 21rem by about 19rem and the shot COVERS it, so a wide shot is drawn wider than the window: each one's
// rungs and `sizes` come from how wide it is actually drawn, never past the capture's own width.
const WINDOW = { width: 336, height: 304 };
const previewSource = async (src: ImageMetadata) => {
    const drawn = Math.round(Math.max(WINDOW.width, (WINDOW.height * src.width) / src.height));
    const widths = [...new Set([drawn, drawn * 2].map((width) => Math.min(width, src.width)))];
    const image = await getImage({ src, widths, format: "webp" });
    return { src: image.src, srcset: image.srcSet.attribute, sizes: `${drawn}px` };
};
const previewOf = async (item: MenuItem) => {
    if (item.shot === undefined) {
        return undefined;
    }
    const pair = shotPair(item.shot.name);
    const [dark, light] = await Promise.all([previewSource(pair.dark), previewSource(pair.light)]);
    return { href: item.href, dark, light };
};
const previews = await Promise.all(
    navEntries.map(async (entry) => {
        if (entry.type !== "menu") {
            return [];
        }
        const shots = await Promise.all(entry.sections.flatMap((section) => section.items).map(previewOf));
        return shots.filter((shot) => shot !== undefined);
    }),
);
// The window opens on the page you are reading when it is one of the rows, and on the first row otherwise.
const shownPreview = (index: number): string | undefined => {
    const entry = navEntries[index];
    const rows = entry?.type === "menu" ? entry.sections.flatMap((section) => section.items) : [];
    const here = rows.find((item) => item.shot !== undefined && isCurrentRow(item, currentPath));
    return here?.href ?? previews[index]?.[0]?.href;
};
---

<header class="bar" id="site-bar" data-cta-managed={ctaManaged ? "" : undefined}>
    {/* The gold leaf every menu glyph is laid in, defined once for the bar and the phone sheet. Its stops read the
        skin's tokens, so the same gradient is gold on lacquer and burnt orange on paper. Sized to nothing rather than
        `display: none`, which some engines treat as having no gradient to paint with. */}
    <svg class="gilt-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="nav-gilt" gradientUnits="userSpaceOnUse" x1="0" y1="2" x2="0" y2="22">
                <stop offset="0" style="stop-color: var(--role-glyph-gilt-1)" />
                <stop offset="0.5" style="stop-color: var(--role-glyph-gilt-2)" />
                <stop offset="1" style="stop-color: var(--role-glyph-gilt-3)" />
            </linearGradient>
        </defs>
    </svg>

    <div class="bar-inner">
        <a href={home} class="brand lockup" aria-label="intentic" data-brand>
            <Lotus size="lg" class="brand-mark" />
            <span class="wordmark">intentic</span>
        </a>

        <nav class="bar-links" aria-label="Main">
            {
                navEntries.map((entry, index) =>
                    entry.type === "link" ? (
                        <a
                            href={entry.href}
                            class:list={["bar-link", { active: isCurrentSection(entry, currentPath) }]}
                            aria-current={isCurrentSection(entry, currentPath) ? "page" : undefined}
                        >
                            {entry.label}
                        </a>
                    ) : (
                        <div class="menu" data-menu>
                            <button
                                type="button"
                                class:list={["bar-link", "menu-trigger", { active: isCurrentSection(entry, currentPath) }]}
                                aria-expanded="false"
                                aria-controls={`bar-menu-${index}`}
                            >
                                {entry.label}
                                <svg class="chev" width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" />
                                </svg>
                            </button>

                            {/* Menu chrome stays fixed while its body moves into the shared flyout. */}
                            <div class="menu-panel">
                                <div class="menu-panel-body" id={`bar-menu-${index}`}>
                                    <div class:list={["menu-main", { "menu-main--preview": (previews[index]?.length ?? 0) > 0 }]}>
                                        <div class="menu-rows" style={`--menu-cols:${entry.sections.length}`}>
                                            {entry.sections.map((section) => (
                                                <div class="menu-section">
                                                    {section.label && <div class="eyebrow eyebrow-bare menu-section-label">{section.label}</div>}
                                                    <ul>
                                                        {section.items.map((item) => (
                                                            <li>
                                                                <a
                                                                    href={item.href}
                                                                    class:list={[
                                                                        "menu-item",
                                                                        { current: isCurrentRow(item, currentPath), "menu-item--flat": !item.description },
                                                                    ]}
                                                                    aria-current={isCurrentRow(item, currentPath) ? "page" : undefined}
                                                                    target={item.external ? "_blank" : undefined}
                                                                    rel={item.external ? "noopener" : undefined}
                                                                    data-preview={item.shot ? item.href : undefined}
                                                                >
                                                                    <NavNiche icon={item.icon} />
                                                                    <span class="menu-item-text">
                                                                        <span class="menu-item-label">{item.label}</span>
                                                                        {item.description && <span class="menu-item-blurb">{item.description}</span>}
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            ))}
                                        </div>

                                        {(previews[index]?.length ?? 0) > 0 && (
                                            <div class="menu-preview" aria-hidden="true">
                                                <div class="menu-preview-window">
                                                    {previews[index]?.map((shot) => (
                                                        <div
                                                            class="menu-preview-shot"
                                                            data-preview={shot.href}
                                                            data-shown={shot.href === shownPreview(index) ? "" : undefined}
                                                        >
                                                            <img
                                                                class="shot-dark"
                                                                alt=""
                                                                sizes={shot.dark.sizes}
                                                                loading="lazy"
                                                                decoding="async"
                                                                data-preview-src={shot.dark.src}
                                                                data-preview-srcset={shot.dark.srcset}
                                                            />
                                                            <img
                                                                class="shot-light"
                                                                alt=""
                                                                sizes={shot.light.sizes}
                                                                loading="lazy"
                                                                decoding="async"
                                                                data-preview-src={shot.light.src}
                                                                data-preview-srcset={shot.light.srcset}
                                                            />
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                    </div>

                                    {entry.action && (
                                        <a
                                            href={entry.action.href}
                                            class="menu-action"
                                            target={entry.action.external ? "_blank" : undefined}
                                            rel={entry.action.external ? "noopener" : undefined}
                                        >
                                            <Bullet />
                                            {entry.action.label}
                                            <svg class="menu-action-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M4 12h15 M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    ),
                )
            }

            {/* The shared dock is present in markup so Astro scopes its styles. The finial is the lozenge set into the
                sheet's top edge; it rides under whichever trigger the sheet belongs to. */}
            <div class="flyout">
                <div class="flyout-shift">
                    <span class="flyout-finial" aria-hidden="true"></span>
                    <div class="flyout-surface"></div>
                </div>
            </div>
        </nav>

        <div class="bar-end">
            <a href={githubUrl} target="_blank" rel="noopener" class="bar-icon" aria-label="GitHub repository" title="GitHub repository">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d={GITHUB_MARK}></path></svg>
            </a>
            <a href={discordUrl} target="_blank" rel="noopener" class="bar-icon" aria-label="Discord community" title="Discord community">
                <DiscordIcon size={18} />
            </a>
            {
                product === "desk" ? (
                    <a href={APP_URL} class="btn btn-primary btn-sm bar-cta">
                        {deskLanding.hero.actions.browser}
                    </a>
                ) : (
                    <DownloadCta primary class="btn-sm bar-cta" icon={false} />
                )
            }

            <button class="hamburger" id="mobile-nav-open" aria-label="Toggle navigation" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

{/* Nothing reveals the managed CTA without the observer, so a reader without scripts keeps it. `!important` is what
    clears the scoped rule above, which carries the compiler's own attribute and so outweighs this selector. */}
<noscript>
    <style>
        .bar[data-cta-managed] .bar-cta {
            opacity: 1 !important;
            transform: none !important;
            pointer-events: auto !important;
        }
    </style>
</noscript>

<MobileNav product={product} />

<script>
    /* The navigation remains usable when this enhancement script is unavailable. */

    /* All menu bodies share one surface below the bar. */
    const links = document.querySelector<HTMLElement>(".bar-links");
    const menus = [...document.querySelectorAll<HTMLElement>("[data-menu]")];

    type Menu = { menu: HTMLElement; trigger: HTMLElement; page: HTMLElement };
    const items: Menu[] = [];
    for (const menu of menus) {
        const trigger = menu.querySelector<HTMLElement>(".menu-trigger");
        const page = menu.querySelector<HTMLElement>(".menu-panel-body");
        if (trigger && page) {items.push({ menu, trigger, page });}
    }

    /* A preview window shows the row under the pointer or focus, and keeps the last one when the pointer moves on. */
    for (const { page } of items) {
        const shots = [...page.querySelectorAll<HTMLElement>(".menu-preview-shot")];
        if (shots.length === 0) {continue;}
        for (const row of page.querySelectorAll<HTMLElement>(".menu-item[data-preview]")) {
            const pick = () => {
                for (const shot of shots) {shot.toggleAttribute("data-shown", shot.dataset.preview === row.dataset.preview);}
            };
            row.addEventListener("pointerenter", pick);
            row.addEventListener("focus", pick);
        }
    }

    /* The window's pictures are fetched on the first approach to the bar, never by the page load itself. Only the
       skin's own copy of each is fetched: the other twin is `display: none`, and a hidden lazy image never loads. */
    let warmed = false;
    const warm = () => {
        if (warmed) {return;}
        warmed = true;
        for (const img of document.querySelectorAll<HTMLImageElement>("img[data-preview-src]")) {
            img.srcset = img.dataset.previewSrcset ?? "";
            img.src = img.dataset.previewSrc ?? "";
        }
    };
    links?.addEventListener("pointerenter", warm, { once: true });
    links?.addEventListener("focusin", warm, { once: true });

    const flyout = document.querySelector<HTMLElement>(".flyout");
    const surface = document.querySelector<HTMLElement>(".flyout-surface");

    if (links && flyout && surface && items.length > 0) {
        /* Switching menus is instant; opening from closed uses a delay. */
        const OPEN_DELAY = 90;
        const CLOSE_GRACE = 140;
        const DRIFT_MS = 340;

        // Enhanced navigation disables the per-menu hover panels.
        links.setAttribute("data-enhanced", "");

        for (const item of items) {
            item.page.classList.add("flyout-page");
            surface.append(item.page);
            item.menu.querySelector(".menu-panel")?.remove();
        }

        // The open value is a complete menu; its index is only for travel direction.
        let open: Menu | null = null;
        let leaving: HTMLElement | null = null;
        let openTimer = 0;
        let closeTimer = 0;
        let driftTimer = 0;
        const idle = () => {
            window.clearTimeout(openTimer);
            window.clearTimeout(closeTimer);
        };

        /* The flyout is positioned from the trigger and clamped to the viewport; the finial stays under the trigger
           even where the clamp has pushed the sheet off-centre. */
        const place = (item: Menu) => {
            const nav = links.getBoundingClientRect();
            const label = item.trigger.getBoundingClientRect();
            const size = item.page.getBoundingClientRect();
            const edge = 12;
            const centre = label.left + label.width / 2;
            const room = Math.max(edge, window.innerWidth - edge - size.width);
            const x = Math.min(Math.max(centre - size.width / 2, edge), room);
            flyout.style.setProperty("--fx", `${Math.round(x - nav.left)}px`);
            flyout.style.setProperty("--fa", `${Math.round(centre - x)}px`);
            surface.style.setProperty("--fw", `${Math.round(size.width)}px`);
            surface.style.setProperty("--fh", `${Math.round(size.height)}px`);
        };

        const light = (i: number) => {
            for (const [n, item] of items.entries()) {
                item.menu.toggleAttribute("data-open", n === i);
                item.trigger.setAttribute("aria-expanded", String(n === i));
                item.page.toggleAttribute("data-active", n === i);
            }
        };

        const show = (i: number) => {
            idle();
            const next = items[i];
            if (!next || next === open) {return;}
            warm();
            // Content drifts toward the next menu; a cold open only rises.
            flyout.style.setProperty("--dir", String(open ? Math.sign(i - items.indexOf(open)) : 0));

            window.clearTimeout(driftTimer);
            leaving?.removeAttribute("data-leaving");
            leaving = null;
            if (open) {
                leaving = open.page;
                leaving.setAttribute("data-leaving", "");
                driftTimer = window.setTimeout(() => {
                    leaving?.removeAttribute("data-leaving");
                    leaving = null;
                }, DRIFT_MS);
                place(next);
                light(i);
            } else {
                /* Closed panels appear at their trigger without sliding. */
                flyout.setAttribute("data-instant", "");
                place(next);
                light(i);
                void flyout.offsetWidth;
                flyout.removeAttribute("data-instant");
            }
            open = next;
            flyout.setAttribute("data-open", "");
        };

        /* Focus restoration is guarded so its own focus event does not reopen the menu. */
        let restoring = false;
        const restore = (el: HTMLElement) => {
            restoring = true;
            el.focus();
            restoring = false;
        };

        /* Closing keeps the last body active while the surface fades. */
        const hide = () => {
            idle();
            if (!open) {return;}
            const home = open.trigger;
            const holding = open.page.contains(document.activeElement);
            open = null;
            flyout.removeAttribute("data-open");
            for (const item of items) {
                item.menu.removeAttribute("data-open");
                item.trigger.setAttribute("aria-expanded", "false");
            }
            if (holding) {restore(home);}
        };

        for (const link of links.querySelectorAll<HTMLElement>(".bar-link")) {
            const i = items.findIndex((item) => item.trigger === link);
            link.addEventListener("pointerenter", (event) => {
                if (event.pointerType !== "mouse") {return;}
                idle();
                // Hovering a plain destination closes the menu.
                if (i === -1) {
                    hide();
                } else if (!open) {
                    openTimer = window.setTimeout(() => show(i), OPEN_DELAY);
                } else {
                    show(i);
                }
            });
        }
        flyout.addEventListener("pointerenter", (event) => {
            if (event.pointerType === "mouse") {idle();}
        });
        links.addEventListener("pointerleave", (event) => {
            if (event.pointerType !== "mouse") {return;}
            idle();
            // Pointer movement does not close a panel while focus remains inside it.
            if (items.some((item) => item.page.contains(document.activeElement))) {return;}
            closeTimer = window.setTimeout(hide, CLOSE_GRACE);
        });

        // Click opens a menu for touch and keyboard users.
        for (const [i, item] of items.entries()) {
            item.trigger.addEventListener("click", (event) => {
                event.preventDefault();
                if (open === item) {
                    hide();
                } else {
                    show(i);
                }
            });
        }

        links.addEventListener("focusin", (event) => {
            const target = event.target as HTMLElement | null;
            if (!target || restoring) {return;}
            const i = items.findIndex((item) => item.trigger === target);
            if (i !== -1) {
                /* Click handlers open menus; focus alone does not toggle them closed. */
                if (target.matches(":focus-visible")) {show(i);}
                return;
            }
            // Focus inside the panel keeps it; other bar links close it.
            if (!items.some((item) => item.page.contains(target))) {hide();}
        });
        links.addEventListener("focusout", (event) => {
            const next = event.relatedTarget as Node | null;
            if (!next || !links.contains(next)) {hide();}
        });

        /* Tab navigation must cross the shared dock before leaving the bar. */
        links.addEventListener("keydown", (event) => {
            if (!open) {return;}
            if (event.key !== "Tab" && event.key !== "ArrowDown") {return;}
            const { trigger, page } = open;
            const rows = [...page.querySelectorAll<HTMLElement>("a[href]")];
            const target = event.target as HTMLElement | null;
            const first = rows[0];
            if (!target || !first) {return;}

            const into = event.key === "ArrowDown" || (event.key === "Tab" && !event.shiftKey);
            if (target === trigger && into) {
                event.preventDefault();
                first.focus();
                return;
            }
            if (event.key !== "Tab" || !page.contains(target)) {return;}
            const at = rows.indexOf(target);
            if (event.shiftKey && at === 0) {
                event.preventDefault();
                trigger.focus();
                return;
            }
            if (!event.shiftKey && at === rows.length - 1) {
                const bar = [...links.querySelectorAll<HTMLElement>(".bar-link")];
                const next = bar[bar.indexOf(trigger) + 1];
                if (!next) {return;}
                // Focus handling closes or switches the panel.
                event.preventDefault();
                next.focus();
            }
        });
        document.addEventListener("pointerdown", (event) => {
            if (!links.contains(event.target as Node | null)) {hide();}
        });
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || !open) {return;}
            const trigger = open.trigger;
            hide();
            restore(trigger);
        });
        // Resize invalidates the dock measurement, so it closes.
        window.addEventListener("resize", hide);
    }

    /* The bar lifts after scrolling past the top plate. */
    const bar = document.getElementById("site-bar");
    if (bar) {
        const lift = () => bar.toggleAttribute("data-lifted", window.scrollY > 40);
        // Reading scrollY while the page is still being built forces a full layout (the flyout above has just moved
        // nodes), so the first read waits for the first frame to have laid out; a restored scroll fires `scroll` anyway.
        requestAnimationFrame(() => setTimeout(lift));
        window.addEventListener("scroll", lift, { passive: true });
    }

    /* The hamburger opens an overlay that owns its internal navigation. */
    const toggle = document.getElementById("mobile-nav-open");
    const overlay = document.getElementById("mobile-nav-overlay");
    toggle?.addEventListener("click", () => {
        const open = overlay?.classList.toggle("open") ?? false;
        toggle.classList.toggle("active", open);
        toggle.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
    });
</script>

<style>
    /* The navigation bar keeps one shared height and surface on every page. */
    .bar {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        z-index: 100;
        background: transparent;
        transition: background-color 0.3s ease;
    }
    .bar[data-lifted] {
        background: var(--role-bar-fill);
        backdrop-filter: blur(14px) saturate(1.15);
    }
    /* The bar's foot is a gilt hairline that fades out toward both ends, brightest under the links it carries. */
    .bar::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: -1px;
        left: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--color-line-strong) 16%,
            var(--color-line-bright) 50%,
            var(--color-line-strong) 84%,
            transparent
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }
    .bar[data-lifted]::after {
        opacity: 1;
    }
    .gilt-defs {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
    }

    .bar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        max-width: 84rem;
        margin: 0 auto;
        padding: 0 1.5rem;
        min-height: var(--bar-height);
    }

    /* The brand lockup aligns the flower with the lettering, not the boxes. */
    .brand {
        --wordmark-size: 1.85rem;
        flex: none;
    }
    .wordmark {
        text-shadow: var(--role-bar-glow);
    }

    /* Relative positioning anchors the shared flyout. */
    .bar-links {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }
    /* The wordmark uses the site's title face. */
    .bar-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.7rem;
        border: 0;
        background: none;
        font-family: var(--font-mark);
        font-weight: var(--font-weight-semibold);
        font-size: 1rem;
        letter-spacing: 0.004em;
        color: var(--color-content);
        text-decoration: none;
        opacity: 0.86;
        cursor: pointer;
        transition:
            color 0.2s ease,
            opacity 0.2s ease;
    }
    /* The pointer warms a link to ember, the site's hover; the section you are in is state, so it wears the accent and
       keeps it under the pointer (_editor/ui/README.md, "One signal colour"). */
    .bar-link:hover,
    .menu[data-open] .menu-trigger {
        color: var(--color-primary-400);
        opacity: 1;
    }
    .bar-link.active,
    .bar-link.active:hover {
        color: var(--color-gold-bright);
        opacity: 1;
    }
    /* The section you are in also carries the house's mark for "you are standing here": an ember lozenge, lit. */
    .bar-link.active::after {
        content: "";
        position: absolute;
        bottom: 0.05rem;
        left: 50%;
        width: 5px;
        height: 5px;
        background: var(--color-primary-500);
        filter: var(--house-ember-mark-glow);
        transform: translateX(-50%) rotate(45deg);
    }
    .chev {
        opacity: 0.7;
        transition:
            transform 0.24s ease,
            opacity 0.2s ease;
    }
    /* The chevron follows the OPEN menu, not the hovered one — with the script running, hover opens. */
    .menu[data-open] .chev,
    .bar-links:not([data-enhanced]) .menu:hover .chev {
        opacity: 1;
        transform: rotate(180deg);
    }

    .menu {
        position: relative;
    }

    /* THE SHEET: black lacquer with a gold-leaf edge. Two layers, because a clipped shape has no border of its own: the
       element is the gilt, and its ::before is the lacquer laid a pixel inside it. Padding is that pixel, so a body
       measured at its own size fits inside the edge rather than over it. */
    .menu-panel,
    .flyout-surface {
