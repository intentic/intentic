---
/* INTENTIC DESK, the product page at /desk/: the same assistant for the reader who does not write code. Its own
   words and pictures from the first line to the last question (site-content landing.ts `deskLanding`); the shell,
   the frames, the marks, the cost band's account list and the trust band are the parts it shares with the developer
   page (Landing.astro). Never a paragraph of that page's copy, so search never meets the same page twice. */
import { deskLanding, landingContent } from "@intentic/site-content/landing";
import { APP_URL } from "@intentic/site-content/site";
import { buildDeskAppSchema } from "@intentic/site-content/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import DeskShot from "./DeskShot.astro";
import Corners from "./Corners.astro";
import DownloadCta from "./DownloadCta.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import Band from "./landing/Band.astro";
import Economics from "./landing/Economics.astro";
import FaqList from "./landing/FaqList.astro";
import Final from "./landing/Final.astro";
import Headline from "./landing/Headline.astro";
import Station from "./landing/Station.astro";
import Tour from "./landing/Tour.astro";
import Trust from "./landing/Trust.astro";
import Workspace from "./landing/Workspace.astro";
import Window from "./Window.astro";
import "../styles/home.css";

const content = deskLanding;

const faq = content.faq.items.map((item) => ({ question: item.question, answer: item.answer.join(" ") }));


/* Hero frames share a viewport axis, so their sizes use `vw`: each shot is drawn at its frame's width (home.css), the
   centre 62% of the stack's 74rem ceiling and the wings 21%, then 56% and 25% between 48rem and 64rem. */
/* Below 48rem the frame is the column (100vw less 4rem of gutter and border) and the shot is drawn 175% / 205% of
   it, cropped (home.css), so `sizes` says the drawn width, not the viewport multiple, or a phone takes a rung too big. */
const appSizes = "(min-width: 64rem) min(62vw, 734px), (min-width: 48rem) 56vw, (min-width: 40rem) calc(175vw - 7rem), calc(205vw - 8.2rem)";
const chatSizes = "(min-width: 64rem) min(21vw, 249px), 25vw";
const planSizes = "(min-width: 64rem) min(21vw, 249px), 25vw";

---

<BaseLayout faq={faq} extraJsonLd={[buildDeskAppSchema()]} backdrop={false}>
    <div class="home flex flex-1 flex-col">
        <Nav product="desk" ctaManaged />

        <main class="flex-1">
            <section class="hero" id="hero">
                <div class="plate" aria-hidden="true">
                    <div class="plate-img"></div>
                </div>
                <div class="plate-fade" aria-hidden="true"></div>

                <div class="hero-grid">
                    <div class="hero-copy">
                        <Headline lines={content.hero.headlineLines} />

                        <p class="hero-sub">{content.hero.subhead}</p>

                        {/* Browser leads: for this reader the app is the door. The bar hides its duplicate while this row is visible. */}
                        <div class="hero-actions" data-hero-cta>
                            <a class="btn btn-primary" href={APP_URL}>{content.hero.actions.browser}</a>
                            <DownloadCta label={content.hero.actions.download} />
                        </div>

                        {/* The other product, for the reader who is in the wrong place. */}
                        <p class="hero-cross">
                            {content.crossLink.lead}{" "}
                            <a href={content.crossLink.href} class="link">{content.crossLink.label} →</a>
                        </p>
                    </div>

                    <figure class="hero-visual">
                        <div class="hero-stack">
                            <Window class="window-plan" aria-hidden="true">
                                <div class="window-crop window-crop-plan">
                                    <DeskShot name={content.hero.screens.plan.name} alt="The plan sidebar where the assistant proposes changes before editing documents" sizes={planSizes} class="screen screen-plan" />
                                </div>
                            </Window>

                            <Window class="window-app" finial>
                                <div class="window-crop window-crop-app">
                                    {
                                        content.hero.screens.app.map((screen, index) => (
                                            <DeskShot
                                                name={screen.name}
                                                alt={screen.alt}
                                                sizes={appSizes}
                                                priority={index === 0}
                                                class={`screen screen-app${index === 0 ? " is-on" : ""}`}
                                                data-screen="app"
                                                aria-hidden={index > 0 ? "true" : undefined}
                                            />
                                        ))
                                    }
                                </div>

                                {/* The press opens the desk recording: the same app on documents, not the code one. */}
                                <a class="play" href={content.hero.demoHref}>
                                    <span class="btn btn-sm">
                                        <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                                        <span>{landingContent.hero.demo.playLabel}</span>
                                    </span>
                                </a>
                            </Window>

                            <Window class="window-chat" aria-hidden="true">
                                <div class="window-crop window-crop-chat">
                                    <DeskShot name={content.hero.screens.chat.name} alt="A conversation with the assistant about a document task" sizes={chatSizes} class="screen screen-chat" />
                                </div>
                            </Window>
                        </div>
                    </figure>
                </div>
            </section>

            <!-- The tour: one screenful per row, the same five feature pages the developer page links, in this reader's words. -->
            <Tour content={content.tour} desk />

            <!-- What you get to look at, against a chat box. -->
            <Workspace content={content.workspace} cta={content.workspace.cta} />

            <!-- The cost model: this page's words over the shared account list. -->
            <Economics content={content.economics} accountsLabel="Your AI accounts" flatLabel={content.economics.flatLabel} />

            <!-- Who builds it: shared with the developer page and /about/. -->
            <Trust />

            <!-- Getting started: the download first, and no command anywhere. -->
            <Band id="connect" intro={content.connect}>
                <div class="flow">
                    <div class="flow-zone">
                        <div class="flow-where">{content.connect.zones.computer}</div>
                        <Station step={content.connect.computerStep} />
                        <div class="hero-actions flow-actions">
                            <DownloadCta label={content.hero.actions.download} />
                        </div>
                    </div>

                    <div class="flow-seam" aria-hidden="true"></div>

                    <div class="flow-zone">
                        <div class="flow-where">{content.connect.zones.app}</div>
                        {
                            content.connect.appSteps.map((step) => (
                                <Station step={step} />
                            ))
                        }
                    </div>
                </div>

                <div class="card desktop">
                    <Corners set="diag" />
                    <div>
                        <p class="desktop-lead">{content.connect.browser.lead}</p>
                        <p class="desktop-note">{content.connect.browser.note}</p>
                    </div>
                    <a class="btn btn-primary btn-sm" href={APP_URL}>{content.connect.browser.cta}</a>
                </div>
            </Band>

            <!-- This page's own questions; native details for keyboard and screen-reader behavior. -->
            <Band id="faq" intro={{ ...content.faq, sub: content.faq.lede }}>
                <div class="faq faq-single">
                    <div class="faq-group" id="desk-questions">
                        <FaqList items={content.faq.items} groupId="desk-questions" />
                    </div>
                </div>
            </Band>

            <!-- Closing cartouche returns the plate at the page end. -->
            <Final>
                <Fragment slot="description">Yours to keep, on your own computer,<br />with nothing to pay us.</Fragment>
                <a class="btn btn-primary" href={APP_URL}>{content.hero.actions.browser}</a>
            </Final>
        </main>

        <Footer />
    </div>

    <script>
        import { observeHeroCta } from "./landing/hero-cta";

        observeHeroCta();

        /* One app frame is visible at a time. */
        const screens = [...document.querySelectorAll<HTMLElement>('[data-screen="app"]')];
        if (screens.length > 1) {
            let shown = 0;
            setInterval(() => {
                shown = (shown + 1) % screens.length;
                screens.forEach((screen, index) => {
                    screen.classList.toggle("is-on", index === shown);
                    screen.setAttribute("aria-hidden", index === shown ? "false" : "true");
                });
            }, 4000);
        }
    </script>
</BaseLayout>
