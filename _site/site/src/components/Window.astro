---
/* The recipe is four things and none of them is optional: a gold hairline on all four sides, a ledge one ornament deep across the top. */
import Corners from "./Corners.astro";
import Lotus from "./Lotus.astro";

interface Props {
    class?: string;
    /** A lotus astride the top rail. For a frame that leads a band; not for one of eight in a grid. */
    finial?: boolean;
    /** "all" (default), or "diag" for a frame sitting in a grid of its own kind. */
    corners?: "all" | "diag";
    href?: string;
/** The route the shot was taken on, set in the ledge. */
    label?: string;
    /** Decorative frames (a wing of a collage) are hidden from a screen reader entirely. */
    "aria-hidden"?: "true";
}

const { class: className = "", finial = false, corners = "all", href, label, "aria-hidden": ariaHidden } = Astro.props;
const Tag = href === undefined ? "div" : "a";
---

<Tag class:list={["window", className]} href={href} aria-hidden={ariaHidden}>
    <Corners set={corners} />
    {finial && <span class="finial"><Lotus size="md" /></span>}
    <div class="window-rail">
        {label && <span class="window-address">{label}</span>}
    </div>
    <slot />
</Tag>
