---
import type { DocsHeading } from "../lib/docs-headings";

/* "On this page": the list of the current page's own sections.
 *
 * THE PROBLEM IT SOLVES: the HTTP API page is about nine screens tall with eleven major sections, the manifest
 * reference is twelve field groups, and neither had any way to move inside it. Reference material is not read
 * top to bottom; someone arrives wanting "Failures" or "contributes.settings" and scrolled blind to find it.
 *
 * TWO PLACEMENTS, ONE LIST, and they are rendered at DIFFERENT POINTS IN THE PAGE, which is why this takes a
 * variant rather than deciding for itself. The rail is the grid's third column, so on a narrow screen it stacks
 * BELOW the article: a section list at the foot of a nine-screen page is worse than none, because you only reach
 * it once you no longer need it. The inline twin therefore renders inside the article, under the header, where
 * someone deciding whether to scroll is actually looking.
 *
 * The inline one is a closed <details>: on a phone an open twelve-item list is a screenful of navigation before
 * the first sentence, and <details> works with no JavaScript at all.
 *
 * SUPPRESSED UNDER THREE HEADINGS: a page with two sections has a table of contents you can already see.
 * The behaviour, including scroll-spy and anchor copying, lives in DocsLayout, which renders once per page.
 */

interface Props {
    headings: DocsHeading[];
    /** "rail" is the sticky third column (wide screens); "inline" is the collapsible block in the article. */
    variant: "rail" | "inline";
}

const { headings, variant } = Astro.props;
const worthIt = headings.length >= 3;

const rowBase = "block border-l py-1 text-xs leading-snug transition-colors";
const rowIdle = "border-line text-subtle hover:border-line-strong hover:text-content";
// Which row is current is applied by the scroll-spy script, not here: it depends on scroll position.
const indent = (heading: DocsHeading): string => (heading.level === 3 ? "pl-5" : "pl-3");
---

{
    worthIt &&
        (variant === `rail` ? (
            // `hidden xl:block`: it appears only when there is room for a third column without squeezing the
            // prose, which is the one thing on the page that must not get narrower.
            <aside class="hidden xl:block" data-docs-toc>
                {/* Same offset as the shelf rail, so the two columns line up and both get the full height. */}
                <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-2">
                    <div class="eyebrow mb-2 pl-3">On this page</div>
                    <ul class="list-none space-y-0.5 p-0">
                        {headings.map((heading) => (
                            <li>
                                <a href={`#${heading.id}`} class:list={[rowBase, indent(heading), rowIdle]} data-toc-link={heading.id}>
                                    {heading.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </aside>
        ) : (
            <details class="mb-8 rounded-lg border border-line bg-card px-4 py-3 xl:hidden">
                <summary class="cursor-pointer text-sm font-medium text-content marker:text-subtle">
                    On this page
                    <span class="ml-1 text-xs font-normal text-subtle">({headings.length} sections)</span>
                </summary>
                <ul class="mt-3 list-none space-y-1 border-t border-line p-0 pt-3">
                    {headings.map((heading) => (
                        <li>
                            <a
                                href={`#${heading.id}`}
                                class:list={["block text-sm text-muted transition-colors hover:text-link", heading.level === 3 && "pl-4"]}
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        ))
}
