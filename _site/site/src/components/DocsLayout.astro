---
import { type Book, bookHref, bookNeighbours, bookPage } from "@intentic-dev/site-content/book";
import { docsBook } from "@intentic-dev/site-content/docs";
import { assertNoCodeBleed, extractDocsContent } from "../lib/docs-headings";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSearch from "./DocsSearch.astro";
import DocsSearchField from "./DocsSearchField.astro";
import DocsSidebar from "./DocsSidebar.astro";
import DocsToc from "./DocsToc.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
    /**
     * Which book this page belongs to. Omitted means /docs, which is most of them; the authoring pages pass
     * apiBook. It decides the rail, the breadcrumb root and which shelf previous/next walks: everything that
     * would otherwise have to be repeated per page and could therefore disagree with the tree.
     */
    book?: Book;
    pageId: string;
    /**
     * The page's h1. It MUST start with the page's title in the docs tree: ideally be exactly it.
     *
     * Five pages used to be called one thing in the rail and another on the page: you clicked "Updates & rollback"
     * and arrived at "Updates: what we promise never breaks", clicked "Overview" and arrived at "intentic
     * documentation". A reader cannot tell that from a mistake, and it makes the rail untrustworthy for the one
     * job it has. Three places carry the three lengths a page name needs, and none of them is this one: the tree's
     * `title` is the short name the rail, breadcrumb and previous/next use, the tree's `meta.title` is the
     * descriptive form for the browser tab and search engines, and `lead` below is the sentence. Two pages append
     * a "· subtitle" here, which still reads as the same page; anything else does not.
     */
    heading: string;
    lead: string;
    /**
     * Heading ids this page links to internally: from a hand-written index table, say. Checked against the
     * headings actually rendered, so renaming a heading breaks the build instead of leaving a dead link nobody
     * notices. A dead in-page link is invisible in a screenshot and invisible in a diff; it is only visible to
     * the reader who clicks it and goes nowhere.
     */
    requireAnchors?: string[];
}

const { book = docsBook, pageId, heading, lead, requireAnchors } = Astro.props;
const page = bookPage(book, pageId);
const bookRoot = bookHref(book, "");

/* The content is RENDERED HERE rather than dropped straight into a <slot />, because both the anchors and the
 * section rail need to know what headings the page has. Rendering the slot to a string is the only place that
 * knowledge exists: the page's markup is authored per-page, and the layout is the one component that sees all of
 * it. See lib/docs-headings.ts for what the pass does and why it is not authored per heading.
 *
 * Safe to re-emit with set:html because these pages are static: no client islands anywhere under /docs/, so the
 * string is final HTML and not a hydration boundary. */
const rendered = await Astro.slots.render("default");
assertNoCodeBleed(rendered, pageId);
const { html, headings } = extractDocsContent(rendered);

const absent = (requireAnchors ?? []).filter((anchor) => !headings.some((entry) => entry.id === anchor));
if (absent.length > 0) {
    throw new Error(`${bookHref(book, pageId)}: index links to headings that do not exist: #${absent.join(`, #`)}`);
}

// The same trail the reader sees, handed to BaseLayout so the BreadcrumbList can't drift from it.
// Title, description and dates are not passed: BaseLayout resolves them from the route.
const breadcrumbs = [
    { name: book.label, path: bookRoot },
    ...(page && pageId ? [{ name: page.title, path: bookHref(book, pageId) }] : []),
];

// Shelf-scoped, so the foot of a page offers the next thing on the same shelf rather than the next of twenty.
const { section, prev, next } = bookNeighbours(book, pageId);
---

<BaseLayout breadcrumbs={breadcrumbs}>
    <Nav />
    <main class="flex-1">
        {/* Three columns where there is room for three: rail, prose, sections. The prose column is `min-w-0`
            and the outer grid caps at 96rem, so adding the third column widens the page rather than squeezing
            the column the prose sits in. */}
        <div
            class="mx-auto grid max-w-6xl gap-10 px-6 pt-28 pb-20 lg:grid-cols-[15rem_1fr] lg:gap-14 lg:pt-32 xl:max-w-[96rem] xl:grid-cols-[16rem_minmax(0,1fr)_14rem]"
        >
            <aside class="lg:relative">
                {/* Narrow screens: the rail is collapsed, so search sits beside the menu toggle rather than
                    inside the thing you would have to open to reach it. */}
                <div class="mb-4 flex items-center gap-2 lg:hidden">
                    <button
                        class="flex items-center gap-2 rounded-lg border border-line bg-card px-3.5 py-2 text-sm text-muted"
                        id="docs-sidebar-toggle"
                        aria-label="Toggle docs menu"
                        aria-expanded="false"
                    >
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                        </svg>
                        Menu
                    </button>
                    <DocsSearchField variant="compact" />
                </div>
                {/* top-20 / 6rem, not top-28 / 9rem: the fixed nav is 65px, so the old offset left 63px of dead
                    gap above the rail and reserved 144px of height for it. Twenty rows need that space: with the
                    old numbers the whole "Build on it" shelf sat below the rail's own scroll on a 1000px-tall
                    viewport, which is exactly the orientation this rewrite exists to give back. */}
                <div class="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto pb-2 lg:block" id="docs-sidebar" data-rail-scroll>
                    <DocsSidebar book={book} pageId={pageId}>
                        {/* Hidden on narrow screens: its compact twin is already in the row above, and two
                            search controls one scroll apart is a bar with no shape. */}
                        <div class="mb-6 hidden lg:block" slot="search">
                            <DocsSearchField />
                        </div>
                    </DocsSidebar>
                </div>
            </aside>

            <article class="docs-article min-w-0">
                <nav aria-label="Breadcrumb" class="mb-6 text-xs text-subtle">
                    <ol class="flex flex-wrap items-center gap-1.5 p-0">
                        <li><a href="/" class="transition-colors hover:text-link">Home</a></li>
                        <li aria-hidden="true">›</li>
                        <li><a href={bookRoot} class="transition-colors hover:text-link">{book.label}</a></li>
                        {
                            pageId && (
                                <Fragment>
                                    <li aria-hidden="true">›</li>
                                    {/* The shelf, so the trail says which part of the docs this is: the one
                                        thing a breadcrumb is for that "Docs › Page" was not doing. */}
                                    {section && (
                                        <Fragment>
                                            <li class="text-subtle">{section.label}</li>
                                            <li aria-hidden="true">›</li>
                                        </Fragment>
                                    )}
                                    <li aria-current="page" class="text-muted">
                                        {page?.title}
                                    </li>
                                </Fragment>
                            )
                        }
                    </ol>
                </nav>

                <header class="mb-10 border-b border-line pb-8">
                    {/* The book's own name is the fallback, so a page outside every shelf says "Docs" or "API"
                        rather than a generic word that belongs to neither. */}
                    <div class="eyebrow">{section?.label ?? book.label}</div>
                    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{heading}</h1>
                    <p class="mt-4 text-base leading-relaxed text-muted">{lead}</p>
                </header>

                {/* Inside the article, before the prose: the rail is the grid's third column, so on a narrow
                    screen it stacks below everything and a reader would meet the section list only after
                    scrolling the whole page.

                    Skipped on a page that authored its own index table. `requireAnchors` is exactly the signal
                    that it did, and that table is this list plus a description column: stacking both put two
                    tables of contents back to back on a phone, the second one strictly worse than the first. */}
                {requireAnchors === undefined && <DocsToc headings={headings} variant="inline" />}

                <div class="docs-body" set:html={html} />

                {
                    (prev || next) && (
                        <div class="mt-16 border-t border-line pt-8">
                            {/* Named, because shelf-scoped movement only makes sense if the reader can see which
                                shelf is being walked. */}
                            {section && <div class="eyebrow mb-4">More in {section.label}</div>}
                            <div class="flex items-stretch justify-between gap-4">
                                {prev ? (
                                    <a href={bookHref(book, prev.id)} class="group flex flex-col gap-1">
                                        <span class="eyebrow">Previous</span>
                                        <span class="text-sm font-medium text-content transition-colors group-hover:text-link">← {prev.title}</span>
                                    </a>
                                ) : (
                                    <span />
                                )}
                                {next && (
                                    <a href={bookHref(book, next.id)} class="group ml-auto flex flex-col gap-1 text-right">
                                        <span class="eyebrow">Next</span>
                                        <span class="text-sm font-medium text-content transition-colors group-hover:text-link">{next.title} →</span>
                                    </a>
                                )}
                            </div>
                        </div>
                    )
                }
            </article>

            <DocsToc headings={headings} variant="rail" />
        </div>
    </main>
    <Footer />

    {/* Outside the rail and outside <main>: a modal inside the collapsed rail cannot open on a phone. */}
    <DocsSearch />

    <script>
        const toggle = document.getElementById("docs-sidebar-toggle");
        const sidebar = document.getElementById("docs-sidebar");

        /* Tell the reader the rail continues. Twenty-seven rows do not fit a laptop viewport, and the shelf that
           falls off the bottom is the last one. So a reader who never scrolls the rail never learns that a
           quarter of the documentation exists. The CSS fades whichever edge has something behind it. */
        if (sidebar) {
            const edges = () => {
                // A pixel of slack: sub-pixel layout makes a container scrolled fully to its end report a
                // fractional gap, which would leave the fade on for ever.
                sidebar.toggleAttribute("data-overflow-top", sidebar.scrollTop > 1);
                sidebar.toggleAttribute("data-overflow-bottom", Math.ceil(sidebar.scrollTop + sidebar.clientHeight) < sidebar.scrollHeight - 1);
            };

            // Measured on open as well as load: on a phone the rail starts display:none, where it has no height
            // to overflow and every edge looks settled.
            toggle?.addEventListener("click", () => {
                const open = sidebar.classList.toggle("!block");
                toggle.setAttribute("aria-expanded", String(open));
                if (open) {
                    sidebar.querySelector('[aria-current="page"]')?.scrollIntoView({ block: "nearest" });
                    edges();
                }
            });

            /* And put the page you are on in view. The rail's job is "where am I", and on a Build-on-it page the
               marked row was below the fold. So the rail opened showing four shelves, none of them yours.
               `nearest` scrolls only when it has to, so the common case does not move. */
            sidebar.querySelector('[aria-current="page"]')?.scrollIntoView({ block: "nearest" });

            edges();
            sidebar.addEventListener("scroll", edges, { passive: true });
            // The rail's height is the viewport's, so a resize is the only other thing that changes whether it
            // overflows.
            window.addEventListener("resize", edges);
        }
    </script>

    {/* Scroll-spy for the section rail. Marks the section whose heading last crossed the top of the reading area,
        so the rail answers "where am I" and not just "what is here". IntersectionObserver rather than a scroll
        handler: it reports only when a boundary is crossed instead of on every frame.

        The rootMargin's top is the sticky header's height plus a little, and its bottom is -70% of the viewport,
        so the "current" band is a strip near the top of the reading area. Without that, three headings sit on
        screen at once near the foot of a short section and the highlight flickers between them.

        It lives here rather than in DocsToc because the rail and its inline twin are two renders of one list :
        the behaviour belongs to the page, which this component is exactly one of. */}
    <script>
        const links = new Map<string, HTMLElement>();
        for (const link of document.querySelectorAll<HTMLElement>("[data-toc-link]")) {
            const id = link.dataset.tocLink;
            if (id) links.set(id, link);
        }

        if (links.size > 0) {
            const ACTIVE = ["border-primary-500", "text-content"];
            const IDLE = ["border-line", "text-subtle"];
            const visible = new Set<string>();
            let current = "";

            const paint = (id: string) => {
                if (id === current) return;
                const previous = current === "" ? undefined : links.get(current);
                previous?.classList.remove(...ACTIVE);
                previous?.classList.add(...IDLE);
                const next = links.get(id);
                next?.classList.remove(...IDLE);
                next?.classList.add(...ACTIVE);
                current = id;
            };

            // Document order, so "the first one still in the band" is well defined.
            const order = [...links.keys()];
            const settle = () => {
                const first = order.find((id) => visible.has(id));
                // Nothing in the band means we are mid-section: keep whatever was last marked rather than
                // clearing, which would leave the rail blank through the longest sections.
                if (first) paint(first);
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        const id = entry.target.id;
                        if (entry.isIntersecting) visible.add(id);
                        else visible.delete(id);
                    }
                    settle();
                },
                { rootMargin: "-100px 0px -70% 0px", threshold: 0 },
            );

            for (const id of order) {
                const heading = document.getElementById(id);
                if (heading) observer.observe(heading);
            }

            // First paint: before any scrolling the reader is at the top, so mark the first section.
            paint(order[0] ?? "");
        }
    </script>

    {/* Copy-link behaviour for the anchor beside every heading. The anchor is a real <a href="#id"> and works
        without this; the handler adds "clicking it puts the full URL on your clipboard", which is what someone
        reaching for a section link actually wants, and briefly says so. */}
    <script>
        for (const anchor of document.querySelectorAll<HTMLAnchorElement>(".docs-anchor")) {
            anchor.addEventListener("click", (event) => {
                // Let modified clicks (open in new tab, etc.) behave normally.
                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                const url = anchor.href;
                // History rather than default navigation, so the copy feedback is not wiped by a jump repaint.
                event.preventDefault();
                document.getElementById(anchor.hash.slice(1))?.scrollIntoView({ behavior: "smooth", block: "start" });
                history.replaceState(null, "", anchor.hash);
                void navigator.clipboard?.writeText(url).then(
                    () => {
                        anchor.dataset.copied = "true";
                        setTimeout(() => delete anchor.dataset.copied, 1200);
                    },
                    // A refused clipboard (insecure origin, denied permission) is not worth surfacing: the hash
                    // is already in the address bar, which is the outcome they wanted.
                    () => {},
                );
            });
        }
    </script>
</BaseLayout>
