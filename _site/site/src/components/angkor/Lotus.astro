---
/* The brand's flower, at one of three sizes. The page's bullet, the wordmark's companion and the
 * finial on every frame — one component so all three are literally the same drawing. */
import { LOTUS } from "./ornaments";

interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { size = "sm", class: className = "" } = Astro.props;
---

<span class={`a-lotus a-lotus-${size} ${className}`} aria-hidden="true" set:html={LOTUS} />
