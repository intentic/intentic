---
import { trustCards } from "@intentic-dev/site-content/about";
import { gitStats } from "@intentic-dev/astro-integrations";

/* The four checkable claims, shared by the landing band and /about/.
 *
 * The third card carries the only number on the page that would rot: every land changes it. So it is
 * MEASURED from git during the build rather than authored — and when git cannot answer (a shallow CI
 * clone, a tarball), `gitStats()` returns null and the card falls back to its sentence without a
 * figure. It never renders a zero: an empty counter is the one thing in a trust section that costs
 * more than it buys, which the reference page we borrowed this shape from demonstrates at its own
 * foot with "0 TOTAL POPULATION".
 *
 * The fourth card is the admission, and it is not padding. A trust section with nothing conceded in it
 * reads as marketing, and every claim above it stops counting. */

const stats = gitStats();

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

// Per-index, so the copy stays pure content — same convention as the landing page's other icon rows.
const cardIcons = [
    icon('<path d="M12 2.5 20 6v5.5c0 4.8-3.4 8.2-8 9.5-4.6-1.3-8-4.7-8-9.5V6z"/><path d="m9 12 2 2 4-4"/>'),
    icon('<path d="M9.5 17H8A5 5 0 0 1 8 7h1.5"/><path d="M14.5 7H16a5 5 0 0 1 0 10h-1.5"/><path d="M8.5 12h7"/>'),
    icon('<circle cx="7" cy="5" r="2"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="12" r="2"/><path d="M7 7v10M7 12h8"/>'),
    icon('<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/>'),
];
---

<div class="grid gap-4 md:grid-cols-2">
    {
        trustCards.map((card, i) => (
            <div class="card flex flex-col p-5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-link">
                        <Fragment set:html={cardIcons[i] ?? ""} />
                    </span>
                    <h3 class="text-sm font-medium text-content">{card.title}</h3>
                </div>

                {card.stat === "commits" && stats !== null && (
                    <p class="mt-4 text-2xl font-semibold tracking-tight text-content">
                        {stats.agent.toLocaleString("en-US")} of {stats.total.toLocaleString("en-US")}
                        <span class="ml-2 align-middle text-xs font-normal text-subtle">commits since {stats.since}</span>
                    </p>
                )}

                <p class="mt-3 max-w-copy text-sm leading-relaxed text-muted">{card.body}</p>

                {card.href && (
                    <a
                        href={card.href}
                        target={card.href.startsWith("http") ? "_blank" : undefined}
                        rel={card.href.startsWith("http") ? "noopener" : undefined}
                        class="mt-4 inline-block text-sm font-medium text-link hover:underline"
                    >
                        {card.linkLabel} →
                    </a>
                )}
            </div>
        ))
    }
</div>
