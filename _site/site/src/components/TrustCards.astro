---
import { trustCards } from "@intentic/site-content/about";
import { gitStats } from "@intentic/astro-integrations";
import Bullet from "./Bullet.astro";
import Corners from "./Corners.astro";

/* The four checkable claims, shared by the landing band and /about/. */

const stats = gitStats();

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

{/* Use the shared lotus mark instead of adding a second icon vocabulary. */}
<div class:list={["grid gap-[1.1rem] md:grid-cols-2", className]}>
    {
        trustCards.map((card) => (
            <div class="card p-[1.4rem]">
                <Corners set="diag" />
                <h3 class="m-0 flex items-center gap-[0.6rem] text-[1.0625rem] text-content">
                    <Bullet />
                    {card.title}
                </h3>

                {/* Use flat display numerals with lining figures so stats remain legible. */}
                {card.stat === "commits" && stats !== null && (
                    <p class="mt-[0.9rem] font-display text-[1.75rem] leading-[1.2] font-semibold text-gold-bright lining-nums tabular-nums">
                        {stats.agent.toLocaleString("en-US")} of {stats.total.toLocaleString("en-US")}
                        <span class="mt-1 block font-sans text-xs font-normal text-subtle">commits since {stats.since}</span>
                    </p>
                )}

                <p class="mt-[0.85rem] text-[0.9375rem] leading-[1.65] text-muted">{card.body}</p>

                {card.href && (
                    <a
                        href={card.href}
                        target={card.href.startsWith("http") ? "_blank" : undefined}
                        rel={card.href.startsWith("http") ? "noopener" : undefined}
                        class="link mt-4 inline-block text-sm"
                    >
                        {card.linkLabel} →
                    </a>
                )}
            </div>
        ))
    }
</div>
