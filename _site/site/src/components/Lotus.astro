---
/* The brand's flower, at one of three sizes. */
import { LOTUS } from "./ornaments";

interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { size = "sm", class: className = "" } = Astro.props;
---

<span class={`lotus lotus-${size} ${className}`} aria-hidden="true" set:html={LOTUS} />
