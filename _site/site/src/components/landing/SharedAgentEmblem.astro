<!-- Three open ribbons that meet in one shared centre. Drawn for the headline's cap height. Every loop's tip sits on
     the centre, and all three rims are drawn before all three ribbons, so the loops join into one clean knot there. -->
<svg class="shared-agent-emblem" viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="shared-ribbon" x1="22" y1="8" x2="67" y2="67" gradientUnits="userSpaceOnUse">
            <stop stop-color="var(--color-gold-bright)" />
            <stop offset="0.45" stop-color="var(--color-primary-400)" />
            <stop offset="1" stop-color="var(--color-primary-600)" />
        </linearGradient>
        <path id="shared-loop" d="M48 48C35 44.4 25 36 25 24C25 14 32 8 40 8C51 8 58 17 58 28C58 40 52 44.4 48 48Z" />
    </defs>
    <g stroke-linejoin="round">
        <g stroke="var(--color-gold)" stroke-width="9">
            <use href="#shared-loop" />
            <use href="#shared-loop" transform="rotate(120 48 48)" />
            <use href="#shared-loop" transform="rotate(240 48 48)" />
        </g>
        <g stroke="url(#shared-ribbon)" stroke-width="6.5">
            <use href="#shared-loop" />
            <use href="#shared-loop" transform="rotate(120 48 48)" />
            <use href="#shared-loop" transform="rotate(240 48 48)" />
        </g>
        <g stroke="var(--color-gold-bright)" stroke-width="1" stroke-linecap="round" opacity="0.7">
            <path d="M28 26C27 17 33 11 40 11" />
            <path d="M28 26C27 17 33 11 40 11" transform="rotate(120 48 48)" />
            <path d="M28 26C27 17 33 11 40 11" transform="rotate(240 48 48)" />
        </g>
    </g>
</svg>

<style>
    .shared-agent-emblem {
        display: inline-block;
        width: 0.94em;
        height: 0.94em;
        margin-inline: 0.16em 0.02em;
        vertical-align: -0.09em;
        overflow: visible;
    }
</style>
