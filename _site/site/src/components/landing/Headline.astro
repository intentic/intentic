---
import SharedAgentEmblem from "./SharedAgentEmblem.astro";

interface Props {
    lines: string[];
    shared?: boolean;
}

// Sentence beats retain spaces so assistive text and crawlers read the full headline.
const beats = Astro.props.lines
    .flatMap((line) => line.split(/(?<=\.)\s+/u))
    .map((beat) => beat.replace(/\.\s*$/u, ""))
    .filter((beat) => beat.length > 0);
---

<h1 class="headline">
    {
        beats.map((beat, index) => (
            <>
                <span class="headline-line">
                    {Astro.props.shared && index === beats.length - 1 ? (
                        <>
                            {beat.includes(" ") && <span class="display">{beat.slice(0, beat.lastIndexOf(" ") + 1)}</span>}
                            <span class="headline-phrase">
                                <span class="display">{beat.slice(beat.lastIndexOf(" ") + 1)}</span>
                                <SharedAgentEmblem />
                            </span>
                        </>
                    ) : (
                        <>
                            <span class="display">{beat}</span>
                            <span class="stop">.</span>
                        </>
                    )}
                </span>
                {index < beats.length - 1 && " "}
            </>
        ))
    }
</h1>

<style>
    /* The shared agent stands in for the headline's last stop; keep it on the line with the word it ends. */
    .headline-phrase {
        display: inline-block;
        white-space: nowrap;
    }
</style>
