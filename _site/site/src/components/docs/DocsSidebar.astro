---
import { type Book, type BookPage, bookHref } from "@intentic/site-content/book";

/* One book's rail: its shelves, with sub-group headings and indented sub-pages. */

interface Props {
    book: Book;
    pageId: string;
}

const { book, pageId } = Astro.props;

/* Two MUTUALLY EXCLUSIVE class sets rather than a base plus an override. */
const rowBase = "nav-wash block border-l-2 py-1 text-sm transition-colors";
const rowIdle = "border-transparent text-muted hover:text-content";
const rowActive = "border-primary-500 font-medium text-primary-400";

/** Child rows sit one step in from their parent, which is the whole point of having them. */
const indent = (page: BookPage): string => (page.id.includes("/") ? "pl-6" : "pl-3");

const isActiveShelf = (pages: BookPage[]): boolean => pages.some((page) => page.id === pageId);

const flatten = (pages: BookPage[]): BookPage[] => pages.flatMap((page) => [page, ...(page.children ?? [])]);

/* A group whose label repeats its own first row shows it twice. */
const labelFor = (group: { label?: string; items: BookPage[] }): string | undefined =>
    group.label === group.items[0]?.title ? undefined : group.label;
---

<nav aria-label={`${book.label} navigation`}>
    <slot name="search" />
    {
        book.sections.map((section) => {
            const pages = section.groups.flatMap((group) => flatten(group.items));
            const active = isActiveShelf(pages);
            return (
                <div class="mt-6 first:mt-0">
                    {/* Accent the current shelf label so the active documentation group is explicit. */}
                    <div class:list={["eyebrow mb-2 pl-3", active && "text-primary-500"]}>{section.label}</div>
                    {section.groups.map((group) => (
                        <div class="mt-3 first:mt-0">
                            {labelFor(group) && (
                                <div class="mb-1 pl-3 text-2xs font-medium tracking-wide text-muted">{labelFor(group)}</div>
                            )}
                            <ul class="list-none space-y-0.5 p-0">
                                {flatten(group.items).map((page) => (
                                    <li>
                                        <a
                                            href={bookHref(book, page.id)}
                                            class:list={[rowBase, indent(page), page.id === pageId ? rowActive : rowIdle]}
                                            aria-current={page.id === pageId ? "page" : undefined}
                                        >
                                            {page.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            );
        })
    }
</nav>
