---
/* The curated "and now this" list at the foot of a page. */

export interface DocsRelatedLink {
    /** Absolute path, with an anchor where the reason points at one section. */
    href: string;
    /** The page's own name: the docs tree's title, so the reader recognises the row they will land on. */
    title: string;
    /** Why THIS reader would want it, in a clause. Inline markup allowed; it is the only part that carries any. */
    why: string;
}

interface Props {
    links: DocsRelatedLink[];
}

const { links } = Astro.props;
---

<h2 class="docs-related">Related pages</h2>
<ul>
    {
        links.map((link) => (
            <li>
                <a href={link.href}>{link.title}</a>: <Fragment set:html={link.why} />
            </li>
        ))
    }
</ul>
