---
import liveJson from "../../content/live.json";
import { type LiveContent, parseLiveContent } from "../lib/live";

/* THE NOTICE STRIP: "the hosted sandboxes are degraded", and nothing more ambitious than that. */

// Baked at BUILD from the committed file. Parsed rather than trusted even here: the same document is
// hand-edited, and a build is a better place to find out it is malformed than a request is.
const content: LiveContent | undefined = parseLiveContent(liveJson);
const notice = content?.notice;
const active = notice?.active === true;
---

<aside
    class="live-notice"
    data-live-notice
    data-tone={notice?.tone ?? "info"}
    data-nosnippet
    role="status"
    aria-live="polite"
    hidden={!active}
>
    <p class="live-notice-inner">
        <span class="live-notice-dot" aria-hidden="true"></span>
        <span data-live-notice-message>{notice?.message ?? ""}</span>
        {/* Render the notice link statically; the worker may only update its allowlisted href and label. */}
        <a class="live-notice-link" href={notice?.href || "/"} data-live-notice-link hidden={!active || notice?.href === ""}>
            {notice?.linkLabel ?? "Details"}
        </a>
    </p>
</aside>

<style is:global>
    /* THE NOTICE STRIP Pinned above the bar, which is `position: fixed` at `top: 0`. */
    :root {
        --notice-height: 2.5rem;
    }

/* `min-height`, NOT `height`. */
    .live-notice {
        position: fixed;
        inset: 0 0 auto;
        z-index: 110;
        min-height: var(--notice-height);
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--notice-ground, var(--role-notice-ground));
        border-bottom: 1px solid var(--notice-edge, var(--color-line-strong));
        backdrop-filter: blur(14px);
    }
    .live-notice[hidden] {
        display: none;
    }

    body:has(> .live-notice:not([hidden])) {
        padding-top: var(--notice-height);
    }
    body:has(> .live-notice:not([hidden])) .bar {
        top: var(--notice-height);
    }

    .live-notice-inner {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        max-width: 84rem;
        /* Vertical padding, so a message that wraps is not flush against the strip's own edges. At one line. */
        padding: 0.5rem 1.5rem;
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.2;
        color: var(--color-content);
        text-align: center;
    }

/* The status dot carries the tone while the notice strip stays neutral. */
    .live-notice-dot {
        flex: none;
        width: 0.5rem;
        height: 0.5rem;
        background: var(--notice-accent);
        box-shadow: 0 0 0.5rem var(--notice-accent);
    }
    .live-notice[data-tone="info"] {
        --notice-accent: var(--color-gold);
    }
    .live-notice[data-tone="warn"] {
        --notice-accent: var(--color-warning);
    }
    .live-notice[data-tone="down"] {
        --notice-accent: var(--color-danger);
    }

    .live-notice-link {
        flex: none;
        color: var(--color-link);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    .live-notice-link[hidden] {
        display: none;
    }

/* THE NARROW RESERVE. */
    @media (max-width: 40rem) {
        :root {
            --notice-height: 4.4rem;
        }
        .live-notice-inner {
            padding: 0.5rem 1rem;
            font-size: 0.78rem;
        }
    }

    /* A CONTROL THE WORKER TURNED OFF `worker.ts` strips the href and sets this attribute; the reason rides in `title`. */
    [data-live-disabled] {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
        filter: grayscale(0.6);
    }
</style>
