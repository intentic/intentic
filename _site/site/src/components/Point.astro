---
/* ONE POINT IN A LIST: a mark, and the words beside it, as a row that cannot be assembled wrongly. */
import Bullet from "./Bullet.astro";

interface Props {
    /** Which house ornament leads the row. */
    mark?: "lotus" | "lozenge";
    /** Classes for the DRAWING: colour, opacity. Never position (Bullet.astro says why). */
    markClass?: string;
    /** Type and colour for the row. */
    class?: string;
}

const { mark = "lotus", markClass = "", class: className = "" } = Astro.props;
---

<li class:list={["point", className]}>
    <Bullet mark={mark} markClass={markClass} />
    <span><slot /></span>
</li>
