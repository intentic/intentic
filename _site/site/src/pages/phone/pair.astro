---
import DevicePairing from "../../components/devices/DevicePairing.astro";

/* WHERE A PHONE PAIRING CODE LANDS WHEN THE APP DID NOT OPEN IT. The QR code in the sandbox is a link to this page with
   the code in its fragment, which no server ever receives: Android opens Intentic Device for it when the app is
   installed and its link verified. Otherwise the phone's browser shows this page, which hands the code to the app by
   its own scheme, or says where to get the app. The code never leaves the browser. */
---

<DevicePairing
    product={{ name: "Intentic Device", path: "/phone/" }}
    heading="Connect this phone"
    hasCode="This link carries a one-time code for Intentic Device. Open it in the app to connect this phone to the sandbox that made it."
    noCode="This page opens a pairing code in Intentic Device. Scan the QR code on your phone's card in the sandbox to get one."
    openLabel="Open in Intentic Device"
    downloadLabel="Don't have the app? Download it"
    scheme="pair"
>
    The code works once and expires about ten minutes after it was made. If it has expired, press Connect on the phone's card
                again for a fresh one.
</DevicePairing>
