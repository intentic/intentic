---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";

/* INTENTIC DEVICE: the Android app that lets the agent in your sandbox work on your own phone. Where the Android
   phone card's install link and its QR code's fallback both lead. */

const steps = [
    {
        title: "Add your phone in the sandbox",
        body: "Open Capabilities, add an Android phone and choose what the agent may do there. A QR code appears.",
    },
    {
        title: "Install the app",
        body: "Download the app below and open it. Android asks you to allow installs from your browser once; that is Android's own check for an app from outside a store.",
    },
    {
        title: "Scan the code",
        body: "Point the phone's camera at the QR code. The app opens on its pairing screen, shows which sandbox it is joining, and asks you to confirm.",
    },
];

const promises = [
    "The phone connects out to your sandbox. Nothing is opened on your network.",
    "A notification shows whenever the agent is connected, and a Quick Settings tile pauses it.",
    "The agent only works in the apps and folders you allow on the phone itself.",
    "Every action is listed in the app's activity log.",
];
---

<BaseLayout breadcrumbs={[{ name: "Intentic Device", path: "/phone/" }]}>
    <Nav />
    <main class="flex-1">
        <section class="below-bar mx-auto max-w-5xl px-6 pb-16">
            <h1 class="display text-4xl font-semibold max-sm:text-3xl">Let your agent work on your phone</h1>
            <p class="mt-4 max-w-copy text-lg text-muted">
                Intentic Device connects your Android phone to your sandbox, the way a connected PC does. The agent can see the screen, use the
                apps you allow, read the folders you pick and, if you let it, the notifications where one-time codes arrive.
            </p>

            <div class="mt-10 flex flex-wrap items-center gap-4">
                <a href="/phone/apk" data-download-cta class="btn btn-primary">Download for Android</a>
                <span class="text-xs text-subtle">Android 8 or newer · .apk, signed by intentic</span>
            </div>

            <ol class="mt-12 grid gap-6 sm:grid-cols-3">
                {
                    steps.map((step, at) => (
                        <li class="flex flex-col gap-2">
                            <span class="text-xs font-semibold text-subtle">Step {at + 1}</span>
                            <h2 class="text-base font-semibold text-content">{step.title}</h2>
                            <p class="text-sm text-muted">{step.body}</p>
                        </li>
                    ))
                }
            </ol>
        </section>

        <section class="mx-auto max-w-5xl px-6 pb-16">
            <div class="border border-line bg-surface p-6">
                <h2 class="text-lg font-semibold text-content">You stay in charge of the phone</h2>
                <ul class="mt-3 grid gap-x-10 gap-y-2 sm:grid-cols-2">
                    {promises.map((promise) => <li class="max-w-copy text-sm text-muted">{promise}</li>)}
                </ul>
            </div>
        </section>

        <section class="mx-auto max-w-5xl px-6 pb-24">
            <h2 class="text-lg font-semibold text-content">Why it is not in Google Play</h2>
            <p class="mt-3 max-w-copy text-sm text-muted">
                Tapping and typing in other apps uses Android's accessibility service, and Google Play does not allow an AI agent to act
                through it. So the full app is downloaded from here. Before turning on its accessibility service, Android 13 and later ask
                you to open the app's info screen and choose <strong class="text-content">Allow restricted settings</strong>; the app walks
                you through it.
            </p>
        </section>
    </main>
    <Footer />
</BaseLayout>
