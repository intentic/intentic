---
import { docsHref, docsSections } from "@intentic-dev/site-content/docs";
import DocsLayout from "../../components/DocsLayout.astro";

/* The overview's job is to ROUTE, not to summarise.
 *
 * It used to end in thirteen cards: one per page in the tree, each captioned with that page's meta description.
 * That was the longest thing on the page, it restated the sidebar sitting three inches to its left, and the
 * captions were written for search results rather than for someone choosing. A reader scrolled a wall to learn
 * what a glance at the rail already told them.
 *
 * What replaces it is the four shelves as four QUESTIONS, because a visitor arrives holding a question, not a
 * shelf label. Each row names the shelf's first stop and the pages behind it, and nothing here is a card grid:
 * the rail is the tree, and this page is the sentence that tells you which branch is yours.
 */

// The install decision, in the order a reader eliminates them: least typing first.
const paths = [
    {
        name: `The desktop app`,
        href: `/docs/quickstart/#desktop-app`,
        who: `You'd rather not open a terminal, and want updates as a button.`,
        run: `An installer, then one click`,
    },
    {
        name: `The setup command`,
        href: `/docs/quickstart/#setup-command`,
        who: `You're on a server, a Mac, or anywhere over SSH.`,
        run: `One pasted line`,
    },
    {
        name: `Docker Compose`,
        href: `/docs/quickstart/#docker-compose`,
        who: `You want to read the whole definition before anything runs.`,
        run: `docker compose up -d`,
    },
    {
        name: `Plain docker run`,
        href: `/docs/quickstart/#docker-run`,
        who: `You're scripting this into your own provisioning tooling.`,
        run: `Five docker commands`,
    },
];

/* The question each shelf answers, in the reader's own words. Authored rather than reusing `audience`: the
 * sidebar's line describes the shelf to someone already browsing it, and this one has to catch someone who has
 * not started looking. Keyed by shelf label, and asserted below, so a renamed or added shelf fails the build
 * rather than quietly rendering a shelf with no question. */
const questions: Record<string, string> = {
    Understand: `“What actually is this, and is it built the way I'd want?”`,
    "Run a sandbox": `“I want one running on my hardware, kept up to date, shared with my team.”`,
    Integrations: `“I want it talking to my systems, my tools and my own computer.”`,
    "Drive agents": `“It's running. How do I get real work out of it?”`,
};

const missing = docsSections.filter((section) => questions[section.label] === undefined).map((section) => section.label);
if (missing.length > 0) {
    throw new Error(`docs/index.astro: no question written for shelf: ${missing.join(`, `)}`);
}

/** Every page on a shelf, flattened, so a row can list what is behind it without the reader guessing. */
const contentsOf = (label: string): string[] => {
    const section = docsSections.find((entry) => entry.label === label);
    return (section?.groups ?? []).flatMap((group) =>
        group.items.flatMap((page) => [page.title, ...(page.children ?? []).map((child) => child.title)]),
    );
};
---

<DocsLayout
    pageId=""
    heading="Overview"
    lead="intentic gives each agent its own sandbox on hardware you own. These docs take you from first run to a sandbox that runs itself."
>
    <h2>The mental model</h2>
    <p>
        One idea holds the whole product together: <strong>a specialized agent is a purpose-built sandbox.</strong> Not a prompt or a
        markdown file. It is a real container, on a machine you control, with the libraries, dev-tools, system access, and curated context a
        specific job needs. You drive it from any browser; it runs where you started it.
    </p>
    <p>Two tiers make that work, and only your sandbox holds your code:</p>
    <ul>
        <li><strong>The platform</strong>: a thin hub that stores your identity and your sandbox's URL. It sits off the command path and can't reach in.</li>
        <li>
            <strong>Your sandbox</strong>: one container per agent, on your hardware, reached by your browser over a private Cloudflare
            tunnel. The agent, repos, credentials, and capabilities live here, along with any tool it runs: a database client, a headless
            browser, even a deployment engine.
        </li>
    </ul>
    <p>
        Read <a href="/docs/architecture/">Architecture</a> for the full picture, or bring one up now.
    </p>

    <h2>Get one running</h2>
    <p>
        Every route starts the same way: <a href="/docs/quickstart/#setup-code">sign in, and the setup screen hands you a finished command
        with your setup code already in it</a>, and every route ends with the same two containers on your machine. They differ only in who
        types the docker commands.
    </p>
    <table>
        <thead>
            <tr>
                <th>Route</th>
                <th>Choose it when</th>
                <th>You run</th>
            </tr>
        </thead>
        <tbody>
            {
                paths.map((path) => (
                    <tr>
                        <td>
                            <a href={path.href}>{path.name}</a>
                        </td>
                        <td>{path.who}</td>
                        <td>{path.run}</td>
                    </tr>
                ))
            }
        </tbody>
    </table>
    <p>
        <a href="/docs/quickstart/">Quickstart</a> walks all four end to end with copy-pasteable commands.{" "}
        <a href="/docs/docker/">Docker setup</a> is the anatomy they share: what gets created, where your data lives, and how to update or
        remove it. If you'd like the installer without reading further, it's on the <a href="/download/">download page</a>.
    </p>

    <h2>What's in a sandbox</h2>
    <p>Everything an agent needs to do real work, and nothing the platform can see:</p>
    <ul>
        <li><strong>An agent</strong>: Claude Code, Codex, or Grok, on your own subscription, chosen per conversation.</li>
        <li><strong>A workspace</strong>: your repos, a file tree, editors, and terminals that survive reconnects.</li>
        <li><strong>Capabilities</strong>: GitHub, databases, Sentry, Stripe, SSH hosts, MCP servers, added in a click.</li>
        <li><strong>An environment</strong>: libraries and dev-tools baked into the image, proposed by the agent and applied on your approval.</li>
        <li><strong>Automations</strong>: schedules, webhooks, and event listeners that wake the agent while you're away.</li>
    </ul>

    <h2>Find your way</h2>
    <p>
        These docs are four shelves, sorted by what you came here to do. The list on the left is all of it; this is which part is yours.
    </p>
    <div class="docs-embed mt-6 flex flex-col gap-3">
        {
            docsSections.map((section) => (
                <a
                    href={docsHref(section.entry)}
                    class="group card block p-5 no-underline transition-colors hover:border-primary-600/40"
                >
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span class="text-sm font-semibold text-content transition-colors group-hover:text-link">{section.label}</span>
                        <span class="text-sm text-muted">{questions[section.label]}</span>
                    </div>
                    {/* The shelf's contents as a plain line rather than a nested card grid: it tells the reader
                        what is behind the row, at a size that does not compete with the question above it. */}
                    <p class="mt-2 text-xs leading-relaxed text-subtle">{contentsOf(section.label).join(` · `)}</p>
                </a>
            ))
        }
    </div>
    {/* The other book, as a row of its own rather than a fifth shelf: it is a different reader, and the whole
        reason the two are separate is that the person building against intentic should not have to scroll past
        install instructions to reach a manifest field. */}
    <div class="docs-embed mt-3">
        <a href="/api/" class="group card block border-primary-600/25 p-5 no-underline transition-colors hover:border-primary-600/50">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-sm font-semibold text-content transition-colors group-hover:text-link">Building on it →</span>
                <span class="text-sm text-muted">“I want to extend it, or drive it from my own code.”</span>
            </div>
            <p class="mt-2 text-xs leading-relaxed text-subtle">
                A separate book, at /api: the extension lifecycle end to end, the manifest reference, the host API and the sandbox's own
                HTTP API.
            </p>
        </a>
    </div>
    <p class="mt-6">
        Looking for one specific thing? Press <kbd>/</kbd> anywhere in the documentation to search every page of both books at once.
    </p>
</DocsLayout>
