        links={[
            { href: "/docs/parallel-agents/", title: "Parallel agents", why: "what each of these opens: an isolated conversation you review and land." },
            { href: "/docs/doorbell/", title: "Doorbell", why: "a listener automation with a chat widget on the front of it." },
            { href: "/docs/capabilities/", title: "Capabilities", why: "connect the system whose events you want to wake on." },
