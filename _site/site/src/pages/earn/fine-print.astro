---
import { creatorSharePct, pool, poolUsd } from "@intentic-dev/site-content/pool";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsCodeBlock from "../../components/DocsCodeBlock.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";

/* THE ARGUED VERSION. /earn/ is the shape of the economy, graspable in one scroll of figures and tiles; this
 * page is every promise on it argued in full — the arithmetic, the design choices and the honest status. It
 * moved OFF /earn/ because seven screens of reasoned prose under the diagrams made the page a wall: the
 * reader deciding whether the deal is fair needs the tiles, and the reader auditing it needs this, and they
 * are almost never the same visit. Figures still come from the published pool config — nothing retyped. */

const n = (value: number) => value.toLocaleString(`en-GB`);

const entry = `{
    "name": "acme.reddit-research",
    "kind": "extension",
    "tier": "premium",
    "description": "Deep subreddit research: audiences, timing, and what actually gets traction.",
    "version": "1.2.0",
    "source": { "source": "github", "repo": "acme/reddit-research", "sha": "9f2c1ab…" }
}`;
---

<BaseLayout>
    <Nav />
    <main class="flex-1">
        <section class="page-hero">
            <div class="below-bar relative mx-auto max-w-7xl px-6 pb-12">
                <div class="eyebrow"><a href="/earn/" class="text-subtle no-underline hover:text-link">Earn</a> · The fine print</div>
                <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">Every promise, argued in full.</h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    <a href="/earn/">Earn</a> is the shape of the economy; this page is its reasoning: the arithmetic behind the split, the
                    design choices behind the rules, and an honest account of what exists today.
                </p>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-6 py-14 lg:py-16">
            {/* docs-article carries the reading measure the docs pages get from their layout; without it every
                paragraph here sets at the container's full width, which is the wall this page exists to avoid. */}
            <div class="docs-article docs-body">
                <h2>The deal</h2>
                <p>
                    A user buys one <strong>intentic membership</strong> (${pool.priceUsd}/month). It includes every <code>premium</code> extension
                    wherever they work and a daily allowance of <strong>credits</strong>, the pool's only currency.{" "}
                    <strong>${pool.infraUsd} of that membership pays for running the platform</strong> (a member's machine, its disk, the
                    things that cost money whether anybody installs anything or not) and the remaining{" "}
                    <strong>${poolUsd} is the pool</strong>, which is what the daily allowance is worth and what the share below is a share of.
                    <strong> Every credit a member spends pays {creatorSharePct}% of its dollar value to the creator it went to</strong>; the rest runs the platform.
                    Two ways credits move:
                </p>
                <ul>
                    <li><strong>Install donations</strong>: installing a premium extension donates a published number of credits to its publisher, once, automatically. Updating it donates again, at most once a month. That is the whole way non-service extensions earn.</li>
                    <li><strong>Service runs</strong>: metered per-run spends on priced services (the section below).</li>
                </ul>
                <p>
                    No per-extension checkout, no subscription per tool, no cut of anything you sell outside the pool. A creator lists once and earns from installs; a member pays once and supports what they pick by picking it.
                </p>

                <h2>No telemetry, by construction</h2>
                <p>
                    Sandboxes are self-hosted: yours, like your editor. So the pool pays on <strong>nothing a sandbox could report</strong>:
                    no usage pings, no active-day bits, no counts, ever. The only economic signal that exists is what passes through the platform's own
                    hands: a member's deliberate install donation, a member's service run. Your machine tells nobody what you run on it.
                </p>
                <p>Why donations at install, and not the obvious alternatives:</p>
                <ul>
                    <li><strong>Not usage metering</strong>: a self-hosted client can invent any usage it likes, and honest ones shouldn't phone home at all.</li>
                    <li><strong>Not minutes or tokens</strong>: those pay slow, bloated tools more for being slow and bloated.</li>
                    <li><strong>Not a per-tool checkout</strong>: friction at every install kills the browsing that makes a catalog worth listing in.</li>
                </ul>

                <h2>Why farming loses money, arithmetically</h2>
                <p>
                    A member's credits are bounded by their own membership: a month's allowance is worth the pool share of what they paid, ${poolUsd} of
                    every ${pool.priceUsd}, never more. So a publisher
                    "farming" donations to their own listing with bought memberships can only redirect <em>a {creatorSharePct}% share of a fraction of money they
                    themselves paid in</em>: every farmed dollar costs more than it returns, at any scale. The monthly donation dedupe also stops update spam:
                    an install can donate at most twelve times a year however often its publisher ships. What remains for policy is only nudging real
                    users into meaningless updates, which is <strong>delisting grounds</strong>, stated on the row like every other trust decision.
                </p>

                <h2>Services &amp; credits: runs with real costs</h2>
                <p>
                    Some tools aren't a prompt and glue: they call paid data APIs or burn real compute per run. Those are <strong>services</strong>,
                    and they run on <strong>credits</strong>: a membership includes a daily allowance ({n(pool.dailyCredits)} credits, resetting at UTC midnight, same
                    honest reset as the free trial), and a service publishes its credit price. The rules a member can hold us to:
                </p>
                <ul>
                    <li><strong>The price is visible before the run.</strong> Any surface can ask what a run costs and what's left today; a refusal for lack of credits answers with the remaining count and when it resets.</li>
                    <li><strong>No charge on failure.</strong> Credits are spent before the call and refunded when the provider errors or never answers. A provider's "your query was malformed" is an answer: paid for, and relayed verbatim.</li>
                    <li><strong>The platform is the intermediary.</strong> The provider never learns who the user is, and the user never holds a provider key. Every forwarded call is signed, so a provider can verify it came from intentic.</li>
                </ul>
                <p>
                    A credit's dollar value is derived, not invented: the membership price divided by a month's allowance. Donations and runs spend from the same allowance, so a member's support is bounded by what they paid, which is what makes the economy sybil-proof. Credits nobody spends pay nobody, so the pool figure is a ceiling payouts approach and the ledger prints both.
                </p>
                <p>
                    <strong>Who let it in, and your worst case.</strong> The catalog is curated: the platform admits every service and delists a bad one, with no self-serve path onto it. Nothing of a provider's runs on your machine, so a run's blast radius is its listed price and the JSON your agent reads back. The mechanical case never needs a dispute (no answer, no charge, enforced in code); a <em>served</em> answer is paid even when it disappoints,
                    and chronic disappointment is what delisting is for rather than a per-run argument.
                </p>
                <p>
                    Running something that costs real money per call? <a href="/developers/services/">Offer a paid service</a> explains the provider's
                    endpoint, signature checks, payments, refunds and admission.
                </p>

                <h2>The books are open</h2>
                <p>
                    The platform serves <code>GET /pool/transparency</code> to anyone, no login, and <a href="/earn/ledger/">the ledger</a> renders it
                    for people. It publishes two kinds of month and never lets them be confused. The month in progress is computed live and its
                    revenue is an <em>estimate</em> (members × price), because nobody can know what a month took until it is over. A finished month
                    is the frozen record: what <strong>actually settled</strong> at Stripe, the <strong>fees</strong> Stripe took on it, the pool, what
                    creators earned, and what became of every cent of it: paid, in flight, carried, unclaimed, or expired back into the pool.
                </p>
                <p>
                    Publishing only the total earned would let "90% to creators" hide money that never reached anybody, so the outcomes are broken out and add up to the distributed total. The margin is visible too: revenue minus fees minus the pool is what the platform keeps. Member counts on an open month are today's snapshot; a closed month's is the count recorded when it closed.
                </p>

                <h2>Getting paid</h2>
                <p>
                    Earnings accrue against the <strong>publisher name</strong> in your manifest, which is a label until somebody proves it is theirs. You claim it by committing a token the platform gives you to any repository the registry already lists under that name: push access is the proof. Then you connect a payout account through Stripe's own hosted setup, which collects bank details, identity documents and tax forms. This platform never sees them.
                </p>
                <p>
                    A month closes as soon as it is over and becomes payable mid-month. The gap is a hold window for refunds and disputes, not an unexplained delay, and the date is stated rather than implied. You are paid once per cycle across every name you hold, and a balance under the minimum carries rather than becoming a transfer whose fee eats it. A failed payment is retried until it lands, never abandoned and never sent twice.
                </p>
                <p>
                    Claim late and you still get paid: statements are never bound to an account, so proving a name in October settles what it earned in July. Earnings nobody claims stay claimable for twelve months, then return to the pool and are split among creators still shipping. That is the one case where money you earned stops being yours, so it is stated here and shown on the ledger.
                </p>

                <h2>What exists today, honestly</h2>
                <ul>
                    <li><strong>Working now:</strong> premium listings, the membership, install donations with the monthly dedupe, credits and metered service runs (spend, refund, signed forwarding, streamed live with status lines on the run's card, up to five minutes a run), the demo service, the pool math, publisher claims, connected payout accounts, the monthly close against settled revenue, automatic payouts, the public ledger, self-serve service listings (published gates, no operator in the loop; see <a href="/developers/services/">Offer a paid service</a>), and the <a href="/earn/catalog/">public catalog</a> with every listing's served and refunded runs.</li>
                    <li><strong>Not yet:</strong> credit top-ups and rollover (the daily allowance is the whole meter), and richer stream events than status lines (the vocabulary is built to grow).</li>
                </ul>
                <p>
                    The split ({creatorSharePct}%) is configuration the platform publishes on the ledger itself, so this page and the endpoint cannot quietly
                    disagree. If the number ever changes, it changes loudly, prospectively, and on that page first.
                </p>

                <h2>Opting in</h2>
                <p>
                    One field on your registry entry. Everything else on <a href="/developers/publish/">Publish &amp; registries</a>: the sha-pinned pointer,
                    the manifest gate, the <a href="/developers/verify/">trust states</a>: applies to premium listings unchanged.
                </p>
                <DocsCodeBlock code={entry} lang="json" title=".claude-plugin/marketplace.json: one entry" />
                <p>
                    Premium is honored on the <a href="/extensions/">official registry</a>, because that is the registry the platform's pool reads.
                    A private registry can mark rows premium for its own purposes, but the public pool neither sees nor pays them.
                </p>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
