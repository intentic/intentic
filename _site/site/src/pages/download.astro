---
import { latestRelease } from "@intentic/astro-integrations";
import { APP_URL, DEMO_PATH } from "@intentic/site-content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import ExternalIcon from "../components/ExternalIcon.astro";
import OsInstaller from "../components/download/OsInstaller.astro";
import PlatformTiles from "../components/download/PlatformTiles.astro";
import SameSandbox from "../components/download/SameSandbox.astro";
import SetupPath from "../components/download/SetupPath.astro";
import { glyph, type GlyphName } from "../components/download/glyphs";
import { desktopPlatforms } from "../lib/desktop-downloads";
import { formatReleaseDate } from "../lib/release";

/* THE DOWNLOAD PAGE: the answer to the one objection the quickstart raises. Read top to bottom it is: what you get,
   what setup will do (beside the button, before anybody presses), which file, what the app does after, that it is the
   same sandbox as the command, and the ways out for someone who will not install anything. */

const release = await latestRelease();

// The hero's button, narrowed by the page's script to the reader's system. Without a match it scrolls to the tiles.
const heroTargets = {
    windows: { href: desktopPlatforms.windows.href, label: `Download for ${desktopPlatforms.windows.name}` },
    linux: { href: desktopPlatforms.linux.href, label: `Download for ${desktopPlatforms.linux.name}` },
    macos: { href: `${APP_URL}/setup?machine=mine`, label: "Get the macOS command" },
};

// What the app does that a browser cannot. Each one is a place the browser has to hand out a command today.
const does: { glyph: GlyphName; title: string; body: string }[] = [
    { glyph: "cube", title: "Sets it all up", body: "Container engine, sandbox and private connection, then your workspace." },
    { glyph: "update", title: "Updates in one click", body: "Sandbox updates run on this computer. A button, not a command." },
    { glyph: "power", title: "Back after a reboot", body: "The sandbox restarts with the engine. Start, stop or read logs from the tray." },
];

const keeps: { glyph: GlyphName; title: string; body: string; link?: { href: string; label: string } }[] = [
    { glyph: "keep", title: "Uninstalling keeps your sandbox", body: "Files and history stay in Docker until you remove them." },
    {
        glyph: "shield",
        title: "The app updates itself",
        body: "Every update promises what it keeps.",
        link: { href: "/docs/updates/", label: "Read the promises" },
    },
];

const exits: { glyph: GlyphName; title: string; body: string; href: string }[] = [
    { glyph: "cloud", title: "Use it in your browser", body: "A hosted workspace. Nothing to install.", href: APP_URL },
    { glyph: "eye", title: "Look around first", body: "The real app on a sample workspace.", href: DEMO_PATH },
    { glyph: "compare", title: "Compare where it runs", body: "This computer, or a machine we host.", href: "/where-it-runs/" },
];
---

<BaseLayout breadcrumbs={[{ name: "Download", path: "/download/" }]}>
    <Nav />
    <main class="flex-1">
        <section class="below-bar mx-auto max-w-6xl px-6 pb-14">
            <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16">
                <div>
                    <h1 class="display text-5xl max-sm:text-[2.35rem]">Run intentic without a terminal</h1>
                    <p class="mt-5 max-w-copy text-lg leading-relaxed text-muted">
                        Install the app, sign in and press <strong class="font-medium text-content">Run on this computer</strong>. It sets up the
                        same sandbox as the command line.
                    </p>

                    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
                        <a href="#platforms" class="btn btn-primary" data-hero-cta data-targets={JSON.stringify(heroTargets)}>
                            <span set:html={glyph("download", "btn-icon")} />
                            <span data-hero-label>Choose your download</span>
                        </a>
                        <a href="#platforms" class="text-sm text-link hover:underline">All platforms</a>
                    </div>

                    {/* Keep the link before punctuation so formatting cannot add a visible gap. */}
                    {
                        release !== null && (
                            <p
                                class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-subtle"
                                data-release-label
                                data-built-version={release.version}
                            >
                                {/* Two groups, so a narrow column breaks between what the build is and what to do about it. */}
                                <span class="inline-flex flex-wrap items-center gap-x-4 gap-y-1">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span set:html={glyph("tag", "h-3.5 w-3.5 text-gold")} />
                                        Version <strong class="font-medium text-muted" data-release-version>{release.version}</strong>
                                    </span>
                                    <span>
                                        Released <span data-release-date>{formatReleaseDate(release.date)}</span>
                                    </span>
                                </span>
                                <span class="inline-flex flex-wrap items-center gap-x-4 gap-y-1">
                                    <a href={release.notes} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-link hover:underline" data-release-notes>
                                        What's new
                                        <ExternalIcon />
                                    </a>
                                    <a href="/about/#verify" class="inline-flex items-center gap-1.5 text-link hover:underline">
                                        <span set:html={glyph("shield", "h-3.5 w-3.5")} />
                                        Verify the download
                                    </a>
                                </span>
                            </p>
                        )
                    }
                </div>

                <SetupPath />
            </div>
        </section>

        <section id="platforms" class="mx-auto max-w-6xl px-6 pb-20" aria-labelledby="platforms-heading">
            <h2 id="platforms-heading" class="sr-only">Downloads</h2>
            <PlatformTiles />
        </section>

        {/* The reader's system lights its tile and names the hero's button. Inline, right after both, so neither repaints late. */}
        <script is:inline>
            (() => {
                // userAgentData.platform where it exists ("Windows", "Linux", "macOS", "Android"), the user-agent string where
                // it does not. Phones and ChromeOS get neither build, and an iPhone's user agent also says "Mac OS X".
                const hint = navigator.userAgentData?.platform || navigator.userAgent;
                const key = /Android|CrOS|iPhone|iPad/i.test(hint)
                    ? null
                    : /Win/i.test(hint)
                      ? "windows"
                      : /Mac/i.test(hint)
                        ? "macos"
                        : /Linux|X11/i.test(hint)
                          ? "linux"
                          : null;
                if (!key) {
                    return;
                }
                document.querySelector(`[data-platform="${key}"]`)?.setAttribute("data-here", "");
                const cta = document.querySelector("[data-hero-cta]");
                const target = cta && JSON.parse(cta.dataset.targets || "{}")[key];
                if (target) {
                    cta.href = target.href;
                    cta.querySelector("[data-hero-label]").textContent = target.label;
                }
            })();
        </script>

        {/* A whole machine rather than an app: its own band, after the tiles and before what the app does after setup. */}
        <section id="os" class="band-rule scroll-mt-24 border-t" aria-label="Intentic OS">
            <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
                <OsInstaller />
            </div>
        </section>

        <section class="band-rule border-t">
            <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
                <h2 class="display text-2xl sm:text-3xl">After setup, the app runs it</h2>
                {/* One strip, three cells: the three things a browser would otherwise hand you a command for. */}
                <ul class="strip mt-8 grid sm:grid-cols-3">
                    {
                        does.map((item) => (
                            <li class="flex items-start gap-5 p-6 sm:block sm:p-8">
                                <span class="niche" set:html={glyph(item.glyph, "h-6 w-6")} />
                                <div>
                                    <h3 class="text-lg text-content sm:mt-5">{item.title}</h3>
                                    <p class="mt-1.5 max-w-[32ch] text-sm leading-relaxed text-muted">{item.body}</p>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="band-rule border-t">
            <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
                <h2 class="display text-2xl sm:text-3xl">Same sandbox, either way</h2>
                <p class="mt-2 max-w-copy text-sm text-muted">The app runs the one-line install's own script for you.</p>
                <div class="mt-10">
                    <SameSandbox />
                </div>
                <ul class="mt-12 grid gap-6 sm:grid-cols-2">
                    {
                        keeps.map((item) => (
                            <li class="flex gap-4">
                                <span class="niche niche-sm" set:html={glyph(item.glyph, "h-5 w-5")} />
                                <div>
                                    <p class="font-mark text-base text-content">{item.title}</p>
                                    <p class="mt-0.5 text-sm text-muted">
                                        {item.body}
                                        {item.link && (
                                            <>
                                                {" "}
                                                <a href={item.link.href} class="text-link hover:underline">
                                                    {item.link.label}
                                                </a>
                                            </>
                                        )}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="band-rule border-t">
            <div class="mx-auto max-w-6xl px-6 pt-16 pb-24 lg:pt-20">
                <h2 class="display text-2xl sm:text-3xl">Not installing on this computer?</h2>
                <div class="mt-8 grid gap-4 md:grid-cols-3">
                    {
                        exits.map((exit) => (
                            <a href={exit.href} class="exit card group flex items-center gap-4 p-5 no-underline">
                                <span class="niche niche-sm" set:html={glyph(exit.glyph, "h-5 w-5")} />
                                <span class="min-w-0 flex-1">
                                    <span class="block font-mark text-base text-content">{exit.title}</span>
                                    <span class="block text-sm text-muted">{exit.body}</span>
                                </span>
                                <span class="exit-arrow" set:html={glyph("arrow", "h-4 w-4")} />
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

{/* The label is built at deploy time and deploys are manual; the worker names the version the download routes serve now. */}
<script>
    import { formatReleaseDate } from "../lib/release";

    const label = document.querySelector<HTMLElement>("[data-release-label]");
    if (label !== null) {
        fetch("/desktop/latest.json")
            .then((response) => (response.ok ? response.json() : null))
            .then((release: { version: string; date: string | null; notes: string } | null) => {
                if (release === null || !/^\d+\.\d+\.\d+/u.test(release.version)) {
                    return;
                }
                const set = (selector: string, text: string): void => {
                    const node = label.querySelector(selector);
                    if (node !== null) {
                        node.textContent = text;
                    }
                };
                set("[data-release-version]", release.version);
                // A date the API would not give is better absent than the old build's.
                set("[data-release-date]", release.date === null ? "recently" : formatReleaseDate(release.date));
                label.querySelector("[data-release-notes]")?.setAttribute("href", release.notes);
            })
            .catch(() => {
                // Offline or the route is not served (astro dev): the label built into the page stands.
            });
    }
</script>

<style>
    /* A glyph set in a carved square: the same niche the menu sets its glyphs in, at content scale. */
    .niche {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        flex: none;
        color: var(--color-gold);
        border: 1px solid var(--color-line-strong);
        background: var(--role-frame-fill);
    }
    .niche :global(svg) {
        display: block;
    }
    .niche-sm {
        width: 2.75rem;
        height: 2.75rem;
        border-color: var(--color-line);
    }

    .strip {
        border: 1px solid var(--color-line);
        background: var(--wash-panel);
    }
    .strip > li + li {
        border-top: 1px solid var(--color-line);
    }
    @media (min-width: 40rem) {
        .strip > li + li {
            border-top: 0;
            border-left: 1px solid var(--color-line);
        }
    }

    .exit-arrow {
        flex: none;
        color: var(--color-subtle);
        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }
    .exit:hover .exit-arrow,
    .exit:focus-visible .exit-arrow {
        color: var(--color-link);
        transform: translateX(3px);
    }
    @media (prefers-reduced-motion: reduce) {
        .exit-arrow {
            transition: none;
        }
    }
</style>
