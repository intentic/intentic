---
import { latestRelease } from "@intentic/astro-integrations";
import { APP_URL } from "@intentic/site-content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { desktopPlatforms } from "../lib/desktop-downloads";

/* THE DOWNLOAD PAGE: the answer to the one objection the quickstart raises. */

const release = await latestRelease();

/* Name, link and glyph come from the shared table, so this page and the hero's button can never drift into pointing at different files. */
const downloads = [
    {
        ...desktopPlatforms.windows,
        note: "Windows 10 and 11, 64-bit",
        label: "Download for Windows",
        sub: ".exe installer · installs for your user, no admin rights",
    },
    {
        ...desktopPlatforms.linux,
        note: "Any distribution, 64-bit",
        label: "Download AppImage",
        sub: "AppImage · chmod +x and run",
    },
];

const alternatives = [
    { label: ".deb", href: "/desktop/deb", note: "Debian, Ubuntu" },
    { label: ".rpm", href: "/desktop/rpm", note: "Fedora, RHEL, openSUSE" },
];

// What the app does that a browser cannot. Each one is a place the browser has to hand out a command today.
const does = [
    {
        title: "Installs and starts your sandbox",
        body: "The app installs Docker if needed, starts the sandbox and its private connection, then opens your workspace.",
    },
    {
        title: "Updates it with a button",
        body: "Updates must run on the same computer as the sandbox. The app handles them with a click instead of a terminal command.",
    },
    {
        title: "Starts again after a reboot",
        body: "The sandbox restarts with Docker. Use the tray app to start it, stop it or read its logs.",
    },
];
---

<BaseLayout breadcrumbs={[{ name: "Download", path: "/download/" }]}>
    <Nav />
    <main class="flex-1">
        <section class="below-bar mx-auto max-w-5xl px-6 pb-16">
            <h1 class="display text-4xl font-semibold max-sm:text-3xl">Run intentic without a terminal</h1>
            <p class="mt-4 max-w-copy text-lg text-muted">
                Install the desktop app, sign in and click <strong class="text-content">Run on this computer</strong>. The app sets up the same
                sandbox you can run from the command line.
            </p>

            <div class="mt-10 grid gap-4 sm:grid-cols-2">
                {
                    downloads.map((download) => (
                        <a
                            href={download.href}
                            class="group flex flex-col gap-3 border border-line bg-surface p-6 transition-colors hover:border-primary-600/50"
                        >
                            <span class="flex items-center gap-3">
                                <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current text-muted" aria-hidden="true">
                                    <path d={download.icon} />
                                </svg>
                                <span class="text-lg font-semibold text-content">{download.name}</span>
                            </span>
                            <span class="text-sm font-medium text-link group-hover:underline">{download.label}</span>
                            <span class="text-xs text-subtle">{download.sub}</span>
                            <span class="mt-auto pt-2 text-xs text-subtle">{download.note}</span>
                        </a>
                    ))
                }
            </div>

            {/* Keep the link before punctuation so formatting cannot add a visible gap. */}
            {
                release !== null && (
                    <p class="mt-4 max-w-copy text-xs text-subtle">
                        Version <strong class="font-medium text-muted">{release.version}</strong>, released {release.date}. Each download is
                        named for its version, so you can always tell which build you have.{" "}
                        <a href={release.notes} target="_blank" rel="noopener" class="text-link hover:underline">
                            What's new
                        </a>
                    </p>
                )
            }

            <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-subtle">
                <span>Other Linux packages:</span>
                {
                    alternatives.map((alternative) => (
                        <a href={alternative.href} class="text-link hover:underline">
                            {alternative.label} <span class="text-subtle">({alternative.note})</span>
                        </a>
                    ))
                }
            </p>
            <p class="mt-2 max-w-copy text-xs text-subtle">
                No macOS build yet. On a Mac, use the <a href="/docs/quickstart/" class="text-link hover:underline">one-line install</a>. It
                does exactly the same thing.
            </p>
            {/* The setup link follows downloads for readers who still need to choose a machine. */}
            <p class="mt-2 max-w-copy text-xs text-subtle">
                The app is for running the sandbox on <strong class="text-muted">this</strong> computer. It can also run on a machine we
                host: <a href="/where-it-runs/" class="text-link hover:underline">compare the two</a>.
            </p>
        </section>

        <section class="mx-auto max-w-5xl px-6 pb-16">
            <div class="grid gap-6 sm:grid-cols-3">
                {
                    does.map((item) => (
                        <div class="flex flex-col gap-2">
                            <h2 class="text-base font-semibold text-content">{item.title}</h2>
                            <p class="text-sm text-muted">{item.body}</p>
                        </div>
                    ))
                }
            </div>
        </section>

<!-- Said plainly rather than buried: someone who is weighing an .exe against a shell command deserves to know they are the same thing. -->
        <section class="mx-auto max-w-5xl px-6 pb-24">
            <div class="border border-line bg-surface p-6">
                <h2 class="text-lg font-semibold text-content">The app runs the standard setup for you</h2>
                {/* Two columns keep the card's paragraphs at a readable measure. */}
                <div class="mt-3 grid gap-x-10 gap-y-3 sm:grid-cols-2">
                    <p class="max-w-copy text-sm text-muted">
                        The app runs the same script as the <a href="/docs/quickstart/" class="text-link hover:underline">one-line install</a>.
                        It creates the same Docker containers and private connection. You can still sign in at{" "}
                        <a href={APP_URL} class="text-link hover:underline">app.intentic.dev</a> from any device to reach the same sandbox.
                    </p>
                    <p class="max-w-copy text-sm text-muted">
                        The app updates itself. Removing the app does not delete your sandbox, files or history; they stay in Docker until you
                        remove them. Read <a href="/docs/updates/" class="text-link hover:underline">what every update promises to preserve</a>.
                    </p>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
