---
import { latestRelease } from "@intentic-dev/astro-integrations";
import { APP_URL } from "@intentic-dev/site-content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";

/* THE DOWNLOAD PAGE — the answer to the one objection the quickstart raises.
 *
 * Setting a sandbox up means running a command in a terminal, and that is where the flow is most often
 * abandoned: not because the command does more than an installer would, but because it arrives with none of
 * an installer's affordances — no publisher, no preview, no file list, no uninstaller. The app is those
 * affordances, so this page's job is to say what it is, be honest that it is the same thing underneath, and
 * hand over a file.
 *
 * The URLs are the site worker's vanity paths (worker.ts): a locally-staged installer if one exists, else a
 * redirect to the newest release's asset. No version in the LINKS — one that needs a bump every release is
 * one that eventually 404s — but the version is stated beside them, because the two are not the same promise:
 * a stable link is how the page keeps working, and a stated version is how somebody knows what they are about
 * to install and whether this project shipped anything this year. It is read, never typed (latestRelease),
 * and the page renders without it rather than with a stale one. */

const release = await latestRelease();

const title = "Download Intentic for Windows and Linux";
const description =
    "The Intentic desktop app runs your agent sandbox on your own computer without a terminal. It installs Docker if you need it, starts the sandbox, keeps it updated, and opens your workspace.";

const downloads = [
    {
        platform: "Windows",
        note: "Windows 10 and 11, 64-bit",
        href: "/desktop/windows",
        label: "Download for Windows",
        sub: ".exe installer · installs for your user, no admin rights",
        icon: "M0 3.449 9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801",
    },
    {
        platform: "Linux",
        note: "Any distribution, 64-bit",
        href: "/desktop/linux",
        label: "Download AppImage",
        sub: "AppImage · chmod +x and run",
        icon: "M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18z",
    },
];

const alternatives = [
    { label: ".deb", href: "/desktop/deb", note: "Debian, Ubuntu" },
    { label: ".rpm", href: "/desktop/rpm", note: "Fedora, RHEL, openSUSE" },
];

// What the app does that a browser cannot. Each one is a place the browser has to hand out a command today.
const does = [
    {
        title: "Sets your sandbox up without a terminal",
        body: "Installs Docker if the machine has none, starts the sandbox and its tunnel, and opens your workspace the moment it answers.",
    },
    {
        title: "Updates it with a button",
        body: "A sandbox cannot recreate its own container; that has to happen on the machine it runs on. The app is on that machine, so an update is a click instead of a command you paste there.",
    },
    {
        title: "Keeps it there after a reboot",
        body: "The sandbox restarts with Docker, and the app sits in your tray to start, stop, and read its logs.",
    },
];
---

<BaseLayout
    title={title}
    description={description}
    breadcrumbs={[{ name: "Download", path: "/download/" }]}
>
    <Nav />
    <main class="flex-1">
        <section class="mx-auto max-w-5xl px-6 pt-32 pb-16 max-sm:pt-28">
            <h1 class="text-4xl font-semibold tracking-tight text-content max-sm:text-3xl">Intentic on your computer</h1>
            <p class="mt-4 max-w-2xl text-lg text-muted">
                The same workspace, the same sandbox, the same everything, minus the terminal. Install it, sign in, and click
                <strong class="text-content">Run on this computer</strong>.
            </p>

            <div class="mt-10 grid gap-4 sm:grid-cols-2">
                {
                    downloads.map((download) => (
                        <a
                            href={download.href}
                            class="group flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-primary-600/50"
                        >
                            <span class="flex items-center gap-3">
                                <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current text-muted" aria-hidden="true">
                                    <path d={download.icon} />
                                </svg>
                                <span class="text-lg font-semibold text-content">{download.platform}</span>
                            </span>
                            <span class="text-sm font-medium text-link group-hover:underline">{download.label}</span>
                            <span class="text-xs text-subtle">{download.sub}</span>
                            <span class="mt-auto pt-2 text-xs text-subtle">{download.note}</span>
                        </a>
                    ))
                }
            </div>

            {/* The link sits at the END of the sentence on purpose: an anchor followed by punctuation puts the
                closing tag and the full stop on separate lines once this file is formatted, and the browser
                renders that gap as a space floating before the period. */}
            {
                release !== null && (
                    <p class="mt-4 text-xs text-subtle">
                        Version <strong class="font-medium text-muted">{release.version}</strong>, released {release.date}. Each download is
                        named for its version, so you can always tell which build you have.{" "}
                        <a href={release.notes} target="_blank" rel="noopener" class="text-link hover:underline">
                            What's new
                        </a>
                    </p>
                )
            }

            <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-subtle">
                <span>Other Linux packages:</span>
                {
                    alternatives.map((alternative) => (
                        <a href={alternative.href} class="text-link hover:underline">
                            {alternative.label} <span class="text-subtle">({alternative.note})</span>
                        </a>
                    ))
                }
            </p>
            <p class="mt-2 text-xs text-subtle">
                No macOS build yet. On a Mac, use the <a href="/docs/quickstart/" class="text-link hover:underline">one-line install</a>. It
                does exactly the same thing.
            </p>
        </section>

        <section class="mx-auto max-w-5xl px-6 pb-16">
            <div class="grid gap-6 sm:grid-cols-3">
                {
                    does.map((item) => (
                        <div class="flex flex-col gap-2">
                            <h2 class="text-base font-semibold text-content">{item.title}</h2>
                            <p class="text-sm text-muted">{item.body}</p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Said plainly rather than buried: someone who is weighing an .exe against a shell command deserves
             to know they are the same thing, and that neither of them is a second product to learn. -->
        <section class="mx-auto max-w-5xl px-6 pb-24">
            <div class="rounded-2xl border border-line bg-surface p-6">
                <h2 class="text-lg font-semibold text-content">It is the same install, with a window around it</h2>
                <p class="mt-3 max-w-3xl text-sm text-muted">
                    The app runs the very same setup script the
                    <a href="/docs/quickstart/" class="text-link hover:underline">one-line install</a> runs: same containers, same Docker,
                    same tunnel, and shows you the same workspace you would get in a browser. Nothing is stored in the app that isn't
                    stored in your browser, and you can sign in at
                    <a href={APP_URL} class="text-link hover:underline">app.intentic.dev</a> and reach the very same sandbox from any
                    device.
                </p>
                <p class="mt-3 max-w-3xl text-sm text-muted">
                    It updates itself, and removing it removes only the app: your sandbox, its files and its history stay in Docker until
                    you remove them yourself.
                </p>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
