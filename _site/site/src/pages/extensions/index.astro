---
import { REGISTRY_TOPIC } from "@intentic/registry";
import { apiHref, extensionLifecycle } from "@intentic-dev/site-content/api";
import { creatorSharePct, creditsPerCent, demoServiceCredits, installsPerDay, pool, runsPerDay } from "@intentic-dev/site-content/pool";
import { APP_URL } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import SpendFigure from "../../components/SpendFigure.astro";
import type { RegistryEntry } from "@intentic/registry";
import { loadGallery, markInitials, markLogoUrl, sourceHref } from "../../lib/registry";

/* The extension gallery: the official registry repository, rendered. Built from its two JSON files at build
 * time (src/lib/registry.ts), so this page has no backend behind it — curation is pull requests over there
 * and a deploy is how the result reaches the web.
 *
 * Verified leads and stars rank within it, which is what compareEntries already decided; the page just says
 * out loud what that ordering does and does not claim, because a gallery sorted by a number readers know is
 * purchasable will otherwise be read as a ranking of quality. */

const { entries, scannedAt, stale } = await loadGallery();

const verified = entries.filter((entry) => entry.trust === "verified");
const listed = entries.filter((entry) => entry.trust !== "verified");

const groups = [
    {
        key: "verified",
        heading: "Verified",
        blurb: "The deterministic scan and agent audit passed, and somebody here also read the source at the listed commit.",
        entries: verified,
    },
    {
        key: "listed",
        heading: "Everything the community has published",
        blurb: "The exact source passed the deterministic scan and agent audit. No human source review is claimed.",
        entries: listed,
    },
].filter((group) => group.entries.length > 0);

/* The nightly scan's cold answer at the pinned commit, folded to a browser's one question: will it load?
 * Absent checks say nothing — a listing repointed since last night, or a registry with no scanner — and the
 * card renders as it always did. This is evidence, not endorsement: "loads" and "somebody read it" are
 * different claims, made by different parties, and the page keeps them apart. */
const loadsProblem = (entry: RegistryEntry): string | undefined => {
    if (entry.checks === undefined) return undefined;
    if (entry.checks.manifest !== "ok") return `At the pinned commit, ${entry.checks.manifest}`;
    return entry.checks.bundle === "ok" || entry.checks.bundle === "none" ? undefined : `At the pinned commit, the bundle ${entry.checks.bundle}`;
};
const loadsOk = (entry: RegistryEntry): boolean => entry.checks !== undefined && loadsProblem(entry) === undefined;

// Built as one string rather than interpolated across template lines, where the newlines become stray spaces.
const scannedNote =
    scannedAt === undefined
        ? undefined
        : `Star counts last read ${new Date(scannedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}${
              stale ? ", from a vendored snapshot, because the registry was unreachable at build time" : ""
          }.`;

const n = (value: number) => value.toLocaleString(`en-GB`);

/* ── HOW A MEMBER SPENDS ──────────────────────────────────────────────────────────────────────────────────
 * The two ways a credit can leave a member's hands, which is the half of the economy this page never stated:
 * the revenue ring below says the pool is "split by the credits members spend — install donations and service
 * runs" and then leaves a reader to guess what either of those is. They are genuinely different products —
 * one flat donation attached to a deliberate install, one metered run of something with real upstream cost —
 * and the contrast is the clearest thing about the model, so it is drawn rather than listed.
 *
 * The diamond that opens the section lives in SpendFigure.astro, which owns its own geometry at two aspect
 * ratios. A third visual language on purpose: the ring below is the creator's side of the same money, the
 * panel further down is not about money at all, and three copies of one figure would flatten all three. */

/* WHAT A DAY BUYS, drawn to scale in both currencies: the same bar, five blocks against two hundred
 * hairlines. Both counts are computed from the prices, so the picture cannot outlive them — and both are
 * exact rather than suggestive, which is the only thing that makes a comb of that density honest rather
 * than decorative. */
const METER_W = 200;
const meterBars = (count: number, gap: number) => {
    const width = Math.max((METER_W - gap * (count - 1)) / count, 0.2);
    return Array.from({ length: count }, (_, i) => ({ x: i * (width + gap), width }));
};
const demoRunsPerDay = runsPerDay(demoServiceCredits);
const spendCards = [
    {
        tag: "One-time",
        kicker: "Premium extensions",
        heading: "Back an extension by installing it",
        blurb: "The install is the whole transaction. Nothing after it is counted, reported or charged for — using the thing you installed is free forever.",
        figure: n(pool.donationCredits),
        unit: "credits, flat",
        note: "Same number whatever you install, whoever made it. A price each listing could set would be the first thing anyone gamed.",
        steps: [
            "You approve the install, exactly like any other extension.",
            `${n(pool.donationCredits)} credits go to the publisher named in the manifest.`,
            "It is yours from then on — open it a thousand times, it never costs another credit.",
        ],
        guarantee: "If the donation cannot go through, the install stops. Nothing half-paid ever goes live.",
        cadence: "Reinstalling charges nothing. An update can donate again, at most once a month.",
        meter: meterBars(installsPerDay, 2.5),
        meterLabel: `A day's credits — ${n(installsPerDay)} installs`,
    },
    {
        tag: "Per run",
        kicker: "Premium services",
        heading: "Pay for a run that costs real money",
        blurb: "Some tools are not a prompt and some glue — they call paid data APIs or burn real compute every time. Those are services, and they are metered per run.",
        figure: "Its own price",
        unit: "shown before you agree",
        note: `Each service publishes what a run costs. The demo research run is ${n(demoServiceCredits)} credits, so a day's allowance is ${n(demoRunsPerDay)} of them.`,
        steps: [
            "Your agent finds one that fits and quotes the price and what is left today.",
            "You say yes in chat. One yes, one run.",
            "The platform makes the call for you — the provider never learns who you are, and you never hold its key.",
        ],
        guarantee: "If the service does not answer, your credits come straight back. A failed run costs nothing.",
        cadence: "Every repeat needs its own yes. Nothing loops without asking you again.",
        meter: meterBars(demoRunsPerDay, 0.45),
        meterLabel: `A day's credits — ${n(demoRunsPerDay)} demo runs`,
    },
];

/* The three rules that are true of BOTH lanes. Kept out of the cards deliberately: printed twice they read as
 * two policies that happen to match, and the single most reassuring thing about this model is that there is
 * one rule wearing two shapes. */
const spendRules = [
    {
        title: `${creatorSharePct}% reaches the creator`,
        body: "The same published share of a spent credit's value, whichever way you spent it. The rest runs the platform.",
    },
    {
        title: "Capped at what you paid",
        body: `Both draw on one meter — ${n(pool.dailyCredits)} credits a day, resetting at midnight UTC — so what you can direct to creators can never exceed your own membership. That is what makes it unfarmable.`,
    },
    {
        title: "Nothing is metered",
        body: "No usage counting anywhere, and none asked for. Installing is a choice you make; a run is one you approve. Credits you never spend pay nobody.",
    },
];

/* The lead figure: what an extension actually is, and how it meets the core. Drawn as a vertical architecture
 * — one extension is a container that bundles any of four contribution surfaces (Capabilities, UI, Automations,
 * Backend) and plugs, through one public interface, into the kernel every sandbox already has (Files, Events,
 * Agents, Secrets, Processes). A deliberately different visual language from the revenue cycle below: solid
 * panels and an edge-connector, not an orbit. Glyph paths are shared and positioned by gGlyph. */
const gGlyph = (paths: string, x: number, y: number, size = 18) =>
    `<svg x="${(x - size / 2).toFixed(1)}" y="${(y - size / 2).toFixed(1)}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const corePrimitives = [
    { name: "Files", d: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>' },
    { name: "Events", d: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>' },
    { name: "Agents", d: '<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>' },
    { name: "Secrets", d: '<circle cx="8" cy="16" r="4"/><path d="M10.8 13.2 20 4M17 7l2 2"/>' },
    { name: "Processes", d: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>' },
];

const buildingBlocks = [
    { name: "Capabilities", d: '<path d="M9 2v4M15 2v4"/><path d="M6 6h12v4a6 6 0 0 1-12 0z"/><path d="M12 16v5"/>' },
    { name: "UI", d: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01"/>' },
    { name: "Automations", d: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>' },
    { name: "Backend", d: '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/>' },
];

// horizontal architecture: several extensions, each bundling some surfaces, plug into the one core below
const EXT_W = 150;
const EXT_H = 104;
const EXT_Y = 16;
// each extension carries a couple of the four surfaces; across the three, all four appear
const extensions = [
    { x: 12, surfaces: [buildingBlocks[0], buildingBlocks[1]] },
    { x: 185, surfaces: [buildingBlocks[2], buildingBlocks[3]] },
    { x: 358, surfaces: [buildingBlocks[0], buildingBlocks[3]] },
];
const CORE = { x: 12, y: 170, w: 496, h: 68 };
const coreChips = corePrimitives.map((p, i) => ({ ...p, x: CORE.x + 70 + i * 90, y: CORE.y + 36 }));

/* The lifecycle diagram that replaces the old prose — deliberately NOT the card figure up top. Delivery is a
 * light one-way flow of chips; the half that matters, how a premium extension pays, is a drawn revenue cycle.
 * The ring geometry is computed so four arrowheads sit tangent to a clockwise loop (members → pool → split →
 * paid → renews). Labels stay terse; the one honesty line rides underneath.
 *
 * THE CHIPS ARE LINKS, and they come from the docs tree rather than from a string array here. They were six
 * inert words, which named the lifecycle to a visitor and then left them to guess where any of it was written
 * down — and the array they came from could drift from the pages that document them, because nothing tied the
 * two together. Now the same list drives this strip and the API overview's. */
const delivery = extensionLifecycle.slice(0, -1);
const earn = extensionLifecycle[extensionLifecycle.length - 1];

const ring = { cx: 150, cy: 150, r: 96 };
const ringStr = (deg: number, rr = ring.r) => {
    const a = (deg * Math.PI) / 180;
    return `${(ring.cx + rr * Math.cos(a)).toFixed(1)} ${(ring.cy + rr * Math.sin(a)).toFixed(1)}`;
};
const ringXY = (deg: number, rr = ring.r) => {
    const a = (deg * Math.PI) / 180;
    return [Number((ring.cx + rr * Math.cos(a)).toFixed(1)), Number((ring.cy + rr * Math.sin(a)).toFixed(1))];
};
const revNodes = [
    { label: "Members pay", xy: ringXY(270), anchor: "middle", lx: 150, ly: 30 },
    { label: "Pooled monthly", xy: ringXY(0), anchor: "start", lx: 262, ly: 155 },
    { label: "Split by credits spent", xy: ringXY(90), anchor: "middle", lx: 150, ly: 286 },
    { label: "Paid to creators", xy: ringXY(180), anchor: "end", lx: 38, ly: 155 },
];
// four short arcs at the quadrant midpoints; each carries one auto-oriented arrowhead so the loop reads clockwise
const revArcs = [315, 45, 135, 225].map((m) => `M ${ringStr(m - 3)} A ${ring.r} ${ring.r} 0 0 1 ${ringStr(m + 3)}`);
---

<BaseLayout
    title="Extensions · intentic"
    description="Every published intentic extension: what it adds, who wrote it, and the exact commit you'd install. A registry of pointers to other people's repositories; intentic hosts none of the code."
>
    <Nav />
    <main class="flex-1">
        <section class="relative overflow-hidden border-b border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/10 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">Extensions</div>
                <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
                    A small core. Everything else plugs in.
                </h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    The core is what every sandbox always has; building blocks add the rest — even the features that ship built in.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={apiHref("build")}>Build one</a>
                    <a class="btn btn-secondary" href={apiHref("publish")}>Get listed</a>
                </div>
            </div>
        </section>

        {/* The member's side of the money, before the creator's side below it — the ring down there splits a pool
            "by the credits members spend", and this is where a reader learns what spending one even looks like. */}
        <section class="relative overflow-hidden border-b border-line" aria-labelledby="credits-heading">
            <div class="absolute inset-0 bg-linear-to-b from-primary-600/8 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="grid-overlay"></div>
            <div class="relative mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
                    <div>
                        <div class="eyebrow text-link">Credits</div>
                        <h2 id="credits-heading" class="mt-3 text-2xl font-semibold tracking-tight text-content sm:text-3xl">
                            One membership. Two ways to spend it.
                        </h2>
                        <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                            Almost everything in this gallery installs free, from anyone, with no cut taken from anybody. A membership adds
                            credits — and a credit leaves your hands in exactly two places, both of which you trigger on purpose.
                        </p>
                        <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                            {
                                [
                                    { term: `$${pool.priceUsd}`, detail: "a month" },
                                    { term: n(pool.dailyCredits), detail: "credits a day" },
                                    { term: n(creditsPerCent), detail: "credits to the cent" },
                                ].map((stat) => (
                                    <div>
                                        <dt class="font-mono text-xl font-semibold tracking-tight text-content">{stat.term}</dt>
                                        <dd class="text-2xs text-subtle">{stat.detail}</dd>
                                    </div>
                                ))
                            }
                        </dl>
                    </div>

                    {/* The diamond: one source, two middles, one rule. */}
                    <figure class="w-full lg:justify-self-end">
                        <SpendFigure />
                    </figure>
                </div>

                {/* One card per way. Same skeleton on both, so the differences are the only thing that moves. */}
                <div class="mt-14 grid gap-6 lg:grid-cols-2">
                    {
                        spendCards.map((card) => (
                            <article class="card relative flex flex-col gap-5 overflow-hidden p-6 sm:p-7">
                                <div
                                    class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary-500/60 to-transparent"
                                    aria-hidden="true"
                                />
                                <header>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="chip border border-primary-600/35 bg-primary-600/12 text-primary-300">{card.tag}</span>
                                        <span class="eyebrow">{card.kicker}</span>
                                    </div>
                                    <h3 class="mt-3.5 text-lg font-semibold tracking-tight text-content">{card.heading}</h3>
                                    <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">{card.blurb}</p>
                                </header>

                                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-y border-line py-4">
                                    <span class="text-3xl font-semibold tracking-tight text-content">{card.figure}</span>
                                    <span class="text-sm text-muted">{card.unit}</span>
                                    <p class="mt-1 w-full text-2xs leading-relaxed text-subtle">{card.note}</p>
                                </div>

                                <ol class="flex flex-col gap-2.5">
                                    {card.steps.map((step, i) => (
                                        <li class="flex gap-3 text-sm leading-relaxed text-muted">
                                            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line bg-overlay/40 text-2xs font-semibold text-subtle">
                                                {i + 1}
                                            </span>
                                            <span>{step}</span>
                                        </li>
                                    ))}
                                </ol>

                                {/* A day's allowance to scale, in this lane's own units — five blocks against a comb. */}
                                <div class="mt-auto">
                                    <svg viewBox={`0 0 ${METER_W} 10`} class="h-2.5 w-full text-primary-400/70" preserveAspectRatio="none" aria-hidden="true">
                                        {card.meter.map((bar) => (
                                            <rect x={bar.x} y="0" width={bar.width} height="10" fill="currentColor" />
                                        ))}
                                    </svg>
                                    <p class="mt-2 text-2xs text-subtle">{card.meterLabel}</p>
                                </div>

                                <div class="flex flex-col gap-2 rounded-lg border border-success/25 bg-success/8 px-3.5 py-3">
                                    <p class="flex items-start gap-2 text-2xs leading-relaxed text-muted">
                                        <svg
                                            class="mt-px h-3.5 w-3.5 shrink-0 text-success"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.25"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path d="M20 6 9 17l-5-5" />
                                        </svg>
                                        <span>{card.guarantee}</span>
                                    </p>
                                    <p class="pl-5.5 text-2xs leading-relaxed text-subtle">{card.cadence}</p>
                                </div>
                            </article>
                        ))
                    }
                </div>

                {/* True of both lanes, which is the point of stating them once. */}
                <div class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-3">
                    {
                        spendRules.map((rule) => (
                            <div class="border-t border-line pt-4">
                                <h3 class="text-sm font-semibold tracking-tight text-content">{rule.title}</h3>
                                <p class="mt-1.5 text-2xs leading-relaxed text-subtle">{rule.body}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
                    <a class="btn btn-secondary" href={apiHref("earn")}>The arithmetic &amp; the public ledger</a>
                    <a class="text-link hover:underline" href="/docs/extensions/">Installing, and what premium means</a>
                </div>
            </div>
        </section>

        <section class="border-b border-line" aria-labelledby="lifecycle-heading">
            <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 lg:pt-14 lg:pb-20">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h2 id="lifecycle-heading" class="text-lg font-semibold tracking-tight text-content">From your repo to a payout</h2>
                    {/* NOT "paid while it's used": nothing is metered, and the section above now says so out loud. */}
                    <p class="text-xs text-subtle">Delivered once. Paid when people choose it.</p>
                </div>

                {/* One-way delivery, pivoting into the earn side. Every chip goes to the page that explains it. */}
                <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2">
                    <span class="eyebrow mr-1 text-subtle">Ship</span>
                    {
                        delivery.map((stage, i) => (
                            <Fragment>
                                {i > 0 && <span class="text-line-strong" aria-hidden="true">→</span>}
                                <a
                                    href={stage.href}
                                    title={stage.what}
                                    class="rounded-full border border-line bg-overlay/50 px-3 py-1 text-sm text-content no-underline transition-colors hover:border-primary-600/40 hover:text-link"
                                >
                                    {stage.step}
                                </a>
                            </Fragment>
                        ))
                    }
                    <span class="text-line-strong" aria-hidden="true">→</span>
                    <a
                        href={earn.href}
                        title={earn.what}
                        class="rounded-full border border-primary-600/40 bg-primary-600/10 px-3 py-1 text-sm font-medium text-link no-underline transition-colors hover:border-primary-600/70"
                    >
                        {earn.step}
                    </a>
                </div>

                {/* The highlight: a drawn revenue cycle on a blueprint canvas. */}
                <div class="relative mt-4 overflow-hidden rounded-2xl border border-line bg-canvas/60">
                    <div class="grid-overlay"></div>
                    <div
                        class="pointer-events-none absolute top-1/2 left-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full"
                        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent), transparent 70%)"
                        aria-hidden="true"
                    >
                    </div>
                    <div class="relative flex flex-col items-center px-5 py-9 text-center">
                        <div class="eyebrow text-link">How a premium extension earns</div>
                        <svg
                            viewBox="-80 0 476 300"
                            class="mt-4 h-auto w-full max-w-[560px] text-link"
                            role="img"
                            aria-label="A monthly cycle: members pay, a share is pooled, the pool is split by the credits members spend, and creators are paid — then it renews."
                        >
                            <defs>
                                <marker id="rev-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
                                    <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
                                </marker>
                            </defs>
                            <circle cx="150" cy="150" r="96" fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="1.5" stroke-dasharray="3 6" />
                            {revArcs.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#rev-arrow)" />)}
                            <circle cx="150" cy="150" r="30" fill="color-mix(in srgb, var(--color-primary-500) 12%, transparent)" stroke="currentColor" stroke-opacity="0.35" />
                            <text x="150" y="151" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" style="fill: var(--color-link)">$</text>
                            {
                                revNodes.map((n) => (
                                    <Fragment>
                                        <circle cx={n.xy[0]} cy={n.xy[1]} r="11" fill="var(--color-canvas)" stroke="currentColor" stroke-opacity="0.35" />
                                        <circle cx={n.xy[0]} cy={n.xy[1]} r="5" fill="currentColor" />
                                        <text x={n.lx} y={n.ly} text-anchor={n.anchor} dominant-baseline="central" font-size="13.5" font-weight="500" style="fill: var(--color-content)">
                                            {n.label}
                                        </text>
                                    </Fragment>
                                ))
                            }
                        </svg>
                        <p class="mt-2 max-w-copy text-2xs leading-relaxed text-subtle">
                            A monthly pool, split by the credits members actually spend — install donations and service runs — and published in the open. No usage is ever metered; free extensions never enter it; premium is opt-in.
                        </p>
                    </div>
                </div>

                <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs">
                    <a class="text-link hover:underline" href={apiHref("publish")}>Listing &amp; ranking</a>
                    <a class="text-link hover:underline" href={apiHref("manifest")}>What you approve</a>
                    <a class="text-link hover:underline" href={apiHref("build")}>Build one</a>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl space-y-16 px-6 py-16 lg:py-20">
            {
                groups.length === 0 && (
                    <section class="card px-6 py-12 text-center">
                        <h2 class="text-lg font-semibold tracking-tight text-content">Nothing listed yet.</h2>
                        <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                            The registry is open and empty, which makes this a good moment to be the first. Add the{" "}
                            <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repository and a nightly job opens your pull request
                            for you.
                        </p>
                        <a class="btn btn-primary mt-6" href={apiHref("build")}>
                            Build an extension
                        </a>
                    </section>
                )
            }

            {
                groups.map((group) => (
                    <section>
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 class="text-lg font-semibold tracking-tight text-content">{group.heading}</h2>
                            <p class="text-xs text-subtle">{group.blurb}</p>
                        </div>
                        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            {group.entries.map((entry) => (
                                <article class="card flex flex-col gap-3 p-6">
                                    <div class="flex items-center gap-3">
                                        {/* The author's mark over its initials — see markInitials for why this
                                            page draws two tiers where the app draws three. The image sits OVER
                                            the letters rather than instead of them, so a slug that 404s at
                                            build time reveals the tier below instead of a hole. */}
                                        <span class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-content/5 text-xs font-semibold text-muted">
                                            {markInitials(entry.name)}
                                            {markLogoUrl(entry) && (
                                                <img
                                                    src={markLogoUrl(entry)}
                                                    alt=""
                                                    referrerpolicy="no-referrer"
                                                    class="absolute h-5 w-5 object-contain"
                                                />
                                            )}
                                        </span>
                                        <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                            <h3 class="min-w-0 truncate font-mono text-sm font-medium text-content">{entry.name}</h3>
                                            {entry.tier === "premium" && (
                                                <span
                                                    class="shrink-0 rounded-sm bg-overlay/40 px-1 text-2xs font-medium text-primary-400"
                                                    title="Needs an intentic membership; installing donates credits to its creator"
                                                >
                                                    Premium
                                                </span>
                                            )}
                                            {entry.version && <span class="shrink-0 text-2xs text-subtle">{entry.version}</span>}
                                            {entry.stars !== undefined && <span class="ml-auto shrink-0 text-2xs text-subtle">★ {entry.stars}</span>}
                                        </div>
                                    </div>
                                    {entry.description && <p class="text-sm leading-relaxed text-muted">{entry.description}</p>}
                                    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-2xs">
                                        {loadsOk(entry) && (
                                            <span class="text-success" title="Re-checked at the pinned commit by the registry's nightly scan">
                                                ✓ loads
                                            </span>
                                        )}
                                        {loadsProblem(entry) && <span class="text-warning">{loadsProblem(entry)}</span>}
                                        {entry.category && <span class="text-subtle">{entry.category}</span>}
                                        {sourceHref(entry) && (
                                            <a class="text-link hover:underline" href={sourceHref(entry)} rel="noopener nofollow">
                                                Source
                                            </a>
                                        )}
                                        {entry.homepage && (
                                            <a class="text-link hover:underline" href={entry.homepage} rel="noopener nofollow">
                                                Homepage
                                            </a>
                                        )}
                                    </div>
                                    {/* The sha is the product. It is what you approve, what runs, and what a
                                        force-push upstream cannot change, so it is on the card rather than a
                                        click away, ready to paste into the install form. */}
                                    {entry.install?.ref && (
                                        <code class="overflow-x-auto rounded-md border border-line bg-canvas px-2.5 py-1.5 font-mono text-2xs whitespace-nowrap text-subtle">
                                            {entry.install.ref}
                                        </code>
                                    )}
                                </article>
                            ))}
                        </div>
                    </section>
                ))
            }

            <section aria-label="How an extension fits the core the sandbox already has">
                <div class="relative overflow-hidden rounded-2xl border border-line bg-canvas/60">
                    <div class="grid-overlay"></div>
                    <div
                        class="pointer-events-none absolute top-1/2 left-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full"
                        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent), transparent 70%)"
                        aria-hidden="true"
                    >
                    </div>
                    <figure class="relative flex flex-col items-center px-4 py-7 text-center sm:px-8">
                        <div class="eyebrow text-link">The shape of it</div>
                        <svg
                            viewBox="0 0 520 256"
                            class="mt-3 h-auto w-full max-w-[600px] text-link"
                            role="img"
                            aria-label="Several extensions — each bundling some of four surfaces (Capabilities, UI, Automations, Backend) — plug into the one core every sandbox has: Files, Events, Agents, Secrets and Processes."
                        >
                            {/* ===== the core: the kernel every sandbox has ===== */}
                            <rect x={CORE.x} y={CORE.y} width={CORE.w} height={CORE.h} rx="16" fill="color-mix(in srgb, var(--color-content) 4%, transparent)" stroke="var(--color-line-strong)" stroke-width="1.5" />
                            <text x={CORE.x + 20} y={CORE.y + 17} text-anchor="start" dominant-baseline="central" font-size="11" font-weight="700" letter-spacing="1" style="fill: var(--color-content)">CORE</text>
                            <g style="color: var(--color-muted)">
                                {
                                    coreChips.map((p) => (
                                        <Fragment>
                                            <Fragment set:html={gGlyph(p.d, p.x, p.y, 16)} />
                                            <text x={p.x} y={p.y + 16} text-anchor="middle" dominant-baseline="central" font-size="10.5" font-weight="500" style="fill: var(--color-muted)">{p.name}</text>
                                        </Fragment>
                                    ))
                                }
                            </g>

                            {/* ===== each extension: a container of surfaces, plugged into the core ===== */}
                            {
                                extensions.map((e) => {
                                    const cx = e.x + EXT_W / 2;
                                    return (
                                        <g>
                                            {/* plug: two pins seated into sockets on the core rim */}
                                            <rect x={cx - 13} y={EXT_Y + EXT_H} width="6" height="54" rx="1.5" fill="color-mix(in srgb, var(--color-primary-500) 55%, transparent)" />
                                            <rect x={cx + 7} y={EXT_Y + EXT_H} width="6" height="54" rx="1.5" fill="color-mix(in srgb, var(--color-primary-500) 55%, transparent)" />
                                            <rect x={cx - 15} y={CORE.y - 4} width="10" height="6" rx="1" fill="var(--color-canvas)" stroke="var(--color-line-strong)" stroke-width="1" />
                                            <rect x={cx + 5} y={CORE.y - 4} width="10" height="6" rx="1" fill="var(--color-canvas)" stroke="var(--color-line-strong)" stroke-width="1" />
                                            {/* the container */}
                                            <rect x={e.x} y={EXT_Y} width={EXT_W} height={EXT_H} rx="14" fill="color-mix(in srgb, var(--color-primary-500) 9%, transparent)" stroke="color-mix(in srgb, var(--color-primary-500) 46%, transparent)" stroke-width="1.5" />
                                            <text x={cx} y={EXT_Y + 16} text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="700" letter-spacing="1" style="fill: var(--color-link)">EXTENSION</text>
                                            {
                                                e.surfaces.map((s, j) => {
                                                    const chipY = EXT_Y + 30 + j * 36;
                                                    return (
                                                        <g>
                                                            <rect x={e.x + 10} y={chipY} width={EXT_W - 20} height="30" rx="8" fill="color-mix(in srgb, var(--color-primary-500) 13%, transparent)" stroke="color-mix(in srgb, var(--color-primary-500) 30%, transparent)" stroke-width="1.25" />
                                                            <Fragment set:html={gGlyph(s.d, e.x + 26, chipY + 15, 16)} />
                                                            <text x={e.x + 44} y={chipY + 15} text-anchor="start" dominant-baseline="central" font-size="11" font-weight="600" style="fill: var(--color-content)">{s.name}</text>
                                                        </g>
                                                    );
                                                })
                                            }
                                        </g>
                                    );
                                })
                            }
                        </svg>
                    </figure>
                </div>
                {scannedNote && <p class="mt-6 text-2xs text-subtle">{scannedNote}</p>}
            </section>
        </div>

        <section class="border-t border-line">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Extend it yourself.</h2>
                <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                    The first-party views ship against the same public API a third-party bundle uses. Nothing here is a privileged path you can't
                    take.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href={apiHref("build")}>Build an extension</a>
                    <a class="btn btn-secondary" href={APP_URL}>Open the app</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
