---
import { REGISTRY_TOPIC } from "@intentic/registry";
import { developersHref, extensionLifecycle } from "@intentic-dev/site-content/developers";
import { creatorSharePct, pool } from "@intentic-dev/site-content/pool";
import { APP_URL } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import type { RegistryEntry } from "@intentic/registry";
import { loadGallery, markArtUrl, markInitials, markLogoUrl, sourceHref } from "../../lib/registry";

/* The extension gallery: the official registry repository, rendered. Built from its two JSON files at build
 * time (src/lib/registry.ts), so this page has no backend behind it: curation is pull requests over there
 * and a deploy is how the result reaches the web.
 *
 * A DISCOVERY SURFACE, and the layout now says so: the listings come first. This page used to open with the
 * site's heaviest economics: the spend diamond, two spend cards, the revenue ring: before showing a single
 * listing, which put the marketplace below the fold of its own page. The whole economy lives at /earn/ now;
 * what stays here is one band of headline figures and the lifecycle strip, each linking out, and both sit at
 * the foot: the hero hands straight over to the gallery, so the listings and the diagram share one screen.
 *
 * Verified leads and stars rank within it, which is what compareEntries already decided; the page just says
 * out loud what that ordering does and does not claim, because a gallery sorted by a number readers know is
 * purchasable will otherwise be read as a ranking of quality. */

const { entries, scannedAt, stale } = await loadGallery();

const verified = entries.filter((entry) => entry.trust === "verified");
const listed = entries.filter((entry) => entry.trust !== "verified");

const groups = [
    {
        key: "verified",
        heading: "Verified",
        blurb: "Automated checks and an AI agent's code review passed. Someone from intentic also read the source at the listed commit.",
        entries: verified,
    },
    {
        key: "listed",
        heading: "Everything the community has published",
        blurb: "Automated checks and an AI agent's code review passed for the listed commit. It has not been reviewed by a person at intentic.",
        entries: listed,
    },
].filter((group) => group.entries.length > 0);

/* The nightly scan's cold answer at the pinned commit, folded to a browser's one question: will it load?
 * Absent checks say nothing: a listing repointed since last night, or a registry with no scanner, and the
 * card renders as it always did. This is evidence, not endorsement: "loads" and "somebody read it" are
 * different claims, made by different parties, and the page keeps them apart. */
const loadsProblem = (entry: RegistryEntry): string | undefined => {
    if (entry.checks === undefined) return undefined;
    if (entry.checks.manifest !== "ok") return `At the pinned commit, ${entry.checks.manifest}`;
    return entry.checks.bundle === "ok" || entry.checks.bundle === "none" ? undefined : `At the pinned commit, the bundle ${entry.checks.bundle}`;
};
const loadsOk = (entry: RegistryEntry): boolean => entry.checks !== undefined && loadsProblem(entry) === undefined;

// Built as one string rather than interpolated across template lines, where the newlines become stray spaces.
const scannedNote =
    scannedAt === undefined
        ? undefined
        : `Star counts last read ${new Date(scannedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}${
              stale ? ", from a vendored snapshot, because the registry was unreachable at build time" : ""
          }.`;

const n = (value: number) => value.toLocaleString(`en-GB`);

/* The three headline figures of the economy: the WHOLE of the money story this page tells. Everything they
 * summarize (the spend cards, the diamond, the revenue ring, the fine print) is /earn/'s job; a band that
 * grew past one row would be the old page growing back. */
const moneyFigures = [
    { term: `$${pool.priceUsd}/mo`, detail: "one membership, every premium extension" },
    { term: `${n(pool.dailyCredits)}/day`, detail: "credits: installs donate them, service runs spend them" },
    { term: `${creatorSharePct}%`, detail: "of every spent credit reaches its creator" },
];

/* The lead figure: what an extension actually is, and how it meets the core. Drawn as a vertical architecture
 *: one extension is a container that bundles any of four contribution surfaces (Capabilities, UI, Automations,
 * Backend) and plugs, through one public interface, into the kernel every sandbox already has (Files, Events,
 * Agents, Secrets, Processes). Glyph paths are shared and positioned by gGlyph. */
const gGlyph = (paths: string, x: number, y: number, size = 18) =>
    `<svg x="${(x - size / 2).toFixed(1)}" y="${(y - size / 2).toFixed(1)}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const corePrimitives = [
    { name: "Files", d: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>' },
    { name: "Events", d: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>' },
    { name: "Agents", d: '<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>' },
    { name: "Secrets", d: '<circle cx="8" cy="16" r="4"/><path d="M10.8 13.2 20 4M17 7l2 2"/>' },
    { name: "Processes", d: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>' },
];

const buildingBlocks = [
    { name: "Capabilities", d: '<path d="M9 2v4M15 2v4"/><path d="M6 6h12v4a6 6 0 0 1-12 0z"/><path d="M12 16v5"/>' },
    { name: "UI", d: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01"/>' },
    { name: "Automations", d: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>' },
    { name: "Backend", d: '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/>' },
];

// horizontal architecture: several extensions, each bundling some surfaces, plug into the one core below
const EXT_W = 150;
const EXT_H = 104;
const EXT_Y = 16;
// each extension carries a couple of the four surfaces; across the three, all four appear
const extensions = [
    { x: 12, surfaces: [buildingBlocks[0], buildingBlocks[1]] },
    { x: 185, surfaces: [buildingBlocks[2], buildingBlocks[3]] },
    { x: 358, surfaces: [buildingBlocks[0], buildingBlocks[3]] },
];
const CORE = { x: 12, y: 170, w: 496, h: 68 };
const coreChips = corePrimitives.map((p, i) => ({ ...p, x: CORE.x + 70 + i * 90, y: CORE.y + 36 }));

/* THE CHIPS ARE LINKS, and they come from the docs tree rather than from a string array here: the same list
 * drives this strip and the API overview's, so the two cannot drift. The Earn chip wears the accent because it
 * is the one that leaves the developer's track for the economy's own page; Update after it is what makes the
 * strip a cycle rather than a line. */
---

<BaseLayout
    title="Extensions · intentic"
    description="Browse published intentic extensions. Each listing shows what it adds, who wrote it and the exact source commit you would install."
>
    <Nav />
    <main class="flex-1">
        <section class="page-hero">
            <div class="below-bar relative mx-auto max-w-7xl px-6 pb-14">
                <div class="eyebrow">Extensions</div>
                <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">
                    Add tools and views to intentic.
                </h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    Extensions can add pages, panels, file viewers, connections and automations. Even built-in features use the same extension system.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={developersHref("build")}>Build one</a>
                    <a class="btn btn-secondary" href={developersHref("publish")}>Get listed</a>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl space-y-10 px-6 pt-8 pb-16 lg:pb-20">
            {
                groups.length === 0 && (
                    <section class="card px-6 py-12 text-center">
                        <h2 class="text-lg font-semibold tracking-tight text-content">Nothing listed yet.</h2>
                        <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                            Be the first to publish one. Add the <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repository, and
                            the registry bot will open a listing pull request for you.
                        </p>
                        <a class="btn btn-primary mt-6" href={developersHref("build")}>
                            Build an extension
                        </a>
                    </section>
                )
            }

            {
                groups.map((group) => (
                    <section>
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 class="text-lg font-semibold tracking-tight text-content">{group.heading}</h2>
                            <p class="text-xs text-subtle">{group.blurb}</p>
                        </div>
                        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            {group.entries.map((entry) => (
                                <article class="card flex flex-col gap-3 p-6">
                                    <div class="flex items-center gap-3">
                                        {/* The author's mark over its initials: see markInitials for why this
                                            page draws three tiers where the app draws four. The image sits OVER
                                            the letters rather than instead of them, so a slug that 404s at
                                            build time reveals the tier below instead of a hole.

                                            Artwork is the one tier that fills the plate rather than sitting on
                                            it — an app icon is its whole square — so where a row has drawn its
                                            own, the neutral plate underneath is dropped rather than framing it
                                            in a ring of grey. */}
                                        <span
                                            class:list={[
                                                "relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden border border-line text-xs font-semibold text-muted",
                                                !markArtUrl(entry) && "bg-content/5",
                                            ]}
                                        >
                                            {!markArtUrl(entry) && markInitials(entry.name)}
                                            {markArtUrl(entry) ? (
                                                <img src={markArtUrl(entry)} alt="" class="h-full w-full object-cover" />
                                            ) : (
                                                markLogoUrl(entry) && (
                                                    <img
                                                        src={markLogoUrl(entry)}
                                                        alt=""
                                                        referrerpolicy="no-referrer"
                                                        class="absolute h-5 w-5 object-contain"
                                                    />
                                                )
                                            )}
                                        </span>
                                        <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                            <h3 class="min-w-0 truncate font-mono text-sm font-medium text-content">{entry.name}</h3>
                                            {entry.tier === "premium" && (
                                                <span
                                                    class="shrink-0 bg-overlay/40 px-1 text-2xs font-medium text-primary-400"
                                                    title="Needs an intentic membership; installing donates credits to its creator"
                                                >
                                                    Premium
                                                </span>
                                            )}
                                            {entry.version && <span class="shrink-0 text-2xs text-subtle">{entry.version}</span>}
                                            {entry.stars !== undefined && <span class="ml-auto shrink-0 text-2xs text-subtle">★ {entry.stars}</span>}
                                        </div>
                                    </div>
                                    {entry.description && <p class="text-sm leading-relaxed text-muted">{entry.description}</p>}
                                    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-2xs">
                                        {loadsOk(entry) && (
                                            <span class="text-success" title="Re-checked at the pinned commit by the registry's nightly scan">
                                                ✓ loads
                                            </span>
                                        )}
                                        {loadsProblem(entry) && <span class="text-warning">{loadsProblem(entry)}</span>}
                                        {entry.category && <span class="text-subtle">{entry.category}</span>}
                                        {sourceHref(entry) && (
                                            <a class="text-link hover:underline" href={sourceHref(entry)} rel="noopener nofollow">
                                                Source
                                            </a>
                                        )}
                                        {entry.homepage && (
                                            <a class="text-link hover:underline" href={entry.homepage} rel="noopener nofollow">
                                                Homepage
                                            </a>
                                        )}
                                    </div>
                                    {/* The sha is the product. It is what you approve, what runs, and what a
                                        force-push upstream cannot change, so it is on the card rather than a
                                        click away, ready to paste into the install form. */}
                                    {entry.install?.ref && (
                                        <code class="overflow-x-auto border border-line bg-canvas px-2.5 py-1.5 font-mono text-2xs whitespace-nowrap text-subtle">
                                            {entry.install.ref}
                                        </code>
                                    )}
                                </article>
                            ))}
                        </div>
                    </section>
                ))
            }

            <section aria-label="How an extension fits the core the sandbox already has">
                <div class="relative overflow-hidden border border-line bg-canvas/60">
                    <div class="wall"></div>
                    <div
                        class="pointer-events-none absolute top-1/2 left-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full"
                        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent), transparent 70%)"
                        aria-hidden="true"
                    >
                    </div>
                    <figure class="relative flex flex-col items-center px-4 py-5 text-center sm:px-8">
                        <div class="eyebrow eyebrow-bare">The shape of it</div>
                        <svg
                            viewBox="0 0 520 256"
                            class="mt-3 h-auto w-full max-w-[520px] text-link"
                            role="img"
                            aria-label="Several extensions bundle Capabilities, UI, Automations or Backend surfaces and plug into the core every sandbox has: Files, Events, Agents, Secrets and Processes."
                        >
                            {/* ===== the core: the kernel every sandbox has ===== */}
                            <rect x={CORE.x} y={CORE.y} width={CORE.w} height={CORE.h} rx="16" fill="color-mix(in srgb, var(--color-content) 4%, transparent)" stroke="var(--color-line-strong)" stroke-width="1.5" />
                            <text x={CORE.x + 20} y={CORE.y + 17} text-anchor="start" dominant-baseline="central" font-size="11" font-weight="700" letter-spacing="1" style="fill: var(--color-content)">CORE</text>
                            <g style="color: var(--color-muted)">
                                {
                                    coreChips.map((p) => (
                                        <Fragment>
                                            <Fragment set:html={gGlyph(p.d, p.x, p.y, 16)} />
                                            <text x={p.x} y={p.y + 16} text-anchor="middle" dominant-baseline="central" font-size="10.5" font-weight="500" style="fill: var(--color-muted)">{p.name}</text>
                                        </Fragment>
                                    ))
                                }
                            </g>

                            {/* ===== each extension: a container of surfaces, plugged into the core ===== */}
                            {
                                extensions.map((e) => {
                                    const cx = e.x + EXT_W / 2;
                                    return (
                                        <g>
                                            {/* plug: two pins seated into sockets on the core rim */}
                                            <rect x={cx - 13} y={EXT_Y + EXT_H} width="6" height="54" rx="1.5" fill="color-mix(in srgb, var(--color-primary-500) 55%, transparent)" />
                                            <rect x={cx + 7} y={EXT_Y + EXT_H} width="6" height="54" rx="1.5" fill="color-mix(in srgb, var(--color-primary-500) 55%, transparent)" />
                                            <rect x={cx - 15} y={CORE.y - 4} width="10" height="6" rx="1" fill="var(--color-canvas)" stroke="var(--color-line-strong)" stroke-width="1" />
                                            <rect x={cx + 5} y={CORE.y - 4} width="10" height="6" rx="1" fill="var(--color-canvas)" stroke="var(--color-line-strong)" stroke-width="1" />
                                            {/* the container */}
                                            <rect x={e.x} y={EXT_Y} width={EXT_W} height={EXT_H} rx="14" fill="color-mix(in srgb, var(--color-primary-500) 9%, transparent)" stroke="color-mix(in srgb, var(--color-primary-500) 46%, transparent)" stroke-width="1.5" />
                                            <text x={cx} y={EXT_Y + 16} text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="700" letter-spacing="1" style="fill: var(--color-link)">EXTENSION</text>
                                            {
                                                e.surfaces.map((s, j) => {
                                                    const chipY = EXT_Y + 30 + j * 36;
                                                    return (
                                                        <g>
                                                            <rect x={e.x + 10} y={chipY} width={EXT_W - 20} height="30" rx="8" fill="color-mix(in srgb, var(--color-primary-500) 13%, transparent)" stroke="color-mix(in srgb, var(--color-primary-500) 30%, transparent)" stroke-width="1.25" />
                                                            <Fragment set:html={gGlyph(s.d, e.x + 26, chipY + 15, 16)} />
                                                            <text x={e.x + 44} y={chipY + 15} text-anchor="start" dominant-baseline="central" font-size="11" font-weight="600" style="fill: var(--color-content)">{s.name}</text>
                                                        </g>
                                                    );
                                                })
                                            }
                                        </g>
                                    );
                                })
                            }
                        </svg>
                    </figure>
                </div>
                {scannedNote && <p class="mt-6 text-2xs text-subtle">{scannedNote}</p>}
            </section>

            <section aria-labelledby="lifecycle-heading">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h2 id="lifecycle-heading" class="text-lg font-semibold tracking-tight text-content">From your repo to a payout, and around again</h2>
                    <p class="text-xs text-subtle">Delivered once. Paid when people choose it. Renewed when you maintain it.</p>
                </div>

                {/* The whole cycle as chips. Every chip goes to the page that explains it, and the Earn chip
                    leaves this track for the economy's own page. */}
                <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2">
                    {
                        extensionLifecycle.map((stage, i) => (
                            <Fragment>
                                {i > 0 && <span class="text-line-strong" aria-hidden="true">→</span>}
                                <a
                                    href={stage.href}
                                    title={stage.what}
                                    class={
                                        stage.step === "Earn"
                                            ? "rounded-full border border-primary-600/40 bg-primary-600/10 px-3 py-1 text-sm font-medium text-link no-underline transition-colors hover:border-primary-600/70"
                                            : "rounded-full border border-line bg-overlay/50 px-3 py-1 text-sm text-content no-underline transition-colors hover:border-primary-600/40 hover:text-link"
                                    }
                                >
                                    {stage.step}
                                </a>
                            </Fragment>
                        ))
                    }
                    <span class="text-line-strong" aria-hidden="true">↻</span>
                </div>

                <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs">
                    <a class="text-link hover:underline" href={developersHref("publish")}>Listing &amp; ranking</a>
                    <a class="text-link hover:underline" href={developersHref("maintain")}>Maintain &amp; grow</a>
                    <a class="text-link hover:underline" href="/earn/">The pool &amp; the ledger</a>
                </div>
            </section>
        </div>

        {/* The money, in one row: almost everything above installs free, and the whole economy behind the
            Premium badges is /earn/'s page to tell. It sits at the foot rather than under the hero, where it
            cost the gallery and the diagram their shared screen; the lifecycle strip directly above it is
            where a reader is already looking at Earn, so the figures land next to the question. Still the
            ONLY economics on the page. */}
        <section class="plinth" aria-label="How premium extensions are paid for">
            <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-6 py-5">
                {
                    moneyFigures.map((stat) => (
                        <div class="flex items-baseline gap-2">
                            <span class="font-mono text-sm font-semibold tracking-tight text-content">{stat.term}</span>
                            <span class="text-2xs text-subtle">{stat.detail}</span>
                        </div>
                    ))
                }
                <a class="text-xs text-link hover:underline sm:ml-auto" href="/earn/">How the pool works →</a>
            </div>
        </section>

        <section class="border-t band-rule">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Extend it yourself.</h2>
                <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                    The first-party views ship against the same public API a third-party bundle uses. Nothing here is a privileged path you can't
                    take.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href={developersHref("build")}>Build an extension</a>
                    <a class="btn btn-secondary" href={APP_URL}>Open the app</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
