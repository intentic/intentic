---
import { REGISTRY_TOPIC } from "@intentic/registry";
import { APP_URL } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import type { RegistryEntry } from "@intentic/registry";
import { loadGallery, markInitials, markLogoUrl, sourceHref } from "../../lib/registry";

/* The extension gallery: the official registry repository, rendered. Built from its two JSON files at build
 * time (src/lib/registry.ts), so this page has no backend behind it — curation is pull requests over there
 * and a deploy is how the result reaches the web.
 *
 * Verified leads and stars rank within it, which is what compareEntries already decided; the page just says
 * out loud what that ordering does and does not claim, because a gallery sorted by a number readers know is
 * purchasable will otherwise be read as a ranking of quality. */

const { entries, scannedAt, stale } = await loadGallery();

const verified = entries.filter((entry) => entry.trust === "verified");
const listed = entries.filter((entry) => entry.trust !== "verified");

const groups = [
    { key: "verified", heading: "Verified", blurb: "Somebody here read the source at the listed commit.", entries: verified },
    { key: "listed", heading: "Everything the community has published", blurb: "The pointer resolves and the manifest parses. Nobody has read the code.", entries: listed },
].filter((group) => group.entries.length > 0);

/* The nightly scan's cold answer at the pinned commit, folded to a browser's one question: will it load?
 * Absent checks say nothing — a listing repointed since last night, or a registry with no scanner — and the
 * card renders as it always did. This is evidence, not endorsement: "loads" and "somebody read it" are
 * different claims, made by different parties, and the page keeps them apart. */
const loadsProblem = (entry: RegistryEntry): string | undefined => {
    if (entry.checks === undefined) return undefined;
    if (entry.checks.manifest !== "ok") return `At the pinned commit, ${entry.checks.manifest}`;
    return entry.checks.bundle === "ok" || entry.checks.bundle === "none" ? undefined : `At the pinned commit, the bundle ${entry.checks.bundle}`;
};
const loadsOk = (entry: RegistryEntry): boolean => entry.checks !== undefined && loadsProblem(entry) === undefined;

// Built as one string rather than interpolated across template lines, where the newlines become stray spaces.
const scannedNote =
    scannedAt === undefined
        ? undefined
        : `Star counts last read ${new Date(scannedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}${
              stale ? ", from a vendored snapshot, because the registry was unreachable at build time" : ""
          }.`;

/* The "small core, everything else plugs in" figure that leads the page. Drawn in markup rather than an image,
 * in the same convention as ProductFigure.astro (24px glyph, stroke 1.5), so it reads at any width and stays in
 * palette. Core = the kernel the sandbox always has; a building block adds some of four things — reach for the
 * agent (Capabilities), surfaces for you (UI), event sources (Automations), a service of its own (Backend) — on
 * the same public interface the first-party ones use, which is the claim this whole page rests on. The four
 * mirror the manifest's own contribution surface, not the narrower "capabilities/UI/API" first cut. */
const glyph = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

const layersGlyph = glyph('<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>');

const corePrimitives = [
    {
        name: "Files",
        glyph: glyph('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>'),
        detail: "Read, write and watch the workspace — every change under version control.",
    },
    {
        name: "Events",
        glyph: glyph('<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>'),
        detail: "Notice when something changes or arrives, and wake an agent to handle it.",
    },
    {
        name: "Agents",
        glyph: glyph('<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>'),
        detail: "Run many at once, each in its own worktree — pick the model, approve, review.",
    },
    {
        name: "Secrets",
        glyph: glyph('<circle cx="8" cy="16" r="4"/><path d="M10.8 13.2 20 4M17 7l2 2"/>'),
        detail: "Keys kept inside the sandbox, so agents can act on your systems, not just talk.",
    },
    {
        name: "Processes",
        glyph: glyph('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>'),
        detail: "Terminals, browsers, ports and live listeners the agent drives.",
    },
];

const buildingBlocks = [
    {
        name: "Capabilities",
        glyph: glyph('<path d="M9 2v4M15 2v4"/><path d="M6 6h12v4a6 6 0 0 1-12 0z"/><path d="M12 16v5"/>'),
        detail: "New tools and connections the agent can run — a CLI, an MCP server, a signed-in browser, a machine — each with its own secret and a skill that teaches its use.",
    },
    {
        name: "UI",
        glyph: glyph('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01"/>'),
        detail: "New views, panels and file viewers, drawn from the shape of your workspace files — so what an agent edits is what you see.",
    },
    {
        name: "Automations",
        glyph: glyph('<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>'),
        detail: "New things to listen for — a message, an email, an alert, a schedule — each waking an agent to handle it.",
    },
    {
        name: "Backend",
        glyph: glyph('<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/>'),
        detail: "Its own routes and long-running services, running under a namespace of its own.",
    },
];
---

<BaseLayout
    title="Extensions · intentic"
    description="Every published intentic extension: what it adds, who wrote it, and the exact commit you'd install. A registry of pointers to other people's repositories; intentic hosts none of the code."
>
    <Nav />
    <main class="flex-1">
        <section class="relative overflow-hidden border-b border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/10 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">Extensions</div>
                <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
                    A small core. Everything else plugs in.
                </h1>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                    intentic is a lean core and a slot for building blocks. The core is the handful of things every sandbox always has. A building
                    block drops into the slot and adds the rest — and the surfaces you already use are built the same way, on the same public
                    interface a stranger's bundle gets. Nothing here is a privileged path you can't take yourself.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href="/docs/extensions/build/">Build one</a>
                    <a class="btn btn-secondary" href="/docs/extensions/publish/">Get listed</a>
                </div>
            </div>
        </section>

        <section class="border-b border-line">
            <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 lg:pt-14 lg:pb-20">
                <figure class="space-y-5 rounded-2xl border border-line bg-canvas/40 p-5 sm:p-7">
                    <div class="card p-5 sm:p-6">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <div class="eyebrow text-link">The core</div>
                            <p class="text-2xs text-subtle">in every sandbox, always — nothing to install, nothing to switch off</p>
                        </div>
                        <div class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
                            {
                                corePrimitives.map((primitive) => (
                                    <div class="rounded-xl border border-line bg-overlay/40 p-4">
                                        <span class="flex items-center gap-2 text-link">
                                            <Fragment set:html={primitive.glyph} />
                                            <span class="text-sm font-medium text-content">{primitive.name}</span>
                                        </span>
                                        <p class="mt-2 text-xs leading-relaxed text-subtle">{primitive.detail}</p>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="mt-4 flex items-start gap-2 border-t border-line pt-4 text-2xs leading-relaxed text-subtle">
                            <span class="shrink-0 text-muted [&>svg]:h-4 [&>svg]:w-4">
                                <Fragment set:html={layersGlyph} />
                            </span>
                            <span>Sign-in, settings, tunnels, logs and on/off switches — and the extension system itself, which loads every block below.</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-center gap-2 text-center text-2xs text-subtle">
                        <span class="h-px w-6 bg-line-strong sm:w-10" />
                        everything past here is a building block you install
                        <span aria-hidden="true">↓</span>
                        <span class="h-px w-6 bg-line-strong sm:w-10" />
                    </div>

                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        {
                            buildingBlocks.map((block) => (
                                <div class="rounded-xl border border-primary-600/30 bg-primary-600/[0.05] p-5">
                                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-600/15 text-link">
                                        <Fragment set:html={block.glyph} />
                                    </span>
                                    <div class="mt-3 text-sm font-medium text-content">{block.name}</div>
                                    <p class="mt-1.5 text-xs leading-relaxed text-muted">{block.detail}</p>
                                </div>
                            ))
                        }
                    </div>

                    <figcaption class="text-center text-2xs text-subtle">
                        The gallery below is these blocks, published — a repository and a manifest each.
                    </figcaption>
                </figure>
            </div>
        </section>

        <div class="mx-auto max-w-7xl space-y-16 px-6 py-16 lg:py-20">
            {
                groups.length === 0 && (
                    <section class="card px-6 py-12 text-center">
                        <h2 class="text-lg font-semibold tracking-tight text-content">Nothing listed yet.</h2>
                        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
                            The registry is open and empty, which makes this a good moment to be the first. Add the{" "}
                            <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repository and a nightly job opens your pull request
                            for you.
                        </p>
                        <a class="btn btn-primary mt-6" href="/docs/extensions/build/">
                            Build an extension
                        </a>
                    </section>
                )
            }

            {
                groups.map((group) => (
                    <section>
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 class="text-lg font-semibold tracking-tight text-content">{group.heading}</h2>
                            <p class="text-xs text-subtle">{group.blurb}</p>
                        </div>
                        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            {group.entries.map((entry) => (
                                <article class="card flex flex-col gap-3 p-6">
                                    <div class="flex items-center gap-3">
                                        {/* The author's mark over its initials — see markInitials for why this
                                            page draws two tiers where the app draws three. The image sits OVER
                                            the letters rather than instead of them, so a slug that 404s at
                                            build time reveals the tier below instead of a hole. */}
                                        <span class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-content/5 text-xs font-semibold text-muted">
                                            {markInitials(entry.name)}
                                            {markLogoUrl(entry) && (
                                                <img
                                                    src={markLogoUrl(entry)}
                                                    alt=""
                                                    referrerpolicy="no-referrer"
                                                    class="absolute h-5 w-5 object-contain"
                                                />
                                            )}
                                        </span>
                                        <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                            <h3 class="min-w-0 truncate font-mono text-sm font-medium text-content">{entry.name}</h3>
                                            {entry.version && <span class="shrink-0 text-2xs text-subtle">{entry.version}</span>}
                                            {entry.stars !== undefined && <span class="ml-auto shrink-0 text-2xs text-subtle">★ {entry.stars}</span>}
                                        </div>
                                    </div>
                                    {entry.description && <p class="text-sm leading-relaxed text-muted">{entry.description}</p>}
                                    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-2xs">
                                        {loadsOk(entry) && (
                                            <span class="text-success" title="Re-checked at the pinned commit by the registry's nightly scan">
                                                ✓ loads
                                            </span>
                                        )}
                                        {loadsProblem(entry) && <span class="text-warning">{loadsProblem(entry)}</span>}
                                        {entry.category && <span class="text-subtle">{entry.category}</span>}
                                        {sourceHref(entry) && (
                                            <a class="text-link hover:underline" href={sourceHref(entry)} rel="noopener nofollow">
                                                Source
                                            </a>
                                        )}
                                        {entry.homepage && (
                                            <a class="text-link hover:underline" href={entry.homepage} rel="noopener nofollow">
                                                Homepage
                                            </a>
                                        )}
                                    </div>
                                    {/* The sha is the product. It is what you approve, what runs, and what a
                                        force-push upstream cannot change, so it is on the card rather than a
                                        click away, ready to paste into the install form. */}
                                    {entry.install?.ref && (
                                        <code class="overflow-x-auto rounded-md border border-line bg-canvas px-2.5 py-1.5 font-mono text-2xs whitespace-nowrap text-subtle">
                                            {entry.install.ref}
                                        </code>
                                    )}
                                </article>
                            ))}
                        </div>
                    </section>
                ))
            }

            <section class="card p-6 lg:p-8">
                <h2 class="text-lg font-semibold tracking-tight text-content">How to read this page</h2>
                <div class="mt-4 grid gap-6 text-sm leading-relaxed text-muted sm:grid-cols-2">
                    <div>
                        <h3 class="font-medium text-content">The order is not a ranking of quality</h3>
                        <p class="mt-2">
                            Verified goes first because it is the one thing a person actually asserted. Stars rank within a tier and are shown
                            because they're useful to weigh. They are also the most purchasable number on GitHub, so they don't get to be the
                            whole sort. Ties break on the most recent push.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">A listing is not an audit</h3>
                        <p class="mt-2">
                            Review checks that the pointer resolves, the manifest parses, and the publisher owns the repo. Installing an extension
                            is trusting its author. What intentic adds is that the trust is bounded and legible: the
                            <a class="text-link hover:underline" href="/docs/extensions/manifest/">manifest</a> is the approval surface, and it
                            can't grow past what you approved without asking you again.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">Installing</h3>
                        <p class="mt-2">
                            In the app, <strong class="text-content">Capabilities → Add → Extension</strong> browses this registry and fills the
                            form in a click. Or paste a card's repo URL and commit sha by hand; same thing.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">Publishing, and your own registry</h3>
                        <p class="mt-2">
                            Add the <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repo and a nightly job opens the pull request
                            for you. Registries are also plural: point a sandbox at an internal repo and you have a private catalogue that never
                            touches this one. <a class="text-link hover:underline" href="/docs/extensions/publish/">The publish guide</a> has both.
                        </p>
                    </div>
                </div>
                {scannedNote && <p class="mt-6 border-t border-line pt-4 text-2xs text-subtle">{scannedNote}</p>}
            </section>
        </div>

        <section class="border-t border-line">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Extend it yourself.</h2>
                <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
                    The first-party views ship against the same public API a third-party bundle uses. Nothing here is a privileged path you can't
                    take.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href="/docs/extensions/build/">Build an extension</a>
                    <a class="btn btn-secondary" href={APP_URL}>Open the app</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
