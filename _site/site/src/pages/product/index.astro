---
import { productHref, productPages } from "@intentic-dev/site-content/product";
import { APP_URL, DEMO_PATH } from "@intentic-dev/site-content/site";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import { shotAsset, SHOT_WIDTHS } from "../../lib/shots";

/* The features index: every verb as a card, in the order the menu lists them. It is what the mega-menu is a
 * shortcut to, and the page a search engine, a shared link or a touch device lands on.
 *
 * One flat ordered set, no group bands: the shelf is five verbs now, and a verb is its own grouping: the
 * run/environment/extend headers that once sorted seven surfaces would be more scaffolding than the cards
 * under them. Order is the array's, which is the menu's. */
---

<BaseLayout
    title="Features · intentic"
    description="Run a fleet of agents, connect them to your systems, start them from events, review every change and host the workspace on a machine you own."
>
    <Nav />
    <main class="flex-1">
        <section class="relative overflow-hidden border-b border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/10 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">Features</div>
                <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
                    What you do with a fleet of agents.
                </h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    Run them, connect them, automate them, review their work and host them on your own machine.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                    <a class="btn btn-secondary" href={DEMO_PATH}>Open the live workspace</a>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
            {/* Two across, and never wider than the shot really is: same reasoning as the landing's gallery: at
                three the thumbnail rendered a 1072 CSS px interface at a third size, and the one portrait shot
                stretched to a blurry 1.6×. */}
            <div class="grid gap-6 sm:grid-cols-2">
                {
                    productPages.map((page) => {
                        // A diagram-led page (Automate) has no screenshot: its card carries a mini-diagram, not a
                        // mockup. Everything else is a real capture, capped at half its own pixels.
                        const image = page.hero ? shotAsset(page.hero.name) : undefined;
                        const cap = image ? `${image.width / 2}px` : undefined;
                        return (
                            <a href={productHref(page.slug)} class="card group overflow-hidden transition-colors hover:border-primary-600/40">
                                {image && page.hero ? (
                                    <div class="flex aspect-16/10 justify-center overflow-hidden border-b border-line bg-canvas">
                                        <Image
                                            src={image}
                                            alt={page.hero.alt}
                                            widths={SHOT_WIDTHS}
                                            sizes={`(min-width: 80rem) min(604px, ${cap}), (min-width: 40rem) min((100vw - 4.5rem) / 2, ${cap}), min(100vw - 3rem, ${cap})`}
                                            style={`max-width:${cap}`}
                                            loading="lazy"
                                            decoding="async"
                                            class="h-full w-full object-cover object-left-top"
                                        />
                                    </div>
                                ) : (
                                    <div class="flex aspect-16/10 items-center justify-center border-b border-line bg-canvas p-6">
                                        <div class="flex items-center gap-2 text-xs font-medium">
                                            <span class="rounded-lg border border-line bg-overlay/40 px-3 py-2 text-content">Event</span>
                                            <span class="text-link" aria-hidden="true">→</span>
                                            <span class="rounded-lg border border-line bg-overlay/40 px-3 py-2 text-content">Guard</span>
                                            <span class="text-link" aria-hidden="true">→</span>
                                            <span class="rounded-lg border border-primary-600/30 bg-primary-600/[0.05] px-3 py-2 text-link">Agent</span>
                                        </div>
                                    </div>
                                )}
                                <div class="p-6">
                                    <h3 class="text-base font-medium text-content group-hover:text-link">{page.navLabel}</h3>
                                    <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">{page.menuBlurb}</p>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>
