---
import { creatorSharePct, creditsPerCent, demoServiceCredits, installsPerDay, pool, runsPerDay } from "@intentic-dev/site-content/pool";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SpendFigure from "../components/SpendFigure.astro";

/* /earn: THE ECONOMY, top-level, because it is the one system on this site with two audiences. A member asks
 * "what does the membership get me and where do my credits go"; a creator asks "what is my share and what is
 * it a share of". Filed under the developer book it read as a step of publishing and served only half its
 * readers, and every other page that mentions money (the gallery, the installer's docs, the publishing
 * guide) now states at most the headline figures and links here, so the numbers live in exactly one place.
 *
 * The page runs member-first on purpose: the creator's pool is "split by the credits members spend", so a
 * reader cannot follow the creator half until they have seen what spending a credit even looks like. The
 * spend cards and the diamond moved here FROM the extension gallery, which is a discovery surface and was
 * carrying the site's heaviest economics above its own listings.
 *
 * Every figure on this page is drawn from the published pool config or derived from it: nothing retyped. */

const n = (value: number) => value.toLocaleString(`en-GB`);

/* WHAT A DAY BUYS, drawn to scale in both currencies: the same bar, five blocks against two hundred
 * hairlines. Both counts are computed from the prices, so the picture cannot outlive them, and both are
 * exact rather than suggestive, which is the only thing that makes a comb of that density honest rather
 * than decorative. */
const METER_W = 200;
const meterBars = (count: number, gap: number) => {
    const width = Math.max((METER_W - gap * (count - 1)) / count, 0.2);
    return Array.from({ length: count }, (_, i) => ({ x: i * (width + gap), width }));
};
const demoRunsPerDay = runsPerDay(demoServiceCredits);

/* The two ways a credit can leave a member's hands. They are different products: one flat donation
 * attached to a deliberate install, one metered run of something with real upstream cost, and the contrast is
 * the clearest thing about the model, so it is drawn rather than listed. The diamond that opens the section
 * lives in SpendFigure.astro, which owns its own geometry at two aspect ratios. */
const spendCards = [
    {
        tag: "One-time",
        kicker: "Premium extensions",
        heading: "Back an extension by installing it",
        blurb: "The install is the whole transaction. Nothing after it is counted, reported or charged for: using the thing you installed is free forever.",
        figure: n(pool.donationCredits),
        unit: "credits, flat",
        note: "Same number whatever you install, whoever made it. A price each listing could set would be the first thing anyone gamed.",
        steps: [
            "You approve the install, exactly like any other extension.",
            `${n(pool.donationCredits)} credits go to the publisher named in the manifest.`,
            "It is yours from then on: open it a thousand times, it never costs another credit.",
        ],
        guarantee: "If the donation cannot go through, the install stops. Nothing half-paid ever goes live.",
        cadence: "Reinstalling charges nothing. An update can donate again, at most once a month.",
        meter: meterBars(installsPerDay, 2.5),
        meterLabel: `A day's credits: ${n(installsPerDay)} installs`,
    },
    {
        tag: "Per run",
        kicker: "Premium services",
        heading: "Pay for a run that costs real money",
        blurb: "Some tools are not a prompt and some glue: they call paid data APIs or burn real compute every time. Those are services, and they are metered per run.",
        figure: "Its own price",
        unit: "shown before you agree",
        note: `Each service publishes what a run costs. The demo research run is ${n(demoServiceCredits)} credits, so a day's allowance is ${n(demoRunsPerDay)} of them.`,
        steps: [
            "Your agent finds one that fits and quotes the price and what is left today.",
            "You say yes in chat. One yes, one run.",
            "The platform makes the call for you: the provider never learns who you are, and you never hold its key.",
        ],
        guarantee: "If the service does not answer, your credits come straight back. A failed run costs nothing.",
        cadence: "Every repeat needs its own yes. Nothing loops without asking you again.",
        meter: meterBars(demoRunsPerDay, 0.45),
        meterLabel: `A day's credits: ${n(demoRunsPerDay)} demo runs`,
    },
];

/* The three rules that are true of BOTH lanes. Kept out of the cards because printed twice they read as
 * two policies that happen to match, and the single most reassuring thing about this model is that there is
 * one rule wearing two shapes. */
const spendRules = [
    {
        title: `${creatorSharePct}% reaches the creator`,
        body: "The same published share of a spent credit's value, whichever way you spent it. The rest runs the platform.",
    },
    {
        title: "Capped at what you paid",
        body: `Both draw on a daily allowance of ${n(pool.dailyCredits)} credits that resets at midnight UTC. You cannot direct more to creators than your membership provides, which prevents farming.`,
    },
    {
        title: "Nothing is metered",
        body: "No usage counting anywhere, and none asked for. Installing is a choice you make; a run is one you approve. Credits you never spend pay nobody.",
    },
];

/* ── THE CHAT, DRAWN ─────────────────────────────────────────────────────────────────────────────────────
 * The service lane demonstrated rather than described: a service is not a store you browse, it arrives as an
 * offer in the middle of real work, and the exchange IS the product's safety story. Price and balance come before
 * the yes, one yes for one run, a receipt after. The bubbles below picture the agent's published etiquette
 * (the sandbox's own services skill) rather than invent a nicer flow than ships.
 *
 * The service and its price are FICTIONAL on purpose. It is a named example, not the demo service, because a real
 * provider sets its own price and pinning the figure to any real number would let this page pass one service's
 * rate off as a catalog-wide one. The balances are arithmetic off the published allowance, so they cannot
 * disagree with the figures above. */
const SERVICE_CREDITS = 40;
const chatBalance = pool.dailyCredits;
const chatAfter = chatBalance - SERVICE_CREDITS;
const chat = [
    { role: "you", text: "We're launching the beta next month. Which communities should we use, and when should we post?" },
    {
        role: "agent",
        text: "I can scan the obvious subreddits myself for free. The catalog also lists a deeper option:",
        offer: {
            name: "acme.reddit-research",
            pitch: "Audiences, posting windows and past results for your product.",
            price: `${n(SERVICE_CREDITS)} credits per run`,
            balance: `${n(chatBalance)} left today`,
            ask: "Want me to run it?",
        },
    },
    { role: "you", text: "Go ahead." },
    {
        role: "agent",
        text: "Three communities stand out, each with a matching posting window. The full report is in research/launch-plan.md.",
        receipt: `acme.reddit-research · one run · ${n(SERVICE_CREDITS)} credits · ${n(chatAfter)} left today`,
    },
];

/* The creator's side of the same money: a drawn revenue cycle. The ring geometry is computed so four
 * arrowheads sit tangent to a clockwise loop (members → pool → split → paid → renews). Labels stay terse; the
 * one honesty line rides underneath. */
const ring = { cx: 150, cy: 150, r: 96 };
const ringStr = (deg: number, rr = ring.r) => {
    const a = (deg * Math.PI) / 180;
    return `${(ring.cx + rr * Math.cos(a)).toFixed(1)} ${(ring.cy + rr * Math.sin(a)).toFixed(1)}`;
};
const ringXY = (deg: number, rr = ring.r) => {
    const a = (deg * Math.PI) / 180;
    return [Number((ring.cx + rr * Math.cos(a)).toFixed(1)), Number((ring.cy + rr * Math.sin(a)).toFixed(1))];
};
const revNodes = [
    { label: "Members pay", xy: ringXY(270), anchor: "middle", lx: 150, ly: 30 },
    { label: "Pooled monthly", xy: ringXY(0), anchor: "start", lx: 262, ly: 155 },
    { label: "Split by credits spent", xy: ringXY(90), anchor: "middle", lx: 150, ly: 286 },
    { label: "Paid to creators", xy: ringXY(180), anchor: "end", lx: 38, ly: 155 },
];
// four short arcs at the quadrant midpoints; each carries one auto-oriented arrowhead so the loop reads clockwise
const revArcs = [315, 45, 135, 225].map((m) => `M ${ringStr(m - 3)} A ${ring.r} ${ring.r} 0 0 1 ${ringStr(m + 3)}`);

/* THE RULES, AS TILES — the fine print folded to what each promise IS, one positive sentence per tile. The
 * argued version (the arithmetic, the design choices, the honest status) moved to /earn/fine-print/: seven
 * screens of reasoned prose under the diagrams made this page a wall, and the reader deciding whether the
 * deal is fair is almost never the reader auditing it. Each icon is a lucide-style stroke path, drawn the
 * same way the gallery draws its glyphs. */
const rules = [
    {
        title: "No telemetry, ever",
        body: "The pool pays only on two deliberate acts: an install you approve and a run you approve. Your machine reports nothing.",
        d: '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="m1 1 22 22"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>',
    },
    {
        title: "The books are open",
        body: "Every month, published: what came in, what payment fees cost, what the pool was, what reached creators, and what is still owed.",
        d: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
    },
    {
        title: "Failures refund themselves",
        body: "Credits return the moment a service fails to answer. Enforced in code before the call, not argued through a support queue.",
        d: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
    },
    {
        title: "The catalog is curated",
        body: "The platform admits every service, and delists it if it goes bad. No form puts an endpoint in front of your agent.",
        d: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
    },
    {
        title: "Farming can't profit",
        body: "Support is capped at each member's own membership, so at any scale fake spend costs more than it returns.",
        d: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
    },
    {
        title: "Paid on a date, not eventually",
        body: "A month closes when it ends and pays mid-month. Claim your publisher name, connect a payout account, and the money comes to you.",
        d: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
    },
];
---

<BaseLayout
    title="Earn · intentic"
    description="One membership, one currency: credits. Installs donate them, service runs spend them, and every credit spent pays its creator a published share, on a public ledger."
>
    <Nav />
    <main class="flex-1">
        <section class="relative overflow-hidden border-b border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/10 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">Earn</div>
                <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
                    One membership. A shared pool. {creatorSharePct}% to creators.
                </h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    The whole economy on one page, for both of its sides: what a member's credits buy, and how extensions and services earn
                    from the pool those credits split: with no telemetry anywhere, and a ledger anyone can read.
                </p>
                {/* THREE DOORS, because this page has three readers and the hero is where they sort
                    themselves: the extension creator, the service provider, and the member who just wants to
                    see what is listed. The provider door is here rather than only at the foot because the
                    reader who needs it usually ARRIVES at it: somebody who already runs a paid API reaches
                    this page from a search, lands at the top, and should not have to read five screens of
                    member economics to find out there is a way in.

                    "List your work" became "List an extension" in the same move, and had to. It was a fine
                    label while it was the only creator button on the page: artifact-neutral, so it caught
                    everybody. Standing next to "Offer a paid service" that neutrality inverts and becomes a
                    trap, because a provider reads the broader label as the one that includes them and lands
                    on a page about git registries. Two buttons that name their artifact cannot do that. */}
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href="/api/publish/">List an extension</a>
                    <a class="btn btn-secondary" href="/api/services/">Offer a paid service</a>
                    <a class="btn btn-secondary" href="/extensions/">Browse extensions</a>
                </div>
            </div>
        </section>

        {/* The member's side first: the ring below splits a pool "by the credits members spend", and this is
            where a reader learns what spending one even looks like. */}
        <section class="relative overflow-hidden border-b border-line" aria-labelledby="credits-heading">
            <div class="absolute inset-0 bg-linear-to-b from-primary-600/8 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="grid-overlay"></div>
            <div class="relative mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
                    <div>
                        <div class="eyebrow text-link">Credits</div>
                        <h2 id="credits-heading" class="mt-3 text-2xl font-semibold tracking-tight text-content sm:text-3xl">
                            One membership. Two ways to spend it.
                        </h2>
                        <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                            Almost everything in the gallery installs free, from anyone, with no cut taken from anybody. A membership adds
                            credits, and a credit leaves your hands in exactly two places, both of which you trigger on purpose.
                        </p>
                        <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                            {
                                [
                                    { term: `$${pool.priceUsd}`, detail: "a month" },
                                    { term: n(pool.dailyCredits), detail: "credits a day" },
                                    { term: n(creditsPerCent), detail: "credits to the cent" },
                                ].map((stat) => (
                                    <div>
                                        <dt class="font-mono text-xl font-semibold tracking-tight text-content">{stat.term}</dt>
                                        <dd class="text-2xs text-subtle">{stat.detail}</dd>
                                    </div>
                                ))
                            }
                        </dl>
                    </div>

                    {/* The diamond: one source, two middles, one rule. */}
                    <figure class="w-full lg:justify-self-end">
                        <SpendFigure />
                    </figure>
                </div>

                {/* One card per way. Same skeleton on both, so the differences are the only thing that moves. */}
                <div class="mt-14 grid gap-6 lg:grid-cols-2">
                    {
                        spendCards.map((card) => (
                            <article class="card relative flex flex-col gap-5 overflow-hidden p-6 sm:p-7">
                                <div
                                    class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary-500/60 to-transparent"
                                    aria-hidden="true"
                                />
                                <header>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="chip border border-primary-600/35 bg-primary-600/12 text-primary-300">{card.tag}</span>
                                        <span class="eyebrow">{card.kicker}</span>
                                    </div>
                                    <h3 class="mt-3.5 text-lg font-semibold tracking-tight text-content">{card.heading}</h3>
                                    <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">{card.blurb}</p>
                                </header>

                                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-y border-line py-4">
                                    <span class="text-3xl font-semibold tracking-tight text-content">{card.figure}</span>
                                    <span class="text-sm text-muted">{card.unit}</span>
                                    <p class="mt-1 w-full text-2xs leading-relaxed text-subtle">{card.note}</p>
                                </div>

                                <ol class="flex flex-col gap-2.5">
                                    {card.steps.map((step, i) => (
                                        <li class="flex gap-3 text-sm leading-relaxed text-muted">
                                            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line bg-overlay/40 text-2xs font-semibold text-subtle">
                                                {i + 1}
                                            </span>
                                            <span>{step}</span>
                                        </li>
                                    ))}
                                </ol>

                                {/* A day's allowance to scale, in this lane's own units: five blocks against a comb. */}
                                <div class="mt-auto">
                                    <svg viewBox={`0 0 ${METER_W} 10`} class="h-2.5 w-full text-primary-400/70" preserveAspectRatio="none" aria-hidden="true">
                                        {card.meter.map((bar) => (
                                            <rect x={bar.x} y="0" width={bar.width} height="10" fill="currentColor" />
                                        ))}
                                    </svg>
                                    <p class="mt-2 text-2xs text-subtle">{card.meterLabel}</p>
                                </div>

                                <div class="flex flex-col gap-2 rounded-lg border border-success/25 bg-success/8 px-3.5 py-3">
                                    <p class="flex items-start gap-2 text-2xs leading-relaxed text-muted">
                                        <svg
                                            class="mt-px h-3.5 w-3.5 shrink-0 text-success"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.25"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path d="M20 6 9 17l-5-5" />
                                        </svg>
                                        <span>{card.guarantee}</span>
                                    </p>
                                    <p class="pl-5.5 text-2xs leading-relaxed text-subtle">{card.cadence}</p>
                                </div>
                            </article>
                        ))
                    }
                </div>

                {/* True of both lanes, which is the point of stating them once. */}
                <div class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-3">
                    {
                        spendRules.map((rule) => (
                            <div class="border-t border-line pt-4">
                                <h3 class="text-sm font-semibold tracking-tight text-content">{rule.title}</h3>
                                <p class="mt-1.5 text-2xs leading-relaxed text-subtle">{rule.body}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        {/* The service lane, demonstrated: the one place on the site a visitor SEES the flow the cards above
            describe. Copy sits on the left and the conversation on the right. The conversation carries the argument, so the
            copy stays short. */}
        <section class="border-b border-line" aria-labelledby="chat-heading">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
                    <div>
                        <div class="eyebrow text-link">In practice</div>
                        <h2 id="chat-heading" class="mt-3 text-2xl font-semibold tracking-tight text-content sm:text-3xl">
                            What a run looks like in chat.
                        </h2>
                        <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                            Services are not a store you browse. They arrive as an offer in the middle of real work, and the offer follows the agent's standing etiquette rather than its goodwill: name the service, quote the price and today's balance, wait for the yes. One yes covers one run, and a run that fails to answer refunds itself.
                        </p>
                        <p class="mt-4 max-w-copy text-sm leading-relaxed text-subtle">
                            The service here is invented. Each real one publishes its own price, shown like this before every run, and
                            entered the catalog through a human review at the platform, not a signup form.
                        </p>
                        {/* THE PROVIDER'S DOOR, and this is the only place on the page it belongs: a reader
                            who has just watched a run get priced and approved is the one reader who knows what
                            being on the other end would mean. It is a qualified fork rather than a button
                            because the qualifier does the filtering: everybody else on this page should be
                            building a free extension, and a third CTA in the closing band would offer a
                            hand-onboarded catalog the same weight as the self-serve path most people want. */}
                        <p class="mt-6 max-w-copy text-sm leading-relaxed text-muted">
                            On the other end of that exchange? A paid data API, heavy compute or a licensed corpus is a{" "}
                            <strong class="font-medium text-content">service</strong> rather than an extension, because every run costs you
                            real money.{" "}
                            <a class="font-medium text-link hover:underline" href="/api/services/">Offer a paid service →</a>
                        </p>
                    </div>

                    <figure class="w-full lg:justify-self-end">
                        <div class="card flex w-full flex-col gap-4 p-5 sm:p-6" role="log" aria-label="A conversation where the agent offers a paid service run and the owner approves it">
                            {
                                chat.map((message) => (
                                    <div class={message.role === "you" ? "flex justify-end" : "flex justify-start"}>
                                        <div class={message.role === "you" ? "max-w-[85%]" : "max-w-[92%]"}>
                                            <p class={`text-2xs tracking-wide text-subtle uppercase ${message.role === "you" ? "text-right" : ""}`}>
                                                {message.role === "you" ? "You" : "Agent"}
                                            </p>
                                            <div
                                                class={
                                                    message.role === "you"
                                                        ? "mt-1 rounded-2xl rounded-tr-sm border border-primary-600/35 bg-primary-600/12 px-4 py-2.5 text-sm leading-relaxed text-content"
                                                        : "mt-1 rounded-2xl rounded-tl-sm border border-line bg-overlay/50 px-4 py-2.5 text-sm leading-relaxed text-muted"
                                                }
                                            >
                                                <p>{message.text}</p>
                                                {message.offer && (
                                                    <div class="mt-3 rounded-xl border border-primary-600/30 bg-canvas/70 p-3.5">
                                                        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                                                            <span class="font-mono text-xs font-semibold text-content">{message.offer.name}</span>
                                                            <span class="chip border border-primary-600/35 bg-primary-600/12 text-primary-300">Premium service</span>
                                                        </div>
                                                        <p class="mt-2 text-xs leading-relaxed text-muted">{message.offer.pitch}</p>
                                                        <p class="mt-2.5 font-mono text-xs text-content">
                                                            {message.offer.price} <span class="text-subtle">· {message.offer.balance}</span>
                                                        </p>
                                                        <p class="mt-2.5 text-sm text-content">{message.offer.ask}</p>
                                                    </div>
                                                )}
                                                {message.receipt && (
                                                    <p class="mt-3 border-t border-line pt-2.5 font-mono text-2xs text-subtle">{message.receipt}</p>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <figcaption class="mt-3 text-2xs leading-relaxed text-subtle">
                            The platform makes the call; the provider never learns who you are. Fails to answer → credits come straight back.
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>

        {/* The creator's side: the same money, seen from the other end of the month. */}
        <section class="border-b border-line" aria-labelledby="pool-heading">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
                    <div class="relative order-last overflow-hidden rounded-2xl border border-line bg-canvas/60 lg:order-first">
                        <div class="grid-overlay"></div>
                        <div
                            class="pointer-events-none absolute top-1/2 left-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full"
                            style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 16%, transparent), transparent 70%)"
                            aria-hidden="true"
                        >
                        </div>
                        <div class="relative flex flex-col items-center px-5 py-9 text-center">
                            <svg
                                viewBox="-80 0 476 300"
                                class="h-auto w-full max-w-[560px] text-link"
                                role="img"
                                aria-label="A monthly cycle: members pay, a share is pooled, the pool is split by the credits members spend, and creators are paid, then it renews."
                            >
                                <defs>
                                    <marker id="rev-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
                                        <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
                                    </marker>
                                </defs>
                                <circle cx="150" cy="150" r="96" fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="1.5" stroke-dasharray="3 6" />
                                {revArcs.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#rev-arrow)" />)}
                                <circle cx="150" cy="150" r="30" fill="color-mix(in srgb, var(--color-primary-500) 12%, transparent)" stroke="currentColor" stroke-opacity="0.35" />
                                <text x="150" y="151" text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="700" style="fill: var(--color-link)">$</text>
                                {
                                    revNodes.map((node) => (
                                        <Fragment>
                                            <circle cx={node.xy[0]} cy={node.xy[1]} r="11" fill="var(--color-canvas)" stroke="currentColor" stroke-opacity="0.35" />
                                            <circle cx={node.xy[0]} cy={node.xy[1]} r="5" fill="currentColor" />
                                            <text x={node.lx} y={node.ly} text-anchor={node.anchor} dominant-baseline="central" font-size="13.5" font-weight="500" style="fill: var(--color-content)">
                                                {node.label}
                                            </text>
                                        </Fragment>
                                    ))
                                }
                            </svg>
                            <p class="mt-2 max-w-copy text-2xs leading-relaxed text-subtle">
                                A public monthly pool split by the credits members spend on install donations and service runs. Usage is never metered, free extensions never enter it and premium is opt-in.
                            </p>
                        </div>
                    </div>
                    <div>
                        <div class="eyebrow text-link">The pool</div>
                        <h2 id="pool-heading" class="mt-3 text-2xl font-semibold tracking-tight text-content sm:text-3xl">
                            Split by what members choose. Renewed monthly.
                        </h2>
                        <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                            Creators don't set prices and members don't open wallets per tool. Memberships fill one pool, the credits members
                            spend decide its split, and {creatorSharePct}% of every spent credit's value reaches the creator it went to.{" "}
                            <a class="text-link hover:underline" href="/api/maintain/">Maintained work earns again</a>: an update can donate
                            again, at most once a month per install.
                        </p>
                        {/* ONE BUTTON, and it is the provider's. This slot has now held three things and each
                            was wrong in the same way: "Maintain & grow" was a step three of a path the reader
                            had not started, and "Get listed" was the neutrality trap that cost "List your
                            work" its name in the hero. Standing beside a button that names its artifact, a
                            label that names none does not read as the general case; it reads as the OTHER
                            case, so the provider takes it and lands on a page about git registries.

                            Disambiguating it to "List an extension" would only reprint the hero's pair one
                            screen below the hero. So the extension path keeps the two unambiguous primaries
                            it already has, at the top and at the foot, plus the maintenance link in the
                            sentence above; and this section, the one that explains how BOTH artifacts get
                            paid, keeps the door that exists nowhere else on the page above the fold. */}
                        <div class="mt-7 flex flex-wrap gap-3">
                            <a class="btn btn-secondary" href="/api/services/">Offer a paid service</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* The rules at a glance: each fine-print argument folded to the one promise it proves. The argued
            version lives at /earn/fine-print/, one click away, so this page stays graspable in a scroll. */}
        <section class="mx-auto max-w-7xl px-6 py-16 lg:py-20" aria-labelledby="rules-heading">
            <div class="eyebrow text-link">The rules</div>
            <h2 id="rules-heading" class="mt-3 text-2xl font-semibold tracking-tight text-content sm:text-3xl">The whole deal, at a glance.</h2>
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {
                    rules.map((rule) => (
                        <article class="card flex flex-col gap-3 p-6">
                            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-primary-600/30 bg-primary-600/10 text-link">
                                <svg
                                    viewBox="0 0 24 24"
                                    class="h-4.5 w-4.5"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                    set:html={rule.d}
                                />
                            </span>
                            <h3 class="text-base font-semibold tracking-tight text-content">{rule.title}</h3>
                            <p class="text-sm leading-relaxed text-muted">{rule.body}</p>
                        </article>
                    ))
                }
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
                <a class="btn btn-secondary" href="/earn/ledger/">See the ledger</a>
                <a class="btn btn-secondary" href="/earn/fine-print/">Read the fine print</a>
                <p class="text-xs text-subtle">The numbers themselves, live from the platform, and every tile above argued in full.</p>
            </div>
        </section>

        {/* THE CLOSING ASK IS THE ARTIFACT FORK, because on this page it is the only question left.
            It used to pair "Build an extension" with a third button to the publishing page, after the hero's
            "List your work" and the pool band's "Get listed" had both already gone there: two steps of ONE
            path, spending the page's last and strongest slot on a destination it had sent the reader to
            twice. Meanwhile the page gives services a spend card, an illustrated run and half the rules
            tiles, then closed without a single button a provider could press.

            Both artifacts, one slot each. The hierarchy stays in the primary and in the sentence rather than
            in whether a door exists at all: most people should build a free extension, and the reader who
            cannot is told so in words instead of being left to infer it from a missing button. */}
        <section class="border-t border-line">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Ship something worth backing.</h2>
                <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                    Two things earn from this pool, and they are not versions of each other: an extension anyone can install free, or a
                    service the platform meters per run. Almost everyone wants the first.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href="/api/build/">Build an extension</a>
                    <a class="btn btn-secondary" href="/api/services/">Offer a paid service</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
