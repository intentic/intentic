---
import { guidePages, guidesHref, guidesIndex } from "@intentic-dev/site-content/guides";
import { APP_URL, DEMO_PATH } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";

/* The guides hub.
 *
 * Every row carries the question AND its answer rather than a title and a teaser, so the hub itself answers
 * five questions instead of promising that five pages will. A crawler that reads only this page still leaves
 * with the substance, and a reader who came for one of the five gets it without a second navigation.
 *
 * The rows are also the page's FAQPage schema, from the same list, so the hub cannot advertise a question
 * whose answer it does not carry.
 */

const faqEntries = guidePages.map((page) => ({ question: page.question, answer: page.answer }));
---

<BaseLayout breadcrumbs={[{ name: "Guides", path: guidesHref("") }]} faq={faqEntries}>
    <Nav />
    <main class="flex-1">
        <section class="page-hero">
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">{guidesIndex.eyebrow}</div>
                <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">{guidesIndex.heading}</h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">{guidesIndex.sub}</p>

                <div class="mt-8 border-t border-line pt-6">
                    <div class="eyebrow">Jump to one</div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        {
                            guidePages.map((page) => (
                                <a
                                    href={guidesHref(page.slug)}
                                    class="border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:border-primary-600/40 hover:text-link"
                                >
                                    {page.navLabel}
                                </a>
                            ))
                        }
                    </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Create your workspace</a>
                    <a class="btn btn-secondary" href={DEMO_PATH}>Open the live workspace</a>
                </div>
            </div>
        </section>

        <!-- Question and answer per row. The hub carries the substance rather than pointing at it. -->
        <section>
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                {
                    guidePages.map((page, i) => (
                        <article class:list={["fade-in", i === 0 ? "pb-12" : "border-t border-line py-12"]}>
                            <div class="grid gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-14">
                                <div>
                                    <h2 class="text-lg font-semibold tracking-tight text-content">
                                        <a href={guidesHref(page.slug)} class="transition-colors hover:text-link">
                                            {page.question}
                                        </a>
                                    </h2>
                                    <p class="mt-3 max-w-copy text-sm leading-relaxed text-subtle">{page.blurb}</p>
                                </div>
                                <div>
                                    <p class="max-w-copy text-base leading-relaxed text-muted">{page.answer}</p>
                                    <a
                                        href={guidesHref(page.slug)}
                                        class="mt-4 inline-flex text-sm font-medium text-link transition-opacity hover:opacity-80"
                                    >
                                        Read the whole answer →
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>
    </main>

    <Footer />

</BaseLayout>
