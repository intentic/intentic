---
import { compareFamilies, compareHref, comparePages, compareVerifiedOn, type ComparePage } from "@intentic-dev/site-content/compare";
import { APP_URL, githubIssuesUrl, ORG_NAME } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";

/* One template, one page per comparison: a new comparison is an entry in an array and its nav row, footer
 * link, page meta, OG card and llms.txt entry all follow from it.
 *
 * The order is the argument, and it is table-forward: the one-line answer, then the head-to-head table as the
 * centrepiece (a reader who only scans sees the marked rows that go the other way), then the two things it
 * really comes down to, then the case FOR the other product last and at full weight. Everything a competitor
 * ships changes weekly, so each page names what it checked and dares the reader to correct it. */

export function getStaticPaths() {
    return comparePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
    page: ComparePage;
}

const { page } = Astro.props;
const family = compareFamilies.find((entry) => entry.id === page.family);
const index = comparePages.indexOf(page);
const next = comparePages[(index + 1) % comparePages.length];

const theirRows = page.table.filter((row) => row.theirs).length;
const host = new URL(page.url).host;

// Written out rather than left as an ISO string: the note is read as a sentence, and "18 August 2026" is a
// date a reader dates the page by, where "2026-08-18" is a field they skim past. `datetime` keeps the machine
// -readable form on the <time> element for anything parsing the page.
const verifiedOn = compareVerifiedOn;
const verifiedLabel = new Date(`${verifiedOn}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});
---

<BaseLayout breadcrumbs={[{ name: "Compare", path: compareHref("") }, { name: page.navLabel, path: compareHref(page.slug) }]}>
    <Nav />
    <main class="flex-1">
        <!-- Hero: the framing, then what they are in their own words -->
        <section class="page-hero">
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32 lg:pb-16">
                <div class="flex flex-wrap items-center gap-3">
                    <a href={compareHref("")} class="eyebrow transition-colors hover:text-link">Compare</a>
                    {family && <span class="chip bg-primary-500/12 text-primary-400">{family.label} · {family.verdict}</span>}
                </div>
                <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">{page.heading}</h1>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">{page.sub}</p>

                <figure class="mt-7 border-l-2 border-line-strong pl-5">
                    <blockquote class="max-w-copy text-sm leading-relaxed text-muted">{page.theirPitch}</blockquote>
                    <figcaption class="mt-2 text-2xs text-subtle">
                        {page.name} ·
                        <a href={page.url} target="_blank" rel="noopener nofollow" class="transition-colors hover:text-link">{host}</a>
                    </figcaption>
                </figure>

                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Create your workspace</a>
                    <a class="btn btn-secondary" href="/features/">See the product</a>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl px-6">
            <!-- The answer, in one or two lines, before anything that could read as a scorecard -->
            <section class="border-b border-line py-14 lg:py-16">
                <div class="eyebrow">The short answer</div>
                <div class="mt-4 space-y-3">
                    {page.verdict.map((paragraph) => <p class="max-w-copy text-lg leading-relaxed text-content sm:text-xl">{paragraph}</p>)}
                </div>
            </section>

            <!-- Head to head: the centrepiece. Only the rows that go the other way are marked: a scorecard
                 with a tick on every row is one nobody believes. The "where you agree" line rides above it so
                 the concession is read before the contrast. -->
            <section class="fade-in border-b border-line py-14 lg:py-16">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h2 class="text-xl font-semibold tracking-tight text-content">Head to head</h2>
                    <p class="text-2xs text-subtle">
                        {theirRows} of {page.table.length} rows go to {page.name}: <span class="text-primary-400">▸</span> marks them
                    </p>
                </div>
                <p class="mt-3 max-w-copy text-sm leading-relaxed text-subtle">
                    <span class="font-medium text-muted">Where you agree · </span>{page.overlap.body}
                </p>
                <table class="cmp mt-7 w-full">
                    <thead>
                        <tr>
                            <th scope="col"><span class="sr-only">Dimension</span></th>
                            <th scope="col" class="text-link">{ORG_NAME}</th>
                            <th scope="col">{page.name}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            page.table.map((row) => (
                                <tr>
                                    <th scope="row">{row.label}</th>
                                    <td data-side={ORG_NAME}>{row.intentic}</td>
                                    <td data-side={page.name} class:list={{ theirs: row.theirs }}>
                                        {row.theirs && <span class="mark" aria-label={`Advantage: ${page.name}`}>▸</span>}
                                        {row.them}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </section>

            <!-- What it comes down to: the one or two distinctions that survive the table. Compact by design,
                 the table already carried the detail, this is the thing to remember. -->
            <section class="fade-in border-b border-line py-14 lg:py-16">
                <h2 class="text-xl font-semibold tracking-tight text-content">What it comes down to</h2>
                <div class:list={["mt-6 grid gap-4", page.differences.length >= 3 ? "md:grid-cols-3" : "md:grid-cols-2"]}>
                    {
                        page.differences.map((section, i) => (
                            <div class="card p-6">
                                <div class="text-sm font-semibold text-link">{String(i + 1).padStart(2, "0")}</div>
                                <h3 class="mt-2 text-base font-medium text-content">{section.title}</h3>
                                <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">{section.body}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            {
                page.together && (
                    <section class="fade-in border-b border-line py-14 lg:py-16">
                        <div class="card border-primary-600/30 bg-primary-500/6 p-7 lg:p-9">
                            <div class="eyebrow text-primary-400">Not either/or</div>
                            <h2 class="mt-2 text-xl font-semibold tracking-tight text-content">{page.together.title}</h2>
                            <p class="mt-3 max-w-copy text-base leading-relaxed text-muted">{page.together.body}</p>
                        </div>
                    </section>
                )
            }

            <!-- The case for them, last and at full weight. If this is soft the whole page reads as marketing. -->
            <section class="fade-in py-14 lg:py-16">
                <h2 class="text-xl font-semibold tracking-tight text-content">Pick {page.name} when</h2>
                <p class="mt-4 max-w-copy text-lg leading-relaxed text-content">{page.pickThem}</p>
            </section>

            <!-- THE EVIDENCE, NAMED AND DATED. The old note said the page was checked "the week this shipped",
                 which is not a date and ages into a claim nobody can test. This states the day the vendor's own
                 documents were last opened and links each one, so a reader can check any row here against the
                 source it came from, and can see for themselves how old that check is. -->
            <section class="border-t border-line py-10">
                <h2 class="text-sm font-semibold tracking-tight text-content">How this was checked</h2>
                <p class="mt-3 max-w-copy text-sm leading-relaxed text-subtle">
                    Every claim about {page.name} on this page is drawn from its own documentation, last read on{" "}
                    <time datetime={verifiedOn}>{verifiedLabel}</time>. These products move fast. Spot something out of date?{" "}
                    <a href={githubIssuesUrl} target="_blank" rel="noopener" class="text-link hover:underline">Open an issue</a>{" "}
                    and it is fixed in the next build.
                </p>
                <ul class="mt-4 flex flex-wrap gap-2">
                    <li>
                        <a
                            href={page.url}
                            target="_blank"
                            rel="noopener nofollow"
                            class="border border-line px-3 py-1.5 text-2xs text-muted transition-colors hover:border-primary-600/40 hover:text-link"
                        >
                            {page.name} · {host}
                        </a>
                    </li>
                    {
                        page.sources.map((source) => (
                            <li>
                                <a
                                    href={source.url}
                                    target="_blank"
                                    rel="noopener nofollow"
                                    class="border border-line px-3 py-1.5 text-2xs text-muted transition-colors hover:border-primary-600/40 hover:text-link"
                                >
                                    {source.label} · {new URL(source.url).host}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>

        <!-- Next comparison + CTA -->
        <section class="border-t border-line">
            <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-14 sm:flex-row sm:items-center sm:justify-between">
                <a href={compareHref(next.slug)} class="group">
                    <div class="eyebrow">Next comparison</div>
                    <div class="mt-1 text-lg font-semibold tracking-tight text-content group-hover:text-link">{next.navLabel} →</div>
                    <p class="mt-1 max-w-sm text-sm text-muted">{next.menuBlurb}</p>
                </a>
                <div class="flex flex-wrap gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Create your workspace</a>
                    <a class="btn btn-secondary" href={compareHref("")}>All comparisons</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <style>
        /* Three columns on a desktop; a stack of labelled cards on a phone, because a 3-column table of
           sentences at 380px is a column of one word per line. The `data-side` attribute carries the column
           header down into the stacked view, so a cell never floats free of whose it is. */
        .cmp {
            border-collapse: collapse;
        }

        .cmp thead th {
            padding: 0 18px 10px 0;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: var(--color-subtle);
            border-bottom: 1px solid var(--color-line-strong);
        }

        .cmp tbody th {
            width: 22%;
            text-align: left;
            font-weight: 500;
            color: var(--color-content);
        }

        .cmp tbody td {
            width: 39%;
            color: var(--color-muted);
        }

        .cmp tbody th,
        .cmp tbody td {
            padding: 14px 18px 14px 0;
            font-size: 0.875rem;
            line-height: 1.55;
            vertical-align: top;
            border-bottom: 1px solid var(--color-line);
        }

        /* The intentic column is the one being argued for: tint its cells so the eye has a side to follow. */
        .cmp tbody td[data-side="intentic"] {
            color: var(--color-content);
        }

        .cmp tbody td.theirs {
            color: var(--color-content);
        }

        .mark {
            color: var(--color-primary-400);
            margin-right: 6px;
        }

        @media (max-width: 48rem) {
            .cmp thead {
                display: none;
            }
            .cmp,
            .cmp tbody,
            .cmp tr,
            .cmp tbody th,
            .cmp tbody td {
                display: block;
                width: auto;
            }
            .cmp tr {
                border: 1px solid var(--color-line);
                border-radius: var(--radius-lg);
                padding: 14px 16px;
                margin-bottom: 10px;
            }
            .cmp tbody th {
                padding: 0 0 10px;
                border-bottom: 1px solid var(--color-line);
            }
            .cmp tbody td {
                padding: 10px 0 0;
                border-bottom: none;
            }
            .cmp tbody td::before {
                content: attr(data-side);
                display: block;
                margin-bottom: 2px;
                font-size: var(--text-2xs);
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: var(--color-subtle);
            }
        }
    </style>

</BaseLayout>
