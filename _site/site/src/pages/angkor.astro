    .a-page .a-compare-foot a {
        font-size: 0.9375rem;
    }

    /* ── 4 · What it costs ───────────────────────────────── */
    .a-page .a-econ {
        display: grid;
        align-items: start;
        gap: 1.4rem;
        margin-top: 3rem;
    }
    @media (min-width: 60rem) {
        .a-page .a-econ {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .a-page .a-accounts-head {
        border-bottom: 1px solid var(--a-line);
        padding: 0.9rem 1.3rem;
    }
    .a-page .a-accounts ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .a-page .a-accounts li {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
        border-bottom: 1px solid var(--a-line);
        padding: 0.95rem 1.3rem;
        color: var(--a-cream);
    }
    .a-page .a-accounts li:last-child {
        border-bottom: 0;
    }
    .a-page .a-account-name {
        font-family: var(--a-font-title);
        font-size: 1rem;
        font-weight: 600;
    }
    .a-page .a-account-detail {
        flex: 1;
        min-width: 10rem;
        font-size: 0.75rem;
        color: var(--a-subtle);
    }
    .a-page .a-account-tag {
        border: 1px solid rgba(201, 160, 92, 0.3);
        padding: 0.15rem 0.6rem;
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--a-gold);
    }
    .a-page .a-flat {
        padding: 1.5rem;
    }
    .a-page .a-flat ul {
        display: grid;
        gap: 0.9rem;
        margin: 1.2rem 0 0;
        padding: 0;
        list-style: none;
    }
    .a-page .a-flat li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: var(--a-muted);
    }
    .a-page .a-flat li .a-lotus {
        margin-top: 0.2rem;
    }

    /* ── 5 · Who builds it ───────────────────────────────── */
    .a-page .a-trust {
        display: grid;
        gap: 3rem;
    }
    @media (min-width: 64rem) {
        .a-page .a-trust {
            grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
            gap: 3.5rem;
        }
    }
    .a-page .a-trust-bio {
        margin: 0.9rem 0 0;
        max-width: 52ch;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--a-subtle);
    }
    .a-page .a-trust-cards {
        display: grid;
        gap: 1.1rem;
    }
    @media (min-width: 48rem) {
        .a-page .a-trust-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .a-page .a-trust-card {
        padding: 1.4rem;
    }
    .a-page .a-trust-card h3 {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        font-family: var(--a-font-title);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--a-cream);
    }
    .a-page .a-trust-card p {
        margin: 0.85rem 0 0;
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--a-muted);
    }
    /* A FIGURE IS READ, NOT ADMIRED, so it takes the titling face and a flat fill. Set in the display
       face with the metal gradient it was a 25px number whose lower third faded to brown — the two
       things a reader most needs to tell apart here are 1,577 and 1,775, and the gradient was dimming
       exactly the strokes that distinguish them. */
    /* `p.` earns this rule the element the sibling `.a-trust-card p` above already has, and without it
       that rule ties on specificity and wins on order — which is why the figure was silently rendering
       at body size in the muted grey, the exact opposite of a headline number. */
    .a-page .a-trust-card p.a-trust-stat {
        margin: 0.9rem 0 0;
        font-family: var(--a-font-title);
        font-size: 1.75rem;
        line-height: 1.2;
        font-weight: 600;
        /* Lining figures, so 1,579 and 1,777 differ by their shapes rather than by where they sit. */
        font-variant-numeric: lining-nums tabular-nums;
        color: var(--a-gold-bright);
    }
    .a-page .a-trust-stat span {
        display: block;
        margin-top: 0.25rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--a-subtle);
    }
    .a-page .a-trust-card a {
        display: inline-block;
        margin-top: 1rem;
        font-size: 0.875rem;
    }

    /* ── 6 · Getting started ─────────────────────────────── */
    .a-page .a-steps {
        display: grid;
        gap: 2.5rem;
        margin-top: 3rem;
    }
    @media (min-width: 48rem) {
        .a-page .a-steps {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 2rem;
        }
    }
    /* Lining figures: these are step markers, so 01/02/03 should sit on one line at one height. The
       display face's default old-style figures drop the 3 below the baseline, which on a counter reads
       as a typo rather than as a style. */
    .a-page .a-step-num {
        font-size: 3.25rem;
        line-height: 1;
        font-weight: 700;
        font-variant-numeric: lining-nums;
        opacity: 0.32;
    }
    .a-page .a-step h3 {
        margin: 0.75rem 0 0;
        font-family: var(--a-font-title);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--a-cream);
    }
    .a-page .a-step p {
        margin: 0.5rem 0 0;
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--a-muted);
    }
    .a-page .a-command {
        margin-top: 2.75rem;
        background: rgba(8, 6, 4, 0.72);
    }
    .a-page .a-command-head {
        border-bottom: 1px solid var(--a-line);
        padding: 0.7rem 1.2rem;
    }
    .a-page .a-command pre {
        margin: 0;
        overflow-x: auto;
        padding: 0.9rem 1.2rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--a-cream);
    }
    .a-page .a-prompt {
        color: var(--a-ember);
    }
    .a-page .a-command-note {
        margin: 0.9rem 0 0;
        font-size: 0.8125rem;
        color: var(--a-subtle);
    }
    .a-page .a-desktop {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 2rem;
        max-width: 52rem;
        margin-top: 1.6rem;
        padding: 1.2rem 1.4rem;
    }
    .a-page .a-desktop > div {
        flex: 1;
        min-width: 16rem;
    }
    .a-page .a-desktop-lead {
        margin: 0;
        font-family: var(--a-font-title);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--a-cream);
    }
    .a-page .a-desktop-note {
        margin: 0.35rem 0 0;
        max-width: 52ch;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--a-muted);
    }

    /* ── 7 · FAQ ─────────────────────────────────────────── */
    .a-page .a-faq {
        display: grid;
        gap: 2.75rem;
        max-width: 44rem;
        margin-top: 2.75rem;
    }
    .a-page .a-faq-group-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.85rem;
    }
    .a-page .a-faq-group-head h3 {
        margin: 0;
        font-family: var(--a-font-title);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--a-cream);
    }
    .a-page .a-faq-group-head p {
        margin: 0;
        font-size: 0.8125rem;
        color: var(--a-subtle);
    }
    .a-page .a-faq-list {
        margin-top: 0.85rem;
        border-bottom: 1px solid var(--a-line);
    }
    .a-page .a-faq details {
        border-top: 1px solid var(--a-line);
    }
    .a-page .a-faq summary {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        cursor: pointer;
        list-style: none;
        padding: 1rem 0;
        font-size: 0.9375rem;
        line-height: 1.45;
        color: var(--a-cream);
        transition: color 0.2s ease;
    }
    .a-page .a-faq summary::-webkit-details-marker {
        display: none;
    }
    .a-page .a-faq summary::marker {
        content: "";
    }
    .a-page .a-faq summary:hover {
        color: var(--a-ember-bright);
    }
    .a-page .a-faq-mark {
        flex: none;
        width: 0.6rem;
        height: 0.6rem;
        margin-top: 0.35rem;
        color: var(--a-gold);
        transition: transform 0.25s ease;
    }
    .a-page .a-faq-mark svg {
        display: block;
        width: 100%;
        height: 100%;
    }
    .a-page .a-faq details[open] .a-faq-mark {
        transform: rotate(90deg) scale(1.15);
        color: var(--a-ember);
    }
    .a-page .a-faq-answer {
        padding-bottom: 1.25rem;
    }
    .a-page .a-faq-answer p {
        margin: 0 0 0.7rem;
        max-width: 60ch;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--a-muted);
    }
    .a-page .a-faq-answer p:last-of-type {
        margin-bottom: 0;
    }
    .a-page .a-faq-answer a {
        display: inline-block;
        margin-top: 0.8rem;
        font-size: 0.875rem;
    }

    /* ── 8 · The closing cartouche ───────────────────────── */
    .a-page .a-final {
        border-top: 1px solid var(--a-line);
    }
    /* The plate's foot: the temple and the lotus, which the first screen hides behind its windows. */
    .a-page .a-plate-foot .a-plate-img {
        background-position: 50% 100%;
        background-size: 130% auto;
    }
    .a-page .a-plate-foot::after {
        background:
            linear-gradient(180deg, var(--a-canvas) 0%, rgba(10, 7, 5, 0.6) 34%, rgba(10, 7, 5, 0.42) 68%, rgba(10, 7, 5, 0.78) 100%),
            rgba(12, 9, 7, 0.14);
    }
    .a-page .a-final-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-top: 6rem;
        padding-bottom: 6.5rem;
    }
    .a-page .a-final-heading {
        max-width: 20ch;
        margin-top: 1.4rem;
        font-size: clamp(2.1rem, 4vw, 3.25rem);
    }
    .a-page .a-final-heading span {
        display: block;
    }
    /* The rule under "forever": its own element, so it can be gold, sit where a drawn underline sits
       rather than where the font's metrics put one, and keep its weight when the heading scales. */
    .a-page .a-final-forever {
        position: relative;
        width: fit-content;
        margin: 0 auto;
        padding-bottom: 0.12em;
    }
    .a-page .a-final-forever::after {
        content: "";
        position: absolute;
        right: 0.04em;
        bottom: 0;
        left: 0.04em;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(224, 123, 39, 0.9) 18%, rgba(224, 123, 39, 0.9) 82%, transparent);
    }
    .a-page .a-final-sub {
        max-width: 46ch;
    }
    .a-page .a-final-divider {
        margin: 2rem 0;
    }

    /* ── The foot ─────────────────────────────────────────
       Five columns and a brand cell, on a ground a shade darker than the page so the band reads as the
       end of it rather than as one more section. `mt-auto` is not needed — the page's own flex column
       already pushes it down on short pages. */
    .a-page .a-foot {
        position: relative;
        overflow: hidden;
        border-top: 1px solid var(--a-line);
        background: #090706;
    }
    .a-page .a-foot-shell {
        padding-top: 3.5rem;
        padding-bottom: 2.25rem;
    }
    .a-page .a-foot-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2.25rem 1.5rem;
    }
    @media (min-width: 44rem) {
        .a-page .a-foot-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    /* Six cells in one row only from 80rem, where each gets ~190px and "Earn & the creator pool" still
       sits on one line. Below that, two even rows beat one ragged one. */
    @media (min-width: 80rem) {
        .a-page .a-foot-grid {
            grid-template-columns: 1.35fr repeat(5, minmax(0, 1fr));
            gap: 2rem;
        }
    }
    .a-page .a-foot-brand-cell {
        grid-column: 1 / -1;
    }
    @media (min-width: 44rem) {
        .a-page .a-foot-brand-cell {
            grid-column: auto;
        }
    }

    /* Same correction as the bar's brand, at this cell's own sizes — see AngkorNav for why. */
    .a-page .a-foot-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .a-page .a-foot-mark {
        transform: translateY(-0.09rem);
    }
