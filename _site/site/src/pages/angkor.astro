    {/* The download button's platform narrowing. Inline and immediately after the markup so it runs
        before the hero paints — a bundled module is deferred, and the label would visibly change under
        the reader. Without JavaScript the general case stands, and it works. */}
    <script is:inline>
        (() => {
            const hint = navigator.userAgentData?.platform || navigator.userAgent;
            const key = /Win/i.test(hint) ? "windows" : /Linux|X11/i.test(hint) && !/Android|CrOS/i.test(hint) ? "linux" : null;
            if (!key) return;
            for (const cta of document.querySelectorAll("[data-download-cta]")) {
                const platform = JSON.parse(cta.dataset.platforms || "{}")[key];
                if (!platform) continue;
                cta.href = platform.href;
                cta.querySelector("[data-download-label]").textContent = `Download for ${platform.name}`;
            }
        })();
    </script>

    <script>
        /* Three small behaviours, and none of them is load-bearing: the page is correct with the script
           removed. The bar lifts once the hero is behind you, bands fade in as they arrive, and the two
           hero frames walk their screens on alternate beats — the same six-step cycle the live hero
           runs, for the same reason (three surfaces behind, two conversations in front, so the pair
           never settles into one repeating picture). */

        const bar = document.querySelector<HTMLElement>(".a-bar");
        if (bar) {
            const lift = () => {
                if (window.scrollY > 40) bar.setAttribute("data-lifted", "");
                else bar.removeAttribute("data-lifted");
            };
            lift();
            window.addEventListener("scroll", lift, { passive: true });
        }

        const reveals = document.querySelectorAll(".a-reveal");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.1 },
            );
            reveals.forEach((el) => observer.observe(el));
        } else {
            reveals.forEach((el) => el.classList.add("is-visible"));
        }

        const STEP_MS = 6000;
        const frames = ["app", "chat"] as const;
        const shown = { app: 0, chat: 0 };
        const screensOf = (frame: string) => document.querySelectorAll<HTMLElement>(`[data-hero-screen="${frame}"]`);
        const labelsOf = (frame: string) => document.querySelectorAll<HTMLElement>(`[data-hero-label="${frame}"]`);

        if (screensOf("app").length > 1) {
            let tick = 0;
            setInterval(() => {
                const frame = frames[tick % frames.length]!;
                tick += 1;
                const screens = screensOf(frame);
                if (screens.length < 2) return;
                const next = (shown[frame] + 1) % screens.length;
                shown[frame] = next;
                screens.forEach((screen, index) => {
                    screen.classList.toggle("is-on", index === next);
                    // The frame's own alt text is the one on screen: nobody on a screen reader should be
                    // handed three descriptions of one picture.
                    screen.setAttribute("aria-hidden", index === next ? "false" : "true");
                });
                labelsOf(frame).forEach((label, index) => {
                    label.hidden = index !== next;
                });
            }, STEP_MS / frames.length);
        }
    </script>
</BaseLayout>

