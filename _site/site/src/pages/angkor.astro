---
/* ═══════════════════════════════════════════════════════════════════════════════════════════════════
 * /angkor/ — THE HOME PAGE, TOLD AS CARVED STONE.
 *
 * An alternative treatment of the landing page, parked on its own URL so it can be looked at beside the
 * live one. It is a SKIN, not a fork of the argument: every word on it comes from the same content
 * modules the live page reads (`landing.ts`, `about.ts`, `faq.ts`, `nav.ts`), so the two pages can never
 * end up making different claims, and a copy change lands on both.
 *
 * What is different is everything around the words: a photographed temple wall behind the first screen,
 * engraved display type with an ember full stop on each beat, gold rules and turned corners in place of
 * hairline borders, and a lotus wherever the live page sets a bullet dot.
 *
 * THREE FACES, EACH FENCED TO A SIZE BAND — Playfair above ~28px, Spectral from 13 to 24, Inter for
 * running copy. `styles/angkor.css` sets that out at length and explains what went wrong when it was
 * two. The short version: if you are adding something between 13 and 24px, it is `--a-font-title`.
 *
 * NOINDEX, and excluded from the sitemap in astro.config.mjs. It is a second dress on the same body:
 * left crawlable it would be a duplicate of the home page, which is the one thing a marketing site must
 * not hand a search engine.
 *
 * The styling is entirely in `styles/angkor.css`, scoped under `.a-page`. Nothing here touches the
 * tokens or component classes the rest of the site is built on.
 * ═══════════════════════════════════════════════════════════════════════════════════════════════════ */
import { gitStats } from "@intentic-dev/astro-integrations";
import { CREATOR_NAME, creatorBio, creatorRole, trustCards } from "@intentic-dev/site-content/about";
import { apiHref } from "@intentic-dev/site-content/api";
import { docsDestinations } from "@intentic-dev/site-content/docs";
import { faqGroups } from "@intentic-dev/site-content/faq";
import { guidePages, guidesHref } from "@intentic-dev/site-content/guides";
import { landingContent } from "@intentic-dev/site-content/landing";
import { productHref, productPages } from "@intentic-dev/site-content/product";
import { APP_URL, DEMO_PATH, discordUrl, githubIssuesUrl, githubReleasesUrl, githubUrl, ORG_NAME, ORG_TAGLINE } from "@intentic-dev/site-content/site";
import { PROVIDER_BRAND_PATHS, providerFillRule } from "@intentic/constants";
import { Image } from "astro:assets";
import DiscordIcon from "../components/DiscordIcon.astro";
import AngkorNav from "../components/angkor/AngkorNav.astro";
import Corners from "../components/angkor/Corners.astro";
import Lotus from "../components/angkor/Lotus.astro";
import { DIVIDER, LOZENGE } from "../components/angkor/ornaments";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DESKTOP_DOWNLOADS_PAGE, DESKTOP_GENERIC_ICON, desktopPlatforms } from "../lib/desktop-downloads";
import { COLUMN_SIZES, shotAsset, SHOT_WIDTHS } from "../lib/shots";
import "../styles/angkor.css";

const content = landingContent;

/* THE HEADLINE, RE-BEATEN. The content ships two typeset lines ("You delegate. Agents work." and "You
 * approve.") because the live hero sets them at 32px in a 26rem column. This treatment sets the same
 * words at three times that size, one sentence per line, with the full stop carrying the only ember on
 * the screen — so the beats are re-split off the same strings rather than authored a second time here.
 * Splitting on the sentence rather than on the line is what keeps this page and landing.ts one source. */
const beats = content.hero.headlineLines
    .flatMap((line) => line.split(/(?<=\.)\s+/u))
    .map((beat) => beat.replace(/\.\s*$/u, ""))
    .filter((beat) => beat.length > 0);

const appScreens = content.hero.screens.app.map((screen) => ({ ...screen, image: shotAsset(screen.name) }));
/* THE WINGS HOLD STILLS. Only the centre frame walks its surfaces (see the script at the foot of this
 * file): a cross-fade inside a 340px frame is a flicker at the edge of vision, and caught mid-fade — which
 * on a 4-second beat is a fair share of the time — it reads as two pictures printed over each other. So
 * the chat wing takes the first of the same shared list the live hero cycles, and holds it. */
const chatStill = shotAsset(content.hero.screens.chat[0]!.name);
/* THREE FRAMES ON ONE AXIS, so three measures, and all of them in `vw` because the frames take their
 * width from the window rather than from a capped shell (see `.a-hero-grid`).
 *
 * Each number is the frame's share of the window MULTIPLIED BY the crop: these are top-left crops drawn
 * larger than the frame that shows them, not whole screenshots shrunk to fit, so the pixels the browser
 * has to fetch are the drawn width and not the frame's. The centre takes 62% of the band at 112% =
 * 70vw; the plan wing 21% at 135% = 29vw; the chat wing 21% at 222% = 47vw. The middle stop covers the
 * tablet layout, where the centre widens and the wings with it. */
const appSizes = "(min-width: 64rem) 70vw, (min-width: 48rem) 78vw, 205vw";
const chatSizes = "(min-width: 64rem) 47vw, (min-width: 48rem) 56vw, 60vw";
const planSizes = "(min-width: 64rem) 29vw, (min-width: 48rem) 35vw, 40vw";

/* THE SUBHEAD, FIRST CLAUSE ONLY. The shared line is two sentences — what the product is, then a claim
 * about visibility — and this treatment keeps the first. The second is carried here by the picture
 * beside it rather than by words: three live surfaces of the product, turning, in the same screenful.
 * Sliced off the shared string rather than retyped, so a rewording upstream still lands on this page. */
const subheadLead = `${content.hero.subhead.split(/(?<=\.)\s+/u)[0] ?? content.hero.subhead}`;

/* THE CALL TO ACTION SAYS WHAT HAPPENS, NOT WHAT IT COSTS. It read "Get started free", and readers
 * kept hearing the shape that phrase almost always has on a pricing page: free NOW, priced later. The
 * product is free permanently and open source, so a word that plants a doubt about that is worse than
 * no word — and the free-ness is already carried three times over on this page, by the chips under the
 * hero, by the "what it costs" band, and by the closing line. So the button names the thing it does. */
const [leadVerb, ...verbCards] = content.verbs.items;

/* The one number on this page that would rot: every land changes it, so it is MEASURED from git during
 * the build rather than authored. When git cannot answer (a shallow CI clone, a tarball) `gitStats()`
 * returns null and the card falls back to its sentence with no figure — it never renders a zero, which
 * in a trust band is the one thing that costs more than it buys. Same source as the live page's cards. */
const stats = gitStats();

// The same table the live download button reads, for the same progressive narrowing (see the script below).
const downloadTargets = Object.fromEntries(Object.entries(desktopPlatforms).map(([key, platform]) => [key, { name: platform.name, href: platform.href }]));

/* THE FOOTER'S COLUMNS, DERIVED rather than typed out. Each one is generated from the module that owns
 * those pages, so adding a feature page or a guide puts it in this footer and the live site's on the
 * same commit, and neither can quietly go stale. The shape follows the live footer's: what the product
 * does, where it is documented, what you can build on it, and where to get help. */
const footerColumns: { label: string; links: { href: string; label: string; external?: boolean }[] }[] = [
    { label: "Features", links: productPages.map((page) => ({ href: productHref(page.slug), label: page.navLabel })) },
    {
        label: "Docs",
        links: [
            ...docsDestinations.map((destination) => ({ href: destination.href, label: destination.label })),
            { href: githubReleasesUrl, label: "Release notes", external: true },
        ],
    },
    {
        label: "Developers",
        links: [
            { href: apiHref(""), label: "Extension API" },
            { href: apiHref("build"), label: "Build an extension" },
            { href: apiHref("publish"), label: "Publish & registries" },
            { href: apiHref("services"), label: "Offer a paid service" },
            { href: "/extensions/", label: "Extension gallery" },
            { href: "/earn/", label: "Earn & the creator pool" },
        ],
    },
    { label: "Guides", links: [{ href: guidesHref(""), label: "All guides" }, ...guidePages.map((page) => ({ href: guidesHref(page.slug), label: page.navLabel }))] },
    {
        label: "Resources",
        links: [
            { href: APP_URL, label: "Open the app", external: true },
            { href: "/download/", label: "Download the app" },
            { href: "/changelog/", label: "Changelog" },
            { href: "/about/", label: "About the creator" },
            { href: discordUrl, label: "Discord community", external: true },
            { href: githubIssuesUrl, label: "Issues", external: true },
        ],
    },
];

const legalLinks = [
    { href: "/privacy/", label: "Privacy" },
    { href: "/terms/", label: "Terms" },
    { href: "/acceptable-use/", label: "Acceptable Use" },
    { href: "/dpa/", label: "DPA" },
    { href: "/subprocessors/", label: "Sub-processors" },
    { href: "/credits/", label: "Credits" },
];

// Fixed, like the live footer's: a build-time `new Date()` would make every rebuild a diff in December.
const FOOTER_YEAR = 2026;

// The repo mark, drawn once here because the bar draws its own and this file cannot reach into that component.
const GITHUB_MARK =
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---

<BaseLayout
    title={`${content.meta.title} · Angkor`}
    description={content.meta.description}
    noindex={true}
>
    <div class="a-page flex flex-1 flex-col">
        <AngkorNav />

        <main class="flex-1">
            <!-- ═══ 1 · The first screen ═══════════════════════════════════════════════════════════
                 SYMMETRIC, because the picture behind it is. The art is a framed plaque with a devata
                 standing in each outer third and a deliberately empty middle; the copy sits in that
                 middle, on the axis, and the product is spread underneath it in three frames — one
                 wide one on the centre line and a narrower one leaning in from either side. An
                 off-centre column over this plate reads as a misprint. -->
            <section class="a-hero" id="hero">
                <div class="a-plate" aria-hidden="true">
                    <div class="a-plate-img"></div>
                </div>
                <div class="a-plate-fade" aria-hidden="true"></div>

                <div class="a-hero-grid">
                    <div class="a-hero-copy">
                        {/* The one line on this page that is a greeting rather than a claim. It is built
                            from the brand name rather than typed, so a rename lands here too, and it is
                            flanked rather than underlined — the band eyebrows elsewhere trail a hairline
                            to the right, which on a centred axis would tip the whole block sideways. */}
                        <p class="a-hero-eyebrow">
                            <span class="a-hero-eyebrow-mark" set:html={LOZENGE} />
                            <span>Welcome to {ORG_NAME}</span>
                            <span class="a-hero-eyebrow-mark" set:html={LOZENGE} />
                        </p>

                        <h1 class="a-headline">
                            {
                                beats.map((beat) => (
                                    <span class="a-headline-line">
                                        <span class="a-display">{beat}</span>
                                        <span class="a-stop">.</span>
                                    </span>
                                ))
                            }
                        </h1>

                        <p class="a-hero-sub">{subheadLead}</p>

                        {/* TWO PRESSES, and resist adding a third. On a centred axis three controls in a
                            row read as a toolbar, and the claim above them drops to a caption on it.
                            They are the two ways to START: the hosted workspace, and the same thing on
                            the reader's own machine. The demo is a fourth thing a visitor might want and
                            it is not a way to start, so it rides on the picture below instead — over the
                            surface it is a recording of.
                            The download ships as the honest general case and the script at the foot of
                            this file narrows it to the reader's platform. With no JavaScript the label
                            and the link stay general, and both are still true. */}
                        <div class="a-hero-actions">
                            <a class="a-btn a-btn-primary" href={APP_URL}>
                                Create your workspace
                            </a>
                            <a class="a-btn" href={DESKTOP_DOWNLOADS_PAGE} data-download-cta data-platforms={JSON.stringify(downloadTargets)}>
                                <svg viewBox="0 0 24 24" class="a-btn-icon" fill="currentColor" aria-hidden="true"><path d={DESKTOP_GENERIC_ICON}></path></svg>
                                <span data-download-label>Download the app</span>
                            </a>
                        </div>
                    </div>

                    <!-- THE PRODUCT, IN THREE FRAMES ON ONE AXIS. The workspace is the wide one on the
                         centre line and the only one that cycles its surfaces; the plan and the chat
                         lean in from the sides, overlapping its edges, at the size a thing in the
                         middle distance would be. All three crop their screens from the top-left
                         rather than fitting them, so a reader sees the legible top of a screen instead
                         of a whole one shrunk past reading. -->
                    <figure class="a-hero-visual">
                        <div class="a-hero-stack">
                            <div class="a-window a-window-plan" aria-hidden="true">
                                <Corners />
                                <div class="a-window-rail"></div>
                                <div class="a-window-crop a-window-crop-plan">
                                    <Image src={shotAsset("chat-plan")} alt="" widths={SHOT_WIDTHS} sizes={planSizes} loading="lazy" decoding="async" class="a-screen a-screen-plan" />
                                </div>
                            </div>

                            <div class="a-window a-window-app">
                                <Corners />
                                <span class="a-finial" aria-hidden="true"><Lotus size="md" /></span>
                                <div class="a-window-rail"></div>
                                <div class="a-window-crop a-window-crop-app">
                                    {
                                        appScreens.map((screen, index) => (
                                            <Image
                                                src={screen.image}
                                                alt={screen.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes={appSizes}
                                                loading={index === 0 ? "eager" : "lazy"}
                                                fetchpriority={index === 0 ? "high" : undefined}
                                                decoding="async"
                                                class:list={["a-screen a-screen-app", index === 0 && "is-on"]}
                                                data-hero-screen="app"
                                                data-index={index}
                                                aria-hidden={index > 0 ? "true" : undefined}
                                            />
                                        ))
                                    }
                                </div>

                                {/* THE DEMO, ON THE SURFACE IT IS A RECORDING OF. It is quiet at rest and
                                    lights up when the pointer or the keyboard reaches the frame, so it
                                    reads as a property of the picture rather than as a third button
                                    competing with the two above.
                                    Quiet, not hidden: a control that only exists on hover does not exist
                                    on a touch screen. It sits top-right because the wing on the left
                                    overlaps this frame's other free corner. */}
                                <a class="a-play" href={DEMO_PATH}>
                                    <span class="a-btn a-btn-sm">
                                        <svg viewBox="0 0 24 24" class="a-btn-icon" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                                        <span>{content.hero.demo.playLabel}</span>
                                    </span>
                                </a>
                            </div>

                            <div class="a-window a-window-chat" aria-hidden="true">
                                <Corners />
                                <div class="a-window-rail"></div>
                                <div class="a-window-crop a-window-crop-chat">
                                    <Image src={chatStill} alt="" widths={SHOT_WIDTHS} sizes={chatSizes} loading="lazy" decoding="async" class="a-screen a-screen-chat" />
                                </div>
                            </div>
                        </div>
                    </figure>
                </div>
            </section>

            <!-- ═══ 2 · What you do: the five verbs ═════════════════════════════════════════════ -->
            <section class="a-band" id="verbs">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-eyebrow">{content.verbs.eyebrow}</div>
                    <h2 class="a-h2 a-display">{content.verbs.heading}</h2>
                    <p class="a-lede">{content.verbs.sub}</p>

                    {/* THE LEAD VERB IS ONE OF THE FIVE, so it is titled like the other four rather than
                        with a style of its own. It used to carry a 13px letterspaced ember caps label,
                        which was three separate mistakes in one line: display type at a size display
                        type cannot hold, a second eyebrow in a band whose eyebrow is twelve rem above
                        it, and the only element on the page wearing that treatment. It is now a heading
                        — the same lotus-and-title pair the trust cards use, one step up in size because
                        this one leads. That also gives the block the <h3> its four siblings all have,
                        so the section finally has an outline a screen reader can walk. */}
                    <div class="a-lead-verb">
                        <div class="a-lead-verb-head">
                            <div>
                                <h3 class="a-lead-verb-name">
                                    <Lotus />
                                    {leadVerb.verb}
                                </h3>
                                <p class="a-lead-verb-line">{leadVerb.line}</p>
                            </div>
                            <a href={leadVerb.href} class="a-link a-see">See it →</a>
                        </div>
                        {
                            leadVerb.shot && (
                                <div class="a-window a-window-wide">
                                    <Corners />
                                    <span class="a-finial" aria-hidden="true">
                                        <Lotus size="md" />
                                    </span>
                                    <div class="a-window-rail"></div>
                                    <Image
                                        src={shotAsset(leadVerb.shot.name)}
                                        alt={leadVerb.shot.alt}
                                        widths={SHOT_WIDTHS}
                                        sizes={COLUMN_SIZES}
                                        loading="lazy"
                                        decoding="async"
                                        class="a-window-full"
                                    />
                                </div>
                            )
                        }
                    </div>

                    <div class="a-verb-grid">
                        {
                            verbCards.map((item) => (
                                <a href={item.href} class="a-window a-verb-card">
                                    <Corners />
                                    {/* THE LEDGE IS THE FRAME'S, NOT THE PICTURE'S, so it is drawn before the
                                        branch below and every card in this grid opens on the same lip —
                                        including the one whose picture is a list. */}
                                    <div class="a-window-rail"></div>
                                    {item.shot ? (
                                        <div class="a-verb-crop">
                                            <Image
                                                src={shotAsset(item.shot.name)}
                                                alt={item.shot.alt}
                                                widths={SHOT_WIDTHS}
                                                sizes="(min-width: 64rem) 420px, (min-width: 40rem) 45vw, calc(100vw - 3rem)"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>
                                    ) : (
                                        /* Automate has no honest screenshot, so its picture is the events it
                                           wakes on — the same decision the live page makes, and for the same
                                           reason: a mocked-up automations screen would be the one lie here. */
                                        <div class="a-triggers">
                                            <div class="a-eyebrow">Wakes on</div>
                                            <ul>
                                                {item.triggers?.map((trigger) => (
                                                    <li>
                                                        <span class="a-loz" set:html={LOZENGE} />
                                                        {trigger}
                                                    </li>
                                                ))}
                                            </ul>
                                            <p class="a-triggers-out">
                                                <span aria-hidden="true">→</span> an optional command checks the event, then a new agent session starts and
                                                appears on your board.
                                            </p>
                                        </div>
                                    )}
                                    <div class="a-verb-body">
                                        <h3>{item.verb}</h3>
                                        <p>{item.line}</p>
                                    </div>
                                </a>
                            ))
                        }
                    </div>

                    <a href="/features/" class="a-link a-band-cta">{content.verbs.cta} →</a>
                </div>
            </section>

            <!-- ═══ 3 · Why a workspace: the comparison ═════════════════════════════════════════
                 Two columns of nouns, and the asymmetry between them is the whole argument — so the
                 heavy side is a lit cartouche and the light one a dashed outline that ends early. -->
            <section class="a-band" id="workspace">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-eyebrow">{content.workspace.eyebrow}</div>
                    <h2 class="a-h2 a-display">{content.workspace.heading}</h2>
                    <p class="a-lede">{content.workspace.sub}</p>

                    <div class="a-compare">
                        <div class="a-card a-compare-ours">
                            <Corners />
                            <div class="a-compare-head">
                                <h3>{content.workspace.comparison.ours.label}</h3>
                                <span>{content.workspace.comparison.ours.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.ours.items.map((item) => (
                                        <li>
                                            <Lotus />
                                            {item}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="a-compare-chat">
                            <div class="a-compare-head">
                                <h3>{content.workspace.comparison.chat.label}</h3>
                                <span>{content.workspace.comparison.chat.note}</span>
                            </div>
                            <ul>
                                {
                                    content.workspace.comparison.chat.items.map((item) => (
                                        <li>
                                            <span class="a-loz a-loz-hollow" set:html={LOZENGE} />
                                            {item}
                                        </li>
                                    ))
                                }
                            </ul>
                            <p class="a-compare-missing">{content.workspace.comparison.chat.missing}</p>
                        </div>
                    </div>

                    <div class="a-compare-foot">
                        <p>{content.workspace.comparison.footnote}</p>
                        <a href="/features/review/" class="a-link">How reviewing agent work works →</a>
                    </div>
                </div>
            </section>

            <!-- ═══ 4 · What it costs ═══════════════════════════════════════════════════════════ -->
            <section class="a-band" id="economics">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-eyebrow">{content.economics.eyebrow}</div>
                    <h2 class="a-h2 a-display">{content.economics.heading}</h2>
                    <p class="a-lede">{content.economics.sub}</p>

                    <div class="a-econ">
                        <div class="a-card a-accounts">
                            <Corners set="diag" />
                            <div class="a-accounts-head"><span class="a-eyebrow">Your agent accounts</span></div>
                            <ul>
                                {
                                    content.economics.accounts.map((account) => (
                                        <li>
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                                <path d={PROVIDER_BRAND_PATHS[account.logo]} fill-rule={providerFillRule(account.logo)} />
                                            </svg>
                                            <span class="a-account-name">{account.name}</span>
                                            <span class="a-account-detail">{account.detail}</span>
                                            <span class="a-account-tag">subscription</span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="a-card a-flat">
                            <Corners set="diag" />
                            <div class="a-eyebrow">Flat, not metered</div>
                            <ul>
                                {
                                    content.economics.points.map((point) => (
                                        <li>
                                            <Lotus />
                                            {point}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══ 5 · Who builds it ═══════════════════════════════════════════════════════════ -->
            <section class="a-band" id="trust">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-trust">
                        <div>
                            <div class="a-eyebrow">{content.trust.eyebrow}</div>
                            <h2 class="a-h2 a-display">{CREATOR_NAME}</h2>
                            <p class="a-lede">{creatorRole}</p>
                            <p class="a-trust-bio">{creatorBio}</p>
                            <a href="/about/" class="a-link a-band-cta">{content.trust.cta} →</a>
                        </div>

                        <div class="a-trust-cards">
                            {
                                trustCards.map((card) => (
                                    <div class="a-card a-trust-card">
                                        <Corners set="diag" />
                                        <h3>
                                            <Lotus />
                                            {card.title}
                                        </h3>
                                        {card.stat === "commits" && stats !== null && (
                                            <p class="a-trust-stat">
                                                {stats.agent.toLocaleString("en-US")} of {stats.total.toLocaleString("en-US")}
                                                <span>commits since {stats.since}</span>
                                            </p>
                                        )}
                                        <p>{card.body}</p>
                                        {card.href && (
                                            <a
                                                href={card.href}
                                                target={card.href.startsWith("http") ? "_blank" : undefined}
                                                rel={card.href.startsWith("http") ? "noopener" : undefined}
                                                class="a-link"
                                            >
                                                {card.linkLabel} →
                                            </a>
                                        )}
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══ 6 · Getting started ═════════════════════════════════════════════════════════ -->
            <section class="a-band" id="connect">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-eyebrow">{content.connect.eyebrow}</div>
                    <h2 class="a-h2 a-display">{content.connect.heading}</h2>
                    <p class="a-lede">{content.connect.sub}</p>

                    <div class="a-steps">
                        {
                            content.connect.steps.map((step, i) => (
                                <div class="a-step">
                                    <div class="a-step-num a-display" aria-hidden="true">
                                        0{i + 1}
                                    </div>
                                    <h3>{step.title}</h3>
                                    <p>{step.body}</p>
                                </div>
                            ))
                        }
                    </div>

                    <div class="a-frame a-command">
                        <Corners />
                        <div class="a-command-head"><span class="a-eyebrow">Step 3 · your machine</span></div>
                        <pre><code><span class="a-prompt">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                    </div>
                    <p class="a-command-note">{content.connect.commandNote}</p>

                    <div class="a-card a-desktop">
                        <Corners set="diag" />
                        <div>
                            <p class="a-desktop-lead">{content.connect.desktop.lead}</p>
                            <p class="a-desktop-note">{content.connect.desktop.note}</p>
                        </div>
                        {/* THE ONE DOWNLOAD ON THE PAGE, and it names the reader's own machine. It sits
                            beside the install command because that is the question it answers: the same
                            step, for someone who would rather not open a terminal. The two data
                            attributes are what the inline script at the foot of this file narrows. With
                            no JavaScript the label and the href stay general, and both are still true. */}
                        <a class="a-btn a-btn-sm" href={DESKTOP_DOWNLOADS_PAGE} data-download-cta data-platforms={JSON.stringify(downloadTargets)}>
                            <span data-download-label>{content.connect.desktop.cta}</span>
                        </a>
                    </div>
                </div>
            </section>

            <!-- ═══ 7 · FAQ ═════════════════════════════════════════════════════════════════════
                 Native <details>, so the whole widget costs no JavaScript and keeps keyboard and
                 screen-reader behaviour for free. `name` makes each band an exclusive accordion. -->
            <section class="a-band" id="faq">
                <div class="a-wall" aria-hidden="true"></div>
                <div class="a-shell a-reveal">
                    <div class="a-eyebrow">FAQ</div>
                    <h2 class="a-h2 a-display">Questions, answered plainly.</h2>
                    <p class="a-lede">Including the honest ones: what's free, what's stored where, what isn't ready yet.</p>

                    <div class="a-faq">
                        {
                            faqGroups.map((group) => (
                                <div class="a-faq-group" id={`angkor-${group.id}`}>
                                    <div class="a-faq-group-head">
                                        <h3>{group.label}</h3>
                                        <p>{group.blurb}</p>
                                    </div>
                                    <div class="a-faq-list">
                                        {group.items.map((item) => (
                                            <details name={`angkor-${group.id}`}>
                                                <summary>
                                                    <span>{item.question}</span>
                                                    <span class="a-faq-mark" aria-hidden="true" set:html={LOZENGE} />
                                                </summary>
                                                <div class="a-faq-answer">
                                                    {item.answer.map((paragraph) => (
                                                        <p>{paragraph}</p>
                                                    ))}
                                                    {item.more && (
                                                        <a href={item.more.href} class="a-link">
                                                            {item.more.label} →
                                                        </a>
                                                    )}
                                                </div>
                                            </details>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- ═══ 8 · The closing cartouche ═══════════════════════════════════════════════════
                 The plate returns, cropped to its foot — the temple and the lotus at the bottom of the
                 art, which is the half the first screen never shows because the windows cover it. -->
            <section class="a-band a-final">
                <div class="a-plate a-plate-foot" aria-hidden="true">
                    <div class="a-plate-img"></div>
                </div>
                {/* THE ONE PLACE THIS PAGE AUTHORS ITS OWN WORDS. Everywhere else the copy is read from
                    `landing.ts`, so the treatment can never make a claim the live page does not — see the
                    file header. The closing band is the exception, by request: it argues from the licence
                    and the community rather than from the fleet, so it needs a sentence the live page does
                    not have. If this ever becomes the site's closing argument rather than this page's, it
                    belongs back in `landing.ts` with the rest. */}
                <div class="a-shell a-reveal a-final-inner">
                    <Lotus size="lg" class="a-final-lotus" />
                    <h2 class="a-h2 a-display a-final-heading">
                        <span>Open-source and free</span>
                        {/* The underline is drawn rather than `text-decoration`, which on a face this
                            large sits too close and too thin, and cannot take the page's gold. */}
                        <span class="a-final-forever">forever</span>
                    </h2>
                    <p class="a-lede a-final-sub">
                        Contribute to our code, extend workspace<br />or offer services for others.
                    </p>
                    <span class="a-divider a-final-divider" aria-hidden="true" set:html={DIVIDER} />
                    <div class="a-hero-actions">
                        <a class="a-btn a-btn-primary" href={APP_URL}>
                            Create your workspace
                        </a>
                        <a class="a-btn" href={githubUrl} target="_blank" rel="noopener">
                            See the source
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <!-- ═══ The foot ════════════════════════════════════════════════════════════════════════
             A REAL FOOTER, columns and all. What stood here was a single strip of eight links and a
             line admitting the page was a mock-up — fine for something nobody scrolls to, and this is
             not that: the footer is where a reader who has read the whole page goes looking for the one
             thing the page did not cover, and half the site is reachable from nowhere else.
             Every column is built from the same modules the live site's footer reads, so a page added
             anywhere shows up in both without either being edited. -->
        <footer class="a-foot">
            <div class="a-wall" aria-hidden="true"></div>
            <div class="a-shell a-foot-shell">
                <div class="a-foot-grid">
                    <div class="a-foot-brand-cell">
                        <div class="a-foot-brand">
                            <Lotus size="md" class="a-foot-mark" />
                            <span class="a-foot-word">intentic</span>
                        </div>
                        <p class="a-foot-tagline">{ORG_TAGLINE}</p>
                        <div class="a-foot-social">
                            <a href={githubUrl} target="_blank" rel="noopener" class="a-bar-icon a-foot-icon" aria-label="GitHub repository">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true">
                                    <path d={GITHUB_MARK} />
                                </svg>
                            </a>
                            <a href={discordUrl} target="_blank" rel="noopener" class="a-bar-icon a-foot-icon" aria-label="Discord community">
                                <DiscordIcon size={17} />
                            </a>
                        </div>
                    </div>

                    {
                        footerColumns.map((column) => (
                            <div class="a-foot-col">
                                <div class="a-eyebrow">{column.label}</div>
                                <ul>
                                    {column.links.map((link) => (
                                        <li>
                                            <a
                                                href={link.href}
                                                class="a-foot-link"
                                                target={link.external ? "_blank" : undefined}
                                                rel={link.external ? "noopener" : undefined}
                                            >
                                                {link.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>

                <div class="a-foot-rule" aria-hidden="true"></div>

                <div class="a-foot-base">
                    <p>© {FOOTER_YEAR} {ORG_NAME}. The sandbox and the CLI are MIT.</p>
                    <div class="a-foot-legal">
                        {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                    </div>
                </div>
            </div>
        </footer>
    </div>

    {/* The download button's platform narrowing. Inline and immediately after the markup so it runs
        before the hero paints — a bundled module is deferred, and the label would visibly change under
        the reader. Without JavaScript the general case stands, and it works. */}
    <script is:inline>
        (() => {
            const hint = navigator.userAgentData?.platform || navigator.userAgent;
            const key = /Win/i.test(hint) ? "windows" : /Linux|X11/i.test(hint) && !/Android|CrOS/i.test(hint) ? "linux" : null;
            if (!key) return;
            for (const cta of document.querySelectorAll("[data-download-cta]")) {
                const platform = JSON.parse(cta.dataset.platforms || "{}")[key];
                if (!platform) continue;
                cta.href = platform.href;
                cta.querySelector("[data-download-label]").textContent = `Download for ${platform.name}`;
            }
        })();
    </script>

    <script>
        /* Four small behaviours, and none of them is load-bearing: the page is correct with the script
           removed, only less exactly aligned at the top. The bar is fitted to the plate's carved band,
           the bar lifts once the hero is behind you, bands fade in as they arrive, and the two hero
           frames walk their screens on alternate beats — the same six-step cycle the live hero runs, for
           the same reason (three surfaces behind, two conversations in front, so the pair never settles
           into one repeating picture). */

        /* THE BAR IS FITTED TO THE FRAME IT SITS IN, and that can only be measured. The full reasoning
           is on `--a-plate-band` in angkor.css; the short version is that `cover` scales the art by
           `max(boxWidth/1600, boxHeight/900)`, the plate's box height is the hero's CONTENT height, and
           so no stylesheet can name the scale. Here it is one line: measure the painted box, take the
           larger term, and the bar's height is 90 art-units of it — twice the 45 at which the band's
           centre sits, because the bar hangs from the plate's top rather than the band's.

           Writing the answer back cannot disturb the measurement: the bar is `position: fixed`, so its
           height is outside the flow that sets the hero's — no observer loop. The selector excludes the
           footer's plate deliberately; it paints the same art at a different size. */
        const heroPlate = document.querySelector<HTMLElement>(".a-plate:not(.a-plate-foot) > .a-plate-img");
        const page = document.querySelector<HTMLElement>(".a-page");
        if (heroPlate && page && "ResizeObserver" in window) {
            /* AND ONLY WHILE THERE IS A FRAME TO SIT IN. Once the hero stacks, its box goes from wider
               than the art to much taller, `cover` enlarges the art by half again, and the carved border
               stops being a border: it becomes a hundred pixels of soft texture with no rule at the
               bottom of it. Fitting the bar to that is measurably perfect and visibly wrong — a logo
               floating sixty pixels down a black screen with nothing above it.
               So the fit is gated on the box still being roughly the art's shape. Measured, the two
               regimes are far apart — 1.41 at the last unstacked width against 0.80 at the first stacked
               one — so 1.2 is a gap, not a knife edge. Outside it the property is dropped and the
               stylesheet's own value applies. */
            const FRAMED_ASPECT = 1.2;
            const fitBandToPlate = () => {
                const { width, height } = heroPlate.getBoundingClientRect();
                if (!width || !height) return;
                if (width / height < FRAMED_ASPECT) {
                    page.style.removeProperty("--a-plate-band");
                    return;
                }
                const scale = Math.max(width / 1600, height / 900);
                page.style.setProperty("--a-plate-band", `${(90 * scale).toFixed(2)}px`);
            };
            fitBandToPlate();
            new ResizeObserver(fitBandToPlate).observe(heroPlate);
        }

        const bar = document.querySelector<HTMLElement>(".a-bar");
        if (bar) {
            const lift = () => {
                if (window.scrollY > 40) bar.setAttribute("data-lifted", "");
                else bar.removeAttribute("data-lifted");
            };
            lift();
            window.addEventListener("scroll", lift, { passive: true });
        }

        const reveals = document.querySelectorAll(".a-reveal");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.1 },
            );
            reveals.forEach((el) => observer.observe(el));
        } else {
            reveals.forEach((el) => el.classList.add("is-visible"));
        }

        /* ONE FRAME WALKS, and it is the middle one. The two wings hold stills: a cross-fade in a frame
           that size is movement at the edge of vision with nothing to show for it, and the centre is
           where a reader is already looking. Three surfaces, four seconds each. */
        const screens = document.querySelectorAll<HTMLElement>('[data-hero-screen="app"]');
        if (screens.length > 1) {
            let shown = 0;
            setInterval(() => {
                shown = (shown + 1) % screens.length;
                screens.forEach((screen, index) => {
                    screen.classList.toggle("is-on", index === shown);
                    // The alt text a screen reader gets is the one on screen: nobody should be handed
                    // three descriptions of one picture.
                    screen.setAttribute("aria-hidden", index === shown ? "false" : "true");
                });
            }, 4000);
        }
    </script>
</BaseLayout>

<style is:global>
    /* ── The shell every band shares ─────────────────────── */
    .a-page .a-shell {
        position: relative;
        max-width: 84rem;
        margin: 0 auto;
        padding: 5.5rem 1.5rem;
    }
    .a-page .a-band {
        position: relative;
        overflow: hidden;
    }

    .a-page .a-h2 {
        margin: 0.9rem 0 0;
        max-width: 24ch;
        font-size: clamp(1.9rem, 3.2vw, 2.75rem);
        line-height: 1.16;
    }
    .a-page .a-lede {
        margin: 1rem 0 0;
        max-width: 52ch;
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--a-muted);
    }
    .a-page .a-band-cta {
        display: inline-block;
        margin-top: 2.5rem;
        font-size: 0.9375rem;
        font-weight: 500;
    }

    /* ── 1 · The first screen ────────────────────────────── */
    .a-page .a-hero {
        position: relative;
        overflow: hidden;
    }
    /* ONE AXIS, and the picture is why. The plate behind this band is a framed plaque with a figure
       standing in each outer third and a deliberately empty middle; the copy sits on that middle and the
       product is laid out UNDER it rather than beside it. The two-column grid that stood here set the
       headline in the left third, which on this art is a devata's shoulder.
       The padding lands the whole band — frame, copy and product — inside about one screen of a laptop.
       Pushing the plaque's bottom rail below the fold turns a framed wall into a wall that runs out. */
    /* THE ONLY BAND ON THE PAGE WITH NO MEASURE OF ITS OWN, and the picture behind it is why.
       Every other band stops at 84rem because a column of words has a width past which it stops being
       readable. This one is not a column of words: it is a plaque with two figures standing in its outer
       thirds, and where those figures land is decided by the plate's width — which is the window's. Cap
       the band and the product frames stay put while the figures walk outwards, until on a wide screen
       they are out at the edges with an acre of empty wall between them.
       So the frames below take their width from the window, exactly as the plate does, and the two track
       each other at 1440, at 1920 and at 2560 with nothing to restate. The COPY still has a measure —
       44rem, set on `.a-hero-copy` — because that part of the band really is a column of words, and its
       type stays the size it is everywhere else on the page. */
    .a-page .a-hero-grid {
        position: relative;
        padding: 7rem 2rem 3rem;
    }
    /* 44rem, and the headline sets it: three beats, one sentence to a line, and this is the widest the
       column can be before the shortest of them stops filling its line. */
    .a-page .a-hero-copy {
        position: relative;
        z-index: 3;
        max-width: 44rem;
        margin: 0 auto;
        text-align: center;
    }

    /* THE GREETING, FLANKED RATHER THAN UNDERLINED. Every other eyebrow on this page trails a fading
       hairline to the right, which opens a left-set band and tilts a centred one. Here the same lozenge
       stands on either side instead and the rule is dropped. */
    .a-page .a-hero-eyebrow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        margin: 0 0 1.4rem;
        font-size: 0.6875rem;
        line-height: 1rem;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--a-ember);
    }
    .a-page .a-hero-eyebrow-mark {
        flex: none;
        width: 0.58rem;
        height: 0.58rem;
        opacity: 0.9;
    }
    .a-page .a-hero-eyebrow-mark svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    /* Sized against the full width of the screen rather than a column, because on this layout it has one.
       THE LEADING IS 1.16, NOT THE 1.04 A DISPLAY SETTING USUALLY WANTS, and the reason is that these are
       three SENTENCES rather than three lines of one. Each ends on its own full stop and each is a
       separate claim, so they need the air between them that a paragraph break would give — set solid
       they read as one phrase that happens to have wrapped, and the ember stops lose their beat.
       Playfair's ascenders and descenders are long, which is what makes 1.04 look tight here where it
       would look right on a face with shorter extenders. */
    .a-page .a-headline {
        margin: 0;
        font-size: clamp(2.55rem, 5.6vw, 4.6rem);
        line-height: 1.16;
        font-weight: 600;
    }
    .a-page .a-headline-line {
        display: block;
        white-space: nowrap;
    }
    /* A little more air between the three beats than the line-height alone gives. Each beat is its own
       sentence and its own claim, so the gap between them is set on the sibling join rather than by
       loosening the leading — the first beat keeps its distance from the eyebrow, the last from the
       subhead, and only the beat-to-beat step opens up. */
    .a-page .a-headline-line + .a-headline-line {
        margin-top: 0.14em;
    }
    /* The ember stop rides just off the last letter, the way a carved full stop would. */
    .a-page .a-stop {
        margin-left: 0.06em;
        font-family: var(--a-font-display);
    }

    /* THE ONE LINE UNDER THE HEADLINE, and the last of the words on this screen. What used to follow it —
       a plain restatement, then a row of three claims about price and providers — said in eleven lines
       what the headline and the picture between them already say, and pushed the product below the fold
       to do it. Both are still on the page further down, in the bands that exist to make those arguments.
       The colour is sampled off the reference art rather than picked. A near-white here (#e4d3b6, which
       is what stood) reads as paper laid over stone on a wall this warm; the amber below is several steps
       warmer and one step darker, so it separates from the cream headline by TEMPERATURE as much as by
       brightness. `balance` splits the sentence on its own clause rather than filling the measure. */
    .a-page .a-hero-sub {
        margin: 1.4rem auto 0;
        max-width: 36ch;
        font-size: 1.15rem;
        line-height: 1.6;
        color: #c2a077;
        text-wrap: balance;
    }

    /* One control row, used twice — here and in the closing band — and centred in both. */
    .a-page .a-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.9rem;
    }
    .a-page .a-hero-copy .a-hero-actions {
        margin-top: 2.1rem;
    }

    /* ── The product, in three frames on one axis ─────────
       The workspace sits on the centre line and a narrower surface leans in from either side, overlapping
       its edges: one near thing in the middle, two at middle distance. Only the centre frame is in flow —
       it sets the block's height — and the two wings hang off their own edges of the same span, so the
       composition holds its proportions at every width without a media query per frame.
       All three CROP their screenshot from the top-left rather than fitting it. A whole screen shrunk into
       a 370px wing is a grey rectangle; its top-left corner at full size is still a readable list. */
    .a-page .a-hero-visual {
        position: relative;
        margin: 2.6rem 0 0;
    }
    /* THE STACK TAKES A CEILING, so the three frames stop filling the whole window on a wide screen.
       Uncapped, the workspace and its two wings grew with the viewport until they ran off both edges and
       swamped the copy above them. The centre is 62% of this box and each wing a fifth of it, so capping
       the box and centring it shrinks all three together and holds every overlap exactly as it was — the
       wings still climb into the figures, just a touch further in. It only bites past ~74rem, so the
       tablet and phone layouts below are untouched. */
    .a-page .a-hero-stack {
        position: relative;
        max-width: 74rem;
        margin-inline: auto;
    }
    /* The centre frame is the only one in flow, so it sets the block's height, and it carries a deeper
       shadow than the shared frame style gives it: it is standing ON the two wings rather than beside
       them, and that is the one place on this page where a cast shadow has real work to do. */
    .a-page .a-window-app {
        position: relative;
        z-index: 2;
        width: 62%;
        margin: 0 auto;
        box-shadow:
            0 2px 0 rgba(201, 160, 92, 0.06),
            0 0 2.5rem 0.4rem rgba(0, 0, 0, 0.6),
            0 2rem 4.5rem -0.8rem rgba(0, 0, 0, 0.9);
    }
    /* THE WINGS RISE INTO THE FIGURES, and that is the point of them.
       Each stands in the outer third of the plate, which is exactly where the art puts a devata, and each
       is pulled up until its top rail crosses her lower body. That overlap is what binds the product to
       the wall: level with the centre frame the three read as a row of thumbnails sitting ON a picture,
       climbing into it they read as one arrangement standing IN it. The reference composition does the
       same thing, and the copy above is unaffected because both wings are outside its measure.
       They rise by different amounts so the pair is not a mirror.
       BOTH SIT BEHIND THE CENTRE, and that is a layering decision rather than a stacking accident. One
       wing in front and one behind reads as depth until you put a control on the middle frame: anything
       in that frame's own corner is then paintable over by the wing above it, and the demo press ended up
       half under a conversation panel. Behind, the centre keeps its four corners for its own use, and the
       hierarchy says plainly which of the three surfaces is the product. */
    .a-page .a-window-plan,
    .a-page .a-window-chat {
        position: absolute;
        z-index: 1;
        pointer-events: none;
    }
    .a-page .a-window-plan {
        top: -27%;
        left: 0;
        width: 21%;
    }
    .a-page .a-window-chat {
        top: -21%;
        right: 0;
        width: 21%;
    }

    .a-page .a-window-crop {
        position: relative;
        overflow: hidden;
    }
    /* One crop shape per surface, each cut to end on a horizon in the screenshot rather than through the
       middle of a row: the workspace on its table of runs, the plan on its checklist, the chat on a reply.
       The centre is the widest of the three on purpose — it is the only one carrying rows a reader is
       meant to read across, and every 100px of height it takes is 100px the whole first screen grows by. */
    .a-page .a-window-crop-app {
        aspect-ratio: 16 / 9;
    }
    /* The wings are PORTRAITS. They are half the centre's width and have to reach from a figure's waist
       down to near the centre frame's foot, and a landscape crop that tall would be a letterbox with a
       margin. Portrait also suits what is in them: a plan is a list and a conversation is a column. */
    .a-page .a-window-crop-plan {
        aspect-ratio: 1 / 2;
    }
    .a-page .a-window-crop-chat {
        aspect-ratio: 5 / 9;
    }
    .a-page .a-screen {
        position: absolute;
        top: 0;
        left: 0;
        max-width: none;
    }
    /* The centre frame is wide enough to hold its screenshot at close to true size; the two wings are not,
       so they are drawn a third over and crop harder. A wing set at the centre's scale is a grey mosaic —
       the point of a surface at middle distance is that you can still tell what it is. */
    .a-page .a-screen-app {
        width: 112%;
    }
    /* Each wing is drawn wide enough to FILL its portrait crop, and the two need very different amounts.
       The plan's source is already a tall column, so a third over is enough. The chat's is a landscape
       panel split into a list and a conversation, and 215% is not a round number: it is the width that
       lands the crop's right edge ON the seam between those two panes. A few points either side and the
       wing shows a column plus a slice of something else, which is what a crop looks like when it is an
       accident. */
    .a-page .a-screen-plan {
        width: 135%;
    }
    .a-page .a-screen-chat {
        width: 222%;
    }

    /* ── The press into the demo ──────────────────────────
       It covers the whole centre frame so the whole picture is the target, and carries its own label in
       the top-right corner. The scrim it lays down is nearly nothing at rest and a real veil under the
       pointer, which is what makes the frame feel like something you can open rather than a picture of
       one. `inset: 0` starts below the ledge so the ornament and the label never share a corner. */
    .a-page .a-play {
        position: absolute;
        inset: var(--a-corner-size) 0 0;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 0.85rem;
        background: rgba(10, 7, 5, 0.06);
        transition: background-color 0.25s ease;
    }
    .a-page .a-play:hover,
    .a-page .a-play:focus-visible {
        background: rgba(10, 7, 5, 0.42);
    }
    /* THE PRESS IS THE PAGE'S OWN SMALL BUTTON, borrowed whole. It used to be a bespoke pill with its own
       outline, its own colours and its own hover — three copies of a recipe that already existed, and the
       one place on the page where the frame visibly changed colour at the notches, because its outline was
       a resampled nine-slice. Using the real control removes all of that and the fault with it.
       What is left here is only what a button ON A PICTURE needs that one on the page does not: the whole
       frame is the target, so the anchor covers it, and hovering anywhere on the picture has to light the
       button even though the pointer is nowhere near it. */
    .a-page .a-play:hover .a-btn::before,
    .a-page .a-play:hover .a-btn::after,
    .a-page .a-play:focus-visible .a-btn::before,
    .a-page .a-play:focus-visible .a-btn::after {
        opacity: 1;
    }
    .a-page .a-play:hover .a-btn,
    .a-page .a-play:focus-visible .a-btn {
        color: #fff6e6;
    }

    /* ── 2 · The verbs ───────────────────────────────────── */
    .a-page .a-lead-verb {
        margin-top: 3.5rem;
    }
    .a-page .a-lead-verb-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        max-width: 52rem;
    }
    .a-page .a-lead-verb-name {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        font-family: var(--a-font-title);
        font-size: 1.375rem;
        font-weight: 600;
        color: var(--a-cream);
    }
    .a-page .a-lead-verb-line {
        margin: 0.6rem 0 0;
        max-width: 46ch;
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--a-cream);
    }
    .a-page .a-see {
