---
import DevicePairing from "../../../components/devices/DevicePairing.astro";

/* WHERE A WATCH'S PAIRING CODE LANDS WHEN THE PHONE'S APP DID NOT OPEN IT. A watch has no camera, so its card's QR code
   is scanned by the phone beside it: a link to this page with the code in its fragment, which no server ever receives.
   Android opens Intentic Device for it when the app is installed and its link verified, and the app sends the code on to
   the watch. Otherwise the phone's browser shows this page, which hands the code to the app by its own scheme, or says
   where to get the app. The code never leaves the browser. */
---

<DevicePairing
    product={{ name: "Intentic Device for Wear OS", path: "/watch/" }}
    heading="Connect your watch"
    hasCode="This link carries a one-time code for a Wear OS watch. Open it in Intentic Device on this phone, and it sends the code to the watch paired with the phone. The watch then asks you before it connects."
    noCode="This page opens a watch's pairing code in Intentic Device on your phone. Scan the QR code on your watch's card in the sandbox with your phone to get one."
    openLabel="Send to my watch"
    downloadLabel="No Intentic Device on this phone? Download it"
    scheme="watch"
>
    The watch needs Intentic Device too: <a href="/watch/" class="text-link hover:underline">how to put it on a watch</a>. The code
                works once and expires about ten minutes after it was made. If it has expired, press Connect on the watch's card again for a
                fresh one.
</DevicePairing>
