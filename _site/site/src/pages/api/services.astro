---
import { apiBook } from "@intentic-dev/site-content/api";
import { creatorSharePct } from "@intentic-dev/site-content/pool";
import { discordUrl } from "@intentic-dev/site-content/site";
import DocsCodeBlock from "../../components/DocsCodeBlock.astro";
import DocsLayout from "../../components/DocsLayout.astro";
import DocsRelated from "../../components/DocsRelated.astro";

/* THE PROVIDER'S PAGE. This is the plumbing behind the service lane of /earn/, which keeps the economics and shows
 * the chat flow. This page holds only what a provider implements, and every technical claim on it mirrors the
 * platform's own forward and the demo upstream that verifies it, so the reference cannot drift from what the
 * forward actually sends. */

const verify = `import { createHmac, timingSafeEqual } from "node:crypto";

// x-intentic-signature = HMAC-SHA256(secret, "{timestamp}.{body}"); reject anything older than a few minutes.
export function verifyIntenticSignature(body: string, timestamp: string, signature: string, secret: string): boolean {
    if (Math.abs(Date.now() / 1000 - Number(timestamp)) > 300) return false;
    const expected = createHmac("sha256", secret).update(\`\${timestamp}.\${body}\`).digest("hex");
    const a = Buffer.from(signature, "utf8");
    const b = Buffer.from(expected, "utf8");
    return a.length === b.length && timingSafeEqual(a, b);
}`;

const exchange = `POST /your-endpoint HTTP/1.1
content-type: application/json
x-intentic-timestamp: 1791234567
x-intentic-signature: 3f1a9c…   # HMAC-SHA256 over "{timestamp}.{body}"

{ "query": "which subreddits fit a self-hosted agent workspace?" }

HTTP/1.1 200 OK
content-type: application/json

{ "communities": [ … ], "timing": "…", "confidence": 0.82 }`;

/* THE RUN, DRAWN — geometry for the round-trip figure, computed so the picture cannot show a party or a hop
 * the prose beside it doesn't. Three actors across the width; the call travels right along one row and the
 * answer travels back left along the next; the dashed row underneath is the model's honesty as geometry —
 * "no answer, no charge". The reader's own column (YOU) is the tinted one, the way Earn is on the lifecycle. */
const RUN = { w: 600, h: 210 };
const runActors = [
    { id: "member", label: "MEMBER", sub: "their agent · holds credits", cx: 92 },
    { id: "platform", label: "PLATFORM", sub: "the ledger · the relay", cx: 300 },
    { id: "you", label: "YOU", sub: "one HTTPS endpoint", cx: 508 },
];
const runBox = { w: 132, h: 34, y: 12 };
const runLane = { y1: 66, y2: 192 };
const [MX, PX, YX] = runActors.map((a) => a.cx);
const RUN_FWD = 100;
const RUN_RET = 140;
const RUN_REF = 180;
const RUN_PAD = 10;
// The same round trip as ordered steps, for phone widths where the wave would set its labels at a few pixels.
const runSteps = [
    "The <strong>member</strong> approves a priced run in chat — nothing is spent yet.",
    "The <strong>platform</strong> charges the member's credits and forwards one <strong>signed</strong> call to your endpoint.",
    "You <strong>verify the signature</strong> and answer — JSON in, JSON out, up to a minute, no streaming.",
    "The platform <strong>relays your answer back verbatim</strong>, and you're paid.",
    "No answer — a 5xx or a timeout — and the <strong>charge is reversed</strong>. You aren't paid; it cost the member nothing.",
];
---

<DocsLayout
    book={apiBook}
    pageId="services"
    heading="Offer a paid service"
    lead="A service is not an extension: no manifest, bundle or repo pointer. It is one HTTPS endpoint that receives metered, signed calls from the platform. The technical bar is verifying a webhook; the catalog itself is curated."
>
    <h2>What a service is for</h2>
    <p>
        Most tools should be free extensions. Reach for a <strong>service</strong> only when every run costs <em>you</em> real money —
        a paid data API, heavy compute, a licensed corpus — so giving it away per run would mean paying to be used. This page is the
        provider's side; what a run looks like from the member's seat is on <a href="/earn/">Earn</a>.
    </p>
    <table>
        <thead>
            <tr><th></th><th>Extension</th><th>Service</th></tr>
        </thead>
        <tbody>
            <tr><td><strong>What it is</strong></td><td>Code of yours, run in someone's sandbox</td><td>One HTTPS endpoint, run by you</td></tr>
            <tr><td><strong>Every run</strong></td><td>Free, forever</td><td>Costs credits, priced by you</td></tr>
            <tr><td><strong>What ships</strong></td><td>A repo pointer, pinned to a commit</td><td>Nothing — a signed call reaches your endpoint</td></tr>
            <tr><td><strong>You're paid</strong></td><td>Donations from the monthly pool</td><td>A share of every paid run</td></tr>
        </tbody>
    </table>

    <h2>The shape of a run</h2>
    <p>
        The platform is the intermediary, and the whole thing is <strong>one HTTP round trip</strong>: it charges the member's credits
        atomically, forwards their JSON to you with a signature, and relays your answer back verbatim. Version 1 is sized for
        research-and-answer services, not live feeds.
    </p>

    <div class="docs-embed mt-6">
        {/* The round trip, on wide screens: the call travels right, the answer travels back, and the honest branch drops underneath. */}
        <figure class="relative hidden overflow-hidden rounded-2xl border border-line bg-canvas/60 sm:block">
            <div class="grid-overlay"></div>
            <div
                class="pointer-events-none absolute top-1/2 left-1/2 h-64 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full"
                style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 13%, transparent), transparent 70%)"
                aria-hidden="true"
            >
            </div>
            <div class="relative p-4 sm:p-5">
                <svg
                    viewBox={`0 0 ${RUN.w} ${RUN.h}`}
                    class="h-auto w-full text-link"
                    role="img"
                    aria-label="One paid run as a round trip: the member approves, the platform charges the member's credits and forwards a signed call, your endpoint verifies it and answers, and the answer is relayed back verbatim and paid. If you do not answer, the platform reverses the charge."
                >
                    <defs>
                        <marker id="run-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                            <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
                        </marker>
                        <marker id="run-refund" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                            <path d="M0 0 L10 5 L0 10 z" fill="var(--color-success)" />
                        </marker>
                    </defs>

                    {/* A faint lifeline under each actor, so every arrow end maps to who acts. */}
                    {runActors.map((a) => <line x1={a.cx} y1={runLane.y1} x2={a.cx} y2={runLane.y2} stroke="var(--color-line)" stroke-width="1" stroke-dasharray="3 5" />)}

                    {/* Forward: the call, charged and signed, travelling right. */}
                    <path d={`M ${MX + RUN_PAD} ${RUN_FWD} L ${PX - RUN_PAD} ${RUN_FWD}`} fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#run-arrow)" />
                    <path d={`M ${PX + RUN_PAD} ${RUN_FWD} L ${YX - RUN_PAD} ${RUN_FWD}`} fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#run-arrow)" />
                    <text x={(MX + PX) / 2} y={RUN_FWD - 8} text-anchor="middle" font-size="9.5" style="fill: var(--color-muted)">approves a priced run</text>
                    <text x={(PX + YX) / 2} y={RUN_FWD - 8} text-anchor="middle" font-size="9.5" style="fill: var(--color-muted)">charge · sign · forward</text>
                    <text x={(PX + YX) / 2} y={RUN_FWD + 13} text-anchor="middle" font-size="8.5" style="fill: var(--color-subtle)">HMAC signature</text>

                    {/* Return: your answer travelling back, relayed verbatim and paid. */}
                    <path d={`M ${YX - RUN_PAD} ${RUN_RET} L ${PX + RUN_PAD} ${RUN_RET}`} fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.5" marker-end="url(#run-arrow)" />
                    <path d={`M ${PX - RUN_PAD} ${RUN_RET} L ${MX + RUN_PAD} ${RUN_RET}`} fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.5" marker-end="url(#run-arrow)" />
                    <text x={(PX + YX) / 2} y={RUN_RET + 14} text-anchor="middle" font-size="9.5" style="fill: var(--color-muted)">your JSON answer</text>
                    <text x={(MX + PX) / 2} y={RUN_RET + 14} text-anchor="middle" font-size="9.5" style="fill: var(--color-muted)">relayed verbatim · paid</text>

                    {/* What you do, on your own lane, between arrival and answer. */}
                    <rect
                        x={YX - 58}
                        y={(RUN_FWD + RUN_RET) / 2 - 13}
                        width="116"
                        height="26"
                        rx="8"
                        fill="color-mix(in srgb, var(--color-primary-500) 12%, var(--color-canvas))"
                        stroke="color-mix(in srgb, var(--color-primary-500) 45%, transparent)"
                        stroke-width="1"
                    />
                    <text x={YX} y={(RUN_FWD + RUN_RET) / 2 + 1} text-anchor="middle" dominant-baseline="central" font-size="9.5" font-weight="600" style="fill: var(--color-link)">verify · answer ≤ 60s</text>

                    {/* The honest branch: no answer, no charge. Drawn to the member, past the platform that reverses it. */}
                    <path d={`M ${YX - RUN_PAD} ${RUN_REF} L ${MX + RUN_PAD} ${RUN_REF}`} fill="none" stroke="var(--color-success)" stroke-opacity="0.9" stroke-width="1.25" stroke-dasharray="4 4" marker-end="url(#run-refund)" />
                    <circle cx={PX} cy={RUN_REF} r="2.5" fill="var(--color-success)" />
                    <text x={(MX + YX) / 2} y={RUN_REF - 7} text-anchor="middle" font-size="9" style="fill: var(--color-success)">no answer (5xx · timeout) → the platform reverses the charge</text>

                    {/* The three parties, drawn last so they sit above the flow. YOU is tinted: it is the reader. */}
                    {
                        runActors.map((a) => (
                            <Fragment>
                                <rect
                                    x={a.cx - runBox.w / 2}
                                    y={runBox.y}
                                    width={runBox.w}
                                    height={runBox.h}
                                    rx="10"
                                    fill={a.id === "you" ? "color-mix(in srgb, var(--color-primary-500) 12%, var(--color-canvas))" : "var(--color-canvas)"}
                                    stroke={a.id === "you" ? "color-mix(in srgb, var(--color-primary-500) 50%, transparent)" : "var(--color-line-strong)"}
                                    stroke-width="1.25"
                                />
                                <text x={a.cx} y={runBox.y + runBox.h / 2} text-anchor="middle" dominant-baseline="central" font-size="12" font-weight="700" letter-spacing="0.5" style={a.id === "you" ? "fill: var(--color-link)" : "fill: var(--color-content)"}>
                                    {a.label}
                                </text>
                                <text x={a.cx} y={runBox.y + runBox.h + 12} text-anchor="middle" font-size="9" style="fill: var(--color-subtle)">
                                    {a.sub}
                                </text>
                            </Fragment>
                        ))
                    }
                </svg>
            </div>
            <figcaption class="relative border-t border-line px-5 py-3 text-2xs leading-relaxed text-subtle">
                The platform is the only party that holds the money or learns who is asking. You get a signed call and return JSON — the answer is your whole side of it, never the member's identity or their wallet.
            </figcaption>
        </figure>

        {/* Phone: the same round trip as ordered steps, where the wave would render its labels at a few pixels. */}
        <ol class="flex flex-col gap-2.5 sm:hidden">
            {
                runSteps.map((step, i) => (
                    <li class="flex gap-3">
                        <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line-strong bg-overlay/50 text-2xs font-semibold text-content">{i + 1}</span>
                        <p class="text-sm leading-relaxed text-muted" set:html={step} />
                    </li>
                ))
            }
        </ol>
    </div>

    <DocsCodeBlock code={exchange} lang="http" title="The same round trip, on the wire" />

    <h2>Verify the signature</h2>
    <p>
        What you get instead of issuing API keys: every forwarded call carries <code>x-intentic-timestamp</code> and{" "}
        <code>x-intentic-signature</code>, an HMAC over <code>{"{timestamp}.{body}"}</code> with the secret you were issued at onboarding, using the same scheme as Stripe webhooks. Verify it and drop everything else, and nobody but the platform can run up your upstream bill. The timestamp check makes a replayed capture die of old age.
    </p>
    <DocsCodeBlock code={verify} lang="typescript" title="The whole verification" />

    <h2>What's paid, what refunds</h2>
    <p>
        The line is <strong>whether you answered</strong>, not whether the caller liked the answer. Anything below 500 is an answer —
        including your 4xx.
    </p>
    <table>
        <thead>
            <tr><th>Your response</th><th>The member</th><th>You</th></tr>
        </thead>
        <tbody>
            <tr><td><code>2xx</code> — a normal answer</td><td>pays</td><td>paid</td></tr>
            <tr><td><code>4xx</code> — "your query was malformed"</td><td>pays</td><td>paid</td></tr>
            <tr><td><code>5xx</code> — your endpoint failed</td><td>refunded</td><td>not paid</td></tr>
            <tr><td>Timeout or dead socket</td><td>refunded</td><td>not paid</td></tr>
        </tbody>
    </table>
    <p>
        Credits are spent atomically before the call, so a refund is immediate and the member is told the run cost nothing. Validate
        loudly: a clear <code>4xx</code> is a real answer, and the paid, honest thing to serve.
    </p>

    <h2>Pricing &amp; the split</h2>
    <p>
        You publish one number — <strong>credits per run</strong> — shown on every surface before the run. Price your real cost plus
        margin, not a teaser; a refusal for lack of credits tells the member what's left and when it resets.
    </p>
    <table>
        <tbody>
            <tr><th scope="row">You set</th><td><strong>Credits per run</strong>: one number, shown before every run.</td></tr>
            <tr><th scope="row">You keep</th><td><strong>{creatorSharePct}%</strong> of every spent credit's dollar value.</td></tr>
            <tr><th scope="row">Public</th><td>Your run counts, credits and earnings — per service, month by month, for anyone to read.</td></tr>
        </tbody>
    </table>
    <p><a href="/earn/">Earn</a> explains what a credit is worth and why the model is unfarmable.</p>

    <h2>Admission &amp; the watch</h2>
    <p>
        A service has no code to audit — none of yours ships to anyone — so the gate is human, not a pipeline. <strong>Admission is
        curated</strong>: every listing is created by the platform after a review of who you are, what it claims, and whether the price
        fits. No form puts an endpoint in front of members' agents unreviewed.
    </p>
    <p>After that, the watch is behavioral — with a service, behavior is the artifact:</p>
    <table>
        <thead>
            <tr><th>What's watched</th><th>How it works</th></tr>
        </thead>
        <tbody>
            <tr><td><strong>Every run</strong></td><td>Public on the ledger, month by month — a track record neither of us can dress up.</td></tr>
            <tr><td><strong>Disputes</strong></td><td>Almost none to have: "no answer, no charge" is the platform's code, not a support queue.</td></tr>
            <tr><td><strong>Quality</strong></td><td>A service that keeps disappointing is delisted, its run history kept — the way a bad extension listing is blocked.</td></tr>
        </tbody>
    </table>
    <p>
        Throughout, the member keeps their guard: the agent only <em>discovers</em> and offers, and nothing is spent until the owner says
        yes to a priced run. Discovery is the agent's job, admission is the platform's, spending stays the member's.
    </p>

    <h2>Getting onboarded, honestly</h2>
    <p>
        There's no self-serve signup yet: the first services are onboarded by hand, which buys each one a real conversation about price
        and shape.
    </p>
    <ol class="mt-5 flex list-none flex-col gap-2.5 pl-0">
        <li class="flex gap-3">
            <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line-strong bg-overlay/50 text-2xs font-semibold text-content">1</span>
            <div class="text-base leading-relaxed">Bring an endpoint that answers the exchange above.</div>
        </li>
        <li class="flex gap-3">
            <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line-strong bg-overlay/50 text-2xs font-semibold text-content">2</span>
            <div class="text-base leading-relaxed"><a href={discordUrl}>Say hello on Discord</a> — that's where onboarding starts.</div>
        </li>
        <li class="flex gap-3">
            <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line-strong bg-overlay/50 text-2xs font-semibold text-content">3</span>
            <div class="text-base leading-relaxed">We review it together: who you are, what the listing claims, and whether the price fits.</div>
        </li>
        <li class="flex gap-3">
            <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line-strong bg-overlay/50 text-2xs font-semibold text-content">4</span>
            <div class="text-base leading-relaxed">You leave with a secret and a listing.</div>
        </li>
    </ol>
    <p class="mt-5">
        The catalog's own <code>demo-research</code> service is the living reference: its upstream is run by the platform and verifies
        exactly the signature on this page, so what this page documents is what the forward actually sends.
    </p>

    <DocsRelated
        links={[
            { href: "/earn/", title: "Earn", why: "the economy your price plugs into, and the chat flow your service is offered in." },
            { href: "/api/publish/", title: "Publish & registries", why: "shipping a free, unmetered extension instead." },
        ]}
    />
</DocsLayout>
