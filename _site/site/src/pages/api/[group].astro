---
import { referenceGroups } from "@intentic/site-content/reference";
import ApiOperation from "../../components/ApiOperation.astro";
import ApiPlayground from "../../components/ApiPlayground.astro";
import ReferenceLayout from "../../components/ReferenceLayout.astro";
import { groupOperations, playgroundPayload } from "../../lib/api-reference";

/* ONE PAGE PER ROUTE GROUP, and there is no list of them anywhere. */

/* The group travels as a prop rather than being looked up from the param, so the page cannot be reached for a group that is not in the tree. */
export const getStaticPaths = () =>
    referenceGroups.map(({ group }) => ({
        params: { group: group.name },
        props: { group },
    }));

const { group } = Astro.props;
const operations = await groupOperations(group.name);

/* Open flat when the group is short enough to read, collapsed when it is a list to scan. */
const openFlat = operations.length <= 6;

// The section rail's entries are the operations themselves, known before any markup exists. That is the one
// thing this layout gains from not discovering headings: no page has ever had a more accurate list.
const headings = operations.map((operation) => ({ id: operation.id, text: operation.summary, level: 2 as const }));
---

<ReferenceLayout
    pageId={group.name}
    heading={group.label}
    lead={group.summary}
    headings={headings}
    simulated={true}
>
    <p>{group.description}</p>

    {
        !openFlat && (
            <Fragment>
                <p class="text-sm text-subtle">
                    {operations.length} calls. Pick one to open it, or use the list on the right.
                </p>
                <nav class="api-index" aria-label={`${group.label} routes`}>
                    {operations.map((operation) => (
                        <a href={`#${operation.id}`}>
                            <span class="api-method border-line text-subtle">{operation.method}</span>
                            <code class="api-path">{operation.path}</code>
                            <span class="api-op-title">{operation.summary}</span>
                        </a>
                    ))}
                </nav>
            </Fragment>
        )
    }

    {operations.map((operation) => <ApiOperation operation={operation} open={openFlat} />)}

    <ApiPlayground payload={playgroundPayload(operations)} />
</ReferenceLayout>
