---
import {
    aboutFigures,
    aboutHero,
    aboutMeta,
    background,
    CONTACT_EMAIL_PARTS,
    CREATOR_HANDLE,
    CREATOR_NAME,
    creatorBio,
    creatorRole,
    openSource,
    trustCards,
    whyIntentic,
} from "@intentic/site-content/about";
import { discordUrl, githubIssuesUrl, githubUrl } from "@intentic/site-content/site";
import { buildProfilePageSchema } from "@intentic/site-content/structured-data";
import { gitStats, npmDownloads } from "@intentic/astro-integrations";
import { Image } from "astro:assets";
import portrait from "../assets/creator.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import CreatorLinks from "../components/CreatorLinks.astro";
import DiscordIcon from "../components/DiscordIcon.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import VerifyDownload from "../components/VerifyDownload.astro";

/* Who builds intentic: the depth behind the landing page's `#trust` band. */

const stats = gitStats();

/* The strongest number on this page used to be the third of four identical grey boxes. */
const n = (value: number) => value.toLocaleString(`en-GB`);

/* Downloads are read from the registry at build time and are the whole argument of the open-source section: "shipped and got used on their own" is a claim. */
const downloads = await npmDownloads(openSource.map((project) => project.name));
const downloadTotal = Object.values(downloads).reduce<number>((sum, value) => sum + (value ?? 0), 0);

/* The claims, restyled for this page: three checkable ones in an even row, and the admission below them. */
const claims = trustCards.filter((card) => card.href !== undefined);
const admission = trustCards.find((card) => card.href === undefined);

const claimIcons = [
    '<path d="M12 2.5 20 6v5.5c0 4.8-3.4 8.2-8 9.5-4.6-1.3-8-4.7-8-9.5V6z"/><path d="m9 12 2 2 4-4"/>',
    '<path d="M9.5 17H8A5 5 0 0 1 8 7h1.5"/><path d="M14.5 7H16a5 5 0 0 1 0 10h-1.5"/><path d="M8.5 12h7"/>',
    '<circle cx="7" cy="5" r="2"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="12" r="2"/><path d="M7 7v10M7 12h8"/>',
];
---

<BaseLayout title={aboutMeta.title} description={aboutMeta.description} extraJsonLd={[buildProfilePageSchema("/about/")]}>
    <Nav />
    <main class="flex-1">
        {/* Keep the About hero in the same shell as the extensions page. */}
        <section class="page-hero">
            <div class="wall"></div>
            <div class="below-bar relative mx-auto max-w-7xl px-6 pb-14">
                <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:gap-16">
                    <div>
                        <div class="eyebrow">{aboutHero.eyebrow}</div>
                        <h1 class="display mt-3 max-w-3xl text-3xl leading-tight font-semibold sm:text-4xl">{aboutHero.headline}</h1>
                        <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">{aboutHero.lede}</p>

                        {/* Keep the name as a signature below the hero claim. */}
                        <div class="mt-7 border-l-2 border-primary-600/40 pl-4">
                            <p class="text-lg font-semibold tracking-tight text-content">{CREATOR_NAME}</p>
                            <p class="mt-1 max-w-copy text-sm leading-relaxed text-muted">{creatorRole}</p>
                            <p class="mt-1.5 max-w-copy text-sm leading-relaxed text-subtle italic">&ldquo;{creatorBio}&rdquo;</p>
                        </div>

                        <CreatorLinks class="mt-6" />
                    </div>

                    {/* Frame the white-background portrait as a tinted plate instead of removing its background. */}
                    <figure class="relative mx-auto w-full max-w-[17rem] lg:mx-0 lg:justify-self-end">
                        <div
                            class="pointer-events-none absolute -inset-8 rounded-full blur-xl"
                            style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 26%, transparent), transparent 70%)"
                            aria-hidden="true"
                        >
                        </div>
                        <div class="relative overflow-hidden border border-line-strong shadow-2xl shadow-black/60">
                            <Image
                                src={portrait}
                                alt={aboutHero.portraitAlt}
                                widths={[230, 460]}
                                sizes="(min-width: 64rem) 272px, 17rem"
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="w-full saturate-[0.9] contrast-[1.02]"
                            />
                            <div class="absolute inset-0 bg-primary-500/12 mix-blend-multiply" aria-hidden="true"></div>
                            {/* An inner hairline, so the plate has an edge of its own against the frame. */}
                            <div class="absolute inset-0 ring-1 ring-black/20 ring-inset" aria-hidden="true"></div>
                        </div>
                    </figure>
                </div>
            </div>
        </section>

        {/* Keep the figures in the shared band and draw the commit split from its ratio. */}
        <section class="plinth" aria-label="Checkable figures">
            <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-10 gap-y-6 px-6 py-6">
                {
                    aboutFigures.map((figure) =>
                        figure.stat === "commits" ? (
                            stats !== null && (
                                <div class="min-w-[13rem] flex-1">
                                    <p class="font-mono text-xl font-semibold tracking-tight text-content">
                                        {n(stats.agent)} <span class="text-sm font-normal text-subtle">of {n(stats.total)}</span>
                                    </p>
                                    <div class="mt-2 h-1.5 w-full max-w-[16rem] overflow-hidden rounded-full bg-overlay">
                                        <div class="h-full rounded-full bg-primary-500" style={`width: ${stats.share}%`}></div>
                                    </div>
                                    <p class="mt-2 text-2xs text-subtle">
                                        {figure.detail} · since {stats.since}
                                    </p>
                                </div>
                            )
                        ) : (
                            <div class="min-w-[10rem] flex-1">
                                <p class="font-mono text-xl font-semibold tracking-tight text-content">{figure.value}</p>
                                <p class="mt-2 text-2xs text-subtle">{figure.detail}</p>
                            </div>
                        ),
                    )
                }
                <a href={`${githubUrl}/commits/main`} target="_blank" rel="noopener" class="text-sm font-medium text-link hover:underline">
                    Read the commit log →
                </a>
            </div>
        </section>

        {/* Keep the three claims at equal height with the admission below them. */}
        <section class="mx-auto max-w-7xl px-6 py-16 lg:py-20" aria-labelledby="claims-heading">
            <div class="eyebrow text-link">Why trust any of this</div>
            <h2 id="claims-heading"class="display mt-3 text-2xl font-semibold sm:text-3xl">
                Three things you can check without asking me.
            </h2>
            <div class="mt-10 grid gap-4 md:grid-cols-3">
                {
                    claims.map((card, i) => (
                        <a
                            href={card.href}
                            target={card.href?.startsWith("http") ? "_blank" : undefined}
                            rel={card.href?.startsWith("http") ? "noopener" : undefined}
                            class="card group relative flex flex-col gap-3 overflow-hidden p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-600/40"
                        >
                            <div
                                class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary-500/60 to-transparent opacity-60 transition-opacity duration-200 group-hover:opacity-100"
                                aria-hidden="true"
                            />
                            <div class="flex items-center gap-3">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-primary-600/30 bg-primary-600/10 text-link transition-colors group-hover:bg-primary-600/20">
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="h-4.5 w-4.5"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.75"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                        set:html={claimIcons[i] ?? ""}
                                    />
                                </span>
                                <h3 class="text-base font-semibold tracking-tight text-content group-hover:text-link">{card.title}</h3>
                            </div>
                            <p class="text-sm leading-relaxed text-muted">{card.body}</p>
                            <span class="mt-auto inline-flex items-center gap-1 pt-1 text-sm font-medium text-link">
                                {card.linkLabel}
                                <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                                    →
                                </span>
                            </span>
                        </a>
                    ))
                }
            </div>

            {
                admission && (
                    <p class="mt-6 border-t border-line pt-4 text-sm leading-relaxed text-subtle">
                        <strong class="font-medium text-content">{admission.title}.</strong> {admission.body} Everything above is a link out to
                        something you can read without taking my word for any of it.
                    </p>
                )
            }
        </section>

        <section class="mx-auto max-w-7xl px-6 pb-16 lg:pb-20">
            <VerifyDownload />
        </section>

        {/* Keep the career spine beside the product-origin panel. */}
        <section class="border-t band-rule" aria-labelledby="background-heading">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16">
                    <div>
                        <div class="eyebrow text-link">Background</div>
                        <h2 id="background-heading"class="display mt-3 text-2xl font-semibold sm:text-3xl">
                            Fifteen years before the first line of this.
                        </h2>

                        <ol class="mt-9 border-l border-line">
                            {
                                background.map((item) => (
                                    <li class="relative pb-8 pl-7 last:pb-0">
                                        <span class="absolute top-1.5 -left-[4.5px] h-2 w-2 rounded-full bg-primary-500 ring-4 ring-canvas" />
                                        <p class="font-mono text-2xs tracking-wide text-link uppercase">{item.marker}</p>
                                        <p class="mt-1.5 text-base font-medium tracking-tight text-content">{item.lead}</p>
                                        <p class="mt-1 max-w-copy text-sm leading-relaxed text-muted">{item.body}</p>
                                    </li>
                                ))
                            }
                        </ol>
                    </div>

                    {/* Pin the origin panel beside the full career spine. */}
                    <div class="relative overflow-hidden border border-line bg-card/60 p-7 lg:sticky lg:top-28 lg:self-start sm:p-8">
                        <div
                            class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full"
                            style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-500) 14%, transparent), transparent 70%)"
                            aria-hidden="true"
                        >
                        </div>
                        <div class="relative">
                            <div class="eyebrow">Why intentic exists</div>
                            <svg
                                class="mt-5 h-6 w-6 text-primary-500/50"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M9.5 5C6.5 6.6 4.5 9.6 4.5 13v6h6v-6H8c0-2.2 1-3.9 3-5zm9 0c-3 1.6-5 4.6-5 8v6h6v-6H17c0-2.2 1-3.9 3-5z"></path>
                            </svg>
                            {
                                whyIntentic.map((paragraph) => (
                                    <p class="mt-4 max-w-copy text-base leading-relaxed text-muted first:mt-5">{paragraph}</p>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* Keep library names with their usage evidence. */}
        <section class="border-t band-rule" aria-labelledby="open-source-heading">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="eyebrow text-link">Open source, before this</div>
                <h2 id="open-source-heading"class="display mt-3 text-2xl font-semibold sm:text-3xl">
                    Libraries that shipped and got used on their own.
                </h2>
                <p class="mt-4 max-w-copy text-base leading-relaxed text-muted">
                    {
                        downloadTotal > 0
                            ? `The easiest thing here to check: roughly ${n(Math.round(downloadTotal / 1000))},000 installs a month, counted by npm rather than by me.`
                            : "The easiest thing here to check: they predate intentic, and they are still installed by people who have never heard of it."
                    }
                </p>

                <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    {
                        openSource.map((project) => (
                            <a
                                href={project.href}
                                target="_blank"
                                rel="noopener"
                                class="card group relative flex flex-col overflow-hidden p-5 transition-colors hover:border-primary-600/40"
                            >
                                <h3 class="font-mono text-sm text-content group-hover:text-link">{project.name}</h3>
                                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{project.body}</p>
                                {downloads[project.name] !== null && downloads[project.name] !== undefined && (
                                    <p class="mt-4 border-t border-line pt-3">
                                        <span class="font-mono text-lg font-semibold tracking-tight text-content">
                                            {n(downloads[project.name] ?? 0)}
                                        </span>
                                        <span class="mt-0.5 block text-2xs text-subtle">downloads a month</span>
                                    </p>
                                )}
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        {/* Keep contact before the shared closing band. */}
        <section class="border-t band-rule">
            <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
                <div class="card flex flex-wrap items-center justify-between gap-x-8 gap-y-4 p-6 sm:p-7">
                    <div>
                        <h2 class="text-lg font-semibold tracking-tight text-content">Get in touch</h2>
                        {/* Keep the email split into spans so the address is readable but not a plain markup match. */}
                        <p class="mt-2 max-w-copy text-sm leading-relaxed text-muted">
                            Reach me at{" "}
                            <span
                                id="contact-email"
                                class="font-mono text-content"
                                data-user={CONTACT_EMAIL_PARTS.user}
                                data-domain={CONTACT_EMAIL_PARTS.domain}
                            >
                                {CONTACT_EMAIL_PARTS.user} [at] {CONTACT_EMAIL_PARTS.domain.replace(".", " [dot] ")}
                            </span>
                            , in the community server, or open a public issue.
                        </p>
                    </div>
                    {/* Keep contact channels together in order of escalation. */}
                    <div class="flex flex-wrap gap-3">
                        <a href={discordUrl} target="_blank" rel="noopener" class="btn btn-secondary inline-flex items-center gap-2">
                            <DiscordIcon size={15} />
                            Join the Discord
                        </a>
                        <a href={githubIssuesUrl} target="_blank" rel="noopener" class="btn btn-secondary">Open an issue</a>
                    </div>
                </div>

                <p class="mt-6 text-xs leading-relaxed text-subtle">
                    Also at <span class="font-mono">@{CREATOR_HANDLE}</span> on GitHub and LinkedIn.
                </p>
            </div>
        </section>

        <section class="border-t band-rule">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Run it on your own machine.</h2>
                <p class="mx-auto mt-3 max-w-copy text-sm leading-relaxed text-muted">
                    Nothing above has to be taken on faith. The engine is MIT, the commit log is public, and the sandbox runs on hardware you
                    own.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href="/download/">Create your workspace</a>
                    <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">Read the source</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <script>
        /* Upgrade the spelled-out address to a real mailto, once, on first interaction. */
        const target = document.getElementById("contact-email");
        const user = target?.dataset.user;
        const domain = target?.dataset.domain;

        if (target && user && domain) {
            const reveal = (): void => {
                const address = `${user}@${domain}`;
                const link = document.createElement("a");
                link.href = `mailto:${address}`;
                link.className = "font-mono text-link hover:underline";
                link.textContent = address;
                target.replaceWith(link);
            };

            for (const event of ["pointerdown", "focusin", "keydown"] as const) {
                document.addEventListener(event, reveal, { once: true, passive: true });
            }
        }
    </script>
</BaseLayout>
