---
import "../styles/global.css";
import { getPageMeta } from "@intentic/site-content/page-meta";
import { ORG_DESCRIPTION, ORG_NAME, ORG_TAGLINE, SITE_URL } from "@intentic/site-content/site";
import type { BreadcrumbEntry, FaqEntry } from "@intentic/site-content/structured-data";
import { buildPageGraph } from "@intentic/site-content/structured-data";
import { lastModForUrl } from "@intentic/astro-integrations";
// Use the package's pure path-math subpath to avoid bundling native image dependencies.
import { getImagePath } from "astro-opengraph-images/util.js";
import FrontDesk from "../components/FrontDesk.astro";
import LiveNotice from "../components/LiveNotice.astro";
import PageBackdrop from "../components/PageBackdrop.astro";
import { THEME_COLOR, variantScript } from "../lib/variant";
import { typefaceCss, typefaceScript } from "../lib/typeface";
import TypeLab from "../components/TypeLab.astro";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    /** Breadcrumbs emit BreadcrumbList metadata and mark the page as an article. */
    breadcrumbs?: BreadcrumbEntry[];
/* Date published is for templated pages absent from page-meta.ts. */
    datePublished?: string;
    /** Article type is used only when breadcrumbs mark the page as an article. */
    articleType?: "TechArticle" | "BlogPosting";
    faq?: FaqEntry[];
    extraJsonLd?: Record<string, unknown>[];
    noindex?: boolean;
/** Whether the page receives the shared temple backdrop. */
    backdrop?: boolean;
}

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const meta = getPageMeta(path);

/* Indexable pages require explicit metadata or a page-meta entry. */
const authored = Astro.props.title !== undefined && Astro.props.description !== undefined;
if (!authored && meta === undefined && Astro.props.noindex !== true) {
    throw new Error(
        `No page meta for ${path}. Add an entry to site-content/src/page-meta.ts, or pass title and description ` +
            `to BaseLayout. Every indexable route needs its own title and description; without one it silently ` +
            `inherits the brand line and ORG_DESCRIPTION.`,
    );
}

const title = Astro.props.title ?? meta?.title ?? `${ORG_NAME} · ${ORG_TAGLINE}`;
const description = Astro.props.description ?? meta?.description ?? ORG_DESCRIPTION;
const datePublished = Astro.props.datePublished ?? meta?.datePublished;
const dateModified = lastModForUrl(`${SITE_URL}${path}`) ?? undefined;

// Breadcrumbs and article metadata are enabled together.
const breadcrumbs = Astro.props.breadcrumbs;
const isArticle = breadcrumbs !== undefined && breadcrumbs.length > 0;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Per-page OG cards require metadata and use the integration's path naming.
const perPageOgAvailable = import.meta.env.PUBLIC_OG_PER_PAGE;
const defaultOgPath = perPageOgAvailable && (meta || authored) ? getImagePath({ url: new URL(path, Astro.site), site: Astro.site }) : "/assets/intentic-logo-sized.png";
const ogImage = new URL(Astro.props.ogImage ?? defaultOgPath, Astro.site);

const jsonLd = buildPageGraph({
    name: title,
    description,
    path,
    datePublished,
    dateModified,
    breadcrumbs,
    article: isArticle,
    articleType: Astro.props.articleType,
    faq: Astro.props.faq,
    extra: Astro.props.extraJsonLd,
});

const cfBeaconToken = import.meta.env.CF_BEACON_TOKEN;

---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta
            name="robots"
            content={Astro.props.noindex ? "noindex,follow" : "max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
        />

<!-- All icons use the shared lotus mark. -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="canonical" href={canonicalURL.href} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {/* RSS discovery is sitewide, not limited to the blog index. */}
        <link rel="alternate" type="application/rss+xml" title={`${ORG_NAME} blog`} href="/blog/rss.xml" />

        <meta property="og:type" content={isArticle ? "article" : "website"} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:site_name" content={ORG_NAME} />
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="628" />
        <meta property="og:image:alt" content={title} />
        {isArticle && datePublished && <meta property="article:published_time" content={datePublished} />}
        {isArticle && dateModified && <meta property="article:modified_time" content={dateModified} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage.href} />
        <meta name="twitter:image:alt" content={title} />

        <meta name="theme-color" content={THEME_COLOR.default} />
        {/* After the tag it rewrites, and before the body it skins. */}
        <script is:inline set:html={variantScript()} />
        {/* Temporary: the type lab (lib/typeface.ts). Both lines go when a reading face has been chosen. */}
        <style is:inline set:html={typefaceCss()} />
        <script is:inline set:html={typefaceScript()} />
        {/* Preload the reading face used by every page. One variable file covers 400, 500 and 600. */}
        <link rel="preload" as="font" type="font/woff2" href="/fonts/public-sans-400-600-latin.woff2" crossorigin />
        <noscript>
            <style>
                .fade-in {
                    opacity: 1;
                    transform: none;
                }
            </style>
        </noscript>

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        {
            cfBeaconToken && (
                <script
                    is:inline
                    defer
                    src="https://static.cloudflareinsights.com/beacon.min.js"
                    data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
                />
            )
        }
    </head>
    {/* Relative isolation keeps the backdrop inside the body stacking context. */}
    <body class="relative isolate flex min-h-screen flex-col">
        {/* LiveNotice stays the first direct body child so its layout rule can move the page. */}
        <LiveNotice />
        {Astro.props.backdrop !== false && <PageBackdrop />}
        <slot />
        <TypeLab />

        <script>
            /* One observer reveals every fade-in element. */
            const reveals = document.querySelectorAll(".fade-in");
            if ("IntersectionObserver" in window) {
                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) {continue;}
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    },
                    { threshold: 0.1 },
                );
                reveals.forEach((element) => observer.observe(element));
            } else {
                reveals.forEach((element) => element.classList.add("visible"));
            }
        </script>

        {/* Last in the body: a chat bubble a visitor may never use must not delay anything they came for. */}
        <FrontDesk />
    </body>
</html>
