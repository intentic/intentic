---
import "../styles/global.css";
import { getPageMeta } from "@intentic-dev/site-content/page-meta";
import { ORG_DESCRIPTION, ORG_NAME, ORG_TAGLINE, SITE_URL } from "@intentic-dev/site-content/site";
import type { BreadcrumbEntry, FaqEntry } from "@intentic-dev/site-content/structured-data";
import { buildPageGraph } from "@intentic-dev/site-content/structured-data";
import { lastModForUrl } from "@intentic-dev/astro-integrations";
// The package's own `util.js` entry, not its root: the root pulls in the build hook, and with it satori and
// resvg's native .node binary, which rollup then tries to bundle into the page. This subpath is pure path math.
import { getImagePath } from "astro-opengraph-images/util.js";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    /** The trail below Home. Present ⇒ the page emits a BreadcrumbList and og:type=article. */
    breadcrumbs?: BreadcrumbEntry[];
    faq?: FaqEntry[];
    extraJsonLd?: Record<string, unknown>[];
    noindex?: boolean;
}

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const meta = getPageMeta(path);

const title = Astro.props.title ?? meta?.title ?? `${ORG_NAME} · ${ORG_TAGLINE}`;
const description = Astro.props.description ?? meta?.description ?? ORG_DESCRIPTION;
const datePublished = meta?.datePublished;
const dateModified = lastModForUrl(`${SITE_URL}${path}`) ?? undefined;

// A page with a breadcrumb trail is a page inside the documentation — which is also what makes it an
// article rather than a site page, so the two travel together instead of as two props that can disagree.
const breadcrumbs = Astro.props.breadcrumbs;
const isArticle = breadcrumbs !== undefined && breadcrumbs.length > 0;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The card astro-opengraph-images will write for this page, named by the same function the integration uses to
// find it — the two MUST agree or the build fails, which is the point: a page can no longer advertise an image
// nobody generated. `path` rather than Astro.url so the name is the built (always-slashed) one in dev too.
const perPageOgAvailable = import.meta.env.PUBLIC_OG_PER_PAGE;
const defaultOgPath = perPageOgAvailable && meta ? getImagePath({ url: new URL(path, Astro.site), site: Astro.site }) : "/assets/intentic-logo-sized.png";
const ogImage = new URL(Astro.props.ogImage ?? defaultOgPath, Astro.site);

const jsonLd = buildPageGraph({
    name: title,
    description,
    path,
    datePublished,
    dateModified,
    breadcrumbs,
    article: isArticle,
    faq: Astro.props.faq,
    extra: Astro.props.extraJsonLd,
});

const cfBeaconToken = import.meta.env.CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta
            name="robots"
            content={Astro.props.noindex ? "noindex,follow" : "max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
        />

        <link rel="icon" type="image/png" href="/assets/intentic-logo-sized.png" />
        <link rel="apple-touch-icon" href="/assets/intentic-logo-sized.png" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="canonical" href={canonicalURL.href} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content={isArticle ? "article" : "website"} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:site_name" content={ORG_NAME} />
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="628" />
        <meta property="og:image:alt" content={title} />
        {isArticle && datePublished && <meta property="article:published_time" content={datePublished} />}
        {isArticle && dateModified && <meta property="article:modified_time" content={dateModified} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage.href} />
        <meta name="twitter:image:alt" content={title} />

        <meta name="theme-color" content="#181614" />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
        <noscript>
            <style>
                .fade-in {
                    opacity: 1;
                    transform: none;
                }
            </style>
        </noscript>

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        {
            cfBeaconToken && (
                <script
                    is:inline
                    defer
                    src="https://static.cloudflareinsights.com/beacon.min.js"
                    data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
                />
            )
        }
    </head>
    <body class="flex min-h-screen flex-col">
        <slot />
    </body>
</html>
