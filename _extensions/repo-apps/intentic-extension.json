{
    "publisher": "intentic",
    "name": "repo-apps",
    "version": "1.0.0",
    "category": "workspace",
    "icon": "th-large",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /workspace/repos/*/apps",
            "POST /workspace/repos/*/apps",
            "POST /workspace/repos/*/apps/*/start",
            "POST /workspace/repos/*/apps/*/stop",
            "POST /workspace/repos/*/tests",
            "GET /workspace/repos/*/graph",
            "GET /workspace/templates",
            "GET /workspace/tree",
            "GET /system/terminals"
        ]
    },
    "contributes": {
        "views": [
            { "id": "apps", "label": "Apps", "surface": "directory" },
            { "id": "dependencies", "label": "Dependencies", "surface": "directory" }
        ]
    }
}
