{
    "publisher": "intentic",
    "name": "imap",
    "version": "1.0.0",
    "category": "connections",
    "engines": {
        "intentic": "^0.4.0"
    },
    "contributes": {
        "listener": {
            "provider": "imap",
            "eventTypes": [
                "message",
                "flags",
                "expunge"
            ]
        },
        "processes": [
            {
                "name": "gateway",
                "command": "node dist/gateway.js",
                "autoStart": true
            }
        ],
        "capabilities": [
            {
                "id": "imap",
                "kind": "cli",
                "catalog": {
                    "name": "IMAP",
                    "icon": "envelope",
                    "description": "Connect an email inbox over IMAP for the agent to read — and to wake automations the moment new mail arrives.",
                    "category": "communication",
                    "guide": {
                        "url": "https://myaccount.google.com/apppasswords",
                        "linkLabel": "Create a Gmail app password",
                        "steps": [
                            "Gmail: turn on 2-Step Verification, then create an App Password (link above) and use it as the password.",
                            "Outlook/Microsoft: account.microsoft.com → Security → Advanced security options → App passwords.",
                            "Other hosts: your normal IMAP password works.",
                            "Host/port — Gmail imap.gmail.com:993, Outlook outlook.office365.com:993."
                        ]
                    }
                },
                "fields": [
                    {
                        "key": "host",
                        "label": "IMAP host",
                        "placeholder": "imap.gmail.com"
                    },
                    {
                        "key": "port",
                        "label": "Port",
                        "default": "993"
                    },
                    {
                        "key": "username",
                        "label": "Username",
                        "placeholder": "you@example.com"
                    },
                    {
                        "key": "password",
                        "label": "Password",
                        "secret": true
                    },
                    {
                        "key": "mailbox",
                        "label": "Watched mailbox",
                        "default": "INBOX"
                    }
                ],
                "env": {
                    "IMAP_HOST": "${host}",
                    "IMAP_PORT": "${port}",
                    "IMAP_USERNAME": "${username}",
                    "IMAP_PASSWORD": "${password}"
                },
                "skill": "skills/imap/SKILL.md"
            }
        ]
    }
}
