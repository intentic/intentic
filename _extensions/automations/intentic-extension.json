{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "automations",
    "version": "1.0.0",
    "category": "work",
    "icon": "clock",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /automations",
            "GET /automations/catalog",
            "GET /personas",
            "GET /ci/runs",
            "POST /automations",
            "POST /automations/*/enabled",
            "DELETE /automations/*",
            "POST /automations/*/run",
            "GET /webchat/*/installs",
            "GET /automations/pending",
            "POST /automations/pending/*/approve",
            "POST /automations/pending/*/reject"
        ]
    },
    "contributes": {
        "views": [{ "id": "automations", "label": "Automations", "surface": "rail", "badge": true }],
        "files": [
            { "path": ".intentic/config/automations.json", "invalidates": ["automations"] },
            { "path": ".intentic/records/automation-runs.json", "invalidates": ["automations"] },
            { "path": ".intentic/config/personas.json", "invalidates": ["personas"] },
            { "path": ".intentic/records/approvals/", "invalidates": ["automation-approvals"] }
        ]
    }
}
