{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "automations",
    "version": "1.0.0",
    "category": "work",
    "icon": "clock",
    "engines": { "intentic": "^2.37.0" },
    "permissions": {
        "sandbox": [
            "GET /automations",
            "GET /automations/catalog",
            "GET /automations/senders/*",
            "GET /agents",
            "GET /personas",
            "GET /access/services",
            "GET /access/profiles",
            "GET /settings",
            "GET /ci/runs",
            "POST /automations",
            "POST /automations/check",
            "POST /automations/*/enabled",
            "DELETE /automations/*",
            "POST /automations/*/run",
            "POST /automations/*/rotate-token"
        ]
    },
    "contributes": {
        "views": [{ "id": "automations", "label": "Automations", "surface": "rail" }],
        "automationTemplates": [
            {
                "id": "page-changes",
                "title": "When a page changes",
                "icon": "globe",
                "trigger": { "kind": "schedule", "cron": "7 * * * *" },
                "source": { "kind": "url", "url": "https://example.com/status" },
                "fireOn": "change",
                "target": { "kind": "notify" },
                "description": "Tell me when the text of a web page changes, a status page, a pricing page, a changelog.",
                "prompt": "The page you were watching changed; what changed is below.",
                "note": "checks hourly · only when its text changes"
            }
        ],
        "files": [
            { "path": ".intentic/config/automations.json", "invalidates": ["automations"] },
            { "path": ".intentic/records/automation-runs.json", "invalidates": ["automations"] },
            { "path": ".intentic/records/automation-watch.json", "invalidates": ["automations"] },
            { "path": ".intentic/config/roles.json", "invalidates": ["roles"] }
        ]
    }
}
