{
    "publisher": "intentic",
    "name": "automations",
    "version": "1.0.0",
    "category": "work",
    "icon": "clock",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /automations",
            "GET /extensions",
            "GET /identities",
            "GET /ci/runs",
            "POST /automations",
            "POST /automations/*/enabled",
            "DELETE /automations/*",
            "POST /automations/*/run",
            "GET /webchat/*/installs",
            "GET /automations/pending",
            "POST /automations/pending/*/approve",
            "POST /automations/pending/*/reject"
        ]
    },
    "contributes": {
        "views": [{ "id": "automations", "label": "Automations", "surface": "rail" }],
        "files": [
            { "path": ".intentic/automations.json", "invalidates": ["automations"] },
            { "path": ".intentic/identities.json", "invalidates": ["identities"] },
            { "path": ".intentic/approvals/", "invalidates": ["automation-approvals"] }
        ]
    }
}
