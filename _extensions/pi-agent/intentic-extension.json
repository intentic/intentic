{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "pi-agent",
    "version": "1.0.0",
    "category": "connections",
    "icon": "terminal",
    "engines": { "intentic": "^2.0.0" },
    "contributes": {
        "environment": { "fragment": "env/pi.Dockerfile" },
        "capabilities": [
            {
                "id": "pi",
                "kind": "agent",
                "catalog": {
                    "name": "Pi",
                    "description": "Run the Pi coding agent as a chat provider.",
                    "category": "extend",
                    "hint": "Served over Pi's own protocol, not ACP: mid-turn steering, effort control, slash commands.",
                    "guide": {
                        "url": "https://pi.dev",
                        "linkLabel": "About Pi",
                        "steps": [
                            "Adding bakes the Pi CLI into the image: a one-time rebuild.",
                            "Run `pi` in a Terminal and type /login, or add API keys below.",
                            "Pick a default inside Pi with /model.",
                            "Pi then appears in the chat's model picker."
                        ]
                    }
                },
                "fields": [
                    { "key": "command", "label": "Command", "default": "pi" },
                    { "key": "name", "label": "Display name", "default": "Pi", "optional": true },
                    {
                        "key": "env",
                        "label": "Environment (KEY=VALUE per line)",
                        "placeholder": "ANTHROPIC_API_KEY=…",
                        "secret": true,
                        "optional": true,
                        "multiline": true
                    },
                    { "key": "loginCommand", "label": "Login command", "default": "pi", "optional": true }
                ]
            }
        ]
    }
}
