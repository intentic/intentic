{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "drafts",
    "version": "1.0.0",
    "category": "work",
    "icon": "send",
    "engines": { "intentic": "^2.3.0" },
    "permissions": {
        "sandbox": ["GET /drafts", "POST /drafts", "DELETE /drafts/*", "GET /extensions", "GET /workspace/raw"]
    },
    "contributes": {
        "views": [{ "id": "drafts", "label": "Drafts", "surface": "rail", "badge": true }],
        "files": [{ "path": ".intentic/config/drafts/", "invalidates": ["drafts"] }]
    }
}
