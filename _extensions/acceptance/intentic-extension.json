{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "acceptance",
    "version": "1.0.0",
    "category": "work",
    "icon": "list-check",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /workspace/children",
            "GET /workspace/file",
            "GET /workspace/raw",
            "POST /workspace/upload",
            "DELETE /workspace/entry",
            "GET /panels",
            "POST /panels/*/start",
            "POST /agent",
            "POST /agent/stop",
            "GET /agents",
            "GET /system/browsers"
        ]
    },
    "contributes": {
        "views": [{ "id": "acceptance", "label": "Acceptance", "surface": "rail", "badge": true }]
    }
}
