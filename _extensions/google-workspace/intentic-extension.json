{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "google-workspace",
    "version": "1.0.0",
    "category": "connections",
    "logo": "google",
    "engines": {
        "intentic": "^2.0.0"
    },
    "contributes": {
        "listener": {
            "provider": "google",
            "events": [
                { "type": "mail", "label": "New mail" },
                { "type": "event", "label": "Calendar event starting" }
            ],
            "automation": {
                "label": "Google Workspace",
                "mentionLabel": "Only mail addressed directly to you (your address in To)",
                "channel": { "label": "Gmail label or calendar id (optional)", "placeholder": "every watched inbox and calendar" },
                "starterPrompt": "Google Workspace events just arrived, each line of the payload is one JSON event. Type `mail` is new Gmail: the author is the sender, content holds the subject and a text excerpt, and extra carries the message id, thread id, labels and attachment names (`gw mail read <id>` for the whole thing). Type `event` is a calendar event about to start: content holds the title, time and location, and extra carries the event id, calendar, attendees and any meeting link. Triage what arrived and act on it, `gw` is on your PATH for the whole of Gmail, Calendar, Drive, Docs, Sheets and Contacts."
            }
        },
        "processes": [
            {
                "name": "watcher",
                "command": "node dist/gateway.js",
                "autoStart": true
            }
        ],
        "bin": "bin",
        "capabilities": [
            {
                "id": "google",
                "kind": "cli",
                "catalog": {
                    "name": "Google Workspace",
                    "logo": "google",
                    "description": "Your Google mail, calendar, files and docs.",
                    "category": "communication",
                    "hint": "One connection covers Gmail, Calendar, Drive, Docs, Sheets and Contacts. Read-only is real: it asks Google for read scopes and refuses every writing command.",
                    "guide": {
                        "url": "https://console.cloud.google.com/apis/credentials",
                        "linkLabel": "Open Google Cloud credentials",
                        "scopes": "read & write: `gmail.modify` `gmail.send` `calendar` `drive` `documents` `spreadsheets` `contacts`, read only: the `.readonly` form of each",
                        "steps": [
                            "In `console.cloud.google.com`, enable the `Gmail`, `Calendar`, `Drive`, `Docs`, `Sheets` and `People` APIs.",
                            "`OAuth consent screen`: `External`, add yourself as a test user.",
                            "Set it to `In production`: a `Testing` screen's tokens die after 7 days.",
                            "`Credentials` → `OAuth client ID` → `Web application`, redirect URI `https://developers.google.com/oauthplayground`.",
                            "Easiest: paste the client ID and secret here, then run `gw auth login` in a chat for the refresh token.",
                            "Whole company: make a service account, download its `JSON` key, note its `Client ID`.",
                            "Whole company: authorise that client ID under `Domain-wide delegation` in `admin.google.com`.",
                            "Add this card again for a second account."
                        ]
                    }
                },
                "fields": [
                    {
                        "key": "mode",
                        "label": "Connect as",
                        "default": "user",
                        "options": [
                            { "value": "user", "label": "Your Google account" },
                            { "value": "domain", "label": "Whole company (Workspace admin)" }
                        ]
                    },
                    {
                        "key": "email",
                        "label": "Google account",
                        "placeholder": "you@example.com",
                        "hint": "The address this connection acts as."
                    },
                    {
                        "key": "clientId",
                        "label": "OAuth client ID",
                        "placeholder": "…apps.googleusercontent.com",
                        "when": "mode == 'user'"
                    },
                    {
                        "key": "refreshToken",
                        "label": "Refresh token",
                        "secret": true,
                        "when": "mode == 'user'",
                        "hint": "Rotate here when Google revokes it."
                    },
                    {
                        "key": "clientSecret",
                        "label": "OAuth client secret",
                        "secret": true,
                        "when": "mode == 'user'"
                    },
                    {
                        "key": "serviceAccountKey",
                        "label": "Service account key (JSON)",
                        "secret": true,
                        "multiline": true,
                        "when": "mode == 'domain'",
                        "hint": "The whole downloaded JSON file."
                    },
                    {
                        "key": "access",
                        "label": "What the agent may do",
                        "default": "write",
                        "options": [
                            { "value": "write", "label": "Read & write" },
                            { "value": "read", "label": "Read only" }
                        ]
                    }
                ],
                "env": {
                    "GOOGLE_MODE": "${mode}",
                    "GOOGLE_EMAIL": "${email}",
                    "GOOGLE_CLIENT_ID": "${clientId}",
                    "GOOGLE_CLIENT_SECRET": "${clientSecret}",
                    "GOOGLE_REFRESH_TOKEN": "${refreshToken}",
                    "GOOGLE_SERVICE_ACCOUNT_KEY": "${serviceAccountKey}",
                    "GOOGLE_ACCESS": "${access}"
                },
                "skill": "skills/google/SKILL.md"
            }
        ]
    }
}
