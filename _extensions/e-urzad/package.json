        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@xmldom/xmldom": "catalog:",
        "asn1js": "catalog:",
        "jose": "catalog:",
        "pkijs": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:",
        "xadesjs": "catalog:",
        "xmldsigjs": "catalog:",
