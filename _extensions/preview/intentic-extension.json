{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "preview",
    "version": "1.0.0",
    "category": "workspace",
    "icon": "globe",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /panels",
            "POST /panels/*/start",
            "POST /panels/*/stop",
            "GET /ports",
            "POST /ports/forward",
            "POST /ports/unforward",
            "GET /public",
            "POST /public/publish",
            "POST /public/unpublish"
        ]
    },
    "contributes": {
        "views": [
            { "id": "preview", "label": "Preview", "surface": "directory" },
            { "id": "ports", "label": "Ports", "surface": "sandbox" },
            { "id": "public", "label": "Public", "surface": "sandbox" }
        ],
        "files": [{ "path": "public/", "invalidates": ["public"] }]
    }
}
