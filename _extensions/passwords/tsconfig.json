/* Source-consumed by the desktop app's Vite through the one entry it imports (./src/app/index.ts). */
{
    "compilerOptions": {
        "types": ["node", "bun", "@intentic/testing/globals"],
        "noEmit": true,
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo",
        "resolveJsonModule": true
    },
    "include": ["./src/**/*.ts", "./src/**/*.vue"],
    "extends": "@intentic/tsconfig/tsconfig.vue.json"
}
