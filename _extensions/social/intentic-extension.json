{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "social",
    "version": "1.0.0",
    "category": "connections",
    "icon": "users",
    "engines": { "intentic": "^2.0.0" },
    "contributes": {
        "capabilities": [
            {
                "id": "reddit",
                "kind": "browser",
                "catalog": {
                    "name": "Reddit",
                    "logo": "reddit",
                    "description": "Post, comment and vote on Reddit as you.",
                    "category": "communication",
                    "hint": "Sign in once with `Log in`: the agent then acts as you. Automating an account may be against Reddit's terms."
                },
                "fields": [],
                "loginUrl": "https://www.reddit.com/login/",
                "homeUrl": "https://www.reddit.com/",
                "skill": "skills/reddit/SKILL.md"
            },
            {
                "id": "x",
                "kind": "browser",
                "catalog": {
                    "name": "X (Twitter)",
                    "logo": "x",
                    "description": "Post, reply, like and follow on X as you.",
                    "category": "communication",
                    "hint": "Sign in once with `Log in`: the agent then acts as you. Automating an account may be against X's terms."
                },
                "fields": [],
                "loginUrl": "https://x.com/i/flow/login",
                "homeUrl": "https://x.com/home",
                "skill": "skills/x/SKILL.md"
            },
            {
                "id": "youtube",
                "kind": "browser",
                "catalog": {
                    "name": "YouTube",
                    "logo": "youtube",
                    "description": "Watch, comment, like and subscribe as you.",
                    "category": "communication",
                    "hint": "Sign in yourself in the live window: Google refuses automated logins."
                },
                "fields": [],
                "loginUrl": "https://accounts.google.com/ServiceLogin?continue=https%3A%2F%2Fwww.youtube.com%2F",
                "homeUrl": "https://www.youtube.com/",
                "skill": "skills/youtube/SKILL.md"
            }
        ]
    }
}
