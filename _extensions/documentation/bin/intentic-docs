#!/usr/bin/env node
/* `intentic-docs` — the FACTS half of the documentation system, on the agent's PATH every turn
 * (contributes.bin: the daemon prepends this directory, and the files themselves are the approved code because
 * they ride the sha-pinned checkout).
 *
 * The split this tool exists to enforce: a model authors judgement, a script computes facts. Which packages
 * exist, what depends on what, how big each one is, whether a page has been kept up with its code, whether an
 * anchor still resolves — all of that is cheap and exact from the filesystem and git, and all of it is something
 * a model will otherwise produce plausibly and wrongly. So the agent runs `facts` before it writes a word, and
 * `validate` after, and the only thing left for it to get wrong is the part that needs a mind.
 *
 * A PACKAGE'S DOCUMENT IS ITS OWN README. There is no per-package JSON sidecar: the one-liner is the README's
 * lead sentence, the anchors are its `## Key files` links, and staleness is a git comparison. Everything an
 * author could forget to update has been replaced by something derived from what they did update.
 *
 * THREE VERBS
 *   facts     enumerate packages, their dependency edges, sizes and revisions          → JSON on stdout
 *   validate  every package has a README, it has a lead sentence, anchors resolve      → exit 1 + reasons
 *   check     recompute the derived index (staleness, orphans, coverage, facts)        → writes index.json
 *
 * `check` is where rot becomes visible. Staleness is computed HERE and written to a file rather than derived in
 * the browser, because `GET /git/{repo}/log` takes no path filter — the browser would need one commit-diff
 * request per commit to learn what touched a package. One `git rev-list --count` answers it exactly.
 *
 * WHY THIS FILE IS PLAIN ESM AND NOT TYPESCRIPT. It is executed directly by the agent's shell, so it must run
 * with no build step and no loader. That costs a small, deliberate duplication: the constants below also live in
 * src/paths.ts. paths.test.ts imports both and asserts they are equal, so the duplication cannot drift silently
 * — it fails a test the moment it does. */

import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, readdirSync, readFileSync, realpathSync, statSync, writeFileSync } from "node:fs";
import { isAbsolute, join, relative } from "node:path";
import { fileURLToPath } from "node:url";

// Mirrored from src/paths.ts — see the header, and paths.test.ts which pins them together.
export const DOCS_DIR = "docs/architecture";
export const STAGING_ROOT = ".intentic/docs";
export const README_TAIL = "README.md";

const MANIFESTS = ["package.json", "Cargo.toml", "pyproject.toml", "go.mod"];
const SKIP_DIRS = new Set(["node_modules", ".git", "dist", "build", "target", ".cache", ".next", "coverage", "vendor", "__pycache__"]);
/* A manifest inside one of these is a FIXTURE, not a package — `_search/iq-recall/src/__fixtures__/workspace` has a
 * package.json because a test needs one to read. These dirs are still WALKED (their lines count toward the package
 * that owns them, and their names are how `hasTests` is detected); they just cannot themselves be a package. */
const NON_PACKAGE_SEGMENTS = new Set(["__fixtures__", "__mocks__", "__snapshots__", "__tests__", "fixtures", "test", "tests", "spec"]);
const SOURCE_EXTENSIONS = new Set(["ts", "tsx", "js", "jsx", "mjs", "cjs", "vue", "rs", "py", "go", "sql", "css", "svelte"]);
// A generated bundle or a lockfile would dominate a size comparison while telling the reader nothing.
const MAX_MEASURED_BYTES = 512 * 1024;
// Deep enough for `_editor/web/src/...`-shaped monorepos, shallow enough that a stray checkout cannot walk forever.
const MAX_DEPTH = 5;
// A one-liner is a tooltip and a list row. Past this it is a paragraph that has been let loose.
const ONE_LINER_MAX = 200;

// ---- shell ---------------------------------------------------------------------------------------------------

/* git, or undefined. Every git fact here is optional by design: a repo with no commits yet, a directory that has
 * never been committed, or a workspace that is not a git repo at all are all ordinary states for a workspace an
 * agent is actively building — and none of them should stop a document from being written. */
const git = (cwd, args) => {
    try {
        return execFileSync(`git`, args, { cwd, encoding: `utf8`, stdio: [`ignore`, `pipe`, `ignore`] }).trim();
    } catch {
        return undefined;
    }
};

const readJson = (path) => {
    try {
        return JSON.parse(readFileSync(path, `utf8`));
    } catch {
        return undefined;
    }
};

const readText = (path) => {
    try {
        return readFileSync(path, `utf8`);
    } catch {
        return undefined;
    }
};

/* Canonical JSON: sorted keys, two-space indent, trailing newline. The whole reviewability argument for a data
 * document model rests on this — unstable key order turns every regeneration into an unreadable diff, which is
 * exactly the objection that ruled out generated HTML in the first place. */
const canonical = (value) => `${JSON.stringify(sortKeys(value), undefined, 2)}\n`;

const sortKeys = (value) => {
    if (Array.isArray(value)) {
        return value.map(sortKeys);
    }
    if (value === null || typeof value !== `object`) {
        return value;
    }
    return Object.fromEntries(
        Object.keys(value)
            .sort()
            .map((key) => [key, sortKeys(value[key])]),
    );
};

// ---- reading a README ------------------------------------------------------------------------------------------

/* Markdown reduced to the words in it. A one-liner lands in a tooltip and a list row, where `**bold**` and a link
 * target are noise — so emphasis, code ticks and link syntax collapse to their text and nothing else changes. */
const plain = (text) =>
    text
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ``)
        .replace(/\[([^\]]*)\]\([^)]*\)/g, `$1`)
        .replace(/[*_`]+/g, ``)
        .replace(/\s+/g, ` `)
        .trim();

/* THE LEAD SENTENCE — a package's one-liner, and the reason a README needs no `oneLiner` field to forget.
 *
 * The first paragraph after the `# H1`, cut at its first sentence. Authors are told to write one sentence there,
 * so for a page written to the convention this is the whole paragraph; cutting is what keeps a page that opened
 * with three sentences from putting all three in a tooltip. Badge lines and block quotes are skipped because
 * they are chrome, and a fence before the prose is a quickstart rather than a description. */
const leadSentence = (markdown) => {
    const lines = markdown.split(/\r?\n/);
    const start = lines.findIndex((line) => /^#\s+\S/.test(line));
    const paragraph = [];
    let fenced = false;
    for (const line of lines.slice(start + 1)) {
        if (/^```/.test(line)) {
            fenced = !fenced;
            continue;
        }
        if (fenced) {
            continue;
        }
        const trimmed = line.trim();
        if (trimmed === ``) {
            if (paragraph.length > 0) {
                break;
            }
            continue;
        }
        // A heading before any prose means the page never described itself; stop rather than quote a section title.
        if (/^#{1,6}\s/.test(trimmed) || /^>/.test(trimmed) || /^[-*+]\s/.test(trimmed) || /^\|/.test(trimmed)) {
            if (paragraph.length > 0) {
                break;
            }
            if (/^#{1,6}\s/.test(trimmed)) {
                return undefined;
            }
            continue;
        }
        paragraph.push(trimmed);
    }
    const prose = plain(paragraph.join(` `));
    if (prose === ``) {
        return undefined;
    }
    /* First sentence: a `.`, `!` or `?` followed by a space and a capital, or the end of the paragraph. The
     * lookahead for a capital is what stops `e.g.` and `@intentic/graph v1.2` from cutting the sentence in half. */
    const match = /^(.+?[.!?])\s+[A-Z(]/.exec(prose);
    const sentence = match === null ? prose : match[1];
    return sentence.length <= ONE_LINER_MAX ? sentence : `${sentence.slice(0, ONE_LINER_MAX - 1).replace(/\s+\S*$/, ``)}…`;
};

/* THE ANCHORS — `## Key files`, read as data.
 *
 * `- [src/compile.ts](src/compile.ts) — RawNode map → validated graph.` Link targets are PACKAGE-relative, so the
 * same link works on GitHub, in the file tree and in the documentation view; this returns them repo-relative,
 * which is what every reader of the index wants and what `validate` resolves against.
 *
 * External links and anchors-into-prose are skipped rather than reported: a `## Key files` list is allowed to
 * mention a URL, and only a local path can be checked for existence. */
const keyFilesOf = (markdown, dir) => {
    const lines = markdown.split(/\r?\n/);
    const at = lines.findIndex((line) => /^##\s+key files/i.test(line.trim()));
    if (at === -1) {
        return [];
    }
    const anchors = [];
    for (const line of lines.slice(at + 1)) {
        if (/^#{1,6}\s/.test(line.trim())) {
            break;
        }
        const match = /^\s*[-*+]\s+\[([^\]]*)\]\(([^)\s]+)\)\s*(.*)$/.exec(line);
        if (match === null) {
            continue;
        }
        const [, label, target, rest] = match;
        if (/^[a-z][a-z0-9+.-]*:/i.test(target) || target.startsWith(`#`)) {
            continue;
        }
        // `#L42` is GitHub's spelling of a line number, and the only one a markdown link can carry.
        const hash = /#L(\d+)$/.exec(target);
        const path = target.replace(/#.*$/, ``);
        const what = plain(rest.replace(/^\s*[—–-]\s*/, ``));
        anchors.push({
            path: join(dir, path).split(`\\`).join(`/`),
            what: what === `` ? plain(label) : what,
            ...(hash === null ? {} : { line: Number.parseInt(hash[1], 10) }),
        });
    }
    return anchors;
};

// ---- discovery -----------------------------------------------------------------------------------------------

/* Every package under a repo: a directory holding a recognised manifest. Evidence over configuration — reading
 * pnpm-workspace globs, npm `workspaces`, Cargo `members` and their equivalents would be four parsers that each
 * disagree with the filesystem in a different way, and the filesystem is the thing that is actually true.
 *
 * The repo root counts as a package only when nothing under it does, so a plain single-package repo documents
 * itself instead of coming back empty. */
/* A DIRECTORY THAT IS ITS OWN REPOSITORY, and therefore where this repository's packages stop. A worktree's
 * marker is a file rather than a directory, so this asks whether the marker exists at all. */
const isRepoRoot = (dir) => existsSync(join(dir, `.git`));

/* Every package in a repository, found by its manifest — and NOTHING from a repository nested inside it.
 *
 * The boundary is the whole reason this is not a plain walk. A workspace root holding clones (a monorepo beside a
 * reference shelf, which is the ordinary shape here) would otherwise claim every package in every clone as its
 * own: hundreds of entries duplicating indexes those repos already keep, plus every reference checkout reported
 * as undocumented work. Each of those repos documents itself, at its own root, in its own git history — which is
 * the point of a page living beside its code. */
const discoverPackages = (repoRoot) => {
    const found = [];
    const walk = (dir, depth) => {
        if (depth > MAX_DEPTH) {
            return;
        }
        let entries;
        try {
            entries = readdirSync(dir, { withFileTypes: true });
        } catch {
            return;
        }
        const candidate = relative(repoRoot, dir).split(`\\`).join(`/`);
        const isFixture = candidate.split(`/`).some((segment) => NON_PACKAGE_SEGMENTS.has(segment));
        if (dir !== repoRoot && !isFixture && MANIFESTS.some((manifest) => entries.some((entry) => entry.isFile() && entry.name === manifest))) {
            found.push(candidate);
            // Do NOT return: a monorepo nests packages under packages, and stopping here would hide them.
        }
        for (const entry of entries) {
            if (entry.isDirectory() && !SKIP_DIRS.has(entry.name) && !entry.name.startsWith(`.`) && !isRepoRoot(join(dir, entry.name))) {
                walk(join(dir, entry.name), depth + 1);
            }
        }
    };
    walk(repoRoot, 0);
    if (found.length === 0 && MANIFESTS.some((manifest) => existsSync(join(repoRoot, manifest)))) {
        return [``];
    }
    return found.sort();
};

// Lines of source and file count for one package dir, not counting nested packages — otherwise a monorepo root
// would report the whole tree and every comparison between packages would be meaningless.
const measure = (repoRoot, dir, nested) => {
    const absolute = dir === `` ? repoRoot : join(repoRoot, dir);
    let files = 0;
    let loc = 0;
    let hasTests = false;
    const walk = (current, depth) => {
        if (depth > MAX_DEPTH) {
            return;
        }
        let entries;
        try {
            entries = readdirSync(current, { withFileTypes: true });
        } catch {
            return;
        }
        for (const entry of entries) {
            const path = join(current, entry.name);
            if (entry.isDirectory()) {
                const rel = relative(repoRoot, path).split(`\\`).join(`/`);
                if (!SKIP_DIRS.has(entry.name) && !entry.name.startsWith(`.`) && !nested.includes(rel)) {
                    if (entry.name === `test` || entry.name === `tests` || entry.name === `__tests__`) {
                        hasTests = true;
                    }
                    walk(path, depth + 1);
                }
                continue;
            }
            const extension = entry.name.includes(`.`) ? entry.name.slice(entry.name.lastIndexOf(`.`) + 1) : ``;
            if (!SOURCE_EXTENSIONS.has(extension)) {
                continue;
            }
            if (/\.(test|spec)\./.test(entry.name)) {
                hasTests = true;
            }
            files += 1;
            try {
                if (statSync(path).size <= MAX_MEASURED_BYTES) {
                    loc += readFileSync(path, `utf8`).split(`\n`).length;
                }
            } catch {
                // An unreadable file still counts as a file; its size is simply unknown.
            }
        }
    };
    walk(absolute, 0);
    return { files, loc, hasTests };
};

// Workspace dependency edges, from each package.json's declared deps intersected with the packages that exist
// here. Only intra-repo edges: an edge to `vue` says nothing about this repo's shape.
const dependencyEdges = (repoRoot, packages) => {
    const nameToDir = new Map();
    const manifests = new Map();
    for (const dir of packages) {
        const manifest = readJson(join(dir === `` ? repoRoot : join(repoRoot, dir), `package.json`));
        if (manifest?.name !== undefined) {
            nameToDir.set(manifest.name, dir);
        }
        manifests.set(dir, manifest);
    }
    const edges = [];
    for (const dir of packages) {
        const manifest = manifests.get(dir);
        if (manifest === undefined) {
            continue;
        }
        const runtime = manifest.dependencies ?? {};
        const declared = new Set([...Object.keys(runtime), ...Object.keys(manifest.devDependencies ?? {})]);
        for (const name of declared) {
            const to = nameToDir.get(name);
            if (to !== undefined && to !== dir) {
                // Dev only when it is NOT also a runtime dependency: a package listed in both is load-bearing at
                // runtime, and drawing that edge as dashed would understate it.
                edges.push({ from: dir, to, dev: !(name in runtime) });
            }
        }
    }
    return edges.sort((left, right) => `${left.from}->${left.to}`.localeCompare(`${right.from}->${right.to}`));
};

// The last commit that touched a path. A real commit rather than a tree hash, so a reader can look it up — and
// `rev-list --count` against it answers "how far behind" exactly.
const revOf = (repoRoot, path) => git(repoRoot, [`log`, `-1`, `--format=%H`, `--`, path === `` ? `.` : path]);
const committedAt = (repoRoot, rev) => {
    const seconds = git(repoRoot, [`log`, `-1`, `--format=%ct`, rev]);
    return seconds === undefined ? undefined : (Number.parseInt(seconds, 10) || 0) * 1000;
};

/* HOW FAR THE CODE HAS RUN AHEAD OF ITS PAGE — the whole staleness signal, in one git call and no authored field.
 *
 * Commits touching the package since the last commit that touched its README. Because that rev is the README's
 * OWN most recent commit, every commit in the range is by construction one that changed the package without
 * changing its page — which is exactly the thing worth counting, and exactly what the same-commit rule asks an
 * author to keep at zero. Updating the README in the same commit as the code moves the rev forward with it, so
 * there is nothing to bump and nothing to forget. */
const behindOf = (repoRoot, dir, readmeRev) => {
    if (readmeRev === undefined) {
        return 0;
    }
    const count = git(repoRoot, [`rev-list`, `--count`, `${readmeRev}..HEAD`, `--`, dir === `` ? `.` : dir]);
    return count === undefined ? 0 : Number.parseInt(count, 10) || 0;
};

// ---- the document tree ---------------------------------------------------------------------------------------

/* Where the repo-level map lives for the tree being read. The PACKAGE pages are not in here — a published one is
 * `<repo>/<dir>/README.md`, beside its code, which is the entire point of the layout. */
const mapBase = (root, repo, from) =>
    from === `staging` ? join(root, STAGING_ROOT, repo === `` ? `root` : repo) : join(root, repo === `` ? `` : repo, DOCS_DIR);

// Where one package's page lives. Staging mirrors the package dir under the repo's staging root, so publishing is
// a copy per tail and never a translation.
const pagePath = (root, repo, dir, from) =>
    from === `staging`
        ? join(root, STAGING_ROOT, repo === `` ? `root` : repo, dir, README_TAIL)
        : join(root, repo === `` ? `` : repo, dir, README_TAIL);

/* Which package dirs have a page. Read off the filesystem rather than from repo.json, so a page that exists is
 * counted whether or not the map remembered to mention it.
 *
 * Published: the packages that exist and have a README. A published page CANNOT outlive its directory — it is in
 * it — so the orphan case is structurally impossible on this side, which is one whole class of rot the layout
 * deletes rather than detects. Staging: whatever the draft holds, which may well name a package that is gone. */
const documentedDirs = (root, repo, from, packages) => {
    if (from !== `staging`) {
        return packages.filter((dir) => dir !== `` && existsSync(pagePath(root, repo, dir, from)));
    }
    const base = mapBase(root, repo, from);
    const found = [];
    const walk = (dir, depth) => {
        if (depth > MAX_DEPTH + 1) {
            return;
        }
        let entries;
        try {
            entries = readdirSync(dir, { withFileTypes: true });
        } catch {
            return;
        }
        if (entries.some((entry) => entry.isFile() && entry.name === README_TAIL)) {
            found.push(relative(base, dir).split(`\\`).join(`/`));
        }
        for (const entry of entries) {
            if (entry.isDirectory()) {
                walk(join(dir, entry.name), depth + 1);
            }
        }
    };
    walk(base, 0);
    return found.filter((dir) => dir !== `` && dir !== `.`).sort();
};

// ---- verbs ---------------------------------------------------------------------------------------------------

const factsOf = (root, repo) => {
    const repoRoot = repo === `` ? root : join(root, repo);
    const packages = discoverPackages(repoRoot);
    return {
        repo,
        head: git(repoRoot, [`rev-parse`, `HEAD`]),
        packages: packages.map((dir) => {
            const manifest = readJson(join(dir === `` ? repoRoot : join(repoRoot, dir), `package.json`));
            const nested = packages.filter((other) => other !== dir && other.startsWith(dir === `` ? `` : `${dir}/`));
            const { files, loc, hasTests } = measure(repoRoot, dir, nested);
            return {
                dir,
                name: manifest?.name,
                description: manifest?.description,
                files,
                loc,
                hasTests,
                hasReadme: existsSync(join(repoRoot, dir, README_TAIL)),
                sourceRev: revOf(repoRoot, dir),
            };
        }),
        edges: dependencyEdges(repoRoot, packages),
    };
};

/* Every package has a page, every page describes itself, and every anchor resolves. Anchors are checked against
 * the WORKING TREE the agent is in, which is the point: an anchor that no longer resolves is the one staleness
 * signal that needs no git history and cannot be argued with. */
const validateDocs = (root, repo, from) => {
    const repoRoot = repo === `` ? root : join(root, repo);
    const base = mapBase(root, repo, from);
    const packages = discoverPackages(repoRoot);
    const documented = documentedDirs(root, repo, from, packages);
    const problems = [];

    const repoDoc = readJson(join(base, `repo.json`));
    if (repoDoc === undefined) {
        problems.push(`${relative(root, join(base, `repo.json`))} is missing or is not valid JSON`);
    }
    if (!existsSync(join(base, `repo.md`))) {
        problems.push(`${relative(root, join(base, `repo.md`))} is missing — the repository's own page`);
    }

    for (const dir of documented) {
        const markdown = readText(pagePath(root, repo, dir, from));
        if (markdown === undefined) {
            problems.push(`${dir}/README.md cannot be read`);
            continue;
        }
        if (leadSentence(markdown) === undefined) {
            problems.push(`${dir}/README.md has no lead sentence under its heading — that sentence IS the package's one-liner`);
        }
        for (const anchor of keyFilesOf(markdown, dir)) {
            if (!existsSync(join(repoRoot, anchor.path))) {
                problems.push(`${dir}/README.md points at ${anchor.path}, which does not exist`);
            }
        }
    }

    for (const dir of packages.filter((candidate) => candidate !== `` && !documented.includes(candidate))) {
        problems.push(`${dir} has no README.md — every package is documented by its own`);
    }
    return problems;
};

const checkDocs = (root, repo, from, write) => {
    const repoRoot = repo === `` ? root : join(root, repo);
    const base = mapBase(root, repo, from);
    const packages = discoverPackages(repoRoot);
    const documented = documentedDirs(root, repo, from, packages);
    const repoDoc = readJson(join(base, `repo.json`));
    const componentOf = (dir) =>
        (Array.isArray(repoDoc?.components) ? repoDoc.components : []).find((component) => (component.packages ?? []).includes(dir))?.id;

    const entries = documented.map((dir) => {
        const markdown = readText(pagePath(root, repo, dir, from)) ?? ``;
        const manifest = readJson(join(repoRoot, dir, `package.json`));
        const nested = packages.filter((other) => other !== dir && other.startsWith(`${dir}/`));
        const gone = !existsSync(join(repoRoot, dir));
        const { files, loc, hasTests } = gone ? { files: 0, loc: 0, hasTests: false } : measure(repoRoot, dir, nested);
        const anchors = keyFilesOf(markdown, dir);
        const deadAnchor = anchors.find((anchor) => !existsSync(join(repoRoot, anchor.path)));
        const readmeRev = gone ? undefined : revOf(repoRoot, `${dir}/${README_TAIL}`);
        const behind = gone ? 0 : behindOf(repoRoot, dir, readmeRev);
        /* Reasons are ordered by how much they tell the reader, not by how easy they are to compute. A dead
         * anchor is a page that is already wrong; being commits behind only means it MIGHT be. */
        const reason = gone
            ? `the package no longer exists`
            : deadAnchor !== undefined
              ? `it points at ${deadAnchor.path}, which no longer exists`
              : behind > 0
                ? `${behind} commit${behind === 1 ? ` has` : `s have`} touched this package since its README was written`
                : undefined;
        return {
            dir,
            name: manifest?.name,
            oneLiner: leadSentence(markdown) ?? ``,
            component: componentOf(dir),
            anchors,
            files,
            loc,
            hasTests,
            readmeRev: readmeRev ?? ``,
            updatedAt: readmeRev === undefined ? 0 : (committedAt(repoRoot, readmeRev) ?? 0),
            stale: reason !== undefined,
            reason,
            behind,
        };
    });

    const index = {
        repo,
        generatedAt: Date.now(),
        entries,
        edges: dependencyEdges(repoRoot, packages),
        orphans: documented.filter((dir) => !existsSync(join(repoRoot, dir))),
        undocumented: packages.filter((dir) => dir !== `` && !documented.includes(dir)),
    };
    if (write) {
        mkdirSync(base, { recursive: true });
        writeFileSync(join(base, `index.json`), canonical(index));
    }
    return index;
};

// ---- cli -----------------------------------------------------------------------------------------------------

const USAGE = `intentic-docs — facts, validation and staleness for architecture documentation

  intentic-docs facts     [--root DIR] [--repo DIR]
  intentic-docs validate  [--root DIR] [--repo DIR] [--from staging|published]
  intentic-docs check     [--root DIR] [--repo DIR] [--from staging|published] [--write]

  --root  workspace root (default /work)
  --repo  repository directory relative to the root; omit for the root repo itself
  --from  which tree to read: the staged draft you are writing, or the published one (default staging)
  --write check only: rewrite index.json in place. Without it, the index goes to stdout.

A package's page is its own README.md. Only the map (repo.json, repo.md) and the generated index.json live under
${DOCS_DIR}/.
`;

const main = (argv) => {
    const verb = argv[0];
    const flag = (name, fallback) => {
        const at = argv.indexOf(`--${name}`);
        return at === -1 || argv[at + 1] === undefined ? fallback : argv[at + 1];
    };
    const root = flag(`root`, `/work`);
    const repo = flag(`repo`, ``);
    const from = flag(`from`, `staging`) === `published` ? `published` : `staging`;

    /* `--repo` IS RELATIVE TO `--root`, and passing the absolute path instead has to fail loudly rather than
     * quietly work. Joining a root onto an absolute path yields a directory that does not exist and never did
     * (`/work` + `/work/intentic` → `/work/work/intentic`), so the run scanned nothing, found nothing, and wrote
     * an empty index into a tree it had just invented — twice, and someone had to notice and delete it by hand
     * both times. The absolute path is the obvious thing to type; the only defence is refusing it. */
    if (isAbsolute(repo) || repo.split(`/`).includes(`..`)) {
        process.stderr.write(`--repo is relative to --root, so pass \`${relative(root, repo) || `.`}\` rather than \`${repo}\`.\nOmit it entirely for the root repository itself.\n`);
        return 2;
    }

    if (verb === `facts`) {
        process.stdout.write(canonical(factsOf(root, repo)));
        return 0;
    }
    if (verb === `validate`) {
        const problems = validateDocs(root, repo, from);
        if (problems.length === 0) {
            process.stdout.write(`documents are valid\n`);
            return 0;
        }
        process.stderr.write(`${problems.map((problem) => `- ${problem}`).join(`\n`)}\n`);
        return 1;
    }
    if (verb === `check`) {
        const write = argv.includes(`--write`);
        /* WRITING A STAGED INDEX FOR A DRAFT THAT DOES NOT EXIST IS HOW THE APP LOSES ITS DOCUMENTS. `--from`
         * defaults to staging because generation is what usually runs this, but the other caller — someone who
         * has just edited a README that is already in the repository — wants `--from published`, and forgetting
         * it used to CREATE the staging directory. The app reads that directory to answer "is there a draft to
         * review", so a lone index there announced a draft with no map and no pages, and the repository's real
         * documents went behind a toggle. Refusing costs a re-run with the right flag; writing costs the reader
         * the whole area. */
        if (write && from === `staging` && !existsSync(mapBase(root, repo, from))) {
            process.stderr.write(`no draft at ${mapBase(root, repo, from)} — nothing to index there.\nIf you edited a README in the repository, this is \`--from published\`.\n`);
            return 1;
        }
        const index = checkDocs(root, repo, from, write);
        if (!write) {
            process.stdout.write(canonical(index));
            return 0;
        }
        const stale = index.entries.filter((entry) => entry.stale).length;
        process.stdout.write(`${index.entries.length} documented, ${stale} stale, ${index.undocumented.length} undocumented, ${index.orphans.length} orphaned\n`);
        return 0;
    }
    process.stderr.write(USAGE);
    return verb === `--help` || verb === `help` ? 0 : 2;
};

// Only run when executed, so the constants above can be imported by a test that pins them to src/paths.ts.
const entry = process.argv[1];
if (entry !== undefined && realpathSync(entry) === realpathSync(fileURLToPath(import.meta.url))) {
    process.exit(main(process.argv.slice(2)));
}
