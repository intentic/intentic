{
    "publisher": "intentic",
    "name": "documentation",
    "version": "1.0.0",
    "category": "knowledge",
    "icon": "question-circle",
    "engines": { "intentic": "^1.0.0" },
    "permissions": {
        "sandbox": [
            "GET /workspace/children",
            "GET /workspace/file",
            "POST /workspace/upload",
            "DELETE /workspace/entry",
            "GET /panels",
            "POST /agent",
            "POST /agent/stop",
            "GET /agents",
            "GET /git/*/status",
            "PUT /git/*/file",
            "POST /git/*/stage",
            "POST /git/*/commit"
        ]
    },
    "contributes": {
        "views": [
            { "id": "documentation", "label": "Documentation", "surface": "rail", "badge": true },
            { "id": "documentation-repo", "label": "Docs", "surface": "directory" }
        ],
        "documents": [{ "id": "architecture", "label": "Architecture" }],
        "files": [{ "path": ".intentic/docs/", "invalidates": ["documentation", "documentation-runs"] }],
        "commands": [{ "command": "documentation.generate", "title": "Generate documentation" }],
        "bin": "bin",
        "agent": { "path": "plugin" }
    }
}
