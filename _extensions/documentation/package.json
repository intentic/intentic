{
    "name": "@intentic/ext-documentation",
    "version": "1.0.0",
    "description": "Documentation — AI-generated, human-reviewed orientation docs for every repository and package, as a first-party intentic extension",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "vue-tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@intentic/extension-api": "workspace:*",
        "@intentic/extension-ui": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@tanstack/vue-query": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "jsdom": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    }
}
