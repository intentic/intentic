{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "onlyoffice",
    "version": "1.2.0",
    "category": "workspace",
    "logo": "onlyoffice",
    "icon": "file-edit",
    "engines": { "intentic": "^2.26.0" },
    "server": "dist/server.js",
    "permissions": {
        "daemon": ["GET /ports", "POST /ports/forward", "GET /workspace/raw"]
    },
    "contributes": {
        "settings": [
            {
                "key": "engine",
                "type": "enum",
                "enum": ["browser", "server"],
                "enumItemLabels": ["In your browser", "Document server"],
                "enumDescriptions": [
                    "A one-time download of about 200 MB, no Docker. Tabs on one file don't co-edit; a save that would overwrite someone else's change asks first.",
                    "ONLYOFFICE Docs in this sandbox's Docker: a 2 GB image and a two-minute cold start. Tabs on one file co-edit live."
                ],
                "title": "Editor engine",
                "description": "Documents on your own computer, opened in the desktop app, always use the browser.",
                "default": "browser"
            },
            {
                "key": "autoStart",
                "type": "boolean",
                "title": "Prepare the editor with the sandbox",
                "description": "Gets the engine ready in the background when the sandbox starts, so the first document opens without the wait. Off: the first document you open does it.",
                "default": false
            }
        ],
        "viewers": [
            {
                "id": "office",
                "edit": true,
                "fetch": "path",
                "extensions": [
                    "docx",
                    "dotx",
                    "docm",
                    "odt",
                    "ott",
                    "rtf",
                    "doc",
                    "xlsx",
                    "xltx",
                    "xlsm",
                    "ods",
                    "ots",
                    "xls",
                    "pptx",
                    "potx",
                    "pptm",
                    "odp",
                    "otp",
                    "ppt"
                ]
            }
        ]
    }
}
