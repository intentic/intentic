{
    "name": "@intentic/ext-onlyoffice",
    "version": "1.0.0",
    "description": "ONLYOFFICE Docs in the workspace: documents, spreadsheets and presentations opened in a full editor — first-party intentic extension via contributes.viewers and a backend that runs the document server",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "vite build --config vite.server.config.ts",
        "typecheck": "vue-tsc --noEmit",
        "test": "suites"
    },
    "dependencies": {
        "@intentic/extension-api": "workspace:*",
        "@intentic/extension-manifest": "workspace:*",
        "@intentic/extension-ui": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    }
}
