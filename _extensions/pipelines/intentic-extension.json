{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "pipelines",
    "version": "1.0.0",
    "category": "work",
    "icon": "bolt",
    "engines": { "intentic": "^2.22.0" },
    "permissions": {
        "sandbox": [
            "GET /settings",
            "GET /agents",
            "GET /ci/runs",
            "POST /ci/runs/rerun",
            "POST /ci/runs/cancel",
            "POST /ci/runs/jobs",
            "POST /ci/fix"
        ]
    },
    "contributes": {
        "views": [{ "id": "pipelines", "label": "Pipelines", "surface": "rail", "badge": true }],
        "sideViews": [{ "id": "run", "label": "CI run", "links": true }]
    }
}
