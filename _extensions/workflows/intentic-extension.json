{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "workflows",
    "version": "1.0.0",
    "category": "work",
    "icon": "sitemap",
    "engines": { "intentic": "^2.0.0" },
    "permissions": {
        "sandbox": [
            "GET /workflows",
            "POST /workflows",
            "DELETE /workflows/*",
            "POST /workflows/*/run",
            "GET /workflows/runs",
            "POST /workflows/runs/*/stop",
            "GET /loops/designs",
            "POST /loops/designs",
            "DELETE /loops/designs/*",
            "GET /personas"
        ]
    },
    "contributes": {
        "views": [{ "id": "workflows", "label": "Workflows", "surface": "rail", "badge": true }]
    }
}
