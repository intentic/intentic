{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "discord",
    "version": "1.0.0",
    "category": "connections",
    "logo": "discord",
    "engines": {
        "intentic": "^2.0.0"
    },
    "permissions": {
        "daemon": ["POST /speech/transcribe"]
    },
    "contributes": {
        "listener": {
            "provider": "discord",
            "events": [
                {
                    "type": "message",
                    "label": "Messages"
                },
                {
                    "type": "voice_utterance",
                    "label": "Voice utterances"
                },
                {
                    "type": "voice_transcript",
                    "label": "Voice transcripts"
                }
            ],
            "automation": {
                "label": "Discord",
                "mentionLabel": "Only when the bot is mentioned (@mention or reply)",
                "channel": {
                    "label": "Channel ID (optional)",
                    "placeholder": "all channels the bot can read"
                },
                "sender": {
                    "label": "User ID",
                    "placeholder": "e.g. 80351110224678912",
                    "hint": "Settings → Advanced → Developer Mode, then right-click a member → Copy User ID. An id, never a username, which anyone can change to."
                },
                "senderGroup": {
                    "label": "Role ID",
                    "placeholder": "e.g. 1180123456789012345",
                    "hint": "Server Settings → Roles → ⋯ → Copy Role ID. The server's own ID is the role everyone in it has."
                },
                "starterPrompt": "Discord events just arrived, each line of the event payload is one JSON event: type `message` (a new message: author, channelId, content; `mentioned: true` when the bot was tagged or replied to), `voice_utterance` (one transcribed utterance from a live voice session), or `voice_transcript` (a finished voice session, read the transcript at its `extra.path`). Handle messages that need attention with your Discord capability; treat utterances as live conversation context; turn finished transcripts into notes and action items in the workspace."
            }
        },
        "processes": [
            {
                "name": "gateway",
                "command": "node dist/gateway.js",
                "autoStart": true
            }
        ],
        "bin": "bin",
        "capabilities": [
            {
                "id": "discord",
                "kind": "cli",
                "catalog": {
                    "name": "Discord",
                    "logo": "discord",
                    "description": "Read and post in your Discord server.",
                    "category": "communication",
                    "hint": "Voice calls are transcribed on this sandbox, by the same speech engine as the composer's microphone.",
                    "guide": {
                        "url": "https://discord.com/developers/applications",
                        "linkLabel": "Open the Discord developer portal",
                        "scopes": "privileged intents `Message Content` + `Server Members`",
                        "steps": [
                            "`New Application` → `Bot`.",
                            "`Reset Token`, then copy the bot token.",
                            "Enable the `Message Content` and `Server Members` privileged intents.",
                            "Paste the token, then ask the agent to “invite yourself to my server”."
                        ]
                    }
                },
                "fields": [
                    {
                        "key": "botToken",
                        "label": "Bot token",
                        "secret": true
                    },
                    {
                        "key": "voiceLanguage",
                        "label": "Voice language",
                        "placeholder": "auto",
                        "optional": true
                    }
                ],
                "env": {
                    "DISCORD_BOT_TOKEN": "${botToken}"
                },
                "skill": "skills/discord/SKILL.md",
                "broker": {
                    "routes": [
                        {
                            "upstream": "https://discord.com/api",
                            "env": "DISCORD_API_URL",
                            "headers": {
                                "authorization": "Bot ${botToken}"
                            }
                        }
                    ],
                    "rules": [
                        {
                            "methods": ["DELETE"],
                            "paths": ["/v10/guilds/*", "/guilds/*", "/v10/channels/*", "/channels/*"],
                            "action": "ask",
                            "why": "deletes a server or a channel"
                        }
                    ]
                },
                "hosts": ["discord.com"]
            }
        ]
    }
}
