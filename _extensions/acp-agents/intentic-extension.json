{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "acp-agents",
    "version": "1.0.0",
    "category": "connections",
    "icon": "terminal",
    "engines": { "intentic": "^2.0.0" },
    "contributes": {
        "capabilities": [
            {
                "id": "opencode",
                "kind": "agent",
                "catalog": {
                    "name": "OpenCode",
                    "logo": "opencode",
                    "description": "Run OpenCode as a chat provider over ACP.",
                    "category": "extend",
                    "hint": "Run the login command in a Terminal once: it keeps its own credentials."
                },
                "fields": [
                    { "key": "command", "label": "Command", "default": "opencode acp" },
                    { "key": "name", "label": "Display name", "default": "OpenCode", "optional": true },
                    { "key": "env", "label": "Environment", "secret": true, "optional": true, "multiline": true, "keyValue": true },
                    { "key": "loginCommand", "label": "Login command", "default": "opencode auth login", "optional": true }
                ]
            },
            {
                "id": "gemini",
                "kind": "agent",
                "catalog": {
                    "name": "Gemini CLI",
                    "logo": "googlegemini",
                    "description": "Run Google's Gemini CLI as a chat provider.",
                    "category": "extend",
                    "hint": "Sign in opens Gemini in a terminal: choose Sign in with Google, open the link it prints and paste the code back. Or add GEMINI_API_KEY under Environment."
                },
                "fields": [
                    { "key": "command", "label": "Command", "default": "gemini --experimental-acp" },
                    { "key": "name", "label": "Display name", "default": "Gemini", "optional": true },
                    {
                        "key": "env",
                        "label": "Environment",
                        "placeholder": "GEMINI_API_KEY=…",
                        "secret": true,
                        "optional": true,
                        "multiline": true,
                        "keyValue": true
                    },
                    { "key": "loginCommand", "label": "Login command", "default": "NO_BROWSER=true gemini", "optional": true }
                ]
            },
            {
                "id": "acp-agent",
                "kind": "agent",
                "catalog": {
                    "name": "Custom ACP agent",
                    "description": "Goose, Qwen Code, or one of your own.",
                    "category": "extend",
                    "hint": "The command must be on the sandbox PATH and speak ACP over stdio.",
                    "guide": {
                        "url": "https://agentclientprotocol.com",
                        "linkLabel": "Browse ACP agents",
                        "steps": [
                            "Pick an agent from `agentclientprotocol.com`, note its run command.",
                            "API key? Add it under `Environment`, its name and its value.",
                            "Device-code sign-in? Add its login command and run it after adding.",
                            "The agent then appears as a provider in the chat's model picker."
                        ]
                    }
                },
                "fields": [
                    { "key": "command", "label": "Command", "placeholder": "npx -y my-acp-agent" },
                    { "key": "name", "label": "Display name", "optional": true },
                    { "key": "env", "label": "Environment", "secret": true, "optional": true, "multiline": true, "keyValue": true },
                    { "key": "loginCommand", "label": "Login command", "optional": true }
                ]
            }
        ]
    }
}
