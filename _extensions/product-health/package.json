{
    "name": "@intentic/ext-product-health",
    "version": "1.0.0",
    "description": "Product health: what PostHog finds in your product (errors, firing alerts, health checks, Inbox reports) as a rail tile that puts agents on it, as a first-party intentic extension",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "vite build --config vite.server.config.ts",
        "typecheck": "vue-tsc --noEmit",
        "test": "suites"
    },
    "dependencies": {
        "@intentic/base": "workspace:*",
        "@intentic/extension-api": "workspace:*",
        "@intentic/extension-manifest": "workspace:*",
        "@intentic/extension-ui": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@tanstack/vue-query": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:typescript6",
        "vite": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    }
}
