{
    "$schema": "https://intentic.dev/intentic-extension.schema.json",
    "publisher": "intentic",
    "name": "viewers",
    "version": "1.0.0",
    "category": "workspace",
    "icon": "image",
    "engines": { "intentic": "^2.0.0" },
    "contributes": {
        "viewers": [
            { "id": "image", "extensions": ["png", "jpg", "jpeg", "gif", "webp", "avif", "bmp", "ico"], "fetch": "blob" },
            { "id": "svg", "extensions": ["svg"], "fetch": "text" },
            { "id": "pdf", "extensions": ["pdf"], "fetch": "blob" },
            {
                "id": "media",
                "extensions": [
                    "mp3",
                    "wav",
                    "flac",
                    "ogg",
                    "oga",
                    "opus",
                    "weba",
                    "m4a",
                    "aac",
                    "mp4",
                    "m4v",
                    "webm",
                    "ogv",
                    "mov",
                    "3gp",
                    "mkv",
                    "avi",
                    "wmv"
                ],
                "fetch": "url"
            },
            { "id": "docx", "extensions": ["docx"], "fetch": "blob", "compare": true },
            { "id": "xlsx", "extensions": ["xlsx", "ods", "ots"], "fetch": "blob" },
            { "id": "pptx", "extensions": ["pptx"], "fetch": "blob" },
            { "id": "odf-text", "extensions": ["odt", "ott"], "fetch": "blob" },
            { "id": "odf-slides", "extensions": ["odp", "otp", "odg", "otg"], "fetch": "blob" },
            { "id": "rtf", "extensions": ["rtf"], "fetch": "blob" },
            { "id": "epub", "extensions": ["epub"], "fetch": "blob" }
        ]
    }
}
