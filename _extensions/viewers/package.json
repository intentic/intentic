{
    "name": "@intentic/ext-viewers",
    "version": "1.0.0",
    "description": "File viewers (images, SVG, PDF, audio/video, docx, odt, rtf, xlsx, ods, pptx, odp, epub) — first-party intentic extension via contributes.viewers",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./docx-compare": {
            "types": "./src/docxCompare.ts",
            "default": "./src/docxCompare.ts"
        },
        "./testing": {
            "types": "./src/testing.ts",
            "default": "./src/testing.ts"
        }
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit",
        "test": "suites"
    },
    "dependencies": {
        "@intentic/extension-api": "workspace:*",
        "@intentic/extension-manifest": "workspace:*",
        "@intentic/extension-ui": "workspace:*",
        "docx-preview": "catalog:",
        "fflate": "catalog:",
        "read-excel-file": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "typescript": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    }
}
