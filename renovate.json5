{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],
    // Strict locking: every THIRD-PARTY docker image in the IMAGES map is pinned to a tag + sha256 digest. Keep
    // digests maintained so a pin is always immutable. The first-party `sandbox` is intentionally unpinned (it
    // tracks the moving `stable` release tag the release publishes), so no manager below covers it.
    pinDigests: true,
    customManagers: [
        {
            // Read each pin from the frozen IMAGES map. The `renovate:` hint comment above an entry supplies the
            // depName; the string literal supplies the current tag + digest. This keeps images.ts plain TypeScript
            // with no build-time generation.
            customType: "regex",
            managerFilePatterns: ["/_libs/state-resolver/src/lib/images\\.ts$/"],
            matchStrings: [
                'renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)[\\s\\S]*?"[^"]*:(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]+)"',
            ],
        },
        {
            // The cloudflared sidecar IMAGE, embedded in files no built-in manager reads: the setup one-liner
            // scripts and the compose the setup page renders for the user to paste. They are not Dockerfiles
            // or compose files, so the pin is matched literally off the image name.
            customType: "regex",
            managerFilePatterns: [
                "/_apps/site/public/scripts/connect\\.sh$/",
                "/_apps/site/public/scripts/connect\\.ps1$/",
                "/_apps/site/public/scripts/connect-host\\.ps1$/",
                "/_apps/web/src/pages/setupCompose\\.ts$/",
            ],
            matchStrings: ["cloudflare/cloudflared:(?<currentValue>[^@'\"`\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
            depNameTemplate: "cloudflare/cloudflared",
            datasourceTemplate: "docker",
        },
        {
            // The cloudflared BINARY — same upstream, a different artifact: the sandbox image bakes it on PATH,
            // the self-host connector scripts install it natively (a container's localhost is the VM under
            // Docker Desktop, so the connector cannot be one), and the sync CLI downloads it per machine.
            // github-releases, so there is no digest to pin — only the tag has to stay in step with the image.
            customType: "regex",
            managerFilePatterns: [
                "/_apps/sandbox/Dockerfile$/",
                "/_apps/site/public/scripts/connect\\.sh$/",
                "/_apps/site/public/scripts/connect-host\\.sh$/",
                "/_apps/sync/src/mutagen\\.ts$/",
            ],
            matchStrings: ["CLOUDFLARED_VERSION[^\\n]*?(?<currentValue>20[0-9]{2}\\.[0-9]+\\.[0-9]+)"],
            depNameTemplate: "cloudflare/cloudflared",
            datasourceTemplate: "github-releases",
        },
        {
            // The starter Dockerfile the CI providers commit into a fresh repo that has none. It is a string
            // literal in TypeScript, so the dockerfile manager never sees it — but it is an image we make
            // somebody else build, which is exactly where a rotting pin is least visible.
            customType: "regex",
            managerFilePatterns: ["/_libs/providers/src/core/ci-yaml\\.ts$/"],
            matchStrings: ['busybox:(?<currentValue>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]+)'],
            depNameTemplate: "busybox",
            datasourceTemplate: "docker",
        },
    ],
    packageRules: [
        {
            // The Agent SDK BUNDLES the Claude Code CLI binary the sandbox actually executes (see its
            // manifest.json — the SDK version maps 1:1 onto a `claude` release), and the image bakes
            // node_modules, so this pin IS the harness version. A stale pin runs every Claude turn on a build
            // that predates the models it serves — its system prompt branches on the model id, so an unknown
            // model silently falls into the wrong prompt family. Track upstream as tightly as Renovate allows:
            // every release, unscheduled, automerged.
            groupName: "claude agent sdk",
            matchPackageNames: ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk-*"],
            schedule: ["at any time"],
            automerge: true,
        },
        {
            // The SigNoz stack (server + collector + zookeeper + clickhouse) is version-interdependent and its bumps
            // re-port the compose/collector/cluster configs in signoz.ts from SigNoz's reference deploy — group them
            // into one PR so a reviewer sees and validates the whole stack move together.
            groupName: "signoz stack",
            matchPackageNames: ["signoz/signoz", "signoz/signoz-otel-collector", "signoz/zookeeper", "clickhouse/clickhouse-server"],
        },
        {
            // FerretDB and its documentdb-extended postgres are paired by tag; bump them together.
            groupName: "ferretdb",
            matchPackageNames: ["ghcr.io/ferretdb/ferretdb", "ghcr.io/ferretdb/postgres-documentdb"],
        },
        {
            groupName: "komodo",
            matchPackageNames: ["ghcr.io/moghtech/komodo-core", "ghcr.io/moghtech/komodo-periphery"],
        },
        {
            // cloudflared is named in seven places — the IMAGES map, the platform compose, the compose the
            // setup page renders, the four connect scripts, the sandbox image's baked binary and the sync
            // CLI's. Ungrouped they drifted to THREE versions at once (the PowerShell scripts sat a full minor
            // behind their shell twins), which means a Windows user's tunnel and their sandbox's bundled
            // cloudflared were different builds. One PR moves every reference or none of them.
            groupName: "cloudflared",
            matchPackageNames: ["cloudflare/cloudflared"],
        },
    ],
}
