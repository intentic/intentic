{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    // pinGitHubActionDigests is the supply-chain half: a workflow that says `@v7` re-resolves that tag on every
    // run, so whoever can move the tag can run code on the runner that holds the release credentials. Pinned to
    // a commit sha the step is immutable, and the `# v7.0.1` comment beside it is what Renovate reads to keep
    // the pin current — the readable version stays visible without being what Actions resolves.
    extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
    // Strict locking: every THIRD-PARTY docker image is pinned to a tag + sha256 digest. Keep digests maintained
    // so a pin is always immutable. The first-party `sandbox` is intentionally unpinned (it tracks the moving
    // `stable` release tag the release publishes).
    pinDigests: true,
    // cloudflared, binary and image, belongs to the daily tool bump (.github/workflows/tools.yml, which moves its tag and
    // digest at every site _tools/scripts/tools/tool-pins.mjs lists). Two bots writing one pin open competing pull
    // requests, so Renovate leaves it alone. The same goes for anything else that table lists: Bun, the image three
    // Dockerfiles copy it from and the catalog's npm package, is one pin there.
    ignoreDeps: ["cloudflare/cloudflared", "oven/bun", "bun"],
    packageRules: [
        {
            // The Agent SDK BUNDLES the Claude Code CLI binary the sandbox actually executes (see its
            // manifest.json — the SDK version maps 1:1 onto a `claude` release), and the image bakes
            // node_modules, so this pin IS the harness version. A stale pin runs every Claude turn on a build
            // that predates the models it serves — its system prompt branches on the model id, so an unknown
            // model silently falls into the wrong prompt family. Track upstream as tightly as Renovate allows:
            // every release, unscheduled, automerged.
            groupName: "claude agent sdk",
            matchPackageNames: ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/claude-agent-sdk-*"],
            schedule: ["at any time"],
            automerge: true,
        },
    ],
}
