{
    "name": "@intentic/fileq",
    "version": "0.0.0",
    "description": "fileq, agent-native file reading: any binary workspace file (docx, xlsx, pptx, pdf, images, audio, archives) as clean budgeted markdown, cached by content so a repeat read is instant",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_sandbox/fileq"
    },
    "files": [
        "dist",
        "src",
        "!src/testing.ts",
        "!dist/testing.*",
        "NOTICE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "bin": {
        "fileq": "./dist/cli.js"
    },
    "exports": {
        "./NOTICE": "./NOTICE",
        "./formats": {
            "types": "./dist/lib/formats.d.ts",
            "import": {
                "@intentic/src": "./src/lib/formats.ts",
                "default": "./dist/lib/formats.js"
            },
            "require": {
                "@intentic/src": "./src/lib/formats.ts",
                "default": "./dist/lib/formats.js"
            }
        },
        "./sidecar": {
            "types": "./dist/lib/sidecar.d.ts",
            "import": {
                "@intentic/src": "./src/lib/sidecar.ts",
                "default": "./dist/lib/sidecar.js"
            },
            "require": {
                "@intentic/src": "./src/lib/sidecar.ts",
                "default": "./dist/lib/sidecar.js"
            }
        },
        "./derive": {
            "types": "./dist/lib/derive.d.ts",
            "import": {
                "@intentic/src": "./src/lib/derive.ts",
                "default": "./dist/lib/derive.js"
            },
            "require": {
                "@intentic/src": "./src/lib/derive.ts",
                "default": "./dist/lib/derive.js"
            }
        },
        "./skill": {
            "types": "./dist/skill.d.ts",
            "import": {
                "@intentic/src": "./src/skill.ts",
                "default": "./dist/skill.js"
            },
            "require": {
                "@intentic/src": "./src/skill.ts",
                "default": "./dist/skill.js"
            }
        }
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "dependencies": {
        "@intentic/agent-cli": "workspace:*",
        "@intentic/base": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/webq": "workspace:*",
        "@intentic/workspace-ignore": "workspace:*",
        "@stricli/core": "catalog:",
        "exceljs": "catalog:",
        "exifr": "catalog:",
        "fflate": "catalog:",
        "file-type": "catalog:",
        "image-size": "catalog:",
        "mammoth": "catalog:",
        "music-metadata": "catalog:",
        "tslib": "catalog:",
        "unpdf": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:"
    }
}
