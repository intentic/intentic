#!/usr/bin/env node
// The in-sandbox devices command: run a program this sandbox built on one of the owner's connected computers.
//
//   push    carry a build (a file, or a whole folder) to the computer
//   start   start a program there and keep it running (its app_start tool, for a shell)
//   reach   open one of the computer's own loopback ports at the same port here
//   run     all of it from the repository's `.intentic/run.json`: build, push, reach, start (and, attached, follow it)
//   stop    stop a program started there, with the ports opened for it
//   attach  follow a program already running there (Ctrl+C stops it, Ctrl+D leaves it)
//   ports   every port listening in this sandbox, and whose it is
//
// It reads the bytes HERE, in this shell's own view of /work, which is the conversation's own checkout during an
// isolated turn: the build that goes is the one this shell made. The daemon relays everything over the device link and
// holds it to the computers this caller may act on: the ones this conversation's turn reaches, or, in a run the owner
// started from the editor, the one computer that run was started for. The computer decides the rest: it refuses all of
// it unless its "Run programs this sandbox sends" switch is on.
//
// node:http rather than fetch: an upload streams from disk with back-pressure, and a 100 MB build over a tunnel takes
// longer than undici's default timeouts like.

import { spawn, spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { copyFileSync, cpSync, createReadStream, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from "node:fs";
import { request } from "node:http";
import { tmpdir } from "node:os";
import { setTimeout as sleep } from "node:timers/promises";
import { basename, dirname, join, resolve } from "node:path";

const COMMAND = "devices";
const TOKEN_PATH = process.env.INTENTIC_AGENT_TOKEN_PATH ?? "/run/intentic/agent.token";
const PORT = process.env.SANDBOX_PORT ?? "8787";
const CONVERSATION = process.env.INTENTIC_TURN_OWNER ?? "";
// Set by the editor's "Run on <device>" in the terminal it opens (hosts/runs/runs.routes.ts): what lets that run act on its
// one computer.
const RUN_GRANT = process.env.INTENTIC_RUN_GRANT ?? "";
const RUN_FILE = ".intentic/run.json";

const USAGE = `devices — run a program built here on one of the owner's connected computers

  devices run [<target>] [--device <device>] [--no-build] [--repo <dir>] [--attach | --detach] [--replace]
      Everything a repository's ${RUN_FILE} declares for <target> (the only one, when there is one): run its build
      here, carry the result to the computer, stop the target's run already going there, open the ports it says the
      sandbox needs, start it there. Prints the run id the computer's app_status, app_logs and app_stop take, and
      \`devices stop\` does. A target with only a "command" runs in the sandbox (the Run dialog's Sandbox, or Start in
      Browsers), not here.
      While a build runs in the owner's tree, lands into that repository wait for it, so it compiles one version of
      the source; the run records the commit it was built from, which the Run dialog shows.
      From an agent's shell it refuses to replace a run of the target this conversation did not start (the owner's,
      from the Run dialog): ask the owner, then pass --replace.
      --attach stays with the program: prints what it prints, ends when it does, Ctrl+C stops it there and Ctrl+D
      leaves it running. --detach leaves it running and returns at once. Attached is the default in a terminal a
      person types in, detached in an agent's shell.

  devices attach <run-id | target> [--device <device>] [--repo <dir>]
      Follow a program already running on a computer (a run id, or a target's newest running program) as --attach
      does: its last lines, then what it prints. Ctrl+C stops it, Ctrl+D or closing the terminal leaves it running.

  devices stop <run-id | target> [--device <device>] [--force] [--repo <dir>]
      Stop a program started there (a run id), or every running program of a ${RUN_FILE} target, with everything it
      started, and close the ports the sandbox opened for it. The computer is the target's own unless --device names
      one; a run id this sandbox started is found by itself. --force skips asking it to close.

  devices push <device> <path> [--name <name>]
      Copy a file (an .exe, an installer) or a whole folder (a build with its DLLs) to <device>, the computer's name as
      its tools are mounted (mcp__<device>__…). It lands in that computer's runs folder, in a folder named for its
      content; the path printed is what to start. The same build pushed again is not sent twice.

  devices start <device> <program> [--isolated] [--no-network] [--name <name>] [-- <args>…]
      Start a program on <device> (a path push printed, or the .exe inside a pushed folder) and keep it running.
      --isolated runs it inside Windows Sandbox, a throwaway VM (Windows Pro/Enterprise with the feature on).

  devices ports
      Every port listening in this sandbox and whose it is: a conversation's agent (and its job), a terminal, a panel.
      Answers "whose server holds 7878?" without ss or pgrep. A port an agent's own shell or job holds stays off the
      owner's computers (desktop sync does not mirror it) unless the job was left running for them.

  devices reach <device> <port> [--as <port>]      open the computer's 127.0.0.1:<port> at 127.0.0.1:<as|port> here
  devices reach <device> <port> --off              close it
  devices reach --list                             what is open

Exit 0: done; the last line is what to use next. Exit 1: refused (the computer is offline, this caller may not act on
it, its agent is too old, or "Run programs this sandbox sends" is off on its card), or the build failed: say so and
carry on. Exit 2: misuse or a transport failure.`;

const die = (message, code = 2) => {
    // Agents discard stderr, so a failure must survive on the stream they read.
    process.stdout.write(`${COMMAND}: ${message}\n`);
    process.exit(code);
};

const say = (line) => process.stdout.write(`${line}\n`);

let tokenCache;
const token = () => {
    if (tokenCache !== undefined) {
        return tokenCache;
    }
    try {
        tokenCache = readFileSync(TOKEN_PATH, "utf8").trim();
        return tokenCache;
    } catch {
        return die(`no daemon token at ${TOKEN_PATH}: is the intentic daemon running in this container?`);
    }
};

const refusalOf = (text) => {
    try {
        const parsed = JSON.parse(text);
        if (typeof parsed?.error === "string") {
            return parsed.error;
        }
        if (typeof parsed?.message === "string") {
            return parsed.message;
        }
    } catch {
        // allow(silent-catch): not JSON, the raw text is all there is.
    }
    return text || "the daemon did not say why";
};

const hashOf = (path) =>
    new Promise((done, fail) => {
        const hash = createHash("sha256");
        createReadStream(path)
            .on("data", (chunk) => hash.update(chunk))
            .on("error", fail)
            .on("end", () => done(hash.digest("hex")));
    });

// One call to the daemon: `body` is a file path to stream, a JSON value, or undefined.
const call = (method, path, body) =>
    new Promise((done, fail) => {
        const req = request({ host: "127.0.0.1", port: PORT, path, method }, (response) => {
            let raw = "";
            response.on("data", (chunk) => {
                raw += chunk.toString();
            });
            response.on("end", () => done({ status: response.statusCode ?? 502, text: raw }));
        });
        req.on("error", fail);
        req.setHeader("x-intentic-agent", token());
        if (CONVERSATION !== "") {
            req.setHeader("x-intentic-conversation", CONVERSATION);
        }
        if (RUN_GRANT !== "") {
            req.setHeader("x-intentic-run-grant", RUN_GRANT);
        }
        if (body === undefined) {
            req.end();
        } else if (typeof body === "object" && body.file !== undefined) {
            req.setHeader("content-type", "application/octet-stream");
            req.setHeader("content-length", String(statSync(body.file).size));
            createReadStream(body.file).on("error", fail).pipe(req);
        } else {
            const text = JSON.stringify(body);
            req.setHeader("content-type", "application/json");
            req.setHeader("content-length", String(Buffer.byteLength(text)));
            req.end(text);
        }
    });

// The answer as JSON, or the refusal as exit 1.
const answered = async (method, path, body) => {
    const reply = await call(method, path, body).catch((error) => die(`the daemon could not be reached: ${error.message}`));
    if (reply.status < 200 || reply.status >= 300) {
        die(refusalOf(reply.text), 1);
    }
    return JSON.parse(reply.text);
};

const NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/;

// Splits argv into named options and positionals; `--` ends options (what follows is the program's own arguments).
const parse = (args, { flags = [], values = [] }) => {
    const options = {};
    const rest = [];
    let after;
    for (let index = 0; index < args.length; index += 1) {
        const arg = args[index];
        if (arg === "--") {
            after = args.slice(index + 1);
            break;
        }
        if (flags.includes(arg)) {
            options[arg.slice(2)] = true;
        } else if (values.includes(arg)) {
            const value = args[index + 1];
            if (value === undefined) {
                die(`${arg} needs a value`);
            }
            options[arg.slice(2)] = value;
            index += 1;
        } else if (arg.startsWith("--")) {
            die(`unknown option ${arg}`);
        } else {
            rest.push(arg);
        }
    }
    return { options, rest, after: after ?? [] };
};

const deviceRoute = (device, tail) => `/devices/${encodeURIComponent(device)}${tail}`;

// Pushes a file or a folder; answers { path, reused, size, sha256, kind }.
const pushPath = async (device, absolute, name) => {
    let stats;
    try {
        stats = statSync(absolute);
    } catch {
        die(`nothing at ${absolute}`);
    }
    const own = basename(absolute);
    const filed = name ?? own.replace(/[^A-Za-z0-9._-]/g, "-").replace(/^[^A-Za-z0-9]+/, "");
    if (!NAME.test(filed)) {
        die(`"${filed}" cannot name a folder there: pass --name with letters, digits, . - _ (64 at most)`);
    }
    let file = absolute;
    let kind = "file";
    let scratch;
    if (stats.isDirectory()) {
        // A folder travels as one tar, packed here and unpacked there; `tar` is on every computer the agent runs on.
        scratch = mkdtempSync(join(tmpdir(), "devices-push-"));
        file = join(scratch, `${filed}.tar`);
        const packed = spawnSync("tar", ["-cf", file, "-C", absolute, "."], { encoding: "utf8" });
        if (packed.status !== 0) {
            die(`could not pack ${absolute}: ${packed.stderr.trim() || `tar exited ${packed.status}`}`);
        }
        kind = "tar";
    } else if (!stats.isFile()) {
        die(`${absolute} is neither a file nor a folder`);
    }
    try {
        const size = statSync(file).size;
        const sha256 = await hashOf(file);
        const fileName = kind === "tar" ? `${filed}.tar` : own;
        const query = new URLSearchParams({ name: filed, kind, file: fileName, size: String(size), sha256 });
        const route = `${deviceRoute(device, "/artifacts")}?${query}`;
        const known = await answered("POST", `${route}&probe=1`);
        const pushed = typeof known.path === "string" ? known : await answered("POST", route, { file });
        return { path: pushed.path, reused: pushed.reused === true, size, sha256, kind };
    } finally {
        if (scratch !== undefined) {
            rmSync(scratch, { recursive: true, force: true });
        }
    }
};

const pushedLine = (device, pushed) => {
    const megabytes = (pushed.size / 1024 / 1024).toFixed(1);
    return pushed.reused
        ? `${device} already had this build (${megabytes} MB, sha256 ${pushed.sha256.slice(0, 12)}); nothing was sent.`
        : `Pushed ${megabytes} MB to ${device} (sha256 ${pushed.sha256.slice(0, 12)}).`;
};

const push = async (args) => {
    const { options, rest } = parse(args, { values: ["--name"] });
    const [device, source] = rest;
    if (device === undefined || source === undefined || rest.length > 2) {
        die(`push takes a device and a path\n\n${USAGE}`);
    }
    const pushed = await pushPath(device, resolve(source), options.name);
    say(pushedLine(device, pushed));
    say(`${pushed.kind === "tar" ? "Unpacked into" : "Saved as"}: ${pushed.path}`);
};

const startOn = async (device, body) => {
    const started = await answered("POST", deviceRoute(device, "/apps"), body);
    return started.text;
};

const start = async (args) => {
    const { options, rest, after } = parse(args, { flags: ["--isolated", "--no-network"], values: ["--name"] });
    const [device, program] = rest;
    if (device === undefined || program === undefined || rest.length > 2) {
        die(`start takes a device and a program (its arguments after --)\n\n${USAGE}`);
    }
    say(
        await startOn(device, {
            program,
            args: after,
            ...(options.name === undefined ? {} : { name: options.name }),
            ...(options.isolated === true ? { isolated: true } : {}),
            ...(options["no-network"] === true ? { network: false } : {}),
        }),
    );
};

const reach = async (args) => {
    const { options, rest } = parse(args, { flags: ["--list", "--off"], values: ["--as"] });
    if (options.list === true) {
        const { tunnels } = await answered("GET", "/devices/tunnels");
        if (tunnels.length === 0) {
            say("No device port is open here.");
            return;
        }
        for (const tunnel of tunnels) {
            say(`${tunnel.device}:${tunnel.devicePort} → ${tunnel.url}  (since ${tunnel.openedAt})`);
        }
        return;
    }
    const [device, portText] = rest;
    const port = Number(portText);
    if (device === undefined || !Number.isInteger(port) || port < 1 || port > 65535 || rest.length > 2) {
        die(`reach takes a device and a port\n\n${USAGE}`);
    }
    if (options.off === true) {
        const { closed } = await answered("DELETE", deviceRoute(device, `/tunnels/${port}`));
        say(closed ? `Closed ${device}:${port}.` : `${device}:${port} was not open.`);
        return;
    }
    const local = options.as === undefined ? undefined : Number(options.as);
    const tunnel = await answered("POST", deviceRoute(device, "/tunnels"), { port, ...(local === undefined ? {} : { as: local }) });
    say(`${device}'s 127.0.0.1:${tunnel.devicePort} answers here at ${tunnel.url} (until the daemon restarts, or --off).`);
};

// Whose each listening port is (the daemon's ports list, ports/ports.routes.ts), one line each.
const ports = async () => {
    const { ports: listed } = await answered("GET", "/ports");
    const shown = listed.filter((port) => port.kind === "workspace");
    if (shown.length === 0) {
        say("Nothing of anyone's work is listening in this sandbox.");
        return;
    }
    for (const port of shown.toSorted((a, b) => a.port - b.port)) {
        const owner = port.job ?? port.owner;
        const whose =
            owner !== undefined
                ? `conversation ${owner.conversationId}${owner.label === undefined ? "" : `, job "${owner.label}"`}`
                : port.origin === "terminal"
                  ? "a terminal of the owner's"
                  : port.origin === "panel"
                    ? "a panel"
                    : port.session === undefined
                      ? "no terminal this sandbox knows"
                      : `terminal session ${port.session}`;
        const where = port.owner !== undefined && port.job === undefined ? "stays in the sandbox" : "mirrored to the owner's computers by desktop sync";
        say(`${String(port.port).padEnd(5)}  ${port.title}  · ${whose} · ${where}${port.forwarded ? ` · public at ${port.previewUrl ?? "its forward"}` : ""}`);
        if (port.command !== undefined) {
            say(`       ${port.command.slice(0, 160)}`);
        }
    }
};

// --- run: the repository's declared targets ----------------------------------------------------------------------

const repoRoot = (given) => {
    if (given !== undefined) {
        return resolve(given);
    }
    const top = spawnSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" });
    return top.status === 0 ? top.stdout.trim() : process.cwd();
};

// The file's shape as schemas/run-targets.ts declares it, checked here by hand: this command runs before any package is
// installed, so it carries no validator. What the daemon lists in the editor is checked by the schema itself.
const targetsOf = (root) => {
    const path = join(root, RUN_FILE);
    if (!existsSync(path)) {
        die(`${root} declares nothing to run: there is no ${RUN_FILE} (see \`devices --help\`, or push and start by hand)`);
    }
    let parsed;
    try {
        parsed = JSON.parse(readFileSync(path, "utf8"));
    } catch (error) {
        die(`${path} is not JSON: ${error.message}`);
    }
    const targets = Array.isArray(parsed?.targets) ? parsed.targets : die(`${path} has no "targets" list`);
    for (const [index, target] of targets.entries()) {
        const where = `${path}: targets[${index}]`;
        if (typeof target?.name !== "string" || !NAME.test(target.name)) {
            die(`${where} needs a "name" of letters, digits, . - _`);
        }
        // A target with only a `command` runs in the sandbox (Start, the Run dialog's Sandbox), never through this command.
        const artifact = target.artifact;
        if (artifact === undefined && typeof target.command !== "string") {
            die(`${where} needs a "command" (to run in the sandbox) or an "artifact" (to run on a computer)`);
        }
        const paths = typeof artifact === "string" ? [artifact] : artifact !== null && typeof artifact === "object" ? Object.values(artifact) : [];
        if (
            artifact !== undefined &&
            (paths.length === 0 || paths.some((entry) => typeof entry !== "string" || entry.startsWith("/") || entry.split(/[\\/]/).includes("..")))
        ) {
            die(`${where} needs an "artifact": a path inside the repository, or an object of name → path`);
        }
        for (const key of ["build", "command", "device", "program", "description"]) {
            if (target[key] !== undefined && typeof target[key] !== "string") {
                die(`${where}.${key} must be text`);
            }
        }
        if (target.args !== undefined && !(Array.isArray(target.args) && target.args.every((arg) => typeof arg === "string"))) {
            die(`${where}.args must be a list of text`);
        }
        if (target.reach !== undefined && !(Array.isArray(target.reach) && target.reach.every((port) => Number.isInteger(port) && port > 0 && port < 65536))) {
            die(`${where}.reach must be a list of port numbers`);
        }
        if (target.stopGraceSeconds !== undefined && !(Number.isInteger(target.stopGraceSeconds) && target.stopGraceSeconds >= 1 && target.stopGraceSeconds <= 600)) {
            die(`${where}.stopGraceSeconds must be a whole number of seconds, 1 to 600`);
        }
    }
    return targets;
};

// What is pushed: the declared file or folder as it is, or a set of files gathered into a scratch folder under their
// own names (the folder name is the target's).
const stage = (root, target) => {
    if (typeof target.artifact === "string") {
        return { path: join(root, target.artifact), scratch: undefined };
    }
    const scratch = mkdtempSync(join(tmpdir(), "devices-run-"));
    const folder = join(scratch, target.name);
    for (const [name, rel] of Object.entries(target.artifact)) {
        const from = join(root, rel);
        if (!existsSync(from)) {
            rmSync(scratch, { recursive: true, force: true });
            die(`${target.name}'s artifact "${name}" is not there: ${from}${target.build === undefined ? "" : " (did its build make it?)"}`, 1);
        }
        const to = join(folder, name);
        mkdirSync(dirname(to), { recursive: true });
        // A folder (resources an app reads beside itself) is copied whole.
        if (statSync(from).isDirectory()) {
            cpSync(from, to, { recursive: true });
        } else {
            copyFileSync(from, to);
        }
    }
    return { path: folder, scratch };
};

// The program inside a pushed folder: the one the target names, or the folder's only .exe.
const programIn = (pushedPath, localFolder, target) => {
    const separator = pushedPath.includes("\\") ? "\\" : "/";
    let program = target.program;
    if (program === undefined) {
        const exes = readdirSync(localFolder).filter((entry) => entry.toLowerCase().endsWith(".exe"));
        if (exes.length !== 1) {
            die(`${target.name} carries a folder; say which file in it to start with "program" (it holds ${readdirSync(localFolder).slice(0, 8).join(", ")})`);
        }
        program = exes[0];
    }
    return `${pushedPath.replace(/[\\/]$/, "")}${separator}${program.replace(/[\\/]/g, separator)}`;
};

const run = async (args) => {
    const { options, rest } = parse(args, { flags: ["--no-build", "--attach", "--detach", "--replace"], values: ["--device", "--repo"] });
    if (options.attach === true && options.detach === true) {
        die("--attach and --detach: pick one");
    }
    // A person at a terminal watches the program; an agent's shell gets its line back and reads the log when it wants.
    // An agent's commands run in a tmux pane too, so a terminal on stdin is not enough: its turn's stamp says whose.
    const attach = options.attach === true || (options.detach !== true && process.stdin.isTTY === true && CONVERSATION === "");
    const root = repoRoot(options.repo);
    // Only the targets that carry something to a computer; the sandbox's own are Start's.
    const targets = targetsOf(root).filter((entry) => entry.artifact !== undefined);
    const [wanted] = rest;
    const target = wanted === undefined ? (targets.length === 1 ? targets[0] : undefined) : targets.find((entry) => entry.name === wanted);
    if (target === undefined) {
        const sandboxOnly = wanted !== undefined && targetsOf(root).some((entry) => entry.name === wanted);
        die(
            sandboxOnly
                ? `${wanted} runs in the sandbox only (it has a "command" and no "artifact"): start it from the Run dialog or the Browsers view, or run its command here`
                : `${wanted === undefined ? "which target?" : `no target called "${wanted}"`} ${RUN_FILE} declares for computers: ${targets.map((entry) => entry.name).join(", ") || "none"}`,
        );
    }
    const device = options.device ?? target.device;
    if (device === undefined) {
        die(`${target.name} names no device: pass --device <name>`);
    }
    if (options.replace !== true) {
        await refuseReplacingAnothers(device, target);
    }
    const builtFrom = target.build !== undefined && options["no-build"] !== true ? await build(root, target, device) : undefined;
    const staged = stage(root, target);
    let programPath;
    try {
        say(`▸ pushing to ${device}`);
        const pushed = await pushPath(device, staged.path, target.name);
        say(pushedLine(device, pushed));
        programPath = pushed.kind === "tar" ? programIn(pushed.path, staged.path, target) : pushed.path;
    } finally {
        if (staged.scratch !== undefined) {
            rmSync(staged.scratch, { recursive: true, force: true });
        }
    }
    // The run already going (it holds the port this one would listen on) stops only now that the new build is
    // there, so a failed build leaves it running.
    await stopNamed(device, target.name);
    for (const port of target.reach ?? []) {
        const tunnel = await answered("POST", deviceRoute(device, "/tunnels"), { port });
        say(`▸ ${device}'s port ${port} answers here at ${tunnel.url}`);
    }
    say(`▸ starting ${programPath}${target.isolated === true ? " inside Windows Sandbox" : ""}`);
    const started = await answered("POST", deviceRoute(device, "/apps"), {
        program: programPath,
        name: target.name,
        args: target.args ?? [],
        // The repository as the editor names it, when the editor started this run; else the folder's own name.
        repo: process.env.INTENTIC_RUN_REPO ?? basename(root),
        ...(target.reach === undefined || target.reach.length === 0 ? {} : { reach: target.reach }),
        ...(target.env === undefined ? {} : { env: target.env }),
        ...(target.isolated === true ? { isolated: true } : {}),
        ...(target.stopGraceSeconds === undefined ? {} : { stopGraceSeconds: target.stopGraceSeconds }),
        ...(builtFrom === undefined ? {} : { builtFrom }),
    });
    say(started.text);
    if (started.ended === true) {
        die(`${target.name} fell over as it started; nothing is running`, 1);
    }
    if (attach && typeof started.id === "string") {
        await follow(device, started.id);
    } else if (typeof started.id === "string") {
        say(`Stop it with: devices stop ${started.id} --device ${device}`);
    }
};

// --- the build: one version of the source, and what it was built from ----------------------------------------------

// The tree as git sees it: HEAD, how many paths are uncommitted, and a print of them that changes when any of their
// contents does (a land rewrites the files it carries; so does an edit). Read without git's optional locks, so it never
// takes index.lock from a land writing this tree. Undefined outside a git repository.
const treeState = (root) => {
    const env = { ...process.env, GIT_OPTIONAL_LOCKS: "0" };
    const head = spawnSync("git", ["-C", root, "rev-parse", "HEAD"], { encoding: "utf8", env });
    if (head.status !== 0) {
        return undefined;
    }
    const status = spawnSync("git", ["-C", root, "status", "--porcelain=v1", "-z", "-uall"], { encoding: "utf8", env, maxBuffer: 256 * 1024 * 1024 });
    if (status.status !== 0) {
        return undefined;
    }
    const entries = status.stdout.split("\0").filter((entry) => entry !== "");
    const paths = [];
    for (let index = 0; index < entries.length; index += 1) {
        const entry = entries[index];
        paths.push(entry.slice(3));
        // A rename or copy is followed by its source path, without a status of its own.
        if (entry[0] === "R" || entry[0] === "C") {
            index += 1;
        }
    }
    const print = createHash("sha256").update(head.stdout).update(status.stdout);
    for (const path of paths) {
        try {
            const stats = statSync(join(root, path));
            print.update(`${path}\0${stats.mtimeMs}\0${stats.size}\0`);
        } catch {
            // allow(silent-catch): a path git lists as deleted has no stats; its status line is already in the print.
            print.update(`${path}\0gone\0`);
        }
    }
    return { commit: head.stdout.trim(), changed: paths.length, print: print.digest("hex") };
};

// While the build runs in the owner's tree, the daemon holds lands into that repository (hosts/runs/run-builds.ts);
// renewed while it runs, so a build killed with this command lets lands go within a minute. Undefined when nothing is
// held: an agent's own checkout, which nothing lands into, or a daemon that does not hold builds.
const holdLands = async (root, target, device) => {
    const repo = process.env.INTENTIC_RUN_REPO;
    const reply = await call("POST", "/devices/builds", { dir: root, target: target.name, device, ...(repo === undefined ? {} : { repo }) }).catch(() => undefined);
    if (reply === undefined || reply.status < 200 || reply.status >= 300) {
        return undefined;
    }
    const hold = JSON.parse(reply.text);
    if (hold.held !== true) {
        return undefined;
    }
    const renew = setInterval(() => void call("POST", `/devices/builds/${encodeURIComponent(hold.id)}/renew`).catch(() => undefined), hold.renewEveryMs ?? 20_000);
    return {
        repo: hold.repo,
        release: async () => {
            clearInterval(renew);
            const done = await call("DELETE", `/devices/builds/${encodeURIComponent(hold.id)}`).catch(() => undefined);
            return done === undefined || done.status !== 200 ? undefined : JSON.parse(done.text);
        },
    };
};

// The build's own process, its output on this terminal. Asynchronous, so the hold above is renewed while it compiles;
// Ctrl+C reaches the build (it shares the terminal) and ends it, which reads here as a failed build.
const runBuild = (root, command) =>
    new Promise((done) => {
        const child = spawn("sh", ["-c", command], { cwd: root, stdio: "inherit" });
        const ignore = () => undefined;
        process.on("SIGINT", ignore);
        const hangUp = () => child.kill("SIGHUP");
        process.on("SIGHUP", hangUp);
        process.on("SIGTERM", hangUp);
        const settle = (status, signal) => {
            process.off("SIGINT", ignore);
            process.off("SIGHUP", hangUp);
            process.off("SIGTERM", hangUp);
            done({ status, signal });
        };
        child.on("error", (error) => {
            say(`${COMMAND}: could not start the build: ${error.message}`);
            settle(127, null);
        });
        child.on("exit", settle);
    });

// Builds the target, holding lands into the owner's tree while it does, and answers what it was built from.
const build = async (root, target, device) => {
    const before = treeState(root);
    const at = new Date().toISOString();
    const hold = await holdLands(root, target, device);
    if (hold !== undefined) {
        say(`▸ lands into ${hold.repo} wait until this build ends, so it compiles one version of the source`);
    }
    say(`▸ building ${target.name}${before === undefined ? "" : ` from ${before.commit.slice(0, 10)}${before.changed === 0 ? "" : ` + ${before.changed} uncommitted path(s)`}`}: ${target.build}`);
    let built;
    let released;
    try {
        built = await runBuild(root, target.build);
    } finally {
        released = await hold?.release();
    }
    const after = treeState(root);
    const moved = before !== undefined && after !== undefined && before.print !== after.print;
    if ((released?.waited ?? 0) > 0) {
        say(`▸ ${released.waited} land(s) waited for this build and go ahead now`);
    }
    if (moved) {
        const lands = released?.landedDuring ?? 0;
        say(
            `▸ the tree changed while it compiled (${lands > 0 ? `${lands} land(s) reached it` : "edits made outside a land"}): this build may mix two versions of the source; Run again to build one`,
        );
    }
    if (built.status !== 0) {
        die(`the build failed (exit ${built.status ?? built.signal}); nothing was pushed`, 1);
    }
    return before === undefined ? undefined : { commit: before.commit, changed: before.changed, at, ...(moved ? { movedDuringBuild: true } : {}) };
};

// An agent's `devices run` must not replace the owner's run of the target with a build of its own, which may be work
// that has not landed, unless it was told to (--replace). A run this conversation started is its own to replace.
const refuseReplacingAnothers = async (device, target) => {
    if (CONVERSATION === "" || RUN_GRANT !== "") {
        return;
    }
    const { runs } = await answered("GET", deviceRoute(device, "/apps"));
    const own = `conversation ${CONVERSATION}`;
    const theirs = runs.find((entry) => entry.name === target.name && entry.state === "running" && entry.startedBy !== own);
    if (theirs === undefined) {
        return;
    }
    const built = theirs.builtFrom === undefined ? "" : `, built from ${theirs.builtFrom.commit.slice(0, 10)}`;
    die(
        `${target.name} is already running on ${device} (${theirs.id}, started by ${theirs.startedBy ?? "someone other than this conversation"}${built}), and this run would replace it with this conversation's build. Ask the owner first; with their yes, run again with --replace. To look without replacing it: devices attach ${theirs.id} --device ${device}.`,
        1,
    );
};

// --- stop, and following a run --------------------------------------------------------------------------------------

const stoppedLines = (stopped) => stopped.map((entry) => entry.text);

const stopNamed = async (device, name) => {
    const { stopped } = await answered("POST", deviceRoute(device, "/apps/stop"), { name, why: "replace" });
    for (const line of stoppedLines(stopped)) {
        say(`▸ ${line}`);
    }
};

// A run id as the computer mints it: the run's name and six hex digits.
const RUN_ID = /^[A-Za-z0-9._-]+-[0-9a-f]{6}$/;

const stop = async (args) => {
    const { options, rest } = parse(args, { flags: ["--force"], values: ["--device", "--repo"] });
    const [what] = rest;
    if (what === undefined || rest.length > 1) {
        die(`stop takes a run id or a target\n\n${USAGE}`);
    }
    if (RUN_ID.test(what)) {
        const device = options.device ?? (await answered("GET", `/devices/runs?${new URLSearchParams({ id: what })}`)).device;
        const { stopped } = await answered("POST", deviceRoute(device, "/apps/stop"), { id: what, why: "stop", ...(options.force === true ? { force: true } : {}) });
        stoppedLines(stopped).forEach(say);
        return;
    }
    const root = repoRoot(options.repo);
    const declared = existsSync(join(root, RUN_FILE)) ? targetsOf(root).find((entry) => entry.name === what) : undefined;
    const device = options.device ?? declared?.device;
    if (device === undefined) {
        die(`${declared === undefined ? `"${what}" is neither a run id nor a target ${RUN_FILE} declares` : `${what} names no device`}: pass --device <name>`);
    }
    const { stopped } = await answered("POST", deviceRoute(device, "/apps/stop"), { name: what, why: "stop" });
    say(stopped.length === 0 ? `Nothing called ${what} was running on ${device}.` : stoppedLines(stopped).join("\n"));
};

const FOLLOW_EVERY_MS = 1000;

// The keys a person following a program types: the terminal hands them over as bytes (raw mode) instead of turning
// Ctrl+C into a SIGINT for every process in the pane. That signal used to reach the pane's `tee` too, which carries what
// this command prints to the screen: it died first, the next line written here failed on the closed pipe, and this
// command could die before its stop left, leaving the program running with nothing on screen saying so.
const CTRL_C = 0x03;
const CTRL_D = 0x04;
const CTRL_BACKSLASH = 0x1c;

// Stays with a program running on a computer, as tmux attach stays with a session: prints what it prints, ends when it
// does (exit 0 when it exited 0 or was stopped), stops it on Ctrl+C, and leaves it running on Ctrl+D or when the
// terminal closes, for `devices attach` (the Run dialog's Terminal) to follow again.
const follow = async (device, id) => {
    // The screen gone (the pane closed, its tee ended) must never cost the stop its request.
    process.stdout.on("error", () => undefined);
    say(`▸ ${id} runs on ${device}, not in this sandbox: this terminal follows what it prints there.`);
    const keys = process.stdin.isTTY === true;
    say(keys ? `  Ctrl+C stops it on ${device} · Ctrl+D leaves it running (the Run dialog's Terminal follows it again)` : `  Ctrl+C stops it on ${device}`);
    let stopping;
    let hinted = false;
    const leave = (why) => {
        say(`\n▸ ${why}: ${id} keeps running on ${device}. Follow it again with the Run dialog's Terminal or devices attach ${id} --device ${device}; stop it with Stop there or devices stop ${id} --device ${device}`);
        process.exit(0);
    };
    const stopIt = () => {
        if (stopping !== undefined) {
            say(`▸ still stopping ${id} on ${device}${keys ? " (Ctrl+D stops waiting and leaves this terminal)" : ""}`);
            return;
        }
        say(`\n▸ stopping ${id} on ${device}: asked to close, forced after 5 seconds if it does not…`);
        stopping = call("POST", deviceRoute(device, "/apps/stop"), { id, why: "interrupt" })
            .then((reply) => {
                if (reply.status >= 200 && reply.status < 300) {
                    say(stoppedLines(JSON.parse(reply.text).stopped).map((line) => `■ ${line}`).join("\n"));
                    process.exit(0);
                }
                say(`${COMMAND}: ${device} did not stop it: ${refusalOf(reply.text)}`);
                say(`${id} may still be running there: the Run dialog says what ${device} reports, and its Stop tries again.`);
                process.exit(1);
            })
            .catch((error) => die(`the daemon could not be reached to stop it (${error.message}); ${id} may still be running on ${device}`, 1));
    };
    if (keys) {
        process.stdin.setRawMode(true);
        process.on("exit", () => {
            try {
                process.stdin.setRawMode(false);
            } catch {
                // allow(silent-catch): the terminal is already gone
            }
        });
        process.stdin.on("data", (chunk) => {
            for (const byte of chunk) {
                if (byte === CTRL_C) {
                    stopIt();
                } else if (byte === CTRL_D || byte === CTRL_BACKSLASH) {
                    leave(stopping === undefined ? "left it" : "stopped waiting");
                } else if (!hinted) {
                    hinted = true;
                    say(`▸ what you type does not reach ${id} on ${device}: Ctrl+C stops it, Ctrl+D leaves it running`);
                }
            }
        });
        process.stdin.resume();
    }
    process.on("SIGINT", stopIt);
    process.on("SIGTERM", stopIt);
    // The terminal closed: a stop already asked for goes on in the daemon whatever happens here.
    process.on("SIGHUP", () => process.exit(0));
    let since;
    let lost = false;
    for (;;) {
        const query = since === undefined ? "?lines=50" : `?since=${since}`;
        const reply = await call("GET", deviceRoute(device, `/apps/${encodeURIComponent(id)}/output${query}`)).catch((error) => ({ status: 0, text: error.message }));
        if (stopping !== undefined) {
            await sleep(FOLLOW_EVERY_MS);
            continue;
        }
        if (reply.status === 403) {
            die(`${refusalOf(reply.text)}\n${id} keeps running on ${device}; stop it from the Run dialog or with devices stop ${id} --device ${device}`, 1);
        }
        if (reply.status >= 200 && reply.status < 300) {
            const output = JSON.parse(reply.text);
            if (lost) {
                say(`▸ ${device} answers again`);
                lost = false;
            }
            for (const line of output.lines) {
                say(line);
            }
            since = output.total;
            if (output.run !== undefined && output.run.state === "ended") {
                say(`■ ${id} ${output.run.said}`);
                process.exit(output.run.exitCode === undefined || output.run.exitCode === 0 ? 0 : 1);
            }
        } else if (!lost) {
            say(`▸ lost sight of ${id} for now (${refusalOf(reply.text)}); still watching`);
            lost = true;
        }
        await sleep(FOLLOW_EVERY_MS);
    }
};

// Follows a program already running there: a run id, or the newest running program of a run-targets target.
const attach = async (args) => {
    const { options, rest } = parse(args, { values: ["--device", "--repo"] });
    const [what] = rest;
    if (what === undefined || rest.length > 1) {
        die(`attach takes a run id or a target\n\n${USAGE}`);
    }
    if (RUN_ID.test(what)) {
        const device = options.device ?? (await answered("GET", `/devices/runs?${new URLSearchParams({ id: what })}`)).device;
        await follow(device, what);
        return;
    }
    const root = repoRoot(options.repo);
    const declared = existsSync(join(root, RUN_FILE)) ? targetsOf(root).find((entry) => entry.name === what) : undefined;
    const device = options.device ?? declared?.device;
    if (device === undefined) {
        die(`${declared === undefined ? `"${what}" is neither a run id nor a target ${RUN_FILE} declares` : `${what} names no device`}: pass --device <name>`);
    }
    const { runs } = await answered("GET", deviceRoute(device, "/apps"));
    const running = runs.find((run) => run.name === what && run.state === "running");
    if (running === undefined) {
        die(`nothing called ${what} is running on ${device}`, 1);
    }
    await follow(device, running.id);
};

const [verb, ...args] = process.argv.slice(2);
if (verb === undefined || verb === "--help" || verb === "-h" || verb === "help") {
    say(USAGE);
    process.exit(verb === undefined ? 2 : 0);
}
const verbs = { push, start, reach, run, stop, attach, ports };
if (verbs[verb] === undefined) {
    die(`unknown command "${verb}"\n\n${USAGE}`);
}
await verbs[verb](args);
