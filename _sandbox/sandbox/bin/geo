#!/usr/bin/env node
// The in-sandbox geo-exit command — what the agent's skill teaches and what an owner can run in a terminal tab.
//
// CALLED `geo`, NOT `exit`, and that is not a style choice: `exit` is a shell BUILTIN in bash, sh, zsh and
// every other shell this runs in, so a binary of that name is unreachable from a command line. `exit list`
// does not run it; it exits the shell, and inside `bash -c` it fails with "numeric argument required". The
// capability, the routes and the manifest entry are all still `exit`, because there the word is a noun and
// nothing shadows it. Only the command had to move.
//
// It deliberately owns NO exit logic: every subcommand is one call to the daemon's /exit routes, which are the
// same routes the browser's Geo exit card drives. That is the whole point — an exit the agent moves appears in
// the UI, one the user stops disappears for the agent, and there is exactly one implementation of what
// switching country means (see _sandbox/sandbox/src/exit/).
//
// Auth is the per-boot agent token from /run/intentic/agent.token, which auth/grants.ts admits to /exit. So
// this command can operate the pools the owner configured, and cannot read the credentials behind them.

import { readFileSync } from "node:fs";

const TOKEN_PATH = "/run/intentic/agent.token";
const base = `http://127.0.0.1:${process.env.SANDBOX_PORT ?? "8787"}`;

const USAGE = `geo — make requests come out of another country

  geo list                     every configured exit with its live state
  geo countries <name>         where this exit can come out, best-supplied first
  geo use <name> [CC]          switch country (starts it if down); CC omitted = provider's choice
  geo rotate <name>            a different address in the same country
  geo ip <name>                what the world sees through it right now
  geo proxy <name>             the proxy URL, for curl and ALL_PROXY
  geo start <name>             bring it up at its stored country
  geo stop <name>              take it down

  --json                        machine-readable output for list/countries/ip

Nothing is proxied unless you point it at the proxy:
  curl --proxy "$(geo proxy NAME)" https://example.com/

Exits are configured by the sandbox owner under Capabilities ▸ Geo exit.`;

const die = (message) => {
    process.stderr.write(`${message}\n`);
    process.exit(1);
};

// Read lazily, not at startup: `exit --help` has to work in any shell, including one where the daemon isn't
// running yet — only an actual call needs the token.
const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return die(`geo: no daemon token at ${TOKEN_PATH} — is the intentic daemon running in this container?`);
    }
};

const call = async (path, init = {}) => {
    const response = await fetch(`${base}${path}`, {
        ...init,
        headers: { "x-intentic-agent": token(), ...(init.body === undefined ? {} : { "content-type": "application/json" }), ...init.headers },
    }).catch((error) => die(`geo: cannot reach the daemon at ${base} (${error.message})`));
    return response;
};

// A non-2xx from the daemon carries its own message — surface that rather than a bare status code.
const failure = async (response) => {
    const body = await response.json().catch(() => null);
    return body?.message ?? body?.error ?? `request failed (${response.status})`;
};

const readJson = async (path, init) => {
    const response = await call(path, init);
    if (!response.ok) {
        die(`geo: ${await failure(response)}`);
    }
    return response.json();
};

const ago = (since) => {
    if (typeof since !== "number") {
        return undefined;
    }
    const minutes = Math.max(0, Math.round((Date.now() - since) / 60000));
    if (minutes < 60) {
        return `${minutes}m`;
    }
    const hours = Math.floor(minutes / 60);
    return hours < 24 ? `${hours}h ${minutes % 60}m` : `${Math.floor(hours / 24)}d ${hours % 24}h`;
};

const STATE_MARK = { up: "●", starting: "◐", down: "○", unavailable: "◌", failed: "✕" };

// The country ASKED for and the country SEEN are rendered separately and never merged, because them
// disagreeing is the single most useful fault signal an exit has.
const renderLink = (link) => {
    const mismatch = link.country && link.observedCountry && link.country !== link.observedCountry;
    const head = `${STATE_MARK[link.state] ?? "○"} ${link.id}  ${link.state}  (${link.provider}${link.country ? ` · wants ${link.country}` : ""})`;
    const facts = [
        link.ip ? `${mismatch ? "⚠ " : ""}${link.observedCountry ?? "??"} ${link.ip}` : undefined,
        ago(link.checkedAt) ? `checked ${ago(link.checkedAt)} ago` : undefined,
        link.state === "up" ? `proxy ${link.proxy}` : undefined,
        ago(link.since) ? `up ${ago(link.since)}` : undefined,
        link.autoStart ? "auto-start" : undefined,
    ].filter(Boolean);
    return [
        head,
        ...(facts.length > 0 ? [`    ${facts.join(" · ")}`] : []),
        ...(mismatch ? [`    ⚠ asked for ${link.country}, coming out of ${link.observedCountry}`] : []),
        ...(link.detail ? [`    ${link.detail}`] : []),
    ].join("\n");
};

// The daemon streams a move as SSE `data: <json>` frames (the shared IntenticLine shape). Printed as they
// arrive so a slow start shows progress instead of silence, and an error frame ends the command non-zero.
const stream = async (path, body) => {
    const response = await call(path, { method: "POST", body: JSON.stringify(body ?? {}) });
    if (!response.ok || response.body === null) {
        die(`geo: ${await failure(response)}`);
    }
    let buffer = "";
    let failed;
    for await (const chunk of response.body) {
        buffer += Buffer.from(chunk).toString("utf8");
        // SSE frames are blank-line separated; keep the trailing partial in the buffer.
        const frames = buffer.split("\n\n");
        buffer = frames.pop() ?? "";
        for (const frame of frames) {
            const data = frame
                .split("\n")
                .filter((line) => line.startsWith("data:"))
                .map((line) => line.slice(5).trim())
                .join("");
            if (data === "") {
                continue;
            }
            let line;
            try {
                line = JSON.parse(data);
            } catch {
                continue;
            }
            if (line.kind === "error") {
                failed = line.message ?? "the exit did not move";
            } else if (typeof line.message === "string") {
                process.stdout.write(`${line.message}\n`);
            }
        }
    }
    if (failed !== undefined) {
        die(`geo: ${failed}`);
    }
};

const COMMANDS = ["list", "countries", "use", "rotate", "ip", "proxy", "start", "stop"];

const main = async () => {
    const argv = process.argv.slice(2);
    const json = argv.includes("--json");
    const positional = argv.filter((arg) => !arg.startsWith("--"));
    const [command, name, country] = positional;

    if (command === undefined || command === "help" || argv.includes("--help") || argv.includes("-h")) {
        process.stdout.write(`${USAGE}\n`);
        return;
    }
    // Reject an unknown verb BEFORE the name check below, so a typo reads as a typo rather than as a missing
    // argument to a command that doesn't exist.
    if (!COMMANDS.includes(command)) {
        die(`geo: unknown command "${command}"\n\n${USAGE}`);
    }

    if (command === "list") {
        const { links } = await readJson("/exit");
        if (json) {
            process.stdout.write(`${JSON.stringify(links, null, 2)}\n`);
            return;
        }
        process.stdout.write(
            links.length === 0
                ? "No exits configured. The sandbox owner adds them under Capabilities ▸ Geo exit.\n"
                : `${links.map(renderLink).join("\n")}\n`,
        );
        return;
    }

    if (name === undefined) {
        die(`geo: ${command} needs an exit name — run \`geo list\` to see them.`);
    }
    const at = `/exit/${encodeURIComponent(name)}`;

    if (command === "countries") {
        const { countries, live } = await readJson(`${at}/countries`);
        if (json) {
            process.stdout.write(`${JSON.stringify(countries, null, 2)}\n`);
            return;
        }
        if (countries.length === 0) {
            die(`geo: ${name} has no countries to offer. For a bring-your-own exit, paste a .conf into its capability.`);
        }
        // `share` is printed because a country list without capacity is misleading: a third of Tor's countries
        // are one overloaded relay, and picking one of those looks like a broken exit rather than a thin one.
        const rows = countries.map((point) => {
            const share = typeof point.share === "number" ? ` ${(point.share * 100).toFixed(1)}%` : "";
            return `  ${point.country}  ${point.countryName.padEnd(24)} ${String(point.servers).padStart(5)} servers${share}`;
        });
        process.stdout.write(`${[...rows, live ? "" : "  (provider unreachable — this is a cached/baked list, not today's)"].filter(Boolean).join("\n")}\n`);
        return;
    }

    if (command === "proxy") {
        const { links } = await readJson("/exit");
        const link = links.find((candidate) => candidate.id === name);
        if (link === undefined) {
            die(`geo: no exit named "${name}" — run \`geo list\` to see them.`);
        }
        if (link.state !== "up") {
            die(`geo: ${name} is ${link.state}. Start it first: geo start ${name}`);
        }
        process.stdout.write(`${link.proxy}\n`);
        return;
    }

    if (command === "ip") {
        const seen = await readJson(`${at}/check`, { method: "POST", body: "{}" });
        process.stdout.write(json ? `${JSON.stringify(seen, null, 2)}\n` : `${seen.ip}${seen.countryName ? ` · ${seen.countryName}` : ""}\n`);
        return;
    }

    if (command === "stop") {
        const response = await call(`${at}/stop`, { method: "POST", body: "{}" });
        if (!response.ok) {
            die(`geo: ${await failure(response)}`);
        }
        process.stdout.write(`Stopped ${name}.\n`);
        return;
    }

    if (command === "use") {
        if (country !== undefined && !/^[A-Za-z]{2}$/.test(country)) {
            die(`geo: "${country}" is not a country code. Use two letters, like DE — run \`geo countries ${name}\` to see them.`);
        }
        await stream(`${at}/use`, country === undefined ? {} : { country: country.toUpperCase() });
        return;
    }

    await stream(`${at}/${command}`, {});
};

await main();
