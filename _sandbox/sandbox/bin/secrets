#!/usr/bin/env node
// The in-sandbox secrets command — how an agent asks the owner for a secret the task needs, finds out which stored
// secrets and connected accounts the owner put behind a NAMED PERSON, and asks one of them to release one.
//
// WHY `gates` EXISTS AT ALL, when a gated secret already announces itself. A gated SECRET is discovered by using
// it: write its reference into a command and the exit parks on a card, so the model learns the rule by
// tripping over it. A gated ACCOUNT cannot work that way — a browser profile, a connector's environment and
// an MCP server are all mounted before the turn starts, so a gated one is simply ABSENT, and absence reads to
// a model as "not connected". That is the wrong conclusion and an expensive one: it goes looking for another
// road, or tells the user to connect something that is already connected. `secrets gates` is how it can tell
// the difference, and `secrets request` is the door.
//
// The release covers the rest of the conversation, and a connected account is mounted from the NEXT turn — there
// is no way to sign a browser profile into a turn that is already running. As a need (docs/architecture/needs.md)
// the release survives the turn that asked: the approver may answer an hour later, and the conversation is
// continued with the account mounted.
//
// `secrets ask` is the other door: a secret that does not exist yet (an API key the task needs). It raises a card
// with one masked field; the person pastes the value there, it goes straight to the store the reference resolves
// from, and the command answers with the reference to write. The value never passes through this command.
//
// `secrets generate` needs nobody: a value the task can make for itself (a session key, a signing secret) is made and
// kept by the daemon, and the command answers with the reference and the length, never the value.
//
// Auth is the per-boot agent token; auth/grants.ts admits it to the names-only gate read and the needs door. Never
// to anything that returns a value: the whole point of the reference machinery is that the model never holds one.

import { call, die, parseArgs, raise, refusalOf, WAIT_HELP } from "./needs-cli.mjs";

const COMMAND = "secrets";

const USAGE = `secrets — secrets the task needs, and which credentials need a person's approval

  secrets ask <NAME> [--where "…"] [--link <url>] [--hint "…"] [--replace] [--why "…"] [--wait <seconds>]
                                             ask the owner, on a card in this chat, for a secret that is not stored
                                             yet: they paste it into the card, and you write its reference
                                             ({{secret:<NAME>}}) where it goes. --where: how it will be used;
                                             --link: where they get one (https); --hint: what a valid one looks
                                             like; --replace: one is stored under this name but is being refused
  secrets generate <NAME> [--bytes <16..128>] [--format hex|base64url|alnum]
                                             make a random secret nobody has to find or paste (a session key, a
                                             signing secret, a password this task sets up itself) and store it; you
                                             get its reference ({{secret:<NAME>}}), never its value. 32 bytes of hex
                                             unless the reader wants another length or alphabet
  secrets gates                              what is gated, and who can release each one
  secrets request <subject> [--why "…"] [--wait <seconds>]
                                             ask those people, on a card in this chat, to release a gated account or
                                             connector for the rest of this conversation; it mounts from the NEXT
                                             turn, and the conversation is continued with it

Never ask for a secret in chat: its value would sit in the transcript. A gated connected account is not loaded into
your turn at all, so it looks like it is not connected — check \`secrets gates\` before concluding that. A gated SECRET
needs no request: write its reference into the command you actually want to run, and the approval card goes up for
that one use.

${WAIT_HELP}`;

const gates = async () => {
    const { status, text } = await call(COMMAND, "GET", "/secrets/gates");
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    const { gates: list } = JSON.parse(text);
    if (!Array.isArray(list) || list.length === 0) {
        // An approver gate is only ONE of the two ways an account goes missing. The other is the turn itself: one
        // nobody started acts as no one and loads no signed-in account. Naming it here saves the search.
        process.stdout.write("Nothing here needs a person's approval.\n");
        process.stdout.write(
            "If an account's skill or tools are refused anyway, this turn was probably started by nobody: an unattended turn\n" +
                "reaches no signed-in account, and that is per turn, not something to ask for here. Your turn's own notes say so when\n" +
                "it applies. Finish what does not need the account and say which one the rest was waiting on.\n",
        );
        return;
    }
    for (const gate of list) {
        // Said in words rather than printed as the enum, because it changes what the agent does.
        const scope = gate.scope === "conversation" ? "released for the rest of a conversation" : "asked again on every use";
        const what = gate.kind === "capability" ? "connected account" : "secret";
        process.stdout.write(`${gate.subject} (${what}) — ${gate.approvers.join(" or ")} can release it; ${scope}\n`);
    }
};

const askFor = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["why", "where", "link", "hint", "wait"], switches: ["replace"] });
    const [name] = rest;
    if (name === undefined) {
        return die(COMMAND, USAGE);
    }
    await raise(
        COMMAND,
        {
            kind: "secret",
            name,
            ...(flags.where === undefined ? {} : { where: flags.where }),
            ...(flags.link === undefined ? {} : { link: flags.link }),
            ...(flags.hint === undefined ? {} : { hint: flags.hint }),
            ...(flags.replace === true ? { replace: true } : {}),
        },
        flags,
    );
};

// No person and no card: making a value grants nothing, and it is stored where the owner's Secrets view lists it. The
// value never comes back, only where to write the reference and how long it is.
const generate = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["bytes", "format"] });
    const [name] = rest;
    if (name === undefined) {
        return die(COMMAND, USAGE);
    }
    const bytes = flags.bytes === undefined ? undefined : Number(flags.bytes);
    if (bytes !== undefined && !Number.isInteger(bytes)) {
        return die(COMMAND, `--bytes takes a whole number from 16 to 128, not "${flags.bytes}"`);
    }
    const body = { key: name, ...(bytes === undefined ? {} : { bytes }), ...(flags.format === undefined ? {} : { format: flags.format }) };
    const { status, text } = await call(COMMAND, "POST", "/secrets/generate", JSON.stringify(body));
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    const made = JSON.parse(text);
    process.stdout.write(
        `Stored a new random secret as ${made.key} (${made.length} characters). Write {{secret:${made.key}}} wherever it goes: ` +
            "a command substitutes it at execution, and in a file keep the reference itself.\n",
    );
};

const requestRelease = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["why", "wait"] });
    const [subject] = rest;
    if (subject === undefined) {
        return die(COMMAND, USAGE);
    }
    await raise(COMMAND, { kind: "release", subject }, flags);
};

const main = async () => {
    const [command, ...rest] = process.argv.slice(2);
    if (command === "gates") {
        return gates();
    }
    if (command === "ask") {
        return askFor(rest);
    }
    if (command === "generate") {
        return generate(rest);
    }
    if (command === "request") {
        return requestRelease(rest);
    }
    process.stdout.write(`${USAGE}\n`);
    process.exit(command === undefined || command === "--help" || command === "-h" ? 0 : 1);
};

main().catch((error) => die(COMMAND, error?.message ?? String(error)));
