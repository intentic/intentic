#!/usr/bin/env node
// The in-sandbox secrets command — how an agent asks the owner for a secret the task needs, finds out which stored
// secrets and connected accounts the owner put behind a NAMED PERSON, and asks one of them to release one.
//
// WHY `gates` EXISTS AT ALL, when a gated secret already announces itself. A gated SECRET is discovered by using
// it: write its reference into a command and the exit parks on a card, so the model learns the rule by
// tripping over it. A gated ACCOUNT cannot work that way — a browser profile, a connector's environment and
// an MCP server are all mounted before the turn starts, so a gated one is simply ABSENT, and absence reads to
// a model as "not connected". That is the wrong conclusion and an expensive one: it goes looking for another
// road, or tells the user to connect something that is already connected. `secrets gates` is how it can tell
// the difference, and `secrets request` is the door.
//
// The release covers the rest of the conversation, and a connected account is mounted from the NEXT turn — there
// is no way to sign a browser profile into a turn that is already running. As a need (docs/architecture/needs.md)
// the release survives the turn that asked: the approver may answer an hour later, and the conversation is
// continued with the account mounted.
//
// `secrets ask` is the other door: a secret that does not exist yet (an API key the task needs). It raises a card
// with one masked field; the person pastes the value there, it goes straight to the store the reference resolves
// from, and the command answers with the reference to write. The value never passes through this command.
//
// `secrets generate` needs nobody: a value the task can make for itself (a session key, a signing secret) is made and
// kept by the daemon, and the command answers with the reference and the length, never the value.
//
// A secret can need a person in two ways, and `secrets gates` shows both on one line per secret: a named approver who
// releases it, and its host guard, which, when on, asks a person whenever a use goes off the secret's hosts or cannot be
// read. `secrets hosts` edits the guard. This command runs on the agent's token, so it may turn a guard on or take hosts
// off it, never loosen one on its own say: adding a host or turning a guard off is a card in front of the owner, and the
// call waits for their answer.
//
// Auth is the per-boot agent token; auth/grants.ts admits it to the names-only gate read and the needs door. Never
// to anything that returns a value: the whole point of the reference machinery is that the model never holds one.

import { call, die, parseArgs, raise, refusalOf, WAIT_HELP } from "./needs-cli.mjs";

// The conversation this shell was spawned for, where a card to the owner goes (needs-cli.mjs reads the same variable).
const CONVERSATION = process.env.INTENTIC_TURN_OWNER ?? "";

const COMMAND = "secrets";

const USAGE = `secrets — secrets the task needs, and which credentials need a person's approval

  secrets ask <NAME> [--where "…"] [--link <url>] [--hint "…"] [--replace] [--why "…"] [--wait <seconds>]
                                             ask the owner, on a card in this chat, for a secret that is not stored
                                             yet: they paste it into the card, and you write its reference
                                             ({{secret:<NAME>}}) where it goes. --where: how it will be used;
                                             --link: where they get one (https); --hint: what a valid one looks
                                             like; --replace: one is stored under this name but is being refused
  secrets generate <NAME> [--bytes <16..128>] [--format hex|base64url|alnum]
                                             make a random secret nobody has to find or paste (a session key, a
                                             signing secret, a password this task sets up itself) and store it; you
                                             get its reference ({{secret:<NAME>}}), never its value. 32 bytes of hex
                                             unless the reader wants another length or alphabet
  secrets gates                              what needs a person's approval, one line per secret: who must release
                                             it, and whether its host guard is on and where it may go unasked
  secrets hosts [<NAME>]                     each host guard, or just NAME's; a secret not listed has its guard off
  secrets hosts <NAME> on                    turn NAME's host guard on, with the hosts it had (a connector's own for
                                             its credential); with none, every use asks
  secrets hosts <NAME> add <host>...         put hosts on NAME's guard (exact, or *.domain for every host under it),
                                             turning it on if it was off
  secrets hosts <NAME> remove <host>...      take hosts off NAME's guard; down to none, every use asks
  secrets hosts <NAME> off                   turn NAME's host guard off: it never asks, and keeps its hosts for later
                                             Turning a guard on and taking hosts off need nobody. Adding a host to a
                                             guard that is on, and turning one off, are the owner's: the command puts
                                             a card in front of them and waits for their answer
  secrets request <subject> [--why "…"] [--wait <seconds>]
                                             ask those people, on a card in this chat, to release a gated account or
                                             connector for the rest of this conversation; it mounts from the NEXT
                                             turn, and the conversation is continued with it

A secret whose host guard is on goes by itself only in one plain curl, wget or git command whose every URL is on its
list. Anything else that uses it (a pipe, a variable, a script, another program, another host) asks a person first,
whatever the safety judge says, and an unattended turn is refused. A secret whose guard is off is never asked about for
where it goes.

Never ask for a secret in chat: its value would sit in the transcript. A gated connected account is not loaded into
your turn at all, so it looks like it is not connected — check \`secrets gates\` before concluding that. A gated SECRET
needs no request: write its reference into the command you actually want to run, and the approval card goes up for
that one use.

${WAIT_HELP}`;

const readJson = async (path) => {
    const { status, text } = await call(COMMAND, "GET", path);
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    return JSON.parse(text);
};

const readGuards = async () => {
    const { guards } = await readJson("/secrets/hosts");
    return Array.isArray(guards) ? guards : [];
};

const whatOf = (kind) => (kind === "capability" ? "connected account" : "secret");

// A host guard in words, since on and off change what the agent does next.
const guardWords = (guard) => {
    if (guard === undefined || !guard.guard) {
        const kept = guard === undefined || guard.hosts.length === 0 ? "" : ` (keeps ${guard.hosts.join(", ")} for when it is turned back on)`;
        return `host guard off: never asks where it goes${kept}`;
    }
    const whose = guard.source === "connector" ? ", its connector's hosts" : "";
    return guard.hosts.length === 0
        ? `host guard on${whose}: every use asks a person`
        : `host guard on${whose}: goes unasked only to ${guard.hosts.join(", ")}, anywhere else asks a person`;
};

// A named approver in words.
const gateWords = (gate) =>
    gate === undefined
        ? "no named approver"
        : `${gate.approvers.join(" or ")} must release it, ${gate.scope === "conversation" ? "once for the rest of a conversation" : "again on every use"}`;

const sameSubject = (left, right) => left.subject === right.subject && left.kind === right.kind;

const gates = async () => {
    const [{ gates: list }, guards] = await Promise.all([readJson("/secrets/gates"), readGuards()]);
    const approvals = Array.isArray(list) ? list : [];
    // One line per secret: who must release it, and where it may go.
    const subjects = [...approvals, ...guards.filter((guard) => !approvals.some((gate) => sameSubject(gate, guard)))];
    const asking = subjects.filter((subject) => approvals.some((gate) => sameSubject(gate, subject)) || guards.some((guard) => sameSubject(guard, subject) && guard.guard));
    if (asking.length === 0) {
        // An approver gate is only ONE of the two ways an account goes missing. The other is the turn itself: one
        // nobody started acts as no one and loads no signed-in account. Naming it here saves the search.
        process.stdout.write("Nothing here needs a person's approval.\n");
        process.stdout.write(
            "If an account's skill or tools are refused anyway, this turn was probably started by nobody: an unattended turn\n" +
                "reaches no signed-in account, and that is per turn, not something to ask for here. Your turn's own notes say so when\n" +
                "it applies. Finish what does not need the account and say which one the rest was waiting on.\n",
        );
        return;
    }
    for (const subject of subjects) {
        const gate = approvals.find((entry) => sameSubject(entry, subject));
        const guard = guards.find((entry) => sameSubject(entry, subject));
        process.stdout.write(`${subject.subject} (${whatOf(subject.kind)}) — ${gateWords(gate)}; ${guardWords(guard)}\n`);
    }
};

// What a person types for a host, as the daemon's lists spell it: lowercase, a pasted URL reduced to its host, no port
// and no trailing dot. The daemon refuses anything that is still not a host.
const hostPattern = (raw) => {
    let text = raw.trim().toLowerCase();
    if (/^[a-z][a-z0-9+.-]*:\/\//.test(text)) {
        try {
            text = new URL(text).hostname;
        } catch {
            return text;
        }
    }
    return text.replace(/:\d+$/, "").replace(/\.$/, "");
};

// A vault name (`github/token`) answers to its capability's guard, the same rule a gate follows.
const hostSubject = (name) => (name.includes("/") ? { subject: name.split("/")[0], kind: "capability" } : { subject: name });

const guardFor = (guards, name) => {
    const { subject, kind } = hostSubject(name);
    return guards.find((entry) => entry.subject === subject && (kind === undefined || entry.kind === kind));
};

const listHosts = async (name) => {
    const guards = await readGuards();
    if (name === undefined) {
        if (guards.length === 0) {
            process.stdout.write("No secret has its host guard on: each may be sent anywhere a command takes it.\n");
            return;
        }
        for (const guard of guards) {
            process.stdout.write(`${guard.subject} (${whatOf(guard.kind)}) — ${guardWords(guard)}\n`);
        }
        return;
    }
    const guard = guardFor(guards, name);
    process.stdout.write(`${guard?.subject ?? name}${guard === undefined ? "" : ` (${whatOf(guard.kind)})`} — ${guardWords(guard)}\n`);
};

// The whole new setting an edit asks for, from the one in force now.
const nextGuard = (name, verb, current, hosts) => {
    if (verb === "on" || verb === "off") {
        return { guard: verb === "on", hosts: current.hosts };
    }
    if (hosts.length === 0) {
        return die(COMMAND, `secrets hosts ${name} ${verb} needs at least one host`);
    }
    if (verb === "add") {
        return { guard: true, hosts: [...new Set([...current.hosts, ...hosts])] };
    }
    const missing = hosts.filter((host) => !current.hosts.includes(host));
    if (missing.length > 0) {
        return die(COMMAND, `${missing.join(", ")} ${missing.length === 1 ? "is" : "are"} not on ${name}'s guard (${current.hosts.join(", ") || "it has none"})`);
    }
    return { guard: current.guard, hosts: current.hosts.filter((host) => !hosts.includes(host)) };
};

const editHosts = async (name, verb, args) => {
    const { subject, kind } = hostSubject(name);
    const current = guardFor(await readGuards(), name) ?? { guard: false, hosts: [] };
    const next = nextGuard(name, verb, current, args.map(hostPattern));
    const body = { subject, ...(kind === undefined ? {} : { kind }), ...next, ...(CONVERSATION === "" ? {} : { conversationId: CONVERSATION }) };
    const { status, text } = await call(COMMAND, "PUT", `/secrets/hosts/${encodeURIComponent(subject)}`, JSON.stringify(body));
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    const answer = JSON.parse(text);
    const by = answer.approvedBy === undefined ? "" : ` (approved by ${answer.approvedBy})`;
    process.stdout.write(`${name} — ${guardWords({ ...answer, source: "owner" })}${by}.\n`);
};

const HOST_VERBS = new Set(["on", "off", "add", "remove"]);

const hostsCommand = async (args) => {
    const [name, verb, ...rest] = args;
    if (verb === undefined) {
        return listHosts(name);
    }
    if (!HOST_VERBS.has(verb)) {
        return die(COMMAND, USAGE);
    }
    await editHosts(name, verb, rest);
};

const askFor = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["why", "where", "link", "hint", "wait"], switches: ["replace"] });
    const [name] = rest;
    if (name === undefined) {
        return die(COMMAND, USAGE);
    }
    await raise(
        COMMAND,
        {
            kind: "secret",
            name,
            ...(flags.where === undefined ? {} : { where: flags.where }),
            ...(flags.link === undefined ? {} : { link: flags.link }),
            ...(flags.hint === undefined ? {} : { hint: flags.hint }),
            ...(flags.replace === true ? { replace: true } : {}),
        },
        flags,
    );
};

// No person and no card: making a value grants nothing, and it is stored where the owner's Secrets view lists it. The
// value never comes back, only where to write the reference and how long it is.
const generate = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["bytes", "format"] });
    const [name] = rest;
    if (name === undefined) {
        return die(COMMAND, USAGE);
    }
    const bytes = flags.bytes === undefined ? undefined : Number(flags.bytes);
    if (bytes !== undefined && !Number.isInteger(bytes)) {
        return die(COMMAND, `--bytes takes a whole number from 16 to 128, not "${flags.bytes}"`);
    }
    const body = { key: name, ...(bytes === undefined ? {} : { bytes }), ...(flags.format === undefined ? {} : { format: flags.format }) };
    const { status, text } = await call(COMMAND, "POST", "/secrets/generate", JSON.stringify(body));
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    const made = JSON.parse(text);
    process.stdout.write(
        `Stored a new random secret as ${made.key} (${made.length} characters). Write {{secret:${made.key}}} wherever it goes: ` +
            "a command substitutes it at execution, and in a file keep the reference itself.\n",
    );
};

const requestRelease = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["why", "wait"] });
    const [subject] = rest;
    if (subject === undefined) {
        return die(COMMAND, USAGE);
    }
    await raise(COMMAND, { kind: "release", subject }, flags);
};

const main = async () => {
    const [command, ...rest] = process.argv.slice(2);
    if (command === "gates") {
        return gates();
    }
    if (command === "ask") {
        return askFor(rest);
    }
    if (command === "generate") {
        return generate(rest);
    }
    if (command === "request") {
        return requestRelease(rest);
    }
    if (command === "hosts") {
        return hostsCommand(rest);
    }
    process.stdout.write(`${USAGE}\n`);
    process.exit(command === undefined || command === "--help" || command === "-h" ? 0 : 1);
};

main().catch((error) => die(COMMAND, error?.message ?? String(error)));
