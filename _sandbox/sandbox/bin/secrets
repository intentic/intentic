#!/usr/bin/env node
// The in-sandbox credential-approval command — how an agent finds out which stored secrets and connected
// accounts the owner put behind a NAMED PERSON, and asks one of them to release one.
//
// WHY THIS EXISTS AT ALL, when a gated secret already announces itself. A gated SECRET is discovered by using
// it: write its reference into a command and the exit parks on a card, so the model learns the rule by
// tripping over it. A gated ACCOUNT cannot work that way — a browser profile, a connector's environment and
// an MCP server are all mounted before the turn starts, so a gated one is simply ABSENT, and absence reads to
// a model as "not connected". That is the wrong conclusion and an expensive one: it goes looking for another
// road, or tells the user to connect something that is already connected. `secrets gates` is how it can tell
// the difference, and `secrets request` is the door.
//
// The release covers the rest of the conversation, and a connected account is mounted from the NEXT turn —
// there is no way to sign a browser profile into a turn that is already running. The answer says so.
//
// node:http rather than fetch, deliberately, and for bin/capabilities' reason: a parked `request` holds its
// connection for as long as the approver takes to decide, and undici's default header timeout would kill the
// wait with the card still up.
//
// Auth is the per-boot agent token from /run/intentic/agent.token; auth/grants.ts admits it to exactly these
// two routes under /secrets — the read (names, subjects and approver addresses) and the ask. Never to
// anything that returns a value: the whole point of the reference machinery is that the model never holds one.

import { readFileSync } from "node:fs";
import { request } from "node:http";

const TOKEN_PATH = "/run/intentic/agent.token";
const PORT = process.env.SANDBOX_PORT ?? "8787";

// The conversation this shell was spawned for (platform/leftovers.ts workloadStamp) — what tells the daemon
// WHOSE chat the release card belongs in. The daemon falls back to the sole live turn when it is unset, and
// refuses rather than guessing when there is no live turn at all.
const CONVERSATION = process.env.INTENTIC_TURN_OWNER ?? "";

const USAGE = `secrets — which credentials need a person's approval, and the in-chat ask to release one

  secrets gates                              what is gated, and who can release each one
  secrets request <subject> [--why "…"]      ask those people, on a card in this chat, to release one;
                                             --why is your one-line case for it

A gated connected account is not loaded into your turn at all, so it looks like it is not connected — check
\`secrets gates\` before concluding that. \`request\` raises a card and waits for one of the named people, so
hold the command open rather than timing it out. A release covers the rest of this conversation, and an
account is mounted from the NEXT turn: finish this turn and ask the user to continue.

A gated SECRET needs no request: write its reference into the command you actually want to run, and the
approval card goes up for that one use.`;

const die = (message) => {
    process.stderr.write(`${message}\n`);
    process.exit(1);
};

// Read lazily, not at startup: `secrets --help` has to work in any shell, including one where the daemon
// isn't running yet — only an actual call needs the token.
const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return die(`secrets: no daemon token at ${TOKEN_PATH} — is the intentic daemon running in this container?`);
    }
};

// One loopback call, held open for as long as the daemon holds it — no timeout on purpose (see the header).
const call = (method, path, body) =>
    new Promise((resolve, reject) => {
        const req = request({ host: "127.0.0.1", port: PORT, path, method }, (response) => {
            let raw = "";
            response.on("data", (chunk) => {
                raw += chunk.toString();
            });
            response.on("end", () => resolve({ status: response.statusCode ?? 502, text: raw }));
        });
        req.on("error", reject);
        req.setHeader("x-intentic-agent", token());
        if (CONVERSATION !== "") {
            req.setHeader("x-intentic-conversation", CONVERSATION);
        }
        if (body !== undefined) {
            req.setHeader("content-type", "application/json");
        }
        req.end(body);
    });

// The daemon's refusals arrive as {message} or {error:{message}} — surface the sentence, which is already
// written to be acted on (it names who can release the credential and whether to retry).
const refusalOf = (text) => {
    try {
        const parsed = JSON.parse(text);
        if (typeof parsed?.message === "string") return parsed.message;
        if (typeof parsed?.error === "string") return parsed.error;
        if (typeof parsed?.error?.message === "string") return parsed.error.message;
    } catch {
        // Not JSON — fall through to the raw text.
    }
    return text || "the daemon did not say why";
};

const gates = async () => {
    const { status, text } = await call("GET", "/secrets/gates");
    if (status !== 200) {
        return die(`secrets: ${refusalOf(text)}`);
    }
    const { gates: list } = JSON.parse(text);
    if (!Array.isArray(list) || list.length === 0) {
        process.stdout.write("Nothing here needs a person's approval.\n");
        return;
    }
    for (const gate of list) {
        // `use` asks again on every single use; `conversation` is released once and stands for the rest of
        // this chat. Said in words rather than printed as the enum, because it changes what the agent does.
        const scope = gate.scope === "conversation" ? "released for the rest of a conversation" : "asked again on every use";
        const what = gate.kind === "capability" ? "connected account" : "secret";
        process.stdout.write(`${gate.subject} (${what}) — ${gate.approvers.join(" or ")} can release it; ${scope}\n`);
    }
};

const requestRelease = async (args) => {
    // `--why` can sit anywhere after `request`; what remains is `<subject>`.
    const rest = [];
    let why;
    for (let i = 0; i < args.length; i += 1) {
        if (args[i] === "--why") {
            why = args[i + 1] ?? "";
            i += 1;
        } else {
            rest.push(args[i]);
        }
    }
    const [subject] = rest;
    if (subject === undefined) {
        return die(USAGE);
    }
    const { status, text } = await call(
        "POST",
        "/secrets/request",
        JSON.stringify({ subject, ...(why !== undefined && why !== "" ? { why } : {}) }),
    );
    if (status < 200 || status >= 300) {
        return die(`secrets: ${refusalOf(text)}`);
    }
    const { message } = JSON.parse(text);
    process.stdout.write(`${message ?? text}\n`);
};

const main = async () => {
    const [command, ...rest] = process.argv.slice(2);
    if (command === "gates") {
        return gates();
    }
    if (command === "request") {
        return requestRelease(rest);
    }
    return die(USAGE);
};

main().catch((error) => die(`secrets: ${error?.message ?? error}`));
