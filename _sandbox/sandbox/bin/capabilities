#!/usr/bin/env node
// The in-sandbox capability command: what this sandbox can be connected to, and the ask that puts a card in the
// owner's chat to connect one (docs/architecture/needs.md). The ASK is the whole of it: the daemon answers for THIS
// turn, not for the sandbox, so a connection for a different site, one this conversation's persona or a gate
// withholds, and one whose credential is being refused each get their own answer and their own card, rather than the
// "already connected, use it" that once came back for all three. The agent never connects anything itself and never
// sees a credential: the person does the setup, in the card, and the command resumes when it is live.
//
// Every raising command shares needs-cli.mjs, so this one cannot drift from the route again: bin/needs-cli.test.mjs
// runs it against the contract's own schemas.

import { call, die, parseArgs, raise, refusalOf, WAIT_HELP } from "./needs-cli.mjs";

const COMMAND = "capabilities";

const USAGE = `capabilities — what this sandbox can be connected to, and the in-chat ask to connect one

  capabilities list [--json]                 every connectable entry, what is connected, and what this workspace
                                             looks like it wants
  capabilities request <entry|connection>    ask the owner, on a card in their chat, to connect one, to fix one
        [--target <site|host>]                 the site or host it is for, when the entry can hold several
        [--set key=value]...                   settings you can fill in (never a credential), or a change to a
                                               connected one's settings (a device switch, a Docker option)
        [--reconnect]                          it is connected, but its credential is being refused
        [--why "…"] [--wait <seconds>]         your one-line case for it, shown on the card

${WAIT_HELP}`;

const list = async (flags) => {
    const { status, text } = await call(COMMAND, "GET", "/capabilities/connectable");
    if (status !== 200) {
        return die(COMMAND, refusalOf(text));
    }
    const parsed = JSON.parse(text);
    if (flags.json === true) {
        process.stdout.write(`${JSON.stringify(parsed, null, 2)}\n`);
        return;
    }
    const entries = Array.isArray(parsed.entries) ? parsed.entries : [];
    if (entries.length === 0) {
        process.stdout.write("No capability entries are available.\n");
        return;
    }
    for (const entry of entries) {
        process.stdout.write(`${entry.connected ? "[connected] " : ""}${entry.entry} — ${entry.name}: ${entry.description}\n`);
    }
    const suggested = Array.isArray(parsed.suggested) ? parsed.suggested : [];
    if (suggested.length > 0) {
        process.stdout.write("\nThis workspace looks like it wants:\n");
        for (const suggestion of suggested) {
            process.stdout.write(`  ${suggestion.entry} — ${suggestion.claim} (from ${suggestion.evidence})\n`);
        }
    }
};

// `key=value` settings as the route takes them; a value may itself contain `=`.
const settingsOf = (pairs) =>
    Object.fromEntries(
        (pairs ?? []).map((pair) => {
            const at = pair.indexOf("=");
            if (at <= 0) {
                return die(COMMAND, `--set takes key=value, and "${pair}" is not`);
            }
            return [pair.slice(0, at), pair.slice(at + 1)];
        }),
    );

const requestOne = async (args) => {
    const { flags, rest } = parseArgs(COMMAND, args, { values: ["why", "target", "wait"], switches: ["reconnect"], repeated: ["set"] });
    const [entry] = rest;
    if (entry === undefined) {
        return die(COMMAND, USAGE);
    }
    const set = settingsOf(flags.set);
    await raise(
        COMMAND,
        {
            kind: "capability",
            entry,
            ...(flags.target === undefined ? {} : { target: flags.target }),
            ...(Object.keys(set).length === 0 ? {} : { set }),
            ...(flags.reconnect === true ? { reconnect: true } : {}),
        },
        flags,
    );
};

const main = async () => {
    const [command, ...rest] = process.argv.slice(2);
    if (command === "list") {
        return list(parseArgs(COMMAND, rest, { switches: ["json"] }).flags);
    }
    if (command === "request") {
        return requestOne(rest);
    }
    process.stdout.write(`${USAGE}\n`);
    process.exit(command === undefined || command === "--help" || command === "-h" ? 0 : 1);
};

main().catch((error) => die(COMMAND, error?.message ?? String(error)));
