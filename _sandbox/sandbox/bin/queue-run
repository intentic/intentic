#!/usr/bin/env bash
# queue-run --pool NAME --limit N [--wait SECONDS] [--memory-gate SECONDS] [--max-hold SECONDS] [--on-deadline run|skip] [--label ID] [--size targeted] -- <command> [args...]
#
# Runs <command> once a slot in <pool> is free, so the expensive commands several agent sessions each decide to
# run — a repo-wide test fan-out, a type check across 74 packages — take turns instead of landing on the box at
# once. A heavy program becomes this as it starts (heavy-turn.cjs in @intentic/constants, loaded into every program
# an agent's command runs), with the flags its rule in the shared table gives (heavy-rules.cjs, with the owner's
# overrides from .intentic/config/heavy-commands.json); the repository's own verify scripts call it the same way. The defaults below are for a hand call only: every caller passes each value from that
# table, so none of them is a second copy of it.
#
# WHY A LOCK AND NOT A COUNTER IN THE DAEMON. The slot has to be released by a command that is killed, that
# backgrounds itself, or that dies with its whole session — and by one running when the daemon restarts under
# it. An `flock` held on an inherited descriptor is released by the KERNEL when the last holder exits, so none
# of those cases leaks a slot and there is no lease, no TTL and no reaper to get wrong. The cost is that the
# lock is held by the process TREE: a command that forks something long-lived and returns keeps the slot until
# that child exits too. That is the honest accounting — the work really is still running — but it does mean a
# `run_in_background` build holds its slot for as long as it builds.
#
# THE ONE CASE THAT RULE DOES NOT COVER is a command that never exits at all. The kernel releases the lock when
# the last holder exits; it does not promise one ever will. Measured: `npx vue-tsc` run from a directory the
# binary is not installed in fell through to the registry, and then sat in epoll_wait for 35 minutes — no child
# process, no output, not one file written into the npx staging directory it had just created. npm's own
# `fetch-timeout` (5 min, 2 retries) should have ended it around 17 and did not, which is the point: a holder
# that hangs is not a case anything below this line can reason about. At `--limit 2` that was half the pool for
# the 26 minutes its conversation went on working. The reaper was not going to help: it reclaims what a STOPPED
# conversation holds, and this one was live the whole time, so the slot was coming back when the conversation
# ended and not before. `--max-hold` is the backstop — a ceiling on how long a command may HOLD a slot, which is
# a different question from `--wait`'s ceiling on queueing for one.
#
# FD 9 SPECIFICALLY, not bash's `{var}>` form: bash marks automatically-allocated descriptors close-on-exec, so
# the lock would be dropped at the `exec` below — the command would run holding nothing while queue-run's own
# exit released the slot it never really had. A literal low fd is inherited across exec, which is the whole
# mechanism.
#
# EVERY FAILURE RUNS THE COMMAND. No flock, no slot directory, a bad argument, an unreadable cgroup: all of it
# degrades to running the command plainly. This wrapper sits between an agent and its shell, and the one thing
# it must never become is the reason a command did not run. The wait running out is not a failure: it is the one
# outcome a rule may answer with `--on-deadline skip`, for a command whose overlap with a holder IS the incident.
set -u

pool="heavy"
limit=2
wait_seconds=900
memory_gate=0
max_hold=0
label="command"
on_deadline="run"
size=""
# Only where the wait cannot be woken by the kernel (a bash before 5.1, see `next_slot`); fractions allowed.
poll_seconds="${INTENTIC_QUEUE_POLL:-0.25}"

# Grace between the ceiling's TERM and the KILL behind it: long enough for a build to flush its output, short
# enough that a process ignoring TERM cannot go on holding the slot.
kill_grace=30

# THE COMMAND IS WHATEVER FOLLOWS `--`, and the line is cut there BEFORE any flag is read. Parsing left to
# right instead means an unrecognised flag — a newer daemon calling an older image's wrapper, which a rollback
# produces — has no safe reading: stopping there swallows `--future-flag x` into the command line and execs
# it, and guessing its arity is worse. Cutting first makes an unknown flag exactly as harmless as it should
# be: ignored, with the command still perfectly delimited. No `--` at all (nothing the daemon emits) means the
# whole line is the command, because this wrapper must never be the reason a command did not run.
flags=()
rest=()
seen_separator=0
for arg in "$@"; do
    if [ "$seen_separator" = 0 ] && [ "$arg" = "--" ]; then
        seen_separator=1
        continue
    fi
    if [ "$seen_separator" = 1 ]; then rest+=("$arg"); else flags+=("$arg"); fi
done
if [ "$seen_separator" = 0 ]; then
    rest=(${flags[@]+"${flags[@]}"})
    flags=()
fi
set -- ${rest[@]+"${rest[@]}"}

i=0
while [ "$i" -lt "${#flags[@]}" ]; do
    case "${flags[$i]}" in
        --pool) pool="${flags[$((i + 1))]:-heavy}"; i=$((i + 2)) ;;
        --limit) limit="${flags[$((i + 1))]:-2}"; i=$((i + 2)) ;;
        --wait) wait_seconds="${flags[$((i + 1))]:-900}"; i=$((i + 2)) ;;
        --memory-gate) memory_gate="${flags[$((i + 1))]:-0}"; i=$((i + 2)) ;;
        --max-hold) max_hold="${flags[$((i + 1))]:-0}"; i=$((i + 2)) ;;
        --label) label="${flags[$((i + 1))]:-command}"; i=$((i + 2)) ;;
        --on-deadline) on_deadline="${flags[$((i + 1))]:-run}"; i=$((i + 2)) ;;
        --size) size="${flags[$((i + 1))]:-}"; i=$((i + 2)) ;;
        *) i=$((i + 1)) ;;
    esac
done

# Nothing to run is not an error worth a non-zero exit: it means the caller composed an empty command line,
# and the command it meant to run does not exist to be harmed either way.
[ $# -eq 0 ] && exit 0

run() { exec "$@"; }

# Bounded: what a command may not do is hold a slot forever. Only the paths that actually TOOK one call this —
# the deadline path below holds nothing, and a ceiling there would kill the owner's work to free no slot at all.
#
# NEVER `--foreground`. Measured against the pipeline that prompted this: that mode leaves the command's siblings
# alive holding the slot's descriptor, so the lock outlives the kill and the leak still happens. Default mode puts
# the command in a process group of its own and signals the group, which is the entire mechanism here.
#
# STILL `exec`, so a bounded command is one process and not two: `queue-run` killed from outside has to take the
# command with it, and that is what frees the slot in the kill case. A supervising parent would survive the signal
# and orphan the very thing it was supervising.
held_run() {
    # Names the slot to everything the command starts. fd 9 says the same to the command itself, but a Node parent does
    # not pass it on, and a script deciding whether it must queue (heavy-slot.mjs) may sit several spawns down.
    [ -n "${slot:-}" ] && export INTENTIC_QUEUE_SLOT="$slot"
    # How long this holder may keep the slot, read back by the daemon's minute log to say when a hold has gone on
    # too long for its own rule (src/system/resources/queue-slots.ts), not by one number for every pool.
    [ -n "${slot:-}" ] && export INTENTIC_QUEUE_MAX_HOLD="$max_hold"
    if [ "$max_hold" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
        exec timeout --kill-after="$kill_grace" "$max_hold" "$@"
    fi
    exec "$@"
}

# Digits only. A non-numeric limit or deadline arriving from a config file must not turn into shell arithmetic
# that errors under `set -u`, or into a negative loop bound that never terminates.
number() { case "$1" in '' | *[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
limit=$(number "$limit" 2)
wait_seconds=$(number "$wait_seconds" 900)
memory_gate=$(number "$memory_gate" 0)
max_hold=$(number "$max_hold" 0)
# A poll interval may be a fraction of a second (`sleep` takes one); anything else, or zero, is the default.
case "$poll_seconds" in '' | *[!0-9.]* | *.*.* | .) poll_seconds=0.25 ;; esac
case "$poll_seconds" in *[1-9]*) ;; *) poll_seconds=0.25 ;; esac
[ "$limit" -lt 1 ] && limit=1
# Two words only; anything else is "run", since an unknown mode must not become the reason a command did not run.
case "$on_deadline" in run | skip) ;; *) on_deadline="run" ;; esac
# One word, or none: a size the gate does not know is priced as the whole class.
case "$size" in targeted) ;; *) size="" ;; esac

# The memory half of the gate, before the slot rather than after: a box with no room should not burn a slot
# sitting in it. `memory-room` asks the daemon's resource budget (the same verdict that holds a turn, and the same
# ledger: two heavy commands admitted at one instant do not both pass on one reading), and applies the same formula
# itself where no daemon answers (@intentic/constants/memory-room). Every outcome of it is "run the command";
# skipped silently when the binary is absent (a dev daemon, a partial image).
# Run through `node` when it is not executable: the symlink points into node_modules, and a tree re-synced into a
# running sandbox can arrive without its executable bit (measured with the gate before it: every heavy command printed
# "Permission denied" and the memory half of this gate silently never ran).
# `--pid $$` names this very process, which the command becomes at the `exec` below (or `timeout`, its parent, under
# --max-hold): the budget hands the reservation back when it exits, not 90 seconds later.
if [ "$memory_gate" -gt 0 ] && gate="$(command -v memory-room 2>/dev/null)" && [ -n "$gate" ]; then
    gate_args=(--class toolchain --wait "$memory_gate" --label "$label" --pid "$$")
    [ -n "$size" ] && gate_args+=(--size "$size")
    if [ -x "$gate" ]; then
        "$gate" "${gate_args[@]}" || true
    else
        node "$gate" "${gate_args[@]}" || true
    fi
fi

command -v flock >/dev/null 2>&1 || run "$@"

dir="${INTENTIC_QUEUE_DIR:-${TMPDIR:-/tmp}/intentic-queue}/$pool"
mkdir -p "$dir" 2>/dev/null || run "$@"
# THE QUEUE DIRECTORY IS SHARED WITH FENCED TURNS, whose sandbox user owns whatever root owns in it
# (conversations/worktrees/turn-sandbox.ts), so anything in it may be a link planted to send root's open somewhere
# else. A pool that is itself a link is no pool: run plainly, as on any other failure.
[ -L "$dir" ] && run "$@"

# One pass over the pool: the first slot whose lock is free is taken and kept (fd 9 stays open, deliberately
# un-closed, all the way through the exec below). A slot we cannot even open is skipped rather than fatal.
#
# NO `2>/dev/null` ON THE `exec` BELOW, however tempting it looks beside a file open that can fail. A
# redirection on `exec` is PERMANENT — `exec 9>slot 2>/dev/null` sets fd 9 AND silences the script's stderr for
# the rest of its life, which cost this wrapper every one of its notices: the pane showed nothing while a
# command sat in the queue, and `bash -x` output stopped mid-function, which is how it was found. A failed
# `exec` redirection returns non-zero without killing a non-interactive bash (verified), so `|| continue` is
# the whole error path it needs.
#
# `>>`, NEVER `>`: the lock needs an open descriptor, not an empty file, and `>` would truncate whatever a slot
# planted as a link names (see the queue directory note above). A slot that is a link is skipped, not removed: the
# check and the open are two steps, and appending through a link won in that gap writes nothing.
acquire() {
    local i
    for ((i = 1; i <= limit; i++)); do
        [ -L "$dir/slot.$i" ] && continue
        exec 9>>"$dir/slot.$i" || continue
        if flock -n 9; then
            slot="$dir/slot.$i"
            return 0
        fi
    done
    exec 9>&-
    return 1
}

acquire && held_run "$@"

# WHO HOLDS THE POOL, said while a command waits on it. "waiting for a free slot" alone left an agent nothing to act on:
# whose command, from which conversation, held for how long. The kernel keeps the answer: a holder is any process with
# fd 9 open on one of the pool's slots (a pipeline inherits it to every member; the oldest of them took it). Read off
# /proc, as the daemon's own minute log reads it (src/system/resources/queue-slots.ts), so nothing here can go stale.
ticks=$(getconf CLK_TCK 2>/dev/null || echo 100)
uptime_now() { local up _; read -r up _ </proc/uptime 2>/dev/null || up=0; echo "${up%.*}"; }
# Seconds the process has lived, which is as long as it has held what it took at its start.
age_of() {
    local stat rest
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    rest=${stat##*) }
    set -- $rest
    # Field 22 of stat(5), the 20th after the name: start time in clock ticks since boot.
    echo $(($(uptime_now) - ${20:-0} / ticks))
}
env_of() { tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -n 1; }
# A string as JSON: backslashes and quotes escaped, control characters dropped.
json_string() { printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
# One line per held slot, its oldest holder: slot, pid, the holder's age in seconds, conversation, rule, command, split
# by the unit separator (a tab is whitespace to `read`, and an empty field between two would vanish).
sep=$(printf '\037')
holders() {
    local fd target pid age best_slot=() line
    for fd in /proc/[0-9]*/fd/9; do
        target=$(readlink "$fd" 2>/dev/null) || continue
        case "$target" in "$dir"/slot.*) ;; *) continue ;; esac
        pid=${fd#/proc/}
        pid=${pid%%/*}
        # A waiter opens a slot for the instant it tries its lock, and is no holder.
        [ -e "$dir/wait.$pid" ] && continue
        age=$(age_of "$pid") || continue
        printf "%s$sep%s$sep%s$sep%s$sep%s$sep%s\n" "${target##*/}" "$pid" "$age" "$(env_of "$pid" INTENTIC_TURN_OWNER)" "$(env_of "$pid" INTENTIC_HEAVY_HELD)" \
            "$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-120)"
    done | sort -t "$sep" -k1,1 -k3,3nr | awk -F "$sep" '!seen[$1]++'
}
minutes() { if [ "$1" -ge 60 ]; then echo "$(($1 / 60))m$(($1 % 60))s"; else echo "${1}s"; fi; }
say_holders() {
    local slot pid age owner rule command
    while IFS="$sep" read -r slot pid age owner rule command; do
        printf '[queue-run]   %s: pid %s, running %s%s%s: %s\n' "$slot" "$pid" "$(minutes "$age")" "${rule:+ by rule $rule}" "${owner:+ for conversation $owner}" "$command" >&2
    done
}

# WHO WAITS, AND THE POOL AS A WHOLE, for a reader that is not this pane (an agent's `cat`, a diagnostics read):
# `wait.<pid>` names each waiter while it waits, and `state.json` is the pool's holders and waiters as the latest waiter
# saw them, rewritten when one starts waiting, every SAY_EVERY seconds, and when it stops. Both written whole under a
# temporary name and renamed over the old, never opened by their own name: the directory is shared with fenced turns
# (see above), and a rename replaces a planted link instead of writing through it.
waiting_since=$(date +%s)
owner_here=${INTENTIC_TURN_OWNER:-}
put() {
    local tmp
    tmp=$(mktemp "$dir/.tmp.XXXXXX" 2>/dev/null) || return 0
    printf '%s\n' "$2" >"$tmp" && mv -f "$tmp" "$dir/$1" 2>/dev/null || rm -f "$tmp"
}
write_state() {
    local holders_json="" waiters_json="" slot pid age owner rule command file entry
    while IFS="$sep" read -r slot pid age owner rule command; do
        [ -n "$slot" ] || continue
        holders_json="$holders_json${holders_json:+,}{\"slot\":$(json_string "$slot"),\"pid\":$pid,\"holderAgeSeconds\":$age,\"conversation\":$(json_string "$owner"),\"rule\":$(json_string "$rule"),\"command\":$(json_string "$command")}"
    done < <(holders)
    for file in "$dir"/wait.*; do
        [ -f "$file" ] && [ ! -L "$file" ] || continue
        pid=${file##*.}
        if [ "$pid" != "$$" ] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$file"
            continue
        fi
        [ "$pid" = "$$" ] && [ "${1:-}" = leaving ] && continue
        entry=$(head -c 2000 "$file" 2>/dev/null)
        waiters_json="$waiters_json${waiters_json:+,}$entry"
    done
    put state.json "{\"pool\":$(json_string "$pool"),\"limit\":$limit,\"updatedAt\":$(date +%s),\"holders\":[$holders_json],\"waiters\":[$waiters_json]}"
}
stop_waiting() {
    stop_flocks
    rm -f "$dir/wait.$$"
    write_state leaving
}

# THE WAIT IS WOKEN BY THE KERNEL, NOT A POLL (2026-10-20). A slot frees the instant its holder's last process exits,
# and nothing told a waiter: it found out at its next poll, a second on average after the slot was already free. Now
# each slot gets a `flock -w` of its own in the background, blocked in the kernel on that slot's lock, and the first one
# granted wins. Each `flock` locks the open file description it inherited from this shell (fd WAIT_FD+i, opened here),
# so the lock it was granted stays this shell's after it exits; the winner's description is then moved to fd 9 (see
# FD 9 SPECIFICALLY above) and the rest are closed. A loser granted its lock in the same instant held it only through
# descriptors closed here and in the killed `flock`, so that slot goes straight back to the pool. A round lasts no
# longer than the next notice is due, so the pane still hears from the wait every SAY_EVERY seconds.
wait_fd=20
flock_pids=()
stop_flocks() {
    [ "${#flock_pids[@]}" -gt 0 ] || return 0
    kill "${flock_pids[@]}" 2>/dev/null
    wait "${flock_pids[@]}" 2>/dev/null
    flock_pids=()
}
# Waits on the `flock`s until one is granted (its slot number left in `won`) or none is left waiting.
first_granted() {
    local done_pid status pid left
    won=""
    while [ "${#flock_pids[@]}" -gt 0 ]; do
        done_pid=""
        wait -n -p done_pid "${flock_pids[@]}"
        status=$?
        [ -n "$done_pid" ] || return 1
        left=()
        for pid in "${flock_pids[@]}"; do [ "$pid" = "$done_pid" ] || left+=("$pid"); done
        flock_pids=(${left[@]+"${left[@]}"})
        if [ "$status" = 0 ]; then
            won=${slot_of[$done_pid]}
            return 0
        fi
    done
    return 1
}
# One round: true with fd 9 holding a slot, false once `$1` seconds pass with none granted.
await_slot() {
    local seconds=$1 i fd opened=()
    won=""
    declare -gA slot_of=()
    for ((i = 1; i <= limit; i++)); do
        [ -L "$dir/slot.$i" ] && continue
        fd=$((wait_fd + i))
        eval "exec $fd>>\"\$dir/slot.\$i\"" || continue
        opened+=("$fd")
        flock -w "$seconds" "$fd" &
        slot_of[$!]=$i
        flock_pids+=("$!")
    done
    if [ "${#opened[@]}" -gt 0 ]; then
        # Never in a $(…): the `flock`s are this shell's children, and only this shell may wait on them.
        first_granted
    else
        # Not one slot could be opened: nothing can wake this round, so it sleeps rather than spins.
        sleep "$poll_seconds"
    fi
    stop_flocks
    [ -n "$won" ] && eval "exec 9>&$((wait_fd + won))" && slot="$dir/slot.$won"
    for fd in ${opened[@]+"${opened[@]}"}; do eval "exec $fd>&-"; done
    [ -n "$won" ] && [ -n "${slot:-}" ]
}
# `wait -n -p` came in bash 5.1; an older bash polls, every INTENTIC_QUEUE_POLL seconds.
kernel_wait=0
if [ "${BASH_VERSINFO[0]}" -gt 5 ] || { [ "${BASH_VERSINFO[0]}" -eq 5 ] && [ "${BASH_VERSINFO[1]}" -ge 1 ]; }; then
    kernel_wait=1
fi
next_slot() {
    local until=$((SECONDS + $1))
    if [ "$kernel_wait" = 1 ] && command -v flock >/dev/null 2>&1; then
        await_slot "$1"
        return
    fi
    while [ "$SECONDS" -lt "$until" ]; do
        sleep "$poll_seconds"
        acquire && return 0
    done
    return 1
}

# Every slot was busy. Say so, with who holds them — the pane is where the person wondering why nothing is happening is
# looking — and again every SAY_EVERY seconds, so a log redirected to a file shows the wait going on rather than staying
# empty for the minutes it lasts. Then wait for a slot (next_slot) until the deadline.
say_every=$(number "${INTENTIC_QUEUE_SAY_EVERY:-30}" 30)
[ "$say_every" -lt 1 ] && say_every=30
put "wait.$$" "{\"pid\":$$,\"label\":$(json_string "$label"),\"conversation\":$(json_string "$owner_here"),\"since\":$waiting_since,\"command\":$(json_string "$(printf '%s ' "$@" | cut -c1-120)")}"
trap 'rm -f "$dir/wait.$$"' EXIT
trap 'stop_waiting; exit 130' INT
trap 'stop_waiting; exit 143' TERM
write_state
printf '[queue-run] %s: waiting for a free slot in pool "%s" (limit %s), held by:\n' "$label" "$pool" "$limit" >&2
holders | say_holders
printf '[queue-run]   (holders and waiters: %s)\n' "$dir/state.json" >&2
started_waiting=$SECONDS
waited=0
said_at=0
while [ "$waited" -lt "$wait_seconds" ]; do
    round=$((say_every - (waited - said_at)))
    [ "$round" -gt $((wait_seconds - waited)) ] && round=$((wait_seconds - waited))
    [ "$round" -lt 1 ] && round=1
    if next_slot "$round"; then
        trap - EXIT INT TERM
        stop_waiting
        printf '[queue-run] %s: slot free after %ss — starting.\n' "$label" "$((SECONDS - started_waiting))" >&2
        held_run "$@"
    fi
    waited=$((SECONDS - started_waiting))
    if [ $((waited - said_at)) -ge "$say_every" ]; then
        said_at=$waited
        write_state
        printf '[queue-run] %s: still waiting after %s for pool "%s" (limit %s), held by:\n' "$label" "$(minutes "$waited")" "$pool" "$limit" >&2
        holders | say_holders
    fi
done
trap - EXIT INT TERM
stop_waiting

# Deadline reached. `skip` exits 75 (EX_TEMPFAIL) having run nothing, so the caller records a check that was not
# made rather than one that failed; it is for a command whose overlap with the holder is the incident and whose
# absence costs only a check. Everything else runs anyway, for the reason memory-room gives for the same
# decision: this gate exists to dodge a peak, not to hand whatever is holding the box a veto over the owner's
# work. A queue that can block forever turns one stuck suite into a dead sandbox — a worse failure, and a much
# quieter one.
if [ "$on_deadline" = skip ]; then
    printf '[queue-run] %s: no slot after %ss — not started, since this command must not run beside the one holding the slot.\n' "$label" "$wait_seconds" >&2
    exit 75
fi
printf '[queue-run] %s: no slot after %ss — starting anyway.\n' "$label" "$wait_seconds" >&2
run "$@"
