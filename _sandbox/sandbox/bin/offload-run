#!/usr/bin/env node
// offload-run --to <runner> --label <rule> [--here <prefix>] [--env NAME]… [--export NAME]… [--out PATH]…
//             [--needs mem=12G,gpu] [--eager] -- <command> [args…]
// offload-run --remote-run [--to <runner>] [--out PATH]… [--needs …] [--env NAME]… -- <command> [args…]   (bin/remote-run)
//
// Runs one heavy command on a runner on one of the owner's machines instead of in this sandbox (settings `offload`). It
// is put in front of the line by the daemon, never typed: by the agent's Bash hook when the line matches a heavy-command
// rule the owner sends somewhere (src/agent/tools/agent-terminals.ts). To whoever runs it, it is the command itself: the
// output streams as it comes, the exit code is the command's, a stop stops it on the runner, and every file the command
// changed comes back into this tree, as if it had run here.
//
// 1. Asks the daemon whether the runner can take it (connected, able), or which one has room when <runner> is "auto"
//    (settings `offload.commands` set to any machine with room); if not, runs the command HERE, behind the local
//    heavy queue it was handed (--here), after one line saying why (none for "auto" while this sandbox has room).
// 2. Snapshots this repository's working tree as one commit, uncommitted and untracked work included, ignored files not,
//    under refs/intentic-offload/<run>, which the runner fetches through the daemon's git door. The ref goes once the
//    run ends.
// 3. Streams the run through the daemon (src/offload/offload.routes.ts), then applies the patch of what the command
//    changed, writes back the files it wrote to each --export variable (at the path that variable names here), and
//    exits with the command's code.
//
// --env NAME carries this environment's value of NAME to the runner. Nothing else travels, and no secret ever: the hook
// runs a line that resolved one here.
//
// --out PATH names something the command makes that has to come back whole, which the patch never carries because git
// ignores it: a binary it built (`--out target/debug/integra`), a directory of frames it rendered (`--out /tmp/vfx`).
// Inside the repository or under /tmp; a file this tree already holds byte for byte is not sent again. --needs says what
// the machine must have (`mem=12G`, `gpu`): a runner short of it is never picked. --eager (remote-run's) picks the
// machine with the most room that fits even while this sandbox is calm; without it "auto" leaves only a busy sandbox,
// or one the command does not fit.
//
// --remote-run is how an agent asks for it in so many words (bin/remote-run): "auto", eager, labelled `remote-run`,
// and run here as it is when no machine fits.
//
// Auth is the per-boot agent token, which auth/grants.ts admits to the /offload routes. node:http rather than fetch:
// a quiet test suite can print nothing for longer than undici's body timeout, which would cut a healthy run.

import { execFileSync, spawn } from "node:child_process";
import { createHash, randomBytes } from "node:crypto";
import {
    chmodSync,
    closeSync,
    copyFileSync,
    existsSync,
    lstatSync,
    mkdirSync,
    mkdtempSync,
    openSync,
    readdirSync,
    readFileSync,
    renameSync,
    rmSync,
    writeFileSync,
    writeSync,
} from "node:fs";
import { request } from "node:http";
import { tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve } from "node:path";
import { gunzipSync } from "node:zlib";

// The per-boot agent token; a test points INTENTIC_AGENT_TOKEN_PATH at its own.
const TOKEN_PATH = process.env.INTENTIC_AGENT_TOKEN_PATH ?? "/run/intentic/agent.token";
const PORT = process.env.SANDBOX_PORT ?? "8787";
const OFFLOAD_REF_PREFIX = "refs/intentic-offload/";
// What queue-run exits with when it did not start a line (QUEUE_SKIPPED_EXIT_CODE): the runner's own queue stayed full.
const QUEUE_SKIPPED = 75;

const say = (line) => process.stderr.write(`offload: ${line}\n`);

// POSIX single-quoting, the same rule as @intentic/sandbox-run's shellQuote.
const quote = (word) => (/^[\w@%+=:,./-]+$/u.test(word) ? word : `'${word.replaceAll("'", `'\\''`)}'`);

// `mem=12G,gpu` as the daemon asks it: memory in MiB, and whether a GPU is needed. A word it does not know is said.
const parseNeeds = (spec) => {
    const needs = {};
    for (const word of String(spec ?? "").split(",").map((part) => part.trim()).filter((part) => part !== "")) {
        const memory = /^mem(?:ory)?=(\d+(?:\.\d+)?)\s*([kmgt]?)i?b?$/iu.exec(word);
        if (memory !== null) {
            const scale = { "": 1 / 1_048_576, k: 1 / 1024, m: 1, g: 1024, t: 1024 * 1024 }[memory[2].toLowerCase()];
            needs.memoryMb = Math.max(1, Math.ceil(Number(memory[1]) * scale));
        } else if (/^gpu$/iu.test(word)) {
            needs.gpu = true;
        } else {
            say(`--needs: "${word}" is not something a machine can be asked for (mem=<size>, gpu); ignored`);
        }
    }
    return needs;
};

const parseArgs = (argv) => {
    const at = argv.indexOf("--");
    const flags = at === -1 ? argv : argv.slice(0, at);
    const command = at === -1 ? [] : argv.slice(at + 1);
    const options = { to: undefined, label: "heavy", here: "", env: [], exports: [], outputs: [], needs: {}, eager: false };
    if (flags.includes("--remote-run")) {
        Object.assign(options, { to: "auto", label: "remote-run", eager: true });
    }
    for (let index = 0; index < flags.length; index += 1) {
        const flag = flags[index];
        const value = flags[index + 1];
        if (flag === "--remote-run") {
            continue;
        } else if (flag === "--eager") {
            options.eager = true;
            continue;
        } else if (flag === "--out") {
            options.outputs.push(value);
        } else if (flag === "--needs") {
            options.needs = { ...options.needs, ...parseNeeds(value) };
        } else if (flag === "--to") {
            options.to = value;
        } else if (flag === "--label") {
            options.label = value;
        } else if (flag === "--here") {
            options.here = value;
        } else if (flag === "--env") {
            options.env.push(value);
        } else if (flag === "--export") {
            options.exports.push(value);
        } else {
            continue;
        }
        index += 1;
    }
    return { options, command };
};

const { options, command } = parseArgs(process.argv.slice(2));
if (command.length === 0) {
    process.stderr.write(
        "usage: offload-run --to <runner> --label <rule> [--here <prefix>] [--env NAME]… [--export NAME]… [--out PATH]… [--needs mem=12G,gpu] [--eager] -- <command>\n" +
            "       remote-run [--to <runner>] [--out PATH]… [--needs mem=12G,gpu] [--env NAME]… -- <command>\n",
    );
    process.exit(2);
}

// The command in this sandbox, behind the heavy queue the caller named: what would have run had nothing been offloaded.
const runHere = (why) => {
    if (why !== undefined) {
        say(`${why}; running it here`);
    }
    const line = `${options.here}${command.map(quote).join(" ")}`;
    const child = spawn("bash", ["-c", line], { stdio: "inherit" });
    const forward = (signal) => child.kill(signal);
    process.on("SIGTERM", forward);
    process.on("SIGINT", forward);
    child.on("exit", (code, signal) => process.exit(code ?? (signal === "SIGINT" ? 130 : 143)));
};

const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return undefined;
    }
};

// One daemon call; `onChunk` streams the body, otherwise it is read whole. Resolves with the status and the body read.
const call = (method, path, body, onChunk) =>
    new Promise((resolve, reject) => {
        const secret = token();
        if (secret === undefined) {
            reject(new Error(`no daemon token at ${TOKEN_PATH}`));
            return;
        }
        const payload = body === undefined ? undefined : JSON.stringify(body);
        const req = request(
            {
                host: "127.0.0.1",
                port: PORT,
                method,
                path,
                headers: {
                    "x-intentic-agent": secret,
                    accept: onChunk === undefined ? "application/json" : "text/event-stream",
                    ...(payload === undefined ? {} : { "content-type": "application/json", "content-length": Buffer.byteLength(payload) }),
                },
            },
            (response) => {
                let text = "";
                response.on("data", (chunk) => {
                    if (onChunk === undefined) {
                        text += chunk.toString("utf8");
                    } else {
                        onChunk(chunk.toString("utf8"));
                    }
                });
                response.on("end", () => resolve({ status: response.statusCode ?? 0, text }));
                response.on("error", reject);
            },
        );
        req.on("error", reject);
        if (payload !== undefined) {
            req.write(payload);
        }
        req.end();
    });

const git = (args, cwd, env) => execFileSync("git", args, { cwd, encoding: "utf8", env: { ...process.env, ...env }, maxBuffer: 256 * 1024 * 1024 }).trim();

// Which repository this is to the daemon's git door: its entry under /history/gits (a worktree's common dir is there
// too), else the workspace root itself.
const repoIdOf = (toplevel) => {
    const common = git(["rev-parse", "--path-format=absolute", "--git-common-dir"], toplevel);
    const gits = "/history/gits/";
    if (common.startsWith(gits)) {
        return decodeURIComponent(basename(common));
    }
    return relative(process.env.WORKSPACE_ROOT ?? "/work", toplevel) === "" ? "root" : undefined;
};

// The working tree as it stands, as one commit parked under the run's ref: a copy of the real index, so only what changed
// is hashed again, then everything git does not ignore added to it.
const snapshot = (toplevel, runId) => {
    const scratch = mkdtempSync(join(tmpdir(), "offload-snapshot-"));
    try {
        const index = join(scratch, "index");
        const real = git(["rev-parse", "--path-format=absolute", "--git-path", "index"], toplevel);
        if (existsSync(real)) {
            copyFileSync(real, index);
        }
        const env = { GIT_INDEX_FILE: index };
        git(["add", "-A"], toplevel, env);
        const tree = git(["write-tree"], toplevel, env);
        const commit = git(["commit-tree", tree, "-p", "HEAD", "-m", `offload ${runId}`], toplevel, {
            GIT_AUTHOR_NAME: "offload",
            GIT_AUTHOR_EMAIL: "offload@intentic.local",
            GIT_COMMITTER_NAME: "offload",
            GIT_COMMITTER_EMAIL: "offload@intentic.local",
        });
        const ref = `${OFFLOAD_REF_PREFIX}${runId}`;
        git(["update-ref", ref, commit], toplevel);
        return ref;
    } finally {
        rmSync(scratch, { recursive: true, force: true });
    }
};

// Brings back what the command changed there: the patch applied here (three-way when this tree moved meanwhile), and each
// exported file written to the path its variable names here.
const bringBack = (toplevel, exit) => {
    if (exit.patchBase64 !== undefined) {
        const scratch = mkdtempSync(join(tmpdir(), "offload-patch-"));
        const patch = join(scratch, "changes.patch");
        writeFileSync(patch, Buffer.from(exit.patchBase64, "base64"));
        try {
            git(["apply", "--binary", "--whitespace=nowarn", patch], toplevel);
            say("the files it changed there are changed here too");
        } catch {
            try {
                git(["apply", "--binary", "--3way", "--whitespace=nowarn", patch], toplevel);
                say("the files it changed there were merged into this tree, which moved meanwhile");
            } catch (error) {
                say(`the files it changed there could not be applied here (${String(error.message).split("\n")[0]}); the patch is at ${patch}`);
                return;
            }
        }
        rmSync(scratch, { recursive: true, force: true });
    }
    for (const [name, content] of Object.entries(exit.files ?? {})) {
        const path = process.env[name];
        if (path !== undefined && path !== "") {
            writeFileSync(path, Buffer.from(content, "base64"));
        }
    }
};

// Each --out as the runner reads it: repo-relative, or absolute under /tmp. Anything else could never come back, so the
// command runs here instead, where it makes the path itself.
const outputPaths = (toplevel, outputs) => {
    const paths = [];
    for (const given of outputs) {
        const absolute = resolve(process.cwd(), given);
        const inRepo = relative(toplevel, absolute);
        if (inRepo !== "" && !inRepo.startsWith("..") && !isAbsolute(inRepo)) {
            paths.push(inRepo.split("\\").join("/"));
        } else if (absolute.startsWith("/tmp/")) {
            paths.push(absolute);
        } else {
            return { refused: `--out ${given} is neither inside this repository nor under /tmp, so it could not come back` };
        }
    }
    return { paths };
};

// Where an output path lands here.
const destinationOf = (toplevel, path) => (path.startsWith("/tmp/") ? path : join(toplevel, path));

const sha256File = (file) => createHash("sha256").update(readFileSync(file)).digest("hex");

// What this tree already holds at each output, by digest, named as the runner will name it (a directory's files joined
// to it), so a binary rebuilt from unchanged sources is said rather than sent.
const haveOf = (toplevel, paths) => {
    const have = {};
    let counted = 0;
    const walk = (absolute, path) => {
        for (const entry of readdirSync(absolute, { withFileTypes: true })) {
            if (counted >= 20_000) {
                return;
            }
            const childAbsolute = join(absolute, entry.name);
            const childPath = `${path.replace(/\/+$/u, "")}/${entry.name}`;
            if (entry.isDirectory()) {
                walk(childAbsolute, childPath);
            } else if (entry.isFile()) {
                have[childPath] = sha256File(childAbsolute);
                counted += 1;
            }
        }
    };
    for (const path of paths) {
        const absolute = destinationOf(toplevel, path);
        try {
            const info = lstatSync(absolute);
            if (info.isFile()) {
                have[path] = sha256File(absolute);
            } else if (info.isDirectory()) {
                walk(absolute, path);
            }
        } catch {
            // Not here yet: everything at that path comes back.
        }
    }
    return have;
};

// Output files as they arrive: each written beside where it goes, checked against its digest, then moved in place, so a
// run cut off mid-file never leaves half a binary where the whole one was.
const receiver = (toplevel, runId) => {
    const open = new Map();
    let delivered = 0;
    let bytes = 0;
    let same = 0;
    const failed = [];
    const drop = (path) => {
        const file = open.get(path);
        if (file !== undefined) {
            closeSync(file.fd);
            rmSync(file.part, { force: true });
            open.delete(path);
        }
    };
    const take = (frame) => {
        if (frame.same === true) {
            same += 1;
            return;
        }
        let file = open.get(frame.path);
        if (file === undefined) {
            const destination = destinationOf(toplevel, frame.path);
            mkdirSync(dirname(destination), { recursive: true });
            const part = `${destination}.offload-${runId}.part`;
            file = { destination, part, fd: openSync(part, "w"), hash: createHash("sha256"), size: 0 };
            open.set(frame.path, file);
        }
        if (frame.data !== undefined) {
            const piece = gunzipSync(Buffer.from(frame.data, "base64"));
            writeSync(file.fd, piece);
            file.hash.update(piece);
            file.size += piece.length;
        }
        if (frame.end !== undefined) {
            closeSync(file.fd);
            open.delete(frame.path);
            if (file.hash.digest("hex") !== frame.end.sha256 || file.size !== frame.end.size) {
                rmSync(file.part, { force: true });
                failed.push(frame.path);
                return;
            }
            chmodSync(file.part, frame.end.mode);
            renameSync(file.part, file.destination);
            delivered += 1;
            bytes += file.size;
        }
    };
    // Whatever never finished is removed, and the tally said.
    const finish = () => {
        for (const path of [...open.keys()]) {
            failed.push(path);
            drop(path);
        }
        return { delivered, bytes, same, failed };
    };
    return { take, finish };
};

// One line on what came back whole, and one for each kind of output that did not.
const sayOutputs = (brought, exit, declared, name) => {
    // A runner from before outputs reads the run without them and measures nothing either: say so, rather than leave the
    // caller looking for a binary that never came.
    const accounted = brought.delivered + brought.same + brought.failed.length + (exit.missing ?? []).length + (exit.tooBig ?? []).length;
    if (declared.length > 0 && accounted === 0 && exit.durationMs === undefined) {
        say(`the runner on ${name} predates --out, so ${declared.join(", ")} stayed there; update it from Devices`);
    }
    if (brought.delivered > 0 || brought.same > 0) {
        const same = brought.same > 0 ? `, ${brought.same} already here unchanged` : "";
        say(`brought back ${brought.delivered} output file${brought.delivered === 1 ? "" : "s"} (${megabytes(brought.bytes)})${same}`);
    }
    if ((exit.missing ?? []).length > 0) {
        say(`never made there: ${exit.missing.join(", ")}`);
    }
    if ((exit.tooBig ?? []).length > 0) {
        say(`too big to bring back, left on the runner: ${exit.tooBig.join(", ")}`);
    }
    if (brought.failed.length > 0) {
        say(`did not arrive whole, so not put in place: ${brought.failed.join(", ")}`);
    }
};

const megabytes = (bytes) => `${(bytes / 1_048_576).toFixed(bytes < 10 * 1_048_576 ? 1 : 0)} MB`;

// The question asked before anything is copied, with what the command needs and what it is, for "auto" to place by.
const targetPath = (to, command) => {
    const query = new URLSearchParams();
    if (options.needs.memoryMb !== undefined) {
        query.set("memoryMb", String(options.needs.memoryMb));
    }
    if (options.needs.gpu === true) {
        query.set("gpu", "true");
    }
    if (options.eager) {
        query.set("eager", "true");
    }
    query.set("label", options.label);
    query.set("command", command.slice(0, 4000));
    return `/offload/runners/${encodeURIComponent(to)}?${query.toString()}`;
};

const main = async () => {
    if (options.to === undefined || options.to === "") {
        runHere("no runner named");
        return;
    }
    // Asked first: for a kind sent to "any machine with room" the answer is usually that this sandbox has room, and then
    // the line runs here as if nothing stood in front of it, with no word and no git work. A refusal with no `why` is
    // exactly that answer; any other carries its reason.
    let target;
    try {
        const answer = await call("GET", targetPath(options.to, command.map(quote).join(" ")));
        target = answer.status === 200 ? JSON.parse(answer.text) : undefined;
    } catch {
        target = undefined;
    }
    if (target === undefined || !target.ready) {
        runHere(target === undefined ? "the daemon could not say whether the runner is there" : target.why);
        return;
    }
    let toplevel;
    let repo;
    try {
        toplevel = git(["rev-parse", "--show-toplevel"], process.cwd());
        git(["rev-parse", "--verify", "--quiet", "HEAD"], toplevel);
        repo = repoIdOf(toplevel);
    } catch {
        runHere("this is not inside a repository with a commit to start from");
        return;
    }
    if (repo === undefined) {
        runHere("this repository is not one the runner can fetch");
        return;
    }
    const outputs = outputPaths(toplevel, options.outputs);
    if (outputs.refused !== undefined) {
        runHere(outputs.refused);
        return;
    }

    const runId = `off-${randomBytes(6).toString("hex")}`;
    let ref;
    try {
        ref = snapshot(toplevel, runId);
    } catch (error) {
        runHere(`the tree could not be snapshotted (${String(error.message).split("\n")[0]})`);
        return;
    }
    const dropRef = () => {
        try {
            git(["update-ref", "-d", ref], toplevel);
        } catch {
            // A ref already gone has nothing left to drop.
        }
    };
    say(`running on ${target.name}`);

    let stopped = false;
    const stop = (signal) => {
        if (stopped) {
            process.exit(signal === "SIGINT" ? 130 : 143);
        }
        stopped = true;
        say(`stopping it on ${target.name}…`);
        void call("POST", `/offload/runs/${runId}/cancel`, {}).catch(() => undefined);
    };
    process.on("SIGTERM", () => stop("SIGTERM"));
    process.on("SIGINT", () => stop("SIGINT"));

    const env = Object.fromEntries(options.env.filter((name) => process.env[name] !== undefined).map((name) => [name, process.env[name]]));
    const have = haveOf(toplevel, outputs.paths);
    const files = receiver(toplevel, runId);
    let buffer = "";
    let exit;
    let refused;
    const onFrame = (frame) => {
        if (frame.kind === "status") {
            say(`[${target.name}] ${frame.text}`);
        } else if (frame.kind === "output") {
            (frame.stream === "stderr" ? process.stderr : process.stdout).write(frame.text);
        } else if (frame.kind === "file") {
            files.take(frame);
        } else if (frame.kind === "exit") {
            exit = frame;
        } else if (frame.kind === "refused") {
            refused = frame.why;
        }
    };
    try {
        const answer = await call(
            "POST",
            "/offload/runs",
            {
                // The runner the daemon answered with: the one named, or the one it picked for "any machine with room".
                runner: target.runner ?? options.to,
                runId,
                repo,
                ref,
                cwd: relative(toplevel, process.cwd()),
                command: command.map(quote).join(" "),
                env,
                exports: options.exports,
                outputs: outputs.paths,
                have,
                label: options.label,
            },
            (chunk) => {
                buffer += chunk;
                const frames = buffer.split("\n\n");
                buffer = frames.pop() ?? "";
                for (const block of frames) {
                    const data = block
                        .split("\n")
                        .filter((line) => line.startsWith("data:"))
                        .map((line) => line.slice(5).trim())
                        .join("");
                    if (data === "") {
                        continue;
                    }
                    try {
                        onFrame(JSON.parse(data));
                    } catch {
                        // A frame that is not JSON is the stream's own bookkeeping, not the run's.
                    }
                }
            },
        );
        if (answer.status !== 200 && exit === undefined && refused === undefined) {
            refused = `the daemon answered ${answer.status}`;
        }
    } catch (error) {
        refused ??= exit === undefined ? `the daemon could not be reached (${error.message})` : undefined;
    }
    dropRef();
    const brought = files.finish();
    if (exit === undefined) {
        if (stopped) {
            process.exit(143);
        }
        runHere(refused ?? `${target.name} ended the run without an exit`);
        return;
    }
    if (exit.ran === false) {
        runHere(`${target.name} could not start it (${String(exit.failure ?? "no reason given").split("\n")[0]})`);
        return;
    }
    if (exit.code === QUEUE_SKIPPED && exit.patchBase64 === undefined) {
        runHere(`${target.name}'s own queue stayed full`);
        return;
    }
    if (exit.failure !== undefined) {
        say(`${target.name}: ${exit.failure}`);
    }
    bringBack(toplevel, exit);
    sayOutputs(brought, exit, outputs.paths, target.name);
    process.exit(exit.code);
};

void main();
