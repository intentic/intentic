#!/usr/bin/env node
// The in-sandbox one-time-code command — what a connector's skill teaches for services whose write path still
// asks for a 2FA code (npm publish --otp, a gateway's OTP prompt).
//
// It owns NO totp logic: the one call is the daemon's GET /capabilities/<name>/otp, which mints a code off the
// seed the owner stored on the capability card. The seed never crosses — this command only ever holds a code
// that dies within its period, which is the whole reason storing a second factor in the sandbox is tolerable.
//
// Auth is the per-boot agent token from /run/intentic/agent.token; auth/grants.ts admits it to exactly this
// mint (and /vpn), never to the routes that would reveal the stored credentials themselves.

import { readFileSync } from "node:fs";

const TOKEN_PATH = "/run/intentic/agent.token";
const base = `http://127.0.0.1:${process.env.SANDBOX_PORT ?? "8787"}`;

const USAGE = `otp — mint the current one-time code for a connected capability

  otp <name>        print the current TOTP code (e.g. otp npm → 492817)

The code goes to stdout alone, so it composes: npm publish --otp "$(otp npm)".
Seeds are stored by the sandbox owner on the capability's card; this command can only mint codes, never read them.`;

const die = (message) => {
    process.stderr.write(`${message}\n`);
    process.exit(1);
};

// Read lazily, not at startup: `otp --help` has to work in any shell, including one where the daemon isn't
// running yet — only an actual call needs the token.
const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return die(`otp: no daemon token at ${TOKEN_PATH} — is the intentic daemon running in this container?`);
    }
};

const main = async () => {
    const argv = process.argv.slice(2);
    const [name] = argv.filter((arg) => !arg.startsWith("--"));
    if (name === undefined || argv.includes("--help") || argv.includes("-h")) {
        process.stdout.write(`${USAGE}\n`);
        return;
    }
    const response = await fetch(`${base}/capabilities/${encodeURIComponent(name)}/otp`, {
        headers: { "x-intentic-agent": token() },
    }).catch((error) => die(`otp: cannot reach the daemon at ${base} (${error.message})`));
    const body = await response.json().catch(() => null);
    if (!response.ok) {
        die(`otp: ${body?.message ?? body?.error ?? `request failed (${response.status})`}`);
    }
    // The code alone on stdout so $(otp <name>) substitutes cleanly; the freshness note rides stderr, where a
    // human sees it and a substitution never picks it up.
    if (body.secondsRemaining <= 5) {
        process.stderr.write(`otp: this code expires in ${body.secondsRemaining}s — if it is refused, mint a fresh one\n`);
    }
    process.stdout.write(`${body.code}\n`);
};

await main();
