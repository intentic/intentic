#!/usr/bin/env bash
# tmux-run [-e NAME]... [-b JOB-DIR] <session> <command-string> [window-name]
# tmux-run [-e NAME]... [-b JOB-DIR] -f <dir>/line <session>
#
# Runs <command-string> inside a new window of tmux session <session> so the web terminal panel can watch
# it live (and type into it — the command's stdin is the pane tty), while this wrapper streams the combined
# output to its own stdout and exits with the command's real exit code. Two callers: the agent's PreToolUse
# hook (src/agent/tools/agent-terminals.ts) rewrites every Bash tool command through it, and the daemon's terminal
# runner (src/terminal/terminal-run.ts) executes user-triggered flows (capabilities, infra check) through it.
#
# -e NAME forwards NAME from this wrapper's OWN environment onto the new window (tmux new-window -e). The
# pane's shell otherwise inherits the tmux SERVER's env snapshot from whenever the server first started, so
# per-turn values (capability credentials, extension PATH) would be missing or stale there. Name-only flags
# keep values — including secrets — out of every argv, pane text, and the persisted pane logs; both callers
# already have the values in this wrapper's environment, which is also what the no-tmux fallback path sees.
# Invalid or unset names are skipped (fail open).
#
# -f hands the command over BY FILE, which is how the agent's hook calls it: `line` is what the pane runs, and beside
# it `said` is the command as the agent wrote it (the output filter's subject: which cleaners match, which un-cleaned
# commands deserve a handler) and `name` the window's name. None of it rides an argv — not this wrapper's, not the
# CLI's shell that starts it, not the pane's — because `pkill -f PATTERN` matches every process's whole command line,
# and an agent command naming a pattern used to kill its own call through whichever of those carried it. The file's
# directory is this run's capture dir, owned and removed like one this wrapper made (or the job dir under -b).
#
# -b names the capture dir for a BACKGROUND JOB (Bash `run_in_background: true`), minted by the caller
# instead of by mktemp here, because the daemon has to be able to read the job's completion after this
# wrapper is gone (src/agent/tools/background-jobs.ts polls $JOB-DIR/status).
#
# A background job is the ONE case where this wrapper dying must not take the command with it. Intentic runs
# every turn as its own short-lived CLI process, and that process SIGTERMs its background shells on the way
# out — so the ordinary TERM trap below, which kills the pane to match the plain Bash tool's timeout
# semantics, turned "keeps running across turns" into "dies fifteen seconds after the turn ends", silently.
# Under -b the trap therefore leaves the pane (and the capture dir) alone, and the soft timeout is off: the
# pane outlives the turn, and the daemon reads the status file whenever it lands.
#
# Capture is a plain file fed by `tee` inside the pane, NOT pipe-pane: a pane supports only one pipe-pane
# and the global per-pane log hooks (src/logs/log-files.ts) already own it — creating the window triggers
# those hooks, so commands land in the terminal history logs for free.
set -u

envflags=()
agentcmd=""
jobdir=""
cmdfile=""
while getopts e:b:f: opt; do
    case "$opt" in
        # Regex first: [[ ]] short-circuits, so an invalid name never reaches the (fatal under bash) indirect
        # expansion. Indirection, not printenv: command substitution would strip trailing newlines.
        e) [[ "$OPTARG" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n "${!OPTARG+x}" ]] && envflags+=(-e "$OPTARG=${!OPTARG}") ;;
        b) jobdir="$OPTARG" ;;
        f) cmdfile="$OPTARG" ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))

session="$1"
if [ -n "$cmdfile" ]; then
    # -f: everything about the command comes from files beside the line, never from argv (see the header). A name or
    # words file that is not there reads as the defaults below.
    cmddir="$(dirname "$cmdfile")"
    cmd="$(cat "$cmdfile" 2>/dev/null)"
    name="$(cat "$cmddir/name" 2>/dev/null)"
    name="${name:-run}"
    agentcmd="$(cat "$cmddir/said" 2>/dev/null)"
else
    cmd="$2"
    name="${3:-run}"
fi
# What the filter is told this command IS. Only the filter sees it — the pane runs, logs and reports $cmd.
: "${agentcmd:=$cmd}"

# WHEN THIS DID NOT RUN WHERE IT WAS MEANT TO, SAY SO.
#
# Fail open: any tmux failure below must degrade to running the command plainly, never break the caller. That
# part is right and stays. What was wrong was doing it SILENTLY. A degraded run is indistinguishable from an
# ordinary one — same stdout, same exit code — while the pane, the capture file, the output filter and the
# terminal log are all absent, and the pane's own `nsenter` (which is what puts the command in the turn's view)
# is gone with them. So a command that ran somewhere other than where it asked to reported nothing about it,
# and every occurrence had to be re-derived from first principles: the pre-land gate's "oxlint: not found" cost
# four turns of guessing at a mechanism nobody could see.
#
# One line is the whole fix. It cannot repair anything; it names what happened at the moment it happens, which
# is the difference between a diagnosable fault and a mystery.
fallback() {
    reason="${1:-tmux unavailable}"
    # Asked only on the way out, so a healthy command pays nothing for it. A namespace this wrapper was told to
    # reach tmux from and cannot is the cause of everything above, and the one condition invisible from outside.
    if [ -n "${INTENTIC_TMUX_NS:-}" ] && ! nsenter "--mount=$INTENTIC_TMUX_NS" -- true 2>/dev/null; then
        reason="$reason; mount namespace $INTENTIC_TMUX_NS is unreachable"
    fi
    # stderr, not stdout: stdout is the tool RESULT and belongs to the command. And `--`, because the line
    # starts with dashes.
    printf -- '--- intentic: ran outside a terminal pane (%s): no live view, no capture, no output filter\n' "$reason" >&2
    # A background job's status file is the daemon's ONLY completion signal, so even the degraded path publishes
    # one — otherwise an adopted watch polls for a file no path left behind and reports a timeout for a command
    # that finished. Same atomic rename the pane runner uses, for the same reason.
    # A command handed over by file runs from that file, so the degraded path puts it in no argv either.
    run=(bash -c "$cmd")
    [ -n "$cmdfile" ] && run=(bash "$cmdfile")
    if [ -n "$jobdir" ]; then
        mkdir -p "$jobdir" 2>/dev/null
        "${run[@]}" 2>&1 | tee -a "$jobdir/out"
        code=${PIPESTATUS[0]}
        echo "$code" > "$jobdir/status.part" && mv "$jobdir/status.part" "$jobdir/status"
        exit "$code"
    fi
    exec "${run[@]}"
}

# EVERY tmux call below is made from the mount namespace named by $INTENTIC_TMUX_NS (set per turn by
# src/agent/run/agent.ts, and only for an isolated one).
#
# A tmux client that finds no server running FORKS one, and that server keeps the mounts of whoever forked it
# — forever, for every pane it ever creates. This wrapper is such a client and the agent's Bash hook runs it
# INSIDE the turn's namespace, where /work is that one conversation's worktree. So the first Bash command of
# the first isolated turn to find no server hands its private /work to the server, and from then on the
# OWNER's own web terminals open in a stranger's worktree, on its branch, with the main checkout nowhere on
# the filesystem and `git checkout main` refusing ("already checked out"). A turn's isolation is supposed to
# be invisible from outside it; this was it leaking out and outliving the turn.
#
# So the client hops OUT to the daemon's namespace first and the server is pinned there for good. The turn's
# own namespace is re-entered one level in, by the nsenter inside the pane's command line
# (src/agent/tools/agent-terminals.ts) — the pane still runs the command in the worktree. Unset var (the daemon's
# own runner, an unisolated turn) means this process is already where the server belongs, so there is no hop.
# Resolved to a path once because the wrapper below calls the FUNCTION, which must not find itself by name.
tmuxbin="$(command -v tmux)" || fallback "no tmux on PATH"
hop=()
[ -n "${INTENTIC_TMUX_NS:-}" ] && hop=(nsenter "--mount=$INTENTIC_TMUX_NS" --)
tmux() { ${hop[@]+"${hop[@]}"} "$tmuxbin" "$@"; }

# Named so the daemon's temp sweep can attribute it (platform/reaper.ts matches the intentic-run- prefix):
# the soft-timeout path below deliberately leaves this dir behind for the still-running command to tee into,
# and a SIGKILLed wrapper skips its trap — both used to be permanent /tmp residents.
if [ -n "$jobdir" ]; then
    mkdir -p "$jobdir" || fallback "job capture dir $jobdir could not be created"
    d="$jobdir"
elif [ -n "$cmdfile" ]; then
    # The caller's own intentic-run- dir, which this wrapper then owns and removes like one it made.
    d="$cmddir"
else
    d="$(mktemp -d "${TMPDIR:-/tmp}/intentic-run-XXXXXXXX")" || fallback "no capture dir under ${TMPDIR:-/tmp}"
fi
printf '%s\n' "$cmd" > "$d/cmd"
: > "$d/out"
# Runner executed inside the pane. tee mirrors output to the pane tty AND the capture file; PIPESTATUS[0]
# preserves the command's exit code through the pipe.
#
# remain-on-exit (keeps the finished command's output readable until the next command prunes it) is set from
# INSIDE the pane, on the pane's own window, before the command runs — the only race-free moment. Setting it
# from the wrapper after creating the window loses to any fast command: tmux destroys the window the instant
# the child exits, so `echo hi` was gone before the option landed — taking the whole session with it now that
# no bootstrap shell holds it open. Here the window cannot have exited: its own shell is what runs this line.
#
# remain-on-exit-format is the epitaph tmux leaves in the dead pane, and it is READ BY THE USER: it's the last
# line of every finished terminal in the web panel. tmux's default — "Pane is dead (status 0, Wed Jul 29
# 13:07:37 2026)" — narrates a SUCCESS in the vocabulary of a crash, which is exactly the wrong first thing to
# find when you open the panel after a turn. Say what happened instead, and let the colour carry the verdict.
# (tmux >= 3.2; the image ships 3.3a. `2>/dev/null` keeps an older tmux failing open, as the line above does.)
#
# The runner then EXITS WITH THE COMMAND'S CODE rather than falling off the end at 0. That code is the only
# thing that makes `pane_dead_status` mean anything: the epitaph above reads it, and so does the terminals list
# (src/system/system.routes.ts paneStates). It changes nothing
# else — `remain-on-exit on` keeps the window whatever the status, and the wrapper's own exit code still comes
# from the status file below, which is written first so a failure can't lose it.
#
# THE STATUS FILE IS PUBLISHED BY RENAME, never written in place. The wait loop below treats the file's
# EXISTENCE as "the command is finished and its code is readable", and `> $d/status` cannot honour that: the
# redirection creates the file empty and the shell writes the digit into it a moment later, so a loaded machine
# can schedule the poll into that gap. The reader then saw an empty status for a command that had SUCCEEDED,
# and handed its caller `exit ""` — which bash refuses ("numeric argument required") by exiting 2. That is how a
# clean `git clone` came back as "exited 2" with its own untroubled output attached, once in a full test run and
# never on a re-run. `mv` within one directory is atomic, so the file appears already complete or not at all.
# The sweep the runner ends with (see below): every process of the pane's session but the runner and its tee. `left`
# re-reads the session each pass and keeps only pids still alive, since the ps and awk it runs are in the session too,
# and never its own subshell.
sweep='left() { for p in $(ps -e -o pid=,sid= | awk -v s=$$ -v t="$teepid" '"'"'$2==s && $1!=s && $1!=t {print $1}'"'"'); do [ "$p" != "$BASHPID" ] && [ -d "/proc/$p" ] && echo "$p"; done; }
pids=$(left)
if [ -n "$pids" ]; then
kill -TERM $pids 2>/dev/null
for _ in $(seq 30); do sleep 0.1; pids=$(left); [ -z "$pids" ] && break; done
[ -n "$pids" ] && kill -KILL $pids 2>/dev/null
fi'
epitaph='#{?#{==:#{pane_dead_status},0},#[fg=green]✓ finished,#[fg=red]✗ #{?#{!=:#{pane_dead_signal},},signal #{pane_dead_signal},exit #{pane_dead_status}}}#[default] · #{t:pane_dead_time}'
# INTENTIC_PIPESTATUS_FILE is where the agent hook's EXIT trap (PIPESTATUS_TRAP, src/agent/tools/agent-terminals.ts)
# leaves the per-stage statuses of the command's last pipeline, for the filter to report a failure `| tail` hid.
#
# WHAT THE COMMAND LEAVES BEHIND IS ENDED WITH IT. The runner is its pane's session leader (tmux starts every pane
# with setsid), and nothing on a command's path starts a session of its own, so every process the command started is
# in this session: including the ones in process groups of their own, which is every turbo task and every `bun test`
# worker. A kill by process group (a `timeout`, a hangup) never reaches those, and a test run whose parent died kept
# forking workers for thirteen minutes on 2026-09-25 while the next run started beside it. So once the command
# returns, the runner ends the rest of its session (TERM, three seconds, KILL) before it publishes the status: a job
# that is finished has nothing left running. The output goes through a process substitution rather than a pipe so the
# runner learns the command returned even while a leftover still holds the output open, and tee is waited for after
# the sweep, so the status still means the capture is complete.
printf 'tmux set-option -w -t "$TMUX_PANE" remain-on-exit on 2>/dev/null\ntmux set-option -w -t "$TMUX_PANE" remain-on-exit-format %q 2>/dev/null\nexport INTENTIC_PIPESTATUS_FILE=%q/pipestatus\nexec 3> >(exec tee -a %q/out)\nteepid=$!\nbash %q/cmd >&3 2>&1\ncode=$?\nexec 3>&-\n%s\nwait "$teepid" 2>/dev/null\necho "$code" > %q/status.part\nmv %q/status.part %q/status\nexit $code\n' "$epitaph" "$d" "$d" "$d" "$sweep" "$d" "$d" "$d" > "$d/runner"

# The persistent pane log (written by the global pipe-pane hooks, src/logs/log-files.ts, VT-rendered to clean
# text by pane-log-clean) — the filter's footer points the agent here for the full output. Path known only
# after the pane exists; the session
# name already satisfies the hooks' sanitized charset, so session-pane composes the exact hook filename.
logfile=""

# Emit the captured output as the tool result, noise-filtered when the filter is present ($1 = exit code
# for its success/failure asymmetry). The filter buffers and writes once, so a failure can't half-emit;
# missing binary, opt-out, or a filter error all degrade to the raw capture — tail-capped when the caller
# bounds what ships over stdout (the full output stays in the pane + pane log).
emit() {
    # The filter is swappable for A/B benchmarking: INTENTIC_FILTER_CMD names any stdin→stdout filter (raw
    # output in, compacted out) and defaults to agent-output-filter.
    filter="${INTENTIC_FILTER_CMD:-agent-output-filter}"
    if [ "${INTENTIC_RUN_FILTER:-1}" != "0" ] && command -v "$filter" >/dev/null 2>&1; then
        "$filter" "$agentcmd" "$1" "$SECONDS" "$logfile" "$(cat "$d/pipestatus" 2>/dev/null)" < "$d/out" 2>/dev/null && return
    fi
    if [ -n "${INTENTIC_RUN_OUTPUT_BYTES:-}" ]; then
        tail -c "$INTENTIC_RUN_OUTPUT_BYTES" "$d/out" 2>/dev/null
    else
        cat "$d/out" 2>/dev/null
    fi
}

# New ACTIVE window (an attached client follows the newest command). This command IS the session's first
# window when the session doesn't exist yet: a bare `tmux new-session` would leave a shell running in window 0
# forever, and one never-dying pane makes the daemon read the whole session as `running` for good (paneStates,
# src/system/system.routes.ts) — so a finished agent's session would never dim, and the panel's "clear
# finished terminals" sweep could never take it. Both creation forms take the same flags; nothing needs the
# shell window, since agent/job sessions are attach-only (src/terminal/terminal.ts).
window=(-P -F '#{pane_id}' -n "$name" -c "$PWD" ${envflags[@]+"${envflags[@]}"} "bash $d/runner")
attach() { tmux new-window -t "=$session:" "${window[@]}"; }
create() { tmux new-session -d -s "$session" "${window[@]}"; }
# Which form is right depends on whether the session exists RIGHT NOW — and concurrent commands flip that under
# us in BOTH directions: two first commands race to create it, and the prune below destroys a session whose
# windows are all dead just as another command is about to add one to it. So both forms are always tried,
# starting with the one has-session makes likely. Only the FIRST attempt's stderr is dropped — that is the
# expected racy miss ("duplicate session" / "can't find session"); the retry's failure is the real one and must
# reach the caller, and only then does fail-open drop the command out of tmux entirely.
if tmux has-session -t "=$session" 2>/dev/null; then
    pane="$(attach 2>/dev/null)" || pane="$(create)" || fallback "tmux would not open a window in session $session"
else
    pane="$(create 2>/dev/null)" || pane="$(attach)" || fallback "tmux would not open a window in session $session"
fi
[ -n "${INTENTIC_TERMINAL_LOGS_DIR:-}" ] && logfile="$INTENTIC_TERMINAL_LOGS_DIR/$session-$pane.log"

# Stamp the session with the conversation that owns it (a tmux user option the daemon's reaper lists by —
# platform/reaper.ts). On the SESSION rather than in any pane's environment, because the fact has to outlive
# every pane: a session whose commands have all finished has no process left to read an environ from. The
# stamp arrives in this wrapper's own environment, inherited from the turn's CLI (agent.ts workloadStamp).
# `=<name>:` — set-option refuses the bare `=<name>` exact form ("no such session"); the trailing colon makes
# it read the target as a SESSION, exactly as capture-pane needs (src/terminal/terminal-session.ts).
# Idempotent per command; best-effort like everything else here.
[ -n "${INTENTIC_TURN_OWNER:-}" ] && tmux set-option -t "=$session:" @intentic_owner "$INTENTIC_TURN_OWNER" 2>/dev/null

# Prune windows of finished commands, so the last output stays readable until the next command but dead
# windows don't accumulate. AFTER this command's window exists, never before: with no bootstrap shell holding
# the session open, a session whose windows are ALL dead (every command finished) would be destroyed by its
# own prune, and the creation above would then have no session to add a window to.
# Concurrent commands can both observe the same dead window; the first kill wins and the second target is gone.
# That cleanup race is expected, so keep tmux's "can't find window" diagnostic out of an unrelated tool result.
# A read loop rather than `xargs tmux`: xargs execs the BINARY it is given and would walk straight past the
# namespace hop the function above exists to make.
tmux list-panes -s -t "=$session" -F '#{pane_dead} #{window_id}' 2>/dev/null \
    | awk '$1==1{print $2}' | while read -r dead; do tmux kill-window -t "$dead" 2>/dev/null; done

# A SIGTERM (the SDK's Bash timeout, or the daemon runner's abort/watchdog) takes the pane down with the
# wrapper so timeout semantics match the plain Bash tool, and still returns whatever the command printed
# before the kill. Down means the pane's whole session: closing the window hangs up only its foreground process
# group, and a turbo task or a `bun test` worker is in a group of its own (see the runner's sweep above). (A SIGKILLed wrapper leaves the pane running visibly; prune or the user cleans it up.)
#
# Except for a background job (-b), where the SIGTERM that arrives is the turn's own CLI exiting, not a
# timeout: killing the pane there is what made `run_in_background` a promise the sandbox could not keep. The
# capture dir stays too — the daemon reads the status file out of it long after this process is gone.
endpane() {
    local leader
    leader="$(tmux display -p -t "$pane" '#{pane_pid}' 2>/dev/null)"
    [ -n "$leader" ] && pkill -TERM -s "$leader" 2>/dev/null
}
if [ -n "$jobdir" ]; then
    trap 'emit 143; exit 143' TERM INT
else
    trap 'endpane; tmux kill-window -t "$pane" 2>/dev/null; emit 143; rm -rf "$d"; exit 143' TERM INT
fi

# Completion is the status file, not tail/pane timing: the runner writes it strictly AFTER `tee` closes
# $d/out (line above), so once it exists the captured output is complete and flushed — no tail-follow,
# inotify, or flush-window race. Pane liveness stays only as the kill escape hatch: a user ×-killing the
# session would otherwise hang this wrapper — and its caller — forever waiting for a status that never comes.
# Soft timeout for long-running commands (dev servers, watch, tail -f): return early with the output so
# far and a follow handle instead of hanging until the SDK's Bash timeout kills the pane. The pane (and
# $d — the runner still tees into it) stays alive; the dead-window prune sweeps it once it exits. Default
# sits under the SDK's 2-minute Bash timeout; 0 disables (the daemon runner blocks to real completion).
soft="${INTENTIC_RUN_SOFT_TIMEOUT_S:-110}"
# A background job has no SDK Bash timeout to beat, and returning early would report it FINISHED to a caller
# that asked to be told when it exits; it waits for the real status, and the turn ending is what releases it.
[ -n "$jobdir" ] && soft=0
while [ ! -f "$d/status" ]; do
    if [ "$soft" -ge 1 ] 2>/dev/null && [ "$SECONDS" -ge "$soft" ]; then
        emit running
        printf '\n--- command still running in tmux window %s · follow: %s\n' "$name" "${logfile:-$d/out}"
        exit 0
    fi
    [ "$(tmux display -p -t "$pane" '#{pane_dead}' 2>/dev/null)" = "0" ] && { sleep 0.05; continue; }
    # Pane gone/dead: a normal fast exit writes status just before the pane dies, so give it a brief grace.
    for _ in 1 2 3 4 5; do [ -f "$d/status" ] && break; sleep 0.05; done
    break
done
# Missing status file means the pane was killed mid-command — report failure honestly. Anything that is not a
# plain number is the same kind of nothing and reports the same way: the code is about to be handed to `exit`,
# which turns any non-number into a 2 of its own invention — a code the command never returned, attached to
# whatever the command actually printed. A wrapper that cannot read a result must say "failed", not make one up.
code="$(cat "$d/status" 2>/dev/null)"
case "$code" in '' | *[!0-9]*) code=1 ;; esac
# Emit the complete captured output once — the SDK captures this stdout as the whole Bash tool result.
emit "$code"
# A job dir is the daemon's, not this wrapper's: the adoption may not have read the status yet, and the tmp
# sweep (platform/boot/reaper.ts, `intentic-run-` prefix) reclaims it on its own clock.
[ -n "$jobdir" ] || rm -rf "$d"
exit "$code"
