#!/usr/bin/env node
// The in-sandbox INBOX command, kept as a name for `messages` (2026-11-27, docs/architecture/account-routing.md, "A
// drop"): what another sandbox drops here arrives as a message in that sender's thread, whichever way it came, so the
// threads are where it is read. `inbox`, `inbox show <thread>` and `inbox take <message> <folder>` run the very same
// `messages` verbs; a thread is let go on the Messages tab.

import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const NOTE = "inbox: drops now arrive as messages, so this runs `messages` (threads by id: `messages show <thread>`, `messages take <message> <folder>`).";

const [verb, ...args] = process.argv.slice(2);
if (verb === "delete" || verb === "rm") {
    process.stderr.write(`${NOTE}\ninbox: a thread is deleted on the Messages tab; \`messages\` keeps what arrived.\n`);
    process.exit(1);
}
process.stderr.write(`${NOTE}\n`);
const forwarded = verb === undefined || verb === "ls" ? [] : [verb, ...args];
const ran = spawnSync(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), "messages"), ...forwarded], { stdio: "inherit" });
process.exit(ran.status ?? 1);
