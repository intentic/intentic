#!/usr/bin/env node
// The in-sandbox premium-services command — how an agent discovers the platform's metered services and asks
// to run one. The ASK is the whole of it: `run` parks on the daemon while an approval card goes up in the
// owner's chat (platform/service-offer.ts), with the price and today's balance drawn from the platform's own
// catalog, and the request is forwarded only when the owner clicks yes. The agent never quotes a number the
// card doesn't already show, and cannot spend without the click — the consent step is plumbing, not etiquette.
//
// It owns NO economics: both calls relay through the daemon to the platform, which holds the member gate,
// the daily credit meter, the spend-before-call-refund-on-failure discipline, and the signed forward to the
// provider. What this command adds is a terminal-shaped surface — `list` prints lines an agent can quote,
// `run` prints the provider's JSON to stdout alone so it composes into pipes, with the credits line on
// stderr where it can't corrupt the data.
//
// node:http rather than fetch, deliberately: a parked `run` holds its connection for as long as the owner
// takes to answer (bounded by the daemon's own deadline), and undici's default header timeout would kill the
// wait at five minutes with the card still up.
//
// Auth is the per-boot agent token from /run/intentic/agent.token; auth/grants.ts admits it to exactly the
// two /pool/services routes (and its /vpn + /otp reach), never to anything credential-shaped.

import { readFileSync } from "node:fs";
import { request } from "node:http";

const TOKEN_PATH = "/run/intentic/agent.token";
const PORT = process.env.SANDBOX_PORT ?? "8787";

// The conversation this shell was spawned for (platform/leftovers.ts workloadStamp) — what tells the daemon
// WHOSE chat the approval card belongs in. The daemon falls back to the sole live turn when it is unset.
const CONVERSATION = process.env.INTENTIC_TURN_OWNER ?? "";

const USAGE = `services — the platform's premium services, priced in the owner's membership credits

  services list                             what exists, what a run costs, and what's left today
  services run <slug> [json] [--why "..."]  ask for one metered run; the request body is the JSON
                                            argument or stdin, --why is your one-line case for it

\`run\` raises an approval card in the owner's chat — price and remaining credits on it, straight from the
platform — and waits. The owner's click is the only thing that releases the spend: a skip or an expired
offer charges nothing and answers with a sentence to act on. One click covers one run; ask again to repeat.
An approved run streams its progress onto that same card (up to five minutes — hold this command open) and
prints its result here when it completes. Nothing is charged when a service fails to answer.`;

const die = (message) => {
    process.stderr.write(`${message}\n`);
    process.exit(1);
};

// Read lazily, not at startup: `services --help` has to work in any shell, including one where the daemon
// isn't running yet — only an actual call needs the token.
const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return die(`services: no daemon token at ${TOKEN_PATH} — is the intentic daemon running in this container?`);
    }
};

// One loopback call, held open for as long as the daemon holds it — no timeout on purpose (see the header
// note above). Resolves with whatever the daemon answered; only a transport failure rejects.
const call = (method, path, body) =>
    new Promise((resolve, reject) => {
        const req = request({ host: "127.0.0.1", port: PORT, path, method }, (response) => {
            let raw = "";
            response.on("data", (chunk) => {
                raw += chunk.toString();
            });
            response.on("end", () =>
                resolve({
                    status: response.statusCode ?? 502,
                    text: raw,
                    remaining: response.headers["x-intentic-credits-remaining"] ?? null,
                }),
            );
        });
        req.on("error", reject);
        req.setHeader("x-intentic-agent", token());
        if (CONVERSATION !== "") {
            req.setHeader("x-intentic-conversation", CONVERSATION);
        }
        if (body !== undefined) {
            req.setHeader("content-type", "application/json");
        }
        req.end(body);
    });

// The platform's refusals arrive as {error: {message}} or {error: string} — surface the sentence, which is
// already written for the person reading the chat.
const refusalOf = (text) => {
    try {
        const parsed = JSON.parse(text);
        if (typeof parsed?.error === "string") return parsed.error;
        if (typeof parsed?.error?.message === "string") return parsed.error.message;
    } catch {
        // Not JSON — fall through to the raw text.
    }
    return text || "the platform did not say why";
};

const list = async () => {
    const { status, text } = await call("GET", "/pool/services");
    if (status !== 200) {
        return die(`services: ${refusalOf(text)}`);
    }
    const { services, credits, member } = JSON.parse(text);
    if (!Array.isArray(services) || services.length === 0) {
        process.stdout.write("No premium services are listed on this platform.\n");
        return;
    }
    for (const service of services) {
        // `new` is the probation badge — a listing the platform admitted on its mechanical gates that has not
        // served enough runs to graduate. Said here as well as on the approval card, because the agent choosing
        // between two services should be able to weigh it before it asks.
        const badge = service.probation === true ? ", new" : "";
        process.stdout.write(
            `${service.slug} — ${service.name}: ${service.description} (${service.creditsPerRun} credits/run, by ${service.publisher}${badge})\n`,
        );
        // The provider's own worked example of the request shape. Worth more than any prose about it.
        if (typeof service.sampleRequest === "string" && service.sampleRequest !== "" && service.sampleRequest !== "{}") {
            process.stdout.write(`    example request: ${service.sampleRequest}\n`);
        }
    }
    if (credits !== undefined) {
        process.stdout.write(`\nCredits: ${credits.remaining} of ${credits.allowance} left today (resets ${credits.resetsAt}).\n`);
    } else if (member === false) {
        process.stdout.write("\nRunning these needs an intentic membership (Settings → Membership).\n");
    }
};

const readStdin = async () => {
    let raw = "";
    for await (const chunk of process.stdin) {
        raw += chunk;
    }
    return raw;
};

const run = async (args) => {
    // `--why` can sit anywhere after `run`; what remains is `<slug> [json]` in order.
    const rest = [];
    let why;
    for (let i = 0; i < args.length; i += 1) {
        if (args[i] === "--why") {
            why = args[i + 1] ?? "";
            i += 1;
        } else {
            rest.push(args[i]);
        }
    }
    const [slug, inline] = rest;
    if (slug === undefined) {
        return die(USAGE);
    }
    const body = inline ?? (process.stdin.isTTY ? "{}" : await readStdin());
    try {
        JSON.parse(body);
    } catch {
        return die(`services: the request body must be JSON, got: ${body.slice(0, 120)}`);
    }
    const query = why !== undefined && why !== "" ? `?why=${encodeURIComponent(why)}` : "";
    const { status, text, remaining } = await call("POST", `/pool/services/${encodeURIComponent(slug)}/run${query}`, body);
    if (status < 200 || status >= 300) {
        return die(`services: ${refusalOf(text)}`);
    }
    process.stdout.write(`${text}\n`);
    if (remaining !== null) {
        process.stderr.write(`(${remaining} credits left today)\n`);
    }
};

const main = async () => {
    const [command, ...rest] = process.argv.slice(2);
    if (command === "list") {
        return list();
    }
    if (command === "run") {
        return run(rest);
    }
    return die(USAGE);
};

main().catch((error) => die(`services: ${error?.message ?? error}`));
