#!/usr/bin/env node
// The in-sandbox network-disk command — what the agent's skill teaches and what an owner can run in a terminal tab.
//
// It deliberately owns NO mount logic: every subcommand is one call to the daemon's /netdisk routes, which are
// the same routes the browser's Network disk card drives. That is the whole point — a disk the agent mounts
// appears in the UI, a disk the user unmounts disappears for the agent, and there is exactly one implementation
// of what mounting means (see _sandbox/sandbox/src/netdisk/).
//
// Auth is the per-boot agent token from /run/intentic/agent.token, which auth/grants.ts admits to /netdisk
// (beside /vpn and bin/otp's code mint). So this command can mount and unmount the disks the owner configured,
// and cannot read the credentials behind them.

import { readFileSync } from "node:fs";

const TOKEN_PATH = "/run/intentic/agent.token";
const base = `http://127.0.0.1:${process.env.SANDBOX_PORT ?? "8787"}`;

const USAGE = `netdisk — inspect, mount and unmount this sandbox's network disks

  netdisk list                      every configured disk with its live state
  netdisk status <name>             one disk, same detail
  netdisk mount <name>              mount it under /mnt/netdisk/<name>
  netdisk unmount <name>            let it go

  --json                            machine-readable output for list/status

Disks are configured by the sandbox owner under Capabilities ▸ Network disk.`;

const die = (message) => {
    process.stderr.write(`${message}\n`);
    process.exit(1);
};

// Read lazily, not at startup: `netdisk --help` has to work in any shell, including one where the daemon isn't
// running yet — only an actual call needs the token.
const token = () => {
    try {
        return readFileSync(TOKEN_PATH, "utf8").trim();
    } catch {
        return die(`netdisk: no daemon token at ${TOKEN_PATH} — is the intentic daemon running in this container?`);
    }
};

const call = async (path, init = {}) => {
    const response = await fetch(`${base}${path}`, {
        ...init,
        headers: { "x-intentic-agent": token(), ...(init.body === undefined ? {} : { "content-type": "application/json" }), ...init.headers },
    }).catch((error) => die(`netdisk: cannot reach the daemon at ${base} (${error.message})`));
    return response;
};

// A non-2xx from the daemon carries its own message — surface that rather than a bare status code.
const failure = async (response) => {
    const body = await response.json().catch(() => null);
    return body?.message ?? body?.error ?? `request failed (${response.status})`;
};

const readJson = async (path) => {
    const response = await call(path);
    if (!response.ok) {
        die(`netdisk: ${await failure(response)}`);
    }
    return response.json();
};

// "14m" / "3h 20m" / "2d 4h" — an uptime a human reads at a glance.
const ago = (since) => {
    if (typeof since !== "number") {
        return undefined;
    }
    const minutes = Math.max(0, Math.round((Date.now() - since) / 60000));
    if (minutes < 60) {
        return `${minutes}m`;
    }
    const hours = Math.floor(minutes / 60);
    return hours < 24 ? `${hours}h ${minutes % 60}m` : `${Math.floor(hours / 24)}d ${hours % 24}h`;
};

const STATE_MARK = { mounted: "●", unmounted: "○", unavailable: "◌" };

const renderLink = (link) => {
    const head = `${STATE_MARK[link.state] ?? "○"} ${link.id}  ${link.state}  (${link.provider} · ${link.target})`;
    const facts = [
        `at ${link.mountPoint}`,
        link.state === "mounted" ? (link.writable ? "read-write" : "read-only") : `${link.access === "read" ? "read-only" : "read-write"} when mounted`,
        ago(link.since) ? `up ${ago(link.since)}` : undefined,
        link.autoMount ? "mounts on start" : undefined,
    ].filter(Boolean);
    return [head, ...(facts.length > 0 ? [`    ${facts.join(" · ")}`] : []), ...(link.detail ? [`    ${link.detail}`] : [])].join("\n");
};

// The daemon streams a mount as SSE `data: <json>` frames (the shared IntenticLine shape). Printed as they
// arrive so a slow server shows progress instead of silence, and an error frame ends the command non-zero.
const streamMount = async (id) => {
    const response = await call(`/netdisk/${encodeURIComponent(id)}/mount`, { method: "POST", body: "{}" });
    if (!response.ok || response.body === null) {
        die(`netdisk: ${await failure(response)}`);
    }
    let buffer = "";
    let failed;
    for await (const chunk of response.body) {
        buffer += Buffer.from(chunk).toString("utf8");
        // SSE frames are blank-line separated; keep the trailing partial in the buffer.
        const frames = buffer.split("\n\n");
        buffer = frames.pop() ?? "";
        for (const frame of frames) {
            const data = frame
                .split("\n")
                .filter((line) => line.startsWith("data:"))
                .map((line) => line.slice(5).trim())
                .join("");
            if (data === "") {
                continue;
            }
            let line;
            try {
                line = JSON.parse(data);
            } catch {
                continue;
            }
            if (line.kind === "error") {
                failed = line.message ?? "mount failed";
            } else if (typeof line.message === "string") {
                process.stdout.write(`${line.message}\n`);
            }
        }
    }
    if (failed !== undefined) {
        die(`netdisk: ${failed}`);
    }
};

const main = async () => {
    const argv = process.argv.slice(2);
    const json = argv.includes("--json");
    const positional = argv.filter((arg) => !arg.startsWith("--"));
    const [command, name] = positional;

    if (command === undefined || command === "help" || argv.includes("--help") || argv.includes("-h")) {
        process.stdout.write(`${USAGE}\n`);
        return;
    }
    // Reject an unknown verb BEFORE the name check below, so a typo reads as a typo rather than as a
    // missing argument to a command that doesn't exist.
    if (!["list", "status", "mount", "unmount"].includes(command)) {
        die(`netdisk: unknown command "${command}"\n\n${USAGE}`);
    }

    if (command === "list") {
        const { links } = await readJson("/netdisk");
        if (json) {
            process.stdout.write(`${JSON.stringify(links, null, 2)}\n`);
            return;
        }
        process.stdout.write(
            links.length === 0
                ? "No network disks configured. The sandbox owner adds them under Capabilities ▸ Network disk.\n"
                : `${links.map(renderLink).join("\n")}\n`,
        );
        return;
    }

    if (name === undefined) {
        die(`netdisk: ${command} needs a disk name — run \`netdisk list\` to see them.`);
    }

    if (command === "status") {
        const { links } = await readJson("/netdisk");
        const link = links.find((candidate) => candidate.id === name);
        if (link === undefined) {
            die(`netdisk: no disk named "${name}" — run \`netdisk list\` to see them.`);
        }
        process.stdout.write(`${json ? JSON.stringify(link, null, 2) : renderLink(link)}\n`);
        return;
    }

    if (command === "mount") {
        await streamMount(name);
        return;
    }

    const response = await call(`/netdisk/${encodeURIComponent(name)}/unmount`, { method: "POST", body: "{}" });
    if (!response.ok) {
        die(`netdisk: ${await failure(response)}`);
    }
    process.stdout.write(`Unmounted ${name}.\n`);
};

await main();
