#!/usr/bin/env bash
# quiet [--idle N] [--pin N] [--wait SECONDS] [--max-hold SECONDS] -- <command> [args...]
#
# The quiet lane, for work whose result is a measurement of time: a benchmark, a profile, a capture whose frames must be
# steady. It first waits, holding nothing, for the machine to be calm (cores idle, counting only load from outside this
# sandbox), then until nothing else heavy runs in this sandbox, holds every NEW heavy command in this sandbox until it
# ends, and prints the conditions it ran under beside its result, so a number carries them:
#
#   [quiet] starting: 1.2 of 16 cores busy outside this sandbox (0.4 in it), load 3.1 4.0 6.2, pinned to cores 12,13. …
#   [quiet] exit 0 after 41.2s. Ran under: before, …; while it ran, everything else kept 0.4 cores busy (it used 3.9); after, load 4.1 3.9 6.0.
#
# (2026-11-19, the shinobi-society audit) Agents armed watches on /proc/loadavg, pinned with `taskset -c 0`, and wrapped
# commands in `flock /tmp/…lock` and `nice -n 19` by hand, and benchmarks were still spoiled by load: one kernel read
# 2.43 ns at load 30 and 1.65 ns at load 7. This is the same queue every heavy command takes (bin/queue-run, pool
# `quiet`, `--exclusive`), so it holds off every conversation's builds, not only this one's, and they wait for it the
# way they wait for each other; the calm wait, the pinning and the report are heavy-launch.cjs (@intentic/constants).
# (2026-11-24) The calm wait comes before the gate, so nothing in the sandbox waits on it, and it waits only while the
# outside load is easing: a load that holds steady is not waited out, the run starts and says it was NOT calm.
#
#   --idle N        cores that must be idle, counting only load from outside this sandbox (default: three quarters)
#   --pin N         pin it to the N idlest cores (taskset), and tell it N as INTENTIC_CPUS
#   --wait S        the most it waits for calm, and then for the heavy commands already running, before it runs anyway
#                   and says so (default 600)
#   --max-hold S    how long it may hold the sandbox before it is stopped (default 3600)
#
# A project marks its own timing-sensitive script quiet in its .intentic/heavy.json instead, and then it needs no prefix.
# Every failure (no queue-run, no node) runs the command plainly: this is never why a command did not run.
set -u

usage() {
    sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

idle=""
pin=""
wait_seconds=600
max_hold=3600
while [ $# -gt 0 ]; do
    case "$1" in
        --idle) idle="${2:-}"; shift 2 ;;
        --pin) pin="${2:-}"; shift 2 ;;
        --wait) wait_seconds="${2:-}"; shift 2 ;;
        --max-hold) max_hold="${2:-}"; shift 2 ;;
        -h | --help) usage ;;
        --) shift; break ;;
        -*) printf 'quiet: unknown option %s\n' "$1" >&2; usage ;;
        *) break ;;
    esac
done
[ $# -eq 0 ] && usage
digits() { case "$1" in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac; }
digits "$wait_seconds" || wait_seconds=600
digits "$max_hold" || max_hold=3600

launch=${INTENTIC_HEAVY_LAUNCH:-/opt/sandbox/node_modules/@intentic/constants/src/heavy/heavy-launch.cjs}
command=("$@")
# queue-run waits for calm with this launcher BEFORE it takes the gate, holding nothing (bin/queue-run, --calm-launcher).
calm_flags=()
if [ -f "$launch" ] && command -v node >/dev/null 2>&1; then
    calm_flags=(--calm-launcher "$launch")
    digits "$idle" && calm_flags+=(--calm-idle "$idle")
    launch_args=(--quiet --calm-wait "$wait_seconds" --label quiet)
    digits "$idle" && launch_args+=(--idle "$idle")
    digits "$pin" && [ "$pin" -gt 0 ] && launch_args+=(--cpus "$pin" --pin)
    command=(node "$launch" "${launch_args[@]}" -- "$@")
else
    printf '[quiet] no node or launcher here: running it without the calm wait or the report.\n' >&2
fi

if [ -n "${INTENTIC_QUEUE_GATE:-}${INTENTIC_HEAVY_HELD:-}" ]; then
    printf '[quiet] this runs inside a heavy command (%s) that already holds its place in the queue, so it cannot hold the others off from here; it still waits for calm and reports.\n' \
        "${INTENTIC_HEAVY_HELD:-${INTENTIC_QUEUE_GATE}}" >&2
    exec "${command[@]}"
fi
queue=${INTENTIC_QUEUE_RUN:-$(command -v queue-run 2>/dev/null)}
if [ -z "$queue" ] || [ ! -f "$queue" ]; then
    printf '[quiet] no queue-run here: other heavy commands are not held off.\n' >&2
    exec "${command[@]}"
fi
exec bash "$queue" --pool quiet --limit 1 --wait "$wait_seconds" --max-hold "$max_hold" --on-deadline run --label quiet --exclusive ${calm_flags[@]+"${calm_flags[@]}"} -- "${command[@]}"
