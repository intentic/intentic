{
    "name": "@intentic/extension-api",
    "version": "0.0.0",
    "description": "The versioned public API intentic extensions compile against — manifest schema, detection facts and the host API",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_sandbox/extension-api"
    },
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        },
        "./protocol": {
            "types": "./dist/protocol.d.ts",
            "import": {
                "@intentic/src": "./src/protocol.ts",
                "default": "./dist/protocol.js"
            },
            "require": {
                "@intentic/src": "./src/protocol.ts",
                "default": "./dist/protocol.js"
            }
        }
    },
    "scripts": {
        "build": "tsgo",
        "watch": "tsgo --build --watch"
    },
    "dependencies": {
        "@intentic/sandbox-contract": "workspace:*",
        "@orpc/contract": "catalog:",
        "tslib": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "vue": "catalog:"
    }
}
