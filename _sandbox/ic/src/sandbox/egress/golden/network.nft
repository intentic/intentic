# ic sandbox egress: one transaction, all or nothing
add table inet intentic_egress
add chain inet intentic_egress sbx_1e06b5c955e1_forward { type filter hook forward priority filter - 10; policy accept; }
delete chain inet intentic_egress sbx_1e06b5c955e1_forward
add chain inet intentic_egress sbx_1e06b5c955e1_input { type filter hook input priority filter - 10; policy accept; }
delete chain inet intentic_egress sbx_1e06b5c955e1_input
add chain inet intentic_egress sbx_1e06b5c955e1_refuse
delete chain inet intentic_egress sbx_1e06b5c955e1_refuse
table inet intentic_egress {
	# sandbox-2e8d89d75865 (network match)
	set sbx_1e06b5c955e1_b4p { type ipv4_addr . inet_proto . inet_service; flags dynamic,timeout; timeout 1h; size 4096; counter; }
	set sbx_1e06b5c955e1_b4o { type ipv4_addr . inet_proto; flags dynamic,timeout; timeout 1h; size 4096; counter; }
	set sbx_1e06b5c955e1_b6p { type ipv6_addr . inet_proto . inet_service; flags dynamic,timeout; timeout 1h; size 4096; counter; }
	set sbx_1e06b5c955e1_b6o { type ipv6_addr . inet_proto; flags dynamic,timeout; timeout 1h; size 4096; counter; }
	chain sbx_1e06b5c955e1_refuse {
		meta l4proto { tcp, udp } update @sbx_1e06b5c955e1_b4p { ip daddr . meta l4proto . th dport }
		meta l4proto != { tcp, udp } update @sbx_1e06b5c955e1_b4o { ip daddr . meta l4proto }
		meta l4proto { tcp, udp } update @sbx_1e06b5c955e1_b6p { ip6 daddr . meta l4proto . th dport }
		meta l4proto != { tcp, udp } update @sbx_1e06b5c955e1_b6o { ip6 daddr . meta l4proto }
		meta l4proto tcp reject with tcp reset
		reject with icmpx admin-prohibited
	}
	chain sbx_1e06b5c955e1_forward {
		type filter hook forward priority filter - 10; policy accept;
		ip saddr != { 172.20.0.0/16 } return
		ip6 saddr != { fd00:20::/64 } return
		ct state established,related accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, nd-redirect } accept
		# peers on its own networks
		ip daddr { 172.20.0.0/16 } accept
		ip6 daddr { fd00:20::/64 } accept
		# the machine's neverAllow, before any way through
		ip daddr { 192.168.1.1 } goto sbx_1e06b5c955e1_refuse
		# DNS to the resolvers docker forwards to
		ip daddr { 192.168.1.1 } meta l4proto { tcp, udp } th dport 53 accept
		# allow nas.lan
		ip daddr { 192.168.1.20 } tcp dport { 445, 8000-8100 } accept
		ip6 daddr { fd00::20 } tcp dport { 445, 8000-8100 } accept
		# allow 10.8.0.0/24
		ip daddr { 10.8.0.0/24 } accept
		# allow printer
		# printer did not resolve on the host: nothing opened
		# internet-only: every private range
		ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } goto sbx_1e06b5c955e1_refuse
		ip6 daddr { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b:1::/48, fc00::/7, fe80::/10, fec0::/10, ff00::/8 } goto sbx_1e06b5c955e1_refuse
	}
	chain sbx_1e06b5c955e1_input {
		type filter hook input priority filter - 10; policy accept;
		iifname "lo" return
		ip saddr != { 172.20.0.0/16 } return
		ip6 saddr != { fd00:20::/64 } return
		ct state established,related accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, nd-redirect } accept
		# the machine's neverAllow, before any way through
		ip daddr { 192.168.1.1 } goto sbx_1e06b5c955e1_refuse
		# DNS to the resolvers docker forwards to
		ip daddr { 192.168.1.1 } meta l4proto { tcp, udp } th dport 53 accept
		# allow nas.lan
		ip daddr { 192.168.1.20 } tcp dport { 445, 8000-8100 } accept
		ip6 daddr { fd00::20 } tcp dport { 445, 8000-8100 } accept
		# allow 10.8.0.0/24
		ip daddr { 10.8.0.0/24 } accept
		# allow printer
		# printer did not resolve on the host: nothing opened
		# allow host
		meta l4proto { tcp, udp } th dport { 11434 } accept
		# the host itself
		goto sbx_1e06b5c955e1_refuse
	}
}
