# ic sandbox egress: one transaction, all or nothing
add table inet intentic_egress
add chain inet intentic_egress sbx_00e13ed7af55_forward { type filter hook forward priority filter - 10; policy accept; }
delete chain inet intentic_egress sbx_00e13ed7af55_forward
add chain inet intentic_egress sbx_00e13ed7af55_input { type filter hook input priority filter - 10; policy accept; }
delete chain inet intentic_egress sbx_00e13ed7af55_input
add chain inet intentic_egress sbx_00e13ed7af55_refuse
delete chain inet intentic_egress sbx_00e13ed7af55_refuse
add set inet intentic_egress sbx_00e13ed7af55_b4p { type ipv4_addr . inet_proto . inet_service; flags dynamic,timeout; timeout 1h; size 4096; counter; }
delete set inet intentic_egress sbx_00e13ed7af55_b4p
add set inet intentic_egress sbx_00e13ed7af55_b4o { type ipv4_addr . inet_proto; flags dynamic,timeout; timeout 1h; size 4096; counter; }
delete set inet intentic_egress sbx_00e13ed7af55_b4o
add set inet intentic_egress sbx_00e13ed7af55_b6p { type ipv6_addr . inet_proto . inet_service; flags dynamic,timeout; timeout 1h; size 4096; counter; }
delete set inet intentic_egress sbx_00e13ed7af55_b6p
add set inet intentic_egress sbx_00e13ed7af55_b6o { type ipv6_addr . inet_proto; flags dynamic,timeout; timeout 1h; size 4096; counter; }
delete set inet intentic_egress sbx_00e13ed7af55_b6o
