{
    "name": "@intentic/extension-manifest",
    "version": "0.0.0",
    "description": "What an intentic extension DECLARES, the intentic-extension.json schema and the sandbox-route allowlist rule",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_sandbox/extension-manifest"
    },
    "files": [
        "dist",
        "src",
        "intentic-extension.schema.json"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsgo",
        "watch": "tsgo --build --watch",
        "schema": "tsgo && node scripts/write-schema.mjs"
    },
    "dependencies": {
        "@intentic/base": "workspace:*",
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:"
    }
}
