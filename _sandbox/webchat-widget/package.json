{
    "name": "@intentic/webchat-widget",
    "version": "0.0.0",
    "description": "Visitor chat, the embeddable chat widget a website loads to talk to a sandbox agent",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_sandbox/webchat-widget"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        "./widget.js": "./dist/widget.js"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsgo --noEmit",
        "watch": "vite build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "devDependencies": {
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@typescript/native-preview": "catalog:",
        "vite": "catalog:"
    }
}
