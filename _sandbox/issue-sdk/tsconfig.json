/* This browser bundle emits no declarations or composite metadata; Vite emits its artifact. */
{
    "compilerOptions": {
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "target": "ES2022"
    },
    "include": ["./src/**/*", "./vite.config.ts", "./vitest.config.ts"],
    "extends": "@intentic/tsconfig/tsconfig.base.json"
}
