{
    "name": "@intentic/issue-sdk",
    "version": "0.0.0",
    "description": "The bug reporter a website or app embeds to send crashes and user reports to a sandbox agent",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_sandbox/issue-sdk"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": "./dist/sdk.mjs",
        "./sdk.js": "./dist/sdk.js"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsgo --noEmit",
        "watch": "vite build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "devDependencies": {
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@typescript/native-preview": "catalog:",
        "vite": "catalog:"
    }
}
