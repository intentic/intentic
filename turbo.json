{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".cache/**", "generated/**", ".astro/**"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        // The declarations every `typecheck` below resolves its workspace imports through, plus the guard that
        // every test file sits in some type-check program (_tools/scripts/typecheck.mjs). A root task, run once
        // for the whole repo rather than per package.
        //
        // This is the `^build` that `test` uses, done without pnpm in the path. `build` goes through pnpm, and
        // pnpm's `syncInjectedDepsAfterScripts` hardlinks into `node_modules` after it — a different filesystem
        // in an agent worktree, so a `^build` dependency died EXDEV (exit 238) for every agent in the fleet.
        // The one check that catches a fake drifting out of shape with its seam was therefore runnable only in
        // CI, on main, after the merge. `tsgo -b` emits the same declarations and works in both places.
        // Uncached because it is already incremental against its own tsbuildinfo: a no-op pass measures ~0.1s,
        // which is cheaper than hashing the inputs would be.
        "//#typecheck:declarations": {
            "cache": false
        },
        // Type-checks each package INCLUDING its test files, which `build` cannot: an emitting package excludes
        // *.test.ts to keep test code out of dist, so without this task the tests are the one part of the repo
        // no type checker ever reads.
        "typecheck": {
            "dependsOn": ["//#typecheck:declarations"],
            "outputs": []
        },
        "check": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": ["WORKSPACE_ROOT", "PREVIEW_PORT"]
        },
        "docker:release": {
            "dependsOn": ["build"],
            "cache": false,
            "passThroughEnv": ["TAGS", "CI_COMMIT_SHORT_SHA", "DOCKER_HOST", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"]
        },
        "watch": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true,
            "env": [
                "DATABASE_URL",
                "NODE_ENV",
                "API_PORT",
                "BETTER_AUTH_SECRET",
                "BETTER_AUTH_URL",
                "WEB_ORIGIN",
                "GOOGLE_CLIENT_ID",
                "GOOGLE_CLIENT_SECRET"
            ]
        },
        "preview": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "e2e": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": [
                "INTENTIC_E2E",
                "CLOUDFLARE_API_TOKEN",
                "CLOUDFLARE_ZONE",
                "FORGEJO_ADMIN_PASSWORD",
                "KOMODO_ADMIN_PASSWORD",
                "KOMODO_WEBHOOK_SECRET",
                "SANDBOX_E2E_IMAGE",
                "DISCORD_E2E_BOT_TOKEN",
                "DISCORD_E2E_SENDER_TOKEN",
                "DISCORD_E2E_CHANNEL_ID",
                "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN"
            ]
        },
        "e2e:hermetic": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["INTENTIC_E2E_HERMETIC", "INTENTIC_HOST_IMAGE", "INTENTIC_LOG_DIR"]
        },
        "bench:retrieval": {
            "dependsOn": ["^build", "build"],
            "cache": false,
            "passThroughEnv": ["IQ_MODEL_DIR", "IQ_RG_PATH"]
        },
        "bench:agents": {
            "dependsOn": ["^build", "build"],
            "cache": false,
            "passThroughEnv": [
                "IQ_BENCH_AGENTS",
                "IQ_BENCH_DANGEROUS",
                "IQ_BENCH_TRANSCRIPTS",
                "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN",
                "OPENAI_API_KEY",
                "XAI_API_KEY"
            ]
        }
    },
    "remoteCache": {
        "enabled": false
    },
    "concurrency": "200%"
}
