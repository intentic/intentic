{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    // The sandbox image's privacy hardening, re-declared so it survives into task processes. Turbo 2's default
    // envMode is `strict`: a task does NOT inherit the ambient environment, it gets a rebuilt one holding only
    // Turbo's system defaults plus what `globalEnv`/`globalPassThroughEnv`/`env`/`passThroughEnv` name. So the
    // two ENV blocks in _sandbox/sandbox/Dockerfile: correct, and live in every sandbox shell, were being
    // deleted before any task started: measured 30 of these 32 stripped, everything except NEXT_ and TURBO_
    // (Turbo ships those two itself). `astro dev` therefore ran with telemetry ON and persisted
    // `enabled: true` plus a tracking id into ~/.config/astro/config.json, which is how this was found.
    //
    // passThrough, not `globalEnv`, because these must not enter the cache key: a passthrough variable's VALUE
    // does not move a task hash, only the presence of the list does: so this costs ONE global invalidation
    // when it lands and nothing afterwards. Both were verified against turbo 2.10.8 before this was written.
    //
    // This list mirrors the Dockerfile's two ENV blocks and has to keep mirroring them: a name added there and
    // not here is set in the image and invisible to every task, which is the exact bug above. NEXT_ and TURBO_
    // are kept even though Turbo passes them anyway, so the two lists can be diffed as one statement.
    "globalPassThroughEnv": [
        "DO_NOT_TRACK",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
        "DISABLE_TELEMETRY",
        "DISABLE_ERROR_REPORTING",
        "DISABLE_FEEDBACK_COMMAND",
        "DISABLE_AUTOUPDATER",
        "OPENCODE_DISABLE_AUTOUPDATE",
        "DISABLE_OPENCOLLECTIVE",
        "ADBLOCK",
        "NPM_CONFIG_AUDIT",
        "NPM_CONFIG_FUND",
        "YARN_ENABLE_TELEMETRY",
        "SCARF_ANALYTICS",
        "NEXT_TELEMETRY_DISABLED",
        "NUXT_TELEMETRY_DISABLED",
        "GATSBY_TELEMETRY_DISABLED",
        "ASTRO_TELEMETRY_DISABLED",
        "TURBO_TELEMETRY_DISABLED",
        "EXPO_NO_TELEMETRY",
        "STORYBOOK_DISABLE_TELEMETRY",
        "NG_CLI_ANALYTICS",
        "DOTNET_CLI_TELEMETRY_OPTOUT",
        "POWERSHELL_TELEMETRY_OPTOUT",
        "SAM_CLI_TELEMETRY",
        "CHECKPOINT_DISABLE",
        "CLOUDSDK_CORE_DISABLE_USAGE_REPORTING",
        "AZURE_CORE_COLLECT_TELEMETRY",
        "WRANGLER_SEND_METRICS",
        "STRIPE_CLI_TELEMETRY_OPTOUT",
        "HASURA_GRAPHQL_ENABLE_TELEMETRY",
        "HF_HUB_DISABLE_TELEMETRY",
        "CONDA_ANACONDA_ANON_USAGE"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".cache/**", "generated/**", ".astro/**"]
        },
        // A suite imports its dependencies' dist, so CI runs this graph as `turbo run build test` and the edge
        // below is what lets each package's tests start the moment its own deps are built.
        //
        // The edge is also unrunnable in an agent worktree, for the same EXDEV reason as `typecheck` below: so
        // the root `test` script runs the same emit and then `turbo run test --only`, which drops the edge
        // and keeps the graph. That is the difference between a suite the fleet can run before landing and one
        // only CI ever sees: 67 of 100 main pipelines failed this job while the whole suite ran nowhere else.
        // VITEST_MAX_WORKERS is the ONLY thing bounding a repo-wide run's memory, and until this line it was
        // being stripped before any suite could read it. The root script sets it (`VITEST_MAX_WORKERS=4 turbo
        // run test --only`), vitest 4 honours it (`if (process.env.VITEST_MAX_WORKERS) resolved.maxWorkers =
        // ...`), and in between `envMode: strict` rebuilt the task environment without it: measured on turbo
        // 2.10.8 via `--dry=json`, the test task reported `passThroughEnv: None` and a global passthrough
        // holding only the 32 telemetry names above. So every vitest fell back to its own default,
        // `Math.max(availableParallelism() - 1, 1)` = 15 workers on a 16-core box, and `concurrency: 4` made
        // that FOUR of them: ~64 worker processes for a run the root script believed it had capped at 16.
        //
        // That is the same fan-out shape as the 2026-08-25 freeze (see the `concurrency` note at the bottom of
        // this file, and _editor/web/vitest.config.ts, both of which describe this cap as though it worked).
        // It is on the TASK rather than in `globalPassThroughEnv` because that list mirrors the Dockerfile's
        // two ENV blocks statement-for-statement and is diffed against them; this name belongs to `test`
        // alone. passThrough, so the VALUE stays out of the cache key and this costs one invalidation, once.
        "test": {
            "dependsOn": ["^build"],
            "outputs": [],
            "passThroughEnv": ["VITEST_MAX_WORKERS"]
        },
        // Type-checks each package INCLUDING its test files, which `build` cannot: an emitting package excludes
        // *.test.ts to keep test code out of dist, so without this task the tests are the one part of the repo
        // no type checker ever reads.
        //
        // The declarations these checks resolve their workspace imports through are emitted by the prepass that
        // the root `typecheck` and `test` scripts both run FIRST (_tools/scripts/build/emit-declarations.mjs). It is `tsgo -b` rather than a
        // `^build` dependency because `build` goes through pnpm, and pnpm's `syncInjectedDepsAfterScripts`
        // hardlinks into `node_modules` after it: a different filesystem in an agent worktree, so a `^build`
        // dependency died EXDEV (exit 238) for every agent in the fleet, leaving the check that catches a fake
        // drifting out of shape with its seam runnable only in CI, on main, after the merge.
        //
        // The prepass is a plain step in that script rather than a `//#` root task in this graph, and that
        // distinction is worth real minutes: a ROOT task's hash covers every file in the repository, so any
        // commit anywhere changed it, and every task that depended on it missed. Measured across three CI
        // pipelines: `Cached: 0 cached, 46 total` for typecheck (~2.5 min) while `build` and `test` hit 27/56
        // and 19/42 from the same cache dir in the same job.
        //
        // `^typecheck` is what replaces that invalidation without going stale: a check reads its dependencies'
        // emitted .d.ts, so a change in a dependency has to re-run it, and a dependency's task hash says
        // exactly that. It propagates through packages that have no typecheck script of their own.
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": []
        },
        "check": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": ["WORKSPACE_ROOT", "PREVIEW_PORT"]
        },
        "docker:release": {
            "dependsOn": ["build"],
            "cache": false,
            "passThroughEnv": ["REGISTRIES", "TAGS", "GITHUB_SHA", "DOCKER_HOST", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"]
        },
        "watch": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true,
            "env": [
                "DATABASE_URL",
                "NODE_ENV",
                "API_PORT",
                "BETTER_AUTH_SECRET",
                "BETTER_AUTH_URL",
                "WEB_ORIGIN",
                "GOOGLE_CLIENT_ID",
                "GOOGLE_CLIENT_SECRET"
            ]
        },
        "preview": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        // The gated real-infra tiers (@intentic/cli, @intentic/sandbox): a Docker daemon plus whatever
        // credentials each suite names, and every one of them self-skips when its own env is absent: which is
        // what lets the nightly CI job be nothing but `pnpm e2e`. A tier that CANNOT self-skip does not belong
        // under this name; see e2e:browser.
        //
        // A suite says which credentials it needs with `e2eTier` (`@intentic/testing/e2e`), and the list below
        // is what lets those reach it: a variable missing here is invisible to the suite no matter what CI
        // holds, so the tier stands down over a credential it was actually given. The two are one statement
        // written twice and they have to agree.
        //
        // The Forgejo/Komodo admin passwords used to sit here and were never read: the CLI GENERATES them and
        // the suite reads them back out of desired-state/.secrets.json, not out of the environment.
        "e2e": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": [
                // The opt-in switch every gated tier reads.
                "INTENTIC_E2E",
                // The Cloudflare tier (cli.e2e): the token is what it stands down without, the zone names which
                // one of yours to deploy under.
                "CLOUDFLARE_API_TOKEN",
                "CLOUDFLARE_ZONE",
                // The Discord tier (discord.e2e): all three required, and the Claude credentials unlock only the
                // one spec inside it that spends a real agent turn.
                "DISCORD_E2E_BOT_TOKEN",
                "DISCORD_E2E_SENDER_TOKEN",
                "DISCORD_E2E_CHANNEL_ID",
                "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN",
                // Points the sandbox-daemon tier at a published image instead of a source build (e2e:browser
                // passes the same variable through for the same reason).
                "SANDBOX_E2E_IMAGE"
            ]
        },
        "e2e:hermetic": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["INTENTIC_E2E_HERMETIC", "INTENTIC_HOST_IMAGE", "INTENTIC_LOG_DIR"]
        },
        // THE PROVIDER CONFORMANCE TIER, and the only e2e task here that GATES a release.
        //
        // Named apart from `e2e` for the reason the two tasks below are: it asks for a provisioning of its own,
        // the provider CLIs at their pinned versions (_tools/scripts/ci/install-provider-clis.sh). What it does
        // NOT ask for is a credential or a network: each turn drives the real CLI against a local scripted
        // model (@intentic/fake-model), so it is deterministic, costs nothing, and cannot be reddened by a
        // vendor's outage. That is precisely what makes it safe to block a release on, where the tiers that
        // spend real tokens are not.
        "e2e:providers": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["INTENTIC_E2E_PROVIDERS", "INTENTIC_CURSOR_SDK_DIR"]
        },
        // The browser tier (@intentic-app/e2e), named apart from `e2e` for the same reason e2e:hermetic is: it
        // asks for a provisioning of its own. Its whole stack is addressed on LOCALHOST: compose postgres on
        // :5440, the https API on :6480, vite on :47145, the daemon container on :18787: and CI jobs run in a
        // container that reaches Docker through the HOST's socket, which publishes those ports on the HOST's
        // network namespace, not the job's loopback (`docker compose up postgres` there leaves the server off
        // localhost, and the migrate that follows dies P1001). ci-base carries no Chromium either. Sharing the `e2e` name
        // is what swept it into the nightly, where it can only fail; under its own it runs where its stack is
        // real: a dev machine, `pnpm e2e:browser`.
        "e2e:browser": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["SANDBOX_E2E_IMAGE"]
        },
        // The mobile geometry gate (_tools/e2e/mobile/audit.mts): a phone-shaped browser walked over every
        // mobile route, failing on a blank surface, anything drawn off-screen, or a target under the WCAG floor.
        //
        // Its own task rather than part of e2e:browser, for the reason that suite's own comment above gives:
        // e2e:browser needs a whole LOCALHOST stack: compose postgres, the https API, a daemon container, and
        // so cannot run in CI at all. This one drives the hermetic demo build, exactly as the shots harness
        // does, so it needs a Chromium and nothing else. That is the entire point: a target-size rule nobody
        // runs is a target-size rule that decays, and this one is cheap enough for every merge request.
        //
        // The demo build is the root script's job (`pnpm e2e:mobile`), not a dependsOn: this package does not
        // depend on the demo, matching the shots harness beside it, and the gate names the build command in its
        // own error when the output is missing. No passThroughEnv: it talks to nothing real, so there is no
        // credential that could gate it and nothing for it to stand down over.
        "e2e:mobile": {
            "cache": false
        },
        "bench:retrieval": {
            "dependsOn": ["^build", "build"],
            "cache": false,
            "passThroughEnv": ["IQ_MODEL_DIR", "IQ_RG_PATH"]
        },
        "bench:agents": {
            "dependsOn": ["^build", "build"],
            "cache": false,
            "passThroughEnv": [
                "IQ_BENCH_AGENTS",
                "IQ_BENCH_DANGEROUS",
                "IQ_BENCH_TRANSCRIPTS",
                "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN",
                "OPENAI_API_KEY",
                "XAI_API_KEY"
            ]
        }
    },
    "remoteCache": {
        "enabled": false
    },
    /* AN ABSOLUTE TASK COUNT, never a percentage: turbo resolves a percentage against the HOST's logical
     * processor count, and a container bounds memory, not cpus. Inside the sandbox "200%" therefore read as 32
     * parallel tasks against a 16-core host while the cgroup capped RAM alone, so one `typecheck` fanned out 15
     * concurrent `vue-tsc` at ~700 MiB each. That peak does not fit any cap localSandboxMemory hands out: the box
     * pinned at its memory ceiling, logged 5.3M allocation stalls, spent 87% of wall-clock inside reclaim, and
     * every agent session sharing it livelocked while the host's own OOM killer shot the owner's dev server.
     *
     * Four holds the fan-out peak near 2.8 GiB, inside the 6 GiB floor that a 20 GiB WSL guest yields, which is
     * the binding constraint on every machine this repo builds on. It is deliberately NOT tuned to the roomiest
     * host: the number has to be safe where the box is smallest, and a `typecheck` that finishes slowly beats one
     * that thrashes forever. A machine with headroom to spare raises it for one run through TURBO_CONCURRENCY
     * rather than by loosening the default here. */
    "concurrency": "4"
}
