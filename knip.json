{
    "$schema": "./node_modules/knip/schema.json",
    "ignore": ["**/dist/**", "**/generated/**", "**/.astro/**", "**/*.d.ts", "**/*.d.mts", "**/__fixtures__/**"],
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "ignoreDependencies": ["tslib"],
    "ignoreBinaries": ["docker", "docker compose", "ssh", "mutagen", "cloudflared", "rg", "tmux", "psql", "bun"],
    "workspaces": {
        ".": {
            "entry": ["_tools/scripts/*.sh", "test/**/*.ts"],
            "ignore": ["desired-state/**", "intent/**"]
        },
        "_editor/web": {
            "entry": [
                "src/main.ts",
                "index.html",
                "popout.html",
                "vite.config.ts",
                "src/**/*.test.ts",
                "scripts/*.mjs",
                "src/environments/environment.local.ts",
                "src/environments/environment.deployment.ts"
            ],
            "ignore": ["public/**"]
        },
        "_site/demo": {
            "entry": ["src/main.ts", "index.html", "popout.html", "vite.config.ts"]
        },
        "_editor/desktop-app": {
            "entry": ["src/main.ts", "index.html", "vite.config.ts", "scripts/*.sh"]
        },
        "_editor/vscode": {
            "entry": ["src/extension.ts", "scripts/*.mjs"],
            "ignoreDependencies": ["@vscode/vsce", "ovsx"]
        },
        "_platform/api": {
            "entry": ["src/**/*.test.ts"]
        },
        "_sandbox/sandbox": {
            "entry": [
                "src/main.ts",
                "src/extensions/backend/backend-host-main.ts",
                "src/**/*.test.ts",
                "bin/*.mjs",
                "bin/*.test.mjs",
                "scripts/*.{sh,mjs}"
            ]
        },
        "_search/iq": {
            "entry": ["src/cli.ts", "plugin/**", "src/**/*.test.ts"]
        },
        "_deploy/cli": {
            "entry": ["src/cli.ts", "src/demo.ts", "src/**/*.test.ts", "doh-lookup.mjs"]
        },
        "_sandbox/sync": {
            "entry": ["src/cli.ts", "src/**/*.test.ts", "scripts/*.sh"]
        },
        "_sandbox/gate-action": {
            "entry": ["src/main.ts", "src/**/*.test.ts"]
        },
        "_search/lsp": {
            "entry": ["src/cli.ts", "src/**/*.test.ts"]
        },
        "_site/site": {
            "entry": ["astro.config.mjs", "src/pages/**/*.{astro,ts}", "worker.ts"],
            "ignore": ["public/**"]
        },
        "_extensions/discord": {
            "entry": ["src/index.ts", "src/gateway.ts", "src/**/*.test.ts"]
        },
        "_extensions/imap": {
            "entry": ["src/index.ts", "src/gateway.ts", "src/**/*.test.ts"]
        },
        "_extensions/deployments": {
            "entry": ["src/server/server.ts", "src/**/*.test.ts"]
        },
        "_extensions/memory": {
            "entry": ["src/server/server.ts", "src/**/*.test.ts"]
        },
        "_extensions/knowledge": {
            "entry": ["src/server/server.ts", "src/cli/kb.ts", "src/**/*.test.ts"]
        },
        "_extensions/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_search/iq-engine": {
            "entry": ["src/index.ts", "scripts/*.mjs", "src/**/*.test.ts"]
        },
        "_computers/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_deploy/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_editor/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_platform/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_sandbox/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_search/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_site/*": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_tools/testing": {
            "entry": ["src/index.ts", "src/**/*.test.ts"]
        },
        "_tools/examples": {
            "entry": ["*.config.ts"]
        },
        "_search/iq-bench": {
            "entry": ["src/**/*.ts"]
        },
        "_tools/e2e": {
            "entry": ["playwright.config.ts", "specs/**/*.ts", "global-setup.ts", "global-teardown.ts"]
        }
    }
}
