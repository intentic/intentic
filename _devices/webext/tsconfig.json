/* A BROWSER bundle, not a node lib: DOM types, bundler resolution, no declaration or composite emit (esbuild
 * emits the artifacts; tsgo only ever type-checks this package). The webchat widget's shape, which is the only
 * other package in this repo built for a browser rather than for node.
 *
 * `types: []` is deliberate and load-bearing: nothing here may reach for node's globals. A `Buffer` or a
 * `process.env` that type-checks because @types/node was ambient would fail at runtime inside a service worker,
 * where neither exists. The Chrome APIs this uses are declared by hand in src/chrome-api.d.ts — see that file
 * for why they are not @types/chrome. */
{
    "compilerOptions": {
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "target": "ES2022",
        "types": []
    },
    "include": ["./src/**/*"],
    "extends": "@intentic/tsconfig/tsconfig.base.json"
}
