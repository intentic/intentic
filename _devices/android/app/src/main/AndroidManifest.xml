<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The connection to the sandbox is a foreground service, so Android keeps it alive and the owner sees it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- One approved screen-sharing session is kept alive by a second foreground service of this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- The "connected" notice, and the notifications that ask the owner. Android 13 and later ask at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only for the owner who chose "Stay connected". -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A short lock around a connect or a call, so the CPU does not sleep in the middle of one. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The apps tool lists launchable apps, and `open` starts one. The home screen is looked up too: it is one of the places the
         touch tools never act in. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".DeviceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntenticDevice">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pairing link or QR code. The App Link is verified by intentic.dev's assetlinks.json; the custom scheme is the
             fallback page's hand-off while that has not happened yet. Either only shows the sandbox's address and asks. -->
        <activity
            android:name=".ui.PairActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="intentic.dev"
                    android:pathPrefix="/phone/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="intentic-device"
                    android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ActivityLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Opened by the "asks to see the screen" notification; shows Android's own dialog and nothing else. -->
        <activity
            android:name=".platform.ScreenConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".link.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's own AI agent connected to this phone while they allow it" />
        </service>

        <service
            android:name=".platform.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The Quick Settings tile that pauses and resumes the agent. -->
        <service
            android:name=".link.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Notification access, which only the person can switch on in Android's settings. It records what other apps post, for
             the notifications tool, and does nothing else. -->
        <service
            android:name=".platform.NoticeListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The wake-up push from the sandbox. Without the four intentic.fcm.* build properties nothing ever calls it. -->
        <service
            android:name=".link.WakeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".link.ControlReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.AccessReceiver"
            android:exported="false" />
        <receiver
            android:name=".link.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Firebase starts from BuildConfig (FirebaseSupport), and only when it is configured. The automatic start from
             google-services.json resources would run with nothing to read, so it is removed. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
