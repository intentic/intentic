<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the build downloaded from intentic.dev updates itself: it hands the new APK to Android's installer, which asks the owner. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- The touch service: the person switches it on in Settings, Accessibility. Reads the screen's element tree, performs
             gestures and takes screenshots for the touch tools, in the apps they allowed. -->
        <service
            android:name=".touch.TouchService"
            android:exported="true"
            android:label="@string/touch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touch_service" />
        </service>

        <receiver
            android:name=".touch.ConfirmReceiver"
            android:exported="false" />

        <service
            android:name=".update.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
