    "glossary": [
        {
            "means": "One private box per project. Your files, your agents, your terminals — nobody else's.",
            "term": "sandbox"
        },
        {
            "means": "The program running inside a sandbox that owns the files and answers the editor.",
            "term": "the daemon"
        },
        {
            "means": "One AI conversation doing one job. Several can run at once, each on its own copy of the code.",
            "term": "agent"
        },
        {
            "means": "One round of an agent working: you ask, it acts, it reports.",
            "term": "turn"
        },
        {
            "means": "A private copy of the code an isolated agent works in, so parallel agents cannot collide.",
            "term": "worktree"
        },
        {
            "means": "The strip of icons down the left of the editor. Space there is scarce and earned.",
            "term": "the rail"
        },
        {
            "means": "A package that adds screens, commands or agent tools without changing the core app.",
            "term": "extension"
        },
        {
            "means": "Something you have connected — a GitHub account, a database, an API key.",
            "term": "capability"
        },
        {
            "means": "A repo's own dev server, run by the sandbox and shown in a frame.",
            "term": "panel"
        },
        {
            "means": "The product you look at and drive: the editor, the sandbox daemons it talks to, and the platform between them.",
            "term": "the app plane"
        },
        {
            "term": "keeper",
            "means": "The machine agent's background check that brings this computer's sandboxes back after a reboot or a hang, through `ic sandbox fix`."
        },
        {
            "term": "upkeep pass",
            "means": "The machine agent's standing clean-up of what older releases left on a computer: retired installs, stale sync, old trash."
        }
    ],
