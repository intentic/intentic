    "glossary": [
        {
            "means": "One private box per project. Your files, your agents, your terminals \u2014 nobody else's.",
            "term": "sandbox"
        },
        {
            "means": "The program running inside a sandbox that owns the files and answers the editor.",
            "term": "the daemon"
        },
        {
            "means": "One AI conversation doing one job. Several can run at once, each on its own copy of the code.",
            "term": "agent"
        },
        {
            "means": "One round of an agent working: you ask, it acts, it reports.",
            "term": "turn"
        },
        {
            "means": "A private copy of the code an isolated agent works in, so parallel agents cannot collide.",
            "term": "worktree"
        },
        {
            "means": "The strip of icons down the left of the editor. Space there is scarce and earned.",
            "term": "the rail"
        },
        {
            "means": "A package that adds screens, commands or agent tools without changing the core app.",
            "term": "extension"
        },
        {
            "means": "Something you have connected \u2014 a GitHub account, a database, an API key.",
            "term": "capability"
        },
        {
            "means": "A repo's own dev server, run by the sandbox and shown in a frame.",
            "term": "panel"
        },
        {
            "means": "A description of what you want to exist. The deployment engine's input, not the product's.",
            "term": "intent"
        },
        {
            "means": "The product you look at. Separate from the deployment engine, which is a bundled tool.",
