{
    "name": "@intentic/extension-api",
    "version": "0.0.0",
    "description": "The versioned public API intentic extensions compile against — manifest schema, detection facts and the host API",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/radarsu/intentic.git",
        "directory": "_libs/extension-api"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc --build --watch"
    },
    "dependencies": {
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "typescript": "catalog:",
        "vue": "catalog:"
    }
}
