/* Type-checks this package's TESTS along with its source. The build config cannot: it emits to dist, so it
 * excludes *.test.ts to keep test code out of the published tree — and that exclusion silently took the test
 * files out of every type check the repo runs. Hand-built fakes then drift out of shape with the seams they
 * stand in for, and the drift only ever surfaces as an opaque runtime failure in an unrelated suite. Run by
 * `pnpm typecheck` (turbo task) and by CI; noEmit, so it never writes anything. See AGENTS.md, "Tests". */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"],
    "exclude": ["./src/__fixtures__/**"]
}
