/* Type-checks this package's TESTS along with its source — the build config excludes *.test.ts to keep test
 * code out of the published tree, which would otherwise leave the tests in no type-check program at all. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"]
}
