{
    "name": "@intentic/extension-ui",
    "version": "0.0.0",
    "description": "The UI kit intentic extensions render with — host-provided at runtime (the app's own components via the import map), so extension UI is always native to the shell",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/radarsu/intentic.git",
        "directory": "_libs/extension-ui"
    },
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./names": "./names.mjs"
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@intentic/ui": "workspace:*",
        "primevue": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "typescript": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "3"
    }
}
