            },
            "require": {
                "@intentic/src": "./src/ids/session-names.ts",
                "default": "./dist/ids/session-names.js"
            }
        },
        "./transcript-fold": {
            "types": "./dist/text/transcript-fold.d.ts",
            "import": {
                "@intentic/src": "./src/text/transcript-fold.ts",
                "default": "./dist/text/transcript-fold.js"
            },
            "require": {
                "@intentic/src": "./src/text/transcript-fold.ts",
                "default": "./dist/text/transcript-fold.js"
            }
        },
        "./webext-links": {
            "types": "./dist/protocol/webext-links.d.ts",
