            "import": {
                "@intentic/src": "./src/ids/share-paths.ts",
                "default": "./dist/ids/share-paths.js"
            },
            "require": {
                "@intentic/src": "./src/ids/share-paths.ts",
                "default": "./dist/ids/share-paths.js"
            }
        },
        "./capability-env": {
