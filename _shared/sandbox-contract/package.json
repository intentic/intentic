                "@intentic/src": "./src/protocol/peer-dial.ts",
                "default": "./dist/protocol/peer-dial.js"
            },
            "require": {
                "@intentic/src": "./src/protocol/peer-dial.ts",
                "default": "./dist/protocol/peer-dial.js"
            }
        },
        "./peer-mcp-server": {
            "types": "./dist/protocol/peer-mcp-server.d.ts",
            "import": {
                "@intentic/src": "./src/protocol/peer-mcp-server.ts",
                "default": "./dist/protocol/peer-mcp-server.js"
            },
            "require": {
                "@intentic/src": "./src/protocol/peer-mcp-server.ts",
