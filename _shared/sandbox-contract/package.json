            },
            "require": {
                "@intentic/src": "./src/protocol/webext-links.ts",
                "default": "./dist/protocol/webext-links.js"
            }
        }
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lock": "tsgo -b && node scripts/write-lock.mjs"
    },
    "dependencies": {
        "@intentic/constants": "workspace:*",
        "@intentic/extension-manifest": "workspace:*",
        "@intentic/registry": "workspace:*",
        "@orpc/contract": "catalog:",
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
