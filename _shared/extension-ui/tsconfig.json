/* Source-only like @intentic/ui (exports → ./src/index.ts); this config exists for standalone
 * type-checking (vue-tsc resolves the .vue components the kit re-exports). */
{
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo"
    },
    "include": ["./src/**/*.ts"],
    "extends": "@intentic/tsconfig/tsconfig.vue.json"
}
