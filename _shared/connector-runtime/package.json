{
    "name": "@intentic/connector-runtime",
    "version": "0.0.0",
    "description": "The shared gateway runtime for realtime-connector extensions, daemon client, reconcile shell, reply painters and logger, written once instead of per channel",
    "license": "MIT",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_shared/connector-runtime"
    },
    "files": [
        "dist",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "@intentic/src": "./src/index.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "bun check -p tsconfig.test.json",
        "test": "suites",
        "watch": "tsc --build --watch"
    },
    "dependencies": {
        "@intentic/base": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/extension-api": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
