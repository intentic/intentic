{
    "name": "@intentic/api-contract",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "@intentic/src": "./src/index.ts",
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./ingress": {
            "types": "./dist/ingress/index.d.ts",
            "import": {
                "@intentic/src": "./src/ingress/index.ts",
                "types": "./dist/ingress/index.d.ts",
                "default": "./dist/ingress/index.js"
            },
            "require": {
                "types": "./dist/ingress/index.d.ts",
                "default": "./dist/ingress/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "suites"
    },
    "dependencies": {
        "@intentic/constants": "workspace:*",
        "@intentic/resources": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@orpc/contract": "catalog:",
        "tslib": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:"
    }
}
