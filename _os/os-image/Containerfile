# INTENTIC OS, SERVER EDITION: a bootc image. The machine boots this image's /usr read-only, keeps /etc and /var,
# and updates by pulling a newer image into a second deployment it boots next (`ic os update`), with the previous one
# kept for `ic os rollback` and for greenboot's automatic rollback of a boot that fails its health checks.
#
# Build it with build.sh, which stages `ic` into bin/ first:
#   bash _os/os-image/build.sh                     # ic from _sandbox/ic/dist-bin, else built from source
#   bash _os/os-image/build.sh --edition desktop   # the desktop edition on top (Containerfile.desktop)
#
# Everything installed comes from Fedora's own signed repositories: moby-engine is Fedora's Docker build (29.8.2 on
# 2026-10-13, a patch behind the 29.9.0 the sandbox image pins for its nested engine; the two need not match, and
# Fedora's updates move this one), kata-containers runs a sandbox as a microVM, greenboot judges each boot.
# greenboot-default-health-checks is left out on purpose: its DNS and repository checks would roll back a box that
# booted fine but is offline.
ARG BASE=quay.io/fedora/fedora-bootc:44
FROM ${BASE}

ARG VERSION=0.0.0
ARG CHANNEL=stable
ARG REPOSITORY=ghcr.io/intentic/os

# The machine's own settings (`ic os network|drives`, _os/README.md "Settings"): fedora-bootc:44 has NetworkManager but
# not its Wi-Fi plugin or the wpa_supplicant behind it (2026-10-16: neither is in the 2026-10-13 build), and has udisks,
# which opens, closes and powers off USB drives and memory cards, only as fwupd's weak dependency, so it is named here to
# stay. rootfs/usr/share/polkit-1/rules.d/50-intentic.rules says which of their actions the intentic user may take.
#
# kata-containers' own %post builds the microVM's initrd from the RUNNING kernel, which during an image build is the
# build host's: it is installed without scripts, and its kata-osbuilder-generate.service builds that initrd on the
# box at boot, from the kernel this image boots. Its dracut config asks for the `dbus` module, which needs
# dbus-daemon even though the system bus here is dbus-broker; without it the initrd build fails at boot.
#
# The transaction's history and ldconfig's cache are removed again, as the base image ships without them: they are
# new bytes on every build, and rechunking (build.sh) files them in libdnf5's and glibc's layers, so an update of
# nothing but `ic` downloaded those two again (20 and 4 MB, measured 2026-10-20). The rpm database has to stay.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=1 install \
        moby-engine \
        docker-buildx \
        docker-compose \
        greenboot \
        nss-mdns \
        dbus-daemon \
        NetworkManager-wifi \
        wpa_supplicant \
        udisks2 \
    && dnf -y --setopt=keepcache=1 --setopt=tsflags=noscripts install kata-containers \
    && rm -rf /var/log/dnf5.log* /var/lib/dnf /run/dnf \
        /var/cache/ldconfig /usr/lib/sysimage/libdnf5/transaction_history.sqlite*

# The host CLI every door goes through (build.sh puts the binary for this architecture here).
COPY --chmod=0755 bin/ic /usr/bin/ic

# Units, policy defaults, the intentic user, sudo rules, Docker's config and the health check.
#
# Every file of Intentic's own, `ic` and release.json included, is marked for a layer of its own when build.sh
# rechunks the image (rpm-ostree reads the user.component attribute). Unmarked, they shared the layer of files no
# package owns with the 107 MB initramfs, which an update then downloaded again whenever `ic` changed. Files only: a
# directory's mark reaches no further than the rechunking of this image, so the desktop edition would not see it.
# Not "intentic": that is the desktop app's package, and rpm-ostree names a package's layer after the package.
COPY rootfs/ /
RUN --mount=type=bind,source=rootfs,target=/tmp/rootfs \
    chmod 0440 /etc/sudoers.d/intentic-os \
    && chmod 0755 /usr/lib/greenboot/check/required.d/50-intentic-sandboxes.sh /usr/libexec/intentic-os/* \
    && visudo -cf /etc/sudoers.d/intentic-os \
    && find /tmp/rootfs -type f -printf '/%P\0' | xargs -0 setfattr -n user.component -v intentic-os \
    && setfattr -n user.component -v intentic-os /usr/bin/ic

# What this image is, read by `ic os` and everything that calls it.
RUN printf '{"name":"Intentic OS","edition":"server","version":"%s","channel":"%s","repository":"%s"}\n' \
        "$VERSION" "$CHANNEL" "$REPOSITORY" > /usr/lib/intentic-os/release.json \
    && setfattr -n user.component -v intentic-os /usr/lib/intentic-os/release.json

# bootc's own timer pulls AND reboots on its schedule; on Intentic OS a reboot is the owner's call, so it is masked and
# intentic-os-update.timer only stages.
RUN systemctl mask bootc-fetch-apply-updates.timer \
    && systemctl enable docker.service avahi-daemon.service \
        intentic-pair.service intentic-os-record.service intentic-os-update.timer intentic-tpm-enroll.service \
        greenboot-healthcheck.service greenboot-set-rollback-trigger.service

LABEL org.opencontainers.image.title="Intentic OS" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/intentic/intentic" \
      dev.intentic.os.edition="server" \
      dev.intentic.os.channel="${CHANNEL}" \
      containers.bootc="1"

RUN bootc container lint
