# INTENTIC OS, DESKTOP EDITION: the server edition plus a screen. greetd logs the intentic user straight into a sway
# session that shows the Intentic desktop app full screen (the shell: This device, the OS card, every sandbox's
# editor) with Chromium one key away for the owner's own browsing. No other window manager, panel or launcher: what
# runs on the screen is the app, and the app is where the machine is operated from.
#
# Physical access is trust here, as on any desk machine: the session is the intentic user's, who manages every
# sandbox. Each sandbox still asks its own sign-in (Google, email or a passkey) in the editor.
ARG BASE=ghcr.io/intentic/os:stable
FROM ${BASE}

ARG VERSION=0.0.0
ARG CHANNEL=stable
ARG REPOSITORY=ghcr.io/intentic/os-desktop

# The app's own .rpm (build.sh stages it) pulls WebKitGTK and GTK; sway, greetd, Chromium and fonts come from Fedora.
COPY desktop/rpm/ /tmp/intentic-rpm/
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=1 install \
        sway swaybg greetd xdg-desktop-portal-wlr \
        chromium \
        google-noto-sans-fonts google-noto-emoji-fonts \
        mesa-dri-drivers mesa-vulkan-drivers \
        pipewire wireplumber \
        /tmp/intentic-rpm/*.rpm \
    && dnf clean all \
    && rm -rf /tmp/intentic-rpm /var/log/dnf5.log* /var/lib/dnf /run/dnf /run/selinux-policy

COPY desktop/rootfs/ /
# The screen is the app's: pairing happens in it (This device) or on the LAN page, never on tty1.
RUN rm /usr/lib/systemd/system/intentic-pair.service.d/50-console.conf \
    && chmod 0755 /usr/libexec/intentic-os/* \
    && systemctl enable greetd.service \
    && systemctl set-default graphical.target \
    && printf '{"name":"Intentic OS","edition":"desktop","version":"%s","channel":"%s","repository":"%s"}\n' \
        "$VERSION" "$CHANNEL" "$REPOSITORY" > /usr/lib/intentic-os/release.json

LABEL org.opencontainers.image.title="Intentic OS desktop" \
      org.opencontainers.image.version="${VERSION}" \
      dev.intentic.os.edition="desktop" \
      dev.intentic.os.channel="${CHANNEL}"

RUN bootc container lint
