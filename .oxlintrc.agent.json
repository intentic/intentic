{
    // RULES MAIN CANNOT MEET YET, held against what agents write.
    //
    // The root config is the landable standard and is green. This file is the root config plus rules whose
    // backlog is too large to fix as one change — .claude/hooks/oxlint-edit.mjs applies it to files an agent
    // has just touched, and reports a diagnostic only if it is absent from the same file at HEAD. So new code
    // meets the stricter bar while `pnpm lint` stays honest about what main actually satisfies.
    //
    // Run it over a path by hand with:  pnpm lint:agent <path>
    //
    // `ignorePatterns` and `overrides` below are COPIED from the root config, because `extends` merges `rules`
    // and nothing else — leaving them out lints vendored sources and loses every tooling exemption. Change one,
    // change both.
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "extends": ["./.oxlintrc.json"],
    "rules": {
        // McCabe's own threshold. 737 functions exceed it across 517 files, so it cannot be a repo-wide gate
        // without either a red `pnpm lint` or an exemption list longer than the config — but every function
        // written from here on can meet it, and that is what this file is for.
        //
        // The hook compares against HEAD by rule AND message, and the message carries the number ("has a
        // complexity of 188"). So editing an already-complex function is silent while its complexity holds
        // steady, and reports the moment the edit pushes it higher. The ratchet only turns one way.
        "complexity": ["error", { "max": 10 }],

        /* ASSERTIONS THAT CANNOT FAIL, held against new tests only. 326 sites here today, which is why this
         * is on the authoring side of the line rather than in the root config.
         *
         * This is the whole of what a linter can honestly say about test quality, and it is the UNDER-specified
         * half. The over-specified half — a 22-key `toEqual`, an exact 80-char string, `toHaveBeenCalledTimes(2)`
         * — is not detectable, because those are the CORRECT assertion whenever the shape is the contract, and
         * every site sampled in this repo was exactly that. See the block in .oxlintrc.json for the measurements.
         *
         * Whether a test that clears this bar actually detects a fault is a different question, and not one any
         * linter answers. Two things answer it: the per-edit check behind the `testFaultDetection` setting, which
         * asks whether the test would have passed before the change it tests, and the `test-strength` chore,
         * which mutates the source and counts what the suite notices.
         *
         * The `help` text is the point of the rule, not decoration: oxlint prints it under the diagnostic, and it
         * is the only part an agent can act on. "Use of `toBeDefined` is disallowed" alone teaches nothing. */
        "jest/no-restricted-matchers": [
            "error",
            {
                "toMatchSnapshot": "A snapshot records what the code DOES; a test says what it must do. Assert the fields the behaviour is about.",
                "toMatchInlineSnapshot": "A snapshot records what the code DOES; a test says what it must do. Assert the fields the behaviour is about.",
                "toMatchFileSnapshot": "A snapshot records what the code DOES; a test says what it must do. Assert the fields the behaviour is about.",
                "toBeDefined": "Passes for 0, \"\", false and every object ever constructed, so it will never fail. Assert what the value IS.",
                "toBeTruthy": "Passes for any non-empty string, any object, any non-zero number. Assert the value, not its truthiness.",
                "toBeFalsy": "Passes for 0, \"\", null, undefined and NaN alike, which are rarely interchangeable. Assert the one you mean.",
                "toHaveBeenCalled": "Says a call happened, not that it was the right one. Use toHaveBeenCalledWith, or assert the effect the call had.",
                "resolves.not.toThrow": "Only says the promise settled. Assert the value it resolved to."
            }
        ]
    },
    "ignorePatterns": [
        "**/node_modules",
        "**/.cache",
        "**/.turbo",
        "**/.astro",
        "**/dist",
        "**/dist-*",
        "**/deploy",
        "**/generated",
        "**/out-tsc",
        "**/tmp",
        "**/assets/js/env.js",
        "_editor/web/public/ext-shims",
        "_sandbox/sandbox/operator-templates",
        // Vendored upstream source — kept byte-identical so it stays diffable against dmmulroy/anti-slop.
        "_tools/oxlint/anti-slop"
    ],
    "overrides": [
        {
            // Tooling whose output IS stdout: CLIs, build scripts, benchmarks, e2e harnesses. console.log is
            // the product here, not a leftover.
            "files": [
                "**/*.mjs",
                "**/scripts/**",
                "**/*.config.*",
                "_tools/scripts/**",
                "_tools/e2e/**",
                "_tools/localhost-https/**",
                "_tools/dev-public/**",
                "_search/iq-bench/**",
                "_sandbox/gate/**",
                "_sandbox/gate-action/**",
                "_deploy/cli/**",
                "_deploy/engine/**",
                "_site/demo/**",
                "_tools/fake-upstream/**",
                "_tools/fake-zrok/**",
                "_platform/example-provider/**",
                "_sandbox/connector-runtime/**",
                "_sandbox/acp-bridge/**",
                "_sandbox/sandbox/src/extensions/backend/**",
                "_editor/web/src/composables/perf.ts",
                "_editor/web/src/composables/chat/focusTrace.ts"
            ],
            "rules": {
                "no-console": "off"
            }
        },
        {
            "files": ["**/*.test.ts", "**/*.integration.test.ts", "**/*.spec.ts"],
            "rules": {
                // vi.mock() is hoisted and has to be declared above the imports it intercepts, which puts a
                // statement between the import list and leaves this rule with nothing useful to say.
                "import/first": "off",
                // A test may hold a deliberately wrong shape to assert the code rejects it.
                "typescript/no-explicit-any": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-return": "off",
                "typescript/unbound-method": "off",
                // A test may construct the degenerate input on purpose: `new Error("")` is the argument under
                // test, and `new Function(src)` is being used as a parser to assert generated code is valid.
                "unicorn/error-message": "off",
                "no-new-func": "off"
            }
        },
        {
            "files": ["_extensions/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": [
                                    "@intentic/*",
                                    "!@intentic/connector-runtime",
                                    "!@intentic/extension-api",
                                    "!@intentic/extension-manifest",
                                    "!@intentic/extension-ui",
                                    "!@intentic/sandbox-contract"
                                ],
                                "message": "Extensions may depend only on @intentic/extension-api, @intentic/extension-manifest, @intentic/extension-ui, @intentic/connector-runtime, and @intentic/sandbox-contract — the extension SDK (browser and gateway halves), what it declares, and the shared wire contract. Reaching any other @intentic/* package couples the extension to app/engine internals. See _extensions/README.md."
                            },
                            {
                                "group": [
                                    "@intentic-app/*",
                                    "**/_computers/**",
                                    "**/_deploy/**",
                                    "**/_editor/**",
                                    "**/_platform/**",
                                    "**/_sandbox/**",
                                    "**/_search/**",
                                    "**/_site/**"
                                ],
                                "message": "Extensions must not reach the app plane (@intentic-app/*) or other packages' internals by path. Use @intentic/extension-ui for UI and @intentic/sandbox-contract for wire types. See _extensions/README.md."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
