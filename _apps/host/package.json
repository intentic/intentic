{
    "name": "@intentic/host",
    "version": "0.0.0",
    "description": "Local agent that lets an intentic sandbox work on this computer \u2014 one outbound WebSocket, an MCP tool surface, and scopes enforced here",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_apps/host"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "bin": {
        "intentic-host": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@intentic/browser": "workspace:*",
        "@intentic/desktop": "workspace:*",
        "@intentic/local-agent": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@orpc/server": "catalog:",
        "@stricli/core": "catalog:",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@orpc/client": "catalog:",
        "@orpc/contract": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "vitest": "catalog:"
    }
}
