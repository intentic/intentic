#!/bin/sh
# Idempotent dockerd starter for the intentic WSL machine. The desktop app runs this (as root, via
# `wsl --exec`) before any docker operation; WSL keeps the VM alive while dockerd runs and parks it
# when idle, so "boot" and "first docker call after a while" are the same path.
set -eu

if docker info >/dev/null 2>&1; then
    exit 0
fi

mkdir -p /var/log
# A stale pid file from a parked VM blocks the next start.
rm -f /var/run/docker.pid
nohup dockerd >>/var/log/dockerd.log 2>&1 &

i=0
while [ "$i" -lt 60 ]; do
    if docker info >/dev/null 2>&1; then
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done

echo "dockerd did not come up; recent log:" >&2
tail -50 /var/log/dockerd.log >&2 || true
exit 1
