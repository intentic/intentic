{
    "name": "@intentic/sandbox",
    "version": "0.0.0",
    "description": "Remote AI-agent dev workspace daemon — runs inside a per-project sandbox container on the customer's host",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/radarsu/intentic.git",
        "directory": "_apps/sandbox"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc --build --watch",
        "dev": "tsx watch ./src/main.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "INTENTIC_E2E=1 vitest run e2e"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "catalog:",
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.2",
        "@hono/node-server": "catalog:",
        "@intentic/constants": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/scaffold": "workspace:*",
        "@intentic/workspace-ignore": "workspace:*",
        "@openai/codex-sdk": "^0.142.5",
        "@opencode-ai/sdk": "^1.17.15",
        "@orpc/openapi": "catalog:",
        "@orpc/server": "catalog:",
        "@playwright/mcp": "^0.0.77",
        "@puristic/env": "catalog:",
        "@xterm/headless": "6.0.0",
        "chokidar": "catalog:",
        "croner": "catalog:",
        "discord.js": "^14.26.4",
        "file-type": "^22.0.1",
        "hono": "catalog:",
        "jose": "catalog:",
        "node-pty": "catalog:",
        "pino": "catalog:",
        "playwright": "^1.61.1",
        "tar-stream": "catalog:",
        "tslib": "catalog:",
        "ws": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@orpc/client": "catalog:",
        "@orpc/openapi-client": "catalog:",
        "@types/node": "catalog:",
        "@types/ssh2": "catalog:",
        "@types/tar-stream": "catalog:",
        "@types/ws": "catalog:",
        "pino-pretty": "catalog:",
        "ssh2": "catalog:",
        "testcontainers": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
