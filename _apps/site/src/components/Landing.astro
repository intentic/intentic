// Even radial layout for the integrations hub: node i sits on an ellipse (rx 46% / ry 41%) around
// the centre, starting at 12 o'clock. Positions are percentages the markup drops into left/top.
const round = (n: number) => Math.round(n * 100) / 100;
const hubNodes = content.integrations.nodes.map((node, i) => {
    const angle = (-90 + (360 / content.integrations.nodes.length) * i) * (Math.PI / 180);
    return Object.assign({}, node, { x: round(50 + Math.cos(angle) * 46), y: round(50 + Math.sin(angle) * 41) });
});
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faq={faq}
    extraJsonLd={[buildSoftwareAppSchema()]}
    noindex={noindex}
>
    <Nav />
    <main class="flex-1">
        <!-- 1 · Hero -->
        <section class="relative overflow-hidden" id="hero">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>

            <!-- Floating ambient orbs -->
            <div class="hero-orbs" aria-hidden="true">
                <svg width="0" height="0">
                    <defs>
                        <radialGradient id="orb-glow" cx="40%" cy="35%" r="50%">
                            <stop offset="0%" stop-color="oklch(82% 0.14 55)" />
                            <stop offset="60%" stop-color="oklch(72% 0.17 55)" />
                            <stop offset="100%" stop-color="oklch(60% 0.16 55)" />
                        </radialGradient>
                    </defs>
                </svg>

                {
                    [1, 2, 3, 4, 5, 6, 7].map((n) => (
                        <svg class={`orb orb-${n}`} viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="46" fill="url(#orb-glow)" stroke="oklch(77% 0.155 55 / 0.2)" stroke-width="0.8" />
                            <ellipse cx="38" cy="36" rx="18" ry="14" fill="rgba(255,255,255,0.10)" />
                        </svg>
                    ))
                }
            </div>

            <div class="grid-overlay" aria-hidden="true"></div>

            <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pt-32 pb-20 lg:grid-cols-2 lg:pt-40 lg:pb-28">
                <div class="animate-fade-in-up">
                    <h1 class="text-4xl leading-tight font-semibold tracking-tight xl:text-5xl">
                        {content.hero.headlineLines.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
                    </h1>
                    <p class="mt-4 max-w-lg text-base leading-relaxed text-muted">
                        {content.hero.subhead}
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                        <a class="btn btn-secondary" href={gitlabUrl} target="_blank" rel="noopener">See the source</a>
                    </div>

                    <ul class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-subtle">
                        {
                            content.hero.chips.map((chip) => (
                                <li class="flex items-center gap-1.5">
                                    <span class="h-1 w-1 rounded-full bg-primary-500" />
                                    {chip}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- The claim, proven immediately: the real fleet board. The frame crops the full-width
                     screenshot to its Attention + Active lanes so agent cards stay legible beside the copy;
                     the third lane bleeds past the right edge, and section 2 shows the whole board. -->
                <!-- Capped until the hero splits into two columns: the crop scales with the frame, so a
                     full-width frame on a tablet would blow the screenshot up to twice its intended size. -->
                <figure class="animate-fade-in-up m-0 w-full max-w-[34rem] lg:mx-0 lg:max-w-none" style="animation-delay: 60ms">
                    <div class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                        <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{content.hero.shot.frameLabel}</span>
                        </div>
                        <!-- Crop window. The width percentages pick how much of the 2152px-wide shot shows:
                             275% ≈ the Attention lane alone (phones), 203% ≈ Attention + Active (from sm up).
                             Each aspect ratio is the matching slice of the source, so the image fills the box.

                             The play button over it opens the real app in the overlay below — not in this box,
                             which is half a hero column wide: an IDE needs a viewport, and the whole claim of
                             the page is that this is an IDE. The image stays the LCP, undimmed until hover;
                             nothing about the demo loads until it is asked for. -->
                        <div class="relative aspect-[5/6] overflow-hidden sm:aspect-[53/45]">
                            <img
                                src={content.hero.shot.src}
                                alt={content.hero.shot.alt}
                                width={content.hero.shot.width}
                                height={content.hero.shot.height}
                                fetchpriority="high"
                                decoding="async"
                                class="w-[275%] max-w-none sm:w-[203%]"
                            />
                            <button
                                id="hero-demo-play"
                                type="button"
                                data-demo-url={DEMO_URL}
                                class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-canvas/10 transition hover:bg-canvas/35 focus-visible:bg-canvas/35 focus-visible:outline-none"
