---
import { faqGroups } from "@intentic-dev/site-content/faq";
import type { LandingContent } from "@intentic-dev/site-content/landing";
import { APP_URL, DEMO_PATH, gitlabIssuesUrl, gitlabUrl } from "@intentic-dev/site-content/site";
import { buildSoftwareAppSchema } from "@intentic-dev/site-content/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
    content: LandingContent;
    noindex?: boolean;
}

const { content, noindex } = Astro.props;

// FAQPage structured data is flat — the topic bands are a reading aid for the page, not part of the schema.
const faq = faqGroups.flatMap((group) => group.items).map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

// Per-index glyphs; content stays pure copy.
const factIcons = [
    icon('<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/>'),
    icon('<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'),
    icon('<path d="M12 2.5 20 6v5.5c0 4.8-3.4 8.2-8 9.5-4.6-1.3-8-4.7-8-9.5V6z"/>'),
];
const checkIcon = icon('<path d="M20 6 9 17l-5-5"/>');

// Line glyphs for the sandbox figure (same 1.5-stroke motif as the section icons above).
const monitorGlyph = icon('<rect x="3" y="4" width="18" height="12.5" rx="1.5"/><path d="M8.5 20.5h7M12 16.5v4"/>');
const cubeGlyph = icon('<path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"/><path d="m3.5 7 8.5 4.5L20.5 7M12 11.5v10"/>');
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faq={faq}
    extraJsonLd={[buildSoftwareAppSchema()]}
    noindex={noindex}
>
    <Nav />
    <main class="flex-1">
        <!-- 1 · Hero -->
        <section class="relative overflow-hidden" id="hero">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>

            <!-- Floating ambient orbs -->
            <div class="hero-orbs" aria-hidden="true">
                <svg width="0" height="0">
                    <defs>
                        <radialGradient id="orb-glow" cx="40%" cy="35%" r="50%">
                            <stop offset="0%" stop-color="oklch(82% 0.14 55)" />
                            <stop offset="60%" stop-color="oklch(72% 0.17 55)" />
                            <stop offset="100%" stop-color="oklch(60% 0.16 55)" />
                        </radialGradient>
                    </defs>
                </svg>

                {
                    [1, 2, 3, 4, 5, 6, 7].map((n) => (
                        <svg class={`orb orb-${n}`} viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="46" fill="url(#orb-glow)" stroke="oklch(77% 0.155 55 / 0.2)" stroke-width="0.8" />
                            <ellipse cx="38" cy="36" rx="18" ry="14" fill="rgba(255,255,255,0.10)" />
                        </svg>
                    ))
                }
            </div>

            <div class="grid-overlay" aria-hidden="true"></div>

            <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pt-32 pb-20 lg:grid-cols-2 lg:pt-40 lg:pb-28">
                <div class="animate-fade-in-up">
                    <h1 class="text-4xl leading-tight font-semibold tracking-tight xl:text-5xl">
                        {content.hero.headlineLines.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
                    </h1>
                    <p class="mt-4 max-w-lg text-base leading-relaxed text-muted">
                        {content.hero.subhead}
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                        <a class="btn btn-secondary" href={gitlabUrl} target="_blank" rel="noopener">See the source</a>
                    </div>

                    <ul class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-subtle">
                        {
                            content.hero.chips.map((chip) => (
                                <li class="flex items-center gap-1.5">
                                    <span class="h-1 w-1 rounded-full bg-primary-500" />
                                    {chip}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- The claim, proven immediately: the real fleet board. The frame crops the full-width
                     screenshot to its Attention + Active lanes so agent cards stay legible beside the copy;
                     the third lane bleeds past the right edge, and section 2 shows the whole board. -->
                <!-- Capped until the hero splits into two columns: the crop scales with the frame, so a
                     full-width frame on a tablet would blow the screenshot up to twice its intended size. -->
                <figure class="animate-fade-in-up m-0 w-full max-w-[34rem] lg:mx-0 lg:max-w-none" style="animation-delay: 60ms">
                    <div class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                        <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                            <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{content.hero.shot.frameLabel}</span>
                        </div>
                        <!-- Crop window. The width percentages pick how much of the 1072px-wide surface shows:
                             262% ≈ rail + the Attention lane (phones), 168% ≈ through the Active lane (from sm up).
                             Each aspect ratio is the matching slice of the source, so the image fills the box.

                             The play button over it opens the real app in the overlay below — not in this box,
                             which is half a hero column wide: an IDE needs a viewport, and the whole claim of
                             the page is that this is an IDE. The image stays the LCP, undimmed until hover;
                             nothing about the demo loads until it is asked for. -->
                        <div class="relative aspect-[5/7] overflow-hidden sm:aspect-6/5">
                            <img
                                src={content.hero.shot.src}
                                alt={content.hero.shot.alt}
                                width={content.hero.shot.width}
                                height={content.hero.shot.height}
                                fetchpriority="high"
                                decoding="async"
                                class="w-[262%] max-w-none sm:w-[168%]"
                            />
                            <button
                                id="hero-demo-play"
                                type="button"
                                data-demo-url={DEMO_PATH}
                                class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-canvas/10 transition hover:bg-canvas/35 focus-visible:bg-canvas/35 focus-visible:outline-none"
                            >
                                <span
                                    class="flex items-center gap-2.5 rounded-full border border-line bg-canvas/85 px-5 py-2.5 text-sm font-medium shadow-xl shadow-black/40 backdrop-blur transition group-hover:border-primary-500 group-hover:text-primary-500"
                                >
                                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5"><path d="M8 5v14l11-7z" /></svg>
                                    <span class="hero-demo-label" data-open-label={content.hero.demo.newTabLabel}>{content.hero.demo.playLabel}</span>
                                </span>
                            </button>
                        </div>
                    </div>
                    <figcaption class="mt-3 text-2xs leading-relaxed text-subtle/80">{content.hero.demo.note}</figcaption>
                </figure>
            </div>
        </section>

        <!-- 2 · The loop — assign several, each isolated, nothing lands unread.
             This is the section that earns the headline's second half: the window is the board you watch,
             the agent you answer, and the diff you read. Beat 02 carries the sandbox FIGURE rather than a
             screenshot because a container is not a surface — there is no honest screen of "its tools are
             really installed", and a mockup of one would be the first lie on the page. -->
        <section class="border-t border-line" id="loop">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.loop.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight">{content.loop.heading}</h2>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{content.loop.sub}</p>

                <div class="mt-14 space-y-14 lg:mt-16 lg:space-y-20">
                    {
                        content.loop.beats.map((beat, i) => {
                            /* Layout follows the shot, the way the product pages do it: a wide capture is 1072 CSS px
                               of real interface and takes the whole column, because halving it renders the app's own
                               text at a third size. It also keeps beat 01 from reading as the hero's screenshot
                               printed twice — the hero shows a cropped corner of the board, this shows all of it.
                               The threshold is 3:2 rather than merely landscape: the review capture is 2144×1800, a
                               tall panel that happens to be a hair wider than high, and given the whole column it is
                               mostly the empty canvas under its own diff. That one keeps the cropped side-by-side. */
                            const wideShot = beat.shot !== undefined && beat.shot.width >= beat.shot.height * 1.5 ? beat.shot : undefined;
                            const words = (
                                <>
                                    <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                        {beat.step}
                                    </div>
                                    <h3 class="mt-3 text-xl font-semibold tracking-tight text-content">{beat.title}</h3>
                                    <p class="mt-3 text-base leading-relaxed text-muted">{beat.body}</p>
                                </>
                            );

                            if (wideShot !== undefined) {
                                return (
                                    <div>
                                        <div class="max-w-2xl">{words}</div>
                                        <figure class="m-0 mt-8 overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                                            <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">
                                                    {wideShot.frameLabel}
                                                </span>
                                            </div>
                                            <img
                                                src={wideShot.src}
                                                alt={wideShot.alt}
                                                width={wideShot.width}
                                                height={wideShot.height}
                                                loading="lazy"
                                                decoding="async"
                                                class="w-full"
                                            />
                                        </figure>
                                    </div>
                                );
                            }

                            return (
                                <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
                                    <div class={i % 2 === 1 ? "lg:order-2" : ""}>{words}</div>

                                    <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                                        {beat.shot && (
                                            <figure class="m-0 overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50">
                                                <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                                                    <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">
                                                        {beat.shot.frameLabel}
                                                    </span>
                                                </div>
                                                {/* A crop window, not a fit: a portrait capture scaled into half a column is
                                                    the app at a third size — a shape you can see, not a screen you can read.
                                                    So the shot is oversized and the window shows its top-left, where this
                                                    surface puts the thing the beat claims. Pinned rather than left in flow:
                                                    a block box with an aspect-ratio and `overflow-hidden` centres a child
                                                    taller than itself, which scrolled the review past its own diff. */}
                                                <div class="relative aspect-16/10 overflow-hidden">
                                                    <img
                                                        src={beat.shot.src}
                                                        alt={beat.shot.alt}
                                                        width={beat.shot.width}
                                                        height={beat.shot.height}
                                                        loading="lazy"
                                                        decoding="async"
                                                        class="absolute top-0 left-0 w-[145%] max-w-none"
                                                    />
                                                </div>
                                            </figure>
                                        )}

                                        {beat.figure === "sandbox" && (
                                            <figure class="m-0 rounded-2xl border border-dashed border-line-strong p-4 sm:p-6">
                                                <div class="eyebrow mb-4 flex items-center gap-2">
                                                    <span class="text-subtle">
                                                        <Fragment set:html={monitorGlyph} />
                                                    </span>
                                                    {content.loop.sandbox.boundary}
                                                </div>

                                                <div class="card border-primary-600/30 bg-primary-600/[0.03] p-5 shadow-xl shadow-black/30">
                                                    <div class="flex items-center gap-3 border-b border-line pb-4">
                                                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-600/15 text-link">
                                                            <Fragment set:html={cubeGlyph} />
                                                        </span>
                                                        <div class="min-w-0">
                                                            <div class="font-mono text-sm text-content">{content.loop.sandbox.agent.name}</div>
                                                            <div class="text-2xs text-subtle">{content.loop.sandbox.agent.role}</div>
                                                        </div>
                                                        <span class="chip ml-auto bg-success/10 text-success">
                                                            <span class="h-1.5 w-1.5 rounded-full bg-success" />
                                                            running
                                                        </span>
                                                    </div>

                                                    <div class="mt-4 space-y-4">
                                                        {content.loop.sandbox.layers.map((layer) => (
                                                            <div class="flex flex-col gap-1.5">
                                                                <div class="eyebrow">{layer.label}</div>
                                                                <div class="flex flex-wrap gap-1.5">
                                                                    {layer.items.map((item) => (
                                                                        <span class="rounded-md border border-line bg-overlay/50 px-2 py-0.5 font-mono text-2xs text-muted">
                                                                            {item}
                                                                        </span>
                                                                    ))}
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </figure>
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                <a href="/product/" class="mt-14 inline-block text-sm font-medium text-link hover:underline">{content.loop.cta} →</a>
            </div>
        </section>

        <!-- 3 · Ownership — diagram + definition rows -->
        <section class="border-t border-line" id="ownership">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.ownership.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.ownership.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.ownership.sub}</p>
                <a href="/product/sandbox/" class="mt-4 inline-block text-sm font-medium text-link hover:underline">How ownership works in the product →</a>

                <div class="mt-12 flex flex-col items-stretch gap-4 md:flex-row md:items-center">
                    <div class="card flex-1 p-5 text-center">
                        <div class="eyebrow">Your browser</div>
                        <p class="mt-2 text-sm text-muted">Chat, files, editor, terminal</p>
                    </div>
                    <div class="text-center text-xs font-medium whitespace-nowrap text-link md:px-2">
                        private tunnel, direct <span aria-hidden="true">→</span>
                    </div>
                    <div class="card flex-1 border-primary-600/30 p-5 text-center">
                        <div class="eyebrow text-link">Your agents · your machine</div>
                        <p class="mt-2 text-sm text-muted">Sandboxes, repos, credentials, capabilities</p>
                    </div>
                    <div class="flex-1 rounded-2xl border border-dashed border-line p-5 text-center">
                        <div class="eyebrow">intentic platform</div>
                        <p class="mt-2 text-sm text-subtle">Identity + sandbox URL only. Off the command path.</p>
                    </div>
                </div>

                <ul class="mt-10 divide-y divide-line border-y border-line">
                    {
                        content.ownership.facts.map((fact, i) => (
                            <li class="flex flex-col gap-2 py-5 sm:flex-row sm:items-baseline sm:gap-8">
                                <div class="flex items-center gap-3 sm:w-80 sm:shrink-0">
                                    <span class="text-link">
                                        <Fragment set:html={factIcons[i] ?? ""} />
                                    </span>
                                    <h3 class="text-sm font-medium text-content">{fact.title}</h3>
                                </div>
                                <p class="text-sm leading-relaxed text-muted">{fact.body}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <!-- 4 · Economics — your subscriptions, your hardware, a flat fee -->
        <section class="border-t border-line" id="economics">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.economics.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight">{content.economics.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.economics.sub}</p>

                <div class="mt-12 grid items-start gap-6 lg:grid-cols-2">
                    <div class="card overflow-hidden">
                        <div class="border-b border-line px-5 py-3">
                            <span class="eyebrow">Your agent accounts</span>
                        </div>
                        <ul class="divide-y divide-line">
                            {
                                content.economics.accounts.map((account) => (
                                    <li class="flex items-center gap-3 px-5 py-4">
                                        <span class="h-2 w-2 shrink-0 rounded-full bg-success" />
                                        <div class="flex flex-1 flex-wrap items-baseline justify-between gap-x-3">
                                            <h3 class="text-sm font-medium text-content">{account.name}</h3>
                                            <span class="text-2xs text-subtle">{account.detail}</span>
                                        </div>
                                        <span class="chip bg-success/10 text-success">subscription</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="card p-5">
                        <div class="eyebrow">Flat, not metered</div>
                        <ul class="mt-4 space-y-3">
                            {
                                content.economics.points.map((point) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
                                        <span class="mt-0.5 shrink-0 text-link">
                                            <Fragment set:html={checkIcon} />
                                        </span>
                                        {point}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5 · Extend it — the flexibility, stated once instead of demonstrated nine times.
             This band is deliberately the quietest thing on the page: no screenshots, no figures, no
             argument. Everything here used to be a section of its own, and together they were what made
             a visitor lose track of what the product is. Each row is one line and a link to the page
             that owns it — discoverable, indexable, and not competing with the claim above. -->
        <section class="border-t border-line" id="extend">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.extend.eyebrow}</div>
                <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight">{content.extend.heading}</h2>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{content.extend.sub}</p>

                <!-- Each row places its three cells explicitly rather than auto-flowing them: name · line · arrow
                     from sm up, and name · arrow over the line below it on a phone, where a fixed name column left
                     the sentence 134px — about three words to a line. -->
                <div class="mt-10 grid border-b border-line md:grid-cols-2 md:gap-x-14">
                    {
                        content.extend.rows.map((row) => (
                            <a
                                href={row.href}
                                class="group grid grid-cols-[1fr_auto] gap-x-3 gap-y-1 border-t border-line py-4 sm:grid-cols-[10rem_1fr_auto] sm:items-baseline sm:gap-x-4"
                            >
                                <span class="col-start-1 row-start-1 text-sm font-medium text-content group-hover:text-link">{row.name}</span>
                                <span class="col-start-1 row-start-2 text-sm leading-relaxed text-muted sm:col-start-2 sm:row-start-1">{row.body}</span>
                                <span
                                    class="col-start-2 row-start-1 text-subtle transition-colors group-hover:text-link sm:col-start-3"
                                    aria-hidden="true"
                                >
                                    →
                                </span>
                            </a>
                        ))
                    }
                </div>

                <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
                    <p class="max-w-xl text-xs leading-relaxed text-subtle">{content.extend.note}</p>
                    <a href="/extensions/" class="text-sm font-medium text-link hover:underline">{content.extend.cta} →</a>
                </div>
            </div>
        </section>

        <!-- 6 · Get connected — ghost-numeral steps, no boxes -->
        <section class="border-t border-line" id="connect">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.connect.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.connect.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.connect.sub}</p>

                <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
                    {
                        content.connect.steps.map((step, i) => (
                            <div>
                                <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                    0{i + 1}
                                </div>
                                <h3 class="mt-3 text-sm font-medium text-content">{step.title}</h3>
                                <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="code-window mt-10">
                    <div class="flex items-center justify-between border-b border-line px-4 py-2">
                        <span class="eyebrow">Step 3 · your machine</span>
                    </div>
                    <pre class="px-4 py-3 text-content"><code><span class="text-subtle">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                </div>
                <p class="mt-3 text-xs text-subtle">{content.connect.commandNote}</p>
            </div>
        </section>

        <!-- 7 · FAQ — every answer open, in topic bands with a jump nav.
             Nothing here is a disclosure widget: thirteen collapsed rows made a visitor click to find out
             whether the answer was even the one they wanted, and hid the answers from in-page search. The
             grouping is what keeps a fully open FAQ scannable — bands are short, and the nav jumps to one. -->
        <section class="border-t border-line" id="faq">
            <div class="fade-in mx-auto max-w-7xl px-6 py-20 lg:py-24">
                <div class="eyebrow">FAQ</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">Questions, answered plainly.</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">
                    Including the honest ones — what's free, what's stored where, and what's not ready yet.
                </p>

                <nav class="mt-8 flex flex-wrap gap-2" aria-label="FAQ topics">
                    {
                        faqGroups.map((group) => (
                            <a
                                href={`#${group.id}`}
                                class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3.5 py-1.5 text-xs font-medium text-muted transition-colors hover:border-line-strong hover:text-content"
                            >
                                {group.label}
                                <span class="text-2xs text-subtle">{group.items.length}</span>
                            </a>
                        ))
                    }
                </nav>

                <div class="mt-12 space-y-12">
                    {
                        faqGroups.map((group) => (
                            <div id={group.id} class="scroll-mt-24">
                                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <h3 class="text-lg font-semibold tracking-tight text-content">{group.label}</h3>
                                    <p class="text-xs text-subtle">{group.blurb}</p>
                                </div>

                                {/* Rules ride on the items, not the container: in two columns a row's top borders
                                    align, and an odd last row leaves the band closed by the wrapper's bottom rule. */}
                                <div class="mt-5 grid border-b border-line md:grid-cols-2 md:gap-x-14">
                                    {group.items.map((item) => (
                                        <article id={item.id} class="scroll-mt-24 border-t border-line py-6">
                                            <h4 class="text-[0.9375rem] leading-snug font-semibold text-content">{item.question}</h4>
                                            {item.answer.map((paragraph) => (
                                                <p class="mt-2.5 max-w-prose text-sm leading-relaxed text-muted">{paragraph}</p>
                                            ))}
                                            {item.more && (
                                                <a href={item.more.href} class="mt-3 inline-block text-sm font-medium text-link hover:underline">
                                                    {item.more.label} →
                                                </a>
                                            )}
                                        </article>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line bg-card/40 px-5 py-4">
                    <p class="text-sm text-muted">Still unanswered? Ask in the open — issues are public and get a real reply.</p>
                    <a href={gitlabIssuesUrl} target="_blank" rel="noopener" class="text-sm font-medium text-link hover:underline">Open an issue →</a>
                </div>
            </div>
        </section>

        <!-- 8 · Final CTA -->
        <section class="relative overflow-hidden border-t border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="fade-in relative mx-auto max-w-7xl px-6 py-20 text-center lg:py-28">
                <div class="eyebrow">Ready</div>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{content.finalCta.heading}</h2>
                <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted">{content.finalCta.sub}</p>
                <div class="mt-8 flex justify-center gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                    <a class="btn btn-secondary" href={gitlabUrl} target="_blank" rel="noopener">See the engine</a>
                </div>
            </div>
        </section>
    </main>

    <!-- The demo, given a viewport. Empty until the hero's play button fills it: the iframe's src is set in
         script, so this page loads no part of the app unless a visitor asks for it. `display` is inline rather
         than a `hidden` class because the container is also a flex centerer — two display utilities on one
         element decide by stylesheet order, which is not a thing to depend on.

         ABOVE THE NAV (z-200 over its z-100), which is what makes this read as a window rather than as another
         section of the page: the nav is `fixed`, so at z-50 it and its bottom border sat ON TOP of the app — a
         marketing header stapled over an IDE, with the site's own line cutting across it. -->
    <div
        id="hero-demo-modal"
        style="display: none"
        class="fixed inset-0 z-200 items-center justify-center bg-black/80 p-3 backdrop-blur-sm sm:p-6"
        role="dialog"
        aria-modal="true"
        aria-label="The intentic workspace, running on a recorded fixture"
    >
        <div class="flex h-[90vh] w-[min(94vw,110rem)] flex-col overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/60">
            <div class="flex items-center gap-3 border-b border-line bg-overlay/40 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong"></span>
                <span class="rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{content.hero.shot.frameLabel}</span>
                <span class="hidden text-2xs text-subtle sm:inline">{content.hero.demo.note}</span>
                <a class="ml-auto text-2xs text-link hover:underline" href={APP_URL}>Get started free</a>
                <button id="hero-demo-close" type="button" class="cursor-pointer rounded-md border border-line px-2.5 py-1 text-2xs text-muted hover:text-content">
                    Close
                </button>
            </div>
            <div id="hero-demo-frame" class="flex-1 bg-canvas"></div>
        </div>
    </div>

    <Footer />

    <script>
        /* The hero's play button: open the real app, on its recorded fixture.
         *
         * Two behaviours, and the split is deliberate. Given a pointer and room, the demo opens in an overlay
         * with most of the viewport — an IDE embedded in half a hero column is a maze, and the page's whole
         * claim is that this is an IDE. On a narrow or touch-first screen it opens in its own tab, where the
         * app's real mobile shell can do a better job than any frame of ours.
         *
         * The iframe is created HERE rather than sitting in the markup, which is the point of the press: until
         * it, this page has loaded no part of the app. It is created once and kept, so closing and re-opening
         * returns the visitor to the workspace they were in rather than restarting the recording. */
        const play = document.querySelector<HTMLButtonElement>("#hero-demo-play");
        const modal = document.getElementById("hero-demo-modal");
        const host = document.getElementById("hero-demo-frame");
        const close = document.getElementById("hero-demo-close");
        const demoUrl = play?.dataset.demoUrl;

        if (play && modal && host && close && demoUrl) {
            const roomy = (): boolean => window.matchMedia("(min-width: 1024px) and (pointer: fine)").matches;
            const label = play.querySelector<HTMLElement>(".hero-demo-label");
            const openLabel = label?.dataset.openLabel;
            if (!roomy() && openLabel !== undefined && label) {
                label.textContent = openLabel;
            }

            const hide = (): void => {
                modal.style.display = "none";
                document.body.style.overflow = "";
            };

            play.addEventListener("click", () => {
                if (!roomy()) {
                    window.open(demoUrl, "_blank", "noopener");
                    return;
                }
                if (host.childElementCount === 0) {
                    const frame = document.createElement("iframe");
                    frame.src = demoUrl;
                    frame.title = "The intentic workspace, running on a recorded fixture";
                    frame.className = "h-full w-full border-0";
                    host.append(frame);
                }
                modal.style.display = "flex";
                // The overlay scrolls nothing of its own; a page scrolling behind it is just the hero drifting.
                document.body.style.overflow = "hidden";
            });

            close.addEventListener("click", hide);
            modal.addEventListener("click", (event) => {
                // The backdrop only — a click that lands inside the frame belongs to the app.
                if (event.target === modal) {
                    hide();
                }
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && modal.style.display !== "none") {
                    hide();
                }
            });
        }

        // Fade-in observer
        const targets = document.querySelectorAll(".fade-in");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.12 },
            );
            targets.forEach((el) => observer.observe(el));
        } else {
            targets.forEach((el) => el.classList.add("visible"));
        }

        // Scroll-based depth parallax for hero orbs
        const hero = document.getElementById("hero");
        const orbsLayer = document.querySelector(".hero-orbs");
        const gridOverlay = document.querySelector(".grid-overlay");

        if (hero && orbsLayer) {
            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            const y = window.scrollY;
                            const limit = hero.offsetHeight;
                            if (y < limit) {
                                (orbsLayer as HTMLElement).style.transform = `translateY(${y * 0.3}px) scale(${1 + y * 0.0003})`;
                                if (gridOverlay) {
                                    (gridOverlay as HTMLElement).style.transform = `translateY(${y * 0.15}px)`;
                                }
                            }
                            ticking = false;
                        });
                        ticking = true;
                    }
                },
                { passive: true },
            );
        }
    </script>
</BaseLayout>
