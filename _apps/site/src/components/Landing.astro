---
import { faqItems } from "@intentic-dev/site-content/faq";
import type { LandingContent } from "@intentic-dev/site-content/landing";
import { APP_URL, githubIssuesUrl, githubUrl } from "@intentic-dev/site-content/site";
import { buildSoftwareAppSchema } from "@intentic-dev/site-content/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
    content: LandingContent;
    noindex?: boolean;
}

const { content, noindex } = Astro.props;

const faqQuestions = faqItems.map((item) => ({ question: item.question, answer: item.answer.join(" ") }));

const permissionModes = [
    { name: "Plan mode", body: "Propose a plan and wait for your approval before running.", isDefault: true },
    { name: "Accept edits", body: "Apply file edits automatically.", isDefault: false },
    { name: "Ask before edits", body: "Ask before each file edit.", isDefault: false },
    { name: "Auto", body: "Run everything without asking.", isDefault: false },
];

const icon = (paths: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">${paths}</svg>`;

// Per-index glyphs; content stays pure copy.
const anatomyIcons = [
    icon('<path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/>'),
    icon('<path d="M12 3 3 7.5 12 12l9-4.5z"/><path d="m3 12 9 4.5L21 12M3 16.5 12 21l9-4.5"/>'),
    icon('<path d="M9.5 17H8A5 5 0 0 1 8 7h1.5"/><path d="M14.5 7H16a5 5 0 0 1 0 10h-1.5"/><path d="M8.5 12h7"/>'),
    icon('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>'),
];
const workforceIcons = [
    icon('<rect x="5" y="8.5" width="14" height="10.5" rx="2"/><path d="M12 8.5V5M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M9.5 13v1.5M14.5 13v1.5"/>'),
    icon('<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12z"/>'),
    icon('<circle cx="5" cy="12" r="2.4"/><circle cx="12" cy="12" r="2.4"/><circle cx="19" cy="12" r="2.4"/><path d="M7.4 12h2.2M14.4 12h2.2"/>'),
];
const factIcons = [
    icon('<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/>'),
    icon('<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'),
    icon('<path d="M12 2.5 20 6v5.5c0 4.8-3.4 8.2-8 9.5-4.6-1.3-8-4.7-8-9.5V6z"/>'),
];
const checkIcon = icon('<path d="M20 6 9 17l-5-5"/>');
const minusIcon = icon('<path d="M6 12h12"/>');
---

<BaseLayout
    title={content.meta.title}
    description={content.meta.description}
    faqQuestions={faqQuestions}
    extraJsonLd={[buildSoftwareAppSchema()]}
    noindex={noindex}
>
    <Nav />
    <main class="flex-1">
        <!-- 1 · Hero -->
        <section class="relative overflow-hidden" id="hero">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>

            <!-- Floating ambient orbs -->
            <div class="hero-orbs" aria-hidden="true">
                <svg width="0" height="0">
                    <defs>
                        <radialGradient id="orb-glow" cx="40%" cy="35%" r="50%">
                            <stop offset="0%" stop-color="oklch(82% 0.14 55)" />
                            <stop offset="60%" stop-color="oklch(72% 0.17 55)" />
                            <stop offset="100%" stop-color="oklch(60% 0.16 55)" />
                        </radialGradient>
                    </defs>
                </svg>

                {
                    [1, 2, 3, 4, 5, 6, 7].map((n) => (
                        <svg class={`orb orb-${n}`} viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="46" fill="url(#orb-glow)" stroke="oklch(77% 0.155 55 / 0.2)" stroke-width="0.8" />
                            <ellipse cx="38" cy="36" rx="18" ry="14" fill="rgba(255,255,255,0.10)" />
                        </svg>
                    ))
                }
            </div>

            <div class="grid-overlay" aria-hidden="true"></div>

            <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pt-32 pb-20 lg:grid-cols-2 lg:pt-40 lg:pb-28">
                <div class="animate-fade-in-up">
                    <h1 class="text-4xl leading-tight font-semibold tracking-tight xl:text-5xl">
                        {content.hero.headlineLines.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
                    </h1>
                    <p class="mt-4 max-w-lg text-base leading-relaxed text-muted">
                        {content.hero.subhead}
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                        <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the open-source engine</a>
                    </div>

                    <ul class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-subtle">
                        {
                            content.hero.chips.map((chip) => (
                                <li class="flex items-center gap-1.5">
                                    <span class="h-1 w-1 rounded-full bg-primary-500" />
                                    {chip}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Specialized-agent card: an agent as a configured worker, not a chat window -->
                <div class="animate-fade-in-up" style="animation-delay: 60ms">
                    <div class="card overflow-hidden shadow-2xl shadow-black/40">
                        <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
                            <div class="flex items-center gap-2">
                                <span class="h-2 w-2 rounded-full bg-success"></span>
                                <span class="font-mono text-xs text-content">{content.hero.spec.name}</span>
                            </div>
                            <span class="text-2xs text-subtle">{content.hero.spec.role}</span>
                        </div>
                        <div class="space-y-3.5 p-4">
                            {
                                content.hero.spec.rows.map((row) => (
                                    <div class="flex flex-col gap-1.5">
                                        <div class="eyebrow">{row.label}</div>
                                        <div class="flex flex-wrap gap-1.5">
                                            {row.items.map((item) => (
                                                <span class="rounded-md border border-line bg-overlay/50 px-2 py-0.5 font-mono text-2xs text-muted">
                                                    {item}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                ))
                            }
                            <div class="mt-1 border-t border-line pt-3.5">
                                <div class="ml-auto max-w-[90%] rounded-lg bg-overlay px-3 py-2 text-xs text-content">
                                    {content.hero.spec.task}
                                </div>
                                <div class="mt-3 flex items-center gap-2 text-2xs text-subtle">
                                    <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                                    {content.hero.spec.outcome}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2 · Why specialized — prompt vs agent -->
        <section class="border-t border-line" id="contrast">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.contrast.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.contrast.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.contrast.sub}</p>

                <div class="mt-12 grid items-start gap-6 md:grid-cols-2">
                    <div class="card p-6">
                        <div class="flex items-baseline justify-between gap-3">
                            <h3 class="text-sm font-medium text-muted">{content.contrast.prompt.label}</h3>
                            <span class="text-2xs text-subtle">{content.contrast.prompt.caption}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.contrast.prompt.points.map((point) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-subtle">
                                        <span class="mt-0.5 shrink-0 text-line-strong">
                                            <Fragment set:html={minusIcon} />
                                        </span>
                                        {point}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="card border-primary-600/30 bg-primary-600/[0.03] p-6">
                        <div class="flex items-baseline justify-between gap-3">
                            <h3 class="text-sm font-medium text-content">{content.contrast.agent.label}</h3>
                            <span class="text-2xs text-link">{content.contrast.agent.caption}</span>
                        </div>
                        <ul class="mt-5 space-y-3">
                            {
                                content.contrast.agent.points.map((point) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-content">
                                        <span class="mt-0.5 shrink-0 text-link">
                                            <Fragment set:html={checkIcon} />
                                        </span>
                                        {point}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3 · Anatomy — the four things a prompt can't give -->
        <section class="border-t border-line" id="anatomy">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.anatomy.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.anatomy.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.anatomy.sub}</p>

                <div class="mt-12 grid gap-10 sm:grid-cols-2 sm:gap-8 lg:gap-12">
                    {
                        content.anatomy.pillars.map((pillar, i) => (
                            <div class="flex gap-4">
                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-600/10 text-link">
                                    <Fragment set:html={anatomyIcons[i] ?? ""} />
                                </div>
                                <div>
                                    <h3 class="mt-1 text-sm font-medium text-content">{pillar.title}</h3>
                                    <p class="mt-2 text-sm leading-relaxed text-muted">{pillar.body}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 4 · Workforce — one agent to a graph of them -->
        <section class="border-t border-line" id="workforce">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.workforce.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.workforce.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.workforce.sub}</p>

                <div class="relative mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
                    <div
                        class="absolute top-5 right-[10%] left-[10%] hidden h-px bg-linear-to-r from-primary-500/40 via-line-strong to-primary-500/40 md:block"
                        aria-hidden="true"
                    >
                    </div>
                    {
                        content.workforce.moments.map((moment, i) => (
                            <div class="relative">
                                <div class="relative inline-flex h-10 w-10 items-center justify-center rounded-full border border-line-strong bg-canvas text-link">
                                    <Fragment set:html={workforceIcons[i] ?? ""} />
                                </div>
                                <h3 class="mt-4 text-sm font-medium text-content">{moment.title}</h3>
                                <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">{moment.body}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 5 · Ownership — diagram + definition rows -->
        <section class="border-t border-line" id="ownership">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.ownership.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.ownership.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.ownership.sub}</p>

                <div class="mt-12 flex flex-col items-stretch gap-4 md:flex-row md:items-center">
                    <div class="card flex-1 p-5 text-center">
                        <div class="eyebrow">Your browser</div>
                        <p class="mt-2 text-sm text-muted">Chat, files, editor, terminal</p>
                    </div>
                    <div class="text-center text-xs font-medium whitespace-nowrap text-link md:px-2">
                        private tunnel, direct <span aria-hidden="true">→</span>
                    </div>
                    <div class="card flex-1 border-primary-600/30 p-5 text-center">
                        <div class="eyebrow text-link">Your agents · your machine</div>
                        <p class="mt-2 text-sm text-muted">Sandboxes, repos, credentials, capabilities</p>
                    </div>
                    <div class="flex-1 rounded-2xl border border-dashed border-line p-5 text-center">
                        <div class="eyebrow">intentic platform</div>
                        <p class="mt-2 text-sm text-subtle">Identity + sandbox URL only. Off the command path.</p>
                    </div>
                </div>

                <ul class="mt-10 divide-y divide-line border-y border-line">
                    {
                        content.ownership.facts.map((fact, i) => (
                            <li class="flex flex-col gap-2 py-5 sm:flex-row sm:items-baseline sm:gap-8">
                                <div class="flex items-center gap-3 sm:w-80 sm:shrink-0">
                                    <span class="text-link">
                                        <Fragment set:html={factIcons[i] ?? ""} />
                                    </span>
                                    <h3 class="text-sm font-medium text-content">{fact.title}</h3>
                                </div>
                                <p class="text-sm leading-relaxed text-muted">{fact.body}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <!-- 6 · Control — two product vignettes -->
        <section class="border-t border-line" id="control">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.control.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.control.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.control.sub}</p>

                <div class="mt-12 grid items-start gap-6 lg:grid-cols-2">
                    <div class="card overflow-hidden">
                        <div class="border-b border-line px-5 py-3">
                            <span class="eyebrow">Permission mode</span>
                        </div>
                        <ul class="divide-y divide-line">
                            {
                                permissionModes.map((mode) => (
                                    <li class:list={["flex items-start gap-3 px-5 py-4", mode.isDefault && "bg-primary-600/5"]}>
                                        <span
                                            class:list={[
                                                "mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border",
                                                mode.isDefault ? "border-primary-500" : "border-line-strong",
                                            ]}
                                        >
                                            {mode.isDefault && <span class="h-2 w-2 rounded-full bg-primary-500" />}
                                        </span>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h3 class="text-sm font-medium text-content">{mode.name}</h3>
                                                {mode.isDefault && <span class="chip bg-primary-600/15 text-link">default</span>}
                                            </div>
                                            <p class="mt-1 text-xs leading-relaxed text-muted">{mode.body}</p>
                                        </div>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="card p-5">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <div class="eyebrow">Changes review</div>
                                <p class="mt-1 text-sm text-muted">Everything the agent touched since you last verified, as diffs.</p>
                            </div>
                            <div class="flex gap-2">
                                <span class="btn btn-secondary px-3 py-1 text-xs">Discard all</span>
                                <span class="btn btn-primary px-3 py-1 text-xs">Commit</span>
                            </div>
                        </div>
                        <div class="code-window mt-4 px-4 py-3">
                            <div><span class="text-success">+ if (attempts.exceeded(key)) return tooManyRequests();</span></div>
                            <div><span class="text-danger">- // TODO: rate-limit this endpoint</span></div>
                        </div>
                        <p class="mt-4 text-xs leading-relaxed text-subtle">
                            Environment (Dockerfile) changes are proposed, never applied — they ship only after your explicit approval.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7 · Get connected — ghost-numeral steps, no boxes -->
        <section class="border-t border-line" id="connect">
            <div class="fade-in mx-auto max-w-6xl px-6 py-20 lg:py-24">
                <div class="eyebrow">{content.connect.eyebrow}</div>
                <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight">{content.connect.heading}</h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{content.connect.sub}</p>

                <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
                    {
                        content.connect.steps.map((step, i) => (
                            <div>
                                <div class="text-5xl font-semibold tracking-tight text-primary-500/25 select-none" aria-hidden="true">
                                    0{i + 1}
                                </div>
                                <h3 class="mt-3 text-sm font-medium text-content">{step.title}</h3>
                                <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="code-window mt-10">
                    <div class="flex items-center justify-between border-b border-line px-4 py-2">
                        <span class="eyebrow">Step 3 · your machine</span>
                    </div>
                    <pre class="px-4 py-3 text-content"><code><span class="text-subtle">$ </span>curl -fsSL https://intentic.dev/connect | sh</code></pre>
                </div>
                <p class="mt-3 text-xs text-subtle">{content.connect.commandNote}</p>
            </div>
        </section>

        <!-- 8 · FAQ — sticky intro + hairline rows -->
        <section class="border-t border-line" id="faq">
            <div class="fade-in mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[1fr_1.6fr] lg:py-24">
                <div class="self-start lg:sticky lg:top-28">
                    <div class="eyebrow">FAQ</div>
                    <h2 class="mt-3 text-3xl font-semibold tracking-tight">Questions, answered plainly.</h2>
                    <p class="mt-3 max-w-sm text-base leading-relaxed text-muted">
                        Including the honest ones — what's free, what's stored where, and what's not ready yet.
                    </p>
                    <a href={githubIssuesUrl} target="_blank" rel="noopener" class="mt-4 inline-block text-sm text-link hover:underline">
                        Something unanswered? Open an issue →
                    </a>
                </div>

                <div>
                    {
                        faqItems.map((item) => (
                            <details class="group border-b border-line first:border-t" id={item.id}>
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-sm font-medium text-content transition-colors hover:text-link [&::-webkit-details-marker]:hidden">
                                    {item.question}
                                    <svg
                                        class="shrink-0 text-subtle transition-transform duration-200 group-open:rotate-45"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 14 14"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        aria-hidden="true"
                                    >
                                        <path d="M7 1v12M1 7h12" />
                                    </svg>
                                </summary>
                                <div class="pb-5">
                                    {item.answer.map((paragraph) => (
                                        <p class="text-sm leading-relaxed text-muted [&+p]:mt-3">{paragraph}</p>
                                    ))}
                                </div>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 9 · Final CTA -->
        <section class="relative overflow-hidden border-t border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/15 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="fade-in relative mx-auto max-w-6xl px-6 py-20 text-center lg:py-28">
                <div class="eyebrow">Ready</div>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{content.finalCta.heading}</h2>
                <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-muted">{content.finalCta.sub}</p>
                <div class="mt-8 flex justify-center gap-3">
                    <a class="btn btn-primary" href={APP_URL}>Get started free</a>
                    <a class="btn btn-secondary" href={githubUrl} target="_blank" rel="noopener">See the engine</a>
                </div>
            </div>
        </section>
    </main>
    <Footer />

    <script>
        // Fade-in observer
        const targets = document.querySelectorAll(".fade-in");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observer.unobserve(entry.target);
                        }
                    }
                },
                { threshold: 0.12 },
            );
            targets.forEach((el) => observer.observe(el));
        } else {
            targets.forEach((el) => el.classList.add("visible"));
        }

        // Scroll-based depth parallax for hero orbs
        const hero = document.getElementById("hero");
        const orbsLayer = document.querySelector(".hero-orbs");
        const gridOverlay = document.querySelector(".grid-overlay");

        if (hero && orbsLayer) {
            let ticking = false;
            window.addEventListener(
                "scroll",
                () => {
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            const y = window.scrollY;
                            const limit = hero.offsetHeight;
                            if (y < limit) {
                                (orbsLayer as HTMLElement).style.transform = `translateY(${y * 0.3}px) scale(${1 + y * 0.0003})`;
                                if (gridOverlay) {
                                    (gridOverlay as HTMLElement).style.transform = `translateY(${y * 0.15}px)`;
                                }
                            }
                            ticking = false;
                        });
                        ticking = true;
                    }
                },
                { passive: true },
            );
        }
    </script>
</BaseLayout>
