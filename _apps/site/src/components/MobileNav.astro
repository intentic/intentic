---
import { navEntries } from "@intentic-dev/content/nav";
import { APP_URL, githubUrl } from "@intentic-dev/content/site";
---

<div class="mobile-nav-overlay" id="mobile-nav-overlay">
    <div class="mobile-nav-inner">
        <ul class="mobile-nav-list">
            {
                navEntries.map((entry) => {
                    if (entry.type === "dropdown") {
                        return (
                            <li class="mobile-nav-group">
                                <button type="button" class="mobile-nav-heading" aria-expanded="false">
                                    {entry.label}
                                    <svg
                                        class="mobile-chevron"
                                        width="12"
                                        height="7"
                                        viewBox="0 0 12 7"
                                        fill="none"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M1 1L6 6L11 1"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </button>
                                <ul class="mobile-subnav">
                                    {entry.items.map((item) => (
                                        <li>
                                            <a
                                                href={item.href}
                                                class="mobile-nav-link sub"
                                                target={item.external ? "_blank" : undefined}
                                                rel={item.external ? "noopener" : undefined}
                                            >
                                                {item.label}
                                                {item.external && (
                                                    <svg
                                                        class="external-icon"
                                                        width="12"
                                                        height="12"
                                                        viewBox="0 0 12 12"
                                                        fill="none"
                                                        aria-hidden="true"
                                                    >
                                                        <path
                                                            d="M3.5 1.5H10.5V8.5M10.5 1.5L1.5 10.5"
                                                            stroke="currentColor"
                                                            stroke-width="1.2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        />
                                                    </svg>
                                                )}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        );
                    }

                    if (entry.type === "link") {
                        return (
                            <li>
                                <a
                                    href={entry.href}
                                    class="mobile-nav-link"
                                    target={entry.external ? "_blank" : undefined}
                                    rel={entry.external ? "noopener" : undefined}
                                >
                                    {entry.label}
                                    {entry.external && (
                                        <svg
                                            class="external-icon"
                                            width="12"
                                            height="12"
                                            viewBox="0 0 12 12"
                                            fill="none"
                                            aria-hidden="true"
                                        >
                                            <path
                                                d="M3.5 1.5H10.5V8.5M10.5 1.5L1.5 10.5"
                                                stroke="currentColor"
                                                stroke-width="1.2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    )}
                                </a>
                            </li>
                        );
                    }
                })
            }

            <li class="mobile-nav-divider"></li>

            <li>
                <a href={githubUrl} target="_blank" rel="noopener" class="mobile-nav-link">
                    <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16" aria-hidden="true">
                        <path
                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
                        />
                    </svg>
                    GitHub
                </a>
            </li>
        </ul>

        <a class="btn btn-primary mobile-cta" href={APP_URL}>Get started free</a>
    </div>
</div>

<style>
    /* ── Mobile nav overlay ────────────────────────────── */
    .mobile-nav-overlay {
        position: fixed;
        inset: 0;
        top: 4rem;
        z-index: 99;
        background: color-mix(in srgb, var(--color-canvas) 98%, transparent);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-12px);
        transition:
            opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.28s,
            transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .mobile-nav-overlay.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .mobile-nav-inner {
        max-width: 32rem;
        margin: 0 auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        min-height: calc(100dvh - 4rem);
    }

    /* ── List ──────────────────────────────────────────── */
    .mobile-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* ── Links ─────────────────────────────────────────── */
    .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-muted);
        border-radius: 10px;
        text-decoration: none;
        transition:
            color 0.15s,
            background 0.15s;
    }

    .mobile-nav-link:hover {
        color: var(--color-content);
        background: var(--color-overlay);
    }

    .mobile-nav-link.sub {
        font-size: 0.925rem;
        padding: 12px 16px 12px 28px;
        color: var(--color-subtle);
    }

    .mobile-nav-link.sub:hover {
        color: var(--color-content);
    }

    /* ── Accordion heading ─────────────────────────────── */
    .mobile-nav-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 14px 16px;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-content);
        background: none;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.15s;
    }

    .mobile-nav-heading:hover {
        background: var(--color-overlay);
    }

    .mobile-chevron {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-nav-heading[aria-expanded="true"] .mobile-chevron {
        transform: rotate(180deg);
    }

    /* ── Sub-nav (collapsed by default) ────────────────── */
    .mobile-subnav {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
    }

    .mobile-subnav > * {
        min-height: 0;
    }

    .mobile-nav-group.expanded .mobile-subnav {
        grid-template-rows: 1fr;
    }

    /* ── Divider ───────────────────────────────────────── */
    .mobile-nav-divider {
        height: 1px;
        background: var(--color-line);
        margin: 12px 16px;
    }

    /* ── External icon ─────────────────────────────────── */
    .external-icon {
        opacity: 0.4;
        flex-shrink: 0;
    }

    /* ── CTA button ────────────────────────────────────── */
    .mobile-cta {
        margin-top: auto;
        padding-top: 1.5rem;
        width: 100%;
        text-align: center;
    }

    /* ── Only visible on mobile ────────────────────────── */
    @media (min-width: 48.0625rem) {
        .mobile-nav-overlay {
            display: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const overlay = document.getElementById("mobile-nav-overlay");
        const toggle = document.getElementById("mobile-nav-open");

        // Accordion toggles
        overlay?.querySelectorAll(".mobile-nav-heading").forEach((btn) => {
            btn.addEventListener("click", () => {
                const group = btn.closest(".mobile-nav-group");
                const wasExpanded = group?.classList.contains("expanded");

                // Collapse all other groups
                overlay.querySelectorAll(".mobile-nav-group.expanded").forEach((g) => {
                    g.classList.remove("expanded");
                    g.querySelector(".mobile-nav-heading")?.setAttribute("aria-expanded", "false");
                });

                // Toggle the clicked group
                if (!wasExpanded) {
                    group?.classList.add("expanded");
                    btn.setAttribute("aria-expanded", "true");
                }
            });
        });

        // Close on link click
        overlay?.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => {
                overlay.classList.remove("open");
                toggle?.classList.remove("active");
                toggle?.setAttribute("aria-expanded", "false");
                document.body.style.overflow = "";
            });
        });
    });
</script>
