---
import type { LegalDoc } from "@intentic-dev/content/legal";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
    doc: LegalDoc;
    eyebrow: string;
}

const { doc, eyebrow } = Astro.props;
---

<BaseLayout>
    <Nav />
    <main class="flex-1">
        <section class="mx-auto max-w-3xl px-6 pt-32 pb-24 max-sm:pt-28">
            <div class="eyebrow">{eyebrow}</div>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{doc.title}</h1>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">{doc.intro}</p>

            <div class="mt-10 flex flex-col gap-8">
                {
                    doc.sections.map((section) => (
                        <section>
                            <h2 class="text-lg font-semibold text-content">{section.heading}</h2>
                            {section.paragraphs.map((paragraph) => (
                                <p class="mt-3 text-sm leading-7 text-muted">{paragraph}</p>
                            ))}
                            {section.list && (
                                <ul class="mt-3 list-disc space-y-2 pl-5">
                                    {section.list.map((item) => (
                                        <li class="text-sm leading-7 text-muted">{item}</li>
                                    ))}
                                </ul>
                            )}
                        </section>
                    ))
                }
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
