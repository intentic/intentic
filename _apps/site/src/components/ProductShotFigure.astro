---
import type { ProductShot } from "@intentic-dev/site-content/product";
import { Image } from "astro:assets";
import { shotAsset, SHOT_WIDTHS } from "../lib/shots";

/* One screenshot, framed. The browser frame carries the route the shot was taken on, so a reader can go open
 * the same screen in the live demo; the phone frame exists because a 430px-wide shot in a bare box reads as a
 * cropped desktop. `bare` is for panels that are already a window of their own (the docked chat). */

interface Props {
    shot: ProductShot;
    /** The hero is the page's LCP; everything below it waits until it is scrolled near. */
    priority?: boolean;
    /**
     * How wide the page paints this shot, so the browser can pick a rung of its srcset. The frame cannot
     * know — a hero owns the whole column and a paired block owns half of it — so the page says. The phone
     * frame is the exception below: it caps its own width, so it describes itself.
     */
    sizes: string;
    class?: string;
}

const { shot, priority = false, sizes, class: className = "" } = Astro.props;
const image = shotAsset(shot.name);
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : undefined;
---

{
    shot.frame === "browser" && (
        <div class:list={["overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50", className]}>
            <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                {shot.label && (
                    <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{shot.label}</span>
                )}
            </div>
            <Image src={image} alt={shot.alt} widths={SHOT_WIDTHS} sizes={sizes} loading={loading} fetchpriority={fetchpriority} decoding="async" class="w-full" />
        </div>
    )
}

{
    shot.frame === "phone" && (
        <div class:list={["mx-auto w-full max-w-[27rem] overflow-hidden rounded-[2rem] border border-line-strong bg-card p-2 shadow-2xl shadow-black/50", className]}>
            <Image
                src={image}
                alt={shot.alt}
                widths={SHOT_WIDTHS}
                sizes="(min-width: 29rem) 416px, calc(100vw - 4rem)"
                loading={loading}
                fetchpriority={fetchpriority}
                decoding="async"
                class="w-full rounded-[1.5rem]"
            />
        </div>
    )
}

{
    shot.frame === "bare" && (
        <Image
            src={image}
            alt={shot.alt}
            widths={SHOT_WIDTHS}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
            class:list={["w-full rounded-xl border border-line shadow-2xl shadow-black/50", className]}
        />
    )
}
