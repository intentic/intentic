---
import type { ProductShot } from "@intentic-dev/site-content/product";

/* One screenshot, framed. The browser frame carries the route the shot was taken on, so a reader can go open
 * the same screen in the live demo; the phone frame exists because a 430px-wide shot in a bare box reads as a
 * cropped desktop. `bare` is for panels that are already a window of their own (the docked chat). */

interface Props {
    shot: ProductShot;
    /** The hero is the page's LCP; everything below it waits until it is scrolled near. */
    priority?: boolean;
    class?: string;
}

const { shot, priority = false, class: className = "" } = Astro.props;
const loading = priority ? undefined : "lazy";
const fetchpriority = priority ? "high" : undefined;
---

{
    shot.frame === "browser" && (
        <div class:list={["overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/50", className]}>
            <div class="flex items-center gap-2 border-b border-line bg-overlay/40 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
                {shot.label && (
                    <span class="ml-3 rounded-md border border-line bg-canvas/60 px-3 py-1 font-mono text-2xs text-subtle">{shot.label}</span>
                )}
            </div>
            <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading={loading} fetchpriority={fetchpriority} decoding="async" class="w-full" />
        </div>
    )
}

{
    shot.frame === "phone" && (
        <div class:list={["mx-auto w-full max-w-[280px] overflow-hidden rounded-[2rem] border border-line-strong bg-card p-2 shadow-2xl shadow-black/50", className]}>
            <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading={loading}
                fetchpriority={fetchpriority}
                decoding="async"
                class="w-full rounded-[1.5rem]"
            />
        </div>
    )
}

{
    shot.frame === "bare" && (
        <img
            src={shot.src}
            alt={shot.alt}
            width={shot.width}
            height={shot.height}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
            class:list={["w-full rounded-xl border border-line shadow-2xl shadow-black/50", className]}
        />
    )
}
