---
import type { NavEntry } from "@intentic-dev/site-content/nav";
import { navEntries } from "@intentic-dev/site-content/nav";
import { APP_URL, gitlabUrl, ORG_NAME } from "@intentic-dev/site-content/site";
import { Image } from "astro:assets";
import logo from "../assets/intentic-full.png";
import { shotAsset, SHOT_WIDTHS } from "../lib/shots";
import MobileNav from "./MobileNav.astro";

const currentPath = Astro.url.pathname;

function isActive(entry: NavEntry): boolean {
    if (entry.type === "link") {
        return currentPath === entry.href || currentPath.startsWith(entry.prefix);
    }
    return currentPath.startsWith(entry.prefix);
}

/* A menu row points at ONE page, so it lights up only on that page. The trigger above matches a prefix because
 * a whole menu is "current"; a row must not — /docs/ is a prefix of every docs page, which made "Overview" the
 * current row everywhere under Docs, and "Extensions" current on each of its three children.
 * The trailing slash is "always" in a build and "ignore" in dev, so it is not part of the comparison. */
const bare = (path: string): string => path.replace(/\/+$/, "");
const isCurrentPage = (href: string): boolean => bare(href) === bare(currentPath);
---

<nav class="fixed top-0 right-0 left-0 z-100 border-b border-line bg-canvas/70 backdrop-blur-lg transition-colors duration-300">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
        {/* The wordmark is what a phone paints largest before the hero image arrives, so it IS the LCP on
            every page here — hence eager and fetchpriority=high, ahead of the stylesheet's other requests. */}
        <a href="/" class="flex items-center no-underline">
            <Image src={logo} alt={ORG_NAME} width={126} height={24} densities={[2]} loading="eager" fetchpriority="high" class="h-6 w-auto" />
        </a>

        <button
            class="hamburger flex-col gap-1.25 p-1 md:hidden"
            id="mobile-nav-open"
            aria-label="Toggle navigation"
            aria-expanded="false"
        >
            <span></span><span></span><span></span>
        </button>

        <ul class="links flex list-none items-center gap-0.5 max-md:hidden" id="nav-links">
            {
                navEntries.map((entry) => {
                    if (entry.type === "menu") {
                        const preview = entry.sections
                            .flatMap((section) => section.items)
                            .flatMap((item) => (item.shot === undefined ? [] : [{ href: item.href, shot: item.shot }]));
                        return (
                            <li class="nav-item has-menu">
                                <button type="button" class:list={["nav-link", { active: isActive(entry) }]} aria-expanded="false">
                                    {entry.label}
                                    <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>

                                {/* The panel. Its column count follows the section count, so Docs reads as its
                                    four shelves and Product as two — and the preview rail exists only where
                                    there are screenshots to preview. */}
                                <div class:list={["menu-panel", { "has-preview": preview.length > 0 }]}>
                                    <div class="menu-sections" style={`--menu-columns:${entry.sections.length}`}>
                                        {entry.sections.map((section) => (
                                            <div class="menu-section">
                                                <div class="menu-section-label">{section.label}</div>
                                                <ul>
                                                    {section.items.map((item) => (
                                                        <li>
                                                            <a
                                                                href={item.href}
                                                                class:list={["menu-item", { active: isCurrentPage(item.href) }]}
                                                                data-preview={item.shot === undefined ? undefined : item.href}
                                                                target={item.external ? "_blank" : undefined}
                                                                rel={item.external ? "noopener" : undefined}
                                                            >
                                                                <span class="menu-item-label">{item.label}</span>
                                                                <span class="menu-item-blurb">{item.description}</span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>

                                    {preview.length > 0 && (
                                        <div class="menu-preview">
                                            {preview.map(({ href, shot }, i) => (
                                                /* A fixed 34rem box — the menu only exists from md up, so
                                                   this is one width, not a viewport formula. The rail asks
                                                   for 170% below, but Tailwind's `img { max-width: 100% }`
                                                   holds it to the box, and `sizes` follows what paints. */
                                                <Image
                                                    src={shotAsset(shot.name)}
                                                    alt={shot.alt}
                                                    widths={SHOT_WIDTHS}
                                                    sizes="544px"
                                                    loading="lazy"
                                                    decoding="async"
                                                    class:list={["menu-preview-shot", { current: i === 0 }]}
                                                    data-preview-for={href}
                                                />
                                            ))}
                                        </div>
                                    )}

                                    {entry.action && (
                                        <a
                                            class="menu-action"
                                            href={entry.action.href}
                                            target={entry.action.external ? "_blank" : undefined}
                                            rel={entry.action.external ? "noopener" : undefined}
                                        >
                                            {entry.action.label} <span aria-hidden="true">→</span>
                                        </a>
                                    )}
                                </div>
                            </li>
                        );
                    }

                    if (entry.type === "link") {
                        return (
                            <li class="nav-item">
                                <a
                                    href={entry.href}
                                    class:list={["nav-link", { active: isActive(entry) }]}
                                    target={entry.external ? "_blank" : undefined}
                                    rel={entry.external ? "noopener" : undefined}
                                >
                                    {entry.label}
                                    {entry.external && (
                                        <svg
                                            class="external-icon"
                                            width="12"
                                            height="12"
                                            viewBox="0 0 12 12"
                                            fill="none"
                                            aria-hidden="true"
                                        >
                                            <path
                                                d="M3.5 1.5H10.5V8.5M10.5 1.5L1.5 10.5"
                                                stroke="currentColor"
                                                stroke-width="1.2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    )}
                                </a>
                            </li>
                        );
                    }
                })
            }

            <li class="nav-item">
                <a
                    href={gitlabUrl}
                    target="_blank"
                    rel="noopener"
                    class="nav-link"
                    aria-label="GitLab repository"
                >
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                        <path
                            d="m23.6004 9.5927-.0337-.0862L20.3.9814a.851.851 0 0 0-.3362-.405.8748.8748 0 0 0-.9997.0539.8748.8748 0 0 0-.29.4399l-2.2055 6.748H7.5375l-2.2057-6.748a.8573.8573 0 0 0-.29-.4412.8748.8748 0 0 0-.9997-.0539.8585.8585 0 0 0-.3362.405L.4332 9.5015l-.0325.0862a6.0657 6.0657 0 0 0 2.0119 7.0105l.0113.0087.0299.0213 4.976 3.7264 2.462 1.8633 1.4995 1.1321a1.0085 1.0085 0 0 0 1.2197 0l1.4995-1.1321 2.462-1.8633 5.006-3.7489.0125-.01a6.0682 6.0682 0 0 0 2.0094-7.003z"
                        />
                    </svg>
                </a>
            </li>

            <li class="max-md:mt-1">
                <a class="btn btn-primary ml-2 max-md:ml-0 max-md:w-full" href={APP_URL}>Get started free</a>
            </li>
        </ul>
    </div>
</nav>

<MobileNav />

<style>
    /* ── Nav base ──────────────────────────────────────── */
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
    }
    .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-muted);
        border-radius: 2px;
        transition:
            transform 0.3s,
            opacity 0.3s;
    }
    .hamburger.active span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .hamburger.active span:nth-child(2) {
        opacity: 0;
    }
    .hamburger.active span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Nav items ─────────────────────────────────────── */
    .nav-item {
        position: relative;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-muted);
        padding: 8px 14px;
        border-radius: 8px;
        transition:
            color 0.2s,
            background 0.2s;
        cursor: pointer;
        background: none;
        border: none;
        font-family: inherit;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-link.active {
        color: var(--color-content);
    }

    .nav-link:hover {
        color: var(--color-content);
        background: var(--color-overlay);
    }

    /* ── Chevron ────────────────────────────────────────── */
    .chevron {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        margin-top: 1px;
    }

    .has-menu:hover .chevron,
    .has-menu:focus-within .chevron {
        transform: rotate(180deg);
    }

    /* ── Mega-menu panel ───────────────────────────────────
       One panel shape for both menus: a grid of labelled sections, an optional screenshot rail, and one
       action at the foot. It is centred under its trigger and clamped to the viewport, so the Product panel
       (wide, with a preview) and the Docs panel (four narrow shelves) both stay on screen at 1024px. */
    .menu-panel {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        display: grid;
        grid-template-areas: "sections" "action";
        gap: 4px;
        width: max-content;
        max-width: min(94vw, 78rem);
        /* Opaque, not "nearly": the panel sits over the hero's white 3xl heading, and on a canvas this dark
           even 3% bleed lifts that text ~8/255 — which the blur then spreads into a legible ghost across the
           menu. The translucency belongs to the nav BAR, which content is meant to scroll under; a menu has
           to be readable. Nothing behind it means backdrop-filter buys only a compositing layer. */
        background: var(--color-canvas);
        border: 1px solid var(--color-line);
        border-top: 2px solid var(--color-link);
        border-radius: 14px;
        padding: 14px;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.22s,
            transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.4),
            0 0 0 1px color-mix(in srgb, var(--color-link) 8%, transparent),
            0 0 40px color-mix(in srgb, var(--color-link) 4%, transparent);
    }

    .menu-panel.has-preview {
        grid-template-areas:
            "sections preview"
            "action   preview";
        grid-template-columns: minmax(0, 1fr) 34rem;
        gap: 4px 18px;
    }

    .has-menu:hover .menu-panel,
    .has-menu:focus-within .menu-panel {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .menu-sections {
        grid-area: sections;
        display: grid;
        grid-template-columns: repeat(var(--menu-columns, 2), minmax(11rem, 1fr));
        gap: 4px 10px;
    }

    .menu-section > ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .menu-section-label {
        padding: 6px 12px;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .menu-item {
        display: block;
        padding: 8px 12px;
        border-radius: 9px;
        text-decoration: none;
        transition:
            background 0.15s,
            color 0.15s;
    }

    .menu-item-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-content);
    }

    .menu-item-blurb {
        display: block;
        margin-top: 2px;
        max-width: 15rem;
        font-size: 0.75rem;
        line-height: 1.35;
        color: var(--color-subtle);
    }

    .menu-item:hover,
    .menu-item:focus-visible {
        background: color-mix(in srgb, var(--color-link) 10%, transparent);
        outline: none;
    }

    .menu-item:hover .menu-item-blurb,
    .menu-item:focus-visible .menu-item-blurb {
        color: var(--color-muted);
    }

    .menu-item.active {
        background: color-mix(in srgb, var(--color-content) 6%, transparent);
    }

    .menu-item.active .menu-item-label {
        color: var(--color-link);
    }

    /* The rail: every product shot stacked, one visible. Cropped to a wide strip — the panel is selling the
       surface at a glance, and the whole 1240px-tall board would shrink to nothing here. It is 34rem because
       the shots are 1072 CSS px of real interface: a rail much narrower than that renders the app's own text
       too small to read, which is all a preview has to do. */
    .menu-preview {
        grid-area: preview;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--color-line);
        border-radius: 10px;
        background: var(--color-card);
        aspect-ratio: 16 / 10;
    }

    /* Zoomed to its top-left corner rather than fitted: a whole surface scaled to fit the rail is a grey
       rectangle, while its first lanes are recognisably the screen the row leads to. 170% of a 34rem rail is
       ~925px of a 1072px-wide shot — near enough to native that the lane headers and card titles read. */
    .menu-preview-shot {
        position: absolute;
        top: 0;
        left: 0;
        width: 170%;
        height: auto;
        opacity: 0;
        transition: opacity 0.18s ease;
    }

    .menu-preview-shot.current {
        opacity: 1;
    }

    .menu-action {
        grid-area: action;
        margin-top: 6px;
        border-top: 1px solid var(--color-line);
        padding: 12px 12px 4px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-link);
        text-decoration: none;
    }

    .menu-action:hover {
        text-decoration: underline;
    }

    /* ── External link icon ────────────────────────────── */
    .external-icon {
        opacity: 0.4;
        flex-shrink: 0;
    }

    /* ── Responsive ────────────────────────────────────── */
    @media (max-width: 48rem) {
        .hamburger {
            display: flex;
        }
        .links {
            display: none;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("mobile-nav-open");
        const overlay = document.getElementById("mobile-nav-overlay");

        toggle?.addEventListener("click", () => {
            const isOpen = overlay?.classList.toggle("open");
            toggle.classList.toggle("active", isOpen);
            toggle.setAttribute("aria-expanded", String(!!isOpen));
            document.body.style.overflow = isOpen ? "hidden" : "";
        });

        // The preview rail follows the hovered row. Pointer only: on a touch screen the panel opens on tap
        // and the rail just shows the first shot, which is the one the panel is already about.
        document.querySelectorAll(".menu-panel.has-preview").forEach((panel) => {
            const shots = panel.querySelectorAll(".menu-preview-shot");
            const show = (href) => {
                shots.forEach((shot) => shot.classList.toggle("current", shot.dataset.previewFor === href));
            };
            panel.querySelectorAll("[data-preview]").forEach((item) => {
                item.addEventListener("pointerenter", () => show(item.dataset.preview));
                item.addEventListener("focus", () => show(item.dataset.preview));
            });
        });
    });
</script>
