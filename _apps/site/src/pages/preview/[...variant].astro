---
import type { LandingVariantId } from "@intentic-dev/site-content/landing";
import { landingVariants } from "@intentic-dev/site-content/landing";
import Landing from "../../components/Landing.astro";

// Dev-only side-by-side comparison of the landing variants; no routes in production builds.
// The rest param also serves bare /preview/, which falls back to variant a below.
export function getStaticPaths() {
    if (!import.meta.env.DEV) return [];
    return [
        { params: { variant: undefined } },
        ...Object.keys(landingVariants).map((variant) => ({ params: { variant } })),
    ];
}

const requested = Astro.params.variant as LandingVariantId | undefined;
const content = (requested && landingVariants[requested]) || landingVariants.a;
---

<Landing content={content} noindex showVariantSwitcher />
