---
import { REGISTRY_TOPIC } from "@intentic/registry";
import { APP_URL } from "@intentic-dev/site-content/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import { loadGallery, markInitials, markLogoUrl, sourceHref } from "../../lib/registry";

/* The extension gallery: the official registry repository, rendered. Built from its two JSON files at build
 * time (src/lib/registry.ts), so this page has no backend behind it — curation is pull requests over there
 * and a deploy is how the result reaches the web.
 *
 * Verified leads and stars rank within it, which is what compareEntries already decided; the page just says
 * out loud what that ordering does and does not claim, because a gallery sorted by a number readers know is
 * purchasable will otherwise be read as a ranking of quality. */

const { entries, scannedAt, stale } = await loadGallery();

const verified = entries.filter((entry) => entry.trust === "verified");
const listed = entries.filter((entry) => entry.trust !== "verified");

const groups = [
    { key: "verified", heading: "Verified", blurb: "Somebody here read the source at the listed commit.", entries: verified },
    { key: "listed", heading: "Listed", blurb: "The pointer resolves and the manifest parses. Nobody has read the code.", entries: listed },
].filter((group) => group.entries.length > 0);

// Built as one string rather than interpolated across template lines, where the newlines become stray spaces.
const scannedNote =
    scannedAt === undefined
        ? undefined
        : `Star counts last read ${new Date(scannedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}${
              stale ? ", from a vendored snapshot, because the registry was unreachable at build time" : ""
          }.`;
---

<BaseLayout
    title="Extensions · intentic"
    description="Every published intentic extension: what it adds, who wrote it, and the exact commit you'd install. A registry of pointers to other people's repositories; intentic hosts none of the code."
>
    <Nav />
    <main class="flex-1">
        <section class="relative overflow-hidden border-b border-line">
            <div class="absolute inset-0 bg-linear-to-br from-primary-600/10 via-canvas to-canvas" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-7xl px-6 pt-28 pb-14 lg:pt-32">
                <div class="eyebrow">Extensions</div>
                <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
                    Everything the community has published.
                </h1>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                    An extension is a git repo with a manifest. This page is a registry of <strong class="text-content">pointers</strong> to those
                    repos at a commit. intentic hosts none of the code, builds none of it, and takes no cut. Installing follows the pointer from
                    your own sandbox straight to the author's git host.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a class="btn btn-primary" href="/docs/extensions/build/">Build one</a>
                    <a class="btn btn-secondary" href="/docs/extensions/publish/">Get listed</a>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-7xl space-y-16 px-6 py-16 lg:py-20">
            {
                groups.length === 0 && (
                    <section class="card px-6 py-12 text-center">
                        <h2 class="text-lg font-semibold tracking-tight text-content">Nothing listed yet.</h2>
                        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
                            The registry is open and empty, which makes this a good moment to be the first. Add the{" "}
                            <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repository and a nightly job opens your pull request
                            for you.
                        </p>
                        <a class="btn btn-primary mt-6" href="/docs/extensions/build/">
                            Build an extension
                        </a>
                    </section>
                )
            }

            {
                groups.map((group) => (
                    <section>
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h2 class="text-lg font-semibold tracking-tight text-content">{group.heading}</h2>
                            <p class="text-xs text-subtle">{group.blurb}</p>
                        </div>
                        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            {group.entries.map((entry) => (
                                <article class="card flex flex-col gap-3 p-6">
                                    <div class="flex items-center gap-3">
                                        {/* The author's mark over its initials — see markInitials for why this
                                            page draws two tiers where the app draws three. The image sits OVER
                                            the letters rather than instead of them, so a slug that 404s at
                                            build time reveals the tier below instead of a hole. */}
                                        <span class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-content/5 text-xs font-semibold text-muted">
                                            {markInitials(entry.name)}
                                            {markLogoUrl(entry) && (
                                                <img
                                                    src={markLogoUrl(entry)}
                                                    alt=""
                                                    referrerpolicy="no-referrer"
                                                    class="absolute h-5 w-5 object-contain"
                                                />
                                            )}
                                        </span>
                                        <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                            <h3 class="min-w-0 truncate font-mono text-sm font-medium text-content">{entry.name}</h3>
                                            {entry.version && <span class="shrink-0 text-2xs text-subtle">{entry.version}</span>}
                                            {entry.stars !== undefined && <span class="ml-auto shrink-0 text-2xs text-subtle">★ {entry.stars}</span>}
                                        </div>
                                    </div>
                                    {entry.description && <p class="text-sm leading-relaxed text-muted">{entry.description}</p>}
                                    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-2xs">
                                        {entry.category && <span class="text-subtle">{entry.category}</span>}
                                        {sourceHref(entry) && (
                                            <a class="text-link hover:underline" href={sourceHref(entry)} rel="noopener nofollow">
                                                Source
                                            </a>
                                        )}
                                        {entry.homepage && (
                                            <a class="text-link hover:underline" href={entry.homepage} rel="noopener nofollow">
                                                Homepage
                                            </a>
                                        )}
                                    </div>
                                    {/* The sha is the product. It is what you approve, what runs, and what a
                                        force-push upstream cannot change, so it is on the card rather than a
                                        click away, ready to paste into the install form. */}
                                    {entry.install?.ref && (
                                        <code class="overflow-x-auto rounded-md border border-line bg-canvas px-2.5 py-1.5 font-mono text-2xs whitespace-nowrap text-subtle">
                                            {entry.install.ref}
                                        </code>
                                    )}
                                </article>
                            ))}
                        </div>
                    </section>
                ))
            }

            <section class="card p-6 lg:p-8">
                <h2 class="text-lg font-semibold tracking-tight text-content">How to read this page</h2>
                <div class="mt-4 grid gap-6 text-sm leading-relaxed text-muted sm:grid-cols-2">
                    <div>
                        <h3 class="font-medium text-content">The order is not a ranking of quality</h3>
                        <p class="mt-2">
                            Verified goes first because it is the one thing a person actually asserted. Stars rank within a tier and are shown
                            because they're useful to weigh. They are also the most purchasable number on GitHub, so they don't get to be the
                            whole sort. Ties break on the most recent push.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">A listing is not an audit</h3>
                        <p class="mt-2">
                            Review checks that the pointer resolves, the manifest parses, and the publisher owns the repo. Installing an extension
                            is trusting its author. What intentic adds is that the trust is bounded and legible: the
                            <a class="text-link hover:underline" href="/docs/extensions/manifest/">manifest</a> is the approval surface, and it
                            can't grow past what you approved without asking you again.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">Installing</h3>
                        <p class="mt-2">
                            In the app, <strong class="text-content">Capabilities → Add → Extension</strong> browses this registry and fills the
                            form in a click. Or paste a card's repo URL and commit sha by hand; same thing.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-medium text-content">Publishing, and your own registry</h3>
                        <p class="mt-2">
                            Add the <code class="text-content">{REGISTRY_TOPIC}</code> topic to your repo and a nightly job opens the pull request
                            for you. Registries are also plural: point a sandbox at an internal repo and you have a private catalogue that never
                            touches this one. <a class="text-link hover:underline" href="/docs/extensions/publish/">The publish guide</a> has both.
                        </p>
                    </div>
                </div>
                {scannedNote && <p class="mt-6 border-t border-line pt-4 text-2xs text-subtle">{scannedNote}</p>}
            </section>
        </div>

        <section class="border-t border-line">
            <div class="mx-auto max-w-7xl px-6 py-14 text-center">
                <h2 class="text-xl font-semibold tracking-tight text-content">Extend it yourself.</h2>
                <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
                    The first-party views ship against the same public API a third-party bundle uses. Nothing here is a privileged path you can't
                    take.
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <a class="btn btn-primary" href="/docs/extensions/build/">Build an extension</a>
                    <a class="btn btn-secondary" href={APP_URL}>Open the app</a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
