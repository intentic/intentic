{
    "name": "@intentic/lsp",
    "version": "0.0.0",
    "description": "lsp, agent-native TypeScript rename + diagnostics CLI over the native TypeScript compiler",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_search/lsp"
    },
    "files": [
        "dist"
    ],
    "bin": {
        "lsp": "./dist/cli.js"
    },
    "exports": {
        "./client": "./dist/client.js"
    },
    "scripts": {
        "build": "tsgo",
        "typecheck": "tsgo --noEmit -p tsconfig.test.json",
        "watch": "tsgo --build --watch",
        "test": "suites",
        "test:watch": "suites --watch"
    },
    "dependencies": {
        "@intentic/base": "workspace:*",
        "tslib": "catalog:",
        "@typescript/native-preview": "catalog:"
    },
    "devDependencies": {
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@types/bun": "catalog:",
        "@types/node": "catalog:"
    }
}
