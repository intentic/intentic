/* Type-checks this package's TESTS along with its source. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "bun", "@intentic/testing/globals"],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "tsBuildInfoFile": "./.cache/tsbuildinfo-typecheck"
    },
    "include": ["./src/**/*"],
    "exclude": ["./src/__fixtures__/**"]
}
