{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge.txt\""
                    },
                    {
                        "type": "command",
                        "command": "command -v iq >/dev/null 2>&1 && (iq sessions ingest >/dev/null 2>&1 &); exit 0"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "command -v iq >/dev/null 2>&1 && iq sessions match --hook 2>/dev/null; exit 0",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
