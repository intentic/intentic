{
    "repo": "intentic",
    "scope": { "notGlobs": ["_search/iq-bench/**"] },
    "cases": [
        {
            "id": "budget-enforcement",
            "verb": "q",
            "query": "where is the output token budget estimated and enforced when rendering search results?",
            "expected": [{ "file": "_search/iq-engine/src/render/budget.ts" }, { "file": "_search/iq-engine/src/render/text.ts" }],
            "notes": "estimateTokens lives in budget.ts; renderText spends the budget."
        },
        {
            "id": "feature-toggles",
            "verb": "q",
            "query": "how are retrieval pipeline stages toggled on and off for benchmarking?",
            "expected": [{ "file": "_search/iq-engine/src/features.ts" }]
        },
        {
            "id": "secrets-floor",
            "verb": "q",
            "query": "where is the secrets floor enforced so ignored files stay unreachable?",
            "expected": [{ "file": "_search/iq-engine/src/workspace/floor.ts" }]
        },
        {
            "id": "rrf-fusion",
            "verb": "q",
            "query": "how are results from multiple engines fused with reciprocal rank fusion?",
            "expected": [{ "file": "_search/iq-engine/src/plan/fuse.ts", "line": 34, "tolerance": 30 }]
        },
        {
            "id": "reranker-prune",
            "verb": "q",
            "query": "how does the cross-encoder reranker prune irrelevant candidates?",
            "expected": [{ "file": "_search/iq-engine/src/embed/reranker.ts" }]
