{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Intentic",
    "version": "0.0.0",
    "identifier": "dev.intentic.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:47146",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "rpm", "appimage", "nsis"],
        "createUpdaterArtifacts": true,
        "category": "DeveloperTool",
        "shortDescription": "Intentic — sandboxed AI workspaces",
        "longDescription": "Run your intentic sandbox on this computer or connect to a remote one — environment checks, Docker/WSL provisioning, and lifecycle management included.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "linux": {
            "deb": {
                "depends": []
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://gitlab.com/radarsu/intentic/-/releases/permalink/latest/downloads/desktop/latest.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRjUyN0VFM0JERDFFMjQKUldRa0h0MDc3aWYxUHdFNWRXNjU5cnhNZzZ6ZjZqc0U1QW96SlArbmVKMkNsVkdCK1dBQjJKb0cK"
        },
        "deep-link": {
            "desktop": {
                "schemes": ["intentic"]
            }
        }
    }
}
