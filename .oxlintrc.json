{
    // THE LANDABLE STANDARD. Everything in this file is green on main and `pnpm lint` gates it.
    //
    // There is a second, stricter config next door — .oxlintrc.agent.json — which extends this one
    // and is applied ONLY to files an agent has just written (see .claude/hooks/oxlint-edit.mjs). That split is
    // deliberate: a standard the repo cannot currently meet is a standard agents learn to disable, so the rules
    // that still have a legacy backlog live on the authoring side of the line and ratchet inward from there,
    // instead of sitting here red.
    //
    // Rules are ENUMERATED rather than pulled in by category. Oxlint's categories are buckets of available
    // rules, not curated presets (there is no `recommended` preset yet — oxc-project/oxc#20758), and the wide
    // ones are internally contradictory: `restriction` alone carries no-async-await, no-optional-chaining and
    // no-rest-spread-properties, which fight require-await, prefer-optional-chain and half of this codebase.
    // Enumerating also pins the rule set across oxlint upgrades, so a bump cannot silently change what an agent
    // is being told to do mid-task.
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    // `jest` is here for ONE rule oxlint ships only in that namespace — no-restricted-matchers, the single
    // configurable lever over which assertions are allowed (see the test-assertion block below). Oxlint's
    // vitest plugin is largely the jest plugin under another name, so enabling both DOUBLE-REPORTS every rule
    // that exists in each: measured, 288 + 127 valid-expect, 88 + 88 require-to-throw-message, 33 + 33
    // no-conditional-expect. Every jest twin of a vitest rule this file already decided about is therefore
    // switched off next to that decision, and the vitest copy stays the one that speaks.
    "plugins": ["typescript", "unicorn", "oxc", "import", "vue", "promise", "node", "vitest", "jest"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error"
    },
    "rules": {
        // ── Repo-specific ────────────────────────────────────────────────────────────────────────────────
        "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
        "import/no-unassigned-import": [
            "error",
            {
                "allow": ["**/*.css", "**/composables/sandbox/sandboxScope", "**/composables/sandbox/sandboxScreen", "**/extension-host/hostModules"]
            }
        ],
        // `_` is this repo's throwaway binding, not a private-member sigil. `_all`/`_count`/`_sum` are Prisma's
        // aggregate result keys and `_zod` is zod's internals marker — names libraries chose, which no amount of
        // linting here will change.
        "no-underscore-dangle": [
            "error",
            {
                "allow": [
                    "_",
                    "_all",
                    "_count",
                    "_sum",
                    "_zod",
                    "__API_URL__",
                    "__POSTHOG_KEY__",
                    "__intentic",
                    "__INTENTIC_DESKTOP__",
                    "__termFrames",
                    "_core",
                    "_renderService"
                ]
            }
        ],
        // `fix.imports` lets --fix delete an unused import outright, which is the whole point of the edit hook:
        // the agent never sees a diagnostic for something a tool could just remove. Variable removal stays off —
        // deleting a binding can delete an initialiser's side effect with it.
        "no-unused-vars": ["error", { "args": "none", "varsIgnorePattern": "^_", "fix": { "imports": "safe-fix", "variables": "off" } }],

        // ── Turned off on purpose ────────────────────────────────────────────────────────────────────────
        // Each of these fires in the hundreds or thousands here and is wrong, not merely unmet. Left on, they
        // would be the noise an agent learns to reach past — and the disable comment it writes to get past
        // them is worth less than the rule was.
        //
        // Sequential awaits in a loop are the intent throughout the daemon (ordered writes, rate-limited
        // fetches), not an oversight. 953 hits.
        "no-await-in-loop": "off",
        // Miscounts the arguments of the call being asserted on: `expect(await fn(a, b, c))` reads as three
        // arguments to expect(). 109 hits, all false. Upstream rule bug, not a codebase problem.
        "vitest/valid-expect": "off",
        // Wants a type parameter on every vi.fn()/vi.mock(). 977 hits of pure ceremony.
        "vitest/require-mock-type-parameters": "off",
        // Wants a message argument on every .toThrow(). 89 hits; the thrown type is usually the assertion.
        "vitest/require-to-throw-message": "off",
        // The repo wraps genuine callback APIs (node-pty, watchers, Playwright events) — 189 hits, none of
        // which have an await to prefer.
        "promise/prefer-await-to-callbacks": "off",
        // Fires on the void-returning `.then()` that is idiomatic here. 72 hits.
        "promise/always-return": "off",
        // Factory closures and per-call helpers are deliberate. 185 hits.
        "unicorn/consistent-function-scoping": "off",
        // `"\x1f"` is a control character this repo handles on purpose — _tools/checks/control-chars.mjs
        // exists to police exactly these bytes. Rewriting them to the literal byte is churn against that check.
        "unicorn/no-hex-escape": "off",
        // The next three are cosmetic, and their autofixes were measured across this repo before being
        // rejected: together they rewrote ~400 files, and catch-error-name's renames alone walked no-shadow
        // from 17 hits to 104 by colliding with outer `error` bindings. A rule that costs a 400-file diff and
        // introduces violations of another rule is not paying for itself.
        "unicorn/catch-error-name": "off", // `catch (e)` → `catch (error)`, 170 renames
        "unicorn/prefer-string-replace-all": "off", // `.replace(/x/g)` → `.replaceAll`, 230 sites
        "promise/param-names": "off", // Promise executor arg naming, 74 sites
        // OFF BECAUSE ITS AUTOFIX IS NOT VALUE-SAFE. appendChild() returns the node it appended; append()
        // returns undefined. Oxlint ships the rewrite as a plain --fix, and it silently broke two call sites
        // here that used the return value — caught by tsc, not by the linter. The edit hook applies --fix
        // without showing the agent what it changed, so a fix that can alter a value is the one kind this
        // setup must not carry.
        "unicorn/prefer-dom-node-append": "off",

        // ── Off on the merits, after measuring what they would actually change ─────────────────────────
        // Every one of these was sampled at its own call sites before being switched off. The test each had
        // to pass is not "is the rule reasonable in the abstract" but "is the code it flags here worse than
        // the code it would produce".
        //
        // Fires on EVERY .sort(), including `[...byKey.values()].sort(...)` where the array was spread into
        // existence one expression earlier and is nobody else's. Its premise — that sort mutates a shared
        // array — is false there, and `toSorted()` just allocates a second array to throw the first away.
        "unicorn/no-array-sort": "off", // 16
        // Path-insensitive. It counts the two arms of `port === 0 ? reject(...) : resolve(...)` as two
        // resolutions of the same promise, which is a ternary: exactly one arm runs. Every site here is an
        // error path plus a success path, and settling twice is a no-op by spec anyway.
        "promise/no-multiple-resolved": "off", // 25
        // Breaks table-driven tests, which is most of the suites here: iterate a table, branch on the shape
        // of each row, assert the invariant that row is supposed to have. Satisfying it means duplicating
        // the loop per branch or flattening the table into expected-value pairs — strictly worse tests.
        "vitest/no-conditional-expect": "off", // 33
        // Aimed at `[...acc, x]` accumulation, which really is quadratic. It does not fire on that here: it
        // fires on `automations.map((a) => ({ ...a, enabled: false }))` and `[...someMap.values()]` — an
        // immutable update and an iterator being materialised. Its own help then suggests `Object.assign` or
        // "direct property assignment", i.e. mutate the input. The rule's remedy is the worse pattern.
        "oxc/no-map-spread": "off", // 15
        // The callback-bridging pair, off for the same reason prefer-await-to-callbacks above is: the sites
        // are `handleEntry(...).then(() => next(), fail)` inside a tar-stream `on("entry")` handler, which is
        // the only correct way to drive a callback API from a promise. There is no await to prefer.
        "promise/no-callback-in-promise": "off", // 8
        "promise/no-promise-in-callback": "off", // 3

        // Fires on the code that DEFENDS against the thing it names. All three sites are the guard and its
        // tests: `href.startsWith("javascript:")` in the markdown sanitiser, and two tests asserting that
        // `javascript:alert(1)` is rejected. A rule that cannot be satisfied without deleting the defence.
        "no-script-url": "off", // 3
        // Same shape: both sites are `/[\u0000-\u001f\u007f]/u.test(...)` inside _tools/registry-scan, whose
        // job IS to find control characters in registry entries.
        "no-control-regex": "off", // 2
        // Two of its four sites are long prose wrapped across lines, and one is a deliberate split —
        // `"intentic:" + "runtime"` exists so the literal directive never appears in a file that asserts packs
        // do not carry it. Joining them is what the rule wants and is worse in every case here.
        "no-useless-concat": "off", // 4
        // Every site is `JSON.parse(JSON.stringify(x))` used ON PURPOSE for its JSON semantics, not as a deep
        // copy: one is literally named `wire()` and models what survives the wire. structuredClone preserves
        // Dates, undefined and Maps — exactly the things these call sites are trying to drop.
        "unicorn/prefer-structured-clone": "off", // 3

        // "Title must be a string" — fired on `test(name, ...)` and `describe.skipIf(...)(tier.title, ...)`,
        // i.e. on every parameterised suite in the repo. Requiring a literal outlaws table-driven tests, which
        // is how most of these suites are written.
        "vitest/valid-title": "off", // 8
        // 100% false positives, and both in files that are not tests: it pattern-matches the word "it" followed
        // by a parenthesis in ordinary English. `// it (transcript-search.ts), a mid-turn message ...` is prose.
        "vitest/no-commented-out-tests": "off", // 2
        // Aimed at `.then(() => p.then(...))`. What it actually flags here is `await rename(p).catch(() => undefined)`
        // — one promise, one handler, the concise form of "try this and ignore failure". The remedy is a
        // try/catch block around a single call, which is longer and says less.
        "promise/no-nesting": "off", // 9

        // ── Debug residue and agent leftovers ────────────────────────────────────────────────────────────
        // console.warn/error are real product behaviour; console.log is something left behind.
        "no-warning-comments": ["error", { "terms": ["@nocommit", "FIXME"] }],
        // THE LOAD-BEARING ONE. Without it the cheapest way for an agent to make the linter quiet is a blanket
        // `oxlint-disable`, and every other rule here becomes advisory.
        "unicorn/no-abusive-eslint-disable": "error",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/no-identical-title": "error",

        // ── What an assertion is allowed to be ───────────────────────────────────────────────────────────
        // The only part of test QUALITY a linter can actually decide, and it is worth being precise about why
        // it is this small.
        //
        // Brittleness is not visible in an AST. A 22-key `toEqual` is the correct assertion when the shape IS
        // the contract (secret-inventory.integration.test.ts) and an over-specification when it is not, and
        // the two are byte-identical. Every rule that promises otherwise was measured against this repo and
        // sampled at its own call sites: `prefer-strict-equal` (5,701 hits) makes tests MORE brittle by
        // pinning undefined keys and class identity; `prefer-called-with` (48) couples an assertion to exact
        // arguments; `prefer-expect-assertions` (10,710) is ceremony. None of them is on, and the reason is
        // not the backlog — it is that satisfying them produces worse tests.
        //
        // What IS decidable is the opposite: an assertion that cannot fail. `toBeDefined` passes for `0`,
        // `""`, `false` and every object ever constructed; it is what a model writes when it does not know
        // what the value should be. That is a shape, and a shape is something a linter can see.
        //
        /* THE BACKLOG WAS 328 AND IS NOW ZERO, so this is an ordinary rule rather than an authoring-side one.
         * It started in .oxlintrc.agent.json (toBeDefined 254, toHaveBeenCalled 46, toBeTruthy 18, toBeFalsy 5,
         * resolves.not.toThrow 1) and moved here once every site had been given the assertion it should have
         * had. What the sweep actually produced, in case the next one is tempted to do it by hand:
         *
         *   - Most `toBeDefined` sites were a NARROWING GUARD with the real assertion on the next line. Those
         *     collapse into one `toMatchObject`, which is shorter and cannot pass on undefined either.
         *   - The rest were rewritten from the TYPE: strip `undefined` off what the checker already knows and
         *     assert the arm that is left (`expect.any(String)`, `Array`, `Function`, …). "Not undefined" and
         *     "is a string" fail on exactly the same value, and the second one also fails on the wrong shape.
         *   - `expect(bag[key]).toBeDefined()` became `expect(Object.keys(bag)).toContain(key)`, which prints
         *     the keys that ARE there instead of the word "undefined".
         *
         * Three of them found real bugs, which is the argument for the rule in one line: a `features` set that
         * arrives as an array and would have satisfied any presence check as `{}`; a rank test that computed an
         * unused baseline and so never made the comparison its name promised; and a window.open spy that was
         * never cleared between tests, so half a suite's counts depended on file order. */
        "jest/no-restricted-matchers": [
            "error",
            {
                "toMatchSnapshot": "A snapshot records what the code DOES; a test is supposed to say what it must do. Assert the fields the behaviour is about — this repo has no snapshot tests and that is deliberate.",
                "toMatchInlineSnapshot": "A snapshot records what the code DOES; a test is supposed to say what it must do. Assert the fields the behaviour is about — this repo has no snapshot tests and that is deliberate.",
                "toMatchFileSnapshot": "A snapshot records what the code DOES; a test is supposed to say what it must do. Assert the fields the behaviour is about — this repo has no snapshot tests and that is deliberate.",
                "toBeDefined": "Says only 'not undefined'. The type already knows what it is instead — assert that: expect.any(String), toMatchObject({…}), or Object.keys(bag) toContain the key.",
                "toBeTruthy": "Passes for any non-empty string, any object, any non-zero number. Assert the value, not its truthiness.",
                "toBeFalsy": "Passes for 0, \"\", null, undefined and NaN alike, which are rarely interchangeable. Assert the one you mean.",
                "toHaveBeenCalled": "Says a call happened, not that it was the right one, and not that it happened once. Use toHaveBeenCalledWith or toHaveBeenCalledTimes.",
                "resolves.not.toThrow": "Only says the promise settled. Assert the value it resolved to, or the effect it had."
            }
        ],
        // Belt and braces on the same zero: if a snapshot ever does land, it cannot be a 200-line one that
        // nobody reads and everybody re-records. maxSize is lines.
        "jest/no-large-snapshots": ["error", { "maxSize": 12 }],
        // ── The jest twins, off ──────────────────────────────────────────────────────────────────────────
        // Each of these is the same rule as the `vitest/` entry decided elsewhere in this file, in the other
        // namespace. Leaving them on reports every finding twice and puts two identical diagnostics on one
        // line, which is how a fix loop starts oscillating. The vitest copy wins in every pair, because that
        // is the framework this repo actually runs.
        "jest/valid-expect": "off", // twin of vitest/valid-expect, off above — 288
        "jest/require-to-throw-message": "off", // twin, off above — 88
        "jest/no-conditional-expect": "off", // twin, off above — 33
        "jest/valid-title": "off", // twin, off above — 8
        "jest/no-commented-out-tests": "off", // twin, off above — 2
        "jest/expect-expect": "off", // twin of the configured vitest/expect-expect below — 8
        "jest/no-focused-tests": "off", // twin of the enabled vitest rule above
        "jest/no-disabled-tests": "off", // twin
        "jest/no-identical-title": "off", // twin
        "jest/no-standalone-expect": "off", // twin

        // ── Type honesty (no checker needed) ─────────────────────────────────────────────────────────────
        "typescript/no-empty-object-type": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-misused-new": "error",
        "typescript/no-require-imports": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-confusing-non-null-assertion": "error",
        "typescript/no-non-null-asserted-nullish-coalescing": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unnecessary-parameter-property-assignment": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-literal-enum-member": "error",
        "typescript/no-useless-empty-export": "error",
        "typescript/no-namespace": "error",
        "typescript/ban-ts-comment": "error",

        // ── Core correctness and intent ──────────────────────────────────────────────────────────────────
        "eqeqeq": ["error", "always", { "null": "ignore" }],
        // NESTING, which is the part of "complex" a reader actually feels. Cyclomatic complexity counts every
        // branch the same, so a flat thirty-case dispatch scores worse than five levels of nested ifs; depth is
        // the thing that makes a function hard to hold in your head, and it is cheap to keep low.
        //
        // 41 sites had to be flattened to turn this on, by early-return guards where the block was the last
        // thing in its loop and by extracting named helpers where it was not. Worth knowing before you raise
        // it: the two metrics PULL AGAINST EACH OTHER. Merging `if (a) { if (b) {` into `if (a && b) {` removes
        // a level and ADDS a branch point, so flattening by condition-merging makes cyclomatic complexity
        // worse. Extraction is the move that improves both, and it is what most of those 41 became.
        "max-depth": ["error", 4],
        "max-nested-callbacks": ["error", 4],
        // Brace-less `if` is where a later single-line edit silently lands outside the branch — a failure mode
        // that costs an agent nothing to avoid and a reviewer real time to spot.
        "curly": "error",
        "array-callback-return": "error",
        "no-throw-literal": "error",
        "preserve-caught-error": "error",
        "no-var": "error",
        "object-shorthand": "error",
        "no-unused-private-class-members": "error",
        "no-constant-binary-expression": "error",
        "no-new-wrappers": "error",
        "no-implied-eval": "error",
        "no-extra-bind": "error",
        "no-useless-rename": "error",
        "no-object-constructor": "error",
        "no-array-constructor": "error",
        "no-multi-str": "error",
        "no-return-assign": "error",
        "no-self-compare": "error",
        "no-unneeded-ternary": "error",
        "default-case-last": "error",
        "grouped-accessor-pairs": "error",
        "symbol-description": "error",
        "operator-assignment": "error",
        "prefer-object-has-own": "error",
        "prefer-arrow-callback": ["error", { "allowNamedFunctions": true }],
        "prefer-exponentiation-operator": "error",
        "prefer-numeric-literals": "error",
        "prefer-promise-reject-errors": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "prefer-template": "error",
        "radix": "error",

        // ── Promises ─────────────────────────────────────────────────────────────────────────────────────
        "promise/no-return-wrap": "error",
        "promise/no-new-statics": "error",
        "promise/valid-params": "error",
        "promise/no-return-in-finally": "error",
        "promise/spec-only": "error",

        // ── Modern built-ins ─────────────────────────────────────────────────────────────────────────────
        "unicorn/throw-new-error": "error",
        "unicorn/new-for-builtins": "error",
        "unicorn/no-instanceof-builtins": "error",
        "unicorn/no-invalid-fetch-options": "error",
        // Owns `typeof x === "undefined"` and autofixes it. Kept ahead of anti-slop/no-runtime-typeof, which
        // is configured not to re-flag the same narrowing (see agent.oxlintrc.json).
        "unicorn/no-typeof-undefined": "error",
        "unicorn/no-useless-promise-resolve-reject": "error",
        "unicorn/no-magic-array-flat-depth": "error",
        "unicorn/no-unnecessary-slice-end": "error",
        "unicorn/no-await-in-promise-methods": "error",
        "unicorn/no-single-promise-in-promise-methods": "error",
        "unicorn/no-console-spaces": "error",
        "unicorn/consistent-empty-array-spread": "error",
        "unicorn/require-array-join-separator": "error",
        "unicorn/text-encoding-identifier-case": "error",
        "unicorn/prefer-node-protocol": "error",
        "unicorn/prefer-string-slice": "error",
        "unicorn/prefer-string-starts-ends-with": "error",
        "unicorn/prefer-array-flat-map": "error",
        "unicorn/prefer-array-some": "error",
        "unicorn/prefer-at": "error",
        "unicorn/prefer-set-size": "error",
        "unicorn/prefer-number-properties": "error",
        "unicorn/prefer-optional-catch-binding": "error",
        "unicorn/prefer-import-meta-properties": "error",

        // ── Imports ──────────────────────────────────────────────────────────────────────────────────────
        "import/no-duplicates": "error",
        "import/no-self-import": "error",
        "import/no-empty-named-blocks": "error",
        "import/no-mutable-exports": "error",
        "import/no-named-default": "error",
        "import/no-absolute-path": "error",
        "import/no-webpack-loader-syntax": "error",
        "node/no-exports-assign": "error",
        "node/no-new-require": "error",

        // ── Type-aware ───────────────────────────────────────────────────────────────────────────────────
        // These need a checker and only run under `pnpm lint:types` (oxlint --type-aware, backed by
        // oxlint-tsgolint). Plain `pnpm lint` ignores them at no cost, so they are declared here — one place
        // where the standard lives — rather than in a separate file.
        //
        // This is the half of the linter that catches what a language model actually gets wrong: a dropped
        // await, an `any` crossing a boundary, a cast the checker cannot justify, a union that grew a member
        // while a switch did not. None of it is visible without types.
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/await-thenable": "error",
        "typescript/require-await": "error",
        "typescript/return-await": "error",
        "typescript/no-unnecessary-condition": "error",
        // Directly counters model staleness: an agent writes against the API it remembers from training, and
        // this is what says the memory is out of date.
        "typescript/no-deprecated": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-confusing-void-expression": "error",
        "typescript/no-misused-spread": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-meaningless-void-operator": "error",
        "typescript/no-mixed-enums": "error",
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/no-unnecessary-type-parameters": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-useless-default-assignment": "error",
        "typescript/non-nullable-type-assertion-style": "error",
        "typescript/related-getter-setter-pairs": "error",
        "typescript/require-array-sort-compare": "error",
        "typescript/unbound-method": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-optional-chain": "error",
        "typescript/prefer-find": "error",
        "typescript/prefer-includes": "error",
        "typescript/prefer-readonly": "error",
        "typescript/prefer-reduce-type-parameter": "error",
        "typescript/prefer-return-this-type": "error",

        // ── Type-aware rules deliberately NOT enabled ────────────────────────────────────────────────────
        // Duplicates of cheaper rules above. Two diagnostics on one line with two different remedies is how a
        // fix loop starts oscillating, so in each pair the always-on rule wins and the type-aware twin is off.
        "typescript/only-throw-error": "off", // duplicate of no-throw-literal
        "typescript/prefer-promise-reject-errors": "off", // duplicate of the eslint rule
        "typescript/no-implied-eval": "off", // duplicate of the eslint rule
        "typescript/prefer-string-starts-ends-with": "off", // duplicate of the unicorn rule
        // Type assertions are owned by anti-slop in agent.oxlintrc.json, which offers a way through (justify
        // it with a SAFETY comment) instead of a demand that cannot always be met.
        "typescript/no-unsafe-type-assertion": "off",
        // Noise without a matching gain: strict-boolean-expressions rejects every truthiness check, and
        // prefer-readonly-parameter-types wants deep-readonly signatures across the whole codebase.
        "typescript/strict-boolean-expressions": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        // ── Was the backlog, now simply the standard ──────────────────────────────────────────────────
        // These 21 rules were listed here as violated-by-main, with counts, and enforced only on files an
        // agent touched. The count reached zero, so they are ordinary rules now and the second config that
        // carried them is gone. Anything added here in future that main does not yet satisfy belongs in the
        // same shape: off, with its count, and a note saying who enforces it in the meantime.
        // Kept for the half that pays: `import { type X }` → `import type { X }`, which it autofixes. Its
        // `disallowTypeAnnotations` half is off — that bans `typeof import("node:child_process")`, which is
        // vitest's own documented idiom for typing `importOriginal<>()` inside a vi.mock factory, and has no
        // top-level-import equivalent because the whole point is to name a module's type without importing it.
        "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
        "no-console": ["error", { "allow": ["warn", "error"] }],
        "no-shadow": "error",
        "vitest/expect-expect": [
            "error",
            {
                // The default list is just `expect`, so a suite that asserts through a shared helper reads as
                // assertion-free. `expectOrpcCode(promise, code)` is how every _platform/api route test states
                // its expectation, and eight suites were being reported for using it.
                "assertFunctionNames": ["expect", "expectTypeOf", "assert", "expectOrpcCode"]
            }
        ],
        "no-sequences": "error",
        "prefer-const": ["error", { "destructuring": "all" }],
        "import/first": "error",
        "unicorn/prefer-native-coercion-functions": "error",
        "no-unsafe-optional-chaining": "error",
        "prefer-regex-literals": "error",
        "vitest/no-standalone-expect": "error",
        "typescript/no-explicit-any": "error",
        "unicorn/error-message": "error",
        "no-new-func": "error",
        "unicorn/no-useless-spread": "error",
        "no-unmodified-loop-condition": "error",
        "require-yield": "error",
        "unicorn/no-useless-length-check": "error",
        "import/no-named-as-default": "error",
        "unicorn/prefer-array-index-of": "error",
        "no-unassigned-vars": "error",
        "typescript/no-import-type-side-effects": "error"
    },
    "env": {
        "node": true,
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": [
        "**/node_modules",
        "**/.cache",
        "**/.turbo",
        "**/.astro",
        "**/dist",
        "**/dist-*",
        "**/deploy",
        "**/generated",
        "**/out-tsc",
        "**/tmp",
        "**/assets/js/env.js",
        "_editor/web/public/ext-shims",
        "_sandbox/sandbox/operator-templates",
        // Vendored upstream source — kept byte-identical so it stays diffable against dmmulroy/anti-slop.
        "_tools/oxlint/anti-slop"
    ],
    "overrides": [
        {
            // Tooling whose output IS stdout: CLIs, build scripts, benchmarks, e2e harnesses. console.log is
            // the product here, not a leftover.
            "files": [
                "**/*.mjs",
                "**/scripts/**",
                "**/*.config.*",
                "_tools/scripts/**",
                "_tools/checks/**",
                "_tools/e2e/**",
                "_tools/localhost-https/**",
                "_tools/dev-public/**",
                "_search/iq-bench/**",
                "_sandbox/gate/**",
                "_sandbox/gate-action/**",
                "_deploy/cli/**",
                "_deploy/engine/**",
                "_site/demo/**",
                "_tools/fake-upstream/**",
                "_platform/example-provider/**",
                "_sandbox/connector-runtime/**",
                "_sandbox/acp-bridge/**",
                "_sandbox/sandbox/src/extensions/backend/**",
                "_editor/web/src/composables/perf.ts",
                "_editor/web/src/composables/chat/focusTrace.ts"
            ],
            "rules": {
                "no-console": "off"
            }
        },
        {
            "files": ["**/*.test.ts", "**/*.integration.test.ts", "**/*.spec.ts"],
            "rules": {
                // vi.mock() is hoisted and has to be declared above the imports it intercepts, which puts a
                // statement between the import list and leaves this rule with nothing useful to say.
                "import/first": "off",
                // A test may hold a deliberately wrong shape to assert the code rejects it.
                "typescript/no-explicit-any": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-return": "off",
                "typescript/unbound-method": "off",
                // A test may construct the degenerate input on purpose: `new Error("")` is the argument under
                // test, and `new Function(src)` is being used as a parser to assert generated code is valid.
                "unicorn/error-message": "off",
                "no-new-func": "off"
            }
        },
        {
            "files": ["_extensions/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": [
                                    "@intentic/*",
                                    "!@intentic/connector-runtime",
                                    "!@intentic/extension-api",
                                    "!@intentic/extension-manifest",
                                    "!@intentic/extension-ui",
                                    "!@intentic/sandbox-contract"
                                ],
                                "message": "Extensions may depend only on @intentic/extension-api, @intentic/extension-manifest, @intentic/extension-ui, @intentic/connector-runtime, and @intentic/sandbox-contract — the extension SDK (browser and gateway halves), what it declares, and the shared wire contract. Reaching any other @intentic/* package couples the extension to app/engine internals. See _extensions/README.md."
                            },
                            {
                                "group": [
                                    "@intentic-app/*",
                                    "**/_devices/**",
                                    "**/_deploy/**",
                                    "**/_editor/**",
                                    "**/_platform/**",
                                    "**/_sandbox/**",
                                    "**/_search/**",
                                    "**/_site/**"
                                ],
                                "message": "Extensions must not reach the app plane (@intentic-app/*) or other packages' internals by path. Use @intentic/extension-ui for UI and @intentic/sandbox-contract for wire types. See _extensions/README.md."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
