{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import", "vue"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error"
    },
    "rules": {
        "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/composables/sandbox/sandboxScope", "**/extension-host/hostModules"] }],
        "no-underscore-dangle": ["error", { "allow": ["__API_URL__", "__intentic"] }],
        "no-await-in-loop": "off"
    },
    "env": {
        "node": true,
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": [
        "**/node_modules",
        "**/.cache",
        "**/.turbo",
        "**/.astro",
        "**/dist",
        "**/dist-*",
        "**/deploy",
        "**/generated",
        "**/out-tsc",
        "**/tmp",
        "**/assets/js/env.js",
        "_apps/web/public/ext-shims",
        "_apps/sandbox/operator-templates"
    ],
    "overrides": [
        {
            "files": ["**/*.vue"],
            "rules": {
                "no-use-before-define": "error"
            }
        },
        {
            "files": ["**/*.test.ts"],
            "rules": {
                "unicorn/consistent-function-scoping": "off"
            }
        },
        {
            "files": ["_extensions/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["@intentic/*", "!@intentic/extension-api", "!@intentic/extension-ui", "!@intentic/sandbox-contract"],
                                "message": "Extensions may depend only on @intentic/extension-api, @intentic/extension-ui, and @intentic/sandbox-contract — the extension SDK + the shared wire contract. Reaching any other @intentic/* package couples the extension to app/engine internals. See _extensions/README.md."
                            },
                            {
                                "group": ["@intentic-app/*", "**/_apps/**", "**/_libs/**"],
                                "message": "Extensions must not reach the app plane (@intentic-app/*) or app/lib internals. Use @intentic/extension-ui for UI and @intentic/sandbox-contract for wire types. See _extensions/README.md."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
