# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5440/app

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-random-string

# Encryption-at-rest key for the platform's persisted secrets (Google OAuth tokens, sandbox connect
# tokens, setup payloads) — generate with: openssl rand -base64 32. Unset = plaintext (dev only).
SECRETS_KEY=

# Browser-facing origin of the API. The SPA calls it directly (no dev-server proxy) — cross-origin but
# CORS-allowed, and :47145/:6480 are same-site so the session cookie still rides. Also the base for
# Better Auth and the git OAuth redirect URIs. Dev runs over https (see API_HTTPS_* below) because
# Google's FedCM One Tap won't run on http://localhost: https://localhost:6480.
API_URL=https://localhost:6480

# Where the Vue web app is served — the SPA origin (CORS allow-origin + Better Auth trusted origin).
WEB_ORIGIN=https://localhost:47145

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: https://localhost:6480/api/auth/callback/google
# Authorized JavaScript origin to register: https://localhost:47145
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Authorization callback URL to register: http://localhost:6480/git/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Forgejo OAuth app on your instance (Settings → Applications).
# Redirect URI to register: http://localhost:6480/git/forgejo/oauth/callback
FORGEJO_BASE_URL=
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=

# Stripe — billing for the platform's OWN SaaS (the "Upgrade" flow). Distinct from the sandbox-side
# i.have.stripe capability, whose STRIPE_API_KEY lives in the user's sandbox .env — these are the platform's.
# Create a Product+Price in the Stripe dashboard and put its price id below. For local webhooks, run:
#   stripe listen --forward-to http://localhost:6480/api/auth/stripe/webhook
# and copy the printed whsec_… into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Transactional email (Resend) for sandbox invite links — the only mail the platform sends. Create an API key
# at https://resend.com and verify your sending domain; EMAIL_FROM must be an address on that domain.
# Unset → invites still work but the link is logged server-side instead of emailed (dev only).
EMAIL_API_KEY=""
EMAIL_FROM=intentic <invites@example.com>

# Emails that always get the "pro" plan without a Stripe subscription (comp'd/test accounts).
# Comma-separated, case-insensitive. Leave empty in normal setups.
PERMANENT_PREMIUM_EMAILS=

# Intentic-provided Cloudflare — the zero-config sandbox path: with a token + zone set, the platform provisions
# each sandbox's tunnel + DNS under its OWN zone and hands the sandbox a narrow per-tunnel connector token (never
# this API token). Unset (either) → setup offers only bring-your-own-Cloudflare. Token needs Zone:Read + DNS:Edit
# on the zone and Account → Cloudflare Tunnel:Edit.
INTENTIC_CLOUDFLARE_API_TOKEN=
INTENTIC_CLOUDFLARE_ZONE=intentic.dev
# Pre-provision this many sandbox subdomains ahead of demand so /setup never waits on Cloudflare (tunnels are
# created in the background and claimed on sandbox creation). 0 = disabled (provision lazily during setup).
INTENTIC_CLOUDFLARE_POOL_SIZE=1

# API server port
API_PORT=6480

# Dev TLS for the API — paths to the committed @intentic-app/localhost-https cert/key (its CA is trusted locally),
# so the API serves https to match the https SPA. Leave empty in prod (TLS terminated by the proxy).
API_HTTPS_KEY=./node_modules/@intentic-app/localhost-https/localhost.key
API_HTTPS_CERT=./node_modules/@intentic-app/localhost-https/localhost.crt

# WSS gateway the sandbox runner dials back on — handed to the user in the setup connect command.
# Optional: defaults to WEB_ORIGIN as ws/wss + /runner/gateway (a localhost origin → host.docker.internal:API_PORT).
# Set only to override (e.g. a separate gateway host).
RUNNER_GATEWAY_URL=
