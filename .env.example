# Local dev env for the platform (api + web + site). Copy to .env and fill in Google credentials to test
# sign-in; the rest degrade gracefully (the api logs a warning and disables that feature when unset). The api
# reads this file (root .env); web/site bake their dev config into src (no env needed). Bring the platform up
# with `pnpm db:up && pnpm dev`.

# ── Platform (api) ──────────────────────────────────────────────────────────────────────────────────────────

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5440/app

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-random-string

# Encryption-at-rest key for the platform's persisted secrets (Google OAuth tokens, sandbox connect
# tokens, setup payloads) — generate with: openssl rand -base64 32. Unset = plaintext (dev only).
SECRETS_KEY=

# Browser-facing origin of the API. The SPA calls it directly (no dev-server proxy) — cross-origin but
# CORS-allowed, and :47145/:6480 are same-site so the session cookie still rides. Also the base for
# Better Auth and the git OAuth redirect URIs. Dev runs over https (see API_HTTPS_* below) because
# Google's FedCM One Tap won't run on http://localhost: https://localhost:6480.
API_URL=https://localhost:6480

# Where the Vue web app is served — the SPA origin (CORS allow-origin + Better Auth trusted origin).
WEB_ORIGIN=https://localhost:47145

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: https://localhost:6480/api/auth/callback/google
# Authorized JavaScript origin to register: https://localhost:47145
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails whose signed-in session may call the /admin surface (the platform-admin panel).
# Deployment config on purpose: no API endpoint can mint an admin, adding one is a redeploy. Empty (the
# default) disables the admin surface outright — every /admin route answers FORBIDDEN for everybody.
# ADMIN_MUTATIONS gates the surface's few writes (suspend a listing, retry a payout, stop a machine, GDPR
# erasure) separately: leave it false until the panel's bytes are a pinned install, per its README.
ADMIN_EMAILS=
ADMIN_MUTATIONS=false

# Transactional email (Resend) for sandbox invite links — the only mail the platform sends. Create an API key
# at https://resend.com and verify your sending domain; EMAIL_FROM must be an address on that domain.
# Unset → invites still work but the link is logged server-side instead of emailed (dev only).
EMAIL_API_KEY=""
EMAIL_FROM=intentic <invites@example.com>

# Intentic's own Cloudflare zone — DNS AND NOTHING ELSE since reachability moved to the ingress below. What
# the token is still for: the `*.local.<zone>` record that answers 127.0.0.1 for the loopback shortcut, the
# short-lived TXT beside it while a loopback certificate is issued over DNS-01 (the daemon has no token for
# this zone, so the platform relays both), and the daily sweep that clears what earlier versions left here.
# It mints no tunnel and no per-sandbox record, so it costs the zone's record quota nothing. The wildcard that
# points the sandbox zone at the ingress is part of deploying the ingress, not something this token writes.
# Unset (either) → the loopback-certificate path is simply off; every sandbox is still reachable.
# Zone:Read + DNS:Edit on the zone, and nothing more: the sweep may call only /dns_records, and a token any
# wider is a token that can do more than this deployment ever asks for.
INTENTIC_CLOUDFLARE_API_TOKEN=
INTENTIC_CLOUDFLARE_ZONE=intentic.dev
# MAY THIS DEPLOYMENT DELETE RECORDS IN THAT ZONE? Leave unset anywhere but the deployment that owns it. The
# daily sweep decides what is an orphan by asking THIS deployment's database, and the zone is shared by every
# deployment holding the token above: an API run locally with production credentials in its env will sweep the
# production zone against an empty local database and take live sandboxes off the internet. Unset, the sweep
# still runs and still reports the zone's record count (the number that matters for the per-zone cap) and
# simply never deletes.
INTENTIC_CLOUDFLARE_REAP=
# Report what the sweep WOULD delete without deleting it, even where reaping is on. Run a new deployment's
# first sweep with this, read the candidates, then take it off.
INTENTIC_CLOUDFLARE_REAP_DRY_RUN=

# ---- Reachability (how every sandbox is reached) ------------------------------------------------------------
# The platform's own edge: `@intentic/ingress` (_platform/ingress), running on Fly behind ONE wildcard
# certificate. A sandbox on the user's own machine dials one outbound tunnel to it and proves which sandbox it
# is with a grant this platform signed; a hosted sandbox (below) dials nothing, the edge answers requests for
# its hostname with a Fly replay to its app. The ingress routes each request by parsing its Host, so there is
# no hub to operate, no account per sandbox and nothing to reconcile. Provisioning reachability is signing;
# revoking it is deleting the sandbox row. `INGRESS_SIGNING_KEY` is the switch: unset ⇒ setup offers only the
# attach lane (a sandbox you already run behind your own domain), which is also the right setting for a dev
# platform.

# The Ed25519 private key that signs reachability grants, PKCS#8 PEM — quote it so its newlines survive. The
# ingress holds only the public half. Generate with: openssl genpkey -algorithm ed25519
INGRESS_SIGNING_KEY=
# Where a sandbox dials its tunnel. Handed to every box as INGRESS_URL, beside the grant it gets as
# SANDBOX_GRANT (_sandbox/sandbox-contract/src/ingress-contract.ts pins both names).
INGRESS_URL=https://ingress.sbx.intentic.dev
# The zone the wildcard record serves — the suffix of every sandbox address (`sandbox-<id>.<zone>`).
INGRESS_ZONE=sbx.intentic.dev

# ---- Hosted sandboxes (optional, OFF by default) -----------------------------------------------------------
# "Sign in and you're in a sandbox": with a Fly token + org set, the platform CREATES each new user's machine on
# its own Fly account — no command, no paste — and keeps the way back in (wake on the next visit, stop, destroy
# on delete). That is the one lane where a platform breach reaches a machine, which ARCHITECTURE.md states in
# full; every other lane is unchanged. Blank (the default, and the right setting for a self-hosted platform) →
# the routes 404 and the editor never offers it.
#
# The token must be ORG-scoped (an app-scoped deploy token cannot create apps):
#   fly tokens create org --org <your-org> --name intentic-hosted --expiry 8760h
# Needs INGRESS_SIGNING_KEY above as well — a hosted machine is reached through the same edge, which answers
# requests for its hostname with a Fly replay to its app rather than carrying them down a tunnel, so Fly
# credentials alone leave the lane off. The ingress must run in THIS Fly org (a replay cannot cross one).
HOSTED_FLY_API_TOKEN=
HOSTED_FLY_ORG=
# Where the machines are created (Fly region codes), and the app-name prefix every hosted app is named under:
# `<prefix>-<sandbox id>`, pool-born or built to order, which is what the reaper recognizes ours by and what
# the edge replays a hostname to. Set the SAME value as HOSTED_APP_PREFIX on the ingress (its fly.toml
# runbook), or the edge replays nothing.
# HOSTED_REGION_EU takes callers from the EEA, the UK and Switzerland; everyone else lands in HOSTED_REGION.
# On intentic.dev that split is a published privacy commitment, not a latency preference — see /privacy.
HOSTED_REGION=iad
HOSTED_REGION_EU=arn
HOSTED_APP_PREFIX=intentic-sbx
# The image a hosted machine boots — the same public sandbox image every other lane runs.
HOSTED_IMAGE=ghcr.io/intentic/sandbox:stable
# The starter machine. Deliberately modest: it is the instant rung of the ladder, and the wizard's other rungs
# (a free 12 GB Oracle machine, your own cloud, your own computer) are the answer for power. Sized against the
# hour ceiling below rather than against what a workstation wants — with awake time capped, the guest shape is
# no longer what the free tier costs, and 4 GB is what survives an install and a build on a real repository.
HOSTED_CPUS=2
HOSTED_MEMORY_MB=4096
HOSTED_VOLUME_GB=10
# Hosted sandboxes per user — the free promise is one each.
HOSTED_PER_USER=1
# Minutes of nobody-connected-and-nothing-running before the daemon exits and its machine stops (the platform
# starts it again on the next visit; the volume keeps everything). 0 = always on, which bills around the clock.
HOSTED_IDLE_STOP_MINUTES=20
# Awake hours per calendar month for an owner WITHOUT a membership; members are unmetered. Counted only while
# the machine is actually running, and checked when it is asked to wake — nobody is stopped mid-session. This
# is the hosted lane's only upgrade prompt. 0 = no ceiling.
HOSTED_MONTHLY_HOURS=40
# Days since a non-member's machine was last woken before it is removed, disk and all, with one warning email
# HOSTED_IDLE_WARN_DAYS beforehand. A machine that is genuinely running is never taken. A member's machine is
# never taken at all. Either at 0 = never remove anything.
HOSTED_IDLE_DAYS=21
HOSTED_IDLE_WARN_DAYS=14
# Machines built ahead of demand, per region: image pulled, then stopped, claimed in seconds when somebody
# presses "Start my machine" (the pull is the minutes-long part of a cold first boot). Each costs its disk
# while it waits. 0 = no pool; claims fall back to building on demand whenever the pool is empty.
HOSTED_POOL_SIZE=2

# Who this deployment is to Fly. Every machine it creates is stamped with this, and its orphan sweep destroys
# NOTHING that carries anyone else's stamp — which is what lets two deployments share an org and a token
# without eating each other's machines. Empty derives it from API_URL + the database host/name, so a copy of
# this file on another box gets its own identity by pointing at its own Postgres. Set it only to carry an
# identity across a database move, or to hand one fleet deliberately to another deployment.
HOSTED_INSTANCE_ID=

# How often (minutes) the platform compares its own machine rows against what Fly actually has, and says so,
# loudly, when they disagree: rows whose machine has vanished, apps under this prefix that this deployment did
# not create (something else is sharing the org and credential), a warm pool that never fills. Reads only,
# destroys nothing. 0 = no watch. It exists because all three of those happened at once and the only trace was
# one warning per machine per night in a container log.
HOSTED_HEALTH_MINUTES=15

# The provisioning canary: every N minutes, provision a sandbox end to end on the real path and wait for its
# daemon to check in, then destroy it. This is the only check that can tell "the lane works" from "the lane
# looks fine and nobody who signs up ever gets a working machine". Every run spends a real machine's few
# minutes, so it is OFF unless you set both. The email must be an address nobody signs in as: it owns the
# canary's sandbox, and every run creates and destroys one under it.
HOSTED_CANARY_MINUTES=0
HOSTED_CANARY_EMAIL=

# ---- Free trial (optional, OFF by default) ---------------------------------------------------------------
# Lets a brand-new user chat before connecting any AI account, on INTENTIC'S OWN free-tier keys. This is the one
# feature that puts the platform on the command path: trial messages pass through it. Every surface that offers
# the trial says so, and connecting any account moves the user onto the direct path for good.
# Blank (the default, and the right setting for a self-hosted platform) → no trial anywhere.
# Several comma-separated keys act as a POOL: a free tier is sized for one developer, so the next key takes the
# turn when one is rate-limited.
TRIAL_KEYS=
# Any OpenAI-compatible upstream. The default is Google's, whose free tier is meant for serving end users.
TRIAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated model ids the trial may ROUTE TO, in preference order. Blank → a curated ladder of Google
# flash aliases built into the code. The trial shows users ONE row and picks a real model per message, walking
# this list until one answers — so this narrows what the trial spends, not what it offers. Set it to keep the
# trial off the expensive end of a free tier; you MUST set it if TRIAL_BASE_URL points at a non-Google upstream,
# since it replaces the built-in ladder rather than filtering it. Prefer `-latest` aliases to pinned versions —
# a pinned id gets retired out from under a free key.
TRIAL_MODELS=
# Messages per signed-in account per UTC day.
TRIAL_DAILY_MESSAGES=12

# ---- Creator pool / paid services (optional, OFF by default) -----------------------------------------------
# The paid membership whose revenue creators share. POOL_STRIPE_SECRET_KEY + POOL_STRIPE_PRICE_ID are the
# switch: both empty (the default, and the right setting for a self-hosted platform) and no pool surface
# exists anywhere. For LOCAL DEV of the paid-services flow you don't need a Stripe account — any non-empty
# values switch the surfaces on (checkout just won't work), and the two lines after them do the rest:
# POOL_DEMO_SERVICE seeds the platform-hosted demo service (its request's "scenario" picks the outcome —
# ok / slow / refuse / fail / broken — and "paceMs" the stream's tempo), POOL_COMP_EMAILS makes your account
# premium without a subscription. Together they make `services list` / `services run demo-research` fully
# drivable end to end: spend card, live status lines, receipt, refunds.
POOL_STRIPE_SECRET_KEY=
POOL_STRIPE_WEBHOOK_SECRET=
POOL_STRIPE_PRICE_ID=
POOL_DEMO_SERVICE=false
# Comma-separated emails that count as premium without paying (complimentary memberships). Dev: put your own
# sign-in email here. Comped members ride the same daily credit meter but add nothing to the pool's revenue.
POOL_COMP_EMAILS=

# Where the connect bootstrap scripts are served from — the setup wizard's cloud lane bakes
# `${SCRIPT_ORIGIN}/connect` into a new cloud machine's first-boot script, the same URL the copy-paste command
# uses. A self-hosted platform points this at its own site.
SCRIPT_ORIGIN=https://intentic.dev

# API server port
API_PORT=6480

# Dev TLS for the API. Leave both empty and dev finds the pair `pnpm install` mints for you (run
# `pnpm cert:trust` once to approve its root) — it lives in your own data directory, which differs per person
# and per OS, so there is no path worth writing down here. Set them only to serve some other cert; empty in prod
# too, where TLS is terminated by the proxy.
API_HTTPS_KEY=
API_HTTPS_CERT=

# ── Sandbox daemon (optional) ───────────────────────────────────────────────────────────────────────────────
# Only needed to run the daemon bare (`pnpm --filter @intentic/sandbox dev`); in production it gets these from
# `docker run -e …` (connect.sh / the workspace provider). All optional — the daemon boots without them and
# features degrade. The AI creds gate whether agent turns can run when no account is connected. GOOGLE_CLIENT_ID
# above is shared (the same Google web client id the daemon verifies ID tokens against).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# xAI (Grok) API key — the translator's upstream key when Grok runs under the Claude Code harness. Also settable
# per-sandbox in the app (Sandbox ▸ Agent). OPENAI_API_KEY above doubles as Codex's key on that path.
XAI_API_KEY=
# Kimi (Moonshot) API key — the fallback for Kimi turns when no key-based account is stored, and the credential
# the Kimi model catalog discovers with. Also settable per-sandbox in the app (Sandbox ▸ Agent).
MOONSHOT_API_KEY=
# The user's own Cloudflare API token (own-Cloudflare path) — the daemon mints host tunnels with it.
CLOUDFLARE_API_TOKEN=
# TOFU owner-bind token, and the account email allowed to bind as owner (match your intentic account).
CONNECT_TOKEN=
OWNER_EMAIL=
# Cloudflare zone for scaffolded app domains; where the platform lives for the daemon's announce/liveness.
ZONE=
PLATFORM_URL=
# Desktop-sync pairing token (only when pairing a local sync agent).
SYNC_PAIR_TOKEN=
# First-party extensions dir for a bare daemon — point at this repo's _extensions/ (absolute path) so cli
# connectors (github, discord, sql, …) resolve like in the image, where the Dockerfile bakes /opt/extensions.
EXTENSIONS_DIR=
