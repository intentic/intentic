<?xml version="1.0" encoding="utf-8"?>
<!-- Public Sans, the web editor's face (OFL, assets/licenses). One variable file serves every weight the app asks for,
     as the web's one woff2 does; each weight is that file at a point on its wght axis. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/public_sans_variable" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/public_sans_variable" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/public_sans_variable" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/public_sans_variable" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
