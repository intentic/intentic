{
    "name": "@intentic/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./icon": {
            "types": "./src/components/primitives/Icon.vue",
            "default": "./src/components/primitives/Icon.vue"
        },
        "./testing": {
            "types": "./src/testing.ts",
            "default": "./src/testing.ts"
        },
        "./markdown-view": {
            "types": "./src/components/markdown/Markdown.vue",
            "default": "./src/components/markdown/Markdown.vue"
        },
        "./markdown": {
            "types": "./src/markdown/index.ts",
            "default": "./src/markdown/index.ts"
        },
        "./markdown-document": {
            "types": "./src/components/markdown/markdownDocument.ts",
            "default": "./src/components/markdown/markdownDocument.ts"
        },
        "./dag": {
            "types": "./src/components/charts/dagLayout.ts",
            "default": "./src/components/charts/dagLayout.ts"
        },
        "./brand-color": {
            "types": "./src/lib/brandColor.ts",
            "default": "./src/lib/brandColor.ts"
        },
        "./brand-mark": {
            "types": "./src/components/brand/brandMark.ts",
            "default": "./src/components/brand/brandMark.ts"
        },
        "./format": {
            "types": "./src/lib/format.ts",
            "default": "./src/lib/format.ts"
        },
        "./icons": {
            "types": "./src/icons/iconSets.ts",
            "default": "./src/icons/iconSets.ts"
        },
        "./glyph": {
            "types": "./src/icons/glyph.ts",
            "default": "./src/icons/glyph.ts"
        },
        "./path": {
            "types": "./src/lib/path.ts",
            "default": "./src/lib/path.ts"
        },
        "./time": {
            "types": "./src/lib/timeWindow.ts",
            "default": "./src/lib/timeWindow.ts"
        },
        "./highlighter": {
            "types": "./src/composables/useHighlighter.ts",
            "default": "./src/composables/useHighlighter.ts"
        },
        "./device": {
            "types": "./src/components/sandbox/deviceDetail.ts",
            "default": "./src/components/sandbox/deviceDetail.ts"
        },
        "./sandbox-resources": {
            "types": "./src/components/sandbox/sandboxResources.ts",
            "default": "./src/components/sandbox/sandboxResources.ts"
        },
        "./notice": {
            "types": "./src/components/feedback/notice.ts",
            "default": "./src/components/feedback/notice.ts"
        },
        "./series": {
            "types": "./src/components/charts/seriesAccent.ts",
            "default": "./src/components/charts/seriesAccent.ts"
        },
        "./preference": {
            "types": "./src/composables/preference.ts",
            "default": "./src/composables/preference.ts"
        },
        "./text-size": {
            "types": "./src/composables/useTextSize.ts",
            "default": "./src/composables/useTextSize.ts"
        },
        "./theme": {
            "types": "./src/composables/useTheme.ts",
            "default": "./src/composables/useTheme.ts"
        },
        "./styles/*": "./src/styles/*",
        "./async": {
            "types": "./src/lib/async.ts",
            "default": "./src/lib/async.ts"
        },
        "./press": {
            "types": "./src/lib/pressLock.ts",
            "default": "./src/lib/pressLock.ts"
        },
        "./style-stability": {
            "types": "./src/lib/styleStability.ts",
            "default": "./src/lib/styleStability.ts"
        },
        "./loading-reveal": {
            "types": "./src/composables/loadingReveal.ts",
            "default": "./src/composables/loadingReveal.ts"
        }
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@dagrejs/dagre": "catalog:",
        "@dicebear/core": "catalog:",
        "@dicebear/styles": "catalog:",
        "@primeuix/themes": "catalog:",
        "@intentic/code-read": "workspace:*",
        "@shikijs/langs": "catalog:",
        "@shikijs/themes": "catalog:",
        "@vue-flow/core": "catalog:",
        "dompurify": "catalog:",
        "marked": "catalog:",
        "mermaid": "catalog:",
        "primevue": "catalog:",
        "shiki": "catalog:",
        "tailwind-merge": "catalog:",
        "tslib": "catalog:",
        "vue": "catalog:"
    },
    "devDependencies": {
        "@intentic/constants": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "typescript": "catalog:",
        "vue-tsc": "catalog:"
    }
}
