new file mode 100644
index 0000000000000000000000000000000000000000..25bc5657b7e5bacc81f18a4609d0b4bd41a3d942
--- /dev/null
+++ b/intentic-icons.mjs
@@ -0,0 +1,58 @@
+// PrimeVue's fallback icons use the same globally registered Icon as Intentic's own controls.
+import { h, resolveComponent } from 'vue';
+
+const icon = (name) => ({
+    inheritAttrs: false,
+    setup(_, { attrs }) {
+        const Icon = resolveComponent('Icon');
+        if (typeof Icon === 'string') throw new Error('Install Intentic UI before rendering PrimeVue controls');
+        return () => h(Icon, { ...attrs, name });
+    }
+});
+
+export const AngleDoubleDownIcon = icon('chevrons-down');
+export const AngleDoubleLeftIcon = icon('chevrons-left');
+export const AngleDoubleRightIcon = icon('chevrons-right');
