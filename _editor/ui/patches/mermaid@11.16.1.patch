+// Native SVG icon registry. Diagram icons are local data, with no icon service or rendering package.
+const NS = 'http://www.w3.org/2000/svg';
+let serial = 0;
+
+const transforms = (base, own) => ({
+  ...base, ...own,
+  hFlip: Boolean(base.hFlip) !== Boolean(own.hFlip),
+  vFlip: Boolean(base.vFlip) !== Boolean(own.vFlip),
+  rotate: ((base.rotate || 0) + (own.rotate || 0)) % 4
+});
+
+const drawing = (pack, name, seen = new Set()) => {
+  if (seen.has(name)) throw new Error(`Cyclic icon: ${name}`);
+  seen.add(name);
+  if (Object.hasOwn(pack.icons, name)) return transforms(pack, pack.icons[name]);
+  const alias = Object.hasOwn(pack.aliases || {}, name) ? pack.aliases[name] : undefined;
+  if (!alias) throw new Error(`Icon not found: ${name}`);
+  return transforms(drawing(pack, alias.parent, seen), alias);
+};
+
+const scale = (value, ratio) => typeof value === 'number'
+  ? value * ratio
+  : String(value).replace(/(?:\d*\.)?\d+/g, number => String(Number(number) * ratio));
+
+const svgOf = (icon, options, attributes) => {
+  const svg = document.createElementNS(NS, 'svg');
+  let width = icon.width || 16;
+  let height = icon.height || 16;
+  const group = document.createElementNS(NS, 'g');
+  // The returned SVG passes through Mermaid's sanitizer before entering the document.
+  group.innerHTML = icon.body;
+  const rotation = (((icon.rotate || 0) + (options.rotate || 0)) % 4 + 4) % 4;
+  const hFlip = Boolean(icon.hFlip) !== Boolean(options.hFlip);
+  const vFlip = Boolean(icon.vFlip) !== Boolean(options.vFlip);
+  const steps = [`translate(${- (icon.left || 0)} ${- (icon.top || 0)})`];
+  if (hFlip || vFlip) steps.unshift(`translate(${hFlip ? width : 0} ${vFlip ? height : 0}) scale(${hFlip ? -1 : 1} ${vFlip ? -1 : 1})`);
+  if (rotation === 1) steps.unshift(`translate(${height} 0) rotate(90)`);
+  if (rotation === 2) steps.unshift(`translate(${width} ${height}) rotate(180)`);
+  if (rotation === 3) steps.unshift(`translate(0 ${width}) rotate(270)`);
+  if (rotation % 2) [width, height] = [height, width];
+  group.setAttribute('transform', steps.join(' '));
+  svg.append(group);
+  // Repeated marks may carry clip paths or gradients; every instance needs its own fragment IDs.
+  const ids = new Map();
+  const prefix = `diagram-icon-${++serial}-`;
+  for (const node of group.querySelectorAll('[id]')) {
+    const id = node.getAttribute('id');
+    ids.set(id, `${prefix}${ids.size}`);
+    node.setAttribute('id', ids.get(id));
+  }
+  for (const node of group.querySelectorAll('*')) {
+    for (const attr of [...node.attributes]) {
+      let value = attr.value;
+      if ((attr.localName === 'href') && ids.has(value.slice(1))) value = `#${ids.get(value.slice(1))}`;
+      value = value.replace(/url\(['"]?#([^)'"\s]+)['"]?\)/g, (match, id) => ids.has(id) ? `url(#${ids.get(id)})` : match);
+      if (value !== attr.value) node.setAttributeNS(attr.namespaceURI, attr.name, value);
+    }
+  }
+  let outWidth = options.width;
+  let outHeight = options.height;
+  if (outWidth === undefined && outHeight === undefined) outHeight = '1em';
+  if (outWidth === 'auto') outWidth = width;
+  if (outHeight === 'auto') outHeight = height;
+  if (outWidth === undefined) outWidth = scale(outHeight, width / height);
+  if (outHeight === undefined) outHeight = scale(outWidth, height / width);
+  const values = { xmlns: NS, width: outWidth, height: outHeight, viewBox: `0 0 ${width} ${height}`, ...attributes };
+  for (const [key, value] of Object.entries(values)) svg.setAttribute(key, String(value));
+  return svg.outerHTML;
+};
+
+export const createIconRegistry = (sanitize) => {
+  const packs = new Map();
+  const loaders = new Map();
+  const pending = new Map();
+  const unknownIcon = { width: 24, height: 24, body: '<path fill="none" stroke="currentColor" stroke-width="2" d="M8 3h8l5 5v8l-5 5H8l-5-5V8Z M9 9a3 3 0 0 1 6 0c0 2-3 2-3 5 M12 17v1"/>' };
+  const registerIconPacks = (entries) => {
+    for (const entry of entries) {
+      if (!entry.name) throw new Error('An icon pack needs a name');
+      if ('icons' in entry) {
+        packs.set(entry.name, entry.icons);
+        loaders.delete(entry.name);
+      } else if (typeof entry.loader === 'function') {
+        loaders.set(entry.name, entry.loader);
+        packs.delete(entry.name);
+      } else throw new Error('An icon pack needs icons or a loader');
+      pending.delete(entry.name);
+    }
+  };
+  const load = async (name, fallback) => {
+    const parts = name.split(':');
+    const prefix = parts.length === 1 ? fallback : parts.at(-2);
+    const key = parts.at(-1);
+    if (!prefix || !key || parts.length > 3) throw new Error(`Invalid icon name: ${name}`);
+    let pack = packs.get(prefix);
+    if (!pack) {
+      const loader = loaders.get(prefix);
+      if (!loader) throw new Error(`Icon pack not found: ${prefix}`);
+      let task = pending.get(prefix);
+      if (!task) {
+        task = Promise.resolve().then(loader);
+        pending.set(prefix, task);
+      }
+      try {
+        pack = await task;
+        if (loaders.get(prefix) === loader) packs.set(prefix, pack);
+      } finally {
+        if (pending.get(prefix) === task) pending.delete(prefix);
+      }
+    }
+    return drawing(pack, key);
+  };
+  const isIconAvailable = async (name) => {
+    try { await load(name); return true; } catch { return false; }
+  };
+  const getIconSVG = async (name, options = {}, attributes = {}) => {
+    let icon;
+    try { icon = await load(name, options.fallbackPrefix); } catch { icon = unknownIcon; }
+    return sanitize(svgOf(icon, options, attributes));
+  };
+  return { unknownIcon, registerIconPacks, isIconAvailable, getIconSVG };
+};
