/* The UI lib is consumed directly from source (main/exports → ./src/index.ts). */
{
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo"
    },
    "include": ["./src/**/*.ts", "./src/**/*.vue"],
    "extends": "@intentic/tsconfig/tsconfig.vue.json"
}
