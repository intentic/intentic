{
    "name": "@intentic/desktop-app",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm stage:scripts && pnpm stage:local && vite",
        "build": "pnpm stage:scripts && vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.local.json && vite build && vite build --config vite.local.config.ts",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "generate:icons": "node scripts/icons.mjs",
        "stage:downloads": "bash scripts/stage-local-downloads.sh",
        "stage:scripts": "bash ../../_tools/scripts/desktop/stage-desktop-scripts.sh",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.local.json && vue-tsc --noEmit -p tsconfig.test.json",
        "test": "suites",
        "test:watch": "suites --watch",
        "test:rust": "pnpm stage:scripts && pnpm stage:local && cargo test --manifest-path src-tauri/Cargo.toml",
        "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "lint:rust": "pnpm stage:scripts && pnpm stage:local && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && pnpm lint:rust && pnpm test:rust",
        "dev:local": "vite --config vite.local.config.ts",
        "stage:local": "bash ../../_tools/scripts/desktop/stage-local-files.sh"
    },
    "dependencies": {
        "@intentic/entry-css": "workspace:*",
        "@intentic/house-css": "workspace:*",
        "@intentic/ui": "workspace:*",
        "@tauri-apps/api": "catalog:",
        "@tauri-apps/plugin-dialog": "catalog:",
        "primevue": "catalog:",
        "tslib": "catalog:",
        "vue": "catalog:"
    },
    "devDependencies": {
        "@dagrejs/dagre": "catalog:",
        "@intentic/api-contract": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/local-files": "workspace:*",
        "@intentic/testing": "workspace:*",
        "@intentic/tsconfig": "workspace:*",
        "@intentic/web": "workspace:*",
        "@shikijs/langs": "catalog:",
        "@shikijs/themes": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@tauri-apps/cli": "catalog:",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "catalog:",
        "@vue-flow/core": "catalog:",
        "mermaid": "catalog:",
        "sharp": "catalog:",
        "shiki": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vue-tsc": "catalog:"
    }
}
