/* The local face's own entry (local/): its bootstrap and the platform stand-in. The editor it enters is type-checked by
   _editor/web itself, so its entry is declared (local/editor-entry.d.ts) rather than followed here. */
{
    "compilerOptions": {
        "rootDir": "../..",
        "tsBuildInfoFile": "./.cache/tsbuildinfo-local",
        "types": ["vite/client"],
        "paths": {
            "@intentic/web/main": ["./local/editor-entry.d.ts"],
            "@intentic/web/local": ["../../_editor/web/src/app/environments/local.ts"],
            "@intentic/web/local-host": ["../../_editor/web/src/app/environments/localHost.ts"],
            "@intentic/api-contract": ["../../_shared/api-contract/src/index.ts"],
            // This app's half of the shell (src/host.ts, This device) is drawn in the kit, read from source as src/ reads it.
            "@intentic/ui": ["../../_editor/ui/src/index.ts"],
            "@intentic/ui/i18n": ["../../_editor/ui/src/i18n/index.ts"]
        }
    },
    "extends": "@intentic/tsconfig/tsconfig.vue.json",
    "include": ["./local/**/*.ts"],
    /* The page's program only: its tests run under bun and are checked by tsconfig.test.json. */
    "exclude": ["./local/**/*.test.ts"]
}
