{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Intentic",
    "version": "0.0.0",
    "identifier": "dev.intentic.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:47146",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "rpm", "appimage", "nsis"],
        "createUpdaterArtifacts": true,
        "category": "DeveloperTool",
        "shortDescription": "Intentic, sandboxed AI workspaces",
        "longDescription": "Run your intentic sandbox on this computer without a terminal, this app installs Docker if you need it, starts the sandbox and its tunnel, keeps it updated, and opens your workspace.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "resources": {
            "staged-scripts/*": "scripts/",
            "../../../_extensions/onlyoffice/dist/editor/*": "onlyoffice-page/"
        },
        "linux": {
            "deb": {
                "depends": [],
                "desktopTemplate": "main.desktop"
            },
            "rpm": {
                "desktopTemplate": "main.desktop"
            }
        },
        "windows": {
            "signCommand": "bash ../../../_tools/scripts/build/sign-windows.sh %1",
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "./installer-hooks.nsh"
            }
        },
        "externalBin": ["binaries/intentic-files"],
        "fileAssociations": [
            {
                "ext": ["docx", "doc", "odt", "rtf"],
                "name": "Word document",
                "description": "Word document, opened in Intentic",
                "role": "Editor",
                "rank": "Alternate",
                "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
                "ext": ["xlsx", "xls", "ods", "csv"],
                "name": "Spreadsheet",
                "description": "Spreadsheet, opened in Intentic",
                "role": "Editor",
                "rank": "Alternate",
                "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
                "ext": ["pptx", "ppt", "odp"],
                "name": "Presentation",
                "description": "Presentation, opened in Intentic",
                "role": "Editor",
                "rank": "Alternate",
                "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
                "ext": ["epub"],
                "name": "EPUB book",
                "description": "EPUB book, opened in Intentic",
                "role": "Viewer",
                "rank": "Alternate",
                "mimeType": "application/epub+zip"
            },
            {
                "ext": ["md", "markdown"],
                "name": "Markdown",
                "description": "Markdown, opened in Intentic",
                "role": "Editor",
                "rank": "Alternate",
                "mimeType": "text/markdown"
            },
            {
                "ext": ["txt", "log", "json", "yaml", "yml", "toml"],
                "name": "Text",
                "description": "Text, opened in Intentic",
                "role": "Editor",
                "rank": "Alternate",
                "mimeType": "text/plain"
            }
        ]
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://github.com/intentic/intentic/releases/latest/download/latest.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzODRDRTZGODg4RkY5NkEKUldScStZK0liODZFODh5UWRTdmhLaCsyK09PS3dlV25XUUdQa0hiY1lUR2NGSGI3Smxaby9zRzYK",
            "windows": {
                "installMode": "passive"
            }
        },
        "deep-link": {
            "desktop": {
                "schemes": ["intentic"]
            }
        }
    }
}
