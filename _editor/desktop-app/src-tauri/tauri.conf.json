{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Intentic",
    "version": "0.0.0",
    "identifier": "dev.intentic.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:47146",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "rpm", "appimage", "nsis"],
        "createUpdaterArtifacts": true,
        "category": "DeveloperTool",
        "shortDescription": "Intentic — sandboxed AI workspaces",
        "longDescription": "Run your intentic sandbox on this computer without a terminal — this app installs Docker if you need it, starts the sandbox and its tunnel, keeps it updated, and opens your workspace.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "resources": {
            "staged-scripts/*": "scripts/"
        },
        "linux": {
            "deb": {
                "depends": [],
                "desktopTemplate": "main.desktop"
            },
            "rpm": {
                "desktopTemplate": "main.desktop"
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "./installer-hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://github.com/intentic/intentic/releases/latest/download/latest.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRjUyN0VFM0JERDFFMjQKUldRa0h0MDc3aWYxUHdFNWRXNjU5cnhNZzZ6ZjZqc0U1QW96SlArbmVKMkNsVkdCK1dBQjJKb0cK"
        },
        "deep-link": {
            "desktop": {
                "schemes": ["intentic"]
            }
        }
    }
}
