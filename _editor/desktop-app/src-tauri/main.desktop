# Tauri's built-in template, with the %U field code its Exec line omits — without one the OS starts this app
# with no arguments and the intentic:// link it was chosen for is gone (see ../README.md, "The link surface").
# %U rather than %u: the same code carries the files and folders "Open with Intentic" hands over (src/local.rs),
# as paths or file:// URIs. inode/directory offers the app for folders; tauri.conf.json's fileAssociations
# supply the document types, each as an alternate to whatever the desktop already opens it with.
# A custom template REPLACES the built-in one, so every other field here has to stay verbatim.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %U
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}};inode/directory;
{{/if}}
