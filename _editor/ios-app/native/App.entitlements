<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's one entitlement: push. scripts/prepare-native.mjs copies this beside the generated app sources
     and points the App target's two build configurations at it, which is what makes automatic signing register
     the capability on the App ID. (The target's own setting rather than an xcodebuild-wide override: that would
     hand the same entitlements file to every Pods framework in the workspace.) "production" is what a
     store/TestFlight build needs; a local debug run from Xcode gets the development environment through its own
     signing regardless of this value. -->
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>production</string>
</dict>
</plist>
