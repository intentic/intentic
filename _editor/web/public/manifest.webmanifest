{
    "name": "intentic",
    "short_name": "intentic",
    "description": "AI-agent workspace: chat with your agent, review changes, and manage your sandbox.",
    "start_url": "/",
    "display": "standalone",
    "shortcuts": [
        { "name": "Chat", "url": "/chat", "description": "The conversation you were last in" },
        { "name": "Agents", "url": "/agents", "description": "Every agent and what needs you" }
    ],
    "background_color": "#f4f1ec",
    "theme_color": "#f4f1ec",
    "icons": [
        { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
        { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
        { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
    ]
}
