{
    "name": "@intentic-app/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        "./main": "./src/main.ts",
        "./builtins": "./src/extension-host/builtins.ts",
        "./chat-tabs": "./src/composables/chat/tabSnapshot.ts"
    },
    "scripts": {
        "dev": "esbuild src/environments/environment.local.ts --bundle --target=es2024 --define:__API_URL__=\\\"${API_URL:-https://localhost:6480}\\\" --outfile=public/assets/js/env.js && vite",
        "watch": "esbuild src/environments/environment.local.ts --bundle --target=es2024 --define:__API_URL__=\\\"${API_URL:-https://localhost:6480}\\\" --outfile=public/assets/js/env.js && vite",
        "build": "vite build && esbuild src/environments/environment.deployment.ts --bundle --minify --target=es2024 --outfile=dist/assets/js/env.js",
        "docker:release": "bash ../../_tools/scripts/docker-release.sh web",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
    },
    "dependencies": {
        "@intentic-app/api-contract": "workspace:*",
        "@intentic-app/capability-catalog": "workspace:*",
        "@intentic-app/localhost-https": "workspace:*",
        "@intentic/base": "workspace:*",
        "@intentic/constants": "workspace:*",
        "@intentic/ext-acceptance": "workspace:*",
        "@intentic/ext-activity": "workspace:*",
        "@intentic/ext-automations": "workspace:*",
        "@intentic/ext-deployments": "workspace:*",
        "@intentic/ext-documentation": "workspace:*",
        "@intentic/ext-drafts": "workspace:*",
        "@intentic/ext-git-history": "workspace:*",
        "@intentic/ext-knowledge": "workspace:*",
        "@intentic/ext-maintenance": "workspace:*",
        "@intentic/ext-pipelines": "workspace:*",
        "@intentic/ext-preview": "workspace:*",
        "@intentic/ext-repo-apps": "workspace:*",
        "@intentic/ext-viewers": "workspace:*",
        "@intentic/ext-workflows": "workspace:*",
        "@intentic/extension-api": "workspace:*",
        "@intentic/extension-manifest": "workspace:*",
        "@intentic/extension-ui": "workspace:*",
        "@intentic/registry": "workspace:*",
        "@intentic/sandbox-contract": "workspace:*",
        "@intentic/sandbox-run": "workspace:*",
        "@intentic/ui": "workspace:*",
        "@intentic/workspace-ignore": "workspace:*",
        "@intentic/workspace-setup": "workspace:*",
        "@orpc/client": "catalog:",
        "@orpc/contract": "catalog:",
        "@orpc/openapi-client": "catalog:",
        "@shikijs/monaco": "catalog:",
        "@tanstack/query-persist-client-core": "catalog:",
        "@tanstack/vue-query": "catalog:",
        "@xterm/addon-serialize": "catalog:",
        "@xterm/addon-web-links": "catalog:",
        "@xterm/addon-webgl": "catalog:",
        "@xterm/xterm": "catalog:",
        "better-auth": "catalog:",
        "idb-keyval": "catalog:",
        "monaco-editor-core": "catalog:",
        "posthog-js": "catalog:",
        "primevue": "catalog:",
        "tslib": "catalog:",
        "vue": "catalog:",
        "vue-router": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "catalog:",
        "@xterm/headless": "catalog:",
        "esbuild": "catalog:",
        "fast-check": "catalog:",
        "jsdom": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vue-tsc": "catalog:"
    }
}
