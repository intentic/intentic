{
    "name": "intentic",
    "displayName": "Intentic",
    "description": "Chat with coding agents, run a fleet in parallel, and review their work — on your own machine, with your own AI accounts. No sandbox required.",
    "version": "0.0.0",
    "private": true,
    "publisher": "intentic",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/intentic/intentic.git",
        "directory": "_editor/vscode"
    },
    "type": "module",
    "main": "./dist/extension.cjs",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Programming Languages"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "intentic",
                    "title": "Intentic",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "intentic": [
                {
                    "type": "webview",
                    "id": "intentic.chat",
                    "name": "Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "intentic.openAgents",
                "title": "Intentic: Agents Board"
            },
            {
                "command": "intentic.openAccounts",
                "title": "Intentic: AI Accounts"
            },
            {
                "command": "intentic.restartEngine",
                "title": "Intentic: Restart Engine"
            }
        ],
        "configuration": {
            "title": "Intentic",
            "properties": {
                "intentic.engine.command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Override how the engine is started (argv). Empty uses the engine bundled with the extension; a development checkout points this at its own entrypoint, e.g. `[\"pnpm\", \"exec\", \"tsx\", \"src/main.ts\"]` with `#intentic.engine.cwd#` set."
                },
                "intentic.engine.cwd": {
                    "type": "string",
                    "default": "",
                    "description": "Working directory for the engine command override."
                }
            }
        }
    },
    "scripts": {
        "build": "node build.mjs && tsgo --noEmit",
        "build:app": "node scripts/copy-app.mjs",
        "typecheck": "tsgo --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@intentic/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@types/vscode": "1.125.0",
        "@typescript/native-preview": "catalog:",
        "@vscode/vsce": "catalog:",
        "esbuild": "catalog:",
        "ovsx": "catalog:",
        "vitest": "catalog:"
    }
}
