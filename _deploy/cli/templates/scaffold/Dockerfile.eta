# intentic starter Dockerfile — replace with your app's real build.
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
# The manifest before the source, so an edit to the code reuses the installed dependencies instead of installing them
# again. The glob takes package-lock.json too once there is one, and copies package.json alone until then.
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm install --omit=dev
COPY . .
ENV PORT=8080
EXPOSE 8080
CMD ["node", "server.js"]
