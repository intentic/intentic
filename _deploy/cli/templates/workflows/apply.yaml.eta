# Generated by intentic: apply the desired-state artifact on every push to it, pruning what it no longer declares; and
# once a day, check for drift without changing anything, failing the run when something needs applying or a person.
on:
  push:
    branches: [ "main" ]
    paths: [ "<%= it.artifactFile %>" ]
  schedule:
    - cron: "<%= it.driftCron %>"
jobs:
<% ["apply", "drift"].forEach(function (job) { -%>
  <%= job %>:
    if: github.event_name == '<%= job === "apply" ? "push" : "schedule" %>'
    runs-on: docker
    env:
<% it.envEntries.forEach(function (entry) { -%>
      <%= entry.env %>: ${{ secrets.<%= entry.secret %> }}
<% }) -%>
    steps:
      - uses: https://github.com/actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          fetch-depth: 0
      - name: <%= job === "apply" ? "apply and prune" : "drift check" %>
        run: |
          set -e
          corepack enable
          # The prune baseline: an annotated tag carries the whole record; a plain one (before 2026-10-05) points at the
          # applied artifact. A tag that exists but cannot be read fails here, never reads as "no baseline".
          PREV=''
          if git rev-parse -q --verify refs/tags/<%= it.appliedTag %> >/dev/null; then
            if [ "$(git cat-file -t refs/tags/<%= it.appliedTag %>)" = tag ]; then
              git tag -l --format='%(contents)' <%= it.appliedTag %> > /tmp/previous.json
            else
              git show <%= it.appliedTag %>:<%= it.artifactFile %> > /tmp/previous.json
            fi
            PREV="--previous /tmp/previous.json"
          fi
<% if (job === "apply") { -%>
          pnpm dlx <%= it.cliPackage %>@<%= it.cliVersion %> deploy apply --yes --artifact <%= it.artifactFile %> $PREV
      - name: mark applied
        run: |
          set -e
          AUTH="$(printf '%s:%s' '<%= it.user %>' "$<%= it.forgejoPasswordKey %>" | base64 -w0)"
          git -c user.name='<%= it.user %>' -c user.email='<%= it.user %>@<%= it.domain %>' tag -f -a --cleanup=verbatim -F <%= it.baselineFile %> <%= it.appliedTag %> HEAD
          git -c http.extraHeader="Authorization: basic $AUTH" push -f origin refs/tags/<%= it.appliedTag %>
<% } else { -%>
          pnpm dlx <%= it.cliPackage %>@<%= it.cliVersion %> deploy plan --check --artifact <%= it.artifactFile %> $PREV
<% } -%>
<% }) -%>
