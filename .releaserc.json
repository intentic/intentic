{
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "bash _tools/scripts/release/release-prepare.sh ${nextRelease.version}",
                "publishCmd": "bash _tools/scripts/release/publish-github.sh ${nextRelease.version} && bash _tools/scripts/release/release-images.sh ${nextRelease.version} && bash _tools/scripts/release/ship-stable.sh ${nextRelease.version}",
                "successCmd": "bash _tools/scripts/release/mark-release-cut.sh ${nextRelease.version} && { node _tools/scripts/release/post-release-discord.mjs ${nextRelease.version} || true; }"
            }
        ]
    ]
}
