{
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "bash _tools/scripts/release-prepare.sh ${nextRelease.version}",
                "publishCmd": "bash _tools/scripts/prepare-image-trees.sh && TAGS=\"${nextRelease.version} stable\" bash _tools/scripts/publish-images.sh",
                "successCmd": "git tag -f stable && git push -f origin stable"
            }
        ],
        [
            "@semantic-release/gitlab",
            {
                "successComment": false,
                "failComment": false
            }
        ]
    ]
}
