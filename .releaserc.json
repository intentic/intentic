{
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "bash _tools/scripts/set-versions.sh ${nextRelease.version} && pnpm turbo run build && bash _apps/sync/scripts/build-binaries.sh && bash _tools/scripts/publish-npm.sh ${nextRelease.version}",
                "publishCmd": "TAGS=\"${nextRelease.version} stable\" bash _tools/scripts/publish-images.sh",
                "successCmd": "git tag -f stable && git push -f origin stable"
            }
        ],
        [
            "@semantic-release/gitlab",
            {
                "successComment": false,
                "failComment": false,
                "assets": [
                    { "path": "_apps/sync/dist-bin/intentic-sync-linux-amd64", "filepath": "/bin/intentic-sync-linux-amd64" },
                    { "path": "_apps/sync/dist-bin/intentic-sync-linux-arm64", "filepath": "/bin/intentic-sync-linux-arm64" },
                    { "path": "_apps/sync/dist-bin/intentic-sync-darwin-amd64", "filepath": "/bin/intentic-sync-darwin-amd64" },
                    { "path": "_apps/sync/dist-bin/intentic-sync-darwin-arm64", "filepath": "/bin/intentic-sync-darwin-arm64" },
                    { "path": "_apps/sync/dist-bin/intentic-sync-windows-amd64.exe", "filepath": "/bin/intentic-sync-windows-amd64.exe" }
                ]
            }
        ]
    ]
}
